d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6e2dbd817b80f88fa0f248b1f35d127e77631609afc7934e578d417cd833185f","event_uuid":"5d899c35-1d04-4ca9-8d7e-24a4a66c4dfd","position":{"commit_sha":"0663d76279fa3d506f33572e848f417f014bc0e3","position":"1787943252062972001-5d899c35-1d04-4ca9-8d7e-24a4a66c4dfd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"23a1f2d22388687ff4211bb54d753554dbfbe4041f04779f4519ba5866d877ef","event_uuid":"2337f092-f205-4a42-9688-7fe3333f1809","position":{"commit_sha":"6bcd3f1ea0c13ac2e25a355c558a19a4f7394242","position":"1787943261659161001-2337f092-f205-4a42-9688-7fe3333f1809"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"53e957d1b6a134ec62dc3dc370b41c1daf949a2a06935f7fe29a3582a5b68651","event_uuid":"8705e5c4-6b07-4481-8c1b-3e6b354d42e4","position":{"commit_sha":"3550d739e5b3d9480c7db89556137bdcfaa4dc74","position":"1787943732106134562-8705e5c4-6b07-4481-8c1b-3e6b354d42e4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-247_agent","claim_remote_session":null,"claimed_session":"41c69740-e628-4506-a328-65f32258a98e","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed https://rebar.solutions.navateam.com/c/rebar/+/2328 (commit 782176dfdfe6). NOT submitted; awaiting LLM-Review +1 and Verified +1.\n\nScope correction found while implementing: the brief's premise that compose could certify was wrong. The REBAR_OPCERT_KEY_PATH already in docker-compose.yml belongs to the opcert: service. The mcp: service mounts the key but never set the var either, so BOTH launch paths were key-less, not just blue-green. Fixed both, keeping compose the parity source of truth.\n\nMutation check: deleting the -e flag from mcp_run_new turns BOTH test_docker_run_points_the_container_at_the_opcert_key (new) and the pre-existing test_docker_run_matches_compose_mcp_service RED. The second oracle exists only because the compose side was fixed too.\n\nREBAR_IDENTITY_SIGNING_KEY: KEPT. It populates cfg.identity.signing_key for authorship signatures and is one of the two required inputs to mcp_server.compose_startup_opcert_binding (absent it the startup binding is skipped entirely). Removing it would have widened the bug.\n\nGates: make lint PASS, make typecheck PASS (682 files), test_module_size_contract 4 passed, complexity ratchet new=0 increased=0, and 95 passed across test_autodeploy_mcp_bluegreen.py + test_mcp_on_box_infra.py + test_opcert_deploy_infra.py.\n\nRelated: closed ticket b173 (spoiled-bionic-goose) documented this exact seam and chose the ContextVar binding; this change adds the env fallback beside it rather than replacing it.","timestamp":1787943252062972001}],"created_at":1787941217546554709,"creation_channel":"mcp","deps":[{"link_uuid":"2337f092-f205-4a42-9688-7fe3333f1809","relation":"relates_to","target_id":"b173-e50a-4b93-455f"},{"link_uuid":"8705e5c4-6b07-4481-8c1b-3e6b354d42e4","relation":"relates_to","target_id":"c7d2-0a86-d4a9-4644"}],"description":"## Problem\n\nMCP tracker `claim` fails on the on-box server with:\n\n```\nno certified plan-review attestation (signature: foreign_key; this\nenvironment has no op-cert public key; it cannot certify any signature)\n```\n\nThe MCP container is KEY-LESS for op-cert signing.\n\n`rebar._opcert_signing.resolve` picks the op-cert key in this order:\n\n1. a context-local startup binding (`rebar._opcert_binding.current_binding`),\n2. the `REBAR_OPCERT_KEY_PATH` env override,\n3. the `<tracker>/.opcert-key` genesis file.\n\nOn the live container none of the three yields a key:\n\n- `REBAR_OPCERT_KEY_PATH` is UNSET,\n- `<tracker>/.opcert-key` is ABSENT (tracker is `/var/gerrit/site/mcp-tickets`),\n- the startup binding, composed by `mcp_server.compose_startup_opcert_binding`\n  from `REBAR_OPCERT_ENV_ID` + `REBAR_IDENTITY_SIGNING_KEY`, is threaded as a\n  ContextVar around serving (`rebar._mcp_health.run_mcp`) and is not observed on\n  the tool-call path that signs.\n\n`rebar.signing` states the consequence directly: a key-less environment can only\never report `unsigned` / `foreign_key`.\n\nThe Ed25519 key file IS already bind-mounted read-only at\n`/run/secrets/opcert-ed25519-key` by BOTH launch paths (verified present, 411\nbytes, in the live container). Only the env var that points at it is missing.\n\n## Scope\n\nBoth launch paths are affected, not just one:\n\n- `infra/compose/docker-compose.yml` `mcp:` service mounts the key and sets\n  `REBAR_OPCERT_ENV_ID` and `REBAR_IDENTITY_SIGNING_KEY`, but NOT\n  `REBAR_OPCERT_KEY_PATH`. (The `REBAR_OPCERT_KEY_PATH` already in that file\n  belongs to the `opcert:` service, a different service.)\n- the `infra/scripts/autodeploy.sh` blue-green `mcp_run_new` `docker run` has\n  the same omission. This is the path that actually serves `/mcp`.\n\n`test_docker_run_matches_compose_mcp_service` pins docker-run/compose parity in\nthe compose-to-run direction, so fixing only the blue-green run would silently\ndiverge the two. Fix both, keeping compose the source of truth.\n\n## Fix\n\nSet `REBAR_OPCERT_KEY_PATH=/run/secrets/opcert-ed25519-key` in the compose\n`mcp:` service environment and as a matching `-e` flag on the blue-green\n`docker run`. The mount already exists, so no new secret, mount, or terraform\nchange is needed. The env override is thread- and context-independent, so unlike\nthe ContextVar binding it holds on every tool-call path.\n\n`REBAR_IDENTITY_SIGNING_KEY` STAYS. It is load-bearing twice over: it populates\n`cfg.identity.signing_key` for authorship signatures, and it is one of the two\nrequired inputs to `compose_startup_opcert_binding` (absent it, the startup\nbinding is skipped entirely). This change adds a fallback beside it, it does not\nreplace it.\n\n## Acceptance Criteria\n\n- [ ] The compose `mcp:` service environment sets\n      `REBAR_OPCERT_KEY_PATH: \"/run/secrets/opcert-ed25519-key\"`. Checked by\n      `pytest tests/scripts/test_autodeploy_mcp_bluegreen.py -k compose_mcp_service`.\n- [ ] The blue-green `docker run` in `infra/scripts/autodeploy.sh` passes\n      `-e REBAR_OPCERT_KEY_PATH=/run/secrets/opcert-ed25519-key`. Checked by\n      `pytest tests/scripts/test_autodeploy_mcp_bluegreen.py`.\n- [ ] A regression test asserts the blue-green `docker run` command line carries\n      that flag with that exact value, and turns RED when the flag is removed\n      (mutation-checked by deleting the flag and re-running\n      `pytest tests/scripts/test_autodeploy_mcp_bluegreen.py`).\n- [ ] `REBAR_IDENTITY_SIGNING_KEY` remains set on both launch paths. Checked by\n      `grep -n REBAR_IDENTITY_SIGNING_KEY infra/scripts/autodeploy.sh infra/compose/docker-compose.yml`.\n- [ ] The repo gates stay green: `make lint`, `make typecheck`,\n      `pytest tests/unit/test_module_size_contract.py`, and\n      `python scripts/check_complexity_baseline.py --check`.\n\n## Testing\n\n- `pytest tests/scripts/test_autodeploy_mcp_bluegreen.py` -- the real-subprocess\n  blue-green suite. It stubs the box binaries onto PATH, runs the shipped\n  `autodeploy.sh`, and asserts against the recorded `docker run` command line,\n  so the new assertion binds the shipped bash rather than a copy of it.\n- `pytest tests/unit/test_mcp_on_box_infra.py` -- the static on-box infra\n  contract, re-run to confirm the compose edit breaks nothing.\n- Mutation check: delete the `-e REBAR_OPCERT_KEY_PATH=...` line from\n  `mcp_run_new` and confirm the new test FAILS, then restore it and confirm it\n  passes. A test that stays green under that deletion is worthless and must be\n  rewritten.\n- `make lint`, `make typecheck`,\n  `pytest tests/unit/test_module_size_contract.py`, and\n  `python scripts/check_complexity_baseline.py --check` for the repo gates.\n\n## Non-goals\n\nNo terraform. No new secret or mount. No change to the ContextVar startup\nbinding mechanism, which is a separate hardening question.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/scripts/autodeploy.sh","reason":"add -e REBAR_OPCERT_KEY_PATH to the blue-green mcp docker run"},{"path":"infra/compose/docker-compose.yml","reason":"set REBAR_OPCERT_KEY_PATH on the mcp service (parity source of truth)"},{"path":"tests/scripts/test_autodeploy_mcp_bluegreen.py","reason":"regression test pinning the flag on the blue-green docker run"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","b173-e50a-4b93-455f"],["relates_to","c7d2-0a86-d4a9-4644"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"bf76a7da-09c8-48fc-9d4a-8df56bc7e51c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"dd96-1655-64c3-4e2c","ticket_type":"bug","title":"Set REBAR_OPCERT_KEY_PATH for the on-box MCP container","verify_commands":[]},"source_event_uuids":["68c77f58-1ccd-49dd-a440-7f0ab700dafc","4d5a467f-95f6-4b31-9b84-467768b0d9ae","0543895f-375a-4d53-807a-f81ceae0213a","e7aea11d-7a2f-417c-80af-e8ede69d7fb2","d84e5b02-4a9a-4716-992f-b180ce0fcdaf","bf76a7da-09c8-48fc-9d4a-8df56bc7e51c","294530f8-fca4-47da-8b7b-304260379d28","5d899c35-1d04-4ca9-8d7e-24a4a66c4dfd","2337f092-f205-4a42-9688-7fe3333f1809","8705e5c4-6b07-4481-8c1b-3e6b354d42e4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787949913733195001,"uuid":"a3069025-4ddf-4ea7-b6f8-01a0aae564f7"}