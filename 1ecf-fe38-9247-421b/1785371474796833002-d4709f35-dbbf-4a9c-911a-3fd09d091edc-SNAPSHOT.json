79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"16d74ebfeee1a77e7dd29c8677abc4b85417e9fc6983c1045e5294bd3351ee9c","event_uuid":"c759540d-402e-46b3-b674-7b1dcd151ec7","position":{"commit_sha":"b36a331f06e2d674f0adcc71dd26516ba69064ba","position":"1785368725853717001-c759540d-402e-46b3-b674-7b1dcd151ec7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dfbd34c9d2c64630b3ed7f75ca96900c6d9ce77ca665f01429145088de88a894","event_uuid":"c65b20c8-bf31-4c77-a8b2-b03caeb30a68","position":{"commit_sha":"db06f222534a4819c27214df13b891c54479735c","position":"1785368738981897001-c65b20c8-bf31-4c77-a8b2-b03caeb30a68"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1ffd037f38d83e6f259fda66a1fa931a9cae61673c41f41b8984d9cb8c595c49","event_uuid":"c71ea8a9-131d-493c-b681-edf18809060f","position":{"commit_sha":"61c65a4ab7484eb9732d86e3f795d9601ff04f06","position":"1785371474796833001-c71ea8a9-131d-493c-b681-edf18809060f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785368708910629001,"creation_channel":"cli","deps":[{"link_uuid":"c759540d-402e-46b3-b674-7b1dcd151ec7","relation":"blocks","target_id":"4143-9afe-6479-4244"}],"description":"# D — Correct the AGENTS.md rule so it is true (precondition for it being followed)\n\n## Context / Problem\n\nThis story is **not** a rewording for emphasis; it is a correctness fix, and it is a precondition for stories A\nand B being trustworthy.\n\n`AGENTS.md` currently says: \"**Prefer its symbol tools over `grep`** when finding or following references … It\nresolves 'who calls / imports this?' reliably (definitions + references, not text matches)\". That claim is\n**false in an important case**, verified in this repo against Serena/Pyright:\n\n- `find_referencing_symbols` on `_anthropic_cache_settings` returned the import plus all five real call sites,\n  but did **not** return `tests/interfaces/store/test_execution_mode_dispatch.py:90`\n  (`monkeypatch.setattr(runner_mod, \"_anthropic_cache_settings\", ...)`). The symbol is named by a **string\n  literal**, so there is nothing for the LSP to resolve.\n- That exact class broke epic `061c` story S1: the identical monkeypatch pattern for\n  `_build_retrying_anthropic_model` passed `tests/unit` and only surfaced in full-suite pre-flight. An agent\n  following the current rule *exclusively* would have missed the site that failed.\n- Separately, Serena's index can lag edits: it reported `runner.py:336` / `test_structured.py:175` when the\n  current tree had `:341` / `:176`, after a commit in the same session rewrote 79 lines of `runner.py`.\n- In the other direction, `grep` produced false positives Serena did not: two `output_mode()` matches that were\n  **comments** (`runner.py:78`, `:160`).\n\nA rule that is wrong some of the time trains agents to discount it all of the time — which is a plausible\ncontributor to the original failure. Encoding the division of labour makes the rule safe to follow literally.\n\n## Approach\n\nReplace the bare preference with a short decision table, and keep it short — the aim is a rule an agent can\napply correctly without re-deriving these findings.\n\n| Need | Tool |\n|---|---|\n| who calls / imports a symbol | Serena `find_referencing_symbols` — semantic, no comment false positives |\n| symbol named as a **string**: `monkeypatch.setattr`, `getattr`, `importlib` | `grep` — the LSP cannot resolve these |\n| current line numbers after recent edits | `grep` on the working tree — the LSP index can lag |\n\nKeep it lean per `AGENTS.md`'s own standing instruction (one-line pointers, not restated sections); the\nsupporting evidence belongs in `docs/`, not inline.\n\n## Scope\n\n- `AGENTS.md` §\"Navigating the codebase (when editing rebar itself)\" — the table replacing the bare preference.\n- `docs/` — a short note recording the LSP string-literal blind spot and the stale-index caveat, with the\n  verified examples, if a suitable doc home exists.\n\n## Testing\n\nDocumentation change; verified by review rather than by test. The claims in the table are each backed by a\nreproducible check recorded on this ticket.\n\n## Acceptance Criteria\n\n- [ ] `AGENTS.md` no longer states an unconditional preference; it states the three-row division of labour\n- [ ] the string-literal blind spot is named explicitly with `monkeypatch.setattr` as the concrete example\n- [ ] the stale-index caveat is named, with the guidance to trust the working tree for line numbers\n- [ ] the section does not grow by more than a few lines (the file's own leanness rule), with detail in `docs/`\n- [ ] the reminder text shipped in story A and this table do not contradict each other","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"AGENTS.md","reason":"replace bare preference with the division-of-labour table"},{"path":"docs/local-dev-env.md","reason":"candidate home for the LSP blind-spot / stale-index note"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["blocks","4143-9afe-6479-4244"],["parent","9109-2ad9-2477-4cf6"]],"no_file_impact_reason":"","parent_id":"9109-2ad9-2477-4cf6","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"open","tags":[],"ticket_id":"1ecf-fe38-9247-421b","ticket_type":"story","title":"D — Correct the AGENTS.md rule so it is true (LSP string-literal blind spot)","verify_commands":[]},"source_event_uuids":["a987564a-f5f2-420a-b0dd-28d56256d9ae","c759540d-402e-46b3-b674-7b1dcd151ec7","c65b20c8-bf31-4c77-a8b2-b03caeb30a68","c71ea8a9-131d-493c-b681-edf18809060f"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785371474796833002,"uuid":"d4709f35-dbbf-4a9c-911a-3fd09d091edc"}