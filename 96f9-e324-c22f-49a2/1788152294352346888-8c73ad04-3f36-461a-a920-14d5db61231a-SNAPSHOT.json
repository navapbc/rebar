-45f6-98e9-07738b85e1d3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d0c6a203b2d9ad7d55722d270c67d18a5fea22c3f6489e4069b5354b44de3df3","event_uuid":"cdf3247c-a8bf-439d-88c3-72df344c5ea5","position":{"commit_sha":"e4c98a885964b16704ced853a5f7ddf5c91fac46","position":"1788142581592392001-cdf3247c-a8bf-439d-88c3-72df344c5ea5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f21b3c2780e63c94b515215fff56f6c68b458d6a07b3472fa946a55f0f9a70ed","event_uuid":"95b7d1c9-91d8-48d1-908e-7067cdbdbd64","position":{"commit_sha":"20bc7f68173908dbb239c07d437128d4a88a1cfb","position":"1788142591584633001-95b7d1c9-91d8-48d1-908e-7067cdbdbd64"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788112404358274736,"creation_channel":"mcp","deps":[{"link_uuid":"6b4177a7-47bc-4a8d-83e3-99fb2c671981","relation":"depends_on","target_id":"ce15-28c5-80e0-49c2"},{"link_uuid":"70fa3c18-964b-4943-bd8b-a1209ee09e99","relation":"relates_to","target_id":"8a67-647d-d48b-4a70"}],"description":"## Problem\n`review_bot/adapter.py::_translate_findings` maps each finding's kernel severity\n(`critical/major/minor/none`) to the common vocabulary via its own copy of\n`_KERNEL_TO_COMMON_SEVERITY`, but nothing downstream ever renders that value to a human:\n`render_findings_block`/`_summarize` in `review_bot/finding_publish.py` render each finding as\n`- ({criterion}) {detail}[ {location}]` with NO severity word anywhere, and the Gerrit comment\nalready conveys blocking vs advisory structurally (via the batch each call renders: `blocking`\nitems under one header, `advisory` items under another). So the human-facing Gerrit comment\nALREADY satisfies \"blocking/advisory, never severity\" -- `finding_publish.py` needs NO change.\n\nThe real defect: `_translate_findings` flattens `verdict[\"blocking\"]` and `verdict[\"advisory\"]`\ninto ONE list with no field distinguishing which bucket a translated finding came from -- its\n`severity` computation is dead weight nothing reads. Separately, two CLI text renderers DO\nprint a severity word today, for findings that (after the sibling ticket\nbeaming-snively-urial) now also carry `priority`/`decision`: `_render_review_text`\n(`review_result` findings) prints `f.get('severity','?').upper()`; `_render_plan_review_text`'s\nadvisory branch prints `sev={f.get('severity')}` (its blocking branch already prints no\nseverity). `_render_verdict_text` (completion_verdict findings) is OUT OF SCOPE: those\nfindings come from `completion_reconcile.py`'s independent module cluster, never pass through\nthe review-kernel, and never carry `priority`/`decision` -- `severity` is their only signal\nand stays untouched.\n\n`_render_review_text` is a SHARED renderer: besides code-review's `review_result` (from\n`shim.py`, which now carries `decision`), it ALSO renders `scan_epics_for_spec`/`scan-spec`\nresults (`_llm_commands.py:222`) -- `spec_scan.py`'s free-form \"spec-alignment\" reviewer\nfindings, which never pass through the code-review kernel/shim.py and carry `severity` but\nNEVER `decision`. A blind severity->decision swap would print a meaningless/fallback word for\nevery spec-scan finding and discard the only real signal that population has.\n\n## Approach\n1. In `review_bot/adapter.py::_translate_findings`, replace the `severity` key with a\n   `blocking: bool` (`True` for items from `verdict[\"blocking\"]`, `False` for\n   `verdict[\"advisory\"]`) -- fixing the genuine gap that the flattened output cannot currently\n   tell the two buckets apart. Delete `_KERNEL_TO_COMMON_SEVERITY` from `adapter.py` (its only\n   use site).\n2. `review_bot/finding_publish.py` (`render_findings_block`/`post_review`) is NOT touched --\n   confirmed it renders no severity word today and already conveys blocking/advisory via its\n   `kind=` batching, satisfying the epic's human-facing design goal with zero code change.\n3. Update `_render_review_text` in `_cli/_llm_commands.py`: when a finding's `decision` field\n   is present (the code-review/`review_result` path), print `BLOCKING`/`ADVISORY` derived from\n   it (`\"block\"` -> `BLOCKING`, else `ADVISORY`) instead of the severity word; when `decision`\n   is absent (the `scan-spec`/`spec_scan.py` path), KEEP printing the existing\n   `f.get('severity','?').upper()` fallback unchanged -- this renderer must serve both\n   producers correctly.\n4. Update `_render_plan_review_text`'s advisory branch to drop the `sev={severity}` suffix\n   entirely (the function's blocking branch already omits any per-finding tag beyond its\n   `[BLOCK ...]`/`[advisory ...]` bucket label, so dropping the advisory branch's severity\n   suffix makes the two branches consistent -- no replacement tag needed since bucket\n   membership already conveys blocking/advisory). Add a new test (none currently exists) that\n   feeds a non-empty advisory finding through `_render_plan_review_text` and asserts the\n   post-change line contains no `sev=` substring.\n5. `_render_verdict_text` is explicitly OUT OF SCOPE (see Problem) -- left unchanged.\n\n## Acceptance Criteria\n- [x] `grep -n \"_KERNEL_TO_COMMON_SEVERITY\" src/rebar/review_bot/adapter.py` returns no\n  matches; `grep -n \"_KERNEL_TO_COMMON_SEVERITY\" src/rebar/llm/code_review/shim.py` still\n  finds it (unchanged, out of scope for this ticket).\n- [x] `adapter.py::_translate_findings`'s output carries a `blocking: bool` key per finding\n  instead of `severity`; `pytest tests/unit/test_code_review_carry_forward.py -k test_adapter_carries_standing_through_to_the_receiver_shape`\n  passes, strengthened with an assertion that a `verdict[\"blocking\"]`-sourced finding has\n  `blocking=True` and a `verdict[\"advisory\"]`-sourced one has `blocking=False`.\n- [x] `src/rebar/review_bot/finding_publish.py` has zero diff from this ticket\n  (`git diff --stat src/rebar/review_bot/finding_publish.py` is empty); `pytest\n  tests/unit/test_review_bot_finding_publish.py` passes unchanged.\n- [x] `_render_review_text` prints `BLOCKING`/`ADVISORY` for a finding carrying `decision`, and\n  still prints the uppercased `severity` word unchanged for a finding with no `decision` (the\n  `scan-spec` case) -- a new test in `_cli/_llm_commands.py`'s test coverage (locate via\n  `pytest --collect-only -q -k llm_commands`) asserts BOTH cases explicitly.\n- [x] `_render_plan_review_text`'s advisory branch no longer prints `sev=...`; a NEW test\n  (none of the existing plan-review-reuse/gate tests cover this line -- they use empty\n  advisory lists) feeds a non-empty advisory finding through `_render_plan_review_text` and\n  asserts the rendered line contains no `sev=` substring.\n\n## Testing\nTier: in-process unit tests against the real `_translate_findings` and CLI renderer functions,\nfed production-shaped verdict/result dicts (contract test). Oracle: the exact\n`blocking`/`BLOCKING`/`ADVISORY` values and text, asserted directly; and a negative check that\n`finding_publish.py`'s rendered output is byte-identical to before (zero diff to that file is\nitself the contrast/regression check). Contrast case (test-design.md sec.6): a `decision`-\nbearing finding (code-review) and a `decision`-absent finding (spec-scan) fed through\n`_render_review_text` must produce different label sources (derived-from-decision vs\nseverity-fallback) while both remaining meaningful. Refactoring litmus: renaming an internal\nhelper inside a renderer must not break these tests, since they assert on the printed\ntext/output value, not on which helper produced it.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/review_bot/adapter.py","reason":"translate blocking bool instead of severity, delete _KERNEL_TO_COMMON_SEVERITY"},{"path":"src/rebar/_cli/_llm_commands.py","reason":"render_review_text and render_plan_review_text show blocking/advisory instead of severity"},{"path":"tests/unit/test_code_review_carry_forward.py","reason":"strengthen _translate_findings test for blocking bool"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","ce15-28c5-80e0-49c2"],["parent","c4c8-317a-85ca-4b08"],["relates_to","8a67-647d-d48b-4a70"]],"no_file_impact_reason":"","parent_id":"c4c8-317a-85ca-4b08","parent_status_uuid":"cdf3247c-a8bf-439d-88c3-72df344c5ea5","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"closed","tags":[],"ticket_id":"96f9-e324-c22f-49a2","ticket_type":"task","title":"Surface blocking/advisory instead of severity in review-bot and CLI renderers","verify_commands":[]},"source_event_uuids":["2b6353f9-2c0f-45e3-8f37-0cd85490bb8b","ad4d8c16-7b9b-458d-bbcd-fd88038db505","5001d4fa-b8eb-4597-8b56-c7ec05554330","409f043b-d0a5-4394-8b1b-4beb08729e6c","0121dfe1-a83b-403c-adbb-1a91442ca6be","0698ec0c-da21-4fae-a9eb-f9fbe2022f07","41a54232-c7a4-43b9-99d7-618902f14e8d","09221225-970b-4ebb-af15-f617facc00fa","70fa3c18-964b-4943-bd8b-a1209ee09e99","0da9839e-7b98-45f6-98e9-07738b85e1d3","cdf3247c-a8bf-439d-88c3-72df344c5ea5","95b7d1c9-91d8-48d1-908e-7067cdbdbd64"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1788152294352346888,"uuid":"8c73ad04-3f36-461a-a920-14d5db61231a"}