903cfc1-d4c2-4901-9c6f-1924fb5b802b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2c8826cdd99f4a90b4d27d24c511905682b4b11ec24af7819121504efa20326b","event_uuid":"1406e8f4-c2bd-4456-b316-228cc3c3c608","position":{"commit_sha":"93c16779c9321aad5975437139bd9d59b609dab2","position":"1787030352233395001-1406e8f4-c2bd-4456-b316-228cc3c3c608"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA boundary note from Gerrit 1827 run 31961655783: this omitted-basetemp sibling is independently valid but did not cause the authorship batched-map failure. The CI parent explicitly ran with --basetemp=/home/runner/work/_temp/rebar-basetemp, and the failing active tracker lived under that tree. _collect_node_ids launches nested pytest without --basetemp, so its cleanup is confined to pytest's separate default /tmp/pytest-of-runner numbered root; it cannot delete or traverse the active authorship tmp_path. Returning this ticket to open for its own planned repair; no code or tests were changed here.","timestamp":1786904817380129001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Repair verification report\n\nProblem: _collect_node_ids launched a nested pytest collection process in the shared numbered temp root, allowing session cleanup to delete another run tree.\n\nProven root cause/proof: a collection-time plugin forced the real nested TempPathFactory to initialize against PYTEST_DEBUG_TEMPROOT with pytest-0..3. Without private basetemp, cleanup deleted the pytest-0 sentinel; supplying private basetemp preserved exact entries and bytes. Plain collect-only was a negative experiment because lazy temp initialization never fired.\n\nTest: held-out tests/unit/test_ci_workflow_parity_basetemp.py was RED before repair and is GREEN after. Removing exactly the --basetemp arguments returned it to RED; they were restored. The oracle also pins exact node parsing and unchanged shared-root entries.\n\nFix: _collect_node_ids owns a TemporaryDirectory and passes nested pytest a private --basetemp while preserving signature, selection, cwd, capture/text, timeout=300, accepted rc 0/5, and :: parsing.\n\nSafety/gates: parity suite plus oracle 23 passed; make lint and make typecheck passed. No dependency or user-facing capability added and no test weakened.\n\nSiblings/parity: bounded search found the previously fixed tests/_store_isolation.py pattern and no additional confirmed occurrence that initializes pytest temp state; other collect-only subprocesses do not by themselves trigger the mechanism. This is internal test infrastructure, so CLI/MCP/library parity slots are N/A.\n\nReplication: the original poisoned shared numbered-root scenario now preserves every preexisting entry and sentinel byte while returning the expected collected node.","timestamp":1787022567330428001}],"created_at":1786898143082505001,"creation_channel":"cli","deps":[{"link_uuid":"d0bf89de-d27f-48f9-95d4-c76fb7fc2cdf","relation":"discovered_from","target_id":"bf7c-333e-29b0-4ee4"},{"link_uuid":"dedc4b08-9521-4c44-b0ce-3c24c72bf2dc","relation":"relates_to","target_id":"9599-c8bc-8517-4cf6"},{"link_uuid":"419f6c6d-c629-4efe-b6f3-be8a24ad05f0","relation":"relates_to","target_id":"0f4a-0144-0d9f-4b0c"}],"description":"## Context\nDiscovered while debugging grindable-deviant-angwantibo. `tests/unit/test_ci_workflow_parity.py::_collect_node_ids` launches a real nested pytest collection subprocess without `--basetemp`. The confirmed sibling mechanism is pytest session shutdown traversing the shared numbered temp root in `cleanup_numbered_dir`/`rmtree`, which can delete or stall on another run temp tree. The fixed `_store_isolation` helper does not cover this independent caller.\n\n## Plan\n- Add a RED regression that gives the nested collection subprocess a poisoned shared numbered temp root and proves a pre-existing sentinel survives unchanged.\n- Pass a caller-owned private `--basetemp` directory to `_collect_node_ids` without changing its collection selection, stdout parsing, return-code contract, or timeout.\n- Prove GREEN, seed the omitted-basetemp mutation back to RED, and run focused plus repository gates.\n\n## Acceptance Criteria\n- [x] The regression fails on the current implementation because nested collection removes or traverses the shared numbered-root sentinel.\n- [x] `_collect_node_ids` runs nested pytest with a private basetemp owned by the caller.\n- [x] The held-out regression passes and the exact-defect mutation returns it to RED.\n- [x] Existing workflow-parity tests pass.\n- [x] `make lint`, `make typecheck`, and `make test` pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_ci_workflow_parity.py","reason":"give the nested collection subprocess a caller-owned private basetemp"},{"path":"tests/unit/test_ci_workflow_parity_basetemp.py","reason":"held-out regression for shared numbered-root cleanup"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","0f4a-0144-0d9f-4b0c"],["relates_to","9599-c8bc-8517-4cf6"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e903cfc1-d4c2-4901-9c6f-1924fb5b802b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["test","flaky"],"ticket_id":"444d-62ff-2c3c-42a9","ticket_type":"bug","title":"Give parity collection subprocess a private pytest basetemp","verify_commands":[]},"source_event_uuids":["8a238ede-f930-48a7-bdda-c9332c88cfe9","a8ed2780-44bc-450c-b7cc-887a17d07850","dedc4b08-9521-4c44-b0ce-3c24c72bf2dc","11d8a5c1-29ff-4eb8-932e-9692f461a5ef","4badd2d6-9b39-46e7-908e-f5fa963be7c3","e2d9e6bf-f05c-4d7b-a1cc-e6fc6dbfc269","84fb5e9c-96cf-4367-a424-072b68b51077","909f6c8e-de7c-4faf-a3cb-11b5401f7906","e34fc52b-d455-46ca-8026-66f6be47a599","419f6c6d-c629-4efe-b6f3-be8a24ad05f0","486423f3-9c22-42c6-8a9e-1da9d8c6dbfa","3c140ec5-64d6-4c2b-9533-904de9f478d3","e903cfc1-d4c2-4901-9c6f-1924fb5b802b","1406e8f4-c2bd-4456-b316-228cc3c3c608"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787033228926744431,"uuid":"12944790-5eea-444c-8836-c53ada601a2e"}