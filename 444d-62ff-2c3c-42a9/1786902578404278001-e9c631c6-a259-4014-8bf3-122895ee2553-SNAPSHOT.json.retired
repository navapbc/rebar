9 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786898143082505001,"creation_channel":"cli","deps":[{"link_uuid":"d0bf89de-d27f-48f9-95d4-c76fb7fc2cdf","relation":"discovered_from","target_id":"bf7c-333e-29b0-4ee4"}],"description":"## Context\nDiscovered while debugging grindable-deviant-angwantibo. `tests/unit/test_ci_workflow_parity.py::_collect_node_ids` launches a real nested pytest collection subprocess without `--basetemp`. The confirmed sibling mechanism is pytest session shutdown traversing the shared numbered temp root in `cleanup_numbered_dir`/`rmtree`, which can delete or stall on another run's temp tree. The fixed `_store_isolation` helper does not cover this independent caller.\n\n## Plan\n- Add a RED regression that gives the nested collection subprocess a poisoned shared numbered temp root and proves a pre-existing sentinel survives unchanged.\n- Pass a caller-owned private `--basetemp` directory to `_collect_node_ids` without changing its collection selection, stdout parsing, return-code contract, or timeout.\n- Prove GREEN, seed the omitted-basetemp mutation back to RED, and run focused plus repository gates.\n\n## Acceptance Criteria\n- [ ] The regression fails on the current implementation because nested collection removes or traverses the shared numbered-root sentinel.\n- [ ] `_collect_node_ids` runs nested pytest with a private basetemp owned by the caller.\n- [ ] The held-out regression passes and the exact-defect mutation returns it to RED.\n- [ ] Existing workflow-parity tests pass.\n- [ ] `make lint`, `make typecheck`, and `make test` pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_ci_workflow_parity.py","reason":"add a private basetemp to the nested pytest collection subprocess and its regression oracle"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["test","flaky"],"ticket_id":"444d-62ff-2c3c-42a9","ticket_type":"bug","title":"Give parity collection subprocess a private pytest basetemp","verify_commands":[]},"source_event_uuids":["f452377c-9206-46b6-8438-77fe269fddfd","c7f21587-c655-4fc4-bcc2-161a54e15727","d0bf89de-d27f-48f9-95d4-c76fb7fc2cdf"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786902578404278001,"uuid":"e9c631c6-a259-4014-8bf3-122895ee2553"}