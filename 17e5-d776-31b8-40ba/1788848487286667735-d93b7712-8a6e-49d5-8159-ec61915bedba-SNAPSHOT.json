eedb41e9eda4b03e7170af233860d0983837bd6548d14f0bcffe","event_uuid":"c32c9b30-3a54-49e2-999e-fa1c4df3b673","position":{"commit_sha":"8078c71f2f7a59fea1cb373a8f7cfc1ab3ff7f7e","position":"1788837904976506401-c32c9b30-3a54-49e2-999e-fa1c4df3b673"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"8f859f7f93a3d467fe03541eefb0fb6c2cc80b2d4e4e623db5a4fa9524ef3c42","event_uuid":"ed20a894-5226-4c04-b5e1-d875159c32b5","position":{"commit_sha":"9fd96670043236b37f48900a73b6bd9ed17c97cd","position":"1788839577832789001-ed20a894-5226-4c04-b5e1-d875159c32b5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"066f216376a285511c1275d517800c1c218bdb175d57669f4c3a81fe57556fc1","event_uuid":"1a27ff79-df44-4f10-9811-e90a7eaae9dd","position":{"commit_sha":"3b4bd26e1cb9ed437596308c46f8d7aefcc3cfee","position":"1788840061197591001-1a27ff79-df44-4f10-9811-e90a7eaae9dd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5326bcea1ca22d1a77289a442d2383de929af66d10fad6d4ecd0aa94c7d5ae8d","event_uuid":"a4c41202-52c9-497b-ba02-ce9052a34f2c","position":{"commit_sha":"270f83ae9932985926ce86ef5245ae3b54aa7cf2","position":"1788840088598495001-a4c41202-52c9-497b-ba02-ce9052a34f2c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"regression","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OBSERVATION\n`review_plan_start` records a local `.rebar/gate_runs/<job_id>` entry as `status=running`, then starts the gate on a background daemon thread (`src/rebar/_mcp_llm.py:_start_gate_job` -> `_spawn_gate_daemon`). `gate_status` (`src/rebar/llm/gate_runs.py:gate_run_status`) resolves a still-`running` index to `stale-running` when `_mcp_inflight.is_job_active(job_id)` is false and the run is older than the 5s grace. That matches the reported job: a running handle became `stale-running`, findings were `run-stale-running`, and no readable `REVIEW_RESULT` or plan-review attestation existed.\n\nHYPOTHESIS\nThe result is lost because the async gate worker is only an in-process daemon thread (`threading.Thread(..., daemon=True)` in `_spawn_gate_daemon`). If the MCP process exits/restarts/is killed before the thread reaches its `finally`, the terminal `record_gate_run(...)`, `handle.complete(...)`, `REVIEW_RESULT`, and signature never happen. A later poll in a fresh process has the stale local `running` index but no live in-flight registry entry, so `gate_run_status` reports `stale-running` rather than an actionable terminal error.\n\nCONFIRMATION\nI reproduced the mechanism without a billable model call in a scratch repo outside the checkout: initialized a rebar store, called `_start_gate_job('plan_review', ..., work=lambda: sleep(60))`, let the Python process exit immediately, slept past `_STALE_GRACE_SECONDS`, then polled `gate_runs.gate_run_status(job_id)` from a new process. It returned `{'status': 'stale-running', 'findings': {'readable': False, 'reason': 'run-stale-running'}, 'durable': ... unsigned/error}`. This would have been disproven if the daemon survived process exit, if the terminal `finally` record appeared, or if durable findings/signature existed. The exact production reason the MCP process died is not encoded in current durable evidence; the reproduced root mechanism is the in-process daemon durability gap.\n\nSUGGESTED FIX DIRECTION\nDo not rely on daemon threads for long gate durability. Move async gates to a process/durable job model with heartbeat + terminal error sidecar/reaper, or at minimum write a recoverable diagnostic terminal record when a running handle goes stale so callers see why no result exists and can safely retry.","timestamp":1788737320069302001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA confirmed from existing investigation: async gate jobs record a local running handle before handing work to an in-process daemon thread. If the MCP process exits before the daemon reaches its finally block, no terminal index record, REVIEW_RESULT sidecar, or attestation is written; a later poll can only see an orphaned running handle. Fix implemented by making gate_status materialize such past-grace orphaned running handles into a persisted failed diagnostic record with an actionable daemon-stopped error, preserving fail-closed behavior and avoiding a misleading lost-result stale-running terminal surface. RED coverage: tests/unit/test_mcp_gate_async.py::test_gate_status_materializes_stale_running_as_failed_diagnostic failed on origin/main with stale-running before the fix.","timestamp":1788825796088453001}],"completion_expectation":"required","created_at":1788538948128699712,"creation_channel":"mcp","deps":[{"link_uuid":"dfb4bd32-82f6-4ae1-9cf4-9bfb35c48609","relation":"discovered_from","target_id":"2af9-0769-6f23-41a8"},{"link_uuid":"80df3557-a2c3-4ef5-b445-88eaf159649a","relation":"relates_to","target_id":"88a1-7f6e-8b26-452e"},{"link_uuid":"c32c9b30-3a54-49e2-999e-fa1c4df3b673","relation":"relates_to","target_id":"1214-cc11-08ab-40ea"}],"description":"## Problem\nAn MCP `review_plan_start` job for ticket `unadhesive-erectable-axolotl` changed from `running` to `stale-running` without writing a readable `REVIEW_RESULT` sidecar or a plan-review attestation.\n\n## Observed\n- Date: 2026-09-04.\n- Job: `1788538783977524160-fd43d54af972425e89d256830684fdf6`.\n- Initial `review_plan_start` returned a normal running handle.\n- The first `gate_status` poll reported `running`, `findings.readable=false`, and an unsigned durable result.\n- The next poll reported `stale-running`, `findings.reason=run-stale-running`, and no signature.\n- An immediately preceding review job on the same ticket completed normally with a structural BLOCK.\n\n## Expected\nThe async daemon records a terminal PASS/BLOCK/ERROR result and readable diagnostic evidence, or the MCP surface returns an actionable cause for the daemon death.\n\n## Reproduction\nEdit a plan after a structural plan-review BLOCK, call `review_plan_start` again for `origin/main`, and poll the returned job with `gate_status`.\n\n## Acceptance Criteria\n- [x] The daemon-death cause is reproducible or identified from durable evidence.\n- [x] A stale async gate records an actionable terminal error or recoverable diagnostic evidence.\n- [x] Regression coverage exercises the stale-running path without a billable external model call.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/gate_runs.py","reason":"settles stale async gate run handles into failed diagnostics"},{"path":"src/rebar/_mcp_llm.py","reason":"updates async gate daemon durability docstring"},{"path":"src/rebar/_mcp_inflight.py","reason":"updates inflight stale-running documentation"},{"path":"src/rebar/_mcp_models.py","reason":"updates GateRunOut status documentation"},{"path":"src/rebar/_mcp_reads.py","reason":"updates gate_status tool documentation"},{"path":"tests/unit/test_mcp_gate_async.py","reason":"adds regression coverage for stale handle materialization"},{"path":"tests/interfaces/facades/test_mcp_output_schema_coverage.py","reason":"updates MCP output schema exemption description"},{"path":"AGENTS.md","reason":"updates async gate status guidance"},{"path":"docs/plan-review-gate.md","reason":"updates async gate status guidance"},{"path":"docs/experiments/plan-review-gate/fixtures/eval_specs/plan-review-E6.eval.yaml","reason":"updates plan-review fixture stale daemon wording"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","1214-cc11-08ab-40ea"],["relates_to","88a1-7f6e-8b26-452e"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"1a27ff79-df44-4f10-9811-e90a7eaae9dd","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["mcp","plan-review","reliability"],"ticket_id":"17e5-d776-31b8-40ba","ticket_type":"bug","title":"MCP async plan-review job loses result as stale-running","verify_commands":[{"command":"pytest tests/unit/test_mcp_gate_async.py tests/interfaces/facades/test_mcp_output_schema_coverage.py -q","dd_id":"AC-REGRESSION","dd_text":"Regression coverage exercises stale-running path without external model calls and schema text remains consistent."}]},"source_event_uuids":["a88dd6c1-d84e-497b-8cca-07369fad0172","56c66673-8c5b-472c-a91a-94fe7fba9033","0396e495-5840-48d9-8cf3-51962b16b27a","ee8176e0-c186-4b8b-a327-1286743eecd4","2e3c0bcf-c8b5-4038-9e72-f8eccb02b49f","ce455809-40ba-4cda-b400-4ada5327e38c","80df3557-a2c3-4ef5-b445-88eaf159649a","65a0d4d3-b834-4ac7-98c8-17c5a1b8cc9d","c32c9b30-3a54-49e2-999e-fa1c4df3b673","ed20a894-5226-4c04-b5e1-d875159c32b5","1a27ff79-df44-4f10-9811-e90a7eaae9dd","a4c41202-52c9-497b-ba02-ce9052a34f2c"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788848487286667735,"uuid":"d93b7712-8a6e-49d5-8159-ec61915bedba"}