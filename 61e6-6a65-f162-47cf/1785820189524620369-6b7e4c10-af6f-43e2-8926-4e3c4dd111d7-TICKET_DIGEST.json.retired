{"author":"Unknown","author_email":"","data":{"content_hash":"4bd7f6089398641b3db3cf68301d8ddb6ed17e35c8434c689670dfe7c741025a","digest":{"component_or_area":"MCP auth framework and static bearer verifier","key_entities":["McpConfig","auth_enabled","auth_strategies","auth_issuer_url","auth_resource_server_url","auth_required_scopes","auth_static_tokens_file","src/rebar/_mcp_auth.py","CompositeTokenVerifier","StaticBearerVerifier","AccessToken","AuthSettings","FastMCP","RFC 9728","RFC 8707","WWW-Authenticate","MCP_ENV_VARS","token_env","token_sha256","client_id","scopes","resource","hmac.compare_digest"],"problem_keywords":["authentication","authorization","token verification","audience validation","bearer token","static token","fail-closed","composite verifier","access control"],"propositions":["A composite token verifier must serve as the single audience and fail-closed choke point, accepting tokens only when resource equals auth_resource_server_url, rejecting on any verifier exception, and returning 401 when no verifier yields a valid matching token","The static bearer verifier must store only SHA-256 digests of tokens (never plaintext), use constant-time comparison, and resolve plaintext from environment variables rather than embedding secrets in configuration files","The auth framework must refuse to start if auth_enabled is true with an empty composite, an unrecognized strategy, or HTTP transport with no verifier wired, ensuring fail-closed behavior at configuration time","No token or secret substring must appear in logs or error messages across composite error handling and verifier failures, enforcing redaction throughout the authentication path","The server must advertise RFC 9728 protected resource metadata with a single authorization_servers entry and respond with 401 + WWW-Authenticate header to unauthenticated requests when auth is enabled"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1785820189524620369,"uuid":"6b7e4c10-af6f-43e2-8926-4e3c4dd111d7"}