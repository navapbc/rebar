YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"98e8c1f953179f475e971293893bb2509e3b373419c320db956b728f9e38b441","event_uuid":"63064f1b-40be-47ca-b13c-e3898c0cd676","position":{"commit_sha":"fed1f8d1166d33842c6da5469d5c7f27d21f0e4d","position":"1795131448290421001-63064f1b-40be-47ca-b13c-e3898c0cd676"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"eefbe854484dca132054a074feb15accdd995b8a45cfa43880f8f962e3ccafb6","event_uuid":"670278f6-aa88-4d63-a83c-ad6613031191","position":{"commit_sha":"5ef5736edf071abcaadf64a0ce39b38c1801f3dc","position":"1795131481129463001-670278f6-aa88-4d63-a83c-ad6613031191"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"env_integration","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Root cause evidence, read from the Windows sweep job logs of runs 43820680079, 43871224211 and the b4e0d01b649 scheduled run (2026-11-15/16). Every failure uses a POSIX-only API on Windows with no Windows path:\n\n1. Product, gate admission: `src/rebar/llm/gate_admission.py:25-28` imports `fcntl` directly (flock at :244, :270) and disarms the concurrency cap when it is absent (:333-336, reason \"advisory locking (fcntl) unavailable\"). Both `test_gate_admission_09da.py` failures assert on that marker. The store already has a portable leg with a Windows `msvcrt.locking` branch, `rebar._store.lock_kernel` (`take_exclusive`/`release_exclusive`/`leg_name`, `src/rebar/_store/lock_kernel.py:111-156`).\n2. Product, grounding harness: `run_in_worker` maps a crash to `parse_error` only for a negative exit code (`src/rebar/grounding/harness.py:385-395`). A native crash on Windows exits with a positive NTSTATUS code (e.g. 0xC0000005), so it would land in `other`. The payload `tests/unit/grounding/_worker_payloads.py:52-65` sends itself `signal.SIGKILL`, absent on Windows (worker \"raised: AttributeError\").\n3. Collection: `tests/unit/test_bridge_runner_spawn.py:201` uses `-signal.SIGKILL` in a module-level parametrize; the collection error (`ERROR tests/unit/test_bridge_runner_spawn.py - AttributeError: module 'signal' has no attribute 'SIGKILL'`) is the only error in the logs of `test_ci_workflow_parity.py::test_make_test_never_selects_a_live_test_even_with_jira_credentials_set` and `test_collection_isolation_guard.py::test_the_live_unit_tier_collects_clean`.\n4. Test stub: `tests/unit/test_spawn_detached.py:83-87` swaps `_proc.subprocess` for a SimpleNamespace with only `Popen`/`DEVNULL`; on Windows `_proc._detach_kwargs` (`src/rebar/_proc.py:112-121`) reads `DETACHED_PROCESS` from it (4 tests); `:123-124` assert POSIX kwargs unconditionally.\n5. POSIX-only legs exercised without a capability guard: fcntl-leg tests patching `_kernel.fcntl.flock` while it is None (`test_lock_stale_reclaim.py` 6, `test_write_lock_busy_probe_7084.py` 2); the fcntl control (`test_fcntl_import_guard.py`); `resource` reads (`test_gate_peak_rss_9ea3.py` 2; product already returns None without `resource`, `src/rebar/llm/peak_rss.py:40-48`); signal-killed children (`test_live_dc_pass_health.py` 2, `test_external_mutation_diagnostics.py` 1); in-process SIGTERM handler grace (`test_mcp_http_transport.py`, `assert 15 == 0`: on Windows `os.kill(pid, SIGTERM)` is TerminateProcess with exit 15, no handler runs); `os.getuid` (`tests/scripts/test_gerrit_object_store_repair.py:72,92`, which runs the Linux host script `infra/scripts/materialize-gerrit-jgit-config.sh` that chowns to uid:gid) and `os.geteuid` (`tests/unit/test_opcert_producer_seam_8d8e.py:517`).","timestamp":1795039171332145673},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed as Gerrit 3436 (3ff84ebc693). make verify: 21,404 passed, 1 failed (test_model_classes.py::test_a_finished_gate_drive_releases_its_event_loop[raised], the known host-load flake tracked by unselfish-finnicky-whooper, unrelated); the integration tier, which that failure stopped make from reaching, was run separately: 226 passed, 2 skipped. Portability: new paths use msvcrt via lock_kernel and os._exit, both present on Windows; no new POSIX-only API.","timestamp":1795049200354576155},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Merged as 4aeb9c0fe23 (Gerrit 3436). First Windows sweep with it, run 44456347985 (job 135332660982, main at ab323f7df0c): every removed posix-api line passed or skipped except 3. (1, 2) The 2 new `test_a_crash_exit_is_described_on_both_platforms[-9-*]` cases expected \"SIGKILL\", but `signal.Signals` has no SIGKILL member on Windows, so the name is \"signal 9\"; test expectation fixed. (3) `test_opcert_producer_seam_8d8e.py::test_orchestrator_degrade_key_unregenerable_records_unsigned` no longer fails on `os.geteuid`; it now reaches a gate-snapshot path longer than MAX_PATH (\"Filename too long\"), so its line moves to `max-path.args` (halfcrazed-rubbly-whimbrel's class). Follow-up Gerrit 3443 (c3f9c1d1621); make verify passed in full, integration tier 226 passed.","timestamp":1795072409090761997},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Windows sweep run 44487190183 (job 135433617476, main at 3f47117c97b, 2026-11-19), with `posix-api.args` deleted: every formerly deselected test passed or skipped on its capability guard, including the fixed harness classifier cases; none is among the run's 13 failures. The job concluded `failure` on 13 tests from other classes (separator/guard tests on arctic-unsecular-esok and obtuse-phenocryst-verdin, a bd66 worker crash on powderblue-effectual-racerunner).","timestamp":1795081741742422693},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Run 44503581058 (job 135490319213, main at 92d3f373e2c): every formerly deselected posix-api test passed or skipped again; the job's 14 failures all belong to other classes. Handoff: only the \"sweep concludes `success`\" clause remains, blocked on arctic-unsecular-esok / obtuse-phenocryst-verdin regressions and 2 new `test_git_ssh_output_encoding.py` failures. Close as `env_integration` once a sweep concludes `success`.","timestamp":1795087067619621608},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Green Windows sweep (cluster A4, session 3d705fec): run 44606030731, `sweep (windows)` job 135849846469, main at a28027d5ec7dcf6bfe286cde926c4ba13ad16672, concluded `success` (20,269 passed, 872 skipped, 0 failed, 2026-11-19 PST). It runs with only `openssh-key-acl.args` and `unclassified.args` deselected.\n- All 28 lines removed from `posix-api.args` (4aeb9c0fe23) ran. None is in an active deselect file and none failed (passed or skipped on a capability guard). `posix-api.args` is absent at a28027d5ec7, and `.github/workflows/test.yml` references only `openssh-key-acl.args` and `unclassified.args`.\nRoot cause and make verify are in the earlier comments. Closing as env_integration.","timestamp":1795124888607021001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"The close refused because commit c6fc7b07a7f (this ticket's follow-up) changed .github/windows-sweep-deselect/max-path.args, which file_impact did not declare. Declared it, with the reason. This is material, so I'm re-running review-plan before the close. No --force.","timestamp":1795130209683010001}],"completion_expectation":"required","created_at":1794857643240118451,"creation_channel":"mcp","deps":[{"link_uuid":"d828e701-850a-40f2-a8ba-73c1143ff56a","relation":"discovered_from","target_id":"6798-606d-37dc-46e7"},{"link_uuid":"56607a75-2fb2-445f-b9f5-1169d92ec142","relation":"relates_to","target_id":"c7f7-f539-6de8-4afd"},{"link_uuid":"c085b662-19b1-4852-bcb6-65eb02b57c06","relation":"relates_to","target_id":"41d3-2eb9-71d3-4ca6"}],"description":"## Context / Problem\n\nDiscovered from majestic-depilatory-beetle. The advisory `sweep (windows)` job deselects tests known to fail on Windows through `.github/windows-sweep-deselect/posix-api.args`. This bug owns that file: 27 `--deselect` lines plus `--ignore=tests/unit/test_bridge_runner_spawn.py`. Each failure uses a POSIX-only API on Windows with no Windows path. The per-test evidence (job logs of runs 43820680079, 43871224211 and the `b4e0d01b649` run) is in the ticket comment \"Root cause evidence\"; in short:\n\n- Product: `src/rebar/llm/gate_admission.py:25-28` imports `fcntl` and disarms the gate cap on Windows (`:333-336`), although `rebar._store.lock_kernel` (`take_exclusive`/`release_exclusive`/`leg_name`, `src/rebar/_store/lock_kernel.py:111-156`) already has a Windows `msvcrt` leg.\n- Product: `src/rebar/grounding/harness.py:385-395` treats only a negative exit code as a crash; a Windows native crash exits with a positive NTSTATUS code (e.g. `0xC0000005`). The payload `tests/unit/grounding/_worker_payloads.py:52-65` uses `signal.SIGKILL`.\n- `tests/unit/test_bridge_runner_spawn.py:201` uses `-signal.SIGKILL` at collection time; that collection error is the sole cause of the `test_ci_workflow_parity.py` and `test_collection_isolation_guard.py` failures.\n- `tests/unit/test_spawn_detached.py:83-87` stubs `subprocess` without the Windows constants `src/rebar/_proc.py:112-121` reads.\n- The other tests exercise POSIX-only legs (fcntl, `resource`, signal death, SIGTERM handlers, `os.getuid`/`os.geteuid`) with no capability guard.\n\n## Approach\n\nFix the product where Windows has a real equivalent; guard tests on the missing capability where the behaviour is POSIX-only by design. This keeps every product guarantee and follows the precedent of `lock_kernel` for the store lock.\n\n- `gate_admission`: drop the `fcntl` import; take and drop slots with `lock_kernel.take_exclusive` (non-blocking on both legs) and `release_exclusive`. Disarm only when `lock_kernel.leg_name() == \"none\"`, reason \"no exclusive file-lock primitive (fcntl or msvcrt) available\". On Windows the cap is then enforced.\n- `grounding.harness`: move exit-status classification into a small pure function that also treats a Windows exit code with NTSTATUS error severity (`>= 0xC0000000`) as a crash (`parse_error`, hex code in `detail`). `hard_crash` keeps SIGKILL on POSIX; on Windows it exits with the access-violation status (`os._exit(-1073741819)`, seen by the parent as `0xC0000005`), the status the harness observes for a real native crash.\n- `test_bridge_runner_spawn.py:201`: literal returncode `-9`.\n- `test_spawn_detached.py`: stub built from `vars(subprocess)` with `Popen` overridden; assert the platform's own detach kwargs.\n- Guards: `skipif(_kernel.fcntl is None)` (fcntl-leg tests); `pytest.importorskip(\"fcntl\")` / `(\"resource\")`; `skipif(not hasattr(signal, \"SIGKILL\"))`; `skipif(os.name == \"nt\")` on the SIGTERM-grace test (Windows `os.kill` is TerminateProcess); `skipif(not hasattr(os, \"getuid\"))` on the Linux host-script test; `not hasattr(os, \"geteuid\") or os.geteuid() == 0` selects the existing simulated branch in `test_opcert_producer_seam_8d8e.py`.\n- Delete `posix-api.args` and its `@` reference in `.github/workflows/test.yml` (`tests/unit/test_windows_sweep_deselect.py` keeps them in step).\n\nPortability: no new POSIX-only API. New paths use `msvcrt` via `lock_kernel` and `os._exit`, both present on Windows. No config key, env var or flag is added.\n\n## Scope\n\n- `src/rebar/llm/gate_admission.py`, `src/rebar/grounding/harness.py`\n- `tests/unit/grounding/_worker_payloads.py`, `tests/unit/grounding/test_harness.py`, `tests/unit/test_gate_admission_09da.py` (no-leg disarm test patches `lock_kernel.fcntl`/`msvcrt` to `None`; the non-blocking spy test spies `lock_kernel.take_exclusive`)\n- `tests/unit/test_bridge_runner_spawn.py`, `tests/unit/test_spawn_detached.py`, `tests/unit/test_lock_stale_reclaim.py`, `tests/unit/test_write_lock_busy_probe_7084.py`, `tests/unit/test_fcntl_import_guard.py`, `tests/unit/test_gate_peak_rss_9ea3.py`, `tests/unit/test_live_dc_pass_health.py`, `tests/unit/test_external_mutation_diagnostics.py`, `tests/unit/test_opcert_producer_seam_8d8e.py`, `tests/interfaces/facades/test_mcp_http_transport.py`, `tests/scripts/test_gerrit_object_store_repair.py`\n- `.github/windows-sweep-deselect/posix-api.args` (deleted), `.github/workflows/test.yml`\n\n## Testing\n\n- New harness classifier tests, run on every platform: a negative exit maps to `parse_error` naming the signal; `0xC0000005` on Windows maps to `parse_error` naming the hex status; exit `3` stays `other`.\n- Gate admission on POSIX: existing congestion and release tests pass through `lock_kernel`; failure path: with both legs patched to `None` admission disarms with the new reason.\n- After merge, a dispatched `sweep (windows)` run on main.\n\n## Acceptance Criteria\n\n- [x] The class's root cause is recorded on this ticket with the evidence that confirmed it.\n- [x] `make verify` passes on the change, including the new harness classifier tests.\n- [x] Every line removed from `posix-api.args` names a test that passed (or skipped with a capability reason) in a `sweep (windows)` run on main after the fix (run id recorded in a comment).\n- [x] `sweep (windows)` concludes `success` on that run, with `posix-api.args` and its `@` reference removed.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/gate_admission.py","reason":"take slots through the portable lock_kernel leg"},{"path":"src/rebar/grounding/harness.py","reason":"classify Windows NTSTATUS crash exits as parse_error"},{"path":"tests/unit/grounding/_worker_payloads.py","reason":"Windows crash payload"},{"path":"tests/unit/grounding/test_harness.py","reason":"classifier unit tests"},{"path":"tests/unit/test_gate_admission_09da.py","reason":"adapt disarm and spy tests to lock_kernel"},{"path":"tests/unit/test_bridge_runner_spawn.py","reason":"collectable on Windows"},{"path":"tests/unit/test_spawn_detached.py","reason":"stub carries platform constants"},{"path":"tests/unit/test_lock_stale_reclaim.py","reason":"fcntl capability guard"},{"path":"tests/unit/test_write_lock_busy_probe_7084.py","reason":"fcntl capability guard"},{"path":"tests/unit/test_fcntl_import_guard.py","reason":"fcntl capability guard"},{"path":"tests/unit/test_gate_peak_rss_9ea3.py","reason":"resource capability guard"},{"path":"tests/unit/test_live_dc_pass_health.py","reason":"SIGKILL capability guard"},{"path":"tests/unit/test_external_mutation_diagnostics.py","reason":"SIGKILL capability guard"},{"path":"tests/unit/test_opcert_producer_seam_8d8e.py","reason":"geteuid capability guard"},{"path":"tests/interfaces/facades/test_mcp_http_transport.py","reason":"SIGTERM handler grace is POSIX-only"},{"path":"tests/scripts/test_gerrit_object_store_repair.py","reason":"Linux host script needs uid:gid"},{"path":".github/windows-sweep-deselect/posix-api.args","reason":"deleted once empty"},{"path":".github/workflows/test.yml","reason":"drop the posix-api argfile reference"},{"path":".github/windows-sweep-deselect/max-path.args","reason":"c6fc7b07a7f added one test_harness line here while that argfile existed; halfcrazed-rubbly-whimbrel later deleted the file (79f46cde8a4)"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","41d3-2eb9-71d3-4ca6"],["relates_to","c7f7-f539-6de8-4afd"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"63064f1b-40be-47ca-b13c-e3898c0cd676","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":["windows","portability"],"ticket_id":"4357-c54c-71b0-4bb4","ticket_type":"bug","title":"Windows sweep: POSIX-only APIs used without a Windows path (28 tests)","verify_commands":[]},"source_event_uuids":["d3b3b4ab-d899-4507-988a-c77a6297291d","8158f34e-c746-4bae-8872-6f2c1093cf50","cd8fef5a-2108-4976-a9bc-99335a5ab99c","71a9525f-5d97-4ece-8598-0353f028de0c","e954a145-c4db-4243-9d71-c2f6585794e7","b16c6ee8-b9cc-487a-9139-0466a0cbb392","506eb6d9-a4ed-4aff-963f-1e997c9f5fe3","b32699b9-b7da-4b3d-8b4b-a189ad379a4f","17efd55b-5a60-4bac-896b-2667a81ba1b9","63064f1b-40be-47ca-b13c-e3898c0cd676","670278f6-aa88-4d63-a83c-ad6613031191"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795131481129463002,"uuid":"31661196-204e-4552-a17b-8ffcc3f61858"}