":"f61606650b36f03ab3431af9fe6f77da9677efeabc61f8d055c1b01bed70db09","tests/scripts/test_observability_marker_anchor_8c2f.py":"ed4ad32fdb310ba6b4153509b0b77c4d01ab74abf4528a8142750e220ead350e","tests/scripts/test_observability_mcp_health_9ea3.py":"5e24f4d8e418c2d6dd6a39bd4147548b93df93db082f38ce858fb306145d93b4","tests/scripts/test_observability_mcp_markers.py":"439f90fc0516615600d705e25bf9b3a324a1de2dbf2302523f6a709424bb0546","tests/scripts/test_observability_memory_9ea3.py":"2100384d60d6986be8700851e9a8aa6170b3a02597d46dd973e4c0ccc5024505","tests/scripts/test_observability_mirror_sync_bff5.py":"9563256697621572fa8c251f20baff9f2fbc7433524794970fc4988a2c23f12e","tests/scripts/test_observability_offsets_6a65.py":"b2925fd0d6ee47c482312e32836ef6bafd684505e58cf269bd9510f367b229b2","tests/scripts/test_observability_reviewbot_webhook_auth.py":"2d2ca20e5dfc44777add4fdde034fac3d8263b83b5ea0856b68a0a9dda9b2513","tests/scripts/test_observability_rotation_2dc7.py":"e9c25127c62934f20720a50fa4554806b1b34621bc3d2d7b94a5ef3aaffefc79","tests/scripts/test_observability_timeout_9313.py":"cd516660cb231502a1c0bd5010ee4f7c466e23bb0858a23a52528fb83c615b7d","tests/scripts/test_observability_var_tmp.py":"0027fbcbd462d5254e11866ce2c03e590102bee28322366f97c0ec40d62f29b0"},"dropped":[{"agreement":1,"block_threshold":0.54,"blocking_enabled":true,"checklist_item":"- [ ] Use env.copy() / SubprocessEnv instead of dict(env) in test_observability_timeout_9313.py's run() so the redacted repr boundary survives.","criteria":["regression","maintainability"],"decision":"dropped","evidence":["tests/scripts/test_observability_timeout_9313.py:161: `run_env = dict(env)`","tests/_subprocess_env.py:19-20: `def __repr__(self) -> str: return f\"{type(self).__name__}(<{len(self)} values redacted>)\"`","Commit message: 'it passes the redacted SubprocessEnv through unwrapped.'"],"finding":"In test_observability_timeout_9313.py the inner run() helper rebuilds the env with `run_env = dict(env)`, downcasting the SubprocessEnv returned by observability_env() to a plain dict. This loses the redacted __repr__ that SubprocessEnv exists to provide, so a subprocess-startup failure in these timeout tests would dump the full inherited environment into pytest's traceback — the exact leak the commit claims to preserve ('passes the redacted SubprocessEnv through unwrapped').","id":"0","impact":0.18,"location":"tests/scripts/test_observability_timeout_9313.py:161","norm_id":"nfa94379598cc6494","priority":0.0771,"reason":"low-validity","scenarios":[],"suggested_fix":"Replace `run_env = dict(env)` with `run_env = env.copy()` (SubprocessEnv.copy preserves the boundary).","tier":"LLM","validity":0.4286,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":true,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"medium","escapes_automation":false,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"none","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}},{"agreement":1,"block_threshold":0.5,"blocking_enabled":true,"checklist_item":"- [ ] Strengthen the docker guard to assert the resolved docker is the harness stub (or a test-owned bin/), not merely 'not equal to the host's PATH-resolved docker'.","criteria":["error-handling"],"decision":"dropped","evidence":["tests/_observability_harness.py:98-99: `host_docker = shutil.which(\"docker\")` / `assert host_docker is None or shutil.which(\"docker\", path=env.get(\"PATH\")) != host_docker`","The positive protection is the stub prepend in observability_env (line 65), but run_observability's own guard only compares against a single host_docker path."],"finding":"The host-docker guard in run_observability short-circuits to pass whenever `shutil.which(\"docker\")` is None (the common CI/macOS case) and otherwise only asserts the env-resolved docker path differs from host_docker. An env PATH that resolves docker to a *different* real host docker binary (second install, symlink to a wrapper) still passes, so the guard cannot distinguish 'docker is safely stubbed' from 'docker resolves to a different real daemon client'.","id":"2","impact":0.225,"location":"tests/_observability_harness.py:98","norm_id":"n0a6e0a45cd20cfa1","priority":0.0964,"reason":"low-validity","scenarios":[],"suggested_fix":"","tier":"LLM","validity":0.4286,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":true,"implicit_coupling":false,"likelihood":"low","prod_impact":"none","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}},{"block_threshold":0.54,"blocking_enabled":true,"criteria":["tests"],"decision":"dropped","evidence":["tests/scripts/test_observability_harness_isolation.py:71: `assert 'INSTANCE_ID_CACHE=\"${INSTANCE_ID_CACHE:-${REGION_CACHE_DIR}/' in SCRIPT.read_text()`","The grepped token `REGION_CACHE_DIR` is an internal shell variable consumed only by bash (infra/scripts/observability.sh:71-73), not by any non-human parser/registry, so it is source-grepping an implementation detail rather than a structural contract.","The adjacent assertions at lines 76-77 (`Path(env['INSTANCE_ID_CACHE']).parent == Path(env['REGION_CACHE']).parent` and `startswith(str(tmp_path))`) already verify the behaviorally-relevant outcome of observability_env without depending on the exact source text."],"finding":"test_the_instance_id_cache_follows_the_redirected_region_cache asserts a verbatim fragment of observability.sh's source text ('INSTANCE_ID_CACHE=\"${INSTANCE_ID_CACHE:-${REGION_CACHE_DIR}/') rather than an observable behavior. This is a source-grep over the script under test coupled to the internal variable name REGION_CACHE_DIR; a behavior-preserving rename of that variable (while still placing instance-id beside the region cache) would break the test even though the harness's explicit INSTANCE_ID_CACHE override keeps isolation intact.","id":"5","impact":0.24,"location":"tests/scripts/test_observability_harness_isolation.py:71","norm_id":"nb6b85960da66c115","priority":0.1029,"reason":"low-validity","standing":{"origin_decision":"advisory","origin_revision":"8e27f801221e621c475fad56ddf71befc8c1f9f8","state":"still-present"},"suggested_fix":"","tier":"LLM","validity":0.4286,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":false,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":true,"likelihood":"low","prod_impact":"none","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}},{"agreement":1,"block_threshold":0.5,"blocking_enabled":true,"checklist_item":"- [ ] Decide whether the installer subprocess.run should also use process-group reaping (run_observability or equivalent), or document why the installer path is exempt.","criteria":["error-handling","regression"],"decision":"dropped","drop_reason":"novelty-region","evidence":["tests/scripts/test_observability_journal_bounding_1205.py:324: `result = subprocess.run([\"bash\", str(INSTALLER)], env=env, timeout=60, check=False)`","tests/scripts/test_observability_harness_isolation.py:139: `if \"observability.sh'\" in source and \"install-observability.sh\" not in source:`","Harness rationale: 'subprocess.run killed only the direct bash, orphaning its subshells at PPID 1.'"],"finding":"The installer run (`subprocess.run([\"bash\", str(INSTALLER)], ...)`) is not routed through run_observability and is deliberately excluded from the harness guard's direct-run scan (via the `install-observability.sh not in source` carve-out). It therefore keeps the pre-change behavior the commit set out to fix: subprocess.run kills only the direct bash and orphans any subshells at PPID 1 on timeout, and it runs with no process-group reaping.","id":"1","impact":0.225,"location":"tests/scripts/test_observability_journal_bounding_1205.py:324","norm_id":"nb0364babd0dd3a61","novelty":1.0,"priority":0.1607,"reason":"default-advisory","scenarios":[],"suggested_fix":"","tier":"LLM","validity":0.7143,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"none","reachable_path_without_automated_coverage":true,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}}],"impact_model_version":"code-v5","indeterminate":[],"model":"bedrock:us.anthropic