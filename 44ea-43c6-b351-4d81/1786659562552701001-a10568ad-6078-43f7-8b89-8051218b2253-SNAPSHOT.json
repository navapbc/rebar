-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b5b742cf7b87dfcc15e6bef9d6700faf7a1755f99b7c0aeb7c0388adce071d96","event_uuid":"51938130-c10d-4174-a618-91a630cec2e1","position":{"commit_sha":"987c2a815e31b5dbd00269e2a268245b410fccf1","position":"1786387503455735001-51938130-c10d-4174-a618-91a630cec2e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5fbcb6079a01195b6d539cc8623de817a66a7ef63cd8e88344624b222cbcc209","event_uuid":"eb86c42b-d75d-4504-baa3-0f64eb555c5a","position":{"commit_sha":"c99c1708df6a90cd66a736fe966e49fa143efc7e","position":"1786387509891527001-eb86c42b-d75d-4504-baa3-0f64eb555c5a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786212578326973001,"creation_channel":"cli","deps":[{"link_uuid":"5f980ef7-b477-4926-a047-4fbe5ac0d248","relation":"discovered_from","target_id":"ae1b-b2a0-a080-4b4e"}],"description":"## Context\nThe architecture is well documented and selected seams have strong bespoke AST negative controls, but there is no repository-wide dependency contract for stable package layers. This leaves new cross-layer imports and cycles outside the specifically protected seams detectable only by review.\n\n## Plan\n- Derive a deliberately small layer model from docs/architecture.md and current package ownership.\n- Encode allowed dependency directions with an import-graph or contract checker.\n- Add known-positive and known-negative fixtures so the checker cannot pass vacuously.\n- Gate only stable boundaries; retain specialized Jira-family and optionality checks.\n\n## Acceptance Criteria\n- [ ] Stable package layers and permitted dependency directions are documented with rationale.\n- [ ] A deterministic repository check rejects a synthetic forbidden edge and accepts a permitted edge.\n- [ ] The check covers production imports without treating facade or documented lazy-import seams as accidental cycles.\n- [ ] CI runs the contract check and reports actionable offending edges.\n- [ ] Existing specialized boundary checks remain green and non-duplicative.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"docs/architecture.md","reason":"Document the enforced stable layer model."},{"path":"tests/interfaces/contracts/","reason":"Add executable dependency contracts and non-vacuity controls."},{"path":".github/workflows/_build-and-test.yml","reason":"Run the repository-wide contract gate in CI."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"eb86c42b-d75d-4504-baa3-0f64eb555c5a","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"idea","tags":["architecture","quality-gate","audit-follow-up"],"ticket_id":"44ea-43c6-b351-4d81","ticket_type":"epic","title":"Define repository-wide package dependency contracts for stable rebar layers","verify_commands":[]},"source_event_uuids":["e0b8d702-3a39-4acc-bdff-e65676770a29","aaf217a4-c654-4e23-bd4c-a9ba3ee5ad40","5f980ef7-b477-4926-a047-4fbe5ac0d248","51938130-c10d-4174-a618-91a630cec2e1","eb86c42b-d75d-4504-baa3-0f64eb555c5a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659562552