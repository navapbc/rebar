r):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                found.append((name,child.lineno,child.end_lineno or child.lineno,child))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    return found\ndef anchor_after(lines,end):\n    i=end\n    while i<len(lines) and (not lines[i].strip() or lines[i].lstrip().startswith(\"#\")):\n        i+=1\n    while i<len(lines) and lines[i].lstrip().startswith(\"@\"):\n        i+=1\n    return \"<EOF>\" if i>=len(lines) else lines[i].strip()\ndef inventory(raw,path):\n    tree=ast.parse(raw,type_comments=True); lines=raw.splitlines(); defs=definitions(tree)\n    scopes=[(\"<module>\",1,max(1,len(lines)))]+[(n,a,b) for n,a,b,_ in defs]\n    docs={}\n    for owner,node in [(\"<module>\",tree)]+[(n,node) for n,_,_,node in defs]:\n        if node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n            expr=node.body[0]\n            docs[owner]={\"raw\":ast.get_source_segment(raw,expr),\"text\":expr.value.value,\"span\":(expr.lineno,expr.end_lineno or expr.lineno)}\n    full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]; row=1\n    while row<=len(lines):\n        if row not in full:\n            row+=1; continue\n        start=row; values=[]\n        while row<=len(lines) and row in full:\n            values.append(full[row]); row+=1\n        owner=min((s for s in scopes if s[1]<=start<=s[2]),key=lambda s:s[2]-s[1])[0]\n        regions.append({\"scope\":owner,\"anchor\":anchor_after(lines,row-1),\"raw\":\"\\n\".join(values),\"text\":\"\\n\".join(values),\"span\":(start,row-1)})\n    cfg=ALLOWED[path]; targets={}; picked=set()\n    for owner in cfg[\"docs\"]:\n        if owner not in docs:\n            raise SystemExit(\"missing allowlisted docstring: \"+path+\"#D:\"+owner)\n        targets[\"D:\"+owner]=docs[owner]\n    for rule in cfg[\"comments\"]:\n        scope,prefix,occ,label=rule\n        matches=[i for i,r in enumerate(regions) if r[\"scope\"]==scope and r[\"anchor\"].startswith(prefix)]\n        if len(matches)<occ:\n            raise SystemExit(\"missing allowlisted comment: \"+path+\"#\"+label)\n        idx=matches[occ-1]\n        if idx in picked:\n            raise SystemExit(\"duplicate comment identity: \"+path+\"#\"+label)\n        picked.add(idx); targets[label]=regions[idx]\n    protected_docs=sorted((k,v[\"raw\"]) for k,v in docs.items() if k not in cfg[\"docs\"])\n    protected_comments=[(r[\"scope\"],r[\"anchor\"],r[\"raw\"]) for i,r in enumerate(regions) if i not in picked]\n    return {\"targets\":targets,\"docs\":protected_docs,\"comments\":protected_comments,\"inline\":inline,\"lines\":lines}\ndef normalized(raw,path):\n    tree=ast.parse(raw,type_comments=True); wanted=set(ALLOWED[path][\"docs\"]); seen=set()\n    def walk(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES) and owner in wanted:\n            if not node.body or not isinstance(node.body[0],ast.Expr) or not isinstance(node.body[0].value,ast.Constant) or not isinstance(node.body[0].value.value,str):\n                raise SystemExit(\"allowlisted leading docstring missing: \"+path+\"#D:\"+owner)\n            node.body=node.body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    if seen!=wanted:\n        raise SystemExit(\"docstring allowlist mismatch: \"+path+\" \"+repr(sorted(wanted-seen)))\n    return ast.dump(tree,include_attributes=False)\ndef directive_signature(raw):\n    lines=raw.splitlines(); out=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not DIRECTIVE.match(tok.string):\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            attach=(\"inline\",left.strip())\n        else:\n            attach=(\"next\",anchor_after(lines,row))\n        out.append((tok.string,attach))\n    return out\ndef expanded_lines(lines,targets):\n    allowed=set()\n    for rec in targets.values():\n        start,end=rec[\"span\"]; allowed.update(range(start,end+1))\n        i=start-1\n        while i>=1 and not lines[i-1].strip():\n            allowed.add(i); i-=1\n        i=end+1\n        while i<=len(lines) and not lines[i-1].strip():\n            allowed.add(i); i+=1\n    return allowed\ndef check_hunks(path,before,after):\n    old_ok=expanded_lines(before[\"lines\"],before[\"targets\"]); new_ok=expanded_lines(after[\"lines\"],after[\"targets\"])\n    diff=subprocess.check_output([\"git\",\"diff\",\"--unified=0\",\"--no-color\",\"HEAD^..HEAD\",\"--\",path],text=True)\n    headers=[line for line in diff.splitlines() if line.startswith(\"@@\")]\n    if not headers:\n        raise SystemExit(\"owned path has no zero-context hunk: \"+path)\n    pattern=re.compile(r\"^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\")\n    for header in headers:\n        match=pattern.match(header)\n        if not match:\n            raise SystemExit(\"unparsed hunk header: \"+path+\" \"+header)\n        old_start=int(match.group(1)); old_n=int(match.group(2) or \"1\")\n        new_start=int(match.group(3)); new_n=int(match.group(4) or \"1\")\n        if old_n and not set(range(old_start,old_start+old_n))<=old_ok:\n            raise SystemExit(\"hunk leaves immutable old spans: \"+path+\" \"+header)\n        if new_n and not set(range(new_start,new_start+new_n))<=new_ok:\n            raise SystemExit(\"hunk leaves allowlisted final spans: \"+path+\" \"+header)\nfor path in sys.argv[1:]:\n    base_raw=source(BASE,path); parent_raw=source(\"HEAD^\",path); final_raw=source(\"HEAD\",path)\n    base=inventory(base_raw,path); parent=inventory(parent_raw,path); final=inventory(final_raw,path)\n    if {k:v[\"raw\"] for k,v in base[\"targets\"].items()}!={k:v[\"raw\"] for k,v in parent[\"targets\"].items()}:\n        raise SystemExit(\"immutable target drift before leaf: \"+path)\n    for key in (\"docs\",\"comments\",\"inline\"):\n        if parent[key]!=final[key]:\n            raise SystemExit(\"protected \"+key+\" changed: \"+path)\n    base_directives=directive_signature(base_raw)\n    if directive_signature(parent_raw)!=directive_signature(final_raw):\n        raise SystemExit(\"directive/shebang text or attachment changed: \"+path)\n    if normalized(parent_raw,path)!=normalized(final_raw,path):\n        raise SystemExit(\"normalized executable AST changed: \"+path)\n    for stable_id,record in base[\"targets\"].items():\n        if len(WORDS.findall(final[\"targets\"][stable_id][\"text\"]))>=len(WORDS.findall(record[\"text\"])):\n            raise SystemExit(\"block not shorter: \"+path+\"#\"+stable_id)\n    check_hunks(path,parent,final)\n' 'tests/unit/test_lock_holder_labelling.py' 'tests/unit/test_lock_retry_zebrafish.py' 'tests/unit/test_lock_stale_reclaim.py' 'tests/unit/test_lock_timeout_names_holder_7084.py' 'tests/unit/test_main_health_report.py' 'tests/unit/test_make_lint_hygiene_wiring.py' 'tests/unit/test_marker_single_emission_f829.py' 'tests/unit/test_max_tokens_model_ceiling_1019.py' 'tests/unit/test_mcp_entrypoint_provi