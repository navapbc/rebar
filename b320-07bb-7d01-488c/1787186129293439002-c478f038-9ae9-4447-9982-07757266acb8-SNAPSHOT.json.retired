25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787186015626303001,"creation_channel":"cli","deps":[{"link_uuid":"342fd806-4fba-40c6-a528-ae9213a790a4","relation":"depends_on","target_id":"a356-d8e4-d970-42a0"}],"description":"## What\n\nChange the emitted verdict `kind` value: `src/rebar/llm/contracts.py:116`,\n`src/rebar/schemas/completion_verdict.schema.json:26,49`, and\n`src/rebar/llm/reviewers/completion_verifier.md:224` (plus its \"Criterion kinds\" section).\n\n## Ordering constraint\n\nBLOCKED BY S2. The reader must accept both values before the emitter changes, or the audit page\nmis-renders one generation of records. The `kind` field is an unconstrained `\"type\": \"string\"`\nwith no enum, so a mismatch fails SILENTLY rather than raising.\n\n## Acceptance Criteria\n\n- [ ] The verifier prompt instructs `codebase-verifiable` or `non-codebase`.\n- [ ] `contracts.py` and the JSON schema describe the same two values.\n- [ ] `tests/unit/test_audit_completion_v2.py` and\n      `tests/unit/test_audit_ticket_page_heldout.py` cover the new value AND retain a legacy\n      `operator-attested` fixture proving old records still render.\n- [ ] The `completion-verifier` eval spec passes; eval case ids remain stable or are renamed\n      deliberately.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/contracts.py","reason":"kind field description"},{"path":"src/rebar/schemas/completion_verdict.schema.json","reason":"kind field description"},{"path":"src/rebar/llm/reviewers/completion_verifier.md","reason":"emitted kind value"},{"path":"tests/unit/test_audit_completion_v2.py","reason":"new value plus legacy fixture"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","a356-d8e4-d970-42a0"],["parent","6f5a-4a49-7bbf-4a30"]],"no_file_impact_reason":"","parent_id":"6f5a-4a49-7bbf-4a30","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"b320-07bb-7d01-488c","ticket_type":"story","title":"S7 — emit kind: non-codebase from the completion verifier","verify_commands":[]},"source_event_uuids":["73b7d93b-22f1-4bf8-befd-f0a8100b1717","342fd806-4fba-40c6-a528-ae9213a790a4","f0fbf59c-3927-4522-9aef-a8cd7791b11a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787186129293439002,"uuid":"c478f038-9ae9-4447-9982-07757266acb8"}