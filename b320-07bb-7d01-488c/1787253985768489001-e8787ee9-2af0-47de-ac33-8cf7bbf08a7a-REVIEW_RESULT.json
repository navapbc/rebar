 schema:49 description, and completion_verifier.md:225's `kind:` line) from `operator-attested` to `non-codebase`; leave the 'Criterion kinds' category-name prose and the line-95 legacy-tag-still-accepted statement intact per ADR 0101 (readers/matcher accept both; only the emitter changes).","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the full old->new kind mapping (both old values -> `codebase-verifiable`/`non-codebase`) so the migration verifies removal of every legacy emitted value, not only that old records still render.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5d","T5e"],"criteria":["E1"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["Title: 'emit kind: non-codebase'","AC: 'The verifier prompt instructs `codebase-verifiable` or `non-codebase`'","AC: 'retain a legacy `operator-attested` fixture proving old records still render'","No stated mapping for the origin of `codebase-verifiable`"],"finding":"The migration's old->new value mapping is incomplete: the plan replaces 