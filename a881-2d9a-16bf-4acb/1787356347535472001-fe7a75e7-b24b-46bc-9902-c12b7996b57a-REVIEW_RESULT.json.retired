e leaf bodies — unlike priority_map, which gets a named resolver (_effective_priority_map_for) and a create_defaults=-analogous param threaded through map_local_to_remote, the Protocol (_backend.py:372), and both backend adapters.","group_criteria":null,"group_id":null,"id":"f374692961b32ab8c","impact":1.0,"is_primary":null,"location":"Approach / Scope 'create_defaults (str-valued ONLY)'; AC test_create_defaults_applied","norm_id":"na719dcae339b306e","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer adds effective_create_defaults + priority_map plumbing but has no named site to inject create_defaults into _map_local_to_jira_fields / _map_local_to_dc_fields, so test_create_defaults_applied cannot be satisfied without inventing an unspecified seam."],"severity":"critical","suggested_fix":"","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an acceptance criterion asserting the parity test (in-module local_to_jira_priority equ