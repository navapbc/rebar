{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787393677222478001,"compiled_state":{"alias":"gold-aciduric-vireo","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"61f7c7c20069d275b5e5f55e944c21f681612ba6","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: a881-2d9a-16bf-4acb","material: 4b806132d4094618","material-part: children 647ea2107ca5072f 0","material-part: description 6bcdd5bdeac55f46 7878","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 72665a266ea10002 3","material-part: ticket_id 6c9e1955416a55da 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (61f7c7c200)","regver: 362a5dd2d2052826","verified-at-sha:0b5356e741629be10c50237f92d99d7800b1a3cf","plan-material-pin: prerequisite bfe7-0900-c3d1-4141 2814cef81e53ef63","dep b356f256553b4d2f6d38683ed4b96144995e0b9de27fa3cade7e8240259901cd src/rebar/_engine/rebar_reconciler/adapters/jira_family/value_maps.py","dep 60cf7ca1dbef6c616382b858d437c4d95f6b4898e497915b20584232e77e443c src/rebar/_engine/rebar_reconciler/config.py","dep absent tests/unit/rebar_reconciler/test_priority_and_create_defaults.py","read-set: 18","read-path: src/rebar/_engine/rebar_reconciler/_backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/outbound_mapper.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/value_maps.py","read-path: src/rebar/_engine/rebar_reconciler/config.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_fields.py","read-path: src/rebar/_engine/rebar_reconciler/mapping_config.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_differ.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_field_diff.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py","read-path: src/rebar/_engine/rebar_reconciler/reconcile_check.py","read-path: tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py","read-path: tests/unit/rebar_reconciler/test_backend_neutrality.py","read-path: tests/unit/rebar_reconciler/test_status_mapping.py","currency-basis: file_impact"],"material_fingerprint":"4b806132d4094618","merged_log_commit":"0b5356e741629be10c50237f92d99d7800b1a3cf","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787357392883408000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"23829b5d4c963410a805c4959cf27a8fc1296bae167db0d34f8c0e362609c450","event_uuid":"2a6828c7-426e-4f00-93ba-8e4bfd679d2f","position":{"commit_sha":"0927115ce1af6f3a077c481f0fb936cb2ed9da2d","position":"1787353651647029001-2a6828c7-426e-4f00-93ba-8e4bfd679d2f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9a650d2da544ecf19bbe57867f692aaa0794a