ype\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"35fb6fe7167e2688fac064bc3cacfb896f61ceeb7e5c25b4d907e104d3f1d37e","event_uuid":"b1814b1d-f38d-4b0d-8a4c-cf7c77330243","position":{"commit_sha":"850113cb9fd5221bd8886092b9acc06a35fd30fa","position":"1787373451628615001-b1814b1d-f38d-4b0d-8a4c-cf7c77330243"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e8e33cf3ba09d9222bd0bb079126f3d27a770ec358d822f7896dbb0794f59312","event_uuid":"772a2315-6e8a-4c6e-87b9-3d4c696f1a87","position":{"commit_sha":"850113cb9fd5221bd8886092b9acc06a35fd30fa","position":"1787373455974275001-772a2315-6e8a-4c6e-87b9-3d4c696f1a87"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"19d567ebb09505d7f1c702725384df2d6db2cf547b143aa418e74d049a034db9","event_uuid":"14819930-4457-40e4-9082-5a970746eee4","position":{"commit_sha":"4d62714303efa5fa8b68810705237800cb3d9bd3","position":"1787379169639111235-14819930-4457-40e4-9082-5a970746eee4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"543eefb4c04722960747b37013b4e95239bfa2eff3cef836b2ff4cfea65151ee","event_uuid":"fff87804-b28a-4fe2-b9bb-6a7bac219e2d","position":{"commit_sha":"9d67944241c082bc599c8f9a0ad9eb5070c0338d","position":"1787382589795477001-fff87804-b28a-4fe2-b9bb-6a7bac219e2d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c9537863085ebe3a37be85a19e3a8c1415329a9151c5c9b5a711c6b22e32679a","event_uuid":"74993c37-9def-40ee-8afe-425630d7cb64","position":{"commit_sha":"ac32ff6a6531823f1a1e2810d4ceb53f91179c53","position":"1787382888386891001-74993c37-9def-40ee-8afe-425630d7cb64"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d305739addebee7f3a02a439b0383f9f3d5e2b4c740768ce47fe00c7b33da4b0","event_uuid":"11145cfd-3d9c-4df4-a17a-7294404178f5","position":{"commit_sha":"0bd034c15e90f9701391ad7a1fb27e871144af36","position":"1787382987030324001-11145cfd-3d9c-4df4-a17a-7294404178f5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"102459908f983d19cb84c221ba82a0e706f96f4b330ebf4aa8a522372339bf04","event_uuid":"1b33a301-3199-417e-bb89-d9bfe0204af4","position":{"commit_sha":"b615105f9a98f42704217f99ee95772cc34202f5","position":"1787382992793726001-1b33a301-3199-417e-bb89-d9bfe0204af4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"FORCE_CLOSE: close gate(s) bypassed by user approval — no completion/signature attestation was signed. Reason: \"Change 2067 MERGED to main; Verified+1 and LLM-Review+1 both green. file_impact widened to 14 paths to match actual commit c530880907, invalidating plan-review attestation (stale-material). Work complete and gate-verified; closing administratively.\". Session: c530880907d.","timestamp":1787382992793726001}],"completion_expectation":"force_bypassed","created_at":1787290322182811001,"creation_channel":"cli","deps":[{"link_uuid":"d9103971-bd0b-4905-b847-d83721d48bb3","relation":"depends_on","target_id":"bfe7-0900-c3d1-4141"},{"link_uuid":"14819930-4457-40e4-9082-5a970746eee4","relation":"relates_to","target_id":"c274-40ed-0762-4df1"}],"description":"# S5 — Config-driven priority mapping + str-valued per-project create_defaults (a881)\n\n## Context / Problem\n\nEpic 3d7a makes rebar↔Jira mappings config-driven over the S1 seam\n(`mapping_config.py`: `MappingLayer` axes, `SKIP`, `resolve_for_project`,\n`validate`). S2 made STATUS config-driven via `config.effective_status_map`\n(`config.py:77`), resolved per project by `outbound_differ._effective_status_map_for`\n(`:272`) and threaded through the backend wrapper/protocol on create+update as an\nOPTIONAL `status_map: dict[str,str] | None = None` kwarg.\n\nS5 makes PRIORITY config-driven the SAME way and adds a str-valued per-project\n`create_defaults` axis. Both axes already exist in `MappingLayer` (both in\n`_AXIS_MAPS`, `mapping_config.py:44`). Priority is a SOFT field: an UNMAPPED\npriority DRIFTS (leave Jira's value, omit the field, warn) — it does NOT fail the\nsync. No priority VOCABULARY axis exists (`validate`, `config.py:328`), so this\nplan carries **no fail-closed claim for priority** — map-or-drift+warn only.\n\n### Verified constraints\n- **Parser is str/SKIP-only** — `_parse_axis_map` (`mapping_config.py:120`) raises\n  on any non-`str`/`SKIP` value, so `create_defaults` is `Mapping[str,str]`;\n  object/array values are inexpressible.\n- **`config.py` imports nothing but `__future__`** and RE-DECLARES status literals\n  in-module (`local_to_jira_status:35`, `jira_to_local_status:64`). Priority\n  follows suit — NO top-level import of `LOCAL_PRIORITY_TO_JIRA`.\n- **Built-in priority map is INT-keyed** `dict[int,str]` 0–4 (`value_maps.py:22`);\n  config `priority_map` is STR-keyed (`_parse_axis_map` does `out[str(key)]`).\n- **ACLI does int-subscript arithmetic** — `acli_cli_ops.py:370`\n  `_LOCAL_PRIORITY_TO_JIRA[int(_id)-1]` (bug 5010-1c6a-9387-4b5b); `:359` +\n  `acli.py:175` int `.get`. Str map breaks these → ACLI LEFT UNCHANGED.\n- **New kwargs are OPTIONAL** (`priority_map=None`, `create_defaults=None`), typed\n  identically to `status_map`, so any Protocol double that omits them still\n  satisfies the Protocol (see Scope → test doubles).\n\n## Approach\n\n**Priority key-type reconciliation (in-module, no import).** Add to `config.py` a\nstr-keyed baseline `local_to_jira_priority: dict[str,str] =\n{\"0\":\"Highest\",\"1\":\"High\",\"2\":\"Medium\",\"3\":\"Low\",\"4\":\"Lowest\"}`, re-declared like\nthe status literals (a parity test pins it against\n`value_maps.LOCAL_PRIORITY_TO_JIRA`). New\n`config.effective_priority_map(project_key, root=None) -> dict[str,str]` mirrors\n`effective_status_map`; consumers look up by `str(priority)`. New shared helper\n`resolve_outbound_priority(value, priority_map) -> str|None` beside\n`resolve_outbound_status` (`outbound_mapper.py:47`): `priority_map.get(str(value))`\n(built-in when `None`); on miss → warn once (`reset_drift_warnings` sink, `:31`)\nand return `None` (DRIFT → OMIT field, never \"Medium\").\n\n**Two named resolvers in `outbound_differ.py`, symmetric with S2's\n`_effective_status_map_for` (`:272`):**\n- NEW `_effective_priority_map_for(ticket, mapping, repo_root)` → `effective_priority_map`.\n- NEW `_effective_create_defaults_for(ticket, mapping, repo_root)` →\n  `config.effective_create_defaults` (create-only).\n\n**Threading seam.** In `outbound_mutation_builders.py`:\n- CREATE (`:88`): resolve both maps and pass `priority_map=` AND `create_defaults=`\n  into the backend `map_local_to_remote` (alongside the existing `status_map=`).\n- UPDATE (`:236`): pass `priority_map=` into `compute_update_fields`\n  (`outbound_field_diff.py:235`, forwarded to `map_fields_to_remote`).\n  `create_defaults` is NOT threaded to update (create-only, echo-safe).\n\n## Scope\n\n**CREATE carriers — gain optional `priority_map=None` + `create_defaults=None`:**\n- `_backend.py:372` — `OutboundMapper` Protocol `map_local_to_remote`.\n- `adapters/jira/backend.py:73` — Cloud `map_local_to_remote` (forwards into leaf).\n- `adapters/jira_datacenter/backend.py:121` — DC `map_local_to_remote` (forwards\n  into `_map_local_to_dc_fields:134`).\n- Leaf bodies: `adapters/jira/outbound_fields.py:_map_local_to_jira_fields`\n  (`:101`, priority `:144`) and `adapters/jira_datacenter/backend.py:\n  _map_local_to_dc_fields` (`:60`, priority `:87`) — each maps priority via\n  `resolve_outbound_priority` and MERGES resolved `create_defaults` FIRST, baseline\n  computed fields winning on collision.\n\n**UPDATE carriers — gain optional `priority_map=None`:**\n- `_backend.py:393` Protocol `map_fields_to_remote`; `adapters/jira/backend.py:92`;\n  `adapters/jira_datacenter/backend.py:136`; leaf\n  `adapters/jira_family/outbound_mapper.py:94`\n  `OutboundFieldMapper.map_fields_to_remote` (priority `:144`).\n\n**Test doubles — mirror S2's status_map set.** S2 added explicit `status_map=None`\nONLY to Protocol doubles with explicit signatures on the threading path; `**kw`\ndoubles absorb new kwargs unchanged. The SAME set gains `priority_map=None`\n(create doubles also `create_defaults=None`):\n- `tests/unit/rebar_reconciler/test_backend_neutrality.py:271` `map_local_to_remote`\n  (carries `status_map=None` at `:279`).\n- `tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py:154`\n  `map_local_to_remote` + `:166` `map_fields_to_remote` (both carry `status_map=None`).\n- SAFE, no edit — the `*a,**k`/`**_kw` fakes already absorb new kwargs:\n  `backend_support.py:148`, `test_rich_text_echo_suppression.py`,\n  `test_rich_text_conflict_safety.py`, `test_inbound_rich_text_echo.py`,\n  `diffing/test_inbound_field_sync_directionality.py:164`,\n  `test_parent_drop_parity_8390.py:395`,\n  `test_parent_emit_suppression_is_loud_9f26.py:89`,\n  `test_live_path_direction_preservation_e6e9.py:50`,\n  `state/test_baseline_advance_aba_e6e9.py:91`,\n  `test_explicit_assignee_resolver_65d7.py:161`. New kwargs default `None` and\n  thread through the identical carriers, so no double lacking `status_map` today\n  (proven off-path by S2) receives `priority_map`.\n\n**Core/config:** `config.py` NEW `local_to_jira_priority`, `effective_priority_map`,\n`effective_create_defaults`; `outbound_differ.py` NEW two resolvers;\n`outbound_mutation_builders.py` thread both maps; `outbound_field_diff.py:\ncompute_update_fields` NEW `priority_map` param.\n\n**LEFT UNCHANGED:** `adapters/jira/acli.py:175`, `adapters/jira/acli_cli_ops.py:\n359,370` (int-keyed int-subscript reverse-id lookup, bug 5010).\n\n**create_defaults (str-valued ONLY).** New `config.effective_create_defaults(\nproject_key, root=None) -> dict[str,str]` (three-layer merge, no vocab gating).\nBaseline (from code): Cloud (`outbound_fields.py:141-149`) summary/description/\nissuetype/priority/assignee/(cond)status/parent; DC (`backend.py:79-92`) same minus\nparent; `project` added by caller. **required-beyond-baseline** = a\ncreatemeta-required field NOT in that set with a plain STRING value. Object/array\nrequireds are inexpressible → OUT of scope, filed as `discovered_from` follow-up.\nUPDATE applies none. No file nears the 800-LOC cap.\n\n## Testing\nUnit only; offline; no network. Fixtures build a `[mapping]` overlay with\n`projects.<KEY>.priority_map` (str keys) and str-valued `.create_defaults`.\n\n## Acceptance Criteria\n- [x] `test_priority_config_effect` — a `projects.KEY.priority_map` str overlay\n      (`\"2\"=\"P2\"`) overrides the str built-in; effective map + all three payload\n      consumers (Cloud create, DC create, update) emit the overlaid name.\n- [x] `test_priority_drifts` — a priority absent from the effective map DRIFTS:\n      `resolve_outbound_priority` returns `None`, the payload OMITS `priority`\n      (never \"Medium\"), a warning is recorded, sync does NOT fail.\n- [x] `test_create_defaults_applied` — exercises the\n      `_effective_create_defaults_for` → `map_local_to_remote` → leaf-body seam:\n      resolved str-valued defaults merge into BOTH create bodies for\n      required-beyond-baseline fields, baseline fields win on collision, and UPDATE\n      applies none.\n\nTest tier: unit","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/_backend.py","reason":"priority create-default plumbing"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"priority mapping in jira backend"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","reason":"resolve outbound priority"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","reason":"priority mapping in DC backend"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_family/outbound_mapper.py","reason":"config-driven priority resolution"},{"path":"src/rebar/_engine/rebar_reconciler/config.py","reason":"resolve priority map + create_defaults"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"thread priority map/create-defaults"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_field_diff.py","reason":"priority field diff"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py","reason":"thread priority into mutations"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py","reason":"priority equivalence updates"},{"path":"tests/unit/rebar_reconciler/test_backend_characterization.py","reason":"priority characterization"},{"path":"tests/unit/rebar_reconciler/test_backend_neutrality.py","reason":"priority neutrality"},{"path":"tests/unit/rebar_reconciler/test_dc_backend_characterization.py","reason":"DC priority characterization"},{"path":"tests/unit/rebar_reconciler/test_priority_and_create_defaults.py","reason":"new priority/create-defaults tests"}],"file_impact_scope":"paths","force_close_reason":"Change 2067 MERGED to main; Verified+1 and LLM-Review+1 both green. file_impact widened to 14 paths to match actual commit c530880907, invalidating plan-review attestation (stale-material). Work complete and gate-verified; closing administratively.","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","bfe7-0900-c3d1-4141"],["parent","3d7a-7795-efde-4df7"],["relates_to","c274-40ed-0762-4df1"]],"no_file_impact_reason":"","parent_id":"3d7a-7795-efde-4df7","parent_status_uuid":"11145cfd-3d9c-4df4-a17a-7294404178f5","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"a881-2d9a-16bf-4acb","ticket_type":"story","title":"Config-driven priority mapping + per-project create_defaults","verify_commands":[]},"source_event_uuids":["2a6828c7-426e-4f00-93ba-8e4bfd679d2f","c3ddc