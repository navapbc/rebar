19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7290c8786cc49fb749f0a0b049f5b474fb07d03d06d5b8b28a188466dda26651","event_uuid":"9cb0d00d-a580-40ca-93e9-4fa5715a91e7","position":{"commit_sha":"e23cbcc27a4e6ad9cad6d0babdacb3bff3d25fa1","position":"1787516600260769001-9cb0d00d-a580-40ca-93e9-4fa5715a91e7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787507522434811001,"creation_channel":"cli","deps":[],"description":"## Context\n\n`templates/rebar-usage.md` currently instructs every project to pass `--assignee <you>` and lists six link relations. The claim command already applies `ticket.default_assignee` when the option is omitted. A repository may leave that setting empty, in which case claim remains valid and records no assignee. An explicit value is an override and must be suitable for the configured Jira bridge when one is present. `templates/AGENTS.md` embeds a synchronized generated region from the usage template. Ticket bilingual-raptorial-furseal deliberately left these templates unchanged because adopter repositories may lack a default assignee. Tickets stun-wraith-conch, weariless-scrapable-mouse, isogonal-wedded-catfish, and dolorous-coverable-mice establish the current behavior and synchronized ownership.\n\n## Plan\n\n- Make the portable claim example omit `--assignee`.\n- Explain the configured default and the valid unassigned result when no default exists.\n- Explain when an explicit Jira-resolvable identity is appropriate without assuming that every client repository uses Jira.\n- Add `caused_by` to the link inventory.\n- Add dependency-ordered plan review guidance that tells clients to review prerequisites before dependents.\n- Synchronize the generated region in `templates/AGENTS.md` through the established template ownership mechanism.\n- Preserve the existing byte-synchronization test and add only focused behavior assertions.\n- Avoid repository-specific Gerrit guidance in the portable template.\n\n## Acceptance Criteria\n\n- [ ] The canonical template presents `rebar claim <id>` as the default command.\n- [ ] The template describes behavior when `ticket.default_assignee` is configured.\n- [ ] The template describes behavior when `ticket.default_assignee` is empty.\n- [ ] Explicit assignee guidance requires a Jira-resolvable identity only when an override is intended.\n- [ ] The link inventory includes `caused_by`.\n- [ ] Plan review guidance requires prerequisites before dependents.\n- [ ] The generated region in `templates/AGENTS.md` matches `templates/rebar-usage.md`.\n- [ ] Focused template synchronization and behavior tests pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"templates/rebar-usage.md","reason":"Correct portable claim, relation, and dependency review guidance at its canonical source."},{"path":"templates/AGENTS.md","reason":"Synchronize the generated rebar usage region from the canonical template."},{"path":"tests/unit/test_client_template_sync.py","reason":"Add focused behavior assertions while preserving byte synchronization coverage."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","b8bf-a5aa-2f4d-44d4"]],"no_file_impact_reason":"","parent_id":"b8bf-a5aa-2f4d-44d4","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","accuracy","f15"],"ticket_id":"20f3-56b5-6e97-4de3","ticket_type":"task","title":"F15 correct portable claim identity guidance","verify_commands":[{"command":"python -m pytest tests/unit/test_client_template_sync.py -q","dd_id":"D1","dd_text":"Template byte parity and behavior"},{"command":"python scripts/check_docs_index.py --check","dd_id":"D2","dd_text":"Documentation links and index"},{"command":"python scripts/check_dco_identity.py","dd_id":"D3","dd_text":"Portable identity guidance"},{"command":"git diff --check","dd_id":"D4","dd_text":"Changed file whitespace"}]},"source_event_uuids":["03c62190-8386-4673-a961-1b15a3261b2e","d883f47c-6c73-488a-acad-f9a7bf50f8a6","346ba329-ab41-4659-977d-faecf5cfa1ee","9cb0d00d-a580-40ca-93e9-4fa5715a91e7"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787519389996019001,"uuid":"65c3c705-4b3d-4f20-b726-e75abd1bcd77"}