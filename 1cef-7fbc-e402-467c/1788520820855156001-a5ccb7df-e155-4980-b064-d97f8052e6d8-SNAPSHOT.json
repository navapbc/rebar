{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788520820855156001,"compiled_state":{"alias":"divinatory-offensive-groundhog","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"46a75bff1b51287a6fdeab3b4aa051c8e9af8d82","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1cef-7fbc-e402-467c","material: 333e05d1ba52be7d","material-part: children 647ea2107ca5072f 0","material-part: description 8a6004ef18a0ac5d 7986","material-part: description_boxes 670af646a34cdc2a 0","material-part: file_impact 3d8ecdd582686fc2 5","material-part: ticket_id e583cd6ebc49a139 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.13.1 (46a75bff1b51-dirty)","regver: aa61189569d34126","verified-at-sha:668523feffde8a561590fd443bdbb24bbb3fef0b","plan-material-pin: prerequisite 67aa-eb04-8814-4975 b2f685fa72c39a27","dep d3d8ab03f9538782a8cf2356a3789fc9c0ae1e75c051e284165c8176e647748c src/rebar/_cli/_llm_eval_commands.py","dep ffa9f5e68e14b9b8d578e12707dc3ae2ff433359b3a9a52310cb3224509cb98c src/rebar/_cli/_parsers/advanced/llm_eval.py","dep a054711cfb7928cc9bc578e8b23fea3e8ca90bcd2fd2f84102fbf15f11aa8214 src/rebar/_config_schema.py","dep absent src/rebar/llm/evals/fixture_mining/heal.py","dep absent tests/unit/test_fixture_heal.py","read-set: 6","read-path: docs/adr/0028-reconciler-bound-but-absent-not-deleted.md","read-path: src/rebar/llm/criteria/overlay.py","read-path: src/rebar/llm/evals/fixture_admission.py","read-path: src/rebar/llm/evals/fixture_emit.py","read-path: src/r