application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9e2aa89eb63d0575ec8761bf8f8682e043c497e89e216dfb67300fd71dad2f65","event_uuid":"890f1aef-1795-4b4b-813c-67e78cb38078","position":{"commit_sha":"ba1468e0c04c8517fc133f7ab7d48333c77ecfb2","position":"1785862124442975001-890f1aef-1795-4b4b-813c-67e78cb38078"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6a960c061a52c29a2676fa36c173102cac39c3af750fe2a9eedb395751fc684b","event_uuid":"cc5ee122-fb62-48c4-b19e-278b713348d9","position":{"commit_sha":"7ab4330ce6598644cda1f035926a0191232edf27","position":"1785862287552352001-cc5ee122-fb62-48c4-b19e-278b713348d9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7aa6444c3d8d001adbdb84845ef787a03460ee13502592322da32d2f0cf606d0","event_uuid":"5a450497-9a3a-4aa0-bc30-c9a4ee441f39","position":{"commit_sha":"0e1d574802e120f71db96e8b425c0d9b26af4176","position":"1785867742111914001-5a450497-9a3a-4aa0-bc30-c9a4ee441f39"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-221_agent","claim_remote_session":null,"claimed_session":"03d46327-27e5-406b-a8f2-adcd55335d05","comments":[],"created_at":1785716307508923001,"creation_channel":"cli","deps":[{"link_uuid":"2458dab6-6e67-411c-80e6-a6c6a90771ba","relation":"discovered_from","target_id":"5200-e04e-246e-4aae"},{"link_uuid":"ceb2eb68-c7de-4029-abc1-7ef30beb16bf","relation":"relates_to","target_id":"fc39-b730-901c-430a"},{"link_uuid":"5ef82bc7-0d6e-4e46-95f1-7740def52494","relation":"relates_to","target_id":"164d-e1b0-d41e-4e16"}],"description":"# Rekey live cell derives a colliding project key ~1 run in 26\n\n## Symptom\n\n`tests/external/live_jira_dc/test_transport.py::test_a_rekeyed_issue_resolves_by_id_and_records_what_the_stale_key_returns`\nfailed on harness run 30772461871 (job 91561874505, main @ bd3de0f864) with its OWN setup assertion:\n\n    >   assert new_project_key != jira_dc_project\n    E   AssertionError: assert 'RBJDRDZ' != 'RBJDRDZ'\n\n48 passed / 1 failed, canary `collected=49 executed=49 skipped=0`.\n\n## Mechanism — a self-collision, not a product defect\n\n`test_transport.py:515-516` derives the rename target by replacing the last character with a literal\n`\"Z\"`:\n\n    new_project_key = (jira_dc_project[:-1] if len(jira_dc_project) >= 4 else jira_dc_project) + \"Z\"\n    assert new_project_key != jira_dc_project\n\nHarness project keys are `RBJ` + 4 random letters (`conftest.py:154,185` — `_PROJECT_KEY_PREFIX` plus\n`_random_project_key`). **When the drawn key already ends in `Z`, the derived \"new\" key is byte-identical\nto the original.** This run drew `RBJDRDZ`, so `RBJDRD` + `Z` == `RBJDRDZ`.\n\nSo the cell is flaky by construction at roughly **1 run in 26** (uniform final letter). It passed on runs\n30765232591 and 30767546938 purely because those draws did not end in `Z`.\n\n## This is NOT a regression, and that matters for reading the run\n\nThe failure is unrelated to anything merged in that tree. Nothing in 1231/1232/1233/1234/1235 touches\n`test_transport.py`, project-key generation, or the rename path; the collision depends only on a random\ndraw. The two cells that DID depend on this session's work both PASSED on the same run:\n`test_outbound_mutation_round_trips[04-transition-status]` and\n`test_the_inbound_assignee_mints_a_jira_family_identity`.\n\n**Credit where due: the cell FAILED SAFE.** Its setup assertion is what caught the collision. Without it\nthe test would have issued `PUT /rest/api/2/project/<key>` renaming the project to the key it already\nhas, and then asserted things about a \"stale\" key that was never stale — a green or a confusing red that\nwould have taught us nothing about the actual contract (7c26's operator-attested question about what a\nstale key returns). The assertion is doing exactly its job; only the derivation is wrong.\n\n## Fix\n\nDerive a target that cannot collide, rather than asserting after the fact. Options, cheapest first:\n* pick a replacement character that differs from the current final character (e.g. `\"Z\"` unless the key\n  already ends in `Z`, in which case `\"Y\"`); or\n* append/rotate rather than substitute, keeping within Jira's project-key constraints (uppercase letters,\n  length limits); or\n* derive the new key from the same `_random_project_key` generator and retry on equality, which reuses the\n  existing validity guarantees instead of hand-rolling a mutation.\nKEEP the `!=` setup assertion whichever is chosen — it is the thing that turned a silent\nnothing-happened rename into a legible failure, and it should stay as the guard.\n\n## Acceptance criteria\n\n- [x] the rename target cannot equal the source key for ANY key the harness can generate, proven by a\n      repo-only unit test over the derivation that includes a key ending in the replacement character\n- [x] the `new_project_key != jira_dc_project` setup assertion is RETAINED, not deleted as redundant\n- [x] the derived key still satisfies Jira's project-key rules (uppercase, length), asserted rather than\n      assumed\n- [x] [operator-attested] the cell passes on a harness run whose project key ends in the replacement\n      character — either by forcing that key for one run or by recording that the derivation test covers\n      it, with the reasoning recorded here\n\n## Criteria met (Gerrit 1370) + AC4 attestation (operator, 2026-08-04)\n\n**AC1 — proven by a repo-only unit test over the derivation, including a key ending in the replacement\ncharacter.** `tests/unit/test_live_dc_rekey_target_d582.py` parametrizes ALL 26 possible final letters,\nso the `Z` case is covered by enumeration rather than by a lucky draw, and names the exact `RBJDRDZ`\nshape separately so the regression is legible in the report. Verified RED before GREEN: against the\npre-fix derivation exactly the `[Z]` case and the explicit `RBJDRDZ` case fail; after it, 54 pass.\n\n**AC2 — the setup assertion is RETAINED.** `assert new_project_key != jira_dc_project` still stands in\nthe cell, and a test asserts its presence in the source. It is what caught the original collision\ninstead of letting the cell rename the project to the key it already had and then assert about a key\nthat was never stale; deleting it as redundant would have removed the only thing that failed safe.\n\n**AC3 — Jira's key rules are asserted, not assumed.** Per final letter: length within 2-10, uppercase,\nletters only, leading letter, and length unchanged from the source (the derivation swaps a character\nrather than growing the key, so a rename cannot push a legal key past the ceiling).\n\n**AC4 — ATTESTED via the route this criterion explicitly permits.** The AC offers two options: force a\n`Z`-terminal project key for one run, OR record that the derivation test covers it with the reasoning\nrecorded here. Taking the second, because it is the stronger of the two:\n\n* the collision depended solely on a random draw with p≈1/26, so a single harness run \"passing\" would\n  have been ~96% likely to draw a NON-`Z` key and therefore prove nothing about the fixed case;\n* forcing a `Z`-terminal key for one run would exercise it once, on a substrate that costs ~41 minutes\n  per attempt and only on the amd64 runner;\n* the unit test exercises the `Z` case on EVERY commit, deterministically, and was demonstrated to go\n  red without the fix.\n\nSo the enumerated repo-only oracle is strictly better evidence than the live run the AC contemplated,\nand it is what this attestation rests on. Harness run **30933704255** additionally exercised the cell\nlive — `test_a_rekeyed_issue_resolves_by_id_and_records_what_the_stale_key_returns` PASSED, its setup\nassertion included — which confirms the derivation works against a real instance, on whatever key that\nrun happened to draw.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"tests/external/live_jira_dc/_dc_support.py","reason":"derive_rename_target: collision-free rename-target derivation, shared and importable so a repo-only test can pin it"},{"path":"tests/external/live_jira_dc/test_transport.py","reason":"rekey cell derives its target through the shared helper; the != safety-net assertion is retained"},{"path":"tests/unit/test_live_dc_rekey_target_d582.py","reason":"repo-only oracle over all 26 final letters incl. the replacement char, plus Jira key-rule assertions"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","e369-a449-4773-48fb"],["relates_to","164d-e1b0-d41e-4e16"],["relates_to","fc39-b730-901c-430a"]],"no_file_impact_reason":"","parent_id":"e369-a449-4773-48fb","parent_status_uuid":"d4ad08e2-f0aa-416d-91db-bf1d52676608","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"d582-fd5a-7ece-4c32","ticket_type":"bug","title":"Rekey live cell can derive a colliding project key (1-in-26 flake)","verify_commands":[]},"source_event_uuids":["23ac1613-a8a6-4948-bec1-f06999c827f8","2458dab6-6e67-411c-80e6-a6c6a90771ba","8a57d8a0-5a42-4d06-8ac9-05822e2d93ef","b6cb88e2-bcef-4bf9-a090-af416959de4a","d4ad08e2-f0aa-416d-91db-bf1d52676608","890f1aef-1795-4b4b-813c-67e78cb38078","cc5ee122-fb62-48c4-b19e-278b713348d9","ceb2eb68-c7de-4029-abc1-7ef30beb16bf","5ef82bc7-0d6e-4e46-95f1-7740def52494","5a450497-9a3a-4aa0-bc30-c9a4ee441f39"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785867742111914002,"uuid":"626b9364-354d-4bf6-8f75-eeed6dd744fd"}