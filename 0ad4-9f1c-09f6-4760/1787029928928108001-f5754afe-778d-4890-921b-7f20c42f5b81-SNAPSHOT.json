 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787028015622391001,"creation_channel":"cli","deps":[],"description":"## Context\nPlanning currently mixes snapshot reads, binding decisions, mode limits, and later handler assumptions. Retry recovery cannot be stable until all decisions derive from one frozen observation.\n\n## Outcome\nDefine immutable `Observation` and `TicketPlan` values and a pure planner that preserves the existing `Mutation` vocabulary/serialization. This task covers deterministic value construction only, not lifecycle dependency logic or preview output.\n\n## Plan\n1. Add frozen provider-neutral observation/version and per-ticket plan types with open payloads.\n2. Build pure planner inputs from local snapshot, remote snapshot, binding read view, mode, selection/filter, and limits.\n3. Refactor existing differ decisions into plan mutation values without filesystem, provider, subprocess, or clock I/O.\n4. Preserve existing mutation serialization and canonical hashes exactly.\n\n## Testing\nFeed frozen fixtures twice and compare immutable plans, hashes, diagnostics, and version identity. Poison all I/O seams.\n\n## Acceptance Criteria\n- [ ] Identical frozen inputs produce equal immutable observations and ticket plans.\n- [ ] Plans carry existing mutations, diagnostics, disposition, and observation/version identity.\n- [ ] Existing mutation serialization and canonical hashes remain byte-identical.\n- [ ] Planner construction performs zero repository saves, ticket writes, Jira calls, subprocess launches, or ambient clock reads.\n- [ ] Provider-specific payload extensions remain open without weakening the provider-neutral core fields.\n\n## Out of scope\nLifecycle intents, inter-ticket dependencies, caps ordering, preview rendering, and shadow cutover.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/observation.py","reason":"Immutable per-pass operation observation."},{"path":"src/rebar/_engine/rebar_reconciler/ticket_plan.py","reason":"Immutable provider-neutral per-ticket plan values."},{"path":"src/rebar/_engine/rebar_reconciler/ticket_planner.py","reason":"Pure planning from one frozen observation."},{"path":"src/rebar/_engine/rebar_reconciler/run_differs.py","reason":"Feed existing differ outputs into the pure planner."},{"path":"tests/unit/rebar_reconciler/orchestrate/test_ticket_plan_shadow.py","reason":"Determinism, serialization parity, immutability, and zero-I/O tests."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","f828-6f5e-3b15-41f5"]],"no_file_impact_reason":"","parent_id":"f828-6f5e-3b15-41f5","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp03","planner","tdd"],"ticket_id":"0ad4-9f1c-09f6-4760","ticket_type":"task","title":"RP-03 S2 T1 — Build immutable observations and pure ticket plans","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/orchestrate/test_ticket_plan_shadow.py -k \"observation or deterministic or serialization or zero_io\"","dd_id":"AC1-AC5","dd_text":"Deterministic immutable plans, mutation parity, zero I/O, and open payloads"}]},"source_event_uuids":["57b106bb-06e5-4b78-8ef1-bb8ea5ff5ab5","f1269fa8-bf28-4dd0-abe2-601dcb551410","873af075-a41e-4052-b0b3-a57cbc6d7d48"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029928928108001,"uuid":"f5754afe-778d-4890-921b-7f20c42f5b81"}