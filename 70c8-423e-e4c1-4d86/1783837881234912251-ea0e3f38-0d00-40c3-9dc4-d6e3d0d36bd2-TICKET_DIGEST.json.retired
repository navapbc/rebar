{"author":"Unknown","data":{"content_hash":"6b73f31c7cc2de632e4292689aefd1f110990e7f1168331fbc935137c021c68a","digest":{"component_or_area":"plan-review and code-review convergence floor gating","key_entities":["remediation_mode","novelty_drop_active","completion_floor_active","VerifyConfig","src/rebar/_config_schema.py","src/rebar/llm/plan_review/__init__.py","src/rebar/llm/code_review/workflow_ops.py","src/rebar/llm/workflow/gate_dispatch.py","_maybe_apply_rising_floor","tests/unit/test_plan_review_rising_floor.py","tests/unit/test_plan_review_remediation_gate.py","docs/config.md","docs/plan-review-gate.md","docs/review-kernel.md","docs/adr/0008-convergent-plan-edit-re-review.md","docs/adr/0037-code-review-novelty-convergence.md","novelty_drop_threshold","novelty_priority_floor","remediation_window_minutes","discriminates_novelty eval"],"problem_keywords":["default flag flip","convergence floor","remediation mode","novelty drop","plan-review gate","code-review floor","verdict instability","operator authorization","docstring sweep","default-ON"],"propositions":["Flip remediation_mode and novelty_drop_active defaults from False to True in VerifyConfig, activating previously-inert convergence floor machinery by default.","The flip is operator-authorized on field evidence, superseding the discriminates_novelty eval prerequisite.","novelty_drop_active is a shared gate consumed by both plan-review and the code-review region-gated floor, so flipping it activates both by default.","All stale default-OFF docstrings and comments across source must be rewritten to default-ON framing with explicit-false named as the back-out.","Docs and ADRs must be updated to reflect the True defaults and record the dated operator-authorized flip.","completion_floor_active stays default False and floor math, thresholds, and eligibility logic are unchanged."]},"digest_hash_version":1,"model":"claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1783837881234912251,"uuid":"ea0e3f38-0d00-40c3-9dc4-d6e3d0d36bd2"}