519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"79c50b5854f8d5de4c83016909df9e8a52c59c652ba15e96602af0135a0453fc","event_uuid":"7045d609-705b-4f44-844f-1762f58079f0","position":{"commit_sha":"425417fe2381bba0a9183a85d26d570ed743740a","position":"1787027590034078001-7045d609-705b-4f44-844f-1762f58079f0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027565716888001,"creation_channel":"cli","deps":[{"link_uuid":"7045d609-705b-4f44-844f-1762f58079f0","relation":"depends_on","target_id":"6083-b802-e90a-416e"}],"description":"## Context\nAbsence grace, retirement/tombstone behavior, explicit unretire, and append-only comment identity remain embedded in the facade after core identity extraction. Their fail-open/fail-closed boundaries are hard-won compatibility behavior.\n\n## Outcome\nMove these state transitions into `BindingLifecycle` without changing thresholds, stored shape, corruption disposition, or facade signatures.\n\n## Plan\n1. Add table tests for confirmed 404 grace, successful-read reset, three-404 retirement, tombstone suppression, explicit unretire, corrupt retired/live data, alert-write failure, and changed/unchanged comment IDs.\n2. Extract the existing absence, retirement, suppression, unretire, and comment-map call clusters.\n3. Keep three confirmed 404s as the retirement threshold; preserve retired corruption and alert-write fail-open behavior and live corruption fail-closed behavior.\n4. Keep comment IDs append-only/change-gated and read old records without eager rewrite.\n\n## Testing\nReload through the repository after transitions and assert bytes, alerts, tombstones, counters, and facade results.\n\n## Acceptance Criteria\n- [ ] Three confirmed 404s retire an issue, while a successful read resets absence state.\n- [ ] Tombstones suppress recreation with an alert until explicit unretire.\n- [ ] Retired corruption and alert-write failures remain fail-open, while live corruption remains fail-closed.\n- [ ] Comment IDs append only when changed and old records without the field remain readable without rewrite.\n- [ ] No lifecycle threshold, stored field, or public method signature changes.\n\n## Out of scope\nInterrupted-retirement recovery and production rich-emission cutover.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_lifecycle.py","reason":"Own absence, retirement, tombstone, unretire, and comment identity policy."},{"path":"src/rebar/_engine/rebar_reconciler/binding_store.py","reason":"Delegate lifecycle methods without changing the facade."},{"path":"tests/unit/rebar_reconciler/state/test_binding_lifecycle.py","reason":"Absence, retirement, tombstone, corruption, and unretire tables."},{"path":"tests/unit/rebar_reconciler/test_binding_store_comment_ids.py","reason":"Append-only comment identity regressions."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","6083-b802-e90a-416e"],["parent","fc1c-1b08-70c2-4afb"]],"no_file_impact_reason":"","parent_id":"fc1c-1b08-70c2-4afb","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp02","binding-lifecycle","tdd"],"ticket_id":"f59b-56c1-596d-422a","ticket_type":"task","title":"RP-02 S2 T2 — Extract absence, tombstone, and comment lifecycle policy","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_binding_lifecycle.py tests/unit/rebar_reconciler/test_binding_store_comment_ids.py","dd_id":"AC1-AC5","dd_text":"Absence, tombstone, corruption, comment identity, and compatibility behavior"}]},"source_event_uuids":["3026a77f-49d5-4b04-8fa1-af6014e5466d","d3cfbe6a-5da6-4dff-b6bd-bf40c93ece67","c6ca71c2-ee55-4387-a8b4-adb8afba6c43","7045d609-705b-4f44-844f-1762f58079f0"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029935659805001,"uuid":"00d2b398-2740-4a49-85c5-6dba213e6a41"}