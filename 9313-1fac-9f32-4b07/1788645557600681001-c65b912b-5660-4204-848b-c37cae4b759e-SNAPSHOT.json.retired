{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788645557600681001,"compiled_state":{"alias":"ignitable-fuchsia-kawala","assignee":"joeoakhart@navapbc.com","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":13,"unsigned":0},"authorship_ledger":[{"content_hash":"a63fa759e12e466a5d4141026f539c629145c293c14ad95aad77f13a300f3a93","event_uuid":"f11992c2-ceca-42e8-8d0c-093b58edbc50","position":{"commit_sha":"502f162168d5ae1a2b4aba10f4161e8b1f6f6249","position":"1788633317277676887-f11992c2-ceca-42e8-8d0c-093b58edbc50"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"15a38a216ae71c257f3a8de9205b1bdca1de76d45bd083d0a6f21a8965ab711c","event_uuid":"d80da885-60bd-427d-b7a1-9d27c593c0be","position":{"commit_sha":"353343b633434270fc3c9ddb2542c4fe714b69c3","position":"1788633425125834155-d80da885-60bd-427d-b7a1-9d27c593c0be"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"58f44b53c9c0f0c9e2eb79f756ee8de8cf13ce2b45be7d8c4aac2c68656e909c","event_uuid":"ed5be577-23cf-4a2e-8c90-ab31fe320575","position":{"commit_sha":"353343b633434270fc3c9ddb2542c4fe714b69c3","position":"1788633425163277695-ed5be577-23cf-4a2e-8c90-ab31fe320575"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8ab0751647bcd031c1938609d939b27fdfb2013c9b1cb675e22fd7192491b796","event_uuid":"ffd36ea6-2225-48f7-9780-a2ec8ec790fb","position":{"commit_sha":"a1549c01ddaeecfb5330555df58991e245a95886","position":"1788633811584367013-ffd36ea6-2225-48f7-9780-a2ec8ec790fb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e14bfefabda7bc48a83fac124fd4d56993a9e04890131197f556d141178666ec","event_uuid":"0d3aa80f-eb79-48ca-8667-2b402cc65ed7","position":{"commit_sha":"2c6c949d814fd8903c6920785f4f4e3d37eb9386","position":"1788633923350050973-0d3aa80f-eb79-48ca-8667-2b402cc65ed7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"452229d9119ba43c39be380eb8889cbef47cc9b4dba57dc62f702b1096fda819","event_uuid":"b4cc1f15-3a27-4752-a7e3-1b443f3f4630","position":{"commit_sha":"d96f88b5f78ab3044c69c02e24a40fb74ce36dd2","position":"1788634197663942069-b4cc1f15-3a27-4752-a7e3-1b443f3f4630"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"877372fc238c51a26f3508080414500f4e461adf38eedc88ec846c219b11c6bc","event_uuid":"7ddc2efb-8573-4ab6-b733-c764b8712dfb","position":{"commit_sha":"810d55aff1c7036e38ce98fee2f47bfe8385b253","position":"1788636486952607236-7ddc2efb-8573-4ab6-b733-c764b8712dfb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1d3d29891735304c96dc33dfeab2437514cfa947bb82904820d7cce5206c5fc5","event_uuid":"12255f43-61cb-4ba5-a502-1871d5f105ec","position":{"commit_sha":"fef4d2f3bba7ebee4efe0b4040de64e52cdcdfd7","position":"1788636581048673587-12255f43-61cb-4ba5-a502-1871d5f105ec"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ebd22416573c7fef82382a2f11600d4aac5bfba76cbe1f2c6ace0a040a5da177","event_uuid":"d4477ec9-2f18-42cd-b258-815d32eae6d9","position":{"commit_sha":"9960d4b997d5fd4309a7d2c8a01bcc380af468f8","position":"1788638792413573298-d4477ec9-2f18-42cd-b258-815d32eae6d9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f0adcee2ff48608fc13e2eabdd17faa448b0af44e3590da70f3ac3a7479f042b","event_uuid":"075af6ad-2314-45bc-8404-26f42b64549e","position":{"commit_sha":"957a6cc7a6a4286bd0ac9b36552af07224a02f52","position":"1788639100430890446-075af6ad-2314-45bc-8404-26f42b64549e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d36b1918f5bb59ebae1c18aa8ad57b53a285c05bc9848b1b2cfffb4f75f62a6d","event_uuid":"8187ced5-b298-440e-8d76-1658a36b761f","position":{"commit_sha":"49ba4b20e04ac36272791d90ea9ee3669e2f39ef","position":"1788642289708744573-8187ced5-b298-440e-8d76-1658a36b761f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"83d85aed7a1dd148267b535026e00faac2dfbc82bfcd2758f31db1d43890eec4","event_uuid":"85359b9b-3afa-42ea-a67a-06acaaeb7d7f","position":{"commit_sha":"6a6c0de0b0f2841742d35880602625d917f5965f","position":"1788643236451905791-85359b9b-3afa-42ea-a67a-06acaaeb7d7f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6bff1d1e27925f43116b6f61b1334d2f8323af2234cabc840a684f33313ed11b","event_uuid":"175013fc-1a7b-4cac-9f0e-559a644bebf1","position":{"commit_sha":"de72f7b73ea62ddfa145291705f769413249d64d","position":"1788643493185828247-175013fc-1a7b-4cac-9f0e-559a644bebf1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Root cause CONFIRMED by per-call measurement on i-00880b2c7f13527c5\n\nMeasured each suspect call individually on the production host (bounded, read-only, SSM).\nWall-clock per call:\n\n| call | measured | bound in probe | completes? |\n|---|---|---|---|\n| `du -sx --block-size=1 /var/lib/docker` | **124.18s** (at a 130s probe bound) | `DOCKER_DU_TIMEOUT=120` | **NO** — always hits the cap |\n| `du -sx --block-size=1 /var/lib/docker/overlay2` | same tree, second walk | `DOCKER_DU_TIMEOUT=120` | **NO** |\n| `docker system df` | **25.01s** (at a 25s bound) | `DOCKER_DF_TIMEOUT=20` | **NO** |\n| `journalctl -u rebar-autodeploy.service -o cat \\| grep -c` | 8.19–14.11s | **unbounded** | yes |\n| `journalctl CONTAINER_NAME=compose-review-bot-1 …` | 4.41s | **unbounded** | yes |\n| `journalctl CONTAINER_NAME=compose-gerrit-1 …` | 8.93s | **unbounded** | yes |\n| `du -sx /var/log/journal` | 0.01s | 60s | yes |\n| `docker ps` / `docker stats --no-stream` | 0.04s / 2.62s | 15s | yes |\n| gerrit/review-bot/MCP curl probes | 0.10s | `--max-time 10` | yes |\n\n### The lead HELD, and it is worse than one `du`\n\n`docker_du_bytes` is called **TWICE** (observability.sh:592-593) — once over `$DOCKER_ROOT` and\nagain over `$DOCKER_ROOT/overlay2`, which is essentially the same ~1.88M-file tree walked a\nsecond time. Each is bounded at `DOCKER_DU_TIMEOUT=120` and each **always hits that bound**:\n\n    592: docker_total_bytes=\"$(docker_du_bytes \"$DOCKER_ROOT\")\"            -> 120s, returns nothing\n    593: docker_overlay2_bytes=\"$(docker_du_bytes \"$DOCKER_ROOT/overlay2\")\" -> 120s, returns nothing\n\n**2 x 120s = 240s = TimeoutStartSec exactly.** The probe is SIGTERM-ed inside or immediately\nafter the second `du`. That is the whole 4-minute wall clock, and because `du` blocks on I/O\nrather than computing, it contributes almost nothing to the ~35s CPU — which is the\nwall-vs-CPU gap in the report.\n\nBeing *bounded* is not being *cheap*: the existing `timeout 120` guard converted an unbounded\nhang into a **guaranteed 120s of burnt budget that returns no value**. Twice.\n\n### Why it is this slow: the unit runs at idle I/O priority\n\n`install-observability.sh` sets `IOSchedulingClass=idle` (and `Nice=10`) on the unit. On a host\nwith documented IOPS-saturation history (`smudgeless-friendless-longspur`), a 1.88M-file walk\nat idle I/O priority is starved by design. So this is not fixable by raising the timeout or by\noptimising computation — both were correctly ruled out in the report.\n\n### Second contributor: 12 full-journal scans, all unbounded\n\nThe journal is **1.7 GB across 38 files**. The probe scans it end-to-end **12 times** in 5\ndistinct shapes — `publish_autodeploy_marker_delta` alone re-reads the identical\n`journalctl -u rebar-autodeploy.service` stream **8 times** (lines 1310, 1312, 1318, 1322, 1330,\n1343, 1348, 1350), plus one at 1301, plus voter/merge (2) and g2p (1). At the measured 8-14s per\nautodeploy scan that is **~110s**, and it is the bulk of the ~35s CPU (journalctl decode + grep).\n\nNeither contributor alone exceeds 240s. **Together they do**: 240 (du) + 20 (df) + ~110 (journal)\n= **~370s of work in a 240s budget.**\n\n### The cut point, and it matches the reported metric ages exactly\n\nMetrics publish in file order. The kill lands at line ~593:\n\n- line 97-237 — `gerrit_healthy`, `reviewbot_healthy`, `GerritReachable`, `mcp_healthy`,\n  `disk_used_percent`, **`root_disk_used_percent` (192)**, `gate_scratch_mounted` — **all publish**.\n- line 597+ — `docker_storage_bytes`, `journal_*`, `var_tmp_*`, `container_*`,\n  **`mem_used_percent` (1020)**, `container_memory_rss_bytes`, `voter_errors`, `deploy_errors`,\n  `g2p_dispatch_errors`, `mirror_out_of_sync` — **never reached**.\n\nThat is precisely the reported evidence: `root_disk_used_percent` fresh at 18:25Z,\n`mem_used_percent` stale. The cut point moves with I/O load, which is why some late metrics\nhave occasional old datapoints rather than none.\n\n### Confirmed still failing right now\n\nJournal, this hour — every run killed at exactly 4min:\n\n    18:20:49 Starting ... 18:24:49 killed 15/TERM, 'timeout', Consumed 39.687s CPU\n    18:25:50 Starting ... 18:29:50 killed 15/TERM, 'timeout', Consumed 34.131s CPU\n    18:31:13 Starting ... 18:35:13 killed 15/TERM, 'timeout', Consumed 39.518s CPU\n\n### One correction to the report\n\n`gerrit_healthy` is published EARLY (line 97) and does survive the kill, so \"no datapoints at\nall\" is not explained by truncation. It is published **with an `InstanceId` dimension** while its\nsibling `GerritReachable` is dimensionless; a query without that dimension returns nothing.\nThat is a query-side artifact, not a second defect in the probe.\n","timestamp":1788633811584367013},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Correction to the previous comment — the journal scans are NOT a contributor\n\nI checked the deployed script against `origin/main` before building on the journal figure, and my\n\"12 unbounded full-journal scans\" was measured against the shape the ticket description cites, not\nagainst the code actually running. `md5sum /usr/local/bin/rebar-observability.sh` matches current\nmain: the marker counters were already converted to **cursor-anchored, bounded** reads by bug\n`1205-63b2-2c01-4e7f` (`journal_marker_delta` uses `--after-cursor` under\n`bounded \"$JOURNAL_SCAN_TIMEOUT\"`, default 10s). There are 7 `journal_marker_delta` call sites,\neach reading only entries since its own cursor. On a healthy box that is a few entries, not 1.7 GB.\n\nThe 8-14s per-scan numbers I measured are what a *full* scan costs; the probe no longer does one.\n**Withdraw that contributor.** The remaining cause stands on its own and is cleaner for it.\n\n## The cause, restated on the corrected evidence: two walks of one tree\n\n    592: docker_total_bytes=\"$(docker_du_bytes \"$DOCKER_ROOT\")\"             # du -sx /var/lib/docker\n    593: docker_overlay2_bytes=\"$(docker_du_bytes \"$DOCKER_ROOT/overlay2\")\" # du -sx the same tree again\n\n`overlay2` is essentially all of `/var/lib/docker`, so this walks ~1.88M files **twice per run**,\neach bounded at `DOCKER_DU_TIMEOUT=120`.\n\n**2 x 120 = 240s = `TimeoutStartSec=240` exactly.** Under I/O contention both walks hit their cap\nand the SIGTERM lands with zero budget left for everything after line 593 — which is every metric\nthe report lists as missing. This is not an approximate fit; it is the timeout to the second.\n\nAnd the second walk buys nothing. The code's own comment says `docker_overlay2_bytes` is\n\"deliberately no longer [participating] in the arithmetic\" — it survives only as a breadcrumb in\none `logger` line. **120s of the 240s budget, in the worst case, is spent on a log message.**\n\n### Frequency, refined\n\n24h on the host: **55 timeout kills against 197 completed runs** (~22%). The kills are *clustered*\n— five consecutive between 18:19 and 18:36 — because they happen when the host is under I/O load.\nWhich is the operator's point: the probe goes blind exactly when the box is in trouble.\n\nCorroborating this, `du` sometimes completes: `docker /var/lib/docker bytes=` breadcrumbs land at\n17:48, 17:58, 18:03, 18:09, 18:42. So the walk ranges from tens of seconds to over the 120s cap,\nand even a \"good\" run spends ~50% of the probe's entire budget in these two calls.\n\n### The unit makes it worse by design\n\n`install-observability.sh` sets `IOSchedulingClass=idle` and `Nice=10`. A 1.88M-file walk at idle\nI/O priority on an IOPS-saturated host is starved deliberately. Correct for a background probe;\nfatal when that probe's tail carries the metrics an operator reads under load.\n\n## Fix, three parts\n\n1. **One walk, not two.** `du -x --max-depth=1 $DOCKER_ROOT` yields the grand total *and* the\n   `overlay2` subtotal from a single traversal. Halves the worst case, 240s -> 120s, and removes\n   the walk that existed only for a log line.\n2. **Deadline-clamped expensive calls with a reserved tail budget.** The script records its start\n   and clamps each expensive call to `min(own timeout, deadline - now - TAIL_RESERVE)`. The `du`\n   can then never consume the budget the later sections need.\n3. **Truncation publishes itself** — `probe_ok` + `probe_elapsed_seconds` on completion, and an\n   `ExecStopPost` hook that publishes `probe_truncated=1` when systemd reports a non-`success`\n   result. systemd runs `ExecStopPost` after a timeout SIGTERM, so a killed run emits its own\n   death certificate.\n\nOn acceptance criterion 4 (positional dependence): choosing **the reserve, not reordering**.\nReordering only moves which metric starves; a guaranteed tail reserve means no metric can be\nstarved by an earlier section overrunning, whatever the order.\n","timestamp":1788633923350050973},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Impact update, measured 18:49 UTC — the alarm surface has degraded further, and it is now overwhelmingly false.\n\n**19 alarms in ALARM.** The metrics behind them:\n\n    data_disk_debris_bytes            journal_cap_in_effect            review_bot_merge_change_errors\n    disk_used_percent                 journal_used_percent             review_interrupts_bound_exceeded\n    docker_buildkit_cache_used_percent  mcp_mem_abort                  review_interrupts_signal_unavailable\n    docker_storage_used_percent       mcp_retire_cap                   var_tmp_cleanup_active\n    docker_unaccounted_bytes          mirror_out_of_sync               var_tmp_used_percent\n    g2p_dispatch_errors               replication_errors               voter_errors\n    gate_scratch_mounted\n\n**Newest datapoint and value for a representative sample:**\n\n    root_disk_used_percent   18:44Z (5 min ago)   = 73\n    mem_used_percent         18:39Z (10 min ago)  = 65\n    voter_errors             18:39Z (10 min ago)  = 0\n    replication_errors       18:39Z (10 min ago)  = 0\n    journal_used_percent     18:39Z (10 min ago)  = 57\n    gerrit_healthy           NO DATA in 4 hours\n\nSo the metrics are publishing, recently, with **healthy values** — zero errors, journal at 57%, memory at 65%, root at 73%. Only two of the nineteen correspond to a real condition: `gate_scratch_mounted` (0, the unmounted volume — `dcc3`) and `var_tmp_cleanup_active` (0, awaiting the `rootflags=pquota` reboot). Both are known and operator-pending.\n\n**Roughly 17 of 19 alarms are reporting a condition that is not true.** Earlier today the same count was 4 of 6. The ratio is getting worse as the probe is killed earlier in its run.\n\n**A second observation that supports the memory-pressure link, and is worth someone testing properly.** `mem_used_percent` stalled completely between 17:40Z and 18:39Z — 49 minutes with no datapoint. It resumed after I restarted the MCP container at ~18:32, which took host memory from 83% used / 990 MB available to 4,314 MB available. That is consistent with the probe getting further through its run when the host is not thrashing, i.e. memory pressure aggravates the I/O stall rather than causing it. One observation, one intervention — suggestive, not established, and the per-section timing this ticket asks for would settle it.\n\n**Why the ratio matters more than the count.** An operator facing 19 alarms of which 17 are false cannot triage by reading the alarm names; they have to go to the datapoints for every one, which is what the alarm surface exists to spare them. I did exactly that three times today and twice nearly drew the wrong conclusion — once treating a cluster of five as a submit-triggered incident, once reading a firing BuildKit alarm as evidence of a real overshoot when it had been red on missing data since the previous evening.","timestamp":1788634197663942069},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Margin measurement, and a third finding the measurement forced\n\nRe-measured on i-00880b2c7f13527c5 at 19:03 UTC, load average 3.45 — representative of the\ncondition that produces the kills.\n\n    95.01s rc=124  timeout 95  du -x --block-size=1 --max-depth=1 /var/lib/docker\n    95.01s rc=124  timeout 95  du -x --block-size=1 --max-depth=1 /var/lib/docker\n   125.03s rc=124  timeout 125 du -sx --block-size=1 /var/lib/docker\n   125.04s rc=124  timeout 125 du -sx --block-size=1 /var/lib/docker/overlay2\n\n**The walk does not complete at any bound.** Not at 95s, not at 125s, twice each. Yet it\ncompletes in well under a minute when the cache is warm (breadcrumbs at 17:48, 17:58, 18:03,\n18:09, 18:42). The reading is **bimodal — fast, or unobtainable** — which retires the idea that\na bigger ceiling buys a reading. It buys only a longer stall. `DOCKER_DU_TIMEOUT` therefore\ngoes to **60**, capturing the fast mode and failing fast in the stalled one; §2e already says a\nmeasurement that could not be taken publishes as silence, and `docker_du_seconds` now says why.\n\n### Third finding: the ceilings were never composed, and the real worst case was ~495s\n\nTiming the tail exposed that `du -sx /var/tmp` **also** exhausts its bound (15.06s at a 15s\nprobe), and that led me to inventory every wall-clock bound in the script rather than only the\none I came for:\n\n| bound | ceiling |\n|---|---|\n| 2 x docker root `du` | 120 + 120 |\n| `docker system df` | 20 |\n| `du /var/log/journal` | 60 |\n| `du /var/tmp` | 60 |\n| per-entry `du -sk` loop | 10 x N |\n| `docker ps` + `docker stats` | 15 + 15 |\n| 7 cursor-anchored journal reads | 7 x 10 |\n| `git ls-remote` | 15 |\n\n**Over 495s of ceilings inside a 240s timeout.** Every one carries a comment justifying itself\nagainst that timeout; the journal section literally reasons \"12 scans x 10 s = 120 s < the\n240 s TimeoutStartSec\" while the docker section was separately entitled to 240s of the same\nbudget. Each ceiling is individually correct and the set is individually wrong. **Nobody was\nadding them up** — that is the defect class, and the double `du` was only the instance that\nhappened to hit first.\n\nSo the fix is not \"make the `du` cheaper\" but \"hold the budget in one place\":\n\n- `probe_budget_left` = `PROBE_DEADLINE_SEC - elapsed - PROBE_TAIL_RESERVE_SEC` (240 - 80).\n- `clamped <ceiling> <cmd>` grants `min(ceiling, budget_left)` and every wall-clock-bounded call\n  in the script now goes through it — all 13 of them.\n- A `clamped` call starting at t cannot end after `deadline - reserve`, and **no sequence of\n  them can either**. The clamped portion of a run is bounded at **160s by construction**, not by\n  estimate.\n\n### Margin\n\n- **Guaranteed: 80s** (240 - 160), and it is structural — it does not depend on how slow the\n  disk gets, because a stalled call is granted less, not more.\n- **Measured typical: ~105s elapsed, so ~135s margin.** From the host, at load average 3.45:\n  docker walk <=60, ledger 15, `/var/log/journal` du 0.01s, `/var/tmp` du ~15, `docker ps` 0.03s,\n  `docker stats` 3.22s, `free` 0.02s, three health curls 0.69s total, `git ls-remote` 0.25s,\n  seven journal reads 0.49-1.69s each.\n- Floor of 1s rather than 0 on an exhausted budget, deliberately: a clamped call must still RUN\n  and fail, because \"could not be measured\" is publishable and being SIGKILLed is not.\n\n### Answering criterion 4 — reserve, not reordering\n\nReordering only changes *which* metric starves. A reserve no earlier section can spend means\nnone can. Pinned by a defect-seeded test: the `du` stub is driven 3s past a 2s budget and the\nassertion is that `mem_used_percent` — the metric that went blind for 49 minutes, and which\nsits ~400 lines after the walk — still publishes, and that `probe_ok` still follows it.\n\n### Criterion 3 — truncation is now a signal\n\n`probe_ok` (once, last), `probe_elapsed_seconds`, and `probe_truncated` from an `ExecStopPost`\nhook that systemd runs even after a timeout SIGTERM. Two alarms in `monitoring_9313.tf`:\n`probe_truncated` (notBreaching — ExecStopPost cannot run if the unit never ran) and the\nmissing-data arm of `probe_ok` (breaching — that is the \"no runs at all\" case).\n\n### Tests\n\n12 new tests in `tests/scripts/test_observability_timeout_9313.py`. Verified RED against\n`origin/main`: **10 of the 12 fail** on the unfixed script, including\n`expected exactly one docker-root walk per run, got ['-sx --block-size=1 /var/lib/docker',\n'-sx --block-size=1 /var/lib/docker/overlay2']`. The 12th is a ratchet asserting no wall-clock\nbound bypasses `clamped`, so the composition hole cannot be quietly reopened.\n","timestamp":1788636581048673587},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Meeting the raised evidentiary bar — hypothesis, in-situ proof, discriminating result, revert condition, mutation check\n\nThe dispatch lead (`du` in `docker_du_bytes`) was treated as a lead. Answering the five points\nin order, and one of them changed my conclusion.\n\n### 1. Falsifiable hypothesis, and what would disprove it\n\n**H:** the wall clock between the unit's `Starting` and its SIGTERM is consumed inside the\ndocker-storage section, specifically in the two `docker_du_bytes` calls at observability.sh:592-593.\n\n**Disproof, stated before the test:** the probe emits `logger -t rebar-health` breadcrumbs at\nfixed line positions. If H holds, a killed run must show breadcrumbs up to *and including* the\ngate-scratch line (:214, the last one before the docker section), then **nothing**, then the\nkill — and must **never** show the `docker /var/lib/docker bytes=` line (:598), which is only\nemitted when the first walk returned a value. **Any** of these would disprove H:\n\n- a killed run showing the `:598` docker breadcrumb (walk finished, time went later);\n- a killed run showing the `buildkit cache` (:619) or `journal ceiling` (:697) breadcrumbs;\n- a killed run whose silence begins *before* the gate-scratch breadcrumb (a network probe);\n- the gap being materially smaller than the run.\n\n### 2. In-situ proof, not isolated re-timing\n\nMy first measurement re-ran the suspect commands standalone. That is inference from\nplausibility, and the objection is right. The probe already instruments itself — timestamped\nbreadcrumbs at known line offsets — so I interleaved `journalctl -t rebar-health` with the unit\nlifecycle over 90 minutes. **Ten consecutive killed runs, one fingerprint:**\n\n    19:29:49  UNIT   Starting rebar-observability.service...\n    19:29:58  CRUMB  gate scratch /var/lib/rebar/gate-scratch mounted=0     <- :214\n              (231 seconds of complete silence)\n    19:33:49  UNIT   Main process exited, code=killed, status=15/TERM\n    19:33:49  UNIT   Failed with result 'timeout'.  Consumed 41.981s CPU time.\n\nIdentical at 18:47:55, 18:52:56, 18:57:56, 19:02:56, 19:08:58, 19:14:58, 19:19:57, 19:25:02,\n19:35:58. Prologue **7-13 s**; then **~231 s / 96% of the run inside one section**; and the\n`:598` breadcrumb **never appears in any killed run**, so the FIRST walk does not complete\neither. 9 + 120 + 120 = 249 against a SIGTERM at 240 — the kill lands mid-second-walk, which is\nwhat the arithmetic predicts.\n\nContrast, the one completed run in the window (18:43): breadcrumbs flow continuously —\n`var_tmp` 18:43:40, `container writable` :41, `memory` :45, four container rows :48-:51 —\nand it consumed **1 min 5.4 s** CPU against the killed runs' 31-46 s.\n\n### 3. Discriminating — the same data refutes the alternatives\n\nThis is not a test that merely fits H; each rival predicts a *different* breadcrumb pattern and\nnone of them occurs:\n\n| rival hypothesis | its prediction | observed |\n|---|---|---|\n| journal marker counters | crumbs through `:697`/`:793`, then silence | never reached |\n| `docker system df` | `:598` present (it precedes the ledger read) | **never present** |\n| a network probe | silence *before* the gate-scratch crumb | crumb always lands, at 7-13 s |\n| general host slowness | prologue also stretched | prologue is 7-13 s |\n\nAnd on \"a fix that lets a stalled probe stall longer\": **this change does not raise the\ntimeout.** `TimeoutStartSec` stays 240. The timeout is not the defect and moving it would only\nmove the kill point, exactly as the report says.\n\n### 4. NEGATIVE RESULT — part of this is a capacity finding, and I am saying so\n\nRemoving the second walk is **not sufficient**, and I would have shipped believing it was if I\nhad stopped at the isolated timings. A **single** walk does not complete at a 95 s bound or at a\n125 s bound (twice each, load average 3.45), and the in-situ data agrees: walk #1 never\nfinished in any killed run. So:\n\n**The Docker root cannot be walked inside this probe's budget under load. That is a capacity\nfinding, not a defect.** ~1.88M files, at `IOSchedulingClass=idle`, on a host with IOPS\nsaturation history.\n\nThe right response to a capacity limit is to stop spending unbounded budget against it, not to\nenlarge the budget. So `DOCKER_DU_TIMEOUT` goes **down** (120 -> 60): the reading is bimodal —\ncache-warm and fast, or unobtainable — and a 120 s attempt that fails costs a minute more than a\n60 s attempt that fails, for no reading either way. When it is unobtainable the §2e rule\napplies: publish silence, and let `docker_du_seconds` say why.\n\n**The genuine defect is the composition**, which the capacity limit merely exposed first: the\nscript held over **495 s** of independently-defensible ceilings inside a 240 s timeout, each\nwith a comment justifying itself against that timeout, and nothing adding them up. `clamped`\nfixes that, and it is the load-bearing part of the change — not the halved walk.\n\n### 5. RED for the right reason, then perturbation\n\n**RED:** 10 of 12 tests fail against `origin/main`, and on the right assertion —\n`expected exactly one docker-root walk per run, got ['-sx --block-size=1 /var/lib/docker',\n'-sx --block-size=1 /var/lib/docker/overlay2']`.\n\n**Perturbation found a real hole before it found teeth.** The portability `timeout` stub this\nsuite inherits is `shift; exec \"$@\"` — it discards the duration — so replacing every `clamped`\nwith `bounded` left all twelve tests green. The mechanism could have been deleted silently. Two\ntests added that measure the **grant** rather than the behaviour: exhausted budget must hand the\nwalk `1`, full budget must hand it `60`. Seven mutations, all killed:\n\n| mutation | killed by |\n|---|---|\n| M1 reintroduce the second walk | `walked_exactly_once` |\n| M2 clamp ignores the budget | `clamp_hands_an_exhausted_budget` (granted 60s) |\n| M3 delete the completion heartbeat | 3 tests |\n| M4 `--report-exit` always reports success | `killed_run_publishes_probe_truncated` |\n| M5 deadline drifts from `TimeoutStartSec` | `probe_deadline_matches_the_unit_timeout` |\n| M6 revert `--max-depth=1` to `-s` | `walked_exactly_once` (shape arm) |\n| M7 one raw `bounded` reintroduced | ratchet + exhausted-budget test |\n\n### Revert condition — what would mean I was wrong\n\nRevert if, after deploy, **any** of these holds:\n\n1. `probe_truncated` still reports 1, or `probe_ok` is still absent, on more than an isolated\n   run. The composition invariant is structural, so this would mean the stall is somewhere I\n   have not clamped — i.e. H was incomplete.\n2. `probe_elapsed_seconds` sits above ~160 s. That is the clamped-portion bound; exceeding it\n   means unclamped work I did not account for dominates.\n3. `mem_used_percent` still shows multi-interval gaps while `probe_ok` reads 1. That would\n   falsify the positional-independence claim directly — the tail would be starving for a reason\n   other than the budget.\n4. The four gap-firing alarms (criterion 6) do not clear on unchanged thresholds. The\n   report's own standard, and the honest test of whether this diagnosis was complete.\n\nExpected and NOT a revert trigger: `docker_storage_bytes` / `docker_unaccounted_bytes` going\nintermittently silent under load, with `docker_du_seconds` at 60. That is the capacity finding\nsurfacing correctly rather than a regression, and it is strictly better than today, where the\nsame walk fails AND destroys the rest of the run. Sizing the Docker root within a probe budget\nis separate work and should get its own ticket.\n","timestamp":1788638792413573298},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## In-situ attribution — the raw evidence\n\nRecording the primary data behind the proof, since the conclusion rests on it.\n\nInterleaved `journalctl -t rebar-health` (the probe's own timestamped breadcrumbs, at known\nline offsets) with the unit lifecycle, 90-minute window, production Gerrit host. Ten\nconsecutive killed runs; here are three verbatim:\n\n    18:47:48  UNIT   Starting rebar-observability.service...\n    18:47:55  CRUMB  gate scratch /var/lib/rebar/gate-scratch mounted=0\n    18:51:49  UNIT   Main process exited, code=killed, status=15/TERM\n    18:51:49  UNIT   Failed with result 'timeout'.  Consumed 45.944s CPU time.\n\n    19:14:49  UNIT   Starting rebar-observability.service...\n    19:14:58  CRUMB  gate scratch /var/lib/rebar/gate-scratch mounted=0\n    19:18:49  UNIT   Main process exited, code=killed, status=15/TERM\n    19:18:49  UNIT   Failed with result 'timeout'.  Consumed 43.266s CPU time.\n\n    19:29:49  UNIT   Starting rebar-observability.service...\n    19:29:58  CRUMB  gate scratch /var/lib/rebar/gate-scratch mounted=0\n    19:33:49  UNIT   Main process exited, code=killed, status=15/TERM\n    19:33:49  UNIT   Failed with result 'timeout'.  Consumed 41.981s CPU time.\n\nAlso at 18:52:56, 18:57:56, 19:02:56, 19:08:58, 19:19:57, 19:25:02, 19:35:58 — same shape every\ntime. Prologue 7-13 s. Then **231 seconds in which the probe emits nothing at all**, and it\nemits nothing because it is inside the docker `du`.\n\nThe completed run at 18:43, for contrast — every breadcrumb after the docker section arrives,\nseconds apart:\n\n    18:43:21  CRUMB  var_tmp /var/tmp budget=unsetB cleanup_active=0 hard_quota=0\n    18:43:40  CRUMB  var_tmp /var/tmp bytes=3841892352\n    18:43:41  CRUMB  container writable share=unsetB reaper_active=0 quota_enforceable=0\n    18:43:45  CRUMB  memory available_percent=34 used_percent=65\n    18:43:48  CRUMB  container compose-review-bot-1 service=review-bot memory_rss_bytes=169659597\n    18:43:49  CRUMB  container rebar-mcp-... service=mcp memory_rss_bytes=1723355628\n    18:43:50  CRUMB  container compose-opcert-1 service=opcert memory_rss_bytes=38702940\n    18:43:51  CRUMB  container compose-gerrit-1 service=gerrit memory_rss_bytes=787585434\n    18:44:12  UNIT   Consumed 1min 5.416s CPU time.\n\nTwo things fall out that I had not measured before.\n\n**The `mem_used_percent` gap is now explained end to end.** It is emitted at 18:43:45 in the run\nthat completes and in none of the ten that do not — a metric published or not published purely\nby whether the `du` in front of it returned. That is the operator-facing consequence in the\nreport, reproduced from the host's own log.\n\n**A complete run costs ~65 s of CPU; a killed one 31-46 s.** So the killed runs are not doing\n*more* work and failing to finish — they are doing *less*, and blocking. The report's\nwall-versus-CPU inference is confirmed from a second direction.\n","timestamp":1788639100430890446},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Independent CloudWatch sweep corroborates the mechanism — plus one thing it does NOT explain\n\nA parallel agent's presence sweep (period=300, 96 buckets/metric, 8 h) landed while this was in\nreview. It is an independent instrument — CloudWatch presence, not the host journal — and it\nmeasures the same thing my breadcrumb trace does, from the other end:\n\n    lines 112-213  (head)         93% present   max gap 10 min\n    line  601  docker_storage     70%                   35 min\n    lines 622/640 buildkit        31%                   60 min\n    line  798  var_tmp_used        0%                    -\n    lines 1193-1301 counters   48-53%                 60-70 min\n    lines 1463/1511 g2p/mirror    43%                   85 min\n\n**Monotone decline in presence with line number.** That is the positional mechanism measured\nfrom the metric side, and it agrees with the journal trace metric-for-metric: 93% at the head,\nfalling off sharply at the docker section (line 601 is the first metric after the walk), and\n`var_tmp_used_percent` at **0%** — a metric that has never once been reached.\n\nTwo consequences worth recording.\n\n**The consumer dependency is satisfied by this change.** A downstream agent has documented an\noperator workaround — \"a reading-alarm firing on absence means the probe could not measure\nthis\" — because with the probe dead before section 2, `disk_used_percent` is absent for reasons\nhaving nothing to do with the volume, and the alarm cannot tell \"the disk is full\" from \"the\nprobe never measured it\". That information is genuinely not in the metric today. `probe_ok`,\n`probe_elapsed_seconds` and `probe_truncated` are in change 2684 and turn that inference into a\nfact. The consumer's guidance can become a lookup instead of a heuristic once it lands.\n\n**NEGATIVE RESULT — the 25-minute HEAD gap is not explained by this root cause, and I am not\nclaiming it.** The same sweep reports the head-of-script max gap widening from 10 to 25 minutes,\nand four false alarms at 20:47Z on missing data while the conditions were verified healthy. The\nhead runs *before* the docker walk: my breadcrumb trace shows the prologue completing in 7-13\nseconds on every one of ten killed runs, and the gate-scratch breadcrumb landing every time. So\na 25-minute head gap is roughly four to five missed runs at the observed 5-6 minute cadence, and\n**my root cause cannot produce it.** Something else is dropping whole runs or failing the\n`aws put-metric-data` calls at the head. That is a second defect and deserves its own ticket\nrather than being folded in here on a plausible story — which is the mistake this whole\ninvestigation exists to correct.\n\nOne checkable prediction rather than a claim: each killed run currently *occupies* 240 s of a\n~300 s timer period, leaving ~60 s of slack, so any additional delay pushes a run into the next\nperiod. After this change a run takes ~105 s, restoring ~195 s of slack. **If the head gap\nnarrows after deploy, cadence pressure was a contributing factor; if it does not, the second\ndefect is independent and the follow-up ticket is required.** Either outcome is informative,\nand `probe_elapsed_seconds` is what will settle it — today the run duration is visible only in\n`systemctl`, never in a metric, which is precisely the gap this change closes.\n\nFiled as **change 2684** — https://rebar.solutions.navateam.com/c/rebar/+/2684\n","timestamp":1788642289708744573},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Is the composition invariant guarded? It is now — and the first version of the guard had a hole\n\nStating this as a decision rather than leaving it implicit: **the invariant is BUILD-ENFORCED,\nnot a convention.** `test_every_wall_clock_bound_goes_through_clamped` is a source scan over\n`observability.sh` that fails if `timeout` or `bounded` appears in command position anywhere\noutside the two lines that form the door (`bounded`'s own definition, and `clamped`'s single\ndelegation to it).\n\nA source scan rather than a runtime check, deliberately: the grant tests observe only the calls\na fixture actually reaches, so a bare `timeout` on a branch behind a host condition the stubs\ndo not produce would pass them. The scan sees every call site whether or not any test executes\nit.\n\n### The guard did not initially hold, and the check is why I know\n\nAsked whether it was guarded, I checked rather than asserted, and the honest first answer was\n**partly**. The original scan matched only `timeout \"$VAR\"` and `bounded <digits>`. So I\nreintroduced the exact shape named as the risk — a bare `timeout 15 docker ps`, which is the\nform two of the original nine ceilings actually had — and:\n\n- the **source scan passed**. It did not see it.\n- the **runtime grant test failed**, catching it by accident of coverage.\n\nCaught by the weaker of the two mechanisms, for a reason that would not generalise. Had that\ncall sat on a branch the fixture does not reach, both would have passed and the composition bug\nwould have been back with no signal. The scan now matches either helper in command position\nwith any argument, and I re-ran the mutations rather than trusting the regex:\n\n| reintroduced shape | before | after |\n|---|---|---|\n| `timeout 15 docker ps` (bare literal) | **MISSED** | caught |\n| `timeout \"$VAR_TMP_DU_TIMEOUT\" du -sx` | caught | caught |\n| `bounded 15 git ls-remote` | caught | caught |\n| `bounded \"$JOURNAL_DU_TIMEOUT\" du -sx` | caught | caught |\n| a brand-new `timeout 30 …` at line start | **MISSED** | caught |\n| a brand-new `timeout 30 …` after a pipe | **MISSED** | caught |\n\nThree of six shapes were invisible to the first version. The scan over-matches and then\nsubtracts the two sanctioned lines by exact text, so a new spelling of the door fails loudly\ninstead of quietly widening it.\n\nThe rationale is now also stated at the definition site in `observability.sh`, so the next\nperson adding a bounded call reads it before the test tells them.\n\n## The accepted degradation is filed\n\n`docker_storage_bytes` / `docker_unaccounted_bytes` going intermittently silent under load is a\n**chosen trade**, and an undocumented regression the moment it lives only in a handoff message.\nFiled as **`utopic-frenzied-albino`** (`5993-4cf7-0de9-4f72`, p2), linked `discovered_from` this\nticket, carrying the 95 s and 125 s negative results, why 60 s is still correct given the\nbimodal distribution, what is lost (`docker_unaccounted_bytes` is the incident metric), four\noptions with none pre-selected, and the alarm question a deliberate non-measurement raises\nagainst `treat_missing_data = \"breaching\"`.\n\nThe distinguishing signal is recorded there and in the script: a gap with `docker_du_seconds`\n≈ 60 and `probe_ok` = 1 is the trade working as designed; a gap with `probe_ok` absent or\n`probe_truncated` = 1 belongs to this ticket's revert conditions.\n","timestamp":1788643493185828247}],"created_at":1788633317277676887,"creation_channel":"mcp","deps":[{"link_uuid":"85359b9b-3afa-42ea-a67a-06acaaeb7d7f","relation":"relates_to","target_id":"a11f-a3a8-9195-443f"}],"description":"## The defect\n\n`rebar-observability.service` does not publish sparsely. It is **killed part-way through every run**,\nand the metrics emitted after the kill point are never published at all.\n\nFrom the host journal, 2026-09-05:\n\n    18:25:50  Starting rebar-observability.service - rebar health + disk observability probe...\n    18:29:50  rebar-observability.service: Main process exited, code=killed, status=15/TERM\n    18:29:50  rebar-observability.service: Failed with result 'timeout'.\n    18:29:50  rebar-observability.service: Consumed 34.131s CPU time.\n\n`systemctl show` gives `TimeoutStartUSec = 4min`. The run above spans **exactly** 18:25:50 -> 18:29:50.\nIt is not finishing late; it is being SIGTERM-ed on the timeout.\n\n**Frequency: 8 timeout failures in a 40-minute window** — i.e. essentially every run, since the timer\nfires about every 5 minutes.\n\n## The decisive measurement: 4 minutes wall-clock, ~35 seconds CPU\n\nConsumed CPU across observed runs: **34.131s** and **39.687s**, against 4 minutes of wall time. So the\nprobe spends roughly **3.4 minutes BLOCKED**, not computing. This is an I/O stall, not a slow script.\n\nThat distinction matters for the fix: raising the timeout would only move the kill point, and making\nthe script computationally faster would not help at all.\n\nPrime suspect, stated as a LEAD: `docker_du_bytes` runs `du -sx --block-size=1` over the Docker root.\nThat tree holds ~1.88M files, and a `du` over it under I/O contention is exactly a multi-minute\nblocking call with near-zero CPU. This host has documented IOPS-saturation history\n(`smudgeless-friendless-longspur`), and an operator `du` on the same tree had to be abandoned for\nrunning long earlier the same day. Confirm before fixing — `GIT_TRACE`-style timing or a per-section\nstopwatch will name the blocking call.\n\n## Why this is the root cause of several open tickets, not a new symptom\n\nMetrics are published SEQUENTIALLY as the script proceeds, so where a metric sits in the script\ndecides whether it survives the kill:\n\n- `root_disk_used_percent` (early) — newest datapoint **18:25Z**, 10 points in 60 min. Healthy.\n- `mem_used_percent` (later) — newest datapoint **17:40Z**. Nothing for ~49 minutes.\n- `gerrit_healthy` (later still) — **no datapoints at all**.\n\nThis explains, with one mechanism, what has been recorded as three separate mysteries:\n\n- `illbred-sour-alpaca` — alarms firing on healthy operation. The empty buckets are not \"cadence\n  aliasing\"; they are the section never running. With `treat_missing_data = \"breaching\"` and\n  `datapoints_to_alarm = 2` of 3, a late-section metric alarms permanently.\n- `enviable-beloved-buffalo` — \"three rebar/host metrics have published nothing for 7+ days\". Those\n  metrics are late in the script. They have not been failing to publish; they have never been reached.\n- The dead-man design from `herbal-garish-monkey` is sound in principle but is being fed by a\n  publisher that silently truncates itself.\n\nMeasured consequence on the live alarm surface: of six alarms in ALARM at 17:09 UTC, only **two** were\ngenuine breaches. The other four fired on gaps while their values were healthy —\n`docker_unaccounted_bytes` read 1.87 GB against a 2 GiB threshold, and BuildKit read 10% against 85.\n\n## Operator consequence, observed first-hand\n\nAn orchestrating session was using `mem_used_percent` to decide when to restart a leaking MCP process.\nThat metric is late in the script, so it went blind for 49 minutes while the leak continued. The\ndecision had to be made by reading the host directly instead. **A probe that truncates itself removes\nexactly the signals an operator reaches for during pressure**, because pressure is what makes the\nprobe slow enough to be killed.\n\n## Acceptance criteria\n\n- [ ] The blocking call is identified by measurement, not inference — per-section timing that names\n      which call consumes the wall-clock gap between ~35s CPU and 4min elapsed.\n- [ ] The probe completes within its timeout under representative load, demonstrated over consecutive\n      runs rather than once. State the margin.\n- [ ] A truncated run cannot be silent: if the probe is killed or exits early, that fact is itself\n      published or alarmed, so \"the section never ran\" is distinguishable from \"the value is missing\".\n      Today they are identical, which is what made this take a day to find.\n- [ ] Metric publication no longer depends on position in the script — either sections are ordered so\n      no metric can be starved, or each publishes independently of the others' progress. State which.\n- [ ] Defect-seeded: force a blocking call to exceed the timeout and confirm the new truncation signal\n      fires and the surviving metrics are correctly attributed.\n- [ ] Re-measure the alarm surface afterwards: the four alarms shown above as firing-on-gaps should\n      clear without their thresholds changing. If they do not, the diagnosis is incomplete.\n- [ ] Portability: host shell + systemd + local validation; no dependence on any single CI provider.\n\n## Testing\n\n1. RED first: instrument the current probe and show a run exceeding 4 minutes with ~35s CPU, killed\n   at the boundary.\n2. Confirm which metrics fall after the kill point and that they match the observed absences.\n3. After the fix, verify late-section metrics publish on consecutive runs, including under induced\n   I/O load.\n\n## Provenance\n\nFound 2026-09-05 while investigating why `mem_used_percent` had stopped publishing. Earlier in the\nsame session the gaps were repeatedly mis-attributed to \"cadence jitter\" and \"sparse publishing\" —\nincluding by me — because a truncated run and a slow publisher are indistinguishable from the metric\nside. The journal is what settles it.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/scripts/observability.sh","reason":"single-pass docker census replacing the double du; whole-probe deadline + clamped; probe_ok/probe_elapsed_seconds/--report-exit"},{"path":"infra/scripts/install-observability.sh","reason":"ExecStopPost truncation hook"},{"path":"infra/terraform/monitoring_9313.tf","reason":"probe_truncated and probe_ok liveness alarms"},{"path":"tests/scripts/test_observability_timeout_9313.py","reason":"regression tests for one-walk, composed budget, truncation signal, defect-seeded starvation"},{"path":"tests/scripts/test_observability_docker_storage.py","reason":"du stub updated to the --max-depth=1 shape"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","a11f-a3a8-9195-443f"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"d80da885-60bd-427d-b7a1-9d27c593c0be","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"9313-1fac-9f32-4b07","ticket_type":"bug","title":"The observability probe blocks on I/O, exceeds its 4-minute systemd timeout and is SIGTERM-ed mid-run, so every metric published after the kill point never appears — this is the root cause of the \"sparse publishing\" behind the dead-man alarms","verify_commands":[]},"source_event_uuids":["f11992c2-ceca-42e8-8d0c-093b58edbc50","d80da885-60bd-427d-b7a1-9d27c593c0be","ed5be577-23cf-4a2e-8c90-ab31fe320575","ffd36ea6-2225-48f7-9780-a2ec8ec790fb","0d3aa80f-eb79-48ca-8667-2b402cc65ed7","b4cc1f15-3a27-4752-a7e3-1b443f3f4630","7ddc2efb-8573-4ab6-b733-c764b8712dfb","12255f43-61cb-4ba5-a502-1871d5f105ec","d4477ec9-2f18-42cd-b258-815d32eae6d9","075af6ad-2314-45bc-8404-26f42b64549e","8187ced5-b298-440e-8d76-1658a36b761f","85359b9b-3afa-42ea-a67a-06acaaeb7d7f","175013fc-1a7b-4cac-9f0e-559a644bebf1"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788645557600681001,"uuid":"c65b912b-5660-4204-848b-c37cae4b759e"}