67.7777777777778,"llm_calls":1,"output_tokens":217.44444444444446,"requests":1},"T6":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1326.6666666666667,"llm_calls":1,"output_tokens":136.0,"requests":1},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1326.6666666666667,"llm_calls":1,"output_tokens":136.0,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1326.6666666666667,"llm_calls":1,"output_tokens":136.0,"requests":1},"prerequisite-consistency":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":5860.0,"llm_calls":1,"output_tokens":465.0,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1326.6666666666667,"llm_calls":1,"output_tokens":136.0,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":96369.0,"llm_calls":1,"output_tokens":4773.0,"requests":7}}}},"findings":[{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate the outbound type-application consumers (adapters/jira/outbound_fields.py, adapters/jira_datacenter/backend.py, and any outbound_differ seam) that must consult the resolved per-project type_map, mirroring the status_map's _effective_status_map_for/resolve_outbound_status path.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["outbound_fields.py:143 `\"issuetype\": _LOCAL_TO_JIRA_TYPE.get(ticket.get(\"ticket_type\", \"task\"), \"Task\")`","jira_datacenter/backend.py:86 same construct","status precedent: outbound_differ._effective_status_map_for -> outbound_mapper.resolve_outbound_status; Scope lists only config.py/value_maps.py/inbound_fields.py"],"finding":"The outbound type-remap consumer sites are not enumerated. The plan says a mapped type is remapped 'through the real path', but the local->Jira type application lives OUTSIDE the four scoped files — adapters/jira/outbound_fields.py:143 and adapters/jira_datacenter/backend.py:86 both call `_LOCAL_TO_JIRA_TYPE.get(ticket.get('ticket_type','task'),'Task')`. For the remap to take effect these sites (or a new effective_type_map seam analogous to _effective_status_map_for) must consult the resolved per-project type_map.","group_criteria":null,"group_id":null,"id":"f34cb7d8521914184","impact":1.0,"is_primary":null,"location":"Scope; Approach ('a mapped type is remapped')","norm_id":"na96f58c8e4ef4801","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["type_map.epic='Initiative' is configured but outbound still emits 'Epic' because neither outbound_fields nor the DC backend was changed to consult the effective map"],"severity":"critical","suggested_fix":"Add an `effective_type_map(project_key, root)` in config.py plus an `_effective_type_map_for` seam in outbound_differ, and update both outbound_fields.py and jira_datacenter/backend.py to resolve issuetype through it.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the stamp attribution: add outbound_labels.py (a rebar-type: analog of _desired_status_annotation/_diff_status_annotation_labels) and the outbound_differ.py invocation site to Scope, since inbound_fields.py holds only inbound recovery.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["outbound_labels.py:89 `_desired_status_annotation`, :114 `_diff_status_annotation_labels` — the stamp/diff machinery","inbound_fields.py:152 recover_status_label is inbound-only","outbound_differ.py:761 comment 'status annotation labels (rebar-status:blocked/cancelled)' — the outbound invocation site"],"finding":"The plan misattributes the rebar-type: label STAMPING machinery to inbound_fields.py. inbound_fields.py holds only inbound RECOVERY (recover_status_label). The rebar-status: STAMPING it claims to mirror lives in outbound_labels.py (_desired_status_annotation / _diff_status_annotation_labels) and is invoked from outbound_differ.py — neither is in Scope, so there is no listed home for emitting the new rebar-type: label.","group_criteria":null,"group_id":null,"id":"f49c16d3475c6cafc","impact":1.0,"is_primary":null,"location":"Approach ('stamp a rebar-type:<local> label ... mirroring the existing rebar-status: label machinery in inbound_fields.py'); Scope","norm_id":"nab5379efb1648f51","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Collapsed types are never stamped with rebar-type: because outbound_labels.py/outbound_differ.py were treated as out of scope"],"severity":"critical","suggested_fix":"Move the 'stamp' half to outbound_labels.py + outbound_differ.py and keep only rebar-type: recovery in inbound_fields.py.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate every _EXCLUDED_PREFIXES site (outbound_labels.py, inbound_collection_diffs.py, differ.py, inbound_translate.py, reconcile_check.py) that must add the 'rebar-type:' prefix so the new label is not synced as a user tag / does not produce spurious REMOVEs.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["outbound_labels.py:34 `_EXCLUDED_PREFIXES = (\"rebar-id:\", \"rebar-id-\", \"imported:\", \"rebar-status:\")`","inbound_collection_diffs.py:88 same tuple","differ.py:105 'rebar-status:'","inbound_translate.py:58 'rebar-status:'","reconcile_check.py:90 exclusion-prefix discussion"],"finding":"The new rebar-type: label prefix is not enumerated for the label-exclusion filters that keep rebar-status: from leaking. The bridge-internal prefix set _EXCLUDED_PREFIXES appears in outbound_labels.py:34, inbound_collection_diffs.py:88, differ.py:105, inbound_translate.py:58 and reconcile_check.py:90 — all currently containing 'rebar-status:'. Without adding 'rebar-type:' to each, the new label will sync as a user tag and/or generate spurious REMOVE mutations.","group_criteria":null,"group_id":null,"id":"f32a817283ad0c405","impact":1.0,"is_primary":null,"location":"Scope (omits label-exclusion filter modules)","norm_id":"n487430df118fe936","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A ticket stamped rebar-type:story is diffed as a user tag ADD locally, or a spurious REMOVE fires each pass — the exact class of bug the rebar-status: exclusions were added to prevent"],"severity":"critical","suggested_fix":"Add 'rebar-type:' to _EXCLUDED_PREFIXES in all five modules and add them to Scope.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"system","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate the sync-decision consumer (outbound_differ.py compute_outbound_mutations / _compute_outbound_select_absent_gets) that must combine EXCLUDED_SYNC_TYPES with the per-project skip-mapped types, since the current consumer takes a project-agnostic frozenset.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["outbound_differ.py:374 `excluded_sync_types: frozenset[str] = _load_config().EXCLUDED_SYNC_TYPES`","outbound_differ.py:378 `_compute_outbound_select_absent_gets(... excluded_sync_types ...)`","config.EXCLUDED_SYNC_TYPES is a project-agnostic frozenset"],"finding":"The per-project type-skip consumer is not enumerated. The plan extends EXCLUDED_SYNC_TYPES 'at per-project granularity', but EXCLUDED_SYNC_TYPES is consumed in outbound_differ.py:374 (`_load_config().EXCLUDED_SYNC_TYPES`) and passed into _compute_outbound_select_absent_gets — a frozenset with no project dimension. Making the skip per-project requires threading the project key / resolved skip set into that consumer, which lies outside the scoped files.","group_criteria":null,"group_id":null,"id":"f12576491e85e0967","impact":1.0,"is_primary":null,"location":"Scope; Approach ('extends the excluded-from-sync behavior (EXCLUDED_SYNC_TYPES) at per-project granularity')","norm_id":"n4be90670573f9263","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["type_map.story='skip' is configured for project A only, but the skip is applied globally (or not at all) because outbound_differ still reads the flat frozenset"],"severity":"critical","suggested_fix":"Add outbound_differ.py to Scope and derive the effective excluded set as EXCLUDED_SYNC_TYPES ∪ {t for t,v in effective type_map if v==SKIP} keyed by the ticket's project.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify HOW the fail-closed check enumerates the set of local rebar types it must cover (validate has no such domain today — it only checks config values against declared vocab), or name the new input/seam that supplies the local-type universe to the load-time guard.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["mapping_config.py:328-359 `validate()` only runs `_check_capability` and `_check_vocab`; `_check_vocab` iterates `axis.items()` (config-supplied entries) and checks VALUES are in `vocab` — it never enumerates the set of local types that must be covered","The parallel status axis (config.py:77 `effective_status_map`, outbound_mapper.py:47 `resolve_outbound_status`) uses map-or-drift (omit + warn), NOT a fail-closed load error, so there is no existing precedent for load-time exhaustiveness the plan can simply reuse","The plan does not name the source of the local-type domain that `validate` would compare the resolved type_map against"],"finding":"The plan routes fail-closed detection of an unmapped non-skipped type through S1 `validate`, but `validate` as implemented only checks config-supplied map values against a declared vocabulary and capability gating — it has no knowledge of the universe of local rebar ticket types, so it cannot by itself detect a local type that has no mapping entry.","group_criteria":null,"group_id":null,"id":"f3e162dc0b0acec4a","impact":1.0,"is_primary":null,"location":"Approach — 'an unmapped, non-skipped type is a fail-closed load error (surfaced by S1 validate)'","norm_id":"nb97619d04776817b","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A Jira project config omits `story` from type_map and does not map it to skip; the author expects a load-time error but `validate` passes because no config entry references an undeclared vocabulary value"],"severity":"critical","suggested_fix":"State that fail-closed requires passing the full set of local rebar types (rebar.types) into the validation step and asserting every non-skipped local type resolves to a target — distinguishing this from validate's existing config-value-vs-vocab check.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State whether the create-path `.get(ticket_type, 'Task')` default coercion (outbound_fields.py:143 and the DC backend copy) is removed/replaced so runtime type resolution cannot silently coerce an unmapped type to Task, keeping runtime consistent with the load-time fail-closed guarantee.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["adapters/jira/outbound_fields.py:143 `\"issuetype\": _LOCAL_TO_JIRA_TYPE.get(ticket.get(\"ticket_type\", \"task\"), \"Task\")` silently defaults any unmapped type to Task","jira_datacenter/backend.py imports the same `_LOCAL_TO_JIRA_TYPE` (search hit) — a second create path with the same `.get(..., default)` risk","The plan's Scope lists value_maps.py ('built-in default becomes injected fallback') but does not mention removing the `\"Task\"` fallback at the two create call sites"],"finding":"The 'never a silent drift' fail-closed guarantee is contradicted by the existing runtime create paths, which coerce an unmapped local type to a default 'Task'; the plan does not state this default coercion must be removed or reconciled with the load-time guard.","group_criteria":null,"group_id":null,"id":"f09c11ca6cfdebba7","impact":1.0,"is_primary":null,"location":"Approach — 'an unmapped, non-skipped type is a fail-closed load error ... never a silent drift'","norm_id":"na348d7d10e1958b4","priority":0.8,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["The load-time guard is bypassed (e.g. a code path builds the mapper without running validate, or a type appears at runtime that was not present at load) and the create path silently emits Task instead of failing"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] Re-derive the rebar-type: label inventory from the symbol graph: add outbound_labels.py (stamp/diff machinery, the outbound half of the round-trip) and every reconciler-managed label-exclusion filter that rebar-status: appears in (differ.py, inbound_translate.py, inbound_collection_diffs.py, reconcile_check.py, apply_inbound_events.py) to Scope, or justify each omission.","cohort":["project.symbol-reference-completeness"],"criteria":["project.symbol-reference-completeness"],"decision":"advisory","decision_margin":0.0,"drop_reason":null,"evidence":["Plan Scope names only: config.py, value_maps.py, inbound_fields.py, and the new test.","Plan Approach: 'stamp a rebar-type:<local> label (new, mirroring the existing rebar-status: label machinery in inbound_fields.py) so inbound recovers the original rebar type.'","search_files for 'rebar-status' shows the prefix registered in outbound_labels.py:34/86, differ.py:105, inbound_translate.py:58, inbound_collection_diffs.py:88, reconcile_check.py:90-92, apply_inbound_events.py:83 — none in the plan's Scope.","reconcile_check.py comment: 'this must match the differ's exclusion set exactly'; inbound_translate.py comment: 'Matches inbound_differ._EXCLUDED_PREFIXES' — the exclusion sets are intentionally kept in lockstep, so a symmetric label must be added to all of them."],"finding":"The plan proposes a new `rebar-type:` annotation label 'mirroring the existing rebar-status: label machinery' but scopes the mirror to inbound_fields.py only. The rebar-status: machinery is spread across at least eight modules; the Scope omits the outbound stamping module (outbound_labels.py) and every reconciler-managed / bridge-internal label-exclusion filter that rebar-status: participates in.","group_criteria":null,"group_id":null,"id":"fc884e12dd1dc5f7a","impact":1.0,"is_primary":null,"location":"Scope section (files list) and Approach: 'stamp a rebar-type:<local> label (new, mirroring the existing rebar-status: label machinery in inbound_fields.py)'","norm_id":"nc12b9752a39d63d1","priority":0.9,"reason":"default-advisory","recalled":false,"scenarios":["src/rebar/_engine/rebar_reconciler/outbound_labels.py — holds _desired_status_annotation / _diff_status_annotation_labels (the ADD/REMOVE stamp machinery for rebar-status:) and _EXCLUDED_PREFIXES; omitted, so rebar-type: has no outbound stamp/diff path and the plan's collapse-stamp step cannot be implemented.","src/rebar/_engine/rebar_reconciler/differ.py:_BRIDGE_INTERNAL_LABEL_PREFIXES (line ~101) — omits rebar-type:, so the new label surfaces as apparent remote drift a pass later (spurious outbound-update echo).","src/rebar/_engine/rebar_reconciler/inbound_translate.py:_BRIDGE_INTERNAL_TAG_PREFIXES (line ~55) and apply_inbound_events.py (_BRIDGE_INTERNAL_TAG_PREFIXES, line ~89) — omit rebar-type:, so the label leaks into local ticket tags at import and never converges away.","src/rebar/_engine/rebar_reconciler/inbound_collection_diffs.py:_EXCLUDED_PREFIXES (line ~88) and reconcile_check.py:_is_rebar_internal_label (line ~85) — omit rebar-type:, so the bridge-internal label is falsely flagged as a label discrepancy on every collapsed ticket."],"severity":"critical","suggested_fix":"Extend Scope to cover the full rebar-status:-symmetric surface: outbound_labels.py (add a _desired_type_annotation / _diff_type_annotation_labels analog for stamping/removing rebar-type: mutations) and the six exclusion-prefix sites (differ._BRIDGE_INTERNAL_LABEL_PREFIXES, inbound_translate._BRIDGE_INTERNAL_TAG_PREFIXES, apply_inbound_events, inbound_collection_diffs._EXCLUDED_PREFIXES, outbound_labels._EXCLUDED_PREFIXES, reconcile_check._is_rebar_internal_label), so rebar-type: is stamped, removed, and excluded exactly as rebar-status: is.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"system","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Name the doc target (ADR/AGENTS.md/design note) for the collapse-forfeits-parent-role consequence and either add a covering criterion or drop the 'Document...' claim.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5d","T5e"],"criteria":["E1","T5e"],"decision":"advisory","decision_margin":-0.0929,"drop_reason":null,"evidence":["Approach states 'Document the hierarchy consequence...' but Scope lists only config.py, value_maps.py, inbound_fields.py, and the new test file — no doc target.","No AC verifies the hierarchy-consequence documentation or the child-to-breadcrumb fallback."],"finding":"The Approach names a documentation deliverable ('Document the hierarchy consequence ...') but no Scope file and no acceptance criterion covers it, and the collapse-forfeits-parent-role rule is a novel behavioral consequence that should be captured.","group_criteria":null,"group_id":null,"id":"f51ac2a4a7e0c92a2","impact":1.0,"is_primary":null,"location":"Approach — 'Document the hierarchy consequence: collapsing to a same/lower Jira hierarchy level forfeits the parent role, so children fall to the S7 breadcrumb path.'","norm_id":"n27ed538cddf30005","priority":0.8571,"reason":"default-advisory","recalled":false,"scenarios":["A reviewer or future maintainer collapses Epic→Initiative and is surprised that children lose their parent role with no recorded rationale."],"severity":"critical","suggested_fix":"Add a Scope bullet for the doc update and an AC that the hierarchy-consequence note exists, or move the note into the plan body if no separate artifact is intended.","tier":"LLM","validity":0.8571,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] State the prior behavior for types absent from the built-in default and give an explicit migration/back-out path (or confirm expand-contract) for configs that would now fail-closed at load.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5d","T5e"],"criteria":["T4"],"decision":"advisory","decision_margin":-0.535,"drop_reason":null,"evidence":["'a type whose config value is the sentinel skip ... an unmapped, non-skipped type is a fail-closed load error (surfaced by S1 validate) — never a silent drift.'","No Scope/Approach bullet describes prior behavior for a type absent from LOCAL_TYPE_TO_JIRA, nor a rollback if a live project's config now fails validation."],"finding":"The plan makes unmapped-non-skipped types a fail-closed load error — a behavior change from the current hardcoded fallback — but does not state what happens to existing project configs that reference types outside the built-in default, nor a migration/back-out path.","group_criteria":null,"group_id":null,"id":"f24d9993e9b0ac0dd","impact":0.264,"is_primary":null,"location":"Approach — 'an unmapped, non-skipped type is a fail-closed load error'","norm_id":"n97353d2d05051b88","priority":0.165,"reason":"default-advisory","recalled":false,"scenarios":["A project currently syncing a type not present in the built-in default suddenly fails S1 validate after this change lands."],"severity":"minor","suggested_fix":"Add an Approach note: enumerate existing types not covered by LOCAL_TYPE_TO_JIRA, confirm each is either in the built-in default or explicitly mapped/skipped before cutover; document reverting the type_map resolution as the back-out.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid