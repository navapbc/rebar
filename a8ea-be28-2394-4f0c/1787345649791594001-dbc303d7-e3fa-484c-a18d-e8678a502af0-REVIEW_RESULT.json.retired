alled":false,"scenarios":["A rebar type is added/renamed; a hand-maintained `rebar-type:` accept-set silently diverges from the effective type map and drops or misrecovers the collapsed type on inbound"],"severity":"minor","suggested_fix":"In the Approach, specify that `rebar-type:` recovery validates the label suffix against a vocabulary DERIVED from the type map (as `_LOCAL_STATUS_VOCAB` is), not a fresh literal, and add a parity assertion in test_type_mapping.py.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"ca609e987b4e391f","material_parts":{"children":["647ea2107ca5072f",0],"description":["25e47216caf273b2",3548],"description_boxes":["1a0f564ddc603945",0],"file_impact":["270fd669c640925e",4],"ticket_id":["d8a52704e3e7d462",19]},"metrics":{"cache_read_tokens":0,"cache_write_tokens":0,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":1558.2,"input_tokens":889627,"llm_calls":29,"llm_ms":346206.0,"output_tokens":32020,"precheck":{"cited_anchor_warning":false},"total_ms":351137.3,"verify_re