n from syncing as user tag"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787769377166962001,"uuid":"8304cde0-e303-4a4d-9ac7-b6cbffad0fd5"}