id\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6474e64855b2c864d246032ccf340d1c9d8b9ce370c3bbdaa873929c20f5f8db","event_uuid":"ae36c16a-54da-47ae-a2ed-1bb123ca0aad","position":{"commit_sha":"94b76e36c1940d4ee4f0d0276378f39afb06b0d1","position":"1787892457476750001-ae36c16a-54da-47ae-a2ed-1bb123ca0aad"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c514f4720d3196617afa357329aa07e4a4a2e52e2391c7f2e72d6480b59a5a8e","event_uuid":"e625883f-fddc-45fc-a833-3b269a5b55d7","position":{"commit_sha":"e85315197dffdec01a2b93c2f490ee5a0304d091","position":"1787892773635474001-e625883f-fddc-45fc-a833-3b269a5b55d7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7096b83d875bdb318bc98584e72df33216e136347ff9cf9509615f9ca46559fb","event_uuid":"bb712285-8bb9-4e1f-a0ff-0eb0237a1097","position":{"commit_sha":"2e0b9d28a10a9238b19651b097f2fb3e4ad762e4","position":"1787892787274387001-bb712285-8bb9-4e1f-a0ff-0eb0237a1097"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review BLOCK, correctly: the plan asserted an automated gating environment where bwrap's unprivileged userns succeeds, without naming the precondition that decides feasibility or measuring it. Replaced assertion with measurement.\n\nMeasured on ubuntu:24.04 (bubblewrap 0.9.0), running a real write through bwrap:\n- default container: UNUSABLE, bwrap never starts\n- --security-opt seccomp=unconfined: UNUSABLE, bwrap never starts\n- --privileged: ENFORCING, child ran and the write outside the allow-list was denied\n\nSo a plain GHA container: job does NOT work, and relaxing seccomp alone does not either. Both the Ubuntu 23.10+ AppArmor restriction (kernel.apparmor_restrict_unprivileged_userns=1) and the runtime's default seccomp filter must be cleared.\n\nMethodological note worth recording: the FIRST version of that probe reported 'enforced' for every mode, including the two where bwrap never started — because a bwrap that fails to start never writes the file whose absence I was reading as denial. That is exactly the false pass just fixed under c100-c4f1, reproduced in my own ad-hoc probe within the hour. The table above comes from a re-run with a liveness check, and the plan now requires any probe used here to assert the child ran.","timestamp":1787886060811274001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation pushed as change 2307, patch set 2.\n\nImportant property of this CI setup, discovered here: the Verified lane takes the workflow DEFINITION from trusted main and only the TREE from the patchset (the 'classify Verify route from trusted main' step). A NEWLY ADDED job therefore cannot run on its own change — the sandbox-enforcement job did not appear in the run at all. Verified +1 on this change proves the parity fixes; it does NOT prove the lane. The lane first executes post-merge.\n\nSo I verified the lane end-to-end locally instead, running its exact container command against a clean 'git archive HEAD' export:\n\n  docker run --privileged -e REBAR_REQUIRE_SANDBOX_ENFORCEMENT=1 python:3.13-slim\n    -> pip install .[dev]; pytest tests/scripts/test_mutation_sandbox.py\n  RESULT: 43 passed, 0 skipped\n\n0 skipped is the load-bearing number: with the flag set, the @live enforcement tests RAN under a real bwrap on Linux rather than skipping. That is exactly what the lane does.\n\nPatch set 1 failed CI on three repo-policy guards, all legitimate: the job set is pinned to {lint, pip-audit, test}, the pytest lane set was counted, and any step running a repo file must skip cleanly when a base predates it. All three now updated to admit the new job without weakening their intent. One fix touched the tree-skew detector: its regex 'scripts/[...].py' was unanchored, so it read tests/scripts/test_mutation_sandbox.py as the gate script scripts/test_mutation_sandbox.py — a path that does not exist and that no if-present guard could satisfy. Added a path-boundary lookbehind, and kept my own if-present guard regardless since the skew risk is real.\n\nThose guards live in tests/unit/, which my narrower pre-push selection did not cover — that is why they reached CI. Now running tests/unit + tests/scripts in parallel before pushing: 15337 passed, 0 failed.","timestamp":1787891429571539001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Merged as 2307. The lane executed for the FIRST time post-merge (run 33142294774, the first run whose workflow definition carries the job) and PASSED. Step outcomes:\n\n  success  Prove bwrap can namespace and enforce (fail the lane if not)\n  success  Run the sandbox enforcement tests under a real bwrap\n\nThe precondition step's success is itself the proof: it is written to fail unless the child RAN and the outside write was DENIED, so it cannot pass on a runner where bwrap merely exists. The test step ran with REBAR_REQUIRE_SANDBOX_ENFORCEMENT=1, under which a missing mechanism fails rather than skips.\n\nScope limit worth recording: I could not fetch that job's raw log text (the API returned nothing for it), so the CI evidence is step-level conclusions rather than a quoted 'N passed, 0 skipped' line. The identical container command was verified locally against a clean git-archive export: 43 passed, 0 skipped.","timestamp":1787892457476750001}],"completion_expectation":"required","created_at":1787856007464559001,"creation_channel":"cli","deps":[{"link_uuid":"021386a7-27b3-440e-8a99-cf9602c0100e","relation":"discovered_from","target_id":"e668-b496-e264-4283"},{"link_uuid":"cc758f8b-1418-4656-8444-0a9d6b576666","relation":"relates_to","target_id":"d916-8ef1-11a6-4683"},{"link_uuid":"bb1e3e50-9309-44e2-a739-67446744aeeb","relation":"relates_to","target_id":"7292-5020-6976-4335"}],"description":"## Summary\n\nThe mutation sandbox's Linux write-deny (`bwrap`) has **no gating CI lane**. The\nenforcement tests are gated on `skipif(mutation_sandbox.probe() is None)`. Bubblewrap\nis installed on the Linux lanes (commit `b63cf799`), but the runners deny unprivileged\n`CLONE_NEWUSER`, so the functional probe correctly returns `None`, every enforcement\ntest SKIPS, and the leg goes green having proven nothing about Linux enforcement.\n\nThis is the silent-skip failure mode: the signal that would report a broken Linux\nsandbox is indistinguishable from the signal for a healthy one.\n\n## The environment precondition, measured\n\nTwo independent mechanisms deny the namespace, and BOTH must be cleared:\n\n1. **Ubuntu 23.10+ AppArmor** sets `kernel.apparmor_restrict_unprivileged_userns=1`,\n   denying unprivileged `CLONE_NEWUSER`.\n2. **Container runtimes' default seccomp** blocks the `clone`/`unshare` outright — so a\n   plain `container:` job does NOT work, and neither does relaxing seccomp alone.\n\nMeasured on `ubuntu:24.04` (bubblewrap 0.9.0), running a real write through `bwrap`:\n\n| Container mode | Result |\n|---|---|\n| default | UNUSABLE — `bwrap` never starts |\n| `--security-opt seccomp=unconfined` | UNUSABLE — `bwrap` never starts |\n| `--privileged` | **ENFORCING** — child ran, write outside the allow-list denied |\n\nThe probe that produced this table carries a LIVENESS check, and that is load-bearing:\na first version without one reported \"enforced\" for every mode, because a `bwrap` that\nfails to start never writes the file whose absence was being read as denial — the same\nfalse pass fixed under `c100-c4f1`. Any probe used here must assert the child ran.\n\n## Approach\n\nA **privileged container lane**. `--privileged` is a plain OCI runtime capability, not a\nCI-provider feature: the identical container runs on a developer laptop, which is what\n`project.portability` requires. The host alternative — `sudo sysctl -w\nkernel.apparmor_restrict_unprivileged_userns=0` on a runner with root — is recorded as a\nfallback for environments that cannot run privileged containers, but is NOT the primary\nmechanism, because it was not measured here.\n\n## Acceptance Criteria\n\n- [x] A gating lane runs the `bwrap` enforcement tests with `probe()` returning a\n      mechanism, so they EXECUTE rather than skip. Verified by the lane's own report\n      showing those tests passed, not skipped.\n- [x] The lane asserts its own precondition BEFORE running tests: a liveness-checked\n      probe confirms `bwrap` both starts and denies a write outside its allow-list. If\n      it cannot, the lane FAILS with that message rather than proceeding to a green\n      run of skipped tests.\n- [x] A skipped enforcement test is a FAILURE on this lane, not a pass. Implemented by\n      an env flag that turns the `@live` skip into a hard requirement, so the silent-skip\n      mode cannot return. Verified by a test asserting that with the flag set and no\n      mechanism available, the suite fails rather than skips.\n- [x] The requirement flag is proven load-bearing: with it set and `probe()` forced to\n      return None, the enforcement tests FAIL. Demonstrated by real substitution.\n- [x] The mechanism is portable: it depends on an OCI runtime capability available\n      outside any single CI provider, and the same container is runnable locally\n      (`project.portability`). No GitHub-Actions-only construct carries the enforcement.\n\n## Definition of Done\n\n- Linux `bwrap` write-denial is proven by an automated, gating control.\n- Skipping is impossible on that lane; a missing mechanism fails it loudly.\n- `make lint`, `make typecheck`.\n\n## Notes\n\nDiscovered from `e668-b496`: its plan review BLOCKED on a criterion claiming a green\n`ubuntu-latest` leg proves Linux enforcement when the tests there skip. The same gap was\nraised as an advisory by the Gerrit `LLM-Review` bot on change 2256 (patch sets 1, 3, 4).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/_build-and-test.yml","reason":"add a gating lane where bwrap can actually create a namespace"},{"path":"tests/scripts/test_mutation_sandbox.py","reason":"treat a skipped enforcement test as failure on the Linux-proving lane"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","7292-5020-6976-4335"],["relates_to","d916-8ef1-11a6-4683"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e625883f-fddc-45fc-a833-3b269a5b55d7","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"0d22-f664-77e1-495f","ticket_type":"task","title":"Linux bwrap enforcement has no gating CI lane (tests skip silently)","verify_commands":[]},"source_event_uuids":["064e5687-c931-4a76-8708-794edad03bd7","f367b397-8d23-41bc-8cb3-4f6f1644dc53","6d9f5ec0-99d8-401b-8208-5bdf6274d2f5","073fec0c-26ac-484b-80f3-beb3a8eb46ac","5a214b1c-a4ca-4cae-adec-31ef9d3881d0","cc758f8b-1418-4656-8444-0a9d6b576666","bb1e3e50-9309-44e2-a739-67446744aeeb","8fc3c305-5c22-46f9-877f-212183d4a694","750dcb74-2042-4027-a5e8-716afbe1bdfa","ae36c16a-54da-47ae-a2ed-1bb123ca0aad","e625883f-fddc-45fc-a833-3b269a5b55d7","bb712285-8bb9-4e1f-a0ff-0eb0237a1097"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787894787645253001,"uuid":"7ff0c67b-7b52-4555-8175-123238e3ae6f"}