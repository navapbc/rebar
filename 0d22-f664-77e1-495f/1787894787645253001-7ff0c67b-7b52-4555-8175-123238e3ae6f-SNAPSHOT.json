eview-phase: planning","rebar-version: 0.12.0 (c02aefe509-dirty)","regver: aa61189569d34126","verified-at-sha:6fe5c0d54574da37f2465529e8a891c767ca367f","dep 8a1fcd77bdc3497680f501d0093b46f5d1b469c632bcdca8d779f1857b285c71 .github/workflows/_build-and-test.yml","dep 705057d5f047185b70f5fd38a91b9de4a64f5c64ca38711b62857681e33b3892 tests/scripts/test_mutation_sandbox.py","read-set: 4","read-path: .github/workflows/_build-and-test.yml","read-path: .github/workflows/_mutation.yml","read-path: scripts/mutation_sandbox.py","read-path: tests/scripts/test_mutation_sandbox.py","currency-basis: file_impact"],"material_fingerprint":"0d21c0cdcd31bacf","merged_log_commit":"6fe5c0d54574da37f2465529e8a891c767ca367f","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787886388559382000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"2e58c889341d47eab33571ef5ceec368fe2f3cd98086114b456776c64041c5c9","event_uuid":"064e5687-c931-4a76-8708-794edad03bd7","position":{"commit_sha":"7b6862c2ca71d0b1582d70a001ecb642dcf0f1db","position":"1787886043788972001-064e5687-c931-4a76-8708-794edad03bd7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f50a348125e0e86291e36e9518407791d736611be24263bd540c3a66d94ed3eb","event_uuid":"f367b397-8d23-41bc-8cb3-4f6f1644dc53","position":{"commit_sha":"444032f0ee1793562806e48cad756efb49ff3f4f","position":"1787886060811274001-f367b397-8d23-41bc-8cb3-4f6f1644dc53"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","sig