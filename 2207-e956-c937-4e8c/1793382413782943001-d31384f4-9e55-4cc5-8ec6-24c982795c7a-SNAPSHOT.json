[],"ticket_id":"2207-e956-c937-4e8c","ticket_type":"story","title":"Rewrite 42 resolver importers to rebar._ids and delete the shim","verify_commands":[]},"source_event_uuids":["06065fc4-7bb6-41fc-851a-0dd4b75b8983","9fd9c667-0802-444b-9a56-0f195eb2a926","eaf7ab72-4eb4-4323-a438-fd1d5df8a850","b6f0e9c7-3427-4fa7-9f24-435d899666ea","f656d110-2565-42a9-be63-ceba5a9ed5f5","e4f9bb22-2003-4d70-b1cb-57d12e464c51","2ba095dd-d0fc-476b-8e37-c68d35839e2b"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793382413782943001,"uuid":"d31384f4-9e55-4cc5-8ec6-24c982795c7a"}