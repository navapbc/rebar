6e","position":"1788296709779520938-6a9edd37-207a-49f4-b6f3-929da20bd620"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a050f4b557ce0af98fff583801e0944a32e18f1a048e6b4cd1e6a76dad6c3543","event_uuid":"8bb82008-ffb5-48e5-a168-2544361b6734","position":{"commit_sha":"8a0b84186f2d3a1ea8eb65351bcee83f826b868d","position":"1788297049930753908-8bb82008-ffb5-48e5-a168-2544361b6734"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"08e5b07df04b47ee2cba22a0524e6ed0e5e990592c4c08930bd17f4119134b17","event_uuid":"452660d9-2d08-4fc2-a78c-e7ae809f0780","position":{"commit_sha":"f3b5553d8d156ddf95fa14e2b3d8cfa90fed5b73","position":"1788297205418058400-452660d9-2d08-4fc2-a78c-e7ae809f0780"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"727d6fb702b8fbf5ba9f378a432d6f26e70312876722f444552e1b52231aba43","event_uuid":"e36dc2d3-870b-433b-a072-b24509a80fac","position":{"commit_sha":"c2d92045482d5d8b2fc33c3b933112f4a650c324","position":"1788297459267144077-e36dc2d3-870b-433b-a072-b24509a80fac"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"070f6c68f192ecb43a7258bdb309b2e626a6e956baf023fb98f890834661b4b2","event_uuid":"d3352671-c585-4110-99c6-2038cc3cc9f7","position":{"commit_sha":"ef8a72bfedab1957424953ff0af506502d4ad5b7","position":"1788300698772833776-d3352671-c585-4110-99c6-2038cc3cc9f7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9bc819382c9e881f66c70d2d5917b765e1381c9d154f7e9acdad1f9c7e030b89","event_uuid":"4c295ba4-0154-49d2-b3cb-a1a261e41f97","position":{"commit_sha":"4b70159e081aff1c64627b93a96fc6a7e66af218","position":"1788302916391690001-4c295ba4-0154-49d2-b3cb-a1a261e41f97"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## DECISION NEEDED — narrow `error_code_for` so `llm_unavailable` means a real outage only\n\n**The change.** Make `llm_unavailable` fire ONLY for `LLMUnavailableError` (the true transient-outage type); every other `LLMError` subclass falls to its explicit `error_code` attribute, else the honest broad `command_failed`.\n\n**This finishes an established direction, it does not open a new one.** Bug `f75f` already carved `LLMRunnerError → command_failed` out of the blanket `LLMError → llm_unavailable` (`_llm_error_code`, `_errors.py:110-127`). What remains is the residual over-claim: the bare `LLMError` base and non-availability subclasses still map to `llm_unavailable` (`:126-127`). ce6b removes that residual — the systematic completion of epic `3405`'s descriptiveness intent — and delivers `551b`'s ruling (editor missing-bundle → `command_failed`).\n\n**OSS grounding.** Same gRPC/HTTP principle as 73d8: reserve `UNAVAILABLE`/503 for genuine outages so retry, backoff, and alerting semantics stay meaningful. An over-broad \"unavailable\" triggers pointless retries and poisons outage dashboards.\n\n**Risk is low and bounded** because the fix is required to enumerate every `LLMError` subclass and add held-out tests proving (a) a genuine execute-time outage still returns `llm_unavailable` and (b) a non-outage `WorkflowError` (e.g. editor missing-bundle at `editor.py:475`) returns `command_failed`.\n\n**Recommendation:** Approve. Land ce6b as the umbrella and fold **73d8**'s `ExpressionError → invalid_input` into the same sweep (set its explicit `error_code`) so the two changes are consistent. Keep the finer `environment_unready` code DEFERRED per 551b's stated trigger.","timestamp":1788226555339010001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Resume state 2026-09-01 13:24 PT: no Gerrit change exists yet; local worktree `../impl-taxonomy` is clean at origin/main `1c8232b0ee4e`, so there is no code WIP to commit. ce6b is still `open`; latest plan-review job `1788289136732189341-e414c914548a431f93b60670dcd42518` returned BLOCK on plan specificity (LLMConfigError subtree and bare WorkflowError execute-outage discriminator). Next step is to revise the ce6b plan, rerun plan-review without force, then claim before editing code. CI/gates: no local taxonomy/lint/typecheck or Gerrit Verified/LLM-Review yet because ce6b is not claimed.","timestamp":1788294716435256248},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Resume state 2026-09-01 13:24 PT: no Gerrit change exists yet; local worktree ../impl-taxonomy is clean at origin/main 1c8232b0ee4e, so there is no code WIP to commit. ce6b is still open; latest plan-review job 1788289136732189341-e414c914548a431f93b60670dcd42518 returned BLOCK on plan specificity (LLMConfigError subtree and bare WorkflowError execute-outage discriminator). The plan has now been revised to address that; next step is rerun plan-review without force and claim before editing code. CI/gates: no local taxonomy/lint/typecheck or Gerrit Verified/LLM-Review yet because ce6b is not claimed.","timestamp":1788294933107517001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan specificity update: resolved latest review blockers by removing the nonexistent message-form execute wrapper premise, preserving dbca AC3 through real LLMUnavailableError propagation and cause/context-wrapped WorkflowError compatibility, mapping plain WorkflowError without an outage cause to command_failed, and naming existing contract-test consumers to update. No Gerrit change yet; no CI yet; ce6b remains open until review-plan PASS and claim.","timestamp":1788295823209069001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan specificity update: latest BLOCK resolved by choosing a type-based split. Bare WorkflowError remains llm_unavailable only for the dbca execute-outage compatibility contract; editor missing-bundle will use a dedicated WorkflowAssetsUnavailableError with error_code=command_failed. This avoids message sniffing while preserving the operator-required dbca behavior. No Gerrit change yet; no CI yet; ce6b remains open pending plan-review PASS and claim.","timestamp":1788296323843069001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation progress: ce6b plan-review PASSed and ce6b is now claimed/in_progress. RED focused contract suite failed on the expected old taxonomy (bare LLMError and ExpressionError still llm_unavailable; missing WorkflowAssetsUnavailableError). Production changes now applied in ../impl-taxonomy and focused taxonomy suite is GREEN: `pytest -q tests/interfaces/contracts/test_error_code_taxonomy_contract.py tests/interfaces/contracts/test_llmrunner_error_codes_f75f_heldout.py tests/interfaces/contracts/test_workflow_error_codes_35ab.py tests/interfaces/contracts/test_workflow_error_codes_dbca.py` => 34 passed. No Gerrit change yet; lint/typecheck pending.","timestamp":1788297049930753908},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Commit created in ../impl-taxonomy: `02e6f2d54a19059d68db5050ec7554d6c5c6fb65` (`Narrow LLM unavailable taxonomy`) with both `rebar-ticket:` trailers and DCO sign-off. Local gates before commit: focused taxonomy contracts 34 passed; `make lint` passed; `make typecheck` passed. Gerrit change not pushed yet; Verified/LLM-Review pending.","timestamp":1788297205418058400},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change opened: https://rebar.solutions.navateam.com/c/rebar/+/2482 for commit `02e6f2d54a19059d68db5050ec7554d6c5c6fb65`. Local pre-push gates: focused taxonomy contracts 34 passed; `make lint` passed; `make typecheck` passed; `rebar verify-commit-ticket --rev HEAD` passed for umbrella ce6b. Gerrit Verified and LLM-Review are pending.","timestamp":1788297459267144077},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit #2482 status update: GitHub Actions run `33560227097` completed successfully and Gerrit has `Verified+1`. LLM-Review remained vote-less, so I posted the documented contributor trigger `rerun-llm-review` on the change to queue a fresh fail-closed review without creating a new patch set. Waiting for LLM-Review before submit.","timestamp":1788300698772833776},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit #2482 status update: Verified+1 is recorded from GitHub Actions run 33560227097, but Gerrit HTTPS status reads began timing out after the LLM-Review rerun was accepted. Last known LLM-Review state was neutral/queued; no new patch set has been pushed. This is an infra/connectivity wait, not a code or CI failure. Continuing to retry Gerrit and waiting for LLM-Review+1 before submit.","timestamp":1788302916391690001}],"created_at":1788109253593886326,"creation_channel":"mcp","deps":[{"link_uuid":"aa70cd46-ad39-469f-8a32-fd232c9be630","relation":"discovered_from","target_id":"73d8-4871-1b49-4047"},{"link_uuid":"ca83007d-4883-412f-a097-bc8702df1010","relation":"supersedes","target_id":"551b-1a30-ac2b-4127"},{"link_uuid":"0dbcac84-4479-43ed-8c2c-90e17b9f6a7c","relation":"depends_on","target_id":"eb64-844b-ab7a-4915"},{"link_uuid":"85aedf95-023a-4ecb-af58-595f36a74beb","relation":"relates_to","target_id":"59a7-cb88-f2f9-4148"}],"description":"Spun from 73d8-4871-1b49-4047 (brainy-convulsant-unicorn) and 551b-1a30-ac2b-4127 (sanidine-cilium-eland) during the 2026-08-30 error-code decision pass.\n\n## Problem\n`error_code_for` (`src/rebar/_errors.py`) maps the broad `LLMError` family to `llm_unavailable`. That over-claims an AI-provider outage for non-outage faults: the bare `LLMError` base, concrete LLM/workflow subclasses that are not in the provider-unavailability subtree, and the editor missing-bundle failure that currently raises a bare `WorkflowError`. This is the residual of origin 8a31-e1c3-cf31-4239's blanket mapping and the systematic completion of epic 3405-c0b7-0436-4b46's descriptiveness intent.\n\n## Operator decision\nThe latest DECISION NEEDED comment approves narrowing `llm_unavailable` to true LLM availability failures while preserving dbca AC3's compatibility contract: a genuine outage surfaced through the bare `WorkflowError` execute-wrapper contract still reads as `llm_unavailable`. The implementation keeps `isinstance(exc, LLMUnavailableError) -> llm_unavailable`, intentionally including `LLMConfigError` / prompt / reviewer configuration subclasses because those classes inherit from `LLMUnavailableError` and model missing LLM dependencies, credentials, or configuration. The implementation removes the broad catch-all for all other `LLMError` instances.\n\nThe split between dbca AC3 and the editor missing-bundle case is type-based, not message-based. The bare `WorkflowError` base remains `llm_unavailable` as the legacy execute-outage wrapper contract. The editor missing-bundle raise at `src/rebar/llm/workflow/editor.py:475` will stop using bare `WorkflowError`; it will raise a dedicated `WorkflowAssetsUnavailableError(WorkflowError)` with `error_code = \"command_failed\"`. That delivers 551b's ruled behavior without message sniffing and without changing the dbca AC3 bare-base contract. Do not add `environment_unready`.\n\nTicket 73d8-4871-1b49-4047 is folded into this sweep by giving `ExpressionError` an explicit `error_code = \"invalid_input\"`, matching prior bug 35ab-f0e0-3e4a-4b72 (unknown-step -> invalid_input) and dbca-97ac-ad96-4d6d (parse/lint -> invalid_input).\n\n## Implementation scope\nTouch `src/rebar/_errors.py`, `src/rebar/llm/errors.py`, `src/rebar/llm/workflow/editor.py`, `src/rebar/llm/workflow/executor.py`, and tests. Enumerate every concrete subclass of `LLMError` across `src/rebar/llm/`, including `errors.py`, `findings.py`, `evals/eval.py`, `prompting/`, and `workflow/`, with Serena hierarchy/reference checks and a grep/string confirmation. Update the existing pinned contract tests that currently assert the blanket mapping: `tests/interfaces/contracts/test_error_code_taxonomy_contract.py`, `tests/interfaces/contracts/test_llmrunner_error_codes_f75f_heldout.py`, `tests/interfaces/contracts/test_workflow_error_codes_35ab.py`, and `tests/interfaces/contracts/test_workflow_error_codes_dbca.py`.\n\nIntended mapping: `LLMUnavailableError` and its availability/config subtree -> `llm_unavailable`; bare `WorkflowError` base -> `llm_unavailable` for the preserved dbca execute-outage wrapper contract; `WorkflowAssetsUnavailableError` -> `command_failed`; `ExpressionError` -> `invalid_input`; workflow caller/authoring errors already classified as `invalid_input` stay there; every remaining non-availability LLM/findings/eval/snapshot subclass without an explicit `error_code` -> `command_failed`; bare `LLMError` base -> `command_failed`.\n\n## Acceptance Criteria\n- [ ] `src/rebar/_errors.py` returns `llm_unavailable` for `LLMUnavailableError` / `LLMConfigError` availability errors and preserves bare `WorkflowError` base -> `llm_unavailable` for the dbca execute-outage compatibility contract; focused tests verify these mappings.\n- [ ] A dedicated editor missing-bundle exception raised from `src/rebar/llm/workflow/editor.py:475` maps to `command_failed`, not `llm_unavailable`, and no message sniffing is used.\n- [ ] The broad `LLMError` base and every non-availability `LLMError` subclass except the deliberately preserved bare `WorkflowError` base maps to an explicit `error_code` when present, otherwise `command_failed`; a parameterized taxonomy test covers the complete enumerated subclass set.\n- [ ] `ExpressionError` maps to `invalid_input` via an explicit `error_code`, verified by a focused test and by the exhaustive taxonomy test.\n- [ ] No `environment_unready` code is introduced; `KNOWN_ERROR_CODES` remains consistent with the intentional taxonomy.\n\n## Testing\nRun the focused updated contract tests with `env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/interfaces/contracts/test_error_code_taxonomy_contract.py tests/interfaces/contracts/test_llmrunner_error_codes_f75f_heldout.py tests/interfaces/contracts/test_workflow_error_codes_35ab.py tests/interfaces/contracts/test_workflow_error_codes_dbca.py`, then `env PATH=\"$PWD/.venv/bin:$PATH\" make lint` and `env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck`. After committing, run `env PATH=\"$PWD/.venv/bin:$PATH\" rebar verify-commit-ticket HEAD`.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_errors.py","reason":"narrow LLMError taxonomy while preserving explicit outage branches"},{"path":"src/rebar/llm/errors.py","reason":"add editor missing-bundle command_failed subclass"},{"path":"src/rebar/llm/workflow/editor.py","reason":"raise dedicated missing-bundle exception instead of bare WorkflowError"},{"path":"src/rebar/llm/workflow/executor.py","reason":"add explicit ExpressionError invalid_input classification"},{"path":"tests","reason":"focused error taxonomy and workflow classification tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["depends_on","eb64-844b-ab7a-4915"],["relates_to","59a7-cb88-f2f9-4148"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"99e2a82c-b8a3-4b59-8e33-660e1bf33325","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":["error-codes","llm","eb64-coord"],"ticket_id":"ce6b-cffa-6450-4fa5","ticket_type":"bug","title":"Reserve llm_unavailable for true outages: narrow error_code_for branch 6 to LLMUnavailableError","verify_commands":[]},"source_event_uuids":["0dbcac84-4479-43ed-8c2c-90e17b9f6a7c","536424b8-005e-4e80-9df0-59c4df171771","d68b0a7c-d7b6-4547-ae01-c05754a37cb1","85aedf95-023a-4ecb-af58-595f36a74beb","df3d749d-e1e4-4073-b3c7-7d2f85ac96a9","d480b164-3704-441e-9544-ca16c741395b","ecb23fbb-fd00-4418-8e62-3834b1366b48","627a1091-42f0-4235-8e3f-199196383208","25fd0bef-15b7-4132-9f42-285c008e8ab2","7cadc316-5047-4df7-b2f9-367a9360e72b","7cdc8289-000a-42ce-86b9-7b7aae59cf1e","bf5dbc0f-c82a-4c71-971c-e484e2ba9602","dad850aa-faef-414c-a165-0a16a1e9d614","6a58ed6f-46aa-4e77-a404-db49d1cb994e","684135e4-aef9-4066-90be-3b887bf14fb3","09eb9b3f-003e-405e-9daf-fbf111394665","99e2a82c-b8a3-4b59-8e33-660e1bf33325","6a9edd37-207a-49f4-b6f3-929da20bd620","8bb82008-ffb5-48e5-a168-2544361b6734","452660d9-2d08-4fc2-a78c-e7ae809f0780","e36dc2d3-870b-433b-a072-b24509a80fac","d3352671-c585-4110-99c6-2038cc3cc9f7","4c295ba4-0154-49d2-b3cb-a1a261e41f97"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788302916391690002,"uuid":"21773336-d1c3-4a72-8beb-1a1c4b5e36a3"}