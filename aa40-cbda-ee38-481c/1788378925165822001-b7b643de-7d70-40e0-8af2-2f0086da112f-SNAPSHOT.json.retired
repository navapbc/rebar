-4a4e8ee8-0b02-4515-8e8f-0a235c83d44d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b63ee6363d244b34899a07b81d3cc48ad4050d9aa8895fbf0f524e1dddab1485","event_uuid":"aeed3cfb-07e0-408c-b79f-5c552a558996","position":{"commit_sha":"e92cdb46c33ef9916cbb1b5f28124214a852adf7","position":"1788375799567868642-aeed3cfb-07e0-408c-b79f-5c552a558996"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"7171637a9cdd28423acd9ee6d128ded268b91763274b292dd84c96441216172d","event_uuid":"2138e3f4-7113-4783-b990-cb583e2369aa","position":{"commit_sha":"bdb24a7fce2795c7e6b54fcefae2e9636e0dd71b","position":"1788375799574194246-2138e3f4-7113-4783-b990-cb583e2369aa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1c9bb8af78f180ef282704aac0d406c22ec667b8329b19a0959bdcbacbfcd43e","event_uuid":"fa11d07b-4850-41fc-bf81-5d7fde19b65b","position":{"commit_sha":"c8382ea8c493ddf13588d810fc8a735dcecfa60f","position":"1788375799634009707-fa11d07b-4850-41fc-bf81-5d7fde19b65b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4adeec59fd2e00375cd0499154dc4e97c997763debca67d120b8b8f88e1fed98","event_uuid":"6a9921f2-f8a0-4e66-a280-780d3f4d43f3","position":{"commit_sha":"980c1226de24946eeb8b1a020f6d9b2006905371","position":"1788375841852286219-6a9921f2-f8a0-4e66-a280-780d3f4d43f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"44d9bb612fa4468da98b4598b2aeda0f4be1efc88367eca716ddd1a9a915644b","event_uuid":"d878576f-578d-4bf0-b4c9-95f9e3346b2d","position":{"commit_sha":"9c11f331dcd123e104d310c86045bc69ae971331","position":"1788375888491587802-d878576f-578d-4bf0-b4c9-95f9e3346b2d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6e148343b240a5576b46d3446b18439e0feeabd3f27bd8c5b025c8e2dc8d5957","event_uuid":"0af6e740-52c7-4f76-9ca0-efed26bffadd","position":{"commit_sha":"30f39889eb30cbcd1ecba747085936240d19d174","position":"1788376362606561477-0af6e740-52c7-4f76-9ca0-efed26bffadd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788375027120785317,"creation_channel":"mcp","deps":[{"link_uuid":"4a4e8ee8-0b02-4515-8e8f-0a235c83d44d","relation":"blocks","target_id":"9183-aaae-667d-45e6"},{"link_uuid":"aeed3cfb-07e0-408c-b79f-5c552a558996","relation":"blocks","target_id":"2ba3-bf77-1303-4b2d"},{"link_uuid":"2138e3f4-7113-4783-b990-cb583e2369aa","relation":"blocks","target_id":"e956-b1c3-45b9-4016"},{"link_uuid":"fa11d07b-4850-41fc-bf81-5d7fde19b65b","relation":"blocks","target_id":"910b-2d43-4482-4c64"}],"description":"# S1 — Isolate review-gate scratch on a dedicated EBS volume\n\n## Why\nReview gate scratch/clones/snapshots currently share the OS/root filesystem. A burst or leak in review work can therefore wedge the whole Gerrit host. Option C is the walking-skeleton structural fix: move gate scratch to a separately sized/quota'd EBS volume.\n\n## What\nAdd a dedicated gp3 EBS volume for code-review gate scratch, mount it at a documented host path such as `/var/lib/rebar/gate-scratch`, and wire review-bot temp handling so both `rebar-gate-snapshots` and `reviewbot-*` clone workdirs use that filesystem. Reuse the existing Nitro NVMe-by-volume-id mount pattern from `infra/terraform/user_data.sh:20-70`. Add a scratch-volume metric and CloudWatch alarm.\n\n## Scope\nIn scope: Terraform volume/attachment/variables/outputs, user-data mount, review-bot compose env/mounts, observability metric, CloudWatch alarm, runbook updates, and targeted tests. Out of scope: Docker/Journald/`/var/tmp`/container-layer caps; those depend on this structural slice.\n\n## Grounding\n- Existing data EBS volume and attachment: `infra/terraform/main.tf:27-35`, `:83-87`.\n- Root block device and user-data render: `infra/terraform/main.tf:56-64`; variables: `infra/terraform/variables.tf:13-23`.\n- Current scratch is root-resident because `REBAR_GATE_TMPDIR` is unset: `infra/compose/docker-compose.yml:233-245`, `src/rebar/_snapshot/repo_snapshot.py:149-163`, `src/rebar/review_bot/voter.py:381`, `src/rebar/review_bot/low_disk.py:69`.\n- Runbook states clone workdirs are root-volume resident: `infra/runbooks/review-bot-ops.md:575-606`.\n\n## Acceptance Criteria\n- [ ] Terraform declares a separate scratch EBS volume, attachment, size/cap variables, tags, and outputs; scratch is documented as rebuildable rather than source-of-truth data.\n- [ ] Host provisioning mounts the scratch volume idempotently by UUID and fails loud if it cannot mount.\n- [ ] Review-bot snapshot store and clone tempdirs resolve to the scratch volume, not root.\n- [ ] Scratch volume publishes a metric and has its own CloudWatch alarm wired to SNS.\n- [ ] Runbooks document steady-state location, alarm meaning, recovery, and rebuildable-data posture.\n- [ ] Targeted tests cover Terraform alarm/action conventions, compose/env wiring, and observability emission.\n- [ ] Portability criterion: control is Terraform + Linux mount/env config with local tests; no GitHub-only CI trigger is required.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/terraform/main.tf","reason":"Declare scratch EBS volume, attachment, user_data variables, and outputs."},{"path":"infra/terraform/variables.tf","reason":"Add scratch volume size/cap/mount variables."},{"path":"infra/terraform/user_data.sh","reason":"Resolve, format, and mount the scratch EBS volume by UUID."},{"path":"infra/compose/docker-compose.yml","reason":"Set review-bot REBAR_GATE_TMPDIR/TMPDIR and mount/use scratch path."},{"path":"infra/scripts/compose-up.sh","reason":"Provision any host bind directories needed for scratch-volume-backed paths."},{"path":"infra/scripts/observability.sh","reason":"Publish scratch mount used/cap metric."},{"path":"infra/terraform/monitoring_autodeploy.tf","reason":"Add scratch volume CloudWatch alarm near root disk alarm."},{"path":"infra/runbooks/review-bot-ops.md","reason":"Document scratch location, alarm, and recovery."},{"path":"infra/runbooks/provision-restore.md","reason":"Document new volume provisioning/restore expectations."},{"path":"tests/scripts/test_autodeploy_materialize_probe.py","reason":"Extend tests for observability installer/deploy trigger if probe changes."},{"path":"tests/scripts/test_observability_disk_pressure.py","reason":"Add/extend observability metric tests."},{"path":"tests/unit/test_alarm_actions_terraform.py","reason":"Assert new alarm action wiring."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["blocks","2ba3-bf77-1303-4b2d"],["blocks","910b-2d43-4482-4c64"],["blocks","9183-aaae-667d-45e6"],["blocks","e956-b1c3-45b9-4016"],["parent","6202-e1c7-c57f-4897"]],"no_file_impact_reason":"","parent_id":"6202-e1c7-c57f-4897","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":["rebar"],"reverts":[],"status":"open","tags":["infra","gerrit","disk-ceiling","scratch-volume"],"ticket_id":"aa40-cbda-ee38-481c","ticket_type":"story","title":"S1 — Isolate review-gate scratch on a dedicated EBS volume","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/test_observability_disk_pressure.py tests/scripts/test_autodeploy_materialize_probe.py tests/unit/test_alarm_actions_terraform.py","dd_id":"AC3","dd_text":"Scratch temp/snapshot paths are moved off root and covered by tests."},{"command":"terraform -chdir=infra/terraform validate","dd_id":"AC4","dd_text":"Terraform syntax remains valid."}]},"source_event_uuids":["042db4c0-eb6a-4bf6-80a5-1e6c1548da49","90ac1409-5f9e-4a2c-be1b-bb4412049116","f116f771-4892-46fc-9bd5-c2f9951c24ff","4a4e8ee8-0b02-4515-8e8f-0a235c83d44d","aeed3cfb-07e0-408c-b79f-5c552a558996","2138e3f4-7113-4783-b990-cb583e2369aa","fa11d07b-4850-41fc-bf81-5d7fde19b65b","6a9921f2-f8a0-4e66-a280-780d3f4d43f3","d878576f-578d-4bf0-b4c9-95f9e3346b2d","0af6e740-52c7-4f76-9ca0-efed26bffadd"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788378925165822001,"uuid":"b7b643de-7d70-40e0-8af2-2f0086da112f"}