e>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_necessity_criterion.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_network_fetch_stall_abort_851e.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_network_guard_local_ipc.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_no_reducer_engine_support_cycle.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_no_stale_bare_review_cli.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_no_verdict_obtainable_2a6f.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_non_codebase_tag_edge.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_opcert_cross_environment_c21f.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_opcert_deploy_infra.py\\\":{\\\"docs\\\":[\\\"test_terraform_opcert_admin_role_ignores_assume_role_policy_drift\\\",\\\"test_dockerfile_opcert_uses_ssh_dash_v_for_version_check\\\",\\\"test_opcert_compose_service_is_aws_free\\\"],\\\"comments\\\":[]}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef normalize(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True)\n    seen=set()\n    allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]\n                seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path):\n    tree=ast.parse(raw,type_comments=True)\n    lines=raw.splitlines()\n    scopes=[(\"<module>\",1,len(lines))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    full={}\n    inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]\n    i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1\n            continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((scope for scope in scopes if scope[1]<=comments[0][0]<=scope[2]),key=lambda scope:scope[2]-scope[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(value for _,value in comments)))\n    rules=ALLOWED[path][\"comments\"]\n    for scope,prefix in rules:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in regions)>1:\n            raise SystemExit(\"ambiguous comment stable id: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    protected=[region for region in regions if not any(region[0]==scope and region[1].startswith(prefix) for scope,prefix in rules)]\n    return inline,protected,regions\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    before=source(base,path)\n    after=source(\"HEAD\",path)\n    if normalize(before,path,True)!=normalize(after,path,False):\n        raise SystemExit(\"normalized AST changed: \"+path)\n    before_inline,before_protected,before_regions=comment_state(before,path)\n    after_inline,after_protected,after_regions=comment_state(after,path)\n    for scope,prefix in ALLOWED[path][\"comments\"]:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in before_regions)!=1:\n            raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    if before_inline!=after_inline:\n        raise SystemExit(\"inline comment changed: \"+path)\n    if before_protected!=after_protected:\n        raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)' tests/unit/test_mcp_plan_review_status.py tests/unit/test_mcp_tool_offload.py tests/unit/test_measurement_provenance_criterion.py tests/unit/test_mechanism_delta.py tests/unit/test_mirror_lock_terraform.py tests/unit/test_model_class_ladder.py tests/unit/test_module_size_contract.py tests/unit/test_mutation_confirmations.py tests/unit/test_mypy_ratchet.py tests/unit/test_necessity_criterion.py tests/unit/test_network_fetch_stall_abort_851e.py tests/unit/test_network_guard_local_ipc.py tests/unit/test_no_reducer_engine_support_cycle.py tests/unit/test