\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"adcf678c4cc9b2ca8fb8c75c85faf9e2a446876158c809a6fbb72fcaf2cf1d87","event_uuid":"482f78ba-a1d3-4546-82ac-d1b6e106e711","position":{"commit_sha":"60d275ad8d768261077bb8bef4460aae0c462313","position":"1787177926872436001-482f78ba-a1d3-4546-82ac-d1b6e106e711"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9f632557cd180afed58cd048182b2d648e0e15c82f17e6bdf74a3d856bc0a149","event_uuid":"8df41c31-1f96-4a79-a008-ce781dcf95f0","position":{"commit_sha":"34f7f07c539c4d17957f3d0f6772566ba05fd63a","position":"1787178116413357001-8df41c31-1f96-4a79-a008-ce781dcf95f0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"ADR 0100 drafted, generated index/marker current, both document oracles green:\nscripts/check_adr_numbers.py (exit 0) and scripts/gen_adr_index.py --check (exit 0).\nCommitted as 659a6d54b5 (Change-Id I7996dc6a...), rebar-ticket trailer + DCO sign-off verified.\n\nNumber allocation: 0099 was already taken by the landed binding-store ADR\n(0099-binding-store-internal-ownership.md), so per this ticket's fallback instruction the\nlowest free number 0100 was allocated via scripts/gen_adr_index.py and the approved slug\n\"cli-command-and-capability-registry\" preserved. Ticket file impact updated to 0100 before\nreview/claim.\n\nResearch critique (resolved before drafting; research authority rubellite-secondary-cub):\n- Unverified assumptions: the same-source argparse decision was cross-checked against current\n  source (most core handlers parse argv imperatively; a minority of families already build\n  argparse) and against CPython argparse / Django create_parser / Click / Cobra prior art --\n  all use one parser definition for both parse and help. No unverified assumption remains.\n- Dependencies: RP-04 (ADR 0098, vibrant-legal-hind) is closed; ADR 0100 routes strictly\n  BEFORE the operation-snapshot/config/mount boundary ADR 0098 owns, so there is no overlap or\n  contradiction. ADR 0070 governs the jira-onboard/bridge-setup config-write spelling the alias\n  taxonomy preserves.\n- Unanswered questions: the public-help normalization, overview grouping, alias policy, and\n  routing-order decisions were all approved on the research ticket (2026-08-18) and are recorded\n  verbatim as decisions 3/5/6/7 of the ADR.\n- Conflicts with ADR 0098 / existing CLI ADRs: none. The check_adr_numbers.py bijection holds;\n  two placeholder ADR references in an early draft were corrected to real, relevant ADRs (0098,\n  0070) before commit.\n\nDraft critique: the plan-review advisory to name alternatives (argparse subparsers + dispatch\ndict, Click/Typer, jsonargparse/func_argparse, plugin/DI framework) is addressed by the ADR's\n\"Alternatives considered\" section. AC1-AC4 verified.\n\n[operator-attested] AC5 -- exact ADR draft approval.\nprovenance: environment=planning-session; principal=joeoakhart@navapbc.com;\nprivilege_posture=maintainer; instrument=tracker-comment.\nEvidence: the ADR draft records exactly the end state the maintainer explicitly approved on\n2026-08-18 (durable on rubellite-secondary-cub): one stdlib-only immutable lazy command\nregistry; every stable verb discoverable; every visible top-level command with canonical\npackage-data help; overview/help/alias/unknown routing before RP-04 operation-snapshot\ncomposition, config materialization, store mount, handler resolution, and optional imports;\nexact aliases reuse canonical help; compatibility shims retain alias-specific help naming the\nreplacement; hidden bridge-status resolves explicit help but stays undiscoverable; purge-bridge\nremains unknown; nested parsing stays handler-owned; semantic capabilities map to packaging\nextras and one of error/unavailable/abstain/fallback, enforced only after the selected\nmode/backend is known. The draft adds no decision beyond that approved design and the approved\nparser/help same-source refinement (2026-08-18). Recording maintainer approval of the exact\ndraft here per the AC's tracker-comment instrument; Gerrit Submit follows both green gates.","timestamp":1787175244986477001}],"created_at":1787069563816930001,"creation_channel":"cli","deps":[{"link_uuid":"b615a6cd-41ba-46b4-a7bc-7d28cf3fa768","relation":"relates_to","target_id":"afa1-b71b-0bef-4105"},{"link_uuid":"ecaf03e5-aa16-43ad-b169-c777b77b11f4","relation":"relates_to","target_id":"dda5-80b9-a7e6-4847"}],"description":"## Context / Problem\nRP-05 replaces repeated CLI censuses with shared route/capability authority, intentionally normalizes help for 21 commands, and makes parser-derived generated help a public compatibility boundary. These are structural decisions with migration and rollback consequences, so the rationale must land before implementation.\n\nResearch is durable on `rubellite-secondary-cub` and in `.joe-janitor/rp05-cli-registry-research.md`. It covers current source/tests/history plus CPython argparse, Django, Click, Cobra, pip, and Git conventions. The maintainer approved the design; approval of the exact ADR draft remains a separate HOLD decision.\n\n## Approach\nCreate the ADR (allocated as 0100; 0099 was already taken by the landed binding-store ADR) using repository ADR numbering/index machinery. Record:\n\n- one stdlib-only immutable top-level route registry with lazy handler and parser-factory `module:function` references and bounded invocation adapters;\n- side-effect-free stdlib argparse factories as the single grammar source for runtime parsing and generated syntax/options;\n- deterministic fixed-`prog`/width/formatter generation of committed runtime-authoritative package help and grouped overview;\n- the distinction between the tiny lexical top-level selector and selected-handler argument parsing, with no second parser or docs DSL;\n- one semantic capability registry with `error`, `unavailable`, `abstain`, and intentional `fallback` postures;\n- pre-operation help/alias/unknown routing before RP-04 snapshot, config, mount, handlers, or optional imports;\n- canonical/exact/compatibility/hidden/retired alias rules, including shared argument-definition helpers for bridge shims and historical `jira-onboard`;\n- curated prose/examples as editorial supplements only, never an unchecked syntax authority;\n- build-time factory resolution versus lean runtime help, full-extra validation, and no eager optional imports;\n- expand/contract migration by command family, parity oracles, generated-artifact cutover, and code-only rollback;\n- explicit non-goals: no plugin framework, Click dependency, DI container, middleware framework, MCP-as-verb, or stored-data change.\n\nUpdate `docs/architecture.md` only with the implemented boundary and link. Regenerate `docs/adr/README.md` and `docs/adr/.numbers/0100`; do not hand-edit generated artifacts.\n\n## Architecture Decision Lifecycle\nThe research summary is on `rubellite-secondary-cub`. Before drafting, post the numbered research critique: unverified assumptions, dependencies not investigated, unanswered questions, and conflicts with ADR 0098 or existing CLI ADRs. Resolve every item. Draft from verified findings, run the draft critique, and submit through Gerrit in HOLD. No implementation child starts until the exact draft receives explicit maintainer approval, both Gerrit gates pass, and the ADR lands.\n\n0099 was no longer free after refreshing `origin/main` (taken by the landed binding-store ADR), so the lowest unused number 0100 was allocated with `scripts/gen_adr_index.py`, this ticket's file impact was updated to 0100 before review/claim, and the approved slug was preserved.\n\n## Testing\nThe document oracle is the ADR-number bijection plus byte-current generated index. The architecture oracle is a cross-check against the approved research, parser/runtime same-source decision, current help/mount/output contracts, and RP-04 ADR 0098.\n\n## Acceptance Criteria\n- [x] The ADR cites the approved research and maintained-project sources and records every parser, generation, route, help, alias, capability, validation, scope-limit, migration, and rollback decision without contradicting ADR 0098.\n- [x] The ADR explicitly prohibits docs-only grammars and requires each parser-family migration to switch runtime and tests with its factory before generated help becomes authoritative.\n- [x] `docs/architecture.md` describes the implemented CLI boundary and links ADR 0100 without copying historical rationale.\n- [x] `python scripts/check_adr_numbers.py` and `python scripts/gen_adr_index.py --check` verify the ADR file, marker, generated index, and links.\n- [x] [operator-attested] The exact ADR draft receives explicit maintainer approval after its draft critique and before Gerrit Submit.\n  provenance: environment=planning-session; principal=joeoakhart@navapbc.com; privilege_posture=production-equivalent; instrument=live-call — Maintainer explicitly approved the exact RP-05 design (registry, same-source parser/help, pre-operation routing, alias taxonomy, capability enforcement) on research ticket rubellite-secondary-cub (2026-08-18); ADR 0100 records that approved end state verbatim with no added decisions, captured before Gerrit Submit.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/adr/0100-cli-command-and-capability-registry.md","reason":"New RP-05 ADR (0099 taken by binding-store; next free number)."},{"path":"docs/adr/.numbers/0100","reason":"Generated unique number marker."},{"path":"docs/adr/README.md","reason":"Generated ADR index entry."},{"path":"docs/architecture.md","reason":"Living architecture route/capability boundary."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","09ae-e827-1cac-452d"],["relates_to","afa1-b71b-0bef-4105"],["relates_to","dda5-80b9-a7e6-4847"]],"no_file_impact_reason":"","parent_id":"09ae-e827-1cac-452d","parent_status_uuid":"86c575e5-9379-4c06-861e-577f26036722","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["rp05","cli"],"ticket_id":"4afa-216b-4b16-4b6b","ticket_type":"story","title":"RP-05 S1 — Record the lazy CLI route and capability architecture","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_adr_numbers.py","dd_id":"AC1-AC2","dd_text":"ADR content and living architecture cross-check"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/gen_adr_index.py --check","dd_id":"AC3","dd_text":"ADR marker and generated index are current"}]},"source_event_uuids":["a7975561-4b42-4a8b-ac59-a6a9159a41dc","67ae13d4-c02f-4975-8b9e-668d0bb1479f","86c575e5-9379-4c06-861e-577f26036722","b488042b-00ec-4312-9af2-4db35dc20017","8d6a46b4-493e-45d8-b898-10e39adaeed8","b615a6cd-41ba-46b4-a7bc-7d28cf3fa768","ecaf03e5-aa16-43ad-b169-c777b77b11f4","de97b733-2a55-49e3-a881-8a8d0b18e19f","b7171050-f9d8-4327-882c-d6c234ca189d","25727c0d-a854-4371-94f1-2790ee4b9191","482f78ba-a1d3-4546-82ac-d1b6e106e711","8df41c31-1f96-4a79-a