405ba4e20b740b7ffe0ff5f3f02b9cc821e467d3d4f","tests/unit/test_cli_parser_contract.py":"ac6b4441acf76164fdf333f6e5f39ab1fa01a600d1995820de472d26e7951d29","tests/unit/test_gen_cli_help.py":"e941f39289dac428462b96d6bd1ad56cef31ea6f77b0d13bd9ffc57fe4777a11","tests/unit/test_gen_cli_reference.py":"2b4c9b9b39877c39a62abf3b6899df45bfd56263223a04886dea077b9301552e"},"dropped":[{"agreement":1,"block_threshold":0.54,"blocking_enabled":true,"checklist_item":"- [ ] Render metrics/audit/bridge-fsck/bridge-probe factories through RebarHelpFormatter (or the generator's fixed-width formatter) so their committed help bytes are COLUMNS- and Python-version-independent.","criteria":["correctness","regression","edge-cases"],"decision":"dropped","drop_reason":"novelty-region","evidence":["metrics.py:23: `formatter_class=argparse.HelpFormatter,`","audit.py:23: `formatter_class=argparse.HelpFormatter,`","bridge_arms.py:32 and :80: `formatter_class=argparse.HelpFormatter,` (build_fsck / build_probe → bridge-fsck.txt / bridge-probe.txt)","_parser.py:51-72 RebarHelpFormatter docstring: argparse's default 'reads shutil.get_terminal_size() (honouring COLUMNS) when width is None, which makes help non-reproducible'; it hardcodes width=_FIXED_WIDTH (80).","_parser.py:74-120 RebarHelpFormatter overrides _format_action_invocation and _get_actions_usage_parts specifically so committed help/*.txt bytes are byte-identical on 3.11/3.12/3.13; the plain formatter gets neither override.","render_route (gen_cli_help.py:85-89) renders these routes into committed .txt checked byte-for-byte by _check (gen_cli_help.py:153-169).","These routes are help-backed: metrics/audit are group 'static_read' and bridge-fsck/bridge-probe are group 'bridge'/'repair' — all satisfy _help_backed (group != 'intercept', not hidden/retired) at gen_cli_help.py:59-62."],"finding":"Four help-backed, committed artifacts (metrics.txt, audit.txt, bridge-fsck.txt, bridge-probe.txt) are rendered from factories that pass the stock argparse.HelpFormatter rather than the fixed-width RebarHelpFormatter, so their generated bytes depend on terminal width / the COLUMNS env var and lack the Python-3.13 parity overrides — making gen_cli_help.py --check non-deterministic across environments and the CI version matrix.","id":"0","impact":0.36,"location":"src/rebar/_cli/_parsers/advanced/metrics.py:23","norm_id":"nbd85693622189beb","novelty":1.0,"priority":0.36,"reason":"default-advisory","scenarios":["A developer or CI runner with COLUMNS exported (or a wider TTY) regenerates/checks help → metrics.txt/audit.txt/bridge-*.txt wrap differently → spurious --check failure.","audit.txt (subparsers) or bridge-* help rendered on Python 3.13 wraps its usage/invocation differently from 3.11/3.12 because the parity overrides are absent → --check fails on one matrix leg."],"severity":"minor","suggested_fix":"Change formatter_class=argparse.HelpFormatter to RebarHelpFormatter in metrics.py, audit.py, and bridge_arms.py (build_fsck/build_probe), matching bridge.py; or have render_route force the fixed-width formatter regardless of the factory's choice for help-backed artifacts.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"yes"},"severity_attributes":{"blast_radius":"module","capability_degraded":true,"churn90":0,"contract_drift":true,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"high","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"medium","prod_impact":"low","reacha