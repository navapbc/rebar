{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787960876442349002,"compiled_state":{"alias":"rapt-dreadable-dromedary","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"ae203145fa39a153c21b6cba8b25cb5679849ec9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: aefe-614a-2631-4117","material: f3d9c28b3361e2ee","material-part: children 647ea2107ca5072f 0","material-part: description 904af2991526d198 7971","material-part: description_boxes a453c4f4c4b8f0c2 0","material-part: file_impact 1d58f583ca264daf 5","material-part: ticket_id d0b409b5babd3489 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (ae203145fa39-dirty)","regver: aa61189569d34126","verified-at-sha:565e1856bc9d180876fdbcaa336ccd57ceb8202e","dep c962cc92c7d4836c4b81e685e14a23d6a7c97c0aea7c6832d48bd61a255e36cd src/rebar/_reads.py","dep 4996fccc5551e953e7ccacf89bf52d739495a4a3233140c70de5ca24497c2614 src/rebar/_store/event_prepare.py","dep absent src/rebar/_store/store_usability.py","dep ee020fcfde9a22ceec69885772280a52ec9c54189e101a6e8389730f4ce290de src/rebar/audit/server.py","dep 7aa40e6f3449974c2781230ba2318563e40d54c612a40db7e70c9b7c0b385e6b tests/unit/test_reads_uninitialized_store.py","read-set: 19","read-path: infra/scripts/mcp-entrypoint.sh","read-path: scripts/check_raw_git_writes.py","read-path: src/rebar/_commands/_seam.py","read-path: src/rebar/_commands/init.py","read-path: src/rebar/_reads.py","read-path: src/rebar/_store/ensures.py","read-path: src/rebar/_store/event_append.py","read-path: src/rebar/_store/event_prepare.py","read-path: src/rebar/_store/git_outcome.py","read-path: src/rebar/_store/gitutil.py","read-path: src/rebar/audit/server.py","read-path: src/rebar/llm/reviewers/plan_review_A1.md","read-path: src/rebar/llm/reviewers/plan_review_E4.md","read-path: src/rebar/llm/reviewers/plan_review_G6.md","read-path: src/rebar/llm/reviewers/plan_review_T4.md","read-path: src/rebar/llm/reviewers/plan_review_T5e.md","read-path: tests/unit/test_raw_git_write_lint.py","read-path: tests/unit/test_reads_uninitialized_store.py","read-path: tests/unit/test_run_git_wrapper.py","currency-basis: file_impact"],"material_fingerprint":"f3d9c28b3361e2ee","merged_log_commit":"565e1856bc9d180876fdbcaa336ccd57ceb8202e","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787960185734419000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":18,"unsigned":0},"authorship_ledger":[{"content_hash":"76f6b7324b63019325a6f5ca16d061652c9174b2a4b56d2bc7c7b337f50ed93d","event_uuid":"707c0e3f-6aff-4aaa-ad3f-aed01b350f61","position":{"commit_sha":"5ca27c344c7bfce11b099761deb649d7a4250942","position":"1787938086223974001-707c0e3f-6aff-4aaa-ad3f-aed01b350f61"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b86b41f98360c2484bbda08d3f0c2ea2e171387ac7373320afe06e4962c0cce9","event_uuid":"ac453ef7-9a0c-4ecc-af20-2566c03980eb","position":{"commit_sha":"6e0cf3a050d9b0777a0f42257e37cabf629f054e","position":"1787938141287821001-ac453ef7-9a0c-4ecc-af20-2566c03980eb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7c4bf5dba28f6a875fdeafc9bb8608474a2d88ba1754d25a23ac28ac512b51ab","event_uuid":"c8807214-6e53-450c-a555-a17f2afa29e5","position":{"commit_sha":"9d145c8445b08cba1f9fd7718d25ba23b00e6459","position":"1787955419222231001-c8807214-6e53-450c-a555-a17f2afa29e5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"36102abd50c8a5ed61c7f6f2e827b842d77daa3aad4b2b5f0204e184a70e21a4","event_uuid":"e301dbcb-c348-4b82-a360-25dfc0468ada","position":{"commit_sha":"9d145c8445b08cba1f9fd7718d25ba23b00e6459","position":"1787955423158154001-e301dbcb-c348-4b82-a360-25dfc0468ada"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e0325084ef89f5b23266a9d634f658a82d45d320b9ccaef1074694ecd993a447","event_uuid":"fbdfd8bb-c3ed-4461-8079-a8b2be1e4808","position":{"commit_sha":"33aa7345405b1756049e7c887207cb32a7700c6c","position":"1787955729940235001-fbdfd8bb-c3ed-4461-8079-a8b2be1e4808"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b43afdce77e7df47cc9c5b22c03f27e3aae3aa2