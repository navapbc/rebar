{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nclass StripDocstrings(ast.NodeTransformer):\n    def generic_visit(self, node):\n        node = super().generic_visit(node)\n        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n            node.body = node.body[1:]\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n        return node\ndef normalized(raw):\n    return StripDocstrings().visit(ast.parse(raw, type_comments=True))\nfor path in sys.argv[1:]:\n    before = subprocess.check_output([\"git\", \"show\", BASE + \":\" + path], text=True)\n    after = subprocess.check_output([\"git\", \"show\", \"HEAD:\" + path], text=True)\n    if ast.dump(normalized(before), include_attributes=False) != ast.dump(normalized(after), include_attributes=False):\n        raise SystemExit(\"normalized AST changed: \" + path)' tests/unit/rebar_reconciler/test_rich_text_codec.py tests/unit/rebar_reconciler/test_rich_text_cutover.py tests/unit/rebar_reconciler/test_rich_text_echo_suppression.py tests/unit/rebar_reconciler/test_rich_text_seam_heldout.py tests/unit/rebar_reconciler/test_run_differs_recovery_no_write.py tests/unit/rebar_reconciler/test_run_pass_lock_lost_exit.py tests/unit/rebar_reconciler/test_timeout_s_forwarding_heldout_7504.py tests/unit/rebar_reconciler/test_transition_replay.py tests/unit/rebar_reconciler/test_transport_exception_contract_heldout.py tests/unit/rebar_reconciler/test_transport_param_typing_cc77.py tests/unit/rebar_reconciler/test_transport_port_completeness_heldout.py tests/unit/rebar_reconciler/test_type_mapping.py tests/unit/rebar_reconciler/test_user_identity_heldout.py tests/unit/rebar_reconciler/test_wiki_render_corpus.py tests/unit/rebar_reconciler/test_wiki_render_hardening.py tests/unit/rebar_reconciler/test_write_ahead_recovery.py","dd_id":"semantic","dd_text":"Every impacted Python file has an exactly equal normalized AST against the immutable audit basis."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nPATTERN=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\")\ndef source(ref, path):\n    return subprocess.check_output([\"git\", \"show\", ref + \":\" + path], text=True)\ndef signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for token in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if token.type != tokenize.COMMENT or not PATTERN.match(token.string):\n            continue\n        row, col = token.start\n        left=lines[row - 1][:col].rstrip()\n        anchor=(\"inline\", left) if left else (\"next\", \"<EOF>\")\n        if not left:\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    anchor=(\"next\", stripped)\n                    break\n        found.append((token.string, anchor))\n    return found\nfor path in sys.argv[1:]:\n    if signatures(source(BASE, path)) != signatures(source(\"HEAD\", path)):\n        raise SystemExit(\"directive text or attachment changed: \" + path)' tests/unit/rebar_reconciler/test_rich_text_codec.py tests/unit/rebar_reconciler/test_rich_text_cutover.py tests/unit/rebar_reconciler/test_rich_text_echo_suppression.py tests/unit/rebar_reconciler/test_rich_text_seam_heldout.py tests/unit/rebar_reconciler/test_run_differs_recovery_no_write.py tests/unit/rebar_reconciler/test_run_pass_lock_lost_exit.py tests/unit/rebar_reconciler/test_timeout_s_forwarding_heldout_7504.py tests/unit/rebar_reconciler/test_transition_replay.py tests/unit/rebar_reconciler/test_transport_exception_contract_heldout.py tests/unit/rebar_reconciler/test_transport_param_typing_cc77.py tests/unit/rebar_reconciler/test_transport_port_completeness_heldout.py tests/unit/rebar_reconciler/test_type_mapping.py tests/unit/rebar_reconciler/test_user_identity_heldout.py tests/unit/rebar_reconciler/test_wiki_render_corpus.py tests/unit/rebar_reconciler/test_wiki_render_hardening.py tests/unit/rebar_reconciler/test_write_ahead_recovery.py","dd_id":"directives","dd_text":"Every protected directive retains exact token text and executable attachment."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\"], text=True).splitlines())\nif actual != expected:\n    raise SystemExit(\"changed paths differ from file impact: actual=\" + repr(actual) + \" expected=\" + repr(expected))' tests/unit/rebar_reconciler/test_rich_text_codec.py tests/unit/rebar_reconciler/test_rich_text_cutover.py tests/unit/rebar_reconciler/test_rich_text_echo_suppression.py tests/unit/rebar_reconciler/test_rich_text_seam_heldout.py tests/unit/rebar_reconciler/test_run_differs_recovery_no_write.py tests/unit/rebar_reconciler/test_run_pass_lock_lost_exit.py tests/unit/rebar_reconciler/test_timeout_s_forwarding_heldout_7504.py tests/unit/rebar_reconciler/test_transition_replay.py tests/unit/rebar_reconciler/test_transport_exception_contract_heldout.py tests/unit/rebar_reconciler/test_transport_param_typing_cc77.py tests/unit/rebar_reconciler/test_transport_port_completeness_heldout.py tests/unit/rebar_reconciler/test_type_map