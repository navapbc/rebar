er_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"96ed173fbfa721a107940801e6133231f77267567afdc6f64ec0cf0ecbb0d6cb","event_uuid":"1c9ea01b-8595-41db-9349-14717654b5d7","position":{"commit_sha":"e0644f2c728d6c088f78c2c2f2d135de14e75284","position":"1787419505182557001-1c9ea01b-8595-41db-9349-14717654b5d7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787418664201975001,"creation_channel":"cli","deps":[],"description":"## Context\nThe GitHub About description currently says Rebar is an LLM-first event-sourced ticket system and Jira reconciler, then identifies GitHub as a read-only mirror. It does not explain the capability that distinguishes Rebar from conventional trackers. ADR 0018 and the plan-review gate guidance establish enforceable review before claim. The completion gate and operation-certificate guidance establish signed verification before close.\n\n## Plan\n- Replace the `navapbc/rebar` repository description with concise client-facing wording that leads with plan review.\n- State the observable mechanisms rather than make an unsupported superiority claim.\n- Preserve the read-only GitHub mirror and Gerrit code-review facts.\n- Keep the description within GitHub limits and avoid internal implementation terms.\n- Read the repository metadata back after the update and record the exact value.\n- Change GitHub repository metadata only.\n\n## Proposed Description\nRebar can block work until an AI plan review passes, require signed completion verification before close, and reconcile its event-sourced ticket record with Jira across CLI, Python, and MCP. GitHub is a read-only mirror. Code review runs in Gerrit.\n\n## Acceptance Criteria\n- [ ] The GitHub About description leads with enforceable plan review before work begins.\n- [ ] It names signed completion verification, event-sourced history, Jira reconciliation, and the CLI, Python, and MCP interfaces.\n- [ ] It preserves the read-only mirror and Gerrit review facts.\n- [ ] It fits the GitHub repository-description limit.\n- [ ] `gh repo view navapbc/rebar --json description` returns the approved description exactly.\n- [ ] No repository file, homepage URL, or topic changes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"none","keyring":[],"managed_refs":[["parent","f7e4-4d33-f231-4774"]],"no_file_impact_reason":"GitHub repository metadata only. No repository file changes.","parent_id":"f7e4-4d33-f231-4774","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f20","github"],"ticket_id":"71fe-c6e9-0d52-48d8","ticket_type":"task","title":"F20 update GitHub About to emphasize plan review","verify_commands":[{"command":"gh repo view navapbc/rebar --json description --jq .description","dd_id":"D1","dd_text":"GitHub About description matches the approved text"},{"command":"gh repo view navapbc/rebar --json homepageUrl,repositoryTopics","dd_id":"D2","dd_text":"Repository homepage and topics remain unchanged"}]},"source_event_uuids":["97f389ac-b204-46e2-9a13-c19ab2d8d225","ea50c3a3-acb7-46e7-8b83-aaa79ea30dcb","925a9c72-1247-4872-ac8c-86296bbe597f","5972e3ba-272f-4f5c-890c-ca10c861f959","1c9ea01b-8595-41db-9349-14717654b5d7"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787421919114395111,"uuid":"a7aeab16-e228-494e-b2dd-90b830ca755e"}