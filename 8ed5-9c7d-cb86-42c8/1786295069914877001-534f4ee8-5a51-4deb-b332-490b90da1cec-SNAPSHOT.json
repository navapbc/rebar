n":"1786290883009838001-c1a604af-c18b-4457-aa3a-dd93a1be9d91"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"53b571d43839c8156e86c9dfd04657e9c30b3d1873dd8711dbfdb585417d890a","event_uuid":"d1552de2-20fc-4d50-b54a-c81cf291a0f3","position":{"commit_sha":"c20bbff6ee921d24d7bf16923ef9217496a17dec","position":"1786290886983344001-d1552de2-20fc-4d50-b54a-c81cf291a0f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2d79eb2be12f7a64028f454c8692c375ebf47f2ebd3c7e523560f3f488320214","event_uuid":"de3051bc-d27c-4524-ba10-1277a255b958","position":{"commit_sha":"090c6db031e275eace0a7ac87fd591dee465a723","position":"1786290888797907001-de3051bc-d27c-4524-ba10-1277a255b958"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Joe Oakhart","body":"Evidence for AC3 (external/operational): the v0.7.0 GitHub Release EXISTS and is marked Latest. Verified with 'gh release list --repo navapbc/rebar' → 'v0.7.0  Latest  v0.7.0'. Release URL: https://github.com/navapbc/rebar/releases/tag/v0.7.0 with assets nava_rebar-0.7.0-py3-none-any.whl + nava_rebar-0.7.0.tar.gz attached. Created as a one-off via 'gh release create v0.7.0 --generate-notes --latest' because PyPI 0.7.0 is immutable and the tag workflow cannot be safely re-run. AC1 (GH_REPO fix) merged as change 316; AC2 (next tag release auto-creates) is forward-looking and covered by the merged fix.","timestamp":1783305177477636001}],"created_at":1783304014179907001,"creation_channel":"unknown","deps":[{"link_uuid":"b7bd6905-e4dc-4e54-a7c2-e5d3d554de95","relation":"discovered_from","target_id":"f112-6222-e236-4b09"}],"description":"## Reproduction Steps\n1. Push a v* tag (v0.7.0) → release.yml runs.\n2. Build + Publish to PyPI succeed.\n3. The `github_release` job fails in ~6s.\n\n## Expected vs Actual\n- **Expected:** the job creates the GitHub Release for the tag.\n- **Actual:** step fails with `failed to run git: fatal: not a git repository (or any of the parent directories): .git` (exit 1). GitHub Actions run 28763401143, job \"Create GitHub Release\".\n\n## Root cause\nThe `github_release` job only runs `actions/download-artifact` then `gh release …`. It never runs `actions/checkout`, and sets no `GH_REPO`, so the `gh` CLI has no repository context and tries to infer it from a local git repo that isn't there.\n\n## Fix\nSet `GH_REPO: ${{ github.repository }}` in the step env (lighter than a full checkout; `gh release create/view/edit/upload` and `--generate-notes` all work against the API with GH_REPO set). Introduced by change 314 (ticket f112-6222-e236-4b09).\n\n## Acceptance Criteria\n- [x] `.github/workflows/release.yml` `github_release` step sets `GH_REPO: ${{ github.repository }}` (or checks out the repo) so `gh` has repo context.\n- [x] The next tag-triggered release creates the GitHub Release automatically without the git-repository error.\n- [x] v0.7.0 GitHub Release exists and is marked Latest (created as a one-off since PyPI 0.7.0 is immutable and the tag workflow cannot be safely re-run).","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"1b69bc09-8a7c-48e4-ba1a-e8783a4926b0","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","status_fork_resolutions":[{"dropped_uuid":"d1552de2-20fc-4d50-b54a-c81cf291a0f3","winner_uuid":"1b69bc09-8a7c-48e4-ba1a-e8783a4926b0"}],"tags":[],"ticket_id":"8ed5-9c7d-cb86-42c8","ticket_type":"bug","title":"release.yml github_release job fails: gh needs repo context (not a git repository)","verify_commands":[]},"source_event_uuids":["28b9cbc7-5120-4e19-9a5e-4aa62e71ca85","b7bd6905-e4dc-4e54-a7c2-e5d3d554de95","e9067eff-fa1a-4d68-993f-d851e722da38","3ae301c9-e3d4-44b1-9442-364acd17ffc6","f336cdd5-1a78-4146-848a-4fd695af7147","5bfd2dbf-a15d-4c08-a3c7-61d25262bf79","1b69bc09-8a7c-48e4-ba1a-e8783a4926b0","9e01c1dc-58f9-4738-b5c4-721babb1f216","294885ed-0919-4b29-9e9b-2790c82c30f8","c1a604af-c18b-4457-aa3a-dd93a1be9d91","d1552de2-20fc-4d50-b54a-c81cf291a0f3","de3051bc-d27c-4524-ba10-1277a255b958"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786295069914877001,"uuid":"534f4ee8-5a51-4deb-b332-490b90da1cec"}