-a546-36a99ec2e922"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"55d5a54786f4a1e9054005c3555a08babb3aef67df51b30cb19587180ad273e9","event_uuid":"b6285424-7a3f-438d-aefc-f3286aefa98a","position":{"commit_sha":"374e6657094cebd91ab0f5ecbf81de65c513df7f","position":"1788491274474198001-b6285424-7a3f-438d-aefc-f3286aefa98a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"634905a1d70ea98d2879d27652ffe442af51c1a0270bf49dbfeb13062d105828","event_uuid":"9ef6a643-edb3-4611-b424-c0a1cbecb87d","position":{"commit_sha":"e167e308d9b95c2e69c4998a8f4fdd89086020ff","position":"1788491301698367001-9ef6a643-edb3-4611-b424-c0a1cbecb87d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3abb74c5019599afa58093b723eb247c0549e79b8e365be599acd70a359f5dc3","event_uuid":"4b391792-e319-470e-9495-cccde8074089","position":{"commit_sha":"98ccbf7dbb00ec2fe4422824635f8b9a5398eca6","position":"1788493252784131001-4b391792-e319-470e-9495-cccde8074089"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c47bfec0fc5df370b7741dbf5d79b2445dde60e5ad30b8eb4d06fce71a5f093d","event_uuid":"52b9d38d-57ed-41da-aba2-d47821a87173","position":{"commit_sha":"0a80906e37a0e9fbc4dff4c88c17c5b1be3d06a4","position":"1788493347582689001-52b9d38d-57ed-41da-aba2-d47821a87173"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fb3b5f85185ff9a1d25ed0b32ac3ccaeda2147854a40b5a8b49cfaac977ca708","event_uuid":"e3418868-7562-422d-8840-5cb8e4094643","position":{"commit_sha":"79b065795a97302a59845f36ffa3fe5342d832c0","position":"1788494081454279908-e3418868-7562-422d-8840-5cb8e4094643"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-259_agent","claim_remote_session":null,"claimed_session":"72e08d92-bab9-41e6-a77e-0524c3443c0b","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA progress (2026-09-03): Step 0(a) tracker sweep found existing in-progress duplicate for `test_editor_e2e.py::test_emitted_bpmn_has_no_illegal_ids` / BPMN illegal ids: this ticket (`9a17-e0b3-7aa6-4091`, `skipping-unamorous-massasauga`), so I am resuming it rather than filing a duplicate. Step 0(b) reported-against floor comes from the triggering report: Gerrit change 2592 / ticket `8eff-87c1-d09a-4893` saw Ubuntu xdist worker crashes in CI runs 33815705743 and 33819616393; no exact tested commit has been independently recovered yet. Step 0(c) fresh worktree `../janitor-editor-e2e-flake` is at `85ef5ad33ada9540d18bd17775bf2a521ef6ccbb`, equal to `origin/main`. Beginning local reproduction on current main; no code fix will be landed in this pass.","timestamp":1788484286830412465},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Reproduced the reported failure LOCALLY and deterministically before fixing it. From a cold tests/e2e/js (node_modules + dist removed), `pytest tests/e2e -n 4 --dist worksteal` produced exactly the CI signature: `[gw3] node down: Not properly terminated` / `[gw1] node down: Not properly terminated`, 2 failed / 12 passed / 7 skipped in 306.60s. That run already carried an explicit per-step timeout and an flock, which is the finding worth recording: a lock ALONE does not fix this. Under -n 4 every worker runs the session-scoped fixture, so serializing them converts the race into a QUEUE that is still charged to a test's 300s pytest-timeout budget — the waiters were killed instead of the installer.\n\nThe fix therefore moves provisioning out of the fixture into `pytest_collection_modifyitems` in tests/e2e/conftest.py. Collection is not a test item, so pytest-timeout does not bound it; the fixture keeps a last-resort fallback that re-reports rather than re-runs a failed provisioning.\n\nPost-fix, same cold state, no pre-step: 21 passed in 111.83s, no worker kill. With `make e2e-deps` run first: 21 passed in 71.80s and the slowest single span is 7.57s (was 90-120s of fixture setup billed to one test). `make e2e-deps` itself took 7m02s cold on this host — which is precisely why it must not sit inside a test's budget.","timestamp":1788484724918903001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA confirmed (2026-09-03): `tests/e2e/test_editor_e2e.py::test_emitted_bpmn_has_no_illegal_ids` worker crashes are a pre-existing test/toolchain flake, not caused by `8eff-87c1-d09a-4893` / Gerrit 2592.\n\nEvidence:\n- CI crash fingerprint recurred twice on Gerrit 2592: run 33815705743 py3.13 logged `[gw0] node down: Not properly terminated`, then `worker 'gw0' crashed while running 'tests/e2e/test_editor_e2e.py::test_emitted_bpmn_has_no_illegal_ids'`, with coverage reporting a failed worker and no test assertion; run 33819616393 py3.11 logged the same node-down/crashed-worker signature.\n- Current `origin/main` reproduction worktree: `85ef5ad33ada9540d18bd17775bf2a521ef6ccbb` (= `origin/main`). The e2e fixture does lazy Node provisioning in test setup: `tests/e2e/conftest.py:47-58` runs `npm install` / `npm run build` inside session-scoped `bpmn_harness` when `node_modules` or `dist/roundtrip.mjs` is absent. Pytest's global timeout covers fixture setup (`pyproject.toml:719-720`, `timeout=300`, `timeout_method=thread`), and CI runs the default tier under xdist worksteal (`.github/workflows/_build-and-test.yml:781-786`). The workflow comments document the failure mode: the thread timeout exits the worker, producing `node down: Not properly terminated` instead of a normal timeout failure (`.github/workflows/_build-and-test.yml:772-777`).\n- Discriminating local experiments: cold toolchain + isolation with the normal 300s budget timed out in fixture setup after 300s while blocked in `subprocess.run([npm, \"install\"], cwd=_JS_DIR, ...)` (`tests/e2e/conftest.py:51-53`). Cold toolchain + xdist + deliberately-short `--timeout=10 --timeout-method=thread` reproduced the exact xdist crash signature: `[gw3] node down: Not properly terminated` and `worker 'gw3' crashed while running ...test_emitted_bpmn_has_no_illegal_ids` in 11.38s. With the toolchain preinstalled and bundle prebuilt, the same xdist command with `--timeout=10` passed in 1.50s. This rules out BPMN illegal-id assertion failure, BPMN serialization nondeterminism, and 8eff docs/scripts changes; the crash is caused by provisioning work happening inside the per-test timeout window.\n- 8eff/Gerrit 2592 patchset 2 only changes docs/ADR/API-stability/architecture and script-policy tests: `docs/adr/.numbers/0111`, `docs/adr/0111-no-internal-only-compatibility-shims.md`, `docs/adr/README.md`, `docs/api-stability.md`, `docs/architecture.md`, `tests/scripts/test_internal_shim_policy_docs.py`, `tests/scripts/test_no_internal_shim_policy.py`. It does not touch `tests/e2e/`, BPMN/editor code, Node harness code, pytest timeout config, or CI xdist command lines.\n\nClassification: (a) genuine pre-existing flaky/test-isolation/resource-timeout bug independent of 8eff. Not a provably transient infra-only fault: the class is reproducible locally by constraining the same pytest-timeout mechanism, and CI hit it on two interpreter shards. Defect origin: ticket `bold-abeyant-indri` (`73b8-2d79-3046-44ce`), commit `6a5c88027c59d3e24d3e4269838fb3c591a64240` (`Adopt standard test-hygiene tooling`) introduced the global fixture-covering pytest-timeout mechanism; the pre-existing lazy e2e provisioning then became capable of killing xdist workers when registry/install latency exceeded the budget.\n\nMinimal fix required: move e2e Node provisioning out of the `bpmn_harness` fixture/test timeout budget (prefer CI/local `make e2e-deps` using lockfile-based `npm ci` before pytest, plus a collection/session-level fallback that is not charged to an individual test item), and keep any fallback subprocesses explicitly bounded/diagnostic. Do not unblock 8eff with a blind `recheck`; either land this class fix first, or accept a targeted recheck only as a tactical retry with known residual flake risk, not because the evidence proves transient infra.","timestamp":1788484963851856733},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"PRIORITY RAISED TO 0. New evidence: this defect is currently failing ~46% of ALL CI runs repo-wide, not just the changes that first surfaced it. Over the last 60 Gerrit Verified runs (2026-09-03 14:27Z to 09-04 03:01Z): 27 success, 23 failure of 50 completed. It blocks every open change in the repository.\n\nIT IS NOT INTERMITTENT, AND THAT CORRECTS HOW I FRAMED IT. I posted a recheck on change 2594 describing this as an 'intermittent race'. That was wrong. It is a FIXED, UNBOUNDED-COST fixture measured against a FIXED budget, and the cost has grown until it straddles the 300s cliff. Measured setup times for test_emitted_bpmn_has_no_illegal_ids on jobs that PASSED, from --durations output:\n  40.96s  (run 33815025971, py3.11)\n  101.86s (run 33829699178, py3.12)\n  201.58s (run 33829352524, py3.12)\n  271.35s (run 33819649550, py3.12)  <- 90% of the 300s budget, barely passed\nAnything over 300s trips timeout_method='thread', which calls os._exit(1) and kills the worker. So which matrix cells fail varies run to run while the underlying cost does not -- that is why a recheck did not clear it and why it lands on different Python versions each time. Corroboration that it is a timeout and not OOM or a segfault: no [rebar-ci-timing] warning for bpmn_harness appears in ANY failing log, because the fixture never completed setup.\n\nONSET IS SHARP: last fully clean run 33811108275 at 2026-09-03T22:02:43Z; first gw0 crash run 33813339060 at 22:30:05Z; zero occurrences from 09-03 01:04Z through 22:02Z. No commit merged in that window touches the e2e/Node/CI path.\n\nTHREE THINGS THE FIX MUST ACCOUNT FOR:\n\n1. PLAYWRIGHT DOMINATES THE COLD INSTALL and is a devDependency needed only by browser_runner, not by bpmn_harness. Removing it from the bpmn_harness provisioning path is the single cheapest lever and may alone drop the cost below the cliff. Evaluate this even if the structural fix lands too.\n\n2. THE VERIFIED LANE RUNS WORKFLOWS FROM TRUSTED MAIN, so a CI-side pre-provisioning step CANNOT be validated from a patchset -- it only takes effect once merged. Plan for that: do not expect a green Verified on the patchset that introduces the CI step, and do not read its absence as failure.\n\n3. THE PORTABLE HALF IS STILL REQUIRED. A CI-only pre-provision step does not satisfy project.portability. The in-process path must also work with no CI provider -- either provisioning outside any test's budget (a pytest_sessionstart or collection hook) or an explicit marked timeout naming the provisioning cost.\n\nmacOS never exercises this: DEFAULT_SUITE_MARKS restricts the macOS job to platform_compat, and test_editor_e2e appears zero times in the macOS log. So the matrix hides the defect on one of four cells.","timestamp":1788491301698367001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Patchset 2 pushed (change 2600). Remediation of LLM-Review -1 + Verified -1, plus the P0 escalation.\n\nVerified -1 was MINE, not a pre-existing flake: tests/unit/test_predates_gate_guard_parity.py::test_completeness_every_gate_step_is_guarded_or_marked. The Verified lane runs workflows from trusted main against an arbitrary patchset, so a base predating this change has no e2e-deps rule and a bare 'make e2e-deps' would have failed the step — turning this fix into a red vote on other people's changes. Now guarded with a 'make -n e2e-deps' probe. Worth recording the local/CI skew that hid it: the gate only considers git-TRACKED paths, so my local run passed while tests/e2e/_toolchain.py was still untracked and CI failed the moment it was committed.\n\nLLM-Review blocking finding (the collection hook had no oracle) is addressed by driving the REAL conftest through a nested pytest over a replica tree with stub node/npm. Coverage is mutation-checked: eight mutations, all killed. One test was found VACUOUS by that exercise — removing the _PROVISION_ATTEMPTED guard changed nothing observable, because pytest_collection_modifyitems fires once per session. The flag was dead mechanism, so it was deleted rather than papered over with a test; _PROVISION_ERROR alone carries every observable behaviour.\n\nAdvisory 1 was a real bug and is fixed: browser_runner never consulted the provisioning state, so a failed npm ci surfaced for bpmn_harness and not for it.\n\nEscalation lever (playwright): measured, and the wall-clock number is NOT usable from this host — paired cold runs gave 111.8s omit-optional vs 63.4s full, then 420.9s omit-optional, i.e. registry variance dominates; --offline with a warm cache is ~1s either way. The reliable measurements are counts and bytes: 15 -> 11 packages, 30M -> 12M node_modules (playwright 4.8M + playwright-core 12M = 56% of the tree). One correction to the escalation: the published playwright package has NO postinstall script, so there is no browser download in this path — the saving is package download/extract only. playwright is now an optionalDependency and a selection with no browser test installs with --omit=optional.\n\nNote for readers of the next Verified run: the CI-side pre-provisioning step CANNOT be exercised on this patchset, because the Verified lane runs the workflow from trusted main. Only the portable in-process half is under test here.","timestamp":1788493252784131001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Patchset 2 up on change 2600. Three corrections and one measurement worth pinning, including one to my own escalation comment above.\n\nCORRECTION TO MY ESCALATION -- the playwright lever is real but smaller than implied. I relayed it as 'dominates the cold install'. Measured properly it dominates in BYTES, not because of a browser download: the published playwright package has NO postinstall script (verified in its package.json: scripts: None), so nothing downloads browsers on this path. The saving is package download and extract only. The honest numbers:\n  full npm ci             : 15 packages, 30M node_modules\n  npm ci --omit=optional  : 11 packages, 12M node_modules\n  playwright 4.8M + playwright-core 12M = 16.8M = 56% of the tree\nOn a cold-cache runner that is still the dominant download fraction, so the lever was worth taking -- it is now an optionalDependency with --omit=optional for selections containing no browser test. But 'playwright downloads browsers' would have been wrong and is deliberately not in the commit message.\n\nWALL-CLOCK MEASUREMENT IS NOT OBTAINABLE FROM THIS HOST, which is itself worth recording so nobody retries it. Paired cold runs: --omit=optional 111.8s, full 63.4s, then --omit=optional again 420.9s. Registry variance dominates and INVERTS the comparison. Against a warm cache with --offline it is ~1s either way. Counts and bytes are the only stable evidence here.\n\nTHE VERIFIED -1 ON PATCHSET 1 WAS OURS, NOT THE PRE-EXISTING FLAKE, and the substance is worse than the message. test_predates_gate_guard_parity flagged an unguarded 'make e2e-deps' in the workflow. Because the Verified lane runs workflows from TRUSTED MAIN against an arbitrary patchset, a base predating this change has no e2e-deps rule, so the bare invocation fails the step -- this fix for a repo-wide CI failure would itself have cast red votes on everyone else's changes. Now guarded with a 'make -n e2e-deps' probe (which also keeps the guard reading the tree's own Makefile, the only thing that can answer the question) plus an ::notice:: on the skip path.\n\nLOCAL/CI SKEW THAT HID IT, worth knowing generally: that gate considers only GIT-TRACKED paths. A 16718-passing local run was green while tests/e2e/_toolchain.py was still untracked, and CI failed the instant it was committed. Re-running the gate after 'git add' is the habit that catches this class.\n\nA VACUOUS TEST WAS FOUND AND THE MECHANISM DELETED RATHER THAN PROTECTED. Removing 'if _PROVISION_ATTEMPTED: return' from the hook changed nothing observable, because pytest_collection_modifyitems fires once per session -- it was dead mechanism. The right response was deleting the flag, not writing a test to defend it. _PROVISION_ERROR alone now carries every observable behaviour and every remaining branch has a killing mutation. Eight mutations applied, all eight killed.\n\nSTRONGEST EVIDENCE IN THE CHANGE: cold state (node_modules and dist removed), CI xdist config, no pre-step -> 63 passed in 442.35s with NO worker kill. On the old code the identical cold state killed two workers at the 300s cliff (2 failed, 12 passed, 7 skipped in 306.60s). 442s of wall clock, none of it charged to any test's budget.\n\nREMINDER FOR REVIEWERS: a still-red Verified on this patchset is EXPECTED and is not evidence the CI step is wrong. The Verified lane runs workflows from trusted main, so the pre-provisioning step and the npm cache cannot take effect until this merges. Only the portable in-process half is under test on the patchset -- which is why that half carries the mutation-checked coverage.","timestamp":1788493347582689001}],"created_at":1788479648120928001,"creation_channel":"cli","deps":[{"link_uuid":"ebae5193-4258-4454-b328-48bc75516e0d","relation":"discovered_from","target_id":"78f2-b104-e3c9-4b86"},{"link_uuid":"d429c1f9-d5d0-4089-8446-976a0324bc99","provenance":"explicit","relation":"caused_by","target_id":"73b8-2d79-3046-44ce"},{"link_uuid":"5e5738a6-6bd9-4b7d-a7ce-e8932a8c9475","relation":"relates_to","target_id":"4ede-586f-ca9e-4208"},{"link_uuid":"a2ce22d1-9379-4e20-a546-36a99ec2e922","relation":"relates_to","target_id":"a1f1-a30d-2d50-4f5a"},{"link_uuid":"e3418868-7562-422d-8840-5cb8e4094643","relation":"relates_to","target_id":"ae8f-61e6-4b9c-460f"}],"description":"## Context / Problem\n\n`tests/e2e/test_editor_e2e.py::test_emitted_bpmn_has_no_illegal_ids` intermittently fails in CI\nas `worker 'gw0' crashed` / `[gw0] node down: Not properly terminated`, with no traceback and no\nassertion — a killed xdist worker, not a test failure. Observed on unrelated Gerrit changes 2592,\n2593 and 2594 within ~30 minutes on 2026-09-03. It costs every contributor a red `Verified` vote\non work that is not at fault, and AGENTS.md forbids retrying a flake instead of root-causing it.\n\n## Root cause (measured, confirmed in the tree)\n\n`tests/e2e/conftest.py::bpmn_harness` is session-scoped and provisions the Node toolchain lazily\ninside the FIRST e2e test's setup: `subprocess.run([npm, \"install\"], …)` at\n`tests/e2e/conftest.py:52` and `subprocess.run([npm, \"run\", \"build\"], …)` at\n`tests/e2e/conftest.py:58`. Neither carries a `timeout=`, unlike every other subprocess in the\nsame file (`:74` `timeout=60`, `:118` `timeout=150`), so their only bound is the global\npytest-timeout: `timeout = 300` / `timeout_method = \"thread\"` at `pyproject.toml:719-720`,\ndeliberately without `timeout_func_only`, so the budget covers fixture setup. The `thread`\nmethod calls `os._exit(1)` — documented in-tree at\n`.github/workflows/_build-and-test.yml:774` — so an over-run kills the whole worker instead of\nreporting `Failed: Timeout`. In passing CI run 33811108275 that setup is the slowest span in the\nsuite (101.26s / 120.93s / 89.69s across py3.11/3.12/3.13); 90-120s of a 300s budget is a\n2.5-3.3x margin that npm-registry variance can consume. There is no `setup-node` step and no npm\ncache in `.github/workflows/`, so every run pays a cold registry install, and under\n`-n 4 --dist worksteal` (`.github/workflows/_build-and-test.yml:782`) each worker runs the\nsession-scoped fixture independently, so several can race the same `tests/e2e/js/node_modules`.\n\n## Approach\n\nCharge provisioning to the build, not to a test, and make the in-fixture fallback bounded and\nrace-safe. This shape is chosen because it fixes both halves of the defect class in the place\neach one lives: the unbounded subprocess is a code defect in the fixture, and the cold install\non the critical path is a build-ordering defect in the workflow.\n\nPortability is the constraint that rules out a CI-only fix (blocking `project.portability`): the\nprovisioning must still work in a checkout with no CI provider. So the primary path is a plain\n`make e2e-deps` target that any developer or any CI system can invoke, and the fixture keeps\nprovisioning as a fallback — now with explicit `timeout=` values and a file lock — rather than\nbeing deleted.\n\nExtract the provisioning into `tests/e2e/_toolchain.py` (a small module beside the fixture, so\nit is directly callable from a test without spawning pytest); `tests/e2e/conftest.py` calls it\nand converts its error into the existing self-skip. A `fcntl.flock` on a lock file in\n`tests/e2e/js/` serializes concurrent xdist workers, degrading to no lock where `fcntl` is\nabsent (single-process correctness is unaffected).\n\n## Scope\n\n- `tests/e2e/_toolchain.py` (new) — `provision_toolchain()` with explicit per-step `timeout=`,\n  a step-naming `ToolchainProvisioningError`, and the cross-process lock.\n- `tests/e2e/conftest.py` — `bpmn_harness` delegates to it and self-skips with the named message.\n- `tests/e2e/test_toolchain_provisioning.py` (new) — the tests below.\n- `Makefile` — `e2e-deps` target: `npm ci` + `npm run build` in `tests/e2e/js`.\n- `.github/workflows/_build-and-test.yml` — an npm cache keyed on\n  `tests/e2e/js/package-lock.json` plus a `make e2e-deps` step before the pytest step at\n  `:781`.\n\n## Testing\n\nA stub `npm` on `PATH` (a shell script that sleeps, or that succeeds then sleeps) makes every\ncase deterministic and fast; no network and no real Node install is involved.\n\n- Happy path: `provision_toolchain` against a stub `npm` that exits 0 returns without error and\n  the build step runs.\n- Failure path (the one that reproduces the bug): a stub `npm` that stalls past the explicit\n  `timeout=` makes `provision_toolchain` raise within the bound, with a message naming the\n  step — `npm install` for the install stall, `npm run build` for the build stall — instead of\n  running unbounded into the 300s pytest budget.\n- Concurrency path: two independent processes call `provision_toolchain` on the same directory\n  at once against a stub `npm` that records enter/exit; their install spans do not overlap.\n- Build-ordering: assert the Makefile exposes `e2e-deps` and that the workflow invokes it in a\n  step preceding the pytest step, and caches on `tests/e2e/js/package-lock.json`.\n\nRun with `pytest tests/e2e/test_toolchain_provisioning.py -q`, plus `make lint` and\n`make typecheck`.\n\n## Acceptance Criteria\n\n- [ ] Both provisioning subprocesses carry an explicit `timeout=`, and exceeding one raises an\n      error whose message names the provisioning step (`npm install` / `npm run build`) — never\n      a worker kill and never a bare `node down`. Checked by\n      `pytest tests/e2e/test_toolchain_provisioning.py -q`, whose stalled-`npm` cases assert the\n      call returns within the bound with the step named.\n- [ ] Toolchain provisioning is available as a portable pre-pytest step that needs no CI\n      provider, and the in-fixture path still provisions in a checkout that never ran it.\n      Checked by running `make e2e-deps` from a clean worktree, and by the fixture test that\n      provisions from an empty directory with a stub `npm`.\n- [ ] CI caches the npm store keyed on `tests/e2e/js/package-lock.json` and provisions with\n      `npm ci` rather than `npm install`. Checked by the workflow/Makefile assertions in\n      `tests/e2e/test_toolchain_provisioning.py` and by `make lint` (actionlint).\n- [ ] Concurrent provisioning by two or more xdist workers is serialized. Checked by the\n      two-process test asserting non-overlapping install spans.\n- [ ] Verified in real time, not by waiting for a recurrence: with `tests/e2e/js/node_modules`\n      and `tests/e2e/js/dist` removed, `make e2e-deps` followed by\n      `pytest tests/e2e -n 4 --dist worksteal -q` completes with no worker kill and no\n      `node down`, and the stalled-`npm` cases above show the diagnosable named failure instead.\n      Both complete in one session.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/e2e/_toolchain.py","reason":"new: provision_toolchain() with explicit per-step timeout=, a step-naming ToolchainProvisioningError, and a cross-process lock so concurrent xdist workers cannot race the same node_modules/dist"},{"path":"tests/e2e/conftest.py","reason":"bpmn_harness delegates provisioning to _toolchain and converts its named error into the tier's existing self-skip instead of running two unbounded subprocesses inside a test's 300s pytest-timeout budget"},{"path":"tests/e2e/test_toolchain_provisioning.py","reason":"new: deterministic stub-npm tests for the stalled-install and stalled-build named failures, the concurrency serialization, and the Makefile/workflow build-ordering assertions"},{"path":"Makefile","reason":"portable e2e-deps target (npm ci + npm run build in tests/e2e/js) so the fix is not CI-only per project.portability"},{"path":".github/workflows/_build-and-test.yml","reason":"npm cache keyed on tests/e2e/js/package-lock.json plus a make e2e-deps step before the pytest step, so cold install time is not charged against a single test's timeout budget"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","4ede-586f-ca9e-4208"],["relates_to","a1f1-a30d-2d50-4f5a"],["relates_to","ae8f-61e6-4b9c-460f"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e30a0894-e44e-4508-a6e2-1cbac0c0f9ae","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":0,"repos":[],"reverts":[],"status":"in_progress","tags":["bug","tests","ci","flake"],"ticket_id":"9a17-e0b3-7aa6-4091","ticket_type":"bug","title":"e2e Node toolchain is provisioned inside a test's timeout budget, killing an xdist worker","verify_commands":[]},"source_event_uuids":["7f45b77b-a692-4cfa-83d9-2d9839d474a9","7fa1957c-908e-40f4-a6dc-cfdecf1bd95a","2bb299e4-abd2-4aef-b351-a2373e981c80","e30a0894-e44e-4508-a6e2-1cbac0c0f9ae","c11dbb2d-65dd-4a45-b748-54cdd910ebe8","613121cf-2268-45bc-b748-008043fd10b5","8b85c73a-a684-46a6-9cfe-1e9752b05f5c","5d0320d7-bcb9-4520-883a-6e5c2b26988d","d429c1f9-d5d0-4089-8446-976a0324bc99","5e5738a6-6bd9-4b7d-a7ce-e8932a8c9475","a2ce22d1-9379-4e20-a546-36a99ec2e922","b6285424-7a3f-438d-aefc-f3286aefa98a","9ef6a643-edb3-4611-b424-c0a1cbecb87d","4b391792-e319-470e-9495-cccde8074089","52b9d38d-57ed-41da-aba2-d47821a87173","e3418868-7562-422d-8840-5cb8e4094643"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788496562395283001,"uuid":"96db532e-297e-4214-9441-b3325c069bc0"}