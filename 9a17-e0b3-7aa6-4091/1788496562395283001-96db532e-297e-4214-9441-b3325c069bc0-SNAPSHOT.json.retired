{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788496562395283001,"compiled_state":{"alias":"skipping-unamorous-massasauga","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"08a39c39c50d61dd4b9ce71404a25a6bc5e13f61","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 9a17-e0b3-7aa6-4091","material: cb4a9559d2dc1796","material-part: children 647ea2107ca5072f 0","material-part: description 4d4eaf3e984956d7 6303","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 38eda74cb6f60505 5","material-part: ticket_id b2e3609cb033e356 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.13.1 (08a39c39c50d-dirty)","regver: aa61189569d34126","verified-at-sha:08a39c39c50d61dd4b9ce71404a25a6bc5e13f61","dep ef574b69d18a65d0b44545aaef72818a7eb6fe2b7fd79f1eaac7db82bd147ecc .github/workflows/_build-and-test.yml","dep 268d20594f1abfe2a8041c39fd51472cc9e660775d07189f665560d2016c4ff3 Makefile","dep absent tests/e2e/_toolchain.py","dep 5f15c38cca55820e34f4743294c5c9957f0b6ec060687630adc4419260d83d25 tests/e2e/conftest.py","dep absent tests/e2e/test_toolchain_provisioning.py","read-set: 7","read-path: .github/workflows/_build-and-test.yml","read-path: Makefile","read-path: pyproject.toml","read-path: src/rebar/_snapshot/git_fetch.py","read-path: src/rebar/_store/fsutil.py","read-path: tests/e2e/conftest.py","read-path: tests/e2e/js/package.json","currency-basis: file_impact"],"material_fingerprint":"cb4a9559d2dc1796","merged_log_commit":"08a39c39c50d61dd4b9ce71404a25a6bc5e13f61","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788481131493547000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":19,"unsigned":0},"authorship_ledger":[{"content_hash":"1ec72f72859f3feb9e28f46046a120f3d38ceb8f4ca0b4ed6e5ea73efe3c4e5e","event_uuid":"7f45b77b-a692-4cfa-83d9-2d9839d474a9","position":{"commit_sha":"25f54c8da654e1df75ed82de542e2897fa6dce7d","position":"1788480697038377001-7f45b77b-a692-4cfa-83d9-2d9839d474a9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ba31769cf5ad20f5bd9a4019c16e41a82bf9577f41f3ee8abd79f731ae86f337","event_uuid":"7fa1957c-908e-40f4-a6dc-cfdecf1bd95a","position":{"commit_sha":"2278d1f80d0592a25609182ef4450d735ac70299","position":"1788480725098988001-7fa1957c-908e-40f4-a6dc-cfdecf1bd95a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"48d667541ff5e1253b0f6d230d162b7bfc21d7b1a766e6b5fd586092811723cb","event_uuid":"2bb299e4-abd2-4aef-b351-a2373e981c80","position":{"commit_sha":"450ef787b4b2f05da1007d31db499eed3801833f","position":"1788481131499113001-2bb299e4-abd2-4aef-b351-a2373e981c80"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"83c770b6c7970697c91513c63d7b21cd162438db3b785fc38177b11441533dbd","event_uuid":"e30a0894-e44e-4508-a6e2-1cbac0c0f9ae","position":{"commit_sha":"06d70b9fba91e81b2a05e98ab8ab55878c1d05e2","position":"1788481453312877001-e30a0894-e44e-4508-a6e2-1cbac0c0f9ae"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cabb10511a803ebb75f51cda52bb87d2149a5d7b3c8315badba34f0297b94bf4","event_uuid":"c11dbb2d-65dd-4a45-b748-54cdd910ebe8","position":{"commit_sha":"06d70b9fba91e81b2a05e98ab8ab55878c1d05e2","position":"1788481458290419001-c11dbb2d-65dd-4a45-b748-54cdd910ebe8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0fd8af0b7d3bececb9f4116abd8dab0bff220542ceb0e10e40d7732eacb12265","event_uuid":"613121cf-2268-45bc-b748-008043fd10b5","position":{"commit_sha":"7f0fcb022831ffa8448b014b7b4597fbe0f4e482","position":"1788484286830412465-613121cf-2268-45bc-b748-008043fd10b5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"96fab6da284bab2ad7f44e39deeaf2e33560ad8971a27f94d72384a4db623a5f","event_uuid":"8b85c73a-a684-46a6-9cfe-1e9752b05f5c","position":{"commit_sha":"dcb41ed540708e0e1bc1d977d19fb430c159a368","position":"1788484724918903001-8b85c73a-a684-46a6-9cfe-1e9752b05f5c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/v