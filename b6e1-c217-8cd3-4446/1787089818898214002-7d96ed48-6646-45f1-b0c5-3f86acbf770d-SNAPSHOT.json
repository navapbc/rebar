472eef4b5b2fd8088f50751f9290bd0d8f35577cff0bffd4fd63ee634","event_uuid":"f4989cbc-7aec-47d0-90ef-cec5192bdb1a","position":{"commit_sha":"82566d778cf570ee56194d655f7f39624156b9ae","position":"1787089583126816001-f4989cbc-7aec-47d0-90ef-cec5192bdb1a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0def386df4c152e776dd3078f67de691eb91585f642ca3c224382b884d08070b","event_uuid":"503ff340-bb0a-41a2-b7fb-7d9df09aedf6","position":{"commit_sha":"55f40e38a478c3929634b64a74d04d257ec04325","position":"1787089757308572001-503ff340-bb0a-41a2-b7fb-7d9df09aedf6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3086aaac13dfeb6c2caabaef8a225f3bb98ca8b704586848aa694940e522c07c","event_uuid":"45037106-31f8-4e08-89c4-509351f2fd51","position":{"commit_sha":"95fb844364e8db4f19d8f3e93947c9bbdf13b3f3","position":"1787089818898214001-45037106-31f8-4e08-89c4-509351f2fd51"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fast-path Phase 1 RCA (confirmed before repair): relation-scoped unlink shipped in commit 73abb5805f and deliberately changed the real CLI/library contract while preserving the omitted-selector most-recent fallback. That commit updated src/rebar/_cli/help/unlink.txt, docs/cli-reference.md, and docs/user-guide.md, but its diff did not touch src/rebar/_cli/help/overview.txt or docs/ticket-model.md; both retain their pre-change wording from earlier commits. Runtime proof: the current `rebar unlink --help` advertises `[relation]`, while `rebar --help` (which loads packaged overview data through rebar._cli._help) still emits `no relation arg`. Existing authoritative behavioral coverage in tests/interfaces/lifecycle/test_unlink_relation_scoped_e39f.py proves explicit relation removal preserves the pair's other active relation and omission retains pair-scoped fallback. The same stale statement also remains in docs/event-schema.md and will be handled as an in-scope documentation sibling. Root cause: the e39f edit set enumerated only the subcommand help plus two generated/user docs and omitted the independently maintained overview and model/schema prose, so their published contract never advanced. Legitimacy: defect, grounded in the operator-ratified e39f commit contract, current CLI/library signatures, and passing relation-scoped behavioral tests. Fast-path gates hold: deterministic live help contradiction, one omission mechanism, docs-only reversible blast radius.","timestamp":1787089535599926001}],"created_at":1787089399254345001,"creation_channel":"cli","deps":[{"link_uuid":"bb38ff7c-b656-4285-9557-c7b748eae62f","relation":"discovered_from","target_id":"88b9-c847-3a2e-4c63"}],"description":"## Context\nRelation-scoped unlink was added to the core, public library, and CLI, and MCP parity is tracked by airy-starchy-muntjac. Two maintained documentation surfaces still state the pre-change contract: `docs/ticket-model.md` says `unlink <source> <target>` takes no relation argument, and `src/rebar/_cli/help/overview.txt` says unlink has no relation arg. This contradicts the current optional relation accepted by `rebar.unlink` and `rebar unlink`. The Phase 1 sibling sweep also found the same obsolete operation wording in `docs/event-schema.md`; its event-shape description must distinguish the relation selector from the emitted link-UUID cancellation.\n\n## Plan\n- Add a held-out contract test through the real packaged top-level CLI help and maintained public documentation surfaces.\n- Update the ticket-model and packaged overview surfaces to document `unlink <source> <target> [relation]`.\n- Preserve and explain the omitted-relation most-recent fallback.\n- State that an explicit canonical relation removes exactly that relation while preserving other active relations on the pair.\n- Correct the event-schema operation wording while preserving the true event payload semantics.\n- Regenerate any derived guide/reference output if these sources feed one.\n\n## Acceptance Criteria\n- [ ] The ticket-model unlink section documents the optional relation argument.\n- [ ] The packaged CLI overview documents the optional relation argument through real `rebar --help` output.\n- [ ] Both surfaces preserve the omitted-selector most-recent fallback contract.\n- [ ] Both surfaces describe exact relation-scoped removal.\n- [ ] The event schema distinguishes optional operation selection from UUID-targeted UNLINK event cancellation.\n- [ ] Documentation drift and relevant help tests pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/help/overview.txt","reason":"Correct the packaged top-level unlink contract"},{"path":"docs/ticket-model.md","reason":"Correct both the public unlink contract and doctor-specific explanation"},{"path":"docs/event-schema.md","reason":"Distinguish optional relation selection from UNLINK event payload semantics"},{"path":"tests/interfaces/contracts/test_unlink_documentation_contract_b6e1.py","reason":"Held-out public help and maintained-document contract regression"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"7bfd9f73-8066-4e6b-aa70-f5365cd76d70","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["docs","unlink","parity"],"ticket_id":"b6e1-c217-8cd3-4446","ticket_type":"bug","title":"Document optional relation-scoped unlink in overview and ticket model","verify_commands":[]},"source_event_uuids":["9c8ce831-9aa7-4941-b3cf-311af9e22498","bb38ff7c-b656-4285-9557-c7b748eae62f","7bfd9f73-8066-4e6b-aa70-f5365cd76d70","8dd45c4d-a253-4511-82d2-859d28d6a279","17de363d-d397-4844-8a6d-60d44bbc1c7d","986180ef-fc50-4262-9f3f-f8be9cdc6b77","f4989cbc-7aec-47d0-90ef-cec5192bdb1a","503ff340-bb0a-41a2-b7fb-7d9df09aedf6","45037106-31f8-4e08-89c4-509351f2fd51"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787089818898214002,"uuid":"7d96ed48-6646-45f1-b0c5-3f86acbf770d"}