5-8fbe004f85e9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"46a2f349349634274db31330c86c688c40fa663bfc0197af13cd6088622b67b0","event_uuid":"3c67d9aa-0bd9-445d-a14a-f634294315c7","position":{"commit_sha":"9e5ce806d3acc014609f21276e8cf7c33b7e65ab","position":"1788620722519200001-3c67d9aa-0bd9-445d-a14a-f634294315c7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c81c6f45388c50c460fd57adc513edac2104f0aa88f94c0355cbd791cfbc96be","event_uuid":"d756c519-61a1-4df6-a8df-87114f6dc421","position":{"commit_sha":"ec8b9f1290cb2d14380e2dbb6e400e60318f5657","position":"1788624674174751001-d756c519-61a1-4df6-a8df-87114f6dc421"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"476badb3c9610566808744aaa6075e47a8b5d91af2087ac8eee45f576e08df41","event_uuid":"52ac0384-1a31-4552-8af2-e6a461357c67","position":{"commit_sha":"cb2259611c0d8446ea66c33ef0d465ef80a2d065","position":"1788626206803546195-52ac0384-1a31-4552-8af2-e6a461357c67"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"88c214dae847f9e01e6b4a05cf9b4d36ae31efcced944cb2a01e95e1122afdaa","event_uuid":"3c966248-7483-4583-bfef-ccfc1194b3be","position":{"commit_sha":"7e17b52146e1fc6234eab59b7cb91276226a02c9","position":"1788626237887446001-3c966248-7483-4583-bfef-ccfc1194b3be"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP recurrence on 2026-09-04: during grouped-comment ticket migration, transition_ticket timed out at the 300-second tools/call deadline after only a six-ticket, two-worker pilot. Readback showed the preceding supersedes links persisted, but both source tickets remained open, so no close was ambiguous. The local CLI fallback is being used for the remaining migration. This broadens the observed impact from canceled-search starvation to mutation availability after sustained MCP load.","timestamp":1788573635320118001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Retry on 2026-09-04 succeeded: rebar MCP completed show/deps/next-batch/session-log writes. The combined graph read took about 90 seconds and returned an oversized 114-leaf payload, but the transport remained available; no CLI fallback was needed.","timestamp":1788583845796472268},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"On 2026-09-04, mcp create_ticket for the uv/worktree diagnostic ran about 160 seconds, returned no structured result, and created no searchable ticket. Local CLI fallback then created foliated-correct-arcticfox successfully. Read tools and log_session remained available; this was a write-response failure, not a total endpoint outage.","timestamp":1788584621660672001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"On 2026-09-04, plan_review_status for goldfilled-portly-dungbeetle returned stale-store: the MCP server ticket clone has diverged from the shared store, so it refuses certification. The repository-local CLI on the isolated current-origin/main worktree saw the same ticket normally and returned the expected unsigned status. Gate operations are switching to the local CLI fallback; no force.","timestamp":1788584888652207001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Recurrence on 2026-09-05 while reconfirming foliated-correct-arcticfox: show_ticket over MCP remained unserved through roughly 90 seconds and was canceled; a fresh direct retry was still unserved after 30 seconds. The local CLI fallback returned the same ticket after about 31 seconds and accepted the follow-up comment in about 19 seconds. No concurrent search batch was launched by this session, so later-read starvation can persist beyond the original canceled-search trigger. No duplicate bug filed.","timestamp":1788606489611928001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Recurrence on 2026-09-05 during uv-bug confirmation: MCP show_ticket remained unserved for about 90 seconds; after cancellation, a direct retry failed with HTTP 502 from nginx. The local CLI returned foliated-correct-arcticfox successfully in about 8 seconds. No duplicate MCP bug filed.","timestamp":1788615127454421001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence during epic rubbery-glacial-cowbird: `summary` for six known story aliases remained live without output for more than three minutes while async plan reviews and concurrent ticket writes were active; the caller cancelled the read to avoid indefinite client occupancy. A preceding six-way `list_tickets(parent=...)` MCP read completed in about 113 seconds but resolved only one alias parent, returning zero rows for five known non-empty stories. Local CLI fallback activated. Investigate serialized sync/contention and alias handling under concurrent gate/write load.","timestamp":1788620722519200001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Async-gate failure evidence for the same 2026-09-05 MCP outage: four `review_plan_start` jobs (cordial-vulpine-piglet, misogynous-demonian-fly, plastery-nonblack-centipede, bronze-unrelaxed-erne) all transitioned to `stale-running`; `findings.readable=false`, no REVIEW_RESULT sidecar exists, and every durable plan status is unsigned. The MCP process/daemon lifetime ended during the concurrent HTTP 502 episode. Local CLI reviews were started once after confirming no surviving run.","timestamp":1788624674174751001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence while driving rubbery-glacial-cowbird: six concurrent bounded list_tickets(parent=..., full=false) MCP reads produced no response for >90 seconds and the client call had to be terminated. Four review_plan_start calls immediately before this succeeded and returned distinct job handles. Switched only the stalled ordinary reads to the documented local CLI fallback; no gate was restarted.","timestamp":1788626206803546195},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence while driving rubbery-glacial-cowbird: six concurrent bounded list_tickets(parent=..., full=false) MCP reads produced no response for more than 90 seconds; comment_ticket then also produced no response for more than 60 seconds, and both client calls had to be terminated. Four review_plan_start calls immediately before this succeeded and returned distinct job handles. Switched only the stalled ordinary reads/writes to the documented local CLI fallback; no gate was restarted.","timestamp":1788626237887446001}],"created_at":1788557999468311001,"creation_channel":"cli","deps":[{"link_uuid":"67040e09-8fc3-49c9-a46d-4b6ffe04231e","relation":"discovered_from","target_id":"d8a3-ff71-8112-4e55"},{"link_uuid":"5b25bb81-d07c-4fb3-beed-fad4d8912504","relation":"discovered_from","target_id":"3e32-a859-2153-4a1b"}],"description":"## Context\nA batch of 46 concurrent `search` calls was canceled at the client. A subsequent single `search` remained unserved and failed with `timed out awaiting tools/call after 300s`. The canceled calls were read-only.\n\n## Acceptance Criteria\n- [ ] Canceled or abandoned searches cannot monopolize MCP request capacity.\n- [ ] A later single tracker read completes within the normal request budget.\n- [ ] A regression test covers cancellation/backpressure for concurrent searches.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["mcp","concurrency","reliability"],"ticket_id":"b0c3-7455-86df-48f6","ticket_type":"bug","title":"Canceled MCP searches starve later tracker reads","verify_commands":[]},"source_event_uuids":["d45e4f88-0510-4a31-9f72-28a24e918fa7","5b25bb81-d07c-4fb3-beed-fad4d8912504","411e4f25-9fea-493b-bea8-56abe61048b0","8addd9a6-12b0-489a-b5c7-0c1a226c25ad","392b2eda-29ee-4377-897e-fe137dcdce85","d12016ed-a539-4b3c-90ed-f522eb4126bc","2c870574-99ef-47a5-bdf5-8fbe004f85e9","3c67d9aa-0bd9-445d-a14a-f634294315c7","d756c519-61a1-4df6-a8df-87114f6dc421","52ac0384-1a31-4552-8af2-e6a461357c67","3c966248-7483-4583-bfef-ccfc1194b3be"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788626237887446002,"uuid":"bd74399f-3930-472a-a19a-8bf5353871e7"}