{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788666244334997001,"compiled_state":{"alias":"skaldic-carbon-copperhead","assignee":null,"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":24,"unsigned":0},"authorship_ledger":[{"content_hash":"596e4f0f395e6ad827caf81dc5a66aa836389b84586ddcbb57478740712a2bba","event_uuid":"5f20fd94-0e36-4c21-8494-70a019537091","position":{"commit_sha":"a4f436bddbcb691b16b8a1d89a79a2a9000bf2a9","position":"1788630266984394001-5f20fd94-0e36-4c21-8494-70a019537091"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8b931145c1fced4b3350dbac490dc510c718427d8f0bded4a4ad8038c9257b84","event_uuid":"f9aef999-4783-4e05-9a88-41f6bff85d2f","position":{"commit_sha":"b8eb849ebb6a7e17ef69641b3117406c4b2ca15a","position":"1788631663910208001-f9aef999-4783-4e05-9a88-41f6bff85d2f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"36c4049fbd1c0c805811ba1b40347e87e0e33e84d1de1d23dcbdbd5f4fef7931","event_uuid":"e92e6ab8-2afd-4048-a84a-8920c916a51a","position":{"commit_sha":"ff553f619297e016a6a09f028f3292ff961544df","position":"1788632034379217001-e92e6ab8-2afd-4048-a84a-8920c916a51a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4e2cecf647355425a565a241c573688a104d3319cb625582fea4e1ef12b05154","event_uuid":"4b1fd36d-ddbb-4bbb-94aa-29e95eca5040","position":{"commit_sha":"40bf329eb9977a94c126516c433c8df835e75585","position":"1788632075561017001-4b1fd36d-ddbb-4bbb-94aa-29e95eca5040"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7b2fe3434b37613dc3b44b3c3891f5fc794b4641f06c98beb6313be1ae59a9fd","event_uuid":"db70f83a-2989-4d6f-9e3f-8d6f7937a183","position":{"commit_sha":"2aa3657b2a7b469a2ce781657c8ce5f48fcd8c32","position":"1788633166605905990-db70f83a-2989-4d6f-9e3f-8d6f7937a183"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d4d73ef96c4976e206483aeb0f90cbb623afa730b6b52f7c3f4a2a1882c9d599","event_uuid":"3f4073c7-dcb4-44e2-8802-64b07ebde6be","position":{"commit_sha":"40dafea7881938742b1138cf601e724188585cc2","position":"1788634508394138001-3f4073c7-dcb4-44e2-8802-64b07ebde6be"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1fbb3ce5248fd481e61dec33ff7a01b7a0d06033ed8c801f709231d27db56b62","event_uuid":"097ff1cc-37ff-4f92-b67b-96876880d527","position":{"commit_sha":"8cb4ecc5b0b5689f046ac381cdc583dbb46f415f","position":"1788638238791026001-097ff1cc-37ff-4f92-b67b-96876880d527"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"23d26d058d524bca0fcd91cede18676f2207b37385930b2e50e349f8d7a82c80","event_uuid":"8ce19fc0-5866-4d74-a596-01b63354e392","position":{"commit_sha":"ac3bd4082380dfc70d15c1ebaa5d7341ccbe22ca","position":"1788639086360586001-8ce19fc0-5866-4d74-a596-01b63354e392"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ca8544008f7d80d21266e120ecec1abb2574e2228687ecf82c4d95e7969267f9","event_uuid":"2ffa21bd-6e93-45f8-914f-607ac42a0ae2","position":{"commit_sha":"46eac936436f26fe9dbbdbfed1e44f55b378bc98","position":"1788649828376647001-2ffa21bd-6e93-45f8-914f-607ac42a0ae2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4ca1d5b964d5efd015835a052be39ee07226b07ad165a3b1332661a83a8f7372","event_uuid":"398e9c49-e211-42d3-826e-5918e883bb55","position":{"commit_sha":"077fd2f24663b0ceab43c259ec5a04a42f6a0c71","position":"1788657671976794844-398e9c49-e211-42d3-826e-5918e883bb55"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4b1ef6a5616dd32c96113fe9eeba2188176fba91b01b355d654a3de15e65f188","event_uuid":"67f67bec-b87f-4c60-a2e7-9e69aff041f3","position":{"commit_sha":"1be77f87379260c7dbf0a1859eda7fb64c7d4463","position":"1788659679706544001-67f67bec-b87f-4c60-a2e7-9e69aff041f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP recurrence on 2026-09-04: during grouped-comment ticket migration, transition_ticket timed out at the 300-second tools/call deadline after only a six-ticket, two-worker pilot. Readback showed the preceding supersedes links persisted, but both source tickets remained open, so no close was ambiguous. The local CLI fallback is being used for the remaining migration. This broadens the observed impact from canceled-search starvation to mutation availability after sustained MCP load.","timestamp":1788573635320118001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Retry on 2026-09-04 succeeded: rebar MCP completed show/deps/next-batch/session-log writes. The combined graph read took about 90 seconds and returned an oversized 114-leaf payload, but the transport remained available; no CLI fallback was needed.","timestamp":1788583845796472268},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"On 2026-09-04, mcp create_ticket for the uv/worktree diagnostic ran about 160 seconds, returned no structured result, and created no searchable ticket. Local CLI fallback then created foliated-correct-arcticfox successfully. Read tools and log_session remained available; this was a write-response failure, not a total endpoint outage.","timestamp":1788584621660672001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"On 2026-09-04, plan_review_status for goldfilled-portly-dungbeetle returned stale-store: the MCP server ticket clone has diverged from the shared store, so it refuses certification. The repository-local CLI on the isolated current-origin/main worktree saw the same ticket normally and returned the expected unsigned status. Gate operations are switching to the local CLI fallback; no force.","timestamp":1788584888652207001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Recurrence on 2026-09-05 while reconfirming foliated-correct-arcticfox: show_ticket over MCP remained unserved through roughly 90 seconds and was canceled; a fresh direct retry was still unserved after 30 seconds. The local CLI fallback returned the same ticket after about 31 seconds and accepted the follow-up comment in about 19 seconds. No concurrent search batch was launched by this session, so later-read starvation can persist beyond the original canceled-search trigger. No duplicate bug filed.","timestamp":1788606489611928001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Recurrence on 2026-09-05 during uv-bug confirmation: MCP show_ticket remained unserved for about 90 seconds; after cancellation, a direct retry failed with HTTP 502 from nginx. The local CLI returned foliated-correct-arcticfox successfully in about 8 seconds. No duplicate MCP bug filed.","timestamp":1788615127454421001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence during epic rubbery-glacial-cowbird: `summary` for six known story aliases remained live without output for more than three minutes while async plan reviews and concurrent ticket writes were active; the caller cancelled the read to avoid indefinite client occupancy. A preceding six-way `list_tickets(parent=...)` MCP read completed in about 113 seconds but resolved only one alias parent, returning zero rows for five known non-empty stories. Local CLI fallback activated. Investigate serialized sync/contention and alias handling under concurrent gate/write load.","timestamp":1788620722519200001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Async-gate failure evidence for the same 2026-09-05 MCP outage: four `review_plan_start` jobs (cordial-vulpine-piglet, misogynous-demonian-fly, plastery-nonblack-centipede, bronze-unrelaxed-erne) all transitioned to `stale-running`; `findings.readable=false`, no REVIEW_RESULT sidecar exists, and every durable plan status is unsigned. The MCP process/daemon lifetime ended during the concurrent HTTP 502 episode. Local CLI reviews were started once after confirming no surviving run.","timestamp":1788624674174751001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence while driving rubbery-glacial-cowbird: six concurrent bounded list_tickets(parent=..., full=false) MCP reads produced no response for >90 seconds and the client call had to be terminated. Four review_plan_start calls immediately before this succeeded and returned distinct job handles. Switched only the stalled ordinary reads to the documented local CLI fallback; no gate was restarted.","timestamp":1788626206803546195},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence while driving rubbery-glacial-cowbird: six concurrent bounded list_tickets(parent=..., full=false) MCP reads produced no response for more than 90 seconds; comment_ticket then also produced no response for more than 60 seconds, and both client calls had to be terminated. Four review_plan_start calls immediately before this succeeded and returned distinct job handles. Switched only the stalled ordinary reads/writes to the documented local CLI fallback; no gate was restarted.","timestamp":1788626237887446001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP fallback evidence (2026-09-05): one batched read attempt (show_ticket + file impact + verify commands) produced no response for over 4 minutes and was terminated; a separate show_ticket(nonlegal-close-tigermoth) attempt produced no response for over 90 seconds and was terminated. Proceeding with the repo-worktree .venv CLI fallback for this audit-only ticket repair batch, per AGENTS.md.","timestamp":1788630266984394001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 recurrence during comment-remediation epic: gate_status for jobs 1788630551874010485-5aac9b7101504f46ae665e0f8e45694b, 1788630559731574124-815f9053189943a69d6217aab4b9d05e, 1788630570354225064-baf87e9c06fa45fa840b68b62d3fdb2b, and 1788630580959432052-fc32a005c255466f9f2244283dc6e0a8 reports status=running while durable currency refuses with stale-store. Three report divergent histories ('neither history contains the other'); one reports 9 committed ticket events never received by the shared store, last delivery failure push-transport-failed. MCP show/status calls also queued for 2-4 minutes behind gates. Switched tracker writes to the documented repo-venv CLI fallback; no raw git or force used.","timestamp":1788631663910208001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP fallback evidence (2026-09-05): a parallel read batch calling show_ticket for incurable-geometric-liger, snoopy-humorous-doe, unplayful-bizarre-sable, and strenuous-aged-sablefish produced no result or error across the initial 30-second tool window plus two 30-second waits (approximately 90 seconds total). The client-side orchestration cell was then terminated. Continuing with the documented worktree-local .venv CLI fallback; no plan reviews, claims, code edits, tests, gates, transitions, commits, or code pushes were performed before fallback.","timestamp":1788632034379217001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP fallback evidence (2026-09-05): a single read-only MCP batch requested show_ticket, get_file_impact, get_verify_commands, and plan_review_status for orthogonal-shrewd-taruca, laudable-abhorrent-nutria, worthy-gloomful-nilgai, and deserved-exact-macropod. The batch returned no output after four 30-second waits (>120 seconds total) and was terminated without issuing duplicate MCP reads. Continuing via the immutable audit worktree local .venv CLI fallback as required.","timestamp":1788632075561017001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fallback evidence for the four-ticket prose-plan audit: MCP set_verify_commands(inferior-mystical-arrowworm) returned HTTP 502 Bad Gateway. A subsequent MCP get_verify_commands read succeeded and returned an empty array, proving the write did not persist. Per AGENTS.md fallback policy, the repo-worktree .venv CLI will be used only to persist that missing seven-row command array; all remaining tracker operations stay on MCP.","timestamp":1788633166605905990},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP fallback evidence (2026-09-05): show_ticket(rubbery-glacial-cowbird) completed after about 43 seconds and a bounded child listing completed, but the subsequent single show_ticket(skaldic-carbon-copperhead) produced no output through two 30-second client windows (>60 seconds) and was terminated without retry. Continuing this delta prose audit through the immutable worktree's repo-venv CLI fallback. No plan review, claim, source edit, test/gate, transition, commit, or code push occurred before fallback.","timestamp":1788634508394138001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"FOUR_TICKET_PROSE_AUDIT_FALLBACK:d6669496:unable\n\nThe unable-wingless-bustard MCP sequence was stopped after edit_ticket returned result=ok but push_status.state=pending (push-transport-failed: git timed out after 30s; unpushed=3). A terminal, idempotent MCP edit retry reconciled that backlog and returned push_status.state=ok with null warnings. The next MCP set_file_impact wrote nothing and failed after 181s because the live MCP server process (pid=1) held the tracker lock for 244s; a single follow-up MCP show_ticket then timed out at the client deadline after 300s.\n\nPer the documented fallback contingency, the remaining operations used the frozen audit worktree's repo-venv CLI, serialized: set-file-impact exited 0 and an immediate JSON readback matched all 18 ordered path/reason rows exactly; set-verify-commands exited 0 and an immediate normalized JSON readback matched all seven dd_id/dd_text/command rows exactly. No plan review, claim, source edit, implementation test/gate, transition, commit, or code push was performed.","timestamp":1788638238791026001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"FOUR_TICKET_PROSE_AUDIT_FALLBACK_READBACK:d6669496\n\nAfter all target payloads were present, the mandated strict MCP readback was attempted serially. The first show_ticket (autositic-relaxative-nurseshark) returned no state and terminated at the 300s MCP client deadline, so the sequence stopped without launching the other three MCP reads. The sanctioned repo-venv fallback then projected and compared all four tickets: every description byte, ordered path/reason row, and normalized dd_id/dd_text/command triple matched; each ticket remained open, unassigned, parented to d6eb-1c6c-88c3-48f6, warning-free, and uncertified (the frozen CLI omits the modern attestations map, so this was checked as signature=null against the immediately preceding MCP preflight's attestations={}). The elder-stingy-narwhale receipt was pre-read at zero marker hits, appended once, and read back as one exact marker/body.","timestamp":1788639086360586001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Additional 2026-09-05 reproduction on origin/main@84ef2848: async plan-review job 1788646952249553441-7b549d5249534992bf46536eab010ec1 for cloudy-primitive-scaup remains `running`, while gate_status reports a local signed_at/verified_at result but durable verdict `stale-store` because the MCP clone diverged. The shared-store repo-venv `review-plan --status` remains unsigned. gate_status calls take roughly 90–150 seconds. This demonstrates an ambiguous split-brain outcome: billable review work completed in the MCP clone but cannot certify the shared ticket, and the handle does not become terminal promptly. No duplicate gate was started.","timestamp":1788649828376647001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-05 additional reproduction: four distinct review_plan_start jobs all returned handles, then became stale-running with findings.readable=false and durable verdict unsigned: little-untimely-grison 1788657158809171994-9b3b721e06bd4482bdc54da0832ad4a5; optometric-hermitical-drake 1788657159427572529-8582838cbfb147f3a745fd05f19b3196; outgoing-heavensent-sardine 1788657157896820665-0832379371904d118fadf2bd7dbb32e2; pale-despairful-pikeperch 1788657159448189859-21fca0cd9a1949e8925ce9588dc1a0ba. No sidecar or signature persisted. The caller will use the repo-local CLI fallback for these four only.","timestamp":1788657671976794844},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Independent reproduction — and it is NOT limited to `search`\n\nReproduced live at 2026-09-06 ~01:50 UTC, with a different call type than the one on record. The\nticket's context describes 46 concurrent **`search`** calls cancelled at the client, after which a\nsingle later `search` went unserved and died at `timed out awaiting tools/call after 300s`. I hit\nthe same terminal state from a **single, non-search, WRITE** call.\n\nSequence, in order:\n\n1. `transition_ticket(0cfc-e511-8f8a-4c8b, in_progress -> closed)` — a close, so it runs the\n   completion-verifier gate. The client aborted it: *\"sent no response or progress for 300s\"*.\n   **The server was not stopped by that abort** — only the client gave up.\n2. Immediately after, `summary([6 ticket ids])` — a trivial read — exceeded 120s and was still\n   unserved.\n3. I cancelled (2), which per this ticket's own thesis may itself starve the next reader.\n\nSo the starvation is reachable from **one** in-flight call, not only from a 46-way concurrent batch,\nand the poisoning call need not be a `search` — it can be a long-running gated **write**. That\nmatters for the fix: a remedy scoped to `search`, or one keyed on concurrency count, would not have\nprevented this.\n\n### Host conditions at the time (context, not cause)\n\n```\nfree -m:  total 7813   available 2615  (33.5%)\nuptime:   load average 4.69, 4.99, 5.08     <-- 2-vCPU box, ~2.5x oversubscribed\ndocker:   rebar-mcp  2.872GiB / 7.631GiB  (37.6%, and the 7.631GiB denominator means NO mem_limit)\n```\n\nThe box was under real pressure, so contention plausibly widens the window. But pressure alone does\nnot explain a **read** remaining unserved for 120s+ while the process is alive and healthy — that is\nthe queueing/serialisation defect this ticket is about.\n\n### Probable amplifier worth checking together\n\nBug `lousy-unsuited-gnu` (p1) reports that resolving a single ticket id scans the whole store at\nroughly 8,900 JSON parses. If that is accurate, every tracker call — including the cheap-looking\n`summary` above — carries a full-store scan, which would make the serialisation window enormous and\nmake this starvation far easier to trigger. These two are worth reading together; fixing the scan\nmay substantially shrink this bug's blast radius without addressing its root cause, so do not let a\nperf fix be mistaken for a fix to this.\n\n### Operational note\n\nWhile this holds, the project's documented guidance to route tracker operations through the MCP\nserver is effectively unavailable: the close had to fall back to the local CLI. Worth stating in the\nfix that a client-side timeout **leaves the server-side operation running**, because the natural\nrecovery — re-firing the call — risks a duplicate, billable gate run. I did not re-fire; I verified\nvia the local CLI that the ticket was still `in_progress` with only a `plan-review` attestation and\nno `completion-verifier`, which is how I established the close had not landed.","timestamp":1788659679706544001}],"created_at":1788557999468311001,"creation_channel":"cli","deps":[{"link_uuid":"67040e09-8fc3-49c9-a46d-4b6ffe04231e","relation":"discovered_from","target_id":"d8a3-ff71-8112-4e55"},{"link_uuid":"5b25bb81-d07c-4fb3-beed-fad4d8912504","relation":"discovered_from","target_id":"3e32-a859-2153-4a1b"}],"description":"## Context\nA batch of 46 concurrent `search` calls was canceled at the client. A subsequent single `search` remained unserved and failed with `timed out awaiting tools/call after 300s`. The canceled calls were read-only.\n\n## Acceptance Criteria\n- [ ] Canceled or abandoned searches cannot monopolize MCP request capacity.\n- [ ] A later single tracker read completes within the normal request budget.\n- [ ] A regression test covers cancellation/backpressure for concurrent searches.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["mcp","concurrency","reliability"],"ticket_id":"b0c3-7455-86df-48f6","ticket_type":"bug","title":"Canceled MCP searches starve later tracker reads","verify_commands":[]},"source_event_uuids":["5f20fd94-0e36-4c21-8494-70a019537091","f9aef999-4783-4e05-9a88-41f6bff85d2f","e92e6ab8-2afd-4048-a84a-8920c916a51a","4b1fd36d-ddbb-4bbb-94aa-29e95eca5040","db70f83a-2989-4d6f-9e3f-8d6f7937a183","3f4073c7-dcb4-44e2-8802-64b07ebde6be","097ff1cc-37ff-4f92-b67b-96876880d527","8ce19fc0-5866-4d74-a596-01b63354e392","2ffa21bd-6e93-45f8-914f-607ac42a0ae2","398e9c49-e211-42d3-826e-5918e883bb55","67f67bec-b87f-4c60-a2e7-9e69aff041f3"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788666244334997001,"uuid":"3173b55e-6bcb-4705-ae39-fdf2163a6f3e"}