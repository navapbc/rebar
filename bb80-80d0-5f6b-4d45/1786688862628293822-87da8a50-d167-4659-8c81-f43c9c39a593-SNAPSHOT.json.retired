-path: src/rebar/_mcp_writes.py","read-path: src/rebar/reducer/_api.py","read-path: src/rebar/reducer/marker.py","read-path: tests/unit/test_compact_all_selection.py","currency-basis: file_impact"],"material_fingerprint":"8b264ea4c09e7cb5","merged_log_commit":"72731d37458c01791d45868ba1dd27a35c281835","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786683628015526000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":4,"unsigned":0},"authorship_ledger":[{"content_hash":"2dd95aa080b75c840787e77d0884c37102f6bddb7a7c5355f09f39d857f2894c","event_uuid":"53c83a47-6c8a-41e3-927b-e5338d573a2c","position":{"commit_sha":"848eef110e0a5014a4da469c45ebbb24f56fcbdd","position":"1786677407480467001-53c83a47-6c8a-41e3-927b-e5338d573a2c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"36e74fb13b983cace96cc7d4c3e5640b4d3fe223b6158a419f8dfeb2cb18be6f","event_uuid":"10ff00e2-2a83-4f4b-bd9f-98f38ccd99b0","position":{"commit_sha":"d134d5c91526daf660381a6219e0da67fb35255a","position":"1786677468024761001-10ff00e2-2a83-4f4b-bd9f-98f38ccd99b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b468ca1adf940f111150ea065cd157d5e4a7da021c9a09f5d10646fa2b69b7ab","event_uuid":"948c98c3-0ac6-4eda-87c7-74e5dd1916b6","position":{"commit_sha":"9e11eff77bfa9aa10d7ecec0e8e56acdca96d81b","position":"1786683001322925001-948c98c3-0ac6-4eda-87c7-74e5dd1916b6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a508aa9b225e6b2639d3f192b91121f244974d9d15420d6f25dd6273cd6a0903","event_uuid":"e9e128a6-5ff0-4749-aea5-6397cd19d873","position":{"commit_sha":"7da5f86d3cf9d967232ef16413ca9bef6e52f782","position":"1786683628017114001-e9e128a6-5ff0-4749-aea5-6397cd19d873"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786677407480467001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\nStore-wide maintenance walks visit every ticket directory on every run: the fsck scan loops (`_ticket_dirs` iterations in src/rebar/_commands/fsck_scan.py) and the compact-all sweep (src/rebar/_commands/compact.py, whose per-ticket selection is `_scan_snapshot_state`'s own `os.scandir(tracker)` walk invoked by `compact_all_cli`) are O(all tickets ever created). As the store grows, archived tickets — cold, excluded from default `list` — dominate that walk and make routine health checks and sweeps slower for no operational value. `ticket list` already has the pattern to copy: default excludes archived (marker fast-path at reducer/_api.py with compiled-state confirmation) with an explicit `--include-archived` override.\n\n## Approach\nTwo coupled changes, ordered so the default flip is safe:\n1. **Operation-linked terminal fold.** Today `leaf.archive` (src/rebar/_commands/leaf.py) writes only the ARCHIVED event + `.archived` marker — it does NOT fold, so an archived ticket can carry unfolded tail events and the only thing that folds them is a later compact-all walk reaching it. Before scoping that walk to active tickets, make the fold part of the archive operation itself: `rebar archive` performs the ticket's final fold inline (reusing the existing single-ticket fold path compact_txn already exposes) right before writing the ARCHIVED event. This is operation-linked, so it is portable across environments with diverse or NO CI provider — no scheduled sweep is load-bearing. Any later `--include-archived` sweep becomes redundant belt-and-suspenders for tickets archived by pre-change builds, not the sole fold path.\n2. **Active-only default scoping.** Introduce one shared helper (in the module fsck_scan already imports `_ticket_dirs` from) that yields ACTIVE ticket dirs by default — skipping dirs whose net archival state is archived, using the `.archived` marker as the fast-path and the existing `_is_net_archived`-style event-name confirmation, the exact semantics `list` uses — with an `include_archived` flag to yield everything. Switch the fsck scan loops to it, and in compact.py replace `_scan_snapshot_state`'s `os.scandir(tracker)` walk with the shared iterator (matching its existing return contract so `_foldable_event_count` consumers are unchanged), with `compact_all_cli` threading `--include-archived` through to it. Add `--include-archived` to `rebar fsck` and `rebar compact-all` (usage lines + JSON passthrough). Default = active-only for both: with change 1 in place, an archived ticket really IS folded on its way out, and any deep audit reaches it with the flag.\nBack-out path: the default flip is a one-line revert per command (restore the full walk); change 1 is independently safe to keep since folding at archive time is strictly more converged than folding later.\nPositive rationale: this reuses the archive marker + net-archival semantics that default `list` has proven, rather than inventing a second notion of active.\n\n## Scope\n- src/rebar/_commands/leaf.py — archive performs the ticket's terminal fold inline before the ARCHIVED event.\n- src/rebar/_commands/fsck_scan.py — scan loops take the shared active-only iterator; `include_archived` threading.\n- src/rebar/_commands/fsck.py — CLI flag + usage + JSON passthrough.\n- src/rebar/_commands/compact.py — `_scan_snapshot_state` replaces its `os.scandir` walk with the shared iterator; `compact_all_cli` threads `--include-archived` through; default active-only.\n- tests/unit/test_scan_scoping.py (new) — visited-set coverage both ways + archive-fold sequence test.\n- docs/user-guide.md — document the default, the override, and the archive-time fold.\n\n## Testing\n- Happy path: fixture store with N archived (marker + ARCHIVED event) and M active tickets; default `rebar fsck` and `rebar compact-all --dry-run` visit exactly the M active dirs (assert on the visited set / reported counts); with `--include-archived` they visit N+M.\n- Archive-fold sequence: archive a ticket that has unfolded events, then run DEFAULT `rebar compact-all`; assert the archived ticket's SNAPSHOT covers those events (nothing stranded) even though the default sweep never visited it — the fold happened at archive time.\n- Edge: a ticket dir with a stale marker but NO net-archived state (reverted archive) is still visited by default (the confirmation step, not the marker alone, decides); an archived ticket with a corrupt event file IS reported when `--include-archived` is passed (deep audit still works); a ticket archived by a PRE-change build (unfolded, no inline fold) is folded by a `compact-all --include-archived` run (the belt-and-suspenders path works).\n- Empty store: both commands succeed with zero visits.\n\n## Acceptance Criteria\n- [ ] `rebar archive` folds the ticket inline (SNAPSHOT covers all its events) before writing ARCHIVED; a just-archived ticket followed by default `compact-all` carries no unfolded events; checked by the sequence test.\n- [ ] Default `rebar fsck` and `rebar compact-all` visit only non-archived tickets, and `--include-archived` restores the full walk (including folding legacy archived-but-unfolded tickets); checked by the visited-set and legacy-fold tests.\n- [ ] A reverted-archive ticket (stale marker) is never skipped by default; checked by the edge test.\n- [ ] Usage lines and docs/user-guide.md name the new flag on both commands and the archive-time fold; checked by --help output in the test and the doc diff.\n- [ ] `make lint` and `make typecheck` clean; lands via Gerrit (LLM-Review +1 AND Verified +1) before close.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/fsck_scan.py","reason":"scan loops use the active-only iterator"},{"path":"src/rebar/_commands/fsck.py","reason":"--include-archived flag + usage + JSON"},{"path":"src/rebar/_commands/compact.py","reason":"compact_all_cli default active-only + flag"},{"path":"tests/unit/test_scan_scoping.py","reason":"visited-set coverage both ways"},{"path":"docs/user-guide.md","reason":"document default + override"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","fb8a-7363-e406-4e36"]],"no_file_impact_reason":"","parent_id":"fb8a-7363-e406-4e36","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"bb80-80d0-5f6b-4d45","ticket_type":"story","title":"Active-only scan scoping: fsck and compact-all default to non-archived tickets with --include-archived override","verify_commands":[]},"source_event_uuids":["53c83a47-6c8a-41e3-927b-e5338d573a2c","10ff00e2-2a83-4f4b-bd9f-98f38ccd99b0","948c98c3-0ac6-4eda-87c7-74e5dd1916b6","e9e128a6-5ff0-4749-aea5-6397cd19d873"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1786688862628293822,"uuid":"87da8a50-d167-4659-8c81-f43c9c39a593"}