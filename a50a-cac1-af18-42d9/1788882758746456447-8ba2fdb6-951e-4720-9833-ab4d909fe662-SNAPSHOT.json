commit_sha":"352b7faa840d544a006d8020b9f691307bab9b38","position":"1788874238514509001-93391c7d-7943-4fad-8917-f2786d4c14a8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bb9df4718630d6fc1e151573c7d0d48a85f06dfca565ae7e338b2d7711769291","event_uuid":"f5c47582-3919-4fcf-883c-af106da56212","position":{"commit_sha":"86fe7eea69c5117504fb49ae05605c26f7503422","position":"1788874255252657001-f5c47582-3919-4fcf-883c-af106da56212"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b331fbb0d958ef089558fd21553aa3e0349c3e50b3584107c1382cfc52d3fe95","event_uuid":"975817ed-2dd5-4413-9fdb-b1ce69f62f88","position":{"commit_sha":"6a0f799a7b0f99f640463cbff89556fb5a85a4d9","position":"1788875696564022514-975817ed-2dd5-4413-9fdb-b1ce69f62f88"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"8a09fd21e91adef776ecfc63dd3c448e5c44bb5d7313fd28d54c206487a90565","event_uuid":"1d26f3b5-757f-4e89-a851-20925d7de7af","position":{"commit_sha":"d8c5b38029dbe1d3b726513ede0acc0ab663aa44","position":"1788882758746456446-1d26f3b5-757f-4e89-a851-20925d7de7af"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA (2026-09-08): reducer.marker guards the import by assigning fcntl = None, but write_marker and clear_marker dereference fcntl.flock unconditionally in both acquire and finally-unlock paths. On platforms without fcntl this raises AttributeError, and the finally path can replace the original exception, violating the documented best-effort never-raises marker contract. The narrow fix is to guard both acquire and unlock; when no fcntl exists the marker write/clear remains best-effort and proceeds without the POSIX advisory serialization rather than raising.","timestamp":1788866262779680001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation note: used the shared blocking helper from the owl change now present in this stacked worktree; no changes to _store/lock.py or _store/lock_owner.py. Targeted verification passes: pytest tests/unit/test_marker_fcntl_guard.py -q; pytest tests/unit/test_marker_fcntl_guard.py tests/unit -k marker -q; make lint; make typecheck.","timestamp":1788870901469050001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Full verification: make verify completed with lint/typecheck/ratchets clean and exited 2 with lastfailed containing only tests/interfaces/test_rebar_repo_isolation.py::test_copy_repoints_sibling_origin_and_keeps_refs_isolated, the known GIT_CONFIG artifact. Mandated solo confirmation passed: env -u GIT_CONFIG_COUNT -u GIT_CONFIG_KEY_0 -u GIT_CONFIG_VALUE_0 -u GIT_CONFIG_KEY_1 -u GIT_CONFIG_VALUE_1 -u GIT_CONFIG_KEY_2 -u GIT_CONFIG_VALUE_2 pytest tests/interfaces/test_rebar_repo_isolation.py -q => 13 passed.","timestamp":1788874255252657001}],"created_at":1788573602341735929,"creation_channel":"mcp","deps":[{"link_uuid":"fea357b8-e590-4d2b-b1b7-4708aaeb48ad","relation":"discovered_from","target_id":"a01e-01e7-6e6e-4809"},{"link_uuid":"cf72a86a-ce16-46d3-a331-1936904983ac","relation":"relates_to","target_id":"bf74-a636-e6d9-40f9"},{"link_uuid":"975817ed-2dd5-4413-9fdb-b1ce69f62f88","relation":"relates_to","target_id":"3a68-36e6-6e5c-4c3e"},{"link_uuid":"1d26f3b5-757f-4e89-a851-20925d7de7af","relation":"relates_to","target_id":"e7d6-7291-d593-40a2"}],"description":"## Finding\n\nFound while reviewing the ADR 0117 draft (task `arterial-bilineate-vampirebat` /\n`a01e-01e7-6e6e-4809`) against the tree. The draft cited `src/rebar/reducer/marker.py:33` as one of\nthree sibling modules that \"already guard correctly\", offered as evidence that `lock.py` is an\noutlier. Re-reading the file shows the opposite: **`marker.py` has the identical defect.**\n\n```\nsrc/rebar/reducer/marker.py:9-11    try: import fcntl / except ImportError: fcntl = None\nsrc/rebar/reducer/marker.py:33      fcntl.flock(lock_fd, fcntl.LOCK_EX)      # write_marker,  unguarded\nsrc/rebar/reducer/marker.py:38      fcntl.flock(lock_fd, fcntl.LOCK_UN)      # write_marker,  unguarded\nsrc/rebar/reducer/marker.py:61      fcntl.flock(lock_fd, fcntl.LOCK_EX)      # remove_marker,  unguarded\nsrc/rebar/reducer/marker.py:67      fcntl.flock(lock_fd, fcntl.LOCK_UN)      # remove_marker,  unguarded\n```\n\nThe import is guarded to `None`; the four uses are not. On Windows every one raises\n`AttributeError: 'NoneType' object has no attribute 'flock'`.\n\nThe two genuine counter-examples in the draft do hold — `_snapshot/git_fetch.py:79` and\n`_snapshot/janitor.py:430` both branch on `if fcntl is not None` before use. `marker.py` was the\nthird citation and it is wrong.\n\n## Why the surrounding `try/except OSError` does not contain it\n\nBoth functions wrap the locked region in `try: ... except OSError:` and log a warning, documented as\n\"On any OSError: logs a warning to stderr and returns without raising. Failed marker writes must not\nprevent callers from proceeding.\" **`AttributeError` is not an `OSError`**, so it is not caught: it\npropagates out of a function whose contract says it never raises. The `finally:` at `:37`/`:66` then\nruns `fcntl.flock(lock_fd, fcntl.LOCK_UN)`, which raises a *second* `AttributeError` from the\ncleanup path and replaces the first.\n\nSo this is not merely \"another Windows failure\". It breaks a documented never-raises contract, and\nit does so through the `finally` block, which is the shape that loses the original error.\n\n## Implementation approach\n\nDefault now: reuse `rebar._store.lock_kernel.take_blocking_exclusive`, which\nwas landed by `hyperbolic-humanoid-owl`. Its POSIX leg is the existing blocking\n`fcntl.flock(fd, LOCK_EX)` operation, and its Windows leg polls the non-blocking\n`msvcrt` primitive until acquired, so `marker.py` keeps blocking serialization\nwithout open-coding a new platform selector. `release_exclusive` keeps the\nexisting explicit-unlock-before-close shape. If no platform primitive exists, `take_blocking_exclusive` raises\n`NoExclusiveLegError`; `marker.py` must catch that before its `except OSError`\npath, skip the release call because no lock was taken, and run the same\nbest-effort marker operation. `write_marker` creates the marker via an\nidempotent `open(marker_path, \"a\")` that writes no content, and\n`remove_marker` is an idempotent unlink.\n\n## Relationship to S1\n\nSeparate from `S1` (`friendless-alabaster-cub`), which owns `_store/lock.py` and\n`_store/lock_owner.py` and is actively in flight. This ticket must NOT touch those files. It is\nlisted under the same epic because it is the same root cause in a different module, and because\n`S1`'s Windows exclusive-lock leg may supply the mechanism this file should call rather than\nopen-coding a second one.\n\nSequence after `S1`: reuse the shared blocking helper now present on this branch; do\nnot touch `_store/lock.py` or `_store/lock_owner.py`.\n\n## Acceptance Criteria\n\n- [x] `write_marker` and `remove_marker` do not raise when no POSIX lock primitive is\n   available; a test proves it by patching `rebar._store.lock_kernel.fcntl` and\n   `rebar._store.lock_kernel.msvcrt` to `None`, causing `NoExclusiveLegError`.\n- [x] The documented never-raises contract holds under `NoExclusiveLegError` — the\n   functions return normally, and the `finally` unlock path does not run unless a\n   lock was actually taken.\n- [x] Serialization is still enforced on POSIX (the existing behaviour is unchanged when `fcntl` is\n   available), proven by a test that still exercises the real lock.\n- [x] Neither `src/rebar/_store/lock.py` nor `src/rebar/_store/lock_owner.py` is modified.\n\n\n\n## Testing\n\n- RED: `pytest tests/unit/test_marker_fcntl_guard.py -q` fails on unmodified main by patching `rebar.reducer.marker.fcntl` to `None`; after routing through `lock_kernel`, the GREEN test patches `rebar._store.lock_kernel.fcntl` and `msvcrt` to `None` to prove the no-primitive fallback.\n- GREEN: `pytest tests/unit/test_marker_fcntl_guard.py -q` passes after the guard.\n- POSIX regression: `pytest tests/unit/test_marker_fcntl_guard.py tests/unit -k marker -q` exercises the real fcntl path where available.\n- Final gates: `make verify`, plus the known `GIT_CONFIG` isolation artifact is checked solo with the environment variables unset.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/reducer/marker.py","reason":"routes write_marker/remove_marker locking through the shared blocking lock_kernel helper and skips release when no lock was acquired so fcntl-absent/no-primitive paths preserve the never-raises contract"},{"path":"tests/unit/test_marker_fcntl_guard.py","reason":"adds regression tests for fcntl-absent legacy dereferences, no-primitive fallback, and POSIX blocking serialization"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","55da-cee1-e556-4735"],["relates_to","3a68-36e6-6e5c-4c3e"],["relates_to","bf74-a636-e6d9-40f9"],["relates_to","e7d6-7291-d593-40a2"]],"no_file_impact_reason":"","parent_id":"55da-cee1-e556-4735","parent_status_uuid":"6b037566-1c1a-4155-811c-3743f386c276","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["windows","portability","store","locking"],"ticket_id":"a50a-cac1-af18-42d9","ticket_type":"bug","title":"reducer/marker.py guards the fcntl import but not its use — the same defect as lock.py, at four call sites","verify_commands":[]},"source_event_uuids":["c25542af-533d-4cab-9142-b64cbadd1495","6a9e5c42-e278-4ce2-b0d4-21002bdfa690","a5b84db4-2bf2-468b-8b1d-3a0e04e9a0d2","8b42e64e-5228-4059-9be6-813ecc62018d","2fcd5b41-db91-4078-9cea-932b1000ec1d","d892c00a-7e6a-4cf8-9c30-524f4e20e722","6b037566-1c1a-4155-811c-3743f386c276","9524a7a1-3a03-42b3-a46f-4487c6b891b7","8b1e46bf-cf6e-4579-b50f-8d89b4674d9e","bfb9c0c5-854d-4b15-b0e1-1e1906a645e1","93391c7d-7943-4fad-8917-f2786d4c14a8","f5c47582-3919-4fcf-883c-af106da56212","975817ed-2dd5-4413-9fdb-b1ce69f62f88","1d26f3b5-757f-4e89-a851-20925d7de7af"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788882758746456447,"uuid":"8ba2fdb6-951e-4720-9833-ab4d909fe662"}