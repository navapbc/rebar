its 5 s sleep completes.","id":"a3d0-5d81-739a-4957","parent_id":"","priority":2,"tags":[],"ticket_type":"bug","title":"test_tool_timeout_cancels_an_async_tool exceeds its 4.5s bound under CI load"},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"CREATE","timestamp":1793477607064481001,"uuid":"4a5de7b6-ee9d-46ea-aadf-500f9f96fa62"}