{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788568195577497801,"compiled_state":{"alias":"witted-invisible-roan","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"28a6d8a82b54f826d9fca8c80c7b06daaac5d1e9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 9ea3-7d07-ea55-4496","material: 77140b3e2e49e6d7","material-part: children 647ea2107ca5072f 0","material-part: description c08e3b64241bfa0a 4763","material-part: description_boxes 038dfdbe3832f4b1 3","material-part: file_impact b74d16d365d60cfb 6","material-part: ticket_id 9c69fa8ebfea1346 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (cdfd7d94dc-dirty)","regver: aa61189569d34126","verified-at-sha:31a37c1223411a836edabdea11d87d839264cd74","dep 09b0fac55e7ad5a96e41848d82840632363caee4906ad2c9ce1b583624ec7448 infra/scripts/observability.sh","dep 3df4302b917f02fef2c95fced2004b42bcefd9a857c4961ae66a0e577ba8110a src/rebar/llm/completion.py","dep absent src/rebar/llm/peak_rss.py","dep c7667659047fa8a545b5219d3f121c2173eb2cf48fcc3b25c2dfcb0e27efabeb src/rebar/llm/plan_review/__init__.py","dep absent tests/scripts/test_observability_memory_9ea3.py","dep absent tests/unit/test_gate_peak_rss_9ea3.py","read-set: 11","read-path: docs/adr/0079-autodeploy-on-box-timer.md","read-path: docs/adr/0104-mcp-on-box.md","read-path: infra/nginx/mcp-upstream.conf","read-path: infra/nginx/rebar.conf.template","read-path: infra/scripts/autodeploy.sh","read-path: infra/scripts/observability.sh","read-path: infra/terraform/monitoring.tf","read-path: infra/terraform/monitoring_9ea3.tf","read-path: infra/terraform/versions.tf","read-path: tests/scripts/test_autodeploy_mcp_bluegreen.py","read-path: tests/scripts/test_observability_mcp_health_9ea3.py","currency-basis: file_impact"],"material_fingerprint":"77140b3e2e49e6d7","merged_log_commit":"31a37c1223411a836edabdea11d87d839264cd74","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788465769141732000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":33,"unsigned":0},"authorship_ledger":[{"content_hash":"c0f956c78d510c3f24c6d7047dddf68cce852faa9a0365f9f1f2ca19ffa54abd","event_uuid":"90c59037-53bd-423e-a1fc-899aa424aa2a","position":{"commit_sha":"39ca04dd06cce3fe94910323dd0a0f57ed0cd181","position":"1788472939935556001-90c59037-53bd-423e-a1fc-899aa424aa2a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e9729f547579181b0e189bc4fb6bba053f1b40c94adc11b43da3771a84da1207","event_uuid":"d4262967-cc00-438d-9c71-8ed8a9e5fbd6","position":{"commit_sha":"628b2cdceee39ba6943b55d96cfa1c0347a12492","position":"1788477245599721001-d4262967-cc00-438d-9c71-8ed8a9e5fbd6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"38299c76132b71bccbe6bd5dbc11421479b7a8e18e3ac49dcc2d604d566d4d57","event_uuid":"9dde8e12-29db-498b-95ce-47549000a7a5","position":{"commit_sha":"a70550e844e6bd35e64fbfead015f5c4935e0b07","position":"1788477865870325001-9dde8e12-29db-498b-95ce-47549000a7a5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4c519eaeb60ab6fc8f915cfea20a39a0abeed818748a0449b806b00682bee20a","event_uuid":"ed178f76-0f2e-4fd5-992e-c2019efb3de4","position":{"commit_sha":"f6db79558cda3c9c3e8d943217c620d6d3b45185","position":"1788504124329895001-ed178f76-0f2e-4fd5-992e-c2019efb3de4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"023a0a806ab8034d3942067b4957925b661b716e878ca2018a5bae526e1f1389","event_uuid":"d080fe9d-7baf-41bd-961c-982fe406dcab","position":{"commit_sha":"53ef00684e7cffc47980ad81594f3dbea74b4340","position":"1788504342196810394-d080fe9d-7baf-41bd-961c-982fe406dcab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0da1f2b908c4e2a8451e8fa0ba9eb5c88a20f2c9cd3873350d579dc05531c4ae","event_uuid":"7698fc30-9807-4d03-890a-de7785908afb","position":{"commit_sha":"d0b050a321bd53dc0a4dbcb6ef179a0529b3ffd2","position":"1788531443132967001-7698fc30-9807-4d03-890a-de7785908afb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3cc4ec36378cca4f9e09d6e6b510a8f482b477a3db6e2054ba9d24d6ed0ba7cf","event_uuid":"5fe59b23-84e3-43e4-97c8-a6eb3e4cede5","position":{"commit_sha":"96cfd2e7bdbb48ab092731f890c68acbc26a56b5","position":"1788539461537978001-5fe59b23-84e3-43e4-97c8-a6eb3e4cede5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4cefc11380a7728c6e2b50be7e6ea77dff7f2af0f47bcc8fa1b54ea03a0631b1","event_uuid":"1b3963c9-f510-4899-8cdf-7415ccc3e29d","position":{"commit_sha":"86a5ff325e8d30e426403b2f770c781b7e5d6182","position":"1788546380501981001-1b3963c9-f510-4899-8cdf-7415ccc3e29d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"136397df6b73959d7ae93c5d7713a9ab0a18eae2b87329facd9473f5fb5ac4fd","event_uuid":"342652d6-4d67-4cbb-84c2-6ad4dbd12b65","position":{"commit_sha":"47071c650fd8f9c5ab40a9c1b271832a091ec3d6","position":"1788555100967917001-342652d6-4d67-4cbb-84c2-6ad4dbd12b65"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"218e04a69aceb8f550a79e6e611fb3f00053e902f87cd1fd12df5a3d5cd537c2","event_uuid":"33426b1e-1a61-4592-b452-f69d9560522f","position":{"commit_sha":"97d7ab41ad25c2d68038fe7d4759a0f096497e83","position":"1788555163495689001-33426b1e-1a61-4592-b452-f69d9560522f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2299922219cc1c0529d15cf903c04a98ff71d44b36df3e63bbcf22f1c8d59070","event_uuid":"283f1b63-f088-4df2-928a-e289a5747ae3","position":{"commit_sha":"fade828338308b5f0b8a2349036eeba254321c0d","position":"1788560547201925001-283f1b63-f088-4df2-928a-e289a5747ae3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-259_agent","claim_remote_session":null,"claimed_session":"72e08d92-bab9-41e6-a77e-0524c3443c0b","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## RCA COMPLETE — confirmed root cause, and THE OUTAGE IS STILL ACTIVE\n\nFirst correction to the ticket: it says 'more than 20 minutes'. I verified live just now — `https://rebar.solutions.navateam.com/mcp` returns **502 right now, ~4 hours in, with no self-recovery**. Discriminating probe: `/mcp` = 502 while `/review/health` = 200 and `/` = 200, so nginx, Gerrit and the review-bot are all healthy and only the rebar_mcp upstream is dead.\n\n## Confirmed mechanism (on-box, read-only SSM)\n\n1. **The MCP container was OOM-KILLED.** `docker inspect` on `rebar-mcp-8db373933654-8093`: `OOMKilled=true Exit=137 RestartCount=1 Status=exited`, Finished `2026-09-03T01:36:51Z` = **18:36:51 PDT**. The plan-review job started 18:31:33 PDT. **The container died ~3 minutes into the gate run.** Host is a t4g.large, 8 GiB.\n2. **nginx still points at the dead port.** `/etc/nginx/mcp-upstream.conf` contains exactly `server 127.0.0.1:8093;` — the port of that exited container. A single backend, no `max_fails`/`fail_timeout`/`backup`/`proxy_next_upstream`, so one dead port is a total outage. Hence 502 rather than a connection refusal.\n3. **`restart: always` did not save it** — RestartCount=1 and the container is still `exited`.\n\n## Why it persists — recovery is STRUCTURALLY IMPOSSIBLE right now\n\nRedeploy is the only recovery path, and every attempt fails at build:\n\n    error: Required uv version `==0.12.7` does not match the running version `0.12.9`\n\npyproject.toml:346 pins `required-version = \"==0.12.7\"` while the Dockerfiles `COPY --from=ghcr.io/astral-sh/uv:latest`, which has moved to 0.12.9. Autodeploy is looping on this — fail#3 backoff 240s, fail#4 backoff 480s — so MCP can never rebuild. Filed separately as `febd-6b13-1976-43be` (curbable-regardable-lemming), linked, claimed, and being fixed FIRST since it is the prerequisite.\n\n## A hypothesis I had, correctly REFUTED\n\nI suspected `mcp_mem_abort`/`mcp_retire_cap` — the alarms I had just fixed in bff5. Both are **0.0 in every 900s bucket 15:00-21:45 PDT**, and neither has fired since 2026-08-30. They are DEPLOY-PATH markers, not observers of the serving process, so a KERNEL OOM-kill is invisible to them. Recording this because it is the interesting part: the instrumentation that exists for 'MCP ran out of memory' does not observe the case that actually happened.\n\n## The detection gap (AC(b)) is total\n\n`observability.sh:46-58` probes exactly two endpoints and publishes `gerrit_healthy` and `reviewbot_healthy`. There is **no `mcp_healthy` metric** — confirmed by `list-metrics` on namespace rebar/host. The container's own `/health` is not routed by any nginx location, so it is unreachable from outside the box. The deploy declares success at the flip and never re-validates. So nothing in the system can observe that /mcp is 502.\n\n## Latent defect worth its own attention\n\nIn `autodeploy.sh`, `mcp_retire_sweep`'s live-backend guard `[ \"$p\" = \"$live\" ] && continue` sits only inside the `Running=true` branch (~line 714). An exited-but-live container falls through to the else branch and is `docker rm`'d while the nginx include still names its port — which is exactly the state observed here. That converts a transient crash into a permanent 502.\n\n## Also noted\n\nRoot disk is back to **76% (46G/60G)** and climbing — relevant to `3276-2f81-8c75-4ddd` and epic `6202`, since the 60 GiB grow was explicitly an unwedge, not a fix.\n\nPrior art from the search: `d240-824a-dd04-4cdb` (event-loop block, same nginx-alive/upstream-dead signature), `9d40-1db8-1bcc-4f91` (22min of 502 on the sibling /review service; its fix added a per-container healthcheck), `d80d-7be7-1c0a-4231` (added the very `review_plan_start`/`gate_status` surface in use when this broke).","timestamp":1788412178801943001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MCP ENDPOINT IS BACK. `/mcp` returns 401 (auth required) rather than 502 — the upstream is answering. Total outage roughly 18:31 PDT 09-02 to 06:41 PDT 09-03, about 12 hours.\n\nRecovery came from the prerequisite bug `febd-6b13-1976-43be`: change 2558 pinned uv in the container images, which restored the ability to BUILD, and the next autodeploy tick then rebuilt and cut over. Journal at 06:41:01: 'mcp cutover complete: /mcp upstream now 127.0.0.1:8092 (deploy DONE)'. `docker ps` shows `rebar-mcp-3e04025b684e-8092 Up (healthy)` and the nginx upstream now names that live port instead of the dead 8093.\n\n## THIS TICKET IS NOT DONE — recovery is not the fix\n\nThe endpoint is up, but every acceptance criterion on this ticket is about the system SURVIVING and DETECTING this, and none of that changed:\n\n- **AC(a) — reachable during/after long async gate jobs.** Unaddressed. The container was OOM-killed roughly 3 minutes into a plan-review run on an 8 GiB box. Nothing about that has changed; the next long gate can repeat it.\n- **AC(b) — unhealthy upstream detected and reported.** Still entirely missing. There is no `mcp_healthy` metric (confirmed via `list-metrics` on rebar/host); `observability.sh` probes only Gerrit and the review-bot; the container's own `/health` is not routed by any nginx location; and the deploy declares success at the flip without re-validating. For ~12 hours nothing in the system could observe that /mcp was down — a human reported it.\n- **AC(c) — regression test or operational probe for upstream loss during a gate.** Still missing.\n\nAlso still standing, and worth its own attention: the `mcp_retire_sweep` guard in autodeploy.sh reaps an exited-but-live container while nginx still names its port (the live-backend `continue` sits only inside the `Running=true` branch), which is how a transient crash becomes a permanent 502.\n\nRecording this explicitly so 'the 502 cleared' is not mistaken for the bug being fixed — the same trap this project hit on 3276, where growing the volume was nearly recorded as the resolution.","timestamp":1788417928346575001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"The `mcp_retire_sweep` reaping defect is FIXED and pushed: Gerrit change 2567 — https://rebar.solutions.navateam.com/c/rebar/+/2567 (commit 363e03c8df9c).\n\n## The defect was exactly as diagnosed, confirmed against the code\n\n`infra/scripts/autodeploy.sh`, `mcp_retire_sweep` (function at line 701; the guard was at 714). The live-backend check `[ \"$p\" = \"$live\" ] && continue` sat ONLY inside the `Running=true` branch. The `else` arm had **no live check at all** — it reaped any non-running managed container, including the live one.\n\n## The RED proof reproduces this outage's exact signature\n\nPre-fix, the new test logged:\n\n    {\"event\":\"autodeploy\",\"msg\":\"mcp retire: reaped exited rebar-mcp-live-8093 (port 8093 freed)\"}\n\nThat is the observed 2026-09-02 state verbatim — the sweep freeing port 8093 while `/etc/nginx/mcp-upstream.conf` still named `server 127.0.0.1:8093;`. Two tests failed pre-fix (live backend reaped; no signal emitted); the third — a RUNNING live backend — passed before and after as the preserved-behaviour control. Anti-vacuity holds: the same fixture's genuinely superseded exited container on 8092 is asserted reaped in the same run, so the sweep still does its job.\n\n## The fix\n\nThe guard is HOISTED above the state branch rather than duplicated into the else arm — a duplicated guard is the same defect waiting to drift, and the code now carries a comment saying so. The `[ -z \"$live\" ]` fail-safe deliberately stays in the running arm: an exited container on no KNOWN live port is still safe to reap, which an existing test pins.\n\n## A signal was added, on the existing path\n\nAn exited container on the live port is not a routine backoff — it means `/mcp` is 502ing right now — so it emits `err mcp-live-backend-down`, an `AUTODEPLOY_ERROR` marker. That reuses the existing convention with ZERO new machinery: `AUTODEPLOY_ERROR` is already counted into `deploy_errors` by observability.sh. A fresh token (as `AUTODEPLOY_MCP_RETIRE_CAP` and `AUTODEPLOY_MCP_MEM_ABORT` are) would have needed its own `publish_autodeploy_marker_delta` call, an offset file, and a terraform metric before it was visible at all. The contrast is deliberate: retire-cap and mem-abort are kept OUT of `deploy_errors` because they are routine; a down live backend is not.\n\n## Verification\n\n`pytest tests/scripts` 1355 passed / 3 skipped; `make lint` exit 0 including shellcheck and all three ratchets. No mechanism marker was needed — a bash marker is not one of the seven censused kinds.\n\n## Noted, not acted on\n\n`autodeploy.sh` is **1313 lines**, far past the 800 cap. It is not gated, because the CI module-size gate scopes to `src/rebar` Python only. Flagging it as a real but out-of-scope observation: the file that manages every deploy on the box is the largest unsplit unit in the tree, and this session has now found two distinct defects in it (this one, and the uv build path).\n\n## Remaining on this ticket\n\nAC(b) detection landed as change 2565 (mcp_healthy probe + alarm — needs a terraform apply to go live). This change addresses the mechanism that made the outage PERMANENT. Still open: AC(a)'s actual OOM prevention — the container was OOM-killed ~3 min into a gate run on an 8 GiB box, and nothing yet stops that recurring. That needs a design decision (container memory limit, gate offloading, or a larger instance) rather than an obvious fix.","timestamp":1788421965391690001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC(a) research complete — the crux, and why this is EPIC-sized rather than bug-sized\n\nRead-only investigation. Recording before any decision, because the finding changes what AC(a) can honestly mean.\n\n### The crux: gate work runs IN-PROCESS\n\n`src/rebar/_mcp_llm.py:194` — `_spawn_gate_daemon` (function at :157) ends in `threading.Thread(target=_bg, daemon=True).start()`. `review_plan_start` (:255) offloads only the basis-SHA resolution to an anyio worker (:291); the review itself runs as `work=lambda: _review_plan_body(...)` **on that daemon thread inside the uvicorn process**. `offload_sync_tools` (`_mcp_health.py:287`) likewise moves bodies off the event loop but stays in-process. No subprocess, no fork, no worker service.\n\nSo the async surface bought TIMEOUT-IMMUNITY, NOT ISOLATION. The gate's memory IS the MCP server's memory. Every other option follows from this.\n\nTwo amplifiers, both hardcoded: `plan_review/pass1.py:362,425` runs up to 6 parallel LLM calls and `container_stage.py:44,258` opens a SECOND pool of 6 — each holding prompt plus response. And `PlanContext` (`det_floor.py:141-144`) states the content is \"ALWAYS whole (no truncation, no content-chunking, by design)\", so for a container ticket every child dict is resident. Ruled out as a cause: the code snapshot streams to DISK, capped at 512 MiB (`workflow/snapshot.py:46,245`) — disk pressure, not RSS.\n\nSecond unbounded consumer on the same box: the review-bot calls `rebar.llm` directly in-process (docker-compose.yml:273). Two LLM runtimes on one 8 GiB host.\n\n### Two facts that reframe the problem\n\n1. **There are NO memory limits anywhere** — no `mem_limit`, no `deploy.resources.limits`, on gerrit, review-bot, mcp or opcert. Yet Gerrit IS budgeted (`gerrit.config:48,67`: heapLimit 2g, packedGitLimit 1g, explicitly sized against total box RAM). So ~3 GiB is reserved by design, and the service that RUNS THE GATES is the only one with no budget at all.\n2. **Memory is entirely unmetered.** observability.sh publishes gerrit_healthy, reviewbot_healthy, disk_used_percent and root_disk_used_percent — and nothing for memory. `MCP_MEM_MIN_MB=1024` (autodeploy.sh:175) is a one-shot deploy go/no-go that FAILS OPEN, with no derivation from any measurement.\n\n### A documentation-vs-reality mismatch worth its own attention\n\nADR 0079:88 and ADR 0104:75 both claim the blue-green overlap is \"guarded by a memory-pressure alarm\". **There is no such alarm.** The only related alarm counts DEPLOY REFUSALS, not memory. That is the same shape of defect as bff5: a stated guard that does not observe the condition it names.\n\n### Prior decisions that constrain the answer\n\n- ADR 0104:75 and ADR 0079:88 **explicitly decided NOT to upsize** — the one-in/one-out overlap cap exists \"so the transient 2x rebar-mcp never forces the t4g.large (8 GiB) up to t4g.xlarge\". Upsizing contradicts an accepted ADR.\n- Ticket 3276's operator-approved principle applies identically: growing a resource is an unwedge, not a fix. An unbounded fan-out will fill 16 GiB too.\n\n### Ranked options\n\n1. **Measure first.** Publish mem_available_percent plus per-container RSS, and a peak-RSS line at gate completion. Prevents nothing on its own — but every other option needs a number nobody has.\n2. **Container memory limits on all four services.** Honours the ADR-0104 \"fit inside 8 GiB\" decision and makes the next failure attributable. Stated plainly: this does NOT save the gate and may kill it sooner. Its value is that MCP can no longer take Gerrit down — and with the reaping fix, `restart: always` and the healthcheck, an MCP OOM becomes a ~30s blip rather than 12 hours.\n3. **Bound the in-process footprint** — make the two fan-out widths configurable and lower them, or run the gate as a subprocess so peak RSS is reclaimed on exit. The only structural fix, and real work.\n4. **Upsize to t4g.xlarge.** Fastest relief; contradicts two ADRs and the 3276 principle; postpones rather than bounds.\n\nUnnamed until now, and arguably the honest end-state: **move gate execution off the box entirely** (separate instance or Fargate). That dissolves the co-tenancy problem the ADRs are working around, and is bigger than this ticket.\n\n### What is unmeasured — the important finding\n\nPeak MCP RSS during a gate; steady-state RSS per container; how RSS scales with ticket size and fan-out width; actual free memory at the kill. **Any mem_limit or instance size chosen today is a guess**, including the existing 1024 MB deploy floor.\n\n### Recommendation on sizing\n\nAC(a) as written (\"prevent the OOM\") is a capacity-architecture problem with the same shape as epic 6202 for disk. Proposal, for operator decision: land MEASUREMENT plus CONTAINER LIMITS under this ticket — that, with the two ACs already done, makes the outage observable, attributable and survivable — and decompose in-process gate execution into a sibling epic, mirroring how 3276 spawned 6202. Escalated rather than decided.","timestamp":1788425475873812001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC(b) IS NOW LIVE — the mcp_healthy alarm is applied and detecting\n\nOperator-approved apply completed. `aws cloudwatch describe-alarms` confirms:\n\n    rebar-mcp-serving-path-down | metric mcp_healthy | Statistic Minimum\n    Threshold 1.0 LessThanThreshold | period 300 | EP 3 | DTA 2\n    TreatMissingData breaching | 1 alarm action | State INSUFFICIENT_DATA (newly created)\n\nPlan was clean and minimal: **1 to add, 0 to change, 0 to destroy** — this creates a new alarm and touches no existing paging behaviour.\n\n## A false-page risk I checked BEFORE calling this done\n\nThe alarm is `treat_missing_data = breaching`, so if the probe that publishes `mcp_healthy` were not yet running on the host, the alarm would have gone to ALARM within ~15 minutes and paged for a non-problem. Verified it will not:\n\n- `get-metric-statistics` returns **22 mcp_healthy datapoints in the last 2 hours** — the metric is publishing.\n- The probe is deployed: `grep -c mcp_healthy /opt/rebar/infra/scripts/observability.sh` = 3, file dated Sep 3 07:33.\n- `systemctl is-active rebar-observability.timer` = **active**.\n\nSo INSUFFICIENT_DATA is simply a newly-created alarm awaiting its first evaluation periods, not a missing publisher.\n\n## What had to be fixed first, and why it matters\n\nChange 2565 landed this alarm with a **1236-raw / 1180-dedented character** `alarm_description` against AWS's 1024 cap, so it was **unappliable** — `terraform plan` errored outright. That reached main through LLM-Review and a green Verified vote because nothing in the pipeline plans against AWS: `terraform validate` parses HCL and passes, the alarm guards checked structure rather than provider constraints, and CI never runs a plan. It surfaced only when an operator asked for the apply.\n\nChange 2584 trimmed the description to 775 characters and added `test_alarm_descriptions_fit_the_aws_limit`, which now covers BOTH the heredoc and quoted-string spellings (monitoring.tf uses the quoted form three times, so a heredoc-only guard would have skipped exactly those) and carries an anti-vacuity floor of 15 measured descriptions. It measures what terraform actually sends — `<<-` strips the common indent, and counting raw would have failed the valid, live `bedrock_invoke_client_errors` at 1037 when AWS reports its description as 982.\n\n## Where this ticket stands\n\n- AC(b) — unhealthy upstream detected and reported: **DONE and LIVE**. Nothing could observe a /mcp outage for the 12 hours of this incident; that gap is now closed in production.\n- AC(c) — regression test / operational probe: **DONE** (change 2565's shell tests, RED-proven).\n- AC(a) — prevent the OOM: measurement-only instrumentation is in flight per the operator's decision. No memory limit or instance size will be chosen until there are numbers, because today every candidate value is a guess.\n\nEndpoint is healthy: `/mcp` returns 401 (auth required), not 502.","timestamp":1788463226481896001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC(a) measurement-only instrumentation pushed: Gerrit change 2589 — https://rebar.solutions.navateam.com/c/rebar/+/2589 (commit b4fed2147007, 6 files +732/-11). Per the operator's decision: MEASURE FIRST, choose limits later. No mem_limit, no instance-size change, no fan-out change.\n\n## What now publishes, on the existing 5-minute timer, namespace rebar/host\n\n    mem_available_percent          (no dims, Percent)  from `free -k` column 7\n    mem_used_percent               (no dims, Percent)  complement\n    mem_probe_ok                   (no dims, 1/0)      did the read actually succeed\n    container_memory_rss_bytes     (dim: container)    one datapoint per running container\n    container_stats_ok             (no dims, 1/0)      the census's own heartbeat\n\nHost gauges are DIMENSIONLESS, matching root_disk_used_percent and every rebar/host alarm in monitoring*.tf — a dimension on one side only silently unmatches. The per-container gauge follows the other local precedent, disk_used_percent's `mount` dimension, because 'which resident set grew' is a comparison ACROSS containers: one `Sum by container` query, versus per-service metric names that would need this probe and every consumer edited whenever compose gains or renames a service.\n\n## Three details that make the measurement trustworthy\n\n1. **It reads `available`, not `free`.** Column 7 of `free -k`, not column 4. On Linux those differ by the reclaimable page cache, and using `free` would have systematically understated headroom — the RED proof for this shows [6] vs [25], so it is not a rounding difference.\n2. **`mem_probe_ok` distinguishes a measured zero from a synthesised one.** Both host gauges publish on every tick including failure paths, in each gauge's pessimistic direction (0% available / 100% used) — the same convention section 5's mirror_out_of_sync now uses. But a pessimistic default must never be mistaken for a real reading, so any analysis of this campaign's data must DROP ticks where mem_probe_ok = 0. A genuinely full box publishes a real 0 with mem_probe_ok = 1.\n3. **peak_delta_bytes is reported alongside the absolute peak.** `RUSAGE_SELF.ru_maxrss` is a process-wide HIGH-WATER MARK, so in a long-lived MCP server the absolute figure attributes every prior gate run's cost to whichever run you happen to be reading. Without the delta the numbers would be actively misleading for exactly the question being asked.\n\n## Peak RSS per gate run\n\nNew `src/rebar/llm/peak_rss.py` emits a `GATE_PEAK_RSS {json}` journald marker at gate completion — gate, ticket_id, peak_rss_bytes, peak_delta_bytes, elapsed_ms, timestamp. A marker rather than metric plumbing because the containers deliberately hold no AWS credentials (IMDS hop limit), which is why VOTER_ERROR and MERGE_CHANGE_ERROR are markers the host probe greps and republishes; the convention is copied verbatim from voter_merge.merge_change_error, including the f829 rule that the logger copy omits the token. It also works under the CLI on a laptop where CloudWatch does not exist.\n\nSeam: the LIBRARY entry points `rebar.llm.review_plan` and `rebar.llm.verify_completion` are wrapped rather than _spawn_gate_daemon and the CLI separately, since both call paths reach the gate through those two functions. Emitted from a `finally`, so runs that DIE — the OOM case, the whole reason this exists — still report.\n\n`ru_maxrss_to_bytes(value, platform)` is a pure function: bytes on darwin/BSD, x1024 on Linux. Kept pure so both branches are testable without the platform.\n\n## docker stats is bounded twice\n\n`--no-stream` plus `timeout 15`, matching the bare `timeout N docker ...` idiom autodeploy.sh already uses in four places. If `timeout` were itself absent the command fails 127, container_stats_ok publishes 0, and the probe continues — it can never wedge the timer. A test asserts both bounds by hanging the stub for 300s unless invoked through timeout AND with --no-stream.\n\n## Eight RED proofs, all binding\n\npublish-nothing-on-failure -> 4 failed ([] != [0]); read `free` not `available` -> 2 failed ([6] != [25]); drop --no-stream -> TimeoutExpired after 60s, the wedge reproduced; gate container_stats_ok on success -> 4 failed; treat ru_maxrss as bytes everywhere -> 3 failed (2048 != 2097152); emit on `else` not `finally` -> 1 failed; logger copy carries the token -> 1 failed (f829 regression); drop the wrapper from review_plan -> 1 failed. All restored, 24/24 green.\n\n## Verification\n\npytest tests/scripts 1369 passed / 3 skipped; test_gate_peak_rss_9ea3.py 12 passed; make lint exit 0 (mechanism new=0 so NO marker needed, complexity new=0/increased=0); make typecheck 750 files. One caveat carried forward honestly: a full `pytest tests/unit` sweep was started as an extra check and its result was not seen — CI will settle it.\n\n## Next step is DATA, not a decision\n\nOnce this lands and deploys, the campaign needs to run long enough to answer: peak MCP RSS during a gate, steady-state RSS per container, and how RSS scales with ticket size. Only then can a mem_limit or an instance size be chosen as anything other than a guess.","timestamp":1788463506316326001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Closing out the verification caveat noted in the previous comment. The full `tests/unit` sweep finished: **6629 passed, 10 skipped, 1 error** — and the error was self-inflicted rather than a code failure. `test_code_review_gate_session.py` carries a harness guard that fails if repo HEAD moves mid-test, and a `git commit` landed while the suite was still running (HEAD moved 8f8af4b763 -> b4fed21470). Re-run on a quiescent tree: 11 passed.\n\nComplete tally for change 2589: tests/scripts 1369 passed / 3 skipped; tests/unit 6629 passed / 10 skipped; make lint exit 0 with all ratchets new=0; make typecheck Success across 750 files.\n\nWorth recording as a reusable observation, since this session hit two variants of it: test harnesses here are sensitive to concurrent activity on the same tree. That guard is doing its job — a suite run against a moving HEAD produces results that cannot be attributed to any particular commit — but it means a full sweep and a commit must not overlap. A sibling instance: a parallel agent's backup file in /tmp was overwritten by another agent on this host, invalidating a RED proof until it was redone with a worktree-local backup. Shared scratch and shared HEAD are both hazards when several agents work the same checkout family.","timestamp":1788463545791743001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review PASSED and certified (head_sha 31a37c1223411a836edabdea11d87d839264cd74, currency_basis file_impact) after restructuring the plan to the readiness floor. The prior run BLOCKED on two legitimate findings: the ticket was filed with prose bullets rather than a `- [ ]` checklist under `## Acceptance Criteria`, and it named no proving commands — so nothing in it was checkable.\n\n## An acknowledged gap the gate caught, recorded here rather than silently dropped\n\nAdvisory T5b/E1: **root cause item 2 — nginx's `upstream rebar_mcp` is a single `server` line with no `max_fails`, `fail_timeout`, `backup` or `proxy_next_upstream` — is named as a confirmed root cause, but no acceptance criterion remediates it and it is not listed among the deliberate exclusions either.** That is accurate and it was my omission: I documented the mechanism and then left it out of the plan in both directions.\n\nStating the disposition explicitly now. It is **deferred, not fixed**, for these reasons:\n\n- It is a change to the nginx serving TOPOLOGY, not to the capacity question this ticket's remaining scope covers. Adding failover means deciding what the second backend IS — during a blue-green cutover the old container is briefly still alive, but in steady state there is exactly one, so 'fail over to what?' has no answer today without also changing how many MCP backends run.\n- With the retire-sweep fix (change 2567, merged) plus `restart: always` and the container healthcheck, a crashed backend is now a ~30s blip rather than permanent. Failover would shrink that further; it is no longer the difference between an outage and no outage.\n- The genuine end-state for this — running MCP with more than one backend, or moving gate execution off-box entirely — is the epic-sized work already identified for AC5's data to inform.\n\nI am NOT adding it as an AC to this ticket, because doing so would commit this bug to a topology change the operator has not scoped. Recording it here so it is a decision rather than an oversight, and so the next reader does not have to rediscover that the single-server upstream was known and left.\n\nThe other two advisories are non-blocking and noted: AC4 asserts new measurement capability without naming its own novelty explicitly (T3), and a general definition-of-done quality note (P6). Neither changes what the work is.","timestamp":1788465831155325001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Change 2589 patch set 2 pushed, addressing all three review findings.\n\n## FINDING 1 (the important one): unbounded metric cardinality\n\nThe per-container gauge keyed its CloudWatch dimension on `docker stats {{.Name}}`, and MCP container names embed a per-deploy commit SHA and port. **I have now personally observed THREE distinct MCP container names in this one session** — `rebar-mcp-8db373933654-8093`, `rebar-mcp-3e04025b684e-8092`, `rebar-mcp-81da79273115-8093` — so the growth is measured, not theoretical. Left alone it would bill per unique dimension combination and restart the series at every deploy, making 'peak MCP RSS during a gate' unanswerable. Measurement instrumentation that cannot be charted over time is worse than none, because it looks like coverage.\n\n**Fix:** the dimension key is now `service=` resolved from container LABELS, via a second bounded `timeout 15 docker ps --format ...` joined against the stats stream in one awk pass (`docker stats --format` cannot emit labels, which is why the second call exists). `autodeploy.sh` also stamps `--label rebar.service=mcp` on the blue-green container, and `rebar.service` wins over the compose label so an explicit stamp can override.\n\n**A correction to the implementing agent's stated justification, which I verified against the live box.** It reported that the blue-green MCP container is started by a bare `docker run` that 'compose never sees and never labels', so a label-only read would have left exactly the campaign's container with no identity. That is NOT what the box shows:\n\n    rebar-mcp-81da79273115-8093 :: mcp\n    compose-review-bot-1        :: review-bot\n    compose-opcert-1            :: opcert\n    compose-gerrit-1            :: gerrit\n\nThe MCP container DOES carry `com.docker.compose.service=mcp`, inherited from the compose-built image. So a label-only read would have worked today. The explicit stamp is still the better design — it does not depend on image-label inheritance surviving a future image change — but it was a robustness improvement, not the necessity it was described as. Recording this so the commit's reasoning is not taken as verified fact.\n\nRejected, correctly: parsing `-<sha12>-<port>` off the name. It fails in the DANGEROUS direction — an unmatched name falls through as itself, so a convention change silently restores unbounded cardinality rather than failing loudly. Unlabelled containers go to a single constant `unlabeled` bucket: bounded by construction, obvious in the data, self-healing at the next deploy, with the raw name sent to journald where cardinality is free.\n\nProven by `test_two_deploys_of_the_same_service_collapse_to_one_dimension_value`, which feeds the two real observed names and asserts `sorted(published) == ['mcp']` while BOTH readings survive under that value — a blue-green cutover briefly runs two containers, and `Maximum by service` is what a peak-RSS question asks. The docker stub is non-vacuous: its `ps` branch exits 3 unless the script actually asked for both label templates. RED: repointing the dimension at the raw name fails 6 of 16.\n\n## FINDING 2: a partial failure looked like success\n\nAn unparseable `MemUsage` row was silently dropped while `container_stats_ok` still published 1. Now counted as `container_stats_unparsed_rows` with a per-row journald line. `container_stats_ok` deliberately stays 1, and the argument is right: it answers 'did the census run AT ALL' — the thing that distinguishes a wedged docker daemon from an idle box — so folding row-level parse quality into it would destroy the distinction it exists for. Two questions, two signals. The fix also caught a SECOND silent-zero path the original had: a row with an empty or non-numeric figure would have published a healthy-looking 0 bytes.\n\n## FINDING 3: a test that source-grepped\n\n`inspect.getsource()` containing `gate_peak_rss(` was replaced by a behavioural test that CALLS each entry point and asserts exactly one GATE_PEAK_RSS marker with the right gate and ticket_id. `peak_rss` itself is deliberately not stubbed. RED: deleting the call, and replacing the `with` block with `if True:`, both fail with 'emitted 0 markers, expected exactly 1'.\n\n## Rebase note\n\nThe rebase hit a conflict with change 2586 (/var/gerrit debris), which merged first: both changes independently claimed section \"2c\" in observability.sh. A NUMBERING collision, not a semantic one — both sections are wanted. Resolved by keeping the merged debris census as 2c and renumbering memory to 2d. Verified both coexist: 21 passed across both probes' tests, then 1378 passed / 3 skipped across tests/scripts, make lint exit 0.\n\nAlso, for the record, the `Missing tree` push rejection recurred and was again a STALE BASE rather than repository corruption — main moved between my rebase and my push. Rebasing onto the current tip cleared it both times.","timestamp":1788467515469738001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC4 verified post-deploy, and the campaign has produced its FIRST DATA\n\nChange 2589 merged and deployed. All five metrics are publishing to `rebar/host`:\n\n    mem_available_percent          1 series\n    mem_used_percent               1 series\n    mem_probe_ok                   1 series\n    container_memory_rss_bytes     4 series\n    container_stats_ok             1 series\n\n**The cardinality fix is confirmed live.** `container_memory_rss_bytes` has exactly FOUR series, and the `service` dimension values are `gerrit`, `mcp`, `review-bot`, `opcert` — four stable service names, not one per deploy. Given I observed three distinct MCP container names in a single session, the unfixed version would already have three series for MCP alone and would grow on every cutover.\n\n## First readings — steady state, no gate running\n\n    gerrit      0.88 GB\n    mcp         1.08 GB\n    review-bot  0.17 GB\n    opcert      0.04 GB\n    -----------------------\n    total      ~2.17 GB of 8 GiB\n\n## The host gauge is already showing something worth knowing\n\n    14:46 PDT  mem_available_percent = 29%\n    14:51 PDT  mem_available_percent = 31%\n    14:56 PDT  mem_available_percent = 60%\n\n`mem_probe_ok = 1.0` across these, so they are MEASURED readings rather than the pessimistic default a failed read publishes — the flag added for exactly this reason is doing its job on its first real use.\n\n**29% available on an 8 GiB box is roughly 2.3 GiB free.** Then something released ~2.3 GiB between 14:51 and 14:56, taking it to 60%. That is the shape of a large consumer exiting — a gate run finishing, or a container cycling.\n\nThis is directly relevant to the OOM: MCP sits at 1.08 GB at rest, and the box was down to ~2.3 GiB free. A gate run that grows the MCP process by ~2 GB against that headroom exhausts the host, which is consistent with the observed `OOMKilled=true / Exit=137` roughly three minutes into a plan-review run.\n\n**It is NOT yet enough to choose a number.** What is still missing for AC5: peak MCP RSS DURING a gate (the `GATE_PEAK_RSS` marker has to fire on a real run), how peak scales with ticket size and fan-out width, and whether the 29% trough is routine or was itself gate-driven. One trough is an observation, not a distribution. The campaign needs to span several gate runs before a `mem_limit` or an instance size is anything but a guess — which was the whole point of measuring first.","timestamp":1788472939935556001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC5 FIRST REAL MEASUREMENT — captured in real time, not waited for\n\nThe `GATE_PEAK_RSS` marker landed in change 2589 fired on a plan-review gate run today, unprompted:\n\n    {\"event\": \"GATE_PEAK_RSS\", \"gate\": \"plan_review\",\n     \"ticket_id\": \"endowed-upset-scaup\",\n     \"peak_rss_bytes\": 752336896,      (~717 MB)\n     \"peak_delta_bytes\": 525369344,    (~501 MB)\n     \"elapsed_ms\": 118090}             (~2 min)\n\n**A plan-review gate costs roughly 500 MB of resident growth over about two minutes.** That is the first hard number anyone has for this, and it is exactly the figure the OOM decision was missing.\n\nThe `peak_delta_bytes` field is doing its job on first use: the absolute 717 MB includes everything the process had already touched, so on a long-lived server it would attribute prior runs' cost to this one. The 501 MB DELTA is the gate's own footprint.\n\n## What this implies for the OOM, stated with its caveat\n\nSteady-state on the box (measured earlier today): gerrit 0.88 GB, mcp 1.08 GB, review-bot 0.17 GB, opcert 0.04 GB — about 2.17 GB of 8 GiB. Host `mem_available_percent` was observed at **29%** (~2.3 GiB free) at one point. A ~500 MB gate against 2.3 GiB of headroom does not by itself exhaust the box — so a SINGLE plan-review is not the whole story. Candidates for the rest, in rough order of suspicion: concurrent gates (the two 6-wide LLM fan-out pools), a container-ticket review holding whole child content by design (`det_floor.py` PlanContext), or the review-bot's second in-process LLM runtime running at the same time.\n\n**CAVEAT, stated plainly: this measurement was taken from a LOCAL CLI run on this workstation, not from the MCP server process on the t4g.large.** Same code path and therefore a fair magnitude, but not the box's own number — different architecture (arm64 host vs this machine), different concurrent load, and the box's MCP process carries the server's baseline on top. The box-side figure needs a gate driven THROUGH the MCP server so the marker lands in the host's journald.\n\nSo: AC5 has its first datapoint and the mechanism is proven end to end. What it still needs is (a) the same marker from a gate run on the box, and (b) a container-ticket review, to see how peak scales with ticket size — the epic 6202 review that produced this number was itself a container ticket with six children, which makes it a reasonable upper-ish sample rather than a trivial one.\n\nRecorded per the operator's standing principle: verifying that a fix is live and remediates behaviour is a real-time activity, not something to wait for.","timestamp":1788477245599721001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## The OOM arithmetic is now settled — operator supplied the missing term\n\nOperator (2026-09-03): '~10 plan reviews run in parallel frequently.'\n\nThat closes the gap I flagged in the previous comment, where a single measured ~500 MB gate against ~2.3 GiB of headroom did NOT account for the kill and I listed concurrent gates as one of three candidate explanations. It is the explanation.\n\n    complete plan-review, measured today      ~739 MB resident delta\n    x10 concurrent                            ~7.4 GB\n    steady-state containers on the box         2.17 GB (gerrit 0.88 + mcp 1.08 + review-bot 0.17 + opcert 0.04)\n    -------------------------------------------------\n    demand                                    ~9.6 GB\n    host                                       8 GiB\n\nThe box is oversubscribed by roughly 1.5 GB at ten concurrent reviews, before counting Gerrit's own 2 GiB JVM heap reservation (gerrit.config heapLimit) which is inside that 0.88 GB RSS figure only insofar as it is touched. An OOM-kill ~3 minutes into a plan-review is exactly what this predicts, and it explains why `mcp_mem_abort` never fired: that marker watches the DEPLOY path, and this is the serving process being killed by the kernel under aggregate pressure.\n\nTwo consequences for this ticket's remaining scope:\n\n1. **A per-container `mem_limit` alone does not fix this.** Capping MCP bounds the blast radius — MCP dies instead of risking Gerrit — but it does not make ten concurrent gates fit in 8 GiB. It converts an unpredictable host-wide OOM into a predictable MCP OOM. That is a real improvement in attributability and is worth doing, but it should not be described as preventing the failure.\n2. **The load-side control is the missing lever.** Ten concurrent in-process gates on one 8 GiB host is a capacity decision, not a leak. The options are bounded concurrency (admission control), moving gate execution off-box, or a larger host — and the first two are the ones consistent with this project's stated principle that growing a resource is an unwedge rather than a fix.\n\nAlso worth recording for AC5: the two measurements taken today differ materially — a run that degraded early cost 501 MB / 118s, a complete run cost 739 MB / 281s. Gate cost is variable, so any limit derived from a single sample would be wrong. The 739 MB figure is from a 6-child container ticket, which is a reasonable upper-ish sample rather than a trivial one, and it was taken from a LOCAL CLI run rather than the box's MCP process.","timestamp":1788477865870325001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MAIN-GREEN DEFECT IN THIS TICKET'S OWN FILE, found and fixed. The scheduled Terraform Drift workflow has been FAILING ON MAIN at its 'terraform fmt -check' step (exit 3), naming infra/terraform/monitoring_9ea3.tf -- this ticket's file.\n\nCause: alarm_name was padded for alignment against a neighbouring line that is a COMMENT, and terraform does not align across comments, so fmt wants:\n  -  alarm_name        = \"rebar-mcp-serving-path-down\"\n  +  alarm_name = \"rebar-mcp-serving-path-down\"\n\nConsequence worth noting: the fmt step is FIRST, so the plan job never ran at all. The Drift workflow has therefore not been checking for actual infrastructure drift -- a whitespace defect was masking the entire purpose of that workflow. That is the fourth instance today of the same shape: absence of execution presenting as a failure or a pass without anyone noticing what did not run.\n\nFixed and pushed as Gerrit change 2614: https://rebar.solutions.navateam.com/c/rebar/+/2614\n'terraform fmt -check -recursive infra/terraform' is now clean. Whitespace only; no alarm semantics change.\n\nCommitted under THIS ticket's trailer rather than opening a new one: 9ea3 is in_progress and held by me, the defect is in 9ea3's own file, and a separate ticket plus a 15-20 minute plan-review cycle for a one-line formatting fix would be ceremony without information. Recording the reasoning here so the trailer is not mistaken for scope creep.","timestamp":1788504124329895001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC5 MEASUREMENT CAMPAIGN -- peak RSS per gate run, ten samples collected in real time tonight.\n\nEvery GATE_PEAK_RSS marker emitted during this session's gate runs, from the marker that landed in\nchange 2589. These are real production-shaped runs against this store, not a synthetic benchmark:\n\n  gate               ticket   peak_rss_bytes   MB     elapsed_ms\n  plan_review        7dfa     748,437,504      713.8   221,616\n  verify_completion  7dfa     461,766,656      440.4    80,910\n  verify_completion  9a17     438,730,752      418.4    ~80,000\n  verify_completion  c379     457,752,576      436.5    67,444\n  verify_completion  740d     440,221,696      419.8    83,913\n  verify_completion  477b     438,534,144      418.2    74,926\n  verify_completion  09da     453,132,288      432.1   112,420\n  verify_completion  860b     438,714,368      418.4   100,917\n  verify_completion  aa40     455,049,216      434.0   119,061\n  verify_completion  1035     439,910,400      419.5    97,633\n\nWHAT THIS SETTLES:\n - PLAN-REVIEW peak is ~714 MB (single sample; the epic's sizing used ~739 MB, so that estimate was\n   sound and slightly conservative).\n - COMPLETION-VERIFIER peak is remarkably TIGHT: nine samples spanning 418.2-440.4 MB, mean ~430 MB,\n   spread under 6%. That is a much more predictable figure than expected, and it is the one to plan\n   against for the close gate.\n - The two gates are NOT interchangeable for sizing: plan-review peaks ~1.66x the completion\n   verifier. A single 'gate RSS' number would overstate one and understate the other.\n - peak_delta_bytes was 0 on most verify_completion runs and 521,961,472 on the plan_review run,\n   i.e. plan-review is where the allocation actually happens; the close gate largely runs inside\n   memory the process already had.\n\nCROSS-CHECK AGAINST S6, which shipped on this basis: S6's default cap of 4 was derived as\n4 x ~748 MB ~= 2.99 GB against ~3 GiB of headroom. These ten samples support that arithmetic for\nplan_review and suggest it is CONSERVATIVE for completion-verifier, where four concurrent runs would\nbe ~1.72 GB rather than ~2.99 GB. So the cap is safe, and if it ever needs raising, doing so per-gate\nrather than globally is the option the data supports.\n\nWHAT IS STILL MISSING for AC5 as written, stated plainly rather than glossed:\n - STEADY-STATE RSS PER CONTAINER: not collected here. That needs the container_memory_rss_bytes\n   series from observability.sh section 2d on the box, which is AC4's post-deploy half.\n - HOW RSS SCALES WITH TICKET SIZE: not collected. Every sample above is one store and a range of\n   ticket sizes I did not control or record, so I cannot honestly attribute the 418-440 MB spread to\n   ticket size rather than to noise. Establishing that needs a deliberate campaign across known\n   description/comment sizes, not opportunistic collection.\n\nSo AC5 is PARTIALLY satisfied: the peak-RSS-per-gate-run term is now measured with ten samples, and\nthe other two terms remain open. Not ticking it.","timestamp":1788531443132967001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Additional GATE_PEAK_RSS sample (tenth for completion_verifier), captured closing bug 1ef8 tonight:\n\n  gate=verify_completion ticket=1ef8-c849-5801-4eee\n  peak_rss_bytes=436371456 (~416 MB)  elapsed_ms=80768\n\nThis sits slightly BELOW the 418-440 MB band recorded from the previous nine samples, so it\nwidens the observed range rather than confirming it: completion_verifier now spans roughly\n416-440 MB across ten samples. The run was fast (81s) and the ticket small (five ACs, one\nsource file plus one test file), which is consistent with the low end being a small-ticket\nfloor rather than noise -- but that is a HYPOTHESIS from n=1 at the low end, not a finding.\n\nDoes NOT close AC5. Still missing the two measurements that need on-box data: steady-state\nper-container RSS, and the RSS-vs-ticket-size relationship. This sample is one more point\nfor the latter, not the curve.","timestamp":1788539461537978001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Live memory + MCP health, verified against AWS tonight (read-only)\n\n**MCP endpoint is healthy right now; the 502 is NOT currently reproducible.**\nRead-only probes (no gate started, nothing billable):\n- `GET /mcp` -> **401** in 0.27s. 401 is the CORRECT healthy code per observability.sh §1b: only\n  the app's auth middleware can produce it, so it proves the whole TLS -> nginx -> upstream -> app\n  path.\n- `POST /mcp` JSON-RPC initialize (unauth) -> 401. `GET /review/health` -> 200.\n  `GET /config/server/version` -> 200, Gerrit 3.14.1. TLS valid to 2026-11-27.\n- `rebar/host:mcp_healthy` = **1.0 on all 259 datapoints over 24h — zero unhealthy ticks.**\n- Alarm `rebar-mcp-serving-path-down` is live, `treat_missing_data=breaching`, OK.\n\nNo attempt was made to reproduce by starting an async gate: the confirmed root cause is a kernel\nOOM-kill of the MCP container mid-gate, and reproducing it requires real concurrent gate load.\nSo \"not reproducible right now\" is NOT \"structurally prevented\".\n\n## AC5 data: live memory numbers\n\n`mem_available_percent` ranged **27-60%** over 3 days, with `mem_probe_ok`=1 throughout — so\nthese are measured, not defaulted. 27% available on 8 GiB is roughly **2.2 GiB free**.\n\nThat is consistent with the oversubscription arithmetic already on this ticket (~10 concurrent\nreviews x ~739 MB + ~2.17 GB steady state ~= 9.6 GB demand against an 8 GiB host). It does not\nclose AC5 — still missing steady-state PER-CONTAINER RSS and the RSS-vs-ticket-size relationship,\nboth of which need on-box data this read-only sweep could not gather.\n\n## A gap worth naming: there is still NO memory alarm\n\n`mem_available_percent` is **measurement-only**. Nothing pages on it. Given that the confirmed\nroot cause of this bug is an OOM kill, and given the host runs at 27-60% available with a\ndemand model that exceeds capacity, the absence of a memory alarm means the next OOM will again\nbe discovered by its consequences rather than announced.\n\nTwo live corroborating signals: `deploy_deferrals` ran to **69 in 24h** — the autodeploy path\ncorrectly declining to kill in-flight reviews, healthy behaviour but strong contention evidence;\nand `rebar-autodeploy-mcp-mem-abort` exists and is correctly `breaching`, which shows the memory\nDIMENSION is already considered alarm-worthy elsewhere in the stack.\n\n## The nginx failover gap is deferred, not fixed\n\nRecording it here so a future reader does not mistake current health for resolution: nginx's\n`upstream rebar_mcp` has a single `server` with no failover, so a recurrence of the OOM would\nstill 502 until a redeploy. The difference from 2026-09-02 is detection latency, not prevention —\n`rebar-mcp-serving-path-down` would now page within ~15 minutes instead of a human noticing 12\nhours later. AC1 (detection) and AC3 (retire sweep) are live and verified; the underlying memory\noversubscription is explicitly deferred pending AC5.\n\n## Unrelated durability observation\n\nThere is **no CloudWatch log group for the rebar Gerrit host** — its logs live only in on-box\njournald and are lost with the host. During the 09-02 outage there was consequently no off-box\nlog record. Not an error and not in this ticket's scope, but it is the reason post-incident\nforensics were limited to what the host still held.","timestamp":1788546380501981001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"2026-09-04 recurrence during lettered-depressing-willet audit: MCP search/show/list initially succeeded, then a three-ticket show batch failed with Transport closed / nginx HTTP 502. An immediate single-call MCP retry also returned HTTP 502. The local checkout CLI remained functional and became the tracker fallback. This confirms the serving-path failure can recur during ordinary tracker reads, not only after this client starts an async gate.","timestamp":1788555100967917001}],"created_at":1788411304995986001,"creation_channel":"cli","deps":[{"link_uuid":"6a7ad30c-7ec9-44b6-9fd0-f9d3a3c457af","relation":"discovered_from","target_id":"ee0c-1d25-1652-43c3"},{"link_uuid":"6262dffe-6792-4590-892f-a11b3d31e335","relation":"relates_to","target_id":"7142-ef53-0f73-40d5"},{"link_uuid":"17f80cee-060f-4caa-878b-81bb95ad3633","relation":"relates_to","target_id":"1950-d3dc-1a88-42ae"},{"link_uuid":"61b00be1-94a2-42b8-adf2-acdd692af19a","relation":"relates_to","target_id":"3f87-4ec6-dd46-4e87"},{"link_uuid":"8c57897e-7453-497f-a887-288a22a7697a","relation":"relates_to","target_id":"6b82-76cf-e825-4498"},{"link_uuid":"9effc97c-d2a4-436b-a973-dafb53c0a486","relation":"relates_to","target_id":"1f94-b1ae-be02-4777"},{"link_uuid":"708ff72e-a446-4c76-be9a-5da6ca5f2d28","relation":"relates_to","target_id":"3ef8-bccd-fc62-4b3e"},{"link_uuid":"d080fe9d-7baf-41bd-961c-982fe406dcab","relation":"relates_to","target_id":"223a-bcd7-090a-4eca"},{"link_uuid":"33426b1e-1a61-4592-b452-f69d9560522f","relation":"relates_to","target_id":"d8a3-ff71-8112-4e55"},{"link_uuid":"283f1b63-f088-4df2-928a-e289a5747ae3","relation":"relates_to","target_id":"1205-63b2-2c01-4e7f"}],"description":"## Observed\nOn 2026-09-02 the configured rebar MCP endpoint initially accepted tracker calls and started plan-review job 1788399093580353346-ab9badfce4eb4b45a6db70794296455e. A later status poll returned \"Transport closed\"; every subsequent rebar MCP call returned nginx HTTP 502. The local CLI remained functional.\n\n**Corrected from the original report:** the outage was not \"more than 20 minutes\". It ran ~18:31 PDT 09-02 to ~06:41 PDT 09-03 — about **12 hours**, with no self-recovery. A human reported it; nothing in the system could observe it.\n\n## Impact\nAgents cannot poll gate results, claim work, or perform tracker operations through the required MCP surface. Long gate state is ambiguous and restarting it risks duplicate billed work.\n\n## Root cause (confirmed on-box, read-only)\n1. The MCP container was **OOM-killed ~3 minutes into a plan-review gate run** — `docker inspect` reported `OOMKilled=true`, `Exit=137`, finished 18:36:51 PDT against a job started 18:31:33 PDT. Host is a t4g.large (8 GiB) shared with Gerrit, the review-bot and opcert.\n2. nginx's `upstream rebar_mcp` is a **single `server` line with no failover**, and still named the dead container's port, so every request 502'd while nginx itself stayed healthy.\n3. Recovery was structurally impossible: redeploy is the only path back, and every build failed on `uv required-version ==0.12.7 does not match 0.12.9` (split out as `febd-6b13-1976-43be`, now closed).\n4. `mcp_retire_sweep` reaped the exited-but-live container while nginx still pointed at its port, converting a transient crash into a permanent 502.\n\nRuled OUT: `mcp_mem_abort` and `mcp_retire_cap` both read 0.0 throughout. They are deploy-path markers, not observers of the serving process, so a kernel OOM-kill is invisible to them.\n\n## Reproduction\n1. Start an async plan review through MCP.\n2. Poll `gate_status` for its job handle.\n3. Observe transport closure followed by persistent HTTP 502 responses.\n\n## Acceptance Criteria\n\n- [x] AC1: an unhealthy MCP upstream is detected and reported with an actionable signal. Verified by `aws cloudwatch describe-alarms --alarm-names rebar-mcp-serving-path-down` showing the alarm live on metric `mcp_healthy`, and by `aws cloudwatch get-metric-statistics --namespace rebar/host --metric-name mcp_healthy` returning datapoints.\n- [x] AC2: a regression test covers loss of the MCP upstream. Verified by `python -m pytest tests/scripts/test_observability_mcp_health_9ea3.py -q`, which drives the real `observability.sh` against stubbed 502/timeout responses and asserts a `0` is published rather than nothing.\n- [x] AC3: a transient MCP crash can no longer become a permanent 502 via the retire sweep. Verified by `python -m pytest tests/scripts -k retire -q`, including a case that reproduces the incident signature (the sweep freeing the port nginx still names).\n- [ ] AC4: host and per-container memory, and peak RSS per gate run, are measured and queryable, so a memory limit or instance size can be chosen from data rather than guessed. Verified by `python -m pytest tests/scripts/test_observability_memory_9ea3.py tests/unit/test_gate_peak_rss_9ea3.py -q`, and post-deploy by `aws cloudwatch get-metric-statistics --namespace rebar/host --metric-name mem_available_percent` returning datapoints and a `GATE_PEAK_RSS` marker appearing in `journalctl` after a gate run.\n- [ ] AC5 [non-codebase]: the measurement campaign has produced the numbers the OOM decision needs — peak MCP RSS during a gate, steady-state RSS per container, and how RSS scales with ticket size. Verified by a comment on this ticket recording those figures.\n\n**Deliberately NOT in this ticket, per operator decision:** choosing a container `mem_limit`, an instance size, or a fan-out width. Every candidate value today is a guess; the decision waits on AC5's data. ADRs 0079 and 0104 explicitly decided against upsizing to t4g.xlarge, and `3276`'s operator-approved principle — growing a resource is an unwedge, not a fix — applies identically. Moving gate execution off-box is the honest end-state and is epic-sized.\n\n## Testing\n\n- `python -m pytest tests/scripts/test_observability_mcp_health_9ea3.py -q` — the serving-path probe.\n- `python -m pytest tests/scripts/test_observability_memory_9ea3.py tests/unit/test_gate_peak_rss_9ea3.py -q` — the memory instrumentation.\n- `python -m pytest tests/scripts -q` — the full shell-probe suite.\n- `python -m pytest tests/unit/test_alarm_actions_terraform.py -q` — the alarm guards, including the AWS description-length limit.\n- `make lint && make typecheck`.\n- Post-deploy: `aws cloudwatch describe-alarms --alarm-names rebar-mcp-serving-path-down` and `get-metric-statistics` on `mcp_healthy`, `mem_available_percent` and `container_memory_rss_bytes`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/scripts/observability.sh","reason":"new section 2c: publish mem_available_percent / mem_used_percent / mem_probe_ok as dimensionless host gauges from `free -k` column 7 (available, not free), plus container_memory_rss_bytes per container and container_stats_ok, with docker stats bounded by --no-stream and timeout so it cannot wedge the 5-minute timer"},{"path":"src/rebar/llm/peak_rss.py","reason":"NEW: emit a GATE_PEAK_RSS journald marker at gate completion carrying peak_rss_bytes and peak_delta_bytes; ru_maxrss_to_bytes is a pure function because the unit differs by platform (bytes on darwin, KiB on Linux). A marker rather than metric plumbing because the containers deliberately hold no AWS credentials"},{"path":"src/rebar/llm/plan_review/__init__.py","reason":"wrap the review_plan library entry point, the seam both the MCP daemon-thread path and the CLI reach the gate through"},{"path":"src/rebar/llm/completion.py","reason":"same wrap for verify_completion; emitted from a finally so a run that DIES (the OOM case this exists for) still reports"},{"path":"tests/scripts/test_observability_memory_9ea3.py","reason":"the oracle for the shell probe: publishes on failure paths rather than nothing, reads `available` not `free`, and docker stats is bounded (proven by hanging the stub for 300s)"},{"path":"tests/unit/test_gate_peak_rss_9ea3.py","reason":"the oracle for the marker: emitted from finally, correct unit handling per platform, and the f829 rule that the logger copy omits the token"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","1205-63b2-2c01-4e7f"],["relates_to","1950-d3dc-1a88-42ae"],["relates_to","1f94-b1ae-be02-4777"],["relates_to","223a-bcd7-090a-4eca"],["relates_to","3ef8-bccd-fc62-4b3e"],["relates_to","3f87-4ec6-dd46-4e87"],["relates_to","6b82-76cf-e825-4498"],["relates_to","7142-ef53-0f73-40d5"],["relates_to","d8a3-ff71-8112-4e55"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"9f9a407a-1e5d-4fcf-8665-e5566c16db9d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":["bug","mcp","availability","ops"],"ticket_id":"9ea3-7d07-ea55-4496","ticket_type":"bug","title":"Configured rebar MCP endpoint returns persistent HTTP 502 after async gate start","verify_commands":[]},"source_event_uuids":["90c59037-53bd-423e-a1fc-899aa424aa2a","d4262967-cc00-438d-9c71-8ed8a9e5fbd6","9dde8e12-29db-498b-95ce-47549000a7a5","ed178f76-0f2e-4fd5-992e-c2019efb3de4","d080fe9d-7baf-41bd-961c-982fe406dcab","7698fc30-9807-4d03-890a-de7785908afb","5fe59b23-84e3-43e4-97c8-a6eb3e4cede5","1b3963c9-f510-4899-8cdf-7415ccc3e29d","342652d6-4d67-4cbb-84c2-6ad4dbd12b65","33426b1e-1a61-4592-b452-f69d9560522f","283f1b63-f088-4df2-928a-e289a5747ae3"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788568195577497801,"uuid":"fa0a7169-e0f4-4788-9e7d-ed6c9bf9a595"}