{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788467933041742055,"compiled_state":{"alias":"witted-invisible-roan","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"28a6d8a82b54f826d9fca8c80c7b06daaac5d1e9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 9ea3-7d07-ea55-4496","material: 77140b3e2e49e6d7","material-part: children 647ea2107ca5072f 0","material-part: description c08e3b64241bfa0a 4763","material-part: description_boxes 038dfdbe3832f4b1 3","material-part: file_impact b74d16d365d60cfb 6","material-part: ticket_id 9c69fa8ebfea1346 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (cdfd7d94dc-dirty)","regver: aa61189569d34126","verified-at-sha:31a37c1223411a836edabdea11d87d839264cd74","dep 09b0fac55e7ad5a96e41848d82840632363caee4906ad2c9ce1b583624ec7448 infra/scripts/observability.sh","dep 3df4302b917f02fef2c95fced2004b42bcefd9a857c4961ae66a0e577ba8110a src/rebar/llm/completion.py","dep absent src/rebar/llm/peak_rss.py","dep c7667659047fa8a545b5219d3f121c2173eb2cf48fcc3b25c2dfcb0e27efabeb src/rebar/llm/plan_review/__init__.py","dep absent tests/scripts/test_observability_memory_9ea3.py","dep absent tests/unit/test_gate_peak_rss_9ea3.py","read-set: 11","read-path: docs/adr/0079-autodeploy-on-box-timer.md","read-path: docs/adr/0104-mcp-on-box.md","read-path: infra/nginx/mcp-upstream.conf","read-path: infra/nginx/rebar.conf.template","read-path: infra/scripts/autodeploy.sh","read-path: infra/scripts/observability.sh","read-path: infra/terraform/monitoring.tf","read-path: infra/terraform/monitoring_9ea3.tf","read-path: infra/terraform/versions.tf","read-path: tests/scripts/test_autodeploy_mcp_bluegreen.py","read-path: tests/scripts/test_observability_mcp_health_9ea3.py","currency-basis: file_impact"],"material_fingerprint":"77140b3e2e49e6d7","merged_log_commit":"31a37c1223411a836edabdea11d87d839264cd74","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788465769141732000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":22,"unsigned":0},"authorship_ledger":[{"content_hash":"64f4a98ee71f08fe9d92eacf99e535f7e766ab5c199ecf1050f6d7f2e80f859b","event_uuid":"d1484281-bfe9-4fad-a241-b1b738ad16a1","position":{"commit_sha":"ebfd37ac2143f88df6aa48ecce9d205d89d0c51a","position":"1788417928346575001-d1484281-bfe9-4fad-a241-b1b738ad16a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"50c01555d1c5ef1f1e95737b52ee52ea5cd643278b6b804555e585c738020871","event_uuid":"6262dffe-6792-4590-892f-a11b3d31e335","position":{"commit_sha":"f30cdae039ed053aa3e55e4df757c42546ebc410","position":"1788419877301976723-6262dffe-6792-4590-892f-a11b3d31e335"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a21abd206f22f4fc17086d242822ccf84cd52823e41929a17f371c519e458199","event_uuid":"1d6f44d1-dec8-482d-b469-2fe57b2da436","position":{"commit_sha":"b84ddb9ab751