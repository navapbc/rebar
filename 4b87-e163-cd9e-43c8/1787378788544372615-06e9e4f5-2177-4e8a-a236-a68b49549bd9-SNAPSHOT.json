{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787378788544372615,"compiled_state":{"alias":"equivalent-unpacified-loris","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4d8b3f222f1a3a80d42f4675c3aee2059d578e49","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 4b87-e163-cd9e-43c8","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (4d8b3f222f)","material: 40f59f78910609bd","verified-at-sha:4d8b3f222f1a3a80d42f4675c3aee2059d578e49"],"material_fingerprint":"40f59f78910609bd","merged_log_commit":"4d8b3f222f1a3a80d42f4675c3aee2059d578e49","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787371171598855000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"e422395a18bee8fa74b596a8d55ddbe5508585a9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4b87-e163-cd9e-43c8","material: 40f59f78910609bd","material-part: children 647ea2107ca5072f 0","material-part: description f67aa518f99eba6a 5605","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 0dc0a7bb90846c95 4","material-part: ticket_id 03a24bb5df12bc7c 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.12.0 (e422395a18-dirty)","regver: aa61189569d34126","verified-at-sha:e422395a18bee8fa74b596a8d55ddbe5508585a9","dep 0600cb02b7afb683c4f4c7a852c0347a294118ff7550072a3fda8ae10e5f104d examples/agent-skills/rebar-brainstorm/test-design.md","dep 0600cb02b7afb683c4f4c7a852c0347a294118ff7550072a3fda8ae10e5f104d examples/agent-skills/rebar-debug/test-design.md","dep 0600cb02b7afb683c4f4c7a852c0347a294118ff7550072a3fda8ae10e5f104d examples/agent-skills/rebar-implement/test-design.md","dep 0600cb02b7afb683c4f4c7a852c0347a294118ff7550072a3fda8ae10e5f104d examples/agent-skills/shared/test-design.md","read-set: 7","read-path: examples/agent-skills/README.md","read-path: examples/agent-skills/rebar-debug/SKILL.md","read-path: examples/agent-skills/rebar-implement/SKILL.md","read-path: examples/agent-skills/shared/test-design.md","read-path: tests/unit/rebar_reconciler/diffing/test_comment_dedup_key_matches_send_fit.py","read-path: tests/unit/rebar_reconciler/test_dc_backend_characterization.py","read-path: tests/unit/test_skill_shared_sync.py","currency-basis: file_impact"],"material_fingerprint":"40f59f78910609bd","merged_log_commit":"e422395a18bee8fa74b596a8d55ddbe5508585a9","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787367292282976000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"12aed1b774ef2e22192aaa85d7d0381e8f39445d8e064d4012afbe1c8372032d","event_uuid":"ec0ab0f2-fae2-4d12-9c42-2c488f3691da","position":{"commit_sha":"5288b8d6996158cc23c8c9e5366fae647019d7af","position":"1787315713365190001-ec0ab0f2-fae2-4d12-9c42-2c488f3691da"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRB