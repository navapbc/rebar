v lint. The independent matrix, not exact prose matching, judges semantic preservation.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":".github/llm-providers/anthropic.toml","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":".github/llm-providers/bedrock.toml","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":".github/llm-providers/openai.toml","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","49ac-d7e5-f383-4d7f"],["relates_to","0c9c-9824-5745-42f6"],["relates_to","277b-1310-b7af-4adc"]],"no_file_impact_reason":"","parent_id":"49ac-d7e5-f383-4d7f","parent_status_uuid":"ed074529-3167-4b97-9406-48e7f0d4ff2f","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"closed","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"aacb-cceb-01e9-46b3","ticket_type":"task","title":"Condense comments in .github/llm-providers","verify_commands":[{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^\\([[:space:]]*#[^!].*\\|[[:space:]]*#[[:space:]]*\\|[[:space:]]*;.*\\|[[:space:]]*<!--.*\\|[[:space:]]*.*-->\\|[[:space:]]*\\)$\" HEAD^ HEAD -- .github/llm-providers/anthropic.toml .github/llm-providers/bedrock.toml .github/llm-providers/openai.toml","dd_id":"preserve-provider-data","dd_text":"Prove the leaf commit changes only standalone comments or blank lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_ci_provider_matrix.py tests/unit/test_structured_matrix_scorer.py tests/unit/test_project_default_provider.py tests/unit/test_reviewbot_bedrock_cutover.py","dd_id":"provider-contracts","dd_text":"Exercise external and structured-output provider matrices, default selection