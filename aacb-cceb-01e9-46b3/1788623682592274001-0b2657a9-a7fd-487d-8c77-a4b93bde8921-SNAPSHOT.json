t+bot@navapbc.com"},{"content_hash":"3ee3b91d6c1ab04ae6ad673fa085fb7dbc379440850dcfae84cab988679f8bd4","event_uuid":"da4a287c-2b53-4cbe-876e-6c54392f0e9f","position":{"commit_sha":"fa22f39f1c31a45a939dcee8b5d0c4a18699f9c2","position":"1788609482383104001-da4a287c-2b53-4cbe-876e-6c54392f0e9f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"34af54f9209ebaf9d9f58387ceb1e10766a0a711009e9b047723ace44f15a6c7","event_uuid":"4440dd45-7164-4832-b1a7-4eccd33147f4","position":{"commit_sha":"13a141bae3b9bd71a98afc786e2d11a72a8c6b4f","position":"1788617973495584001-4440dd45-7164-4832-b1a7-4eccd33147f4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788570398539940975,"creation_channel":"mcp","deps":[{"link_uuid":"aca1ef81-ac96-45fc-8c6e-e5ddeca5eb7b","relation":"supersedes","target_id":"85fe-72d9-4cb1-422e"},{"link_uuid":"13cd2aef-5d0b-4642-bf9b-064082f7442f","relation":"supersedes","target_id":"8e84-6667-b4d3-441a"},{"link_uuid":"426f8800-0d78-4319-9b4c-d4110d40280d","relation":"supersedes","target_id":"0478-6166-5e05-447e"}],"description":"## Context / Problem\nThe three provider overlays contain repeated or historical comments identified by the audit and revalidated on `origin/main` at `0033662b5534531d84e39d4a14bf75c8e768e85e`. Shortening them must preserve provider selection, cross-provider comparability, and credential isolation.\n\n## Approach\nEdit only standalone comments and blank lines in the declared TOML files. Preserve configuration values byte-for-byte and retain the minimum current rationale needed by external-test operators.\n\n## Scope\n- `anthropic.toml` — Preserve explicit config-file-path coverage, credential name, provider-qualified `[llm] model`, and all three model-class slots so ambient provider defaults cannot leak in.\n- `bedrock.toml` — Preserve same-Claude-family cross-provider comparability; inference-profile-only IDs with nonuniform suffixes; verbatim AWS discovery; region and ambient-AWS credentials; provider-qualified scalar model plus every class slot; and matrix-only Anthropic-key blanking.\n- `openai.toml` — Preserve best-effort support tier, credential, verified models, provider-qualified scalar model, and every class slot.\n\nConsumers are `src/rebar/_config_sources.py` plus the LLM config/class resolver; `.github/workflows/external-integration.yml`; `.github/workflows/structured-output-baseline.yml`; `.github/workflows/jira-dc-richtext-probe.yml` for the Anthropic overlay; the `rebar.toml` and Compose Bedrock pins; and provider/config pin tests. Workflow prose is owned by `sphalerite-bereft-tortoise`; the stale provider README is tracked by `wearied-convincing-arrowana`.\n## Acceptance Criteria\n- [ ] The leaf commit changes only the permitted comments/docstrings or blank lines in the declared files; executable/configuration data and exact behavior-bearing directives remain unchanged.\n- [ ] Every Scope constraint and consumer contract has a PASS row with concrete before/after citations in a leaf-linked TSV semantic matrix authored by a reviewer who did not write the remediation.\n- [ ] Every edited block has an independent `bloat-removal` PASS row confirming that redundant, obvious, duplicated, stale, or historical prose was removed while current rationale remained.\n- [ ] Recorded focused checks, path-scoped `git diff --check`, and repository lint pass at the leaf commit.\n- [ ] Missing or FAIL semantic rows block closure.\n\n## Verification\nRun the recorded content-only guards, focused checks, path-scoped diff check, and worktree-venv lint. The independent matrix, not exact prose matching, judges semantic preservation.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":".github/llm-providers/anthropic.toml","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":".github/llm-providers/bedrock.toml","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":".github/llm-providers/openai.toml","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","49ac-d7e5-f383-4d7f"]],"no_file_impact_reason":"","parent_id":"49ac-d7e5-f383-4d7f","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"aacb-cceb-01e9-46b3","ticket_type":"task","title":"Condense comments in .github/llm-providers","verify_commands":[{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^\\([[:space:]]*#[^!].*\\|[[:space:]]*#[[:space:]]*\\|[[:space:]]*;.*\\|[[:space:]]*<!--.*\\|[[:space:]]*.*-->\\|[[:space:]]*\\)$\" HEAD^ HEAD -- .github/llm-providers/anthropic.toml .github/llm-providers/bedrock.toml .github/llm-providers/openai.toml","dd_id":"preserve-provider-data","dd_text":"Prove the leaf commit changes only standalone comments or blank lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_ci_provider_matrix.py tests/unit/test_structured_matrix_scorer.py tests/unit/test_project_default_provider.py tests/unit/test_reviewbot_bedrock_cutover.py","dd_id":"provider-contracts","dd_text":"Exercise external and structured-output provider matrices, default selection, and Bedrock coupling."},{"command":"rtk git diff --check HEAD^ HEAD -- .github/llm-providers/anthropic.toml .github/llm-providers/bedrock.toml .github/llm-providers/openai.toml","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"Run repository lint and policy gates."}]},"source_event_uuids":["ae019b09-bc37-49bc-a193-b334d78a681b","b3b517b7-3c5e-49ea-a5da-68fbe995c522","c0b0926d-374d-4744-95bc-6a64d487bdba","661e24bd-351e-4962-8bdb-ebee1a3d5b64","ecb8f8f0-8533-42b7-aef3-52a588dbff4e","80f2b56e-1cac-45b1-8c02-65723491070e","eaa3b958-5834-48dc-9cd2-b43f8901862e","7639e83e-7088-4d16-a321-1bf44cfdb130","5e85034c-2f91-42d4-afde-1de84a2df1ef","fa21f47b-e5a6-4a2a-ac74-96ee0f222ccc","da4a287c-2b53-4cbe-876e-6c54392f0e9f","4440dd45-7164-4832-b1a7-4eccd33147f4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788623682592274001,"uuid":"0b2657a9-a7fd-487d-8c77-a4b93bde8921"}