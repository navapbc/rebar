{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c '\nimport ast, io, subprocess, tokenize\nfrom pathlib import Path\nB = \"d49fea41cc383dc70d465903e94598a6dc790bd1\"\nA = {\"src/rebar/_io/_cli.py\":[\"module\"],\"src/rebar/_io/_provenance.py\":[\"module\",\"_coerce_ns\",\"create_kwargs\"],\"src/rebar/_io/_strip.py\":[\"module\"],\"src/rebar/_io/import_ndjson.py\":[\"module\",\"_scan_existing_source_ids\",\"import_tickets\"]}\nTOKENS = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in A[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                qualified = f\"{prefix}.{child.name}\" if prefix else child.name\n                visit(child, qualified)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    found = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type != tokenize.COMMENT:\n            continue\n        body = tok.string[1:].lstrip()\n        if tok.string.startswith(\"#!\") or any(body.startswith(prefix) for prefix in TOKENS):\n            found.append(lines[tok.start[0] - 1])\n    return found\nfor path in A:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\n'","dd_id":"immutable-prose-only","dd_text":"Only allowlisted prose may change; after stripping those owner docstrings, base and final AST/runtime trees match, with only TypeIgnore.lineno normalized, and directive/shebang physical lines are identical."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess; expected=set([\"src/rebar/_io/_cli.py\",\"src/rebar/_io/_provenance.py\",\"src/rebar/_io/_strip.py\",\"src/rebar/_io/import_ndjson.py\"]); actual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":sorted(expected),\"actual\":sorted(actual)}'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/interfaces/io/test_export_ndjson.py tests/interfaces/io/test_import_ndjson.py tests/unit/io/test_strip_external.py tests/unit/test_c3b_push_defer_coupling_heldout.py tests/interfaces/contracts/test_operation_snapshot_authoritative_binding.py","dd_id":"focused-contracts","dd_text":"Focused tests for every preserved subsystem contract pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_io/_cli.py src/rebar/_io/_provenance.py src/rebar/_io/_strip.py src/rebar/_io/import_ndjson.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"VERIFY_COMMANDS","timestamp":1788621366086412221,"uuid":"4396e145-8d08-4178-a8a5-d3ae1184044a"}