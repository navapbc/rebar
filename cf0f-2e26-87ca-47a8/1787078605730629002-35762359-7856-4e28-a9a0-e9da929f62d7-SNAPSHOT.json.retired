{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787078605730629002,"compiled_state":{"alias":"callous-amused-hart","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: cf0f-2e26-87ca-47a8","material: a37f205b83a59b9d","material-part: children 647ea2107ca5072f 0","material-part: description 8201d74ecbc60c02 1936","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact e90a9affddc676f0 2","material-part: ticket_id e7816cbafa69ddd1 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.12.0 (5b5008bbfb)","regver: 1da3feeb7c09e17f","verified-at-sha:5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","dep 010123940f603c855d7fda91e8c7663d1d12209f80b42f1e7221d0ba198a25a6 tests/_isolation.py","dep 69f784b27db730558ac49b6607b98827124c81b5d34438aa0413e1db6eac8508 tests/unit/test_repo_isolation_guard.py","read-set: 4","read-path: tests/_isolation.py","read-path: tests/conftest.py","read-path: tests/unit/test_git_timeout_bounds_77e1.py","read-path: tests/unit/test_repo_isolation_guard.py","currency-basis: file_impact"],"material_fingerprint":"a37f205b83a59b9d","merged_log_commit":"5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787028368561017000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"2828035717ef2a05e99873df3b8dae4421050532e1db2436bbe31e447e377296","event_uuid":"75312d45-36da-41aa-ae34-34b3275399d0","position":{"commit_sha":"cbecfce2988e0c5388a520b0f981a5deeb56fba2","position":"1787027995311488001-75312d45-36da-41aa-ae34-34b3275399d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1735197a46a3f279285b9bd731eb66e4e7090c7469e09367e0fbb0c222c3086f","event_uuid":"074f678c-168a-4777-a04b-30e6ba51b14d","position":{"commit_sha":"68b6d1b0a3f2113dd4929fbba4508c952a112542","position":"1787028001208267001-074f678c-168a-4777-a04b-30e6ba51b14d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"85546502eb4a0bb5138b0f60e2558e52e643fb1862b32a49a0417dc0f5b634d6","event_uuid":"270c29db-e5bf-4a4c-bb7d-9aea87a5eca8","position":{"commit_sha":"348dfcacb8cc513f16f79ce2b6367e5d6154a06f","position":"1787028206231352001-270c29db-e5bf-4a4c-bb7d-9aea87a5eca8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4b7cddb3d93bedd06201e6c292411e50b097eee06cd6a5b781f0a9f900c97976","event_uuid":"6a1b67f7-783d-49af-8a14-67853c46cdd1","position":{"commit_sha":"ee1e17a302191a761f878a9475bd6759d4311caf","position":"1787028368564056001-6a1