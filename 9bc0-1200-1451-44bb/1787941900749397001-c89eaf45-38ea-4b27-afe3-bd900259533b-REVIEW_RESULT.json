ted_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"broken_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify where the persistent-pressure counter is stored between autodeploy.sh invocations (e.g. a marker/state file) and its fail-safe behavior when the store is absent or unreadable.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e"],"criteria":["E2","T5b"],"decision":"advisory","decision_margin":-0.0137,"drop_reason":null,"evidence":["'a persistent-pressure counter increments; it resets to zero once the disk falls below the threshold'","'across 3 or more reclaim cycles' — cycles are separate throttled invocations (PRESSURE_PRUNE_MIN_INTERVAL 600s), so the count cannot live in process memory","Plan does not name a marker file / state file for the counter"],"finding":"The persistent-pressure counter must survive between separate autodeploy.sh invocations (the reclaim gate runs periodically as distinct processes), but the plan does not specify where/how the counter is persisted or how it fails safe if the store is missing/corrupt.","group_criteria":null,"group_id":null,"id":"fc3166c3931015bdf","impact":0.67,"is_primary":null,"location":"Scope item 3 / AC4 / AC5","norm_id":"n875f3803e2b2c1ca","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["autodeploy.sh runs as a fresh process each cycle and the in-memory counter would be lost, never reaching 3","The state file is deleted or unreadable and the counter silently never fires the persistence marker"],"severity":"major","suggested_fix":"State that the counter is persisted to a state file alongside the existing AUTODEPLOY_DISK_PRESSURE marker, initialized to 0 when absent, and incremented/reset per cycle based on the post-reclaim disk reading.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"State whether orphaned rebar-mcp-<sha> tags (containers already reaped, or reaped in a crash window before image rm) are in scope, or explicitly accept them as residue and justify why the retire-path-only reclaim is sufficient given the incident backlog was cleared manually.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.1111,"drop_reason":null,"evidence":["Plan: 'removing the corresponding rebar-mcp-<sha> tag be