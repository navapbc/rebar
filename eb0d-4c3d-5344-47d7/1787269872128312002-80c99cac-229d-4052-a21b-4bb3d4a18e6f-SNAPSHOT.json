XaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9cd0621071da193178899f6b35359c830f261deadc00851e1f97d3a29cbc1819","event_uuid":"9b342ff6-4ed3-43d2-8873-4e276f38282c","position":{"commit_sha":"5316c559572235d0f4ae2c235873a52b1b007b3a","position":"1787269589962287001-9b342ff6-4ed3-43d2-8873-4e276f38282c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c5fef6bdd6eec4263eb8194d95160338e21afdf76bd0a396946d8f68b9a33173","event_uuid":"445883a3-fd1f-4c28-a589-d8d27ee2a290","position":{"commit_sha":"9fa99d1b2996e3a1e3894d0ac63d3fa536979128","position":"1787269858275291001-445883a3-fd1f-4c28-a589-d8d27ee2a290"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9a0239e4ba9db2522c50d6cbd0670671ba9675169f8551c5ff50ae6a2a9bc562","event_uuid":"91b258e7-ffa2-4cbb-b379-1efe90366613","position":{"commit_sha":"04394cca095217b65d513df67931526b39da50aa","position":"1787269872128312001-91b258e7-ffa2-4cbb-b379-1efe90366613"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Completion evidence (all codebase-verified; landed in Gerrit change 1969 -> origin/main 695cab7b0c):\n\nAC1 (every core _dispatch_* routes through a Route.parser_factory; no parallel imperative grammar; metrics excluded): src/rebar/_cli/_parsers/core/ adds 14 family modules with one build_<name>(*, prog) factory per command; _registry.py wires parser_factory onto all 49 core Routes; handlers parse through the factory. In-tree oracle tests/unit/test_core_cli_parsers.py registry-completeness test asserts the exact 49-name core set each carries a parser_factory. metrics untouched (S2c). resolve_accepted removed (0 refs in src/).\n\nAC2 (accepted/rejected argv matrices: missing/surplus values, space/equal options, --, global output extraction, per-family unknown-token skip vs reject-exit-2, malformed input): held-out parity oracle (49 commands x 9-variant battery incl --help, -h, --nonexistent-flag-xyz, empty, surplus-args, --output bogus, --output=bogus, --, and bare dash) GREEN 49/49; 7 structural checks GREEN; total 56/56 byte-exact vs pre-migration golden.\n\nAC3 (persisted effects, no-effect refusals, diagnostics, streams, exit codes: no unapproved delta via real production-path tests): held-out parity captures real subprocess stdout/stderr/exit per variant; existing interface suites (tests/interfaces/facades + lifecycle exit-code conformance) 817 passed; full CI suite green on PS2 (run 32427234163), all 3 ubuntu + macos pytest jobs.\n\nAC4 (parser construction imports no domain executor/optional dep; selected execution resolves no unrelated factory/handler; construction-exclusion probe + dispatch-isolation assertion): in-tree oracle includes 5 dispatch-isolation spy tests + a construction-exclusion poison-probe; 70/70 pass.\n\nAC5 (module-size/complexity policy; each family revertable as one unit): largest touched file composer.py 782 LOC (<800 cap); module-size gate green in CI; complexity ratchet regenerated shrink-only (--update-stale: active=49 new=0 increased=0 stale=0), test_complexity_baseline green on PS2; each family = its parser module + one _registry.py wiring line + its _dispatch_* switch (self-contained hunk, no cross-family coupling).","timestamp":1787269858275291001}],"created_at":1787070476629784001,"creation_channel":"cli","deps":[{"link_uuid":"1a10e5f1-7618-47bb-892d-00c1f00c6528","relation":"depends_on","target_id":"b2ff-03f7-a223-4900"},{"link_uuid":"091fe7de-e3f8-4f6f-9646-db00eecb8dbd","relation":"relates_to","target_id":"b06c-04a9-52b2-42fe"},{"link_uuid":"d1deed2f-c3ac-4b75-b4de-c30c61c5cf08","relation":"relates_to","target_id":"743a-8227-ea97-46a2"},{"link_uuid":"537031ea-1acb-4d52-85b6-55acfe614452","relation":"relates_to","target_id":"7780-f1c3-17c7-4fe0"}],"description":"## Context / Problem\nMost core ticket, store, read/write, config, import/export, maintenance, and gate commands parse argv imperatively. Adding docs-only argparse definitions would create the duplicate grammar RP-05 is meant to eliminate.\n\n## Approach\nInventory every registered core grammar owned by `src/rebar/_commands/`, `src/rebar/_engine_support/`, and `src/rebar/_io/`, PLUS the two consumers that make a migrated grammar live: the per-`Route` `parser_factory` field in `src/rebar/_cli/_registry.py` (core Routes in `_reads_init_only`/`_simple_read_groups`/`_lifecycle`/`_writes_full`/`_bridge_and_arms` currently carry NO `parser_factory`; only advanced/intercept routes set it) and the runtime handler switch in `src/rebar/_cli/__init__.py` (the `_dispatch_*` family, which selects and invokes each command's handler). For each command:\n\n1. Capture current production-path positive, negative, boundary, surplus/missing argument, option-space/equal, global-output, and `--` behavior from existing tests and focused additions.\n2. Move the grammar into a side-effect-free factory in the new `src/rebar/_cli/_parsers/core/` package using the S2a argparse contract, extracting shared argument-definition helpers where canonical and compatibility forms overlap.\n3. Switch the runtime handler to parse with that same factory in the same change, wiring the `parser_factory` reference onto the command's core `Route` in `_registry.py` and routing its `_dispatch_*` handler through that factory. Keep domain execution and initialization outside the parser module.\n4. Preserve command-specific diagnostic text, stdout/stderr, and exit codes through the shared parser seam; do not accept an option merely because argparse can parse it.\n5. Register the parser reference and prove only the selected parser/handler is resolved during execution (assert via a real production-path invocation that no unrelated parser factory or handler is constructed).\n\nCover the leaf positional registry, reads/lookups/gates, create/edit/lifecycle, compaction/fsck/doctor/maintenance, config, import/export, identity-adjacent core store commands, and static reads. EXCLUDE `metrics`: its route already carries `parser_factory=\"rebar._cli._parsers.advanced.metrics:build\"` from S2c and is out of scope here (re-migrating it is forbidden). Split files only along existing command-family call graphs and respect module-size rules.\n\n### Router global-flag/end-of-options seam (layering)\nThe router-level global extraction (`--output`/`-o`, `--quiet`, `--allow-secret-pattern`, applied to the pre-`--` segment only) runs in `_cli/__init__.py` BEFORE the per-command factory sees argv, exactly as today. Per-command factories parse only the command-local tail after that extraction; this ordering is invariant and no factory re-declares a global flag.\n\n### Unknown-token semantics (per-family, preserved)\nCore families currently have OPPOSITE unknown-token behavior: some parse via `parse_known_args` (silently skipping unknown tokens) while the positional-only leaf registry REJECTS stray option tokens with exit 2. Stock argparse reproduces neither by default. Each migrated factory MUST preserve its own family's pre-migration unknown-token semantics (skip vs reject-with-exit-2), proven by a negative test per semantics class; a family's semantics is not silently normalized to argparse's default.\n\n## Compatibility and Rollback\nNo help cutover occurs here. Accepted grammar and execution behavior are invariant unless this ticket records and receives approval for a specific delta. A parser family, its `Route` `parser_factory` wiring, and its handler switch are ONE revertable unit; no stored data changes.\n\n## Testing\nUse the smallest production path crossing each parser. Pure parser tables may be unit-tested, but public oracles run real CLI subprocesses or existing interface tests and assert return code, exact relevant stream, parsed effect/persisted state, and unchanged state on refusal. Include nearest controls and verify tests run under `make test`.\n\n## Acceptance Criteria\n- [x] Every registered core command runtime (its `_dispatch_*` handler) calls its S2a parser factory via a `parser_factory` reference wired onto its core `Route` in `_registry.py`; no parallel imperative grammar remains for that command. `metrics` is excluded (already migrated in S2c).\n- [x] Accepted/rejected argv matrices cover missing/surplus values, space/equal options, `--`, global confirmation/output extraction, per-family unknown-token semantics (skip vs reject-exit-2), and representative malformed input.\n- [x] Existing persisted effects, no-effect refusals, diagnostics, streams, and exit codes show no unapproved behavior delta, verified through real production-path (subprocess/interface) tests.\n- [x] Parser construction imports no domain executor or optional dependency, and a real selected execution resolves no unrelated parser factory or handler (proven by a construction-exclusion probe plus a dispatch-isolation assertion).\n- [x] All touched modules meet module-size/complexity policy, and each family is proven revertable as one unit (parser factory + `Route` wiring + handler switch) — demonstrated by confirming the family's parser module, its single `_registry.py` wiring line, and its `_dispatch_*` switch form one self-contained hunk with no cross-family coupling.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/_parsers/core/","reason":"Lean core command-family parser factories and shared argument definitions."},{"path":"src/rebar/_commands/","reason":"Switch core write/lifecycle/config/store handlers from imperative or inline parsing to shared factories."},{"path":"src/rebar/_engine_support/","reason":"Switch read/lookup/gate/validation handlers to shared factories."},{"path":"src/rebar/_io/_cli.py","reason":"Switch import/export runtime parsing to shared factories."},{"path":"tests/interfaces/facades/","reason":"Real CLI core argv, effect, stream, and exit-code parity matrices."},{"path":"tests/interfaces/contracts/","reason":"Core command grammar and output contract coverage."},{"path":"tests/unit/test_core_cli_parsers.py","reason":"Pure parser boundary and import-clean tests."},{"path":"src/rebar/_cli/_registry.py","reason":"Wire parser_factory references onto core command Routes (reads/lifecycle/writes/etc.)."},{"path":"src/rebar/_cli/__init__.py","reason":"Route core _dispatch_* handlers through their new parser factories; global-flag extraction seam unchanged."},{"path":".github/complexity-baseline.json","reason":"Shrink-only complexity ratchet update: the factory migration and inert-call removals lowered several core handlers below their frozen ceilings; refresh so the committed baseline stays stale-free (test_complexity_baseline)."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","b2ff-03f7-a223-4900"],["parent","2635-4aa3-5c14-4b12"],["relates_to","743a-8227-ea97-46a2"],["relates_to","7780-f1c3-17c7-4fe0"],["relates_to","b06c-04a9-52b2-42fe"]],"no_file_impact_reason":"","parent_id":"2635-4aa3-5c14-4b12","parent_status_uuid":"950c0f98-03a3-4581-872c-1514e7ec02fa","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["rp05","cli"],"ticket_id":"eb0d-4c3d-5344-47d7","ticket_type":"task","title":"RP-05 S2b — Migrate core command grammars to shared argparse factories","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_core_cli_parsers.py tests/interfaces/facades/test_cli.py tests/interfaces/facades/test_cli_space_form_options.py tests/interfaces/facades/test_leaf_writes_parity.py tests/interfaces/lifecycle/test_exit_codes_doc_conformance.py","dd_id":"AC1-AC4","dd_text":"Core shared-parser and real CLI argv/effect/stream/exit parity"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make lint && env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck","dd_id":"AC5","dd_text":"Core parser migration module-size, complexity, lint, and types"}]},"source_event_uuids":["ff7e983f-6a37-4f4b-8009-f984e284366f","bb404679-41b8-44a7-854a-665031080d2d","3f497240-555f-4cfc-a73a-46a5b8151b28","950c0f98-03a3-4581-872c-1514e7ec02fa","c0b6fe77-60be-4b74-b13a-f35d95a5b86c","091fe7de-e3f8-4f6f-9646-db00eecb8dbd","d1deed2f-c3ac-4b75-b4de-c30c61c5cf08","a24e3371-2a84-42b1-9bfa-bf04f257e52e","537031ea-1acb-4d52-85b6-55acfe614452","9b342ff6-4ed3-43d2-8873-4e276f38282c","445883a3-fd1f-4c28-a589-d8d27ee2a290","91b258e7-ffa2-4cbb-b379-1efe90366613"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787269872128312002,"uuid":"80c99cac-229d-4052-a21b-4bb3d4a18e6f"}