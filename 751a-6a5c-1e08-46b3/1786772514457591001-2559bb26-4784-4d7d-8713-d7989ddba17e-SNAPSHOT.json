: planning","rebar-version: 0.11.0 (9bcc2fba1b)","regver: 4f90349cd81c4911","verified-at-sha:9bcc2fba1b75379df444e70e46754bfd091eb9b4","currency-basis: fail-safe"],"material_fingerprint":"259d742d314d20dd","merged_log_commit":"9bcc2fba1b75379df444e70e46754bfd091eb9b4","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786754547539845000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":12,"unsigned":0},"authorship_ledger":[{"content_hash":"387eac777b4550effeb01098772197ba39558a864ea7d4ed165f572ede1572bf","event_uuid":"28e64d1b-720c-464d-9f72-3cf5d32d29d6","position":{"commit_sha":"09f43ec21c6a16dc53aad75379fc06797316783b","position":"1786754226863329001-28e64d1b-720c-464d-9f72-3cf5d32d29d6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"14b8f40ad7fc36575f9c81a9a47c2682a479d5d75f11d9ca479da7a74523e577","event_uuid":"efc40b7e-2fdb-412a-b0b7-a46747ba9ef8","position":{"commit_sha":"80756d9c6640d84c9682f0c11c146aa7bb96d404","position":"1786754248870857001-efc40b7e-2fdb-412a-b0b7-a46747ba9ef8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3471c21fd2f31c5e8040385e4f39ddedb3edd504a13a196bb0041f1897741696","event_uuid":"fd292f59-dc2f-46d3-b0b1-a4132e8c8363","position":{"commit_sha":"c2c8ea40a210e3afebc6737aea08cdd7e06b4e6b","position":"1786754547548225001-fd292f59-dc2f-46d3-b0b1-a4132e8c8363"},"signature":"{\"payload\": \"\", \