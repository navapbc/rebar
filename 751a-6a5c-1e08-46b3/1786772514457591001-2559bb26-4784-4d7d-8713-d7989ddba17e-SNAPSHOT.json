db1-a772a3bf0588"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d27783693de98e5ca65e5c8343024d7402e9c6581211e6ae34a49013edc3e954","event_uuid":"e305302f-1063-4a6a-8eaa-5a453e76b928","position":{"commit_sha":"b8ed5465623bfd04767431b9a498d072a1c6656f","position":"1786759924531004001-e305302f-1063-4a6a-8eaa-5a453e76b928"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2689ba7364b1ff37f7f57624f0d2b253e4ed511c7a076ff4944594cd1652ed02","event_uuid":"81003e67-c35e-4eb5-8458-34f7ccc30d85","position":{"commit_sha":"a3736c9d26e14b5d7f8ec43113f632e8b92161f1","position":"1786759928425771001-81003e67-c35e-4eb5-8458-34f7ccc30d85"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"regression","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Claimed and starting fix. Retarget decision: BOTH modules move to rebar.llm.review_code (the surviving op whose result contract is REVIEW_RESULT with runner/model/findings — matching each test's existing assertions). review_plan returns a PLAN_REVIEW_VERDICT (blocking/advisory/coaching, no top-level findings), so it cannot satisfy 'result.get(\"findings\") is not None' nor the schemas.REVIEW_RESULT + result['model'] assertions without gutting the tests. review_code is already proven live+pydantic_ai by the sibling test_pydantic_review_code in the same module. Plan: (1) test_pydantic_review_ticket_opus -> review_code on the frontier/opus model (enable REBAR_VERIFY_ENABLE_CODE_REVIEW so the real four-pass gate runs on pydantic_ai), preserving the opus param-handling intent + runner/model/findings asserts; (2) test_llm_trace.py -> review_code (capability enabled) so a real traced LLM run occurs and result.get('findings') stays assertable.","timestamp":1786754676654471001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed retarget to Gerrit: https://rebar.solutions.navateam.com/c/rebar/+/1800 (change 1800). Local validation: ruff check + format-check clean; typecheck gate (mypy src/rebar scripts) unaffected (tests/external not in scope); pytest --collect-only clean for both modules; and test_pydantic_review_code_opus PASSED live on the bedrock arm (REBAR_LLM_CONFIG_FILE=bedrock.toml, AWS_PROFILE=frontier-bedrock) in 60s — confirming opus param handling (no temperature 400) + runner==pydantic_ai + model==bedrock:us.anthropic.claude-opus-4-8 + findings list. The langfuse lane needs a Langfuse stack (absent locally, skips cleanly); the review_code findings path it depends on is exercised by the opus run. Awaiting LLM-Review +1 and Verified +1, then Submit + authoritative Live External Integration workflow_dispatch.","timestamp":1786755064566459001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RESOLVED — merged + validated.\n\nRCA: public rebar.llm.review_ticket() was removed pre-1.0 (-> review_plan/review_code); two tests/external live modules still called it and were missed by the removal epic (external tests excluded from the Verified gate), so 4 Live External Integration lanes died with 'AttributeError: module rebar.llm has no attribute review_ticket'.\n\nFIX (Gerrit change 1800, merged as d38eb1c7a1): retargeted BOTH call sites to review_code (surviving op returning REVIEW_RESULT with runner/model/findings), NOT review_plan (returns PLAN_REVIEW_VERDICT with no top-level findings, cannot satisfy either test's assertions).\n - test_pydantic_review_ticket_opus -> test_pydantic_review_code_opus: drives review_code on the frontier/opus model with the four-pass gate enabled (REBAR_VERIFY_ENABLE_CODE_REVIEW=1). Preserves the opus param-handling intent (no temperature 400 on a real pydantic_ai run) + runner/model/findings asserts (finalize stamps cfg.model/runner).\n - test_llm_trace.py: drives review_code (gate enabled, ticket-addressed) as the Langfuse OTLP trace vehicle; result.get('findings') is not None preserved unchanged.\n\nVALIDATION:\n - Gerrit: LLM-Review +1 (PASS) AND Verified +1 (CI run 31854837190 SUCCESS) -> submitted.\n - Authoritative live workflow_dispatch: https://github.com/navapbc/rebar/actions/runs/31856166064\n     * external LLM (live anthropic): GREEN  * external LLM (live openai): GREEN  * langfuse tracing round-trip: GREEN\n     * external LLM (live bedrock): RED — but on an UNRELATED test only: test_completion_banking_behavior_0707::test_dense_completion_banks_and_terminates_in_two_of_three_trials (completion-verifier bug: _observe_trial.observed_upsert() got unexpected kwarg 'evidence_sufficient'). 17 passed / 1 failed on that arm; ZERO 'review_ticket'/'no attribute' occurrences anywhere in the bedrock log -> the original regression is gone and my retargeted opus test is among the 17 passed. Filed as discovered bug ulcerative-confined-blacklemur (9c7c-4844-f53c-4eac), linked discovered_from.\n\nAC status: no review_ticket calls in tests/external (only doc/comment mentions remain); both modules retargeted to a surviving op with matching contracts; live lanes validate the retarget (3 LLM arms + langfuse green running the retargeted tests; the lone red arm is an unrelated pre-existing defect). Closing.","timestamp":1786757604914945001}],"created_at":1786754226863329001,"creation_channel":"cli","deps":[{"link_uuid":"efc40b7e-2fdb-412a-b0b7-a46747ba9ef8","relation":"discovered_from","target_id":"368f-f03e-a045-4377"},{"link_uuid":"7da9f627-7163-4111-a9b2-70acb3fe3ffe","relation":"relates_to","target_id":"757e-b67c-affd-4eca"}],"description":"## Summary\n\nThe \"Live External Integration\" workflow (external-integration.yml) has 4 failing job lanes —\n`external LLM (live anthropic)`, `external LLM (live openai)`, `external LLM (live bedrock)`,\nand `langfuse tracing round-trip` — all failing with:\n\n    AttributeError: module 'rebar.llm' has no attribute 'review_ticket'\n\n## Root cause (proven)\n\nThe public `rebar.llm.review_ticket()` API was REMOVED in a pre-1.0 breaking pass (deprecated\nv0.11.0, removed 2026-08-12; CHANGELOG.md:121, docs/release-notes.md:72 maps it ->\n`rebar.llm.review_plan()`). `rebar.llm` now exposes `review_plan` / `review_code`, no\n`review_ticket`. That removal epic's AC said \"the rest [of the 19 referencing test files] are\nretargeted to the surviving review-plan/engine paths\" — but TWO EXTERNAL live-test modules\nwere missed:\n\n- `tests/external/test_pydantic_ai_cutover_live.py:80` (`test_pydantic_review_ticket_opus`) —\n  run by the external-llm lanes via `pytest -m \"external and llm_live\" tests/external`.\n- `tests/external/test_llm_trace.py:151` — run by the langfuse lane via\n  `pytest -m external tests/external/test_llm_trace.py`.\n\nThese modules are marked `external` and are EXCLUDED from the standard Gerrit Verified gate\n(which collects+skips external tests), so the removal epic's `pytest` run never exercised them\nand the regression was invisible until a live `workflow_dispatch` run. Discovered during the\n368f Jira-DC harness live run (run 31853325667).\n\n## Fix is NOT a mechanical rename\n\nThe old call `llm.review_ticket(epic, \"ticket-quality\", repo_root=..., config=...)` differs\nfrom the replacement `review_plan(ticket_id, *, ref=None, source=None, repo_root=None,\nconfig=None, ...)`:\n- `review_plan` has NO positional `\"ticket-quality\"` graph-target-kind argument.\n- `review_plan` returns a `PLAN_REVIEW_VERDICT`, but both tests validate `schemas.REVIEW_RESULT`\n  and assert `result[\"runner\"]`, `result[\"model\"]`, `result[\"findings\"]`.\n\nSo retargeting requires an author decision (review_plan vs review_code) plus adapted\nassertions/schema. Both external modules must move to a surviving API with the correct result\ncontract, not a blind s/review_ticket/review_plan/.\n\n## Acceptance Criteria\n\n- [x] `grep -rn \"review_ticket\" tests/external` shows no call to the removed public API (the\n      surviving `operations._review_ticket_impl` engine symbol is a different thing and may stay).\n- [x] `test_pydantic_ai_cutover_live.py` and `test_llm_trace.py` are retargeted to a surviving\n      public op (`review_plan` or `review_code`) with assertions/schema matching that op's\n      actual result contract.\n- [x] A live `workflow_dispatch` of \"Live External Integration\" shows the `external LLM (*)`\n      and `langfuse tracing round-trip` lanes GREEN (or the retarget is validated equivalently).\n\n## Testing\n\n- `pytest -m \"external and llm_live\" tests/external` and\n  `pytest -m external tests/external/test_llm_trace.py` (require live LLM creds).\n- A `workflow_dispatch` of \"Live External Integration\" is the authoritative check.\n\n\n## Resolution evidence\n\n- Retargeted both modules to `rebar.llm.review_code` (surviving REVIEW_RESULT op) in Gerrit\n  change 1800, merged as `d38eb1c7a1`. `review_plan` was rejected — it returns a\n  PLAN_REVIEW_VERDICT with no top-level `findings`, so it cannot satisfy either test.\n- `grep -rn \"review_ticket\" tests/external` now returns only doc/comment mentions and a\n  cross-reference to `test_llm_live.test_live_review_ticket`; no call to the removed public API.\n- Verified live: `test_pydantic_review_code_opus` PASSED on the bedrock arm locally (60s), and\n  the authoritative workflow_dispatch run 31856166064 shows `external LLM (live anthropic)`,\n  `external LLM (live openai)`, and `langfuse tracing round-trip` GREEN — all running the\n  retargeted tests. ZERO `review_ticket`/`no attribute` errors on any arm (original regression\n  gone). The `external LLM (live bedrock)` arm's lone red is an UNRELATED completion-verifier\n  defect (`observed_upsert() got an unexpected keyword argument 'evidence_sufficient'` in\n  `test_completion_banking_behavior_0707`; 17 passed / 1 failed), filed as\n  `ulcerative-confined-blacklemur` (9c7c-4844-f53c-4eac) and linked `discovered_from`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","757e-b67c-affd-4eca"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e305302f-1063-4a6a-8eaa-5a453e76b928","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["ci","external-tests","regression"],"ticket_id":"751a-6a5c-1e08-46b3","ticket_type":"bug","title":"External live tests call removed rebar.llm.review_ticket -> 4 CI lanes fail","verify_commands":[]},"source_event_uuids":["28e64d1b-720c-464d-9f72-3cf5d32d29d6","efc40b7e-2fdb-412a-b0b7-a46747ba9ef8","fd292f59-dc2f-46d3-b0b1-a4132e8c8363","9f4f2628-4a1e-45ae-af98-0d50b446ec2f","80f6de90-6861-444a-b44a-7616b28914bf","fdfed56b-32a8-41dc-a9e3-a520657ad3d5","cccde0ae-0417-4a20-a22b-56f897ce1752","7da9f627-7163-4111-a9b2-70acb3fe3ffe","c62fbd99-f598-49b0-b360-5b24fe148772","46afc1d7-08e6-40c9-bdb1-a772a3bf0588","e305302f-1063-4a6a-8eaa-5a453e76b928","81003e67-c35e-4eb5-8458-34f7ccc30d85"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786772514457591001,"uuid":"2559bb26-4784-4d7d-8713-d7989ddba17e"}