bar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"07936bbb2d54eaa23fe50dbf6e6ffcc189c275f98dd4e8da62fb55973b722c5f","event_uuid":"0a51a889-c107-4bef-8e94-951a225a15c7","position":{"commit_sha":"88deecfe34b172fe66583fd311ddfec97f6d5d49","position":"1786326728820387001-0a51a889-c107-4bef-8e94-951a225a15c7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"PROVEN RCA (rebar-debug Phase 1, 2026-08-09)\n\nRoot cause: `material_basis()` canonicalizes the description but inserts operator free text `no_file_impact_reason` byte-for-byte whenever `file_impact_scope == \"none\"` (`src/rebar/llm/plan_review/material_diff.py:119-135`). `material_fingerprint()` then JSON-serializes and hashes that basis (`pass1.py:739-770`). The raw insertion is the first divergence; serialization only faithfully preserves it.\n\nDiscriminating runtime proof used a fixed `PlanContext` with scope=`none`, identical description/file impact/children, and changed only the reason. Baseline `docs only` => `1f987a8683504420`; trailing space => `bc423348886c26f3`; trailing newline => `54adef751fa61586`; leading blank line => `48965da49efade62`. At the exact gate seam, `plan_review_status()` reported `certified` for baseline and `stale-material` for each whitespace-only variant. `material_basis()` showed the only differing value was the raw nested reason. Normalizing only the reason in the experimental input with the existing `normalize_insignificant_whitespace()` restored the baseline fingerprint exactly. This confirms the raw-reason artifact and rejects a serializer defect.\n\nRivals rejected: (1) field-scope logic is not causal because scope remained `none` in every main trial; the separate scope control correctly removed the entire component for `paths`, which is a meaningful state change. (2) the legacy fallback does not originate the staleness: the default fingerprint already diverges before validity dispatch, and both legacy recomputations also preserve the reason raw and fail to match. (3) a broken normalizer is excluded: the same normalizer maps `docs only ` and `docs only\\n` to `docs only`; it simply is never applied at lines 129-134.\n\nSecurity negative controls remain material: interior double space (`docs  only`) => `51c2845a17a03ffc`; word change (`runtime only`) => `d0fa333084ea6672`; both produce `stale-material`. `normalize_insignificant_whitespace()` leaves both unchanged, so reusing it does not collapse meaningful reason edits. Existing 2be7/94a3/96d1 suites all pass today (58 tests), confirming this is an uncovered parity gap rather than a broken description fix.\n\nLegitimacy: defect/incomplete parity implementation. Parent `unspirited-polished-arcticfox` deliberately filed this sibling in its completed parity sweep. Its authoritative invariant is implemented and documented at `material_diff.py:65-82`, `pass1.py:742-755`, and `docs/plan-review-gate.md:455-479`: whitespace carrying no plan substance is normalized out, while meaningful material edits invalidate. The other free-text material field violates that invariant.\n\nCaller-dependency sweep: Serena + rg show `material_basis` feeds only `material_components` and `material_fingerprint`; the latter feeds review generation/snapshots and validity recomputation. Those consumers depend only on consistent current hashes and benefit from the correction. One real behavioral dependency must be preserved: `_legacy_material_ok` (`attest.py:645-670`) deliberately reproduces pre-330c raw and post-330c/pre-2be7 checkbox-only generations. Both must continue hashing the reason raw.\n\nAdditional compatibility finding: the fix creates a new historical boundary. A post-2be7/pre-reason-fix attestation was signed with canonical DESCRIPTION but raw REASON. For a signed trailing-space reason, the old-current hash is `bc423348886c26f3`, while both existing legacy candidates are `12e291cb05bacc64` because they also change description canonicalization. Neither can grandfather that unchanged attestation after reason normalization. Phase 2 must preserve this third generation explicitly (canonical description + raw reason), in addition to keeping pre-330c raw behavior.\n\nPhase 1 stops here; no source/test edit, claim, plan review, or transition was performed.","timestamp":1786297988392831001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation started from the signed plan: normalize boundary/trailing whitespace in no-file-impact reasons for current fingerprints, while retaining explicit raw-reason legacy candidates for all three historical description generations. Production code only; the held-out oracle remains untouched.","timestamp":1786299508883548001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"FINAL REBAR-DEBUG REPORT (2026-08-09)\n\nProblem: whitespace-only edits to `no_file_impact_reason` changed signed plan-review material and returned `stale-material`, contrary to the original whitespace-normalization invariant.\n\nProven root cause: `material_basis()` canonicalized the description but inserted the no-file-impact reason byte-for-byte for scope `none`; `material_fingerprint()` faithfully serialized and hashed that first divergence. Fixed-context runtime fingerprints split for `docs only`, `docs only `, `docs only\\n`, and `\\ndocs only`, while normalizing only the reason restored the baseline exactly. Scope/serializer/legacy-dispatch rivals were rejected. Authority: parent `unspirited-polished-arcticfox`, `material_diff.py` canonicalization contract, and `docs/plan-review-gate.md` material-staleness contract.\n\nTest: `tests/unit/plan_review/test_callous_reason_whitespace.py` is an in-process oracle through real material hashing and `compute_validity`, mocking only store/signature boundaries. Its final form was observed RED before the fix (4 expected failures: three unequal whitespace fingerprints plus a whitespace-only review reading stale; 6 controls passed). After the held-out production fix it was GREEN 10/10. Reintroducing the exact raw-reason insertion returned the same 4 failures; restoring the fix returned GREEN 10/10. The test asserts observable fingerprints/verdicts, so formatting/refactoring does not invalidate it.\n\nFix: Gerrit change 1565, merged as `b6c05c87b6b24b6bf66026e8589f54d810445562`. An independent `normalize_reason=True` switch now flows through `material_basis` -> `material_fingerprint` -> `current_material_fingerprint_impl`. Current reasons reuse `normalize_insignificant_whitespace`. `_legacy_material_ok` explicitly disables reason normalization in the pre-330c and post-330c/pre-2be7 candidates and adds the post-2be7/pre-fix canonical-description/raw-reason candidate.\n\nScope and safety: caller sweep found only fingerprint/component consumers; none depends behaviorally on cosmetic reason bytes. Historical byte-exact recomputation is preserved explicitly. This restores documented behavior, adds no dependency, weakens no test, and leaves all edited production modules below the 800-line limit. Local gates: held-out 10 passed; focused plan-review/legacy 185 passed; `make check` passed. Local `rebar review-code`: PASS, 0 findings; independent reviewer: APPROVE, 0 findings. Gerrit: `LLM-Review +1`, `Verified +1`; full CI matrix succeeded on Linux Python 3.11/3.12/3.13 and macOS Python 3.13, including default and integration tiers.\n\nSiblings/parity: construct sweep of the material basis found exactly two free-text fields: description and no-file-impact reason; both now use the same insignificant-whitespace canonicalizer, so no additional raw free-text sibling remains. Parity rule: current plan-review free text ignores only boundary/trailing whitespace while meaningful edits remain material. CLI review/status/gates, MCP `review_plan`, the library facade, automated close/review workflows, and both generation/validation directions all converge on the shared material basis; no MISSING surface.\n\nReplication: the original scenario now certifies for trailing/boundary whitespace variants. Interior whitespace, word changes, scope changes, and an unrelated valid-looking 16-hex fingerprint still return `stale-material`. All three historical raw-reason generations certify unchanged.\n\nResidual risk and prevention: none observed in the fixed seam. The explicit three-generation regression matrix prevents future canonicalization changes from silently invalidating old attestations. Per session directive, this ticket is intentionally left `in_progress` and was not closed.","timestamp":1786302173761859001}],"created_at":1786106983674723001,"creation_channel":"cli","deps":[{"link_uuid":"7508725d-f8ca-4f0c-b1e7-41f19f406b62","relation":"discovered_from","target_id":"2be7-80d6-208a-4737"},{"link_uuid":"ca537d23-4d7a-4fcb-980e-92ca8f29612f","relation":"relates_to","target_id":"22c1-7546-1216-4584"},{"link_uuid":"3a4eb9bb-a818-4c15-95a8-180b3d930306","relation":"relates_to","target_id":"23fa-0473-97c1-497a"}],"description":"## Context\n\n`no_file_impact_reason` is operator-authored free text in the signed plan-review material. The original whitespace-normalization epic established that insignificant whitespace must not stale attestations while substantive edits must. Runtime proof shows `material_basis()` still hashes this reason raw, so boundary whitespace produces `stale-material`.\n\nCompatibility spans three historical fingerprint generations: pre-330c raw description/raw reason; post-330c pre-2be7 checkbox-normalized/raw reason; and post-2be7 pre-this-fix whitespace-normalized description/raw reason.\n\n## Plan\n\n- Add a held-out in-process RED oracle through the real material fingerprint and attestation-validity seams.\n- Add an independent boolean `normalize_reason` parameter, defaulting `True`, to `material_basis`; thread it through `material_fingerprint` and `current_material_fingerprint_impl`. Normalize insignificant reason whitespace only when this parameter is enabled.\n- In `_legacy_material_ok`, explicitly pass `normalize_reason=False` in EACH historical candidate. Keep the existing pre-330c candidate (`normalize_checkboxes=False`) and post-330c/pre-2be7 candidate (`normalize_whitespace=False`), and add the post-2be7/pre-fix candidate with only `normalize_reason=False`. This makes every raw-reason generation exactly reproducible while the current path uses the default normalized reason.\n- Run the focused plan-review suites, mutation-check the exact raw-reason defect, then run lint, typecheck, and the broader unit gate.\n\n## Acceptance Criteria\n\n- [x] Boundary/trailing whitespace-only variants of `no_file_impact_reason` produce the same current material fingerprint and a signed review remains `certified`.\n- [x] Interior whitespace or a word change remains material and yields `stale-material`.\n- [x] Pre-330c and post-330c/pre-2be7 legacy candidates explicitly disable reason normalization and continue matching their historical raw-reason fingerprints.\n- [x] Post-2be7/pre-fix attestations with canonical descriptions and raw reasons are grandfathered by the explicit third `normalize_reason=False` candidate.\n- [x] A valid-looking unrelated fingerprint remains stale, and existing legacy/description-normalization tests pass unchanged.\n\n## Verification\n\nFocused pytest nodes cover fingerprint equality, exact validity status, negative controls, and all legacy generations. The final change also passes repository lint, typecheck, and unit-test gates.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/plan_review/material_diff.py","reason":"Normalize insignificant reason whitespace behind an independent compatibility switch"},{"path":"src/rebar/llm/plan_review/pass1.py","reason":"Thread the reason-normalization switch through composite fingerprinting"},{"path":"src/rebar/llm/plan_review/relation_snapshot.py","reason":"Expose the switch at current-material recomputation"},{"path":"src/rebar/llm/plan_review/attest.py","reason":"Add the post-2be7/pre-fix legacy fingerprint candidate"},{"path":"tests/unit/plan_review/test_callous_reason_whitespace.py","reason":"Held-out RED/GREEN contract and historical-compatibility regression coverage"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","22c1-7546-1216-4584"],["relates_to","23fa-0473-97c1-497a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"6da0df95-fa21-4955-8a4b-9576c41e9690","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","tags":[],"ticket_id":"8aed-f307-8faa-49c6","ticket_type":"bug","title":"no_file_impact_reason is hashed raw into plan-review material, so whitespace-only edits to it still stale an attestation","verify_commands":[]},"source_event_uuids":["38d7abc8-93b3-4cfb-9e8d-543010fe3dd4","7508725d-f8ca-4f0c-b1e7-41f19f406b62","2d6111a1-adeb-4a8a-9b4b-9765c19dd641","b96a8f79-911b-4569-8265-fc9040d206f4","0956ebc1-187e-4d36-bacd-a3126999a9b8","848c8f9a-0bac-4627-8e22-bdcf9e753a9e","6dc79bc7-0f2d-490f-94ca-9cf860f50220","a63d841f-293e-475a-958f-517a2da04bb1","efed1743-f781-4256-9691-32940b2bc44f","b09b12a