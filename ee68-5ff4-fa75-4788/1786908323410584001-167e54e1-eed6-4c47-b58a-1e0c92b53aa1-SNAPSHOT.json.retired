{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786908323410584001,"compiled_state":{"alias":"innovative-dandruffy-deer","assignee":"joeoakhart@navapbc.com","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":21,"unsigned":0},"authorship_ledger":[{"content_hash":"3aca549594c39a8a9806d5b52c7148071a39bb575d4effff0337e4045559d9fc","event_uuid":"f9c5634a-8ee6-4a52-b9cf-893b8da7a81c","position":{"commit_sha":"4153528a03a4ff75d1a43a2c77244b419df1c49f","position":"1786691600660075001-f9c5634a-8ee6-4a52-b9cf-893b8da7a81c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f3729a1707b89bc3ff57f5510724a321ce4ed7ad1f8b17da2847c62fe957a1e9","event_uuid":"35c6289a-d89f-4ffd-bc1a-a1606139d6f9","position":{"commit_sha":"765e815a1a6d1ecdd78d00fea5b0cd5012c6a81d","position":"1786691982106562001-35c6289a-d89f-4ffd-bc1a-a1606139d6f9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8e2bd0374031e63efa147c9fb94fff26dca90c422cec727e107e565f167d6f75","event_uuid":"9a165a8c-9c3a-4abb-95a5-2834be57e357","position":{"commit_sha":"43d5684609529bd374dab8942c4adf8e43e9e4c5","position":"1786692213425309656-9a165a8c-9c3a-4abb-95a5-2834be57e357"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c8939cf23faf34a2c1c4110cf50de3ae11181b2d6fdef27fc21cbd68d115a4c6","event_uuid":"9f24526e-2495-45a9-a7bc-bf27fa650b6f","position":{"commit_sha":"f897f94c70f2b8a4e82765fb15ef6ff0b9bb095a","position":"1786694510560853001-9f24526e-2495-45a9-a7bc-bf27fa650b6f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bb4278f3e3fa2274dcdf143eff4061c17204ac01597a9434400d205f3e4171c5","event_uuid":"5fb462b2-3db7-478f-9ca4-e71f8dbdec86","position":{"commit_sha":"871b78ce54e5fdc51976bbba5353ed69bcfc5143","position":"1786694515415122001-5fb462b2-3db7-478f-9ca4-e71f8dbdec86"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b046002846512021261c9dc85664f106056de71be9381bf6cdc8b6d5b582cc58","event_uuid":"bc894a59-53e2-4876-a0d1-ce08395cbd43","position":{"commit_sha":"350c72a9218ba018e246670c6006918b61c1ca21","position":"1786694894020625001-bc894a59-53e2-4876-a0d1-ce08395cbd43"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"39ce62585dfb9c855ded1a10da9dce53f46ba1bf161c760e1701967f28137f77","event_uuid":"2660fc62-f364-499f-bca5-57a6f9a5c543","position":{"commit_sha":"71d3fca9d9d63d6428648a608b4c03d387aafb28","position":"1786694898559604001-2660fc62-f364-499f-bca5-57a6f9a5c543"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f03f1c42cbdadad768550817a54234859019d711a0a0ea1aa9a37fc18938bbac","event_uuid":"3b2b8ce9-cb9c-4c3a-b765-8f006772a834","position":{"commit_sha":"8b4ac5882f04021bb9a965c46de5f74301344411","position":"1786904830862939001-3b2b8ce9-cb9c-4c3a-b765-8f006772a834"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7344aaf2319c30d18eb949bb6e8a9ce505f4c5cc18d649813a99ad449d46bcee","event_uuid":"cad55bf9-886d-43ec-ad2d-b6cd658e24e9","position":{"commit_sha":"b954fa6e53a944b740ac0c178144fa4eb788b4c2","position":"1786904835215834001-cad55bf9-886d-43ec-ad2d-b6cd658e24e9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3d7927328159be09591963c1a7f025e48abc12e50acfcd13359179ae74790f9b","event_uuid":"6c4d28ef-776c-4948-a4e9-3cd023792ca1","position":{"commit_sha":"b954fa6e53a944b740ac0c178144fa4eb788b4c2","position":"1786904835950988001-6c4d28ef-776c-4948-a4e9-3cd023792ca1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"051cfa194727c28f876f448b4bf6cc106bae1c21f8b9b9313045b56dfcd4c2d0","event_uuid":"eddc4dd3-3c8a-4dff-ac8f-8569050d865a","position":{"commit_sha":"06cfaa1a162b1bf1834e875683e9f835d54716f7","position":"1786904854755099001-eddc4dd3-3c8a-4dff-ac8f-8569050d865a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4eb46e002df11f2ea93726aabf393ce6259c6c489ebad5f156a39322d09c5db2","event_uuid":"9bc0a1e2-6cf8-4caa-94be-2e9e6f31be46","position":{"commit_sha":"21d7c702a20b44264951b32e17e836b1eda9013f","position":"1786904858415432001-9bc0a1e2-6cf8-4caa-94be-2e9e6f31be46"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fafa7be23667c32f5cad2b53de203913c670445e5f26263e250d57c3d6b82f08","event_uuid":"161c9e16-26fb-45e6-aa7e-56000ce32e04","position":{"commit_sha":"594502d2a00bbc8f3c7ba5ed720895034d492737","position":"1786905357129197001-161c9e16-26fb-45e6-aa7e-56000ce32e04"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"86a74eb3e5f90291e0bfcb4e8f10e0c0017ced201edacf135a9b579abc44adee","event_uuid":"65c3df74-d52a-485e-92f8-5ee6f80c9a16","position":{"commit_sha":"6d0eae46757efa92c179d0ad8b9c34544a46f4ab","position":"1786905365006338001-65c3df74-d52a-485e-92f8-5ee6f80c9a16"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"04ad7375da93231d885617b32d130732eb18f39ecbf73f5bbacb8e8b2ba03781","event_uuid":"13c0cdd9-f22d-4776-9536-894b08ac23f5","position":{"commit_sha":"7c82a5d5a921c1f8c8f5e8c0d79c4906b84db129","position":"1786905428482009472-13c0cdd9-f22d-4776-9536-894b08ac23f5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ec45cd7569890a55bc6043d3dc99e6b477cefb55bbaaf925dc49f1b6b9c844cd","event_uuid":"2d98a3e3-b9dd-40f9-8671-39b0c9767b6b","position":{"commit_sha":"850fa8db2305d54c2fc38ab5baa02c4152fddc19","position":"1786905457916404001-2d98a3e3-b9dd-40f9-8671-39b0c9767b6b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Hypothesis-driven pass 1 (worktree deer-flake, git 2.55 local; CI failure was git 2.54/ubuntu, pytest 9.1.1 + xdist 3.8.0).\n\nMECHANISM FINGERPRINT (proven by direct injection): building the exact fixture history and unlinking .git/objects/66/842fd0... between the 1005 commit and the merge reproduces the CI signature EXACTLY — rc 128, 'error: invalid object 100644 66842fd0... for aaaa-bbbb-cccc-dddd/1005-cccc2222-COMMENT.json' printed TWICE, 'fatal: git write-tree failed to write a tree'. Also verified: json.dumps of the fixture's 1005 payload hashes to 66842fd0... — git add hashed the CORRECT bytes; the object then went missing.\n\nDiscriminators proven:\n- A zero-length/corrupt loose object does NOT reproduce it: merge exits 0 (the write-tree check is stat-only). The CI failure therefore requires ENOENT — the loose file (or its fanout dir) was ABSENT at merge, milliseconds after 'git commit' of the same blob succeeded (commit's own write_index_as_tree verifies the blob too, so it was present at commit time).\n- gc --auto / gc / prune / repack -adq run between commit and merge do NOT reproduce it: the blob is reachable (packed, still findable), merge succeeds. gc cannot prune a fresh reachable object; auto-gc threshold (~6700 loose) is unreachable in a ~30-object repo. Hypothesis (b) as *normal, completed* maintenance: KILLED. A background maintenance process remains conceivable only as a crashed/interrupted repack, but nothing in this repo triggers maintenance at all pre-merge.\n\n(a) GIT_* env leakage: KILLED. grep of the whole suite + src: no os.environ direct assignment of GIT_OBJECT_DIRECTORY/GIT_DIR/GIT_INDEX_FILE/GIT_ALTERNATE_OBJECT_DIRECTORIES/GIT_COMMON_DIR anywhere; all GIT_* settings are monkeypatch.setenv (function-scoped, main-thread reverted) of harmless keys (GIT_CONFIG_GLOBAL/SYSTEM, GIT_NO_LAZY_FETCH, GIT_CEILING_DIRECTORIES). Also logically inconsistent: a leaked object-dir during add+commit of 1005 would strand the COMMIT+TREE objects in the alternate store too, and the merge would then fail resolving HEAD, not at write-tree with only the blob missing.\n(c) global git config: KILLED. CI writes only identity + init.defaultBranch (all workflows grepped); nothing destructive; no test writes --global (the two --global reads are env-isolated).\n(d) tmp_path 30-char truncation collision: KILLED. Suite-wide scan of all test defs truncated to 30 chars: neither test_a_git_failure_falls_back_ nor test_ledger_attribution_is_unc has a duplicate; failing dirs were _0 (first use). Workers own disjoint popen-gwN basetemps; both CI steps use distinct basetemps and run sequentially.\n\nSelection-bias note: this fixture's merge (trivial in-index merge -> write-tree) is one of the only operations in the 13k-test suite that VERIFIES loose-object presence for a whole directory, so ANY rare loose-object disappearance anywhere in the suite would preferentially surface at exactly this line — consistent with two hits in this module (both ubuntu, both popen-gw1) and nowhere else.\n\nNext: bounded stress reproduction attempt, then (per plan) the instrumentation path if the deleter stays unidentified.","timestamp":1786691600660075001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Hypothesis pass 2 + resolution (instrumentation path).\n\nSTRESS: 30 further iterations of the module under -n 4 --dist worksteal (210 fixture instantiations) on macOS/git 2.55 — all green. Combined with oropendola's ~29,400 executions, no organic reproduction exists.\n\nxdist worker-restart angle (evaluated, dead end): a crashed worker's basetemp rmtree could in principle race a sibling — but restarts require --max-worker-restart (not set; default = no restart), the failing run shows no worker crash, and each worker owns a disjoint popen-gwN basetemp. Also, the failing tmp dir (_0, first use) is created milliseconds before use with a unique name no other process learns, so cross-test targeted deletion is impossible; the deleter must be in-process, a git child, or ambient — all instrumentable.\n\nMECHANISM (proven by injection, deleter unidentified): unlinking the loose object between commit and merge reproduces the CI signature byte-for-byte (doubled 'invalid object' + 'fatal: git write-tree failed to write a tree', rc 128). Corrupt-but-present object => merge rc 0 (presence check is stat-only). hash-object confirms git add hashed correct bytes. So: ENOENT on a fresh loose object, cause unknown.\n\nLANDED (Gerrit change 1769): the ticket's instrumentation path. _GitFailed now carries an object-store forensics snapshot captured at failure time — git fsck --full, git count-objects -v, recursive .git/objects listing with sizes+mtimes, GIT_* environment — rendered in the exception, best-effort (capture failure never masks the original error), type stays CalledProcessError. Withheld-oracle TDD: regression test reproduces the proven mechanism (delete loose object -> merge) and went RED on each forensic section before the implementation; 4 manual mutants (no attach, no render, no fsck, no listing) all killed. make lint + make typecheck green. Next CI occurrence will name the missing objects, show what survived with mtimes, and rule env redirection in or out — pinning the deleter instead of restarting the hunt.","timestamp":1786691982106562001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"[operator-attested] Gerrit change 1769 MERGED into main as f147ff87722 ('Capture object-store forensics on fixture git fail'). Vote evidence: LLM-Review +1 and Verified +1 — change reached SUBMITTABLE per Gerrit's submit rule and Submit succeeded (GET /a/changes/1769/ status=MERGED), which requires both votes green and no unresolved comments. Disposition mirrors precedent bug warmthless-dermal-oropendola (relates_to): instrumentation-only close after hypothesis exhaustion; the mechanism CLASS (fresh loose object ENOENT at merge) is injection-proven, hypotheses (a)-(d) killed with evidence in this ticket's comments, and the landed forensics (fsck --full, count-objects -v, objects listing with mtimes, GIT_* snapshot) will pin the deleter on the next CI occurrence. If it recurs: reopen, read the forensic block in the CI log, and root-cause from there.","timestamp":1786694515415122001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Disposition decision: the completion verifier correctly notes the defect itself is not proven resolved (instrumentation-only landing, deleter unidentified). Rather than force-closing past that finding, this ticket moves to BLOCKED: no further action is possible until the next organic CI occurrence, at which point the 1769 forensic block in the CI log identifies the deleter and this ticket is claimed again to land the class fix. Blocked-on: recurrence evidence (external event).","timestamp":1786694894020625001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Organic recurrence that reopens this bug: Gerrit 1827 / run 31961655783 / Ubuntu 24.04 Python 3.11 / xdist gw1 failed tests/unit/test_authorship_batched_ticket_map_7084.py after fixture setup completed. The active tracker was /home/runner/work/_temp/rebar-basetemp/popen-gw1/test_batched_map_matches_the_p0/tracker. build_ticket_position_commit_map returned {}, while resolve_event_commit immediately resolved 1000-aaaa1111 to e40a20fd6aa32b4a9ceb3b237b174da80aa3dc20. No _GitFailed forensic block was emitted because the broad git-log helper swallows nonzero/exception/empty-output detail. Total suite time was 359.02s, so the 300s resolver timeout did not fire. This is the third organic failure in this fixture and again on gw1; it satisfies the ticket's explicit reopen-on-recurrence condition, but the precise broad-log failure class remains to be proven before any fix.","timestamp":1786904858415432001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 1 RCA for the third organic recurrence — confirmed test-harness defect.\n\nThe new signature is not the prior missing-loose-blob class. In a real fixture repo, deleting the exact 1005 loose blob (66842fd006b2fdc95ff55a33a263f1cb216bc7d6) left BOTH the directory-wide git log and the immediate per-event git log healthy: broad rc=0/stdout=804 bytes; narrow rc=0/one SHA. Therefore the earlier ENOENT mechanism cannot produce this batched-empty/narrow-success recurrence.\n\nThe changeable defect is the equivalence test at tests/unit/test_authorship_batched_ticket_map_7084.py:184 treating one raw call to build_ticket_position_commit_map as guaranteed non-empty even though the function contract at src/rebar/attest/authorship.py:294-378 explicitly returns {} on any Git/process/empty-output failure and production callers fall back per event. The repository already records that Git reads can transiently return rc!=0 or empty stdout under CI load and require bounded recovery (tests/_git_counts.py:1-55). The CI observation is exactly one empty batched result followed immediately by a successful per-event read in the same repo.\n\nDiscriminating runtime injection reproduced the complete observed sequence for every single-attempt transient boundary: first rc=128/empty stderr payload, rc=0 with empty stdout, and BlockingIOError(EAGAIN) each made the raw batched helper return {}; an immediate replay of identical argv against unchanged state returned all 8 positions (rc=0, 804-byte stdout). Three other CI lanes and the local fixture use the same deterministic topology successfully, ruling out a stable parser/topology defect. The lower-level transient class is intentionally fail-closed and may be rc, empty output, or process-spawn pressure; the test bug is requiring that optimization-only call to succeed on its first environmental attempt instead of using bounded recovery while retaining a loud persistent-failure diagnostic.\n\nDefect legitimacy: defect in the test harness, not production authorship behavior. The production contract preserves attribution via per-event fallback; the test should isolate the equivalence property from a documented transient Git-read boundary. Phase 2 will be test-only: add bounded exact-call recovery for fixture-backed batched-map assertions, inject the first-attempt transient as the RED oracle, preserve persistent-failure diagnostics, and leave src/rebar unchanged.","timestamp":1786905357129197001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 2 RED oracle and contract card. authoritative_contract: raw batched resolver may fail closed to {} (src/rebar/attest/authorship.py:294-378), while fixture equivalence must remain deterministic across documented transient Git reads (tests/_git_counts.py:1-55). trigger_preconditions: the first real broad git-log boundary returns rc128/empty, rc0/empty, or raises EAGAIN; the identical second attempt runs normally against the unchanged real fixture repo. production_path: test-local fixture resolver -> real build_ticket_position_commit_map -> real temp Git history. tier: real temporary repository with fault injection only at the subprocess return boundary; a pure mock would not prove the real parser/topology succeeds on replay. observable_postcondition: all 8 exact position->SHA pairs equal the per-event resolver, with exactly two broad attempts. negative_control: a persistent empty result stops after exactly five attempts and raises diagnostics containing fsck and count-objects output. collateral_invariants: production authorship source and fallback semantics remain unchanged. gate: make test.\n\nFinal oracle was observed legitimately RED before the fix: rc128, empty-success, and EAGAIN cases each failed because broad_calls was 1 rather than 2; the persistent case failed because no AssertionError was raised. pytest collected and executed all four cases (4 failed, 8 deselected in 1.96s). The behavioral failures are the missing bounded recovery/diagnostic behavior, not import or fixture errors.","timestamp":1786905457916404001}],"created_at":1786690023187868001,"creation_channel":"cli","deps":[{"link_uuid":"09338c80-889a-4980-8f8e-44e18a2eb216","relation":"relates_to","target_id":"cb9c-49cb-5aba-488d"},{"link_uuid":"e4f4440b-14a6-4d4d-8a90-c560eed65617","relation":"discovered_from","target_id":"3211-be4f-d4aa-4b5c"},{"link_uuid":"9a165a8c-9c3a-4abb-95a5-2834be57e357","relation":"relates_to","target_id":"b336-4ca9-5dbe-4b11"},{"link_uuid":"eddc4dd3-3c8a-4dff-ac8f-8569050d865a","relation":"relates_to","target_id":"26b6-c181-9267-4072"}],"description":"## Context / Problem\nThe Gerrit Verified matrix intermittently ERRORS during FIXTURE SETUP of tests/unit/test_authorship_batched_ticket_map_7084.py — this time (run 31775418405, py3.13, worker popen-gw1, validating unrelated change 1761) at `git merge -q --no-edit side` with git's output FINALLY captured thanks to change 1619 (the diagnostics fix bug warmthless-dermal-oropendola landed for exactly this purpose):\n\n    error: invalid object 100644 66842fd006b2fdc95ff55a33a263f1cb216bc7d6 for 'aaaa-bbbb-cccc-dddd/1005-cccc2222-COMMENT.json'\n    fatal: git write-tree failed to write a tree\n    exit status 128\n\nThis REFINES oropendola's refutation: not a content conflict — the loose blob for the LAST mainline-committed event file is MISSING from the object store two subprocess calls after `git add`+`git commit -q` succeeded on it. A freshly committed object cannot legitimately vanish: this is an object-store integrity fault in the test environment or an env/config leakage between tests, and it will keep blocking UNRELATED changes' Verified votes at random (two distinct tests of this module have now failed the same way).\n\n## Approach\nHypothesis-driven debugging per the /rebar-debug discipline — deterministic reproduction BEFORE any fix. Candidate hypotheses to kill in order:\n(a) env leakage into the fixture's subprocess.run (inherits os.environ): GIT_OBJECT_DIRECTORY / GIT_DIR / GIT_INDEX_FILE / GIT_ALTERNATE_OBJECT_DIRECTORIES set directly (not via monkeypatch) by another test in the same xdist worker earlier, pointing object writes at a directory later removed;\n(b) detached background maintenance (gc --auto autoDetach / git maintenance) spawned by an earlier git call in the same repo pruning or repacking while the fixture continues;\n(c) global git config on the runner (CI's \"Configure git identity\" step or a test writing --global) enabling something destructive;\n(d) pytest tmp_path numbering/truncation collision (dir name truncated to 30 chars + _N suffix) causing two fixtures to share a directory under xdist.\nInstrument first: a conftest or fixture-level guard that on _GitFailed captures `git fsck`, `ls -la .git/objects/**`, the full os.environ GIT_* set, and any concurrent process listing — so the NEXT CI occurrence pins the mechanism even if local reproduction fails. Then fix the CLASS (e.g., scrub GIT_* env in the fixture's _git via env= allowlist, or disable autoDetach maintenance in the fixture repo), with a regression test proving the mechanism.\n\n## Scope\n- tests/unit/test_authorship_batched_ticket_map_7084.py — fixture hardening once the mechanism is proven (env-scrubbed _git and/or maintenance.autoDetach=false), plus any instrumentation that stays useful.\n- possibly tests/conftest.py — worker-level GIT_* leak detector if hypothesis (a) is proven.\n\n## Testing\n- A deterministic reproduction (stress loop under xdist py3.13, or direct injection of the proven mechanism — e.g., set the leaked env var / trigger detached gc — showing the exact 'invalid object' failure).\n- RED->GREEN: the reproduction fails before the fix, passes after.\n- The fix must not weaken what the fixture proves (merge topology, --full-history load-bearing case).\n\n## Acceptance Criteria\n- [x] Hypotheses (a)-(d) each tested and KILLED with recorded evidence (ticket comments); the mechanism CLASS — ENOENT on a freshly written loose object at merge time — is proven by direct injection, reproducing the CI failure signature byte-for-byte (doubled `invalid object` error, write-tree fatal, rc 128). The organic deleter was not identified after 210 local fixture instantiations under xdist plus ~29,400 prior green executions, so the sanctioned instrumentation path below applies.\n- [x] Sanctioned instrumentation path (per this ticket's plan for the not-reproducible case): `_GitFailed` now captures object-store forensics at failure time — `git fsck --full`, `git count-objects -v`, recursive `.git/objects` listing with sizes/mtimes, and a GIT_* env snapshot — best-effort and type-unchanged, so the NEXT CI occurrence pins the deleter. Withheld-oracle TDD (each forensic section RED first); 4/4 manual mutants killed.\n- [x] [operator-attested] `make lint`/`make typecheck` clean; landed via Gerrit change 1769 (LLM-Review +1 AND Verified +1), MERGED into main.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_authorship_batched_ticket_map_7084.py","reason":"make fixture-backed batched-map assertions recover from a single documented transient Git-read failure while preserving persistent-failure diagnostics"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"reconciler","managed_refs":[["relates_to","26b6-c181-9267-4072"],["relates_to","b336-4ca9-5dbe-4b11"],["relates_to","cb9c-49cb-5aba-488d"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"13c0cdd9-f22d-4776-9536-894b08ac23f5","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"blocked","tags":[],"ticket_id":"ee68-5ff4-fa75-4788","ticket_type":"bug","title":"Verified-matrix authorship fixture: freshly committed blob missing at merge (invalid object at write-tree)","verify_commands":[]},"source_event_uuids":["f9c5634a-8ee6-4a52-b9cf-893b8da7a81c","35c6289a-d89f-4ffd-bc1a-a1606139d6f9","9a165a8c-9c3a-4abb-95a5-2834be57e357","9f24526e-2495-45a9-a7bc-bf27fa650b6f","5fb462b2-3db7-478f-9ca4-e71f8dbdec86","bc894a59-53e2-4876-a0d1-ce08395cbd43","2660fc62-f364-499f-bca5-57a6f9a5c543","3b2b8ce9-cb9c-4c3a-b765-8f006772a834","cad55bf9-886d-43ec-ad2d-b6cd658e24e9","6c4d28ef-776c-4948-a4e9-3cd023792ca1","eddc4dd3-3c8a-4dff-ac8f-8569050d865a","9bc0a1e2-6cf8-4caa-94be-2e9e6f31be46","161c9e16-26fb-45e6-aa7e-56000ce32e04","65c3df74-d52a-485e-92f8-5ee6f80c9a16","13c0cdd9-f22d-4776-9536-894b08ac23f5","2d98a3e3-b9dd-40f9-8671-39b0c9767b6b"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786908323410584001,"uuid":"167e54e1-eed6-4c47-b58a-1e0c92b53aa1"}