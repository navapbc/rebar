vCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"db524c60a367cd47c1b13916383fc488323a5a6b9c4821a8531a2b49e324abe0","event_uuid":"04f45fc7-d012-4e8f-907c-fd3f74c43d2a","position":{"commit_sha":"1bb2db0206ee36969e9d34e6d4631dc827f526c6","position":"1795326122522140001-04f45fc7-d012-4e8f-907c-fd3f74c43d2a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed as Gerrit 3502 patch set at 0130526b5a9 (LLM-Review +1, Verified +1, 0 unresolved), merged as 8a35d8720a4. Checked on main at 8a35d8720a4: tests/unit/test_opcert_gate_config.py + test_verify_opcert*.py 48 passed, including the base-resolution tests (master default, REBAR_SYNC_REMOTE, ignored REBAR_GATE_REF/working-tree selectors, one-hop on the trusted remote, HEAD/SHA/fork refs fail closed, unfetched hop, dangling origin/HEAD, missing remote, no resolvable base: 15 passed); 'no fetched origin/main' gone from docs/exit-codes.md; docs/plan-review-gate.md names <remote>/HEAD; gen_cli_help --check and gen_cli_reference --check exit 0; check_mechanism_delta --check exits 0; _config_schema.py unchanged. make verify green locally (21712 + 226 passed).","timestamp":1795326047468599001}],"created_at":1795245184374679001,"creation_channel":"cli","deps":[{"link_uuid":"c3e0931a-0922-4141-96e4-f31f55e654f4","relation":"discovered_from","target_id":"eca7-e5b5-7640-403f"},{"link_uuid":"c058d8fd-dd0a-4ccf-95d9-48e8b12908c5","relation":"relates_to","target_id":"92e0-015d-cde7-4a8f"},{"link_uuid":"76793960-04cd-4526-8af3-0687589e577c","relation":"relates_to","target_id":"f4ed-fcad-b98c-46d0"},{"link_uuid":"04f45fc7-d012-4e8f-907c-fd3f74c43d2a","relation":"relates_to","target_id":"8983-a808-7ad5-4d20"}],"description":"## Context / Problem\n\n`src/rebar/_opcert_gate_config.py` (from golden-busied-nag, `d5f10d1d2c8`) hard-codes the reviewed base as `BASE_REMOTE = \"origin\"` / `BASE_REF = \"refs/remotes/origin/main\"`. In a repository whose integration branch is not `main` (for example `master` or `trunk`), or whose remote is not named `origin`, `base_ref()` finds no such ref and `rebar verify-opcert` exits 2 with a misleading \"fetch origin main\" hint. Rebar is used in other repositories, so the gate is unusable there. The rest of rebar names its sync remote with `sync.remote` (`src/rebar/_config_schema.py`, `SyncConfig.remote`, default `origin`) and its gate base ref with `REBAR_GATE_REF` > `[snapshot].ref` > `origin/main` (`rebar.llm.gate_source.default_ref`, `src/rebar/_config_resolvers.py` `resolve_gate_ref`). No config key, env var or flag may be added.\n\nThe constraint that shapes the fix: the base ref decides which `rebar.toml` the gate trusts, so it must not come from the change under review. A working-tree `[snapshot].ref` or `sync.remote` could point the gate at the change's own branch.\n\n## Approach\n\n`REBAR_GATE_REF` is NOT used: the offline suite's autouse fixture `_gate_source_attested_by_default` (`tests/conftest.py:657`) sets it to `HEAD`, and a developer may do the same for local gates; for this gate `HEAD` is the change under review, which reopens the hole. The working-tree `[snapshot].ref` is not used for the same reason.\n\n`base_ref()` in `src/rebar/_opcert_gate_config.py` resolves the base from sources the change cannot edit:\n1. Remote: `sync.remote` from the user config and environment layers only (`REBAR_SYNC_REMOTE`, the canonical override; `env_overridable_keys()` lists `(\"sync\",\"remote\")`), default `origin`. The project layer is skipped, using the same layer composition `gate_config` already builds minus the project layer. It must be a configured git remote (`git remote` lists it), else `ConfigError`.\n2. Branch: `refs/remotes/<remote>/HEAD` when it resolves to a commit (git records the remote's default branch on clone or `git remote set-head <remote> --auto`); a dangling symref falls through. Else `refs/remotes/<remote>/main` (today's behaviour). A stale `<remote>/HEAD` after an upstream default-branch rename is a known limit, fixed with `git remote set-head <remote> --auto`; the error text and help say so.\n3. One reviewed hop, on the base's own remote only: if the base's committed config sets `[snapshot].ref` to `<branch>` or `<remote>/<branch>` where `<remote>` is the base's remote, and that differs from the base, the gate re-resolves to `refs/remotes/<remote>/<branch>` and reads the committed config there. `HEAD`, a SHA-like value or any other remote (a fork) is a `ConfigError` (exit 2), not a silent fallback, so a hop can never leave the trusted remote. The hop target must resolve, else `ConfigError` naming the fetch. The target's own `[snapshot].ref` is not followed.\n\nNo resolvable base: `ConfigError` (exit 2) naming the remote, the refs tried and the `git fetch` that fixes it. `.github/workflows/verify-identity.yml` is unchanged (this repository's base is `main`).\n\n## Scope\n\n- `src/rebar/_opcert_gate_config.py`\n- `tests/unit/test_opcert_gate_config.py`\n- `src/rebar/_cli/_parsers/advanced/verify.py`, `src/rebar/_cli/help/overview.txt`, `src/rebar/_cli/help/verify-opcert.txt`, `docs/cli-reference.md` (describe the base resolution)\n- `docs/exit-codes.md`, `docs/manifest-signing.md`, `docs/plan-review-gate.md`, `infra/runbooks/mcp-opcert-enforcement-flip.md`: replace the fixed `origin/main` base with the resolution rule\n\n## Testing\n\nIn `tests/unit/test_opcert_gate_config.py` (local bare repos; the existing fixtures keep `REBAR_GATE_REF=HEAD` from conftest, which this design ignores):\n- only branch `master`, `origin/HEAD` set to it: gate reads `origin/master:rebar.toml`;\n- remote named `upstream`, `REBAR_SYNC_REMOTE=upstream`: reads upstream's base; a working-tree `[sync] remote` is ignored;\n- `REBAR_GATE_REF=HEAD` and a working-tree `[snapshot] ref` naming the change branch: both ignored;\n- committed `[snapshot] ref = \"origin/release\"` (or bare `release`) on main: hop once to `origin/release`; release's own `[snapshot] ref` is not followed; a committed ref naming the base itself is no hop; `HEAD`, `origin/HEAD`, a SHA or `fork/release` is a `ConfigError`; a hop target that is not fetched exits 2;\n- dangling `origin/HEAD`: falls through to `origin/main`;\n- `REBAR_SYNC_REMOTE` naming a missing remote, or no resolvable base: exit 2 naming the remote and refs tried.\nExisting gate tests pass. Then `make verify`.\n\n## Acceptance Criteria\n\n- [x] On a repository whose default branch is `master` (recorded as `origin/HEAD`), `rebar verify-opcert` reads the committed config from `origin/master` and does not exit 2: shown by a test.\n- [x] The environment's `sync.remote` selects the remote; a working-tree `[sync].remote`, a working-tree `[snapshot].ref` and `REBAR_GATE_REF=HEAD` do not change the base: shown by tests.\n- [x] A committed `[snapshot].ref` naming a branch of the base's remote is followed once and only once, and `HEAD`, a SHA or another remote fails closed: shown by tests.\n- [x] With no resolvable base, a missing remote, or an unfetched hop target, the exit is 2 and the message names what was tried.\n- [x] `grep -n 'no fetched \\`origin/main\\`' docs/exit-codes.md` prints nothing, and `docs/plan-review-gate.md` names the resolution rule.\n- [x] The regenerated help (`python scripts/gen_cli_help.py --check`) and `docs/cli-reference.md` (`python scripts/gen_cli_reference.py --check`) are current and describe the resolution.\n- [x] No config key, env var or flag is added: `python scripts/check_mechanism_delta.py --check` exits 0 and `git diff origin/main -- src/rebar/_config_schema.py` is empty.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_opcert_gate_config.py","reason":"resolve the base ref from env remote and its default branch"},{"path":"tests/unit/test_opcert_gate_config.py","reason":"cover non-main bases and hop rules"},{"path":"src/rebar/_cli/_parsers/advanced/verify.py","reason":"describe base resolution"},{"path":"src/rebar/_cli/help/overview.txt","reason":"regenerated help"},{"path":"src/rebar/_cli/help/verify-opcert.txt","reason":"regenerated help"},{"path":"docs/cli-reference.md","reason":"regenerated reference"},{"path":"docs/exit-codes.md","reason":"exit-2 causes"},{"path":"docs/manifest-signing.md","reason":"base resolution"},{"path":"docs/plan-review-gate.md","reason":"base resolution"},{"path":"infra/runbooks/mcp-opcert-enforcement-flip.md","reason":"base wording"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","8983-a808-7ad5-4d20"],["relates_to","92e0-015d-cde7-4a8f"],["relates_to","f4ed-fcad-b98c-46d0"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f9e6d483-ee75-43a3-94bf-ddabf6877bde","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"35eb-bf90-0c47-4b64","ticket_type":"bug","title":"verify-opcert hard-codes origin/main as the reviewed base","verify_commands":[]},"source_event_uuids":["8d611038-a3e4-464e-8dc1-04449582b4d8","ec99e924-b9bb-404c-ab23-c202319a069b","f9e6d483-ee75-43a3-94bf-ddabf6877bde","2556a335-133b-451d-8c6d-ee5ab82724c0","c058d8fd-dd0a-4ccf-95d9-48e8b12908c5","0dab5660-74d6-4c19-8cd6-9d95dca78be9","7544cec9-4a8a-4d1e-995a-44d5caae82f2","2a2a4181-ec34-4518-b4bf-7f8842033caa","7679396