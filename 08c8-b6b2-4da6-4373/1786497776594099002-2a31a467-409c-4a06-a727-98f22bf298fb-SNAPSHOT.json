a8e-4010-9d55-fb15c980bc8b","position":{"commit_sha":"361187c1143c895ea536f8b0752ba9481b8d9302","position":"1786497776594099001-b08ab0e7-1a8e-4010-9d55-fb15c980bc8b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[],"created_at":1786313724101886001,"creation_channel":"cli","deps":[{"link_uuid":"65b1fa11-38d4-4d53-bec4-8f3170fef9ab","relation":"discovered_from","target_id":"9f7f-3abe-0db4-4dcf"}],"description":"## Context\n\nBug b636 (landed as 5e7d6e71ba) added deleted-source recovery to fsck. After the module-size split, `restore_deleted_sources` and `rebuild_with_restore` live in `src/rebar/_commands/fsck_restore.py` (:127 and :182) and are re-exported from `src/rebar/_commands/fsck_repair.py` (bottom-of-module import at :614).\n\nOnly ONE call site actually uses the composed helper — `repair_or_plan` (`fsck_repair.py:580`). The per-ticket repair path `_repair_ticket` (`fsck_repair.py:209`) still calls `rebuild_snapshot_from_full_log` DIRECTLY at :270-274, so it rebuilds from whatever sources survive and never attempts the restore. That path fails closed rather than corrupting anything, but a ticket whose SNAPSHOT source was dropped by legacy compaction is not recovered when repair runs through `_repair_ticket`.\n\n`rebuild_with_restore`'s own docstring already calls itself \"the repair path's single entrypoint\", and no ADR or ticket records an intentional divergence between the two paths — this is a residual gap, not a deliberate split.\n\nDiscovered while closing story 9f7f (superseded into b636): every other acceptance criterion of 9f7f is implemented, this call site is the residual gap.\n\n## Plan\n\nRoute `_repair_ticket`'s rebuild through `rebuild_with_restore` so the two repair entry points behave identically, and surface any restored sources in the `disp` dict the caller already consumes.\n\n### The `no_commit` contract (must be preserved)\n\n`_repair_ticket` takes `no_commit: bool = False` and currently forwards it:\n`rebuild_snapshot_from_full_log(tracker, ticket_id, ticket_dir, no_commit=no_commit)`.\n`no_commit` gates the git commit in `compact_rebuild.py:234`, and the batch repair loop at `fsck_repair.py:401-408` calls `_repair_ticket(..., no_commit=True)` so commits are deferred until after the whole batch.\n\n`rebuild_with_restore(tracker, ticket_id, ticket_dir) -> tuple[bool, list[str]]` has NO `no_commit` parameter and calls the rebuild with the default `no_commit=False`. Routing naively would make the batch path commit once per ticket — a behavior change.\n\nWorked example of the required contract:\n\n- `rebuild_with_restore` gains a keyword-only `no_commit: bool = False` and forwards it verbatim: `rebuild_snapshot_from_full_log(tracker, ticket_id, ticket_dir, no_commit=no_commit)`.\n- `_repair_ticket` calls `rebuild_with_restore(tracker, ticket_id, ticket_dir, no_commit=no_commit)` and unpacks `(rebuilt, restored)`.\n- The existing `repair_or_plan` call at `fsck_repair.py:580` stays `rebuild_with_restore(tracker, ticket_id, ticket_dir)` — the new parameter defaults to `False`, which is that path's current behavior, so it is unchanged.\n- Concretely: `_repair_ticket(tracker, tid, dir, dry_run=False, no_commit=True)` on a ticket with an auto-recoverable orphan restores the deleted source, rebuilds the snapshot, and leaves the tickets worktree DIRTY (no new commit on the `tickets` branch); with `no_commit=False` it commits exactly as it does today.\n\n### Reporting\n\n`_repair_ticket`'s `disp` dict gains a `\"restored\"` key holding the restored filenames list (empty list when nothing was restored), mirroring what `repair_or_plan` surfaces as \"after restoring N deleted event(s)\".\n\n### Import cycle\n\n`fsck_repair` imports `fsck_restore` at the BOTTOM of the module (:614) to let the leaf lazily import `snapshot_missing_sources`. `_repair_ticket` therefore uses a function-local `from rebar._commands.fsck_restore import rebuild_with_restore` (the same lazy-import shape the current code uses for `rebuild_snapshot_from_full_log` at :270) rather than a new module-level import.\n\n### No double-restore\n\n`restore_deleted_sources` skips any name already present on disk as `<name>` or `<name>.retired`, and `rebuild_with_restore` only attempts a restore when `snapshot_missing_sources(ticket_dir)` is non-empty. A second pass over the same ticket therefore restores nothing and reports an empty list — that idempotency is the invariant AC4 asserts.\n\n## Acceptance Criteria\n\n- [ ] `_repair_ticket` obtains its rebuild through `rebuild_with_restore`, not a direct `rebuild_snapshot_from_full_log` call.\n      Verify: `grep -n \"rebuild_with_restore\" src/rebar/_commands/fsck_repair.py` shows a call inside `_repair_ticket`, and `grep -n \"rebuild_snapshot_from_full_log\" src/rebar/_commands/fsck_repair.py` shows no call in `_repair_ticket`.\n- [ ] `rebuild_with_restore` accepts a keyword-only `no_commit: bool = False` and forwards it to `rebuild_snapshot_from_full_log`; `_repair_ticket` passes its own `no_commit` through.\n      Verify: `grep -n \"no_commit\" src/rebar/_commands/fsck_restore.py`.\n- [ ] `_repair_ticket`'s returned `disp` dict carries a `\"restored\"` list of restored source filenames.\n      Verify: `python -m pytest tests/interfaces/store/test_fsck_repair_restore_08c8.py -q`.\n- [ ] A held-out test proves a ticket whose SNAPSHOT source was deleted by legacy compaction is recovered when repair runs via `_repair_ticket` (RED before the change).\n      Verify: `python -m pytest tests/interfaces/store/test_fsck_repair_restore_08c8.py -q`.\n- [ ] A test proves `_repair_ticket(..., no_commit=True)` creates no new commit on the tickets branch while still restoring and rebuilding.\n      Verify: `python -m pytest tests/interfaces/store/test_fsck_repair_restore_08c8.py -q`.\n- [ ] A test proves a second `_repair_ticket` pass over the same ticket restores nothing (no double-restore, empty `\"restored\"`).\n      Verify: `python -m pytest tests/interfaces/store/test_fsck_repair_restore_08c8.py -q`.\n- [ ] The `repair_or_plan` call site at `fsck_repair.py:580` is unchanged in behavior and existing fsck repair/restore tests pass unchanged.\n      Verify: `python -m pytest tests/integration/test_b636_rebuild_history_loss.py tests/interfaces/store -q -k \"fsck or restore or repair\"`.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_commands/fsck_repair.py","reason":"_repair_ticket rebuild routed through rebuild_with_restore; restored-source reporting added to disp"},{"path":"src/rebar/_commands/fsck_restore.py","reason":"rebuild_with_restore gains keyword-only no_commit forwarded to rebuild_snapshot_from_full_log"},{"path":"tests/interfaces/store/test_fsck_repair_restore_08c8.py","reason":"held-out tests: recovery via _repair_ticket, no_commit preserved, no double-restore"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"422b08bf-4535-414e-b815-4debd1f0519e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"08c8-b6b2-4da6-4373","ticket_type":"task","title":"fsck _repair_ticket bypasses rebuild_with_restore, so repair never restores deleted SNAPSHOT sources","verify_commands":[]},"source_event_uuids":["fcaf6e06-9307-43d4-b990-3a436a2ca066","74e58670-146f-4175-8b98-927fb19661e9","65b1fa11-38d4-4d53-bec4-8f3170fef9ab","10bf3dda-df66-4f4c-89d9-f88e2f4d4794","61efbdfe-c0c0-4be8-b89c-b4e5fcfe702b","12958f1c-205c-46ea-b76a-f693075a990a","422b08bf-4535-414e-b815-4debd1f0519e","b08ab0e7-1a8e-4010-9d55-fb15c980bc8b"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786497776594099002,"uuid":"2a31a467-409c-4a06-a727-98f22bf298fb"}