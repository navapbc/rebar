{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^\\([[:space:]]*#[^!].*\\|[[:space:]]*#[[:space:]]*\\|[[:space:]]*;.*\\|[[:space:]]*<!--.*\\|[[:space:]]*.*-->\\|[[:space:]]*\\)$\" HEAD^ HEAD -- .github/workflows/reconcile-bridge.yml .github/workflows/release.yml .github/workflows/structured-output-baseline.yml .github/workflows/terraform-drift.yml .github/workflows/test.yml .github/workflows/verify-identity.yml","dd_id":"preserve-workflow-data","dd_text":"Prove the leaf commit changes only standalone comments or blank lines in declared workflow paths."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import re,subprocess,sys\npat=re.compile(r\"#\\s*(?:shellcheck\\b|zizmor:|predates-gate-ok:|mechanism-ok:)\",re.I)\ndef rows(ref,path):\n lines=subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True).splitlines()\n out=[]\n for i,line in enumerate(lines):\n  if pat.search(line):\n   nxt=next((x for x in lines[i+1:] if x.strip() and not x.lstrip().startswith(\"#\")),\"<EOF>\")\n   out.append((line,nxt))\n return out\nbad=[p for p in sys.argv[1:] if rows(\"HEAD^\",p)!=rows(\"HEAD\",p)]\nassert not bad,f\"workflow directive text or attachment changed: {bad}\"' .github/workflows/reconcile-bridge.yml .github/workflows/release.yml .github/workflows/structured-output-baseline.yml .github/workflows/terraform-drift.yml .github/workflows/test.yml .github/workflows/verify-identity.yml","dd_id":"directive-preservation","dd_text":"Preserve shellcheck, zizmor, predates-gate, and mechanism markers with their code attachment."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/workflow/test_reconcile_workflow_lint.py tests/unit/workflow/test_bridge_primary_workflow_heldout.py tests/interfaces/store/test_reconcile_workflow_merge_driver.py tests/interfaces/store/test_reconcile_workflow_no_shallow_rebase.py tests/scripts/test_reconcile_bridge_push_retry.py","dd_id":"reconcile-contracts","dd_text":"Exercise reconciliation workflow concurrency, merge-driver, history, and push-retry contracts."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_release_workflow_pins.py tests/unit/test_release_guards.py tests/unit/test_mcp_publisher_pin.py tests/unit/test_dependency_advisory_wiring.py tests/unit/test_structured_matrix_scorer.py","dd_id":"release-structured-contracts","dd_text":"Exercise release pins/guards, publisher provenance, advisory wiring, and structured matrix behavior."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_terraform_drift_workflow_shape.py tests/unit/test_terraform_tree_currency.py tests/unit/test_terraform_drift_version_pin.py tests/unit/test_opcert_deploy_infra.py::test_terraform_ci_runs_fmt_check_and_validate","dd_id":"terraform-contracts","dd_text":"Exercise drift workflow shape, tree currency, version floor, and validation wiring."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_ci_main_push_policy.py tests/unit/test_ci_workflow_parity.py tests/unit/test_predates_gate_guard_parity.py tests/unit/test_main_health_report.py tests/unit/test_ci_tickets_partial_clone_workflows.py tests/unit/test_ci_tickets_push_policy.py tests/unit/test_verify_opcert_heldout.py tests/unit/test_verify_gate_parity.py tests/unit/test_ci_actionlint_scope.py","dd_id":"ci-identity-contracts","dd_text":"Exercise CI trigger/parity, guard, health, ticket-store, identity, op-cert, and actionlint contracts."},{"command":"rtk git diff --check HEAD^ HEAD -- .github/workflows/reconcile-bridge.yml .github/workflows/release.yml .github/workflows/structured-output-baseline.yml .github/workflows/terraform-drift.yml .github/workflows/test.yml .github/workflows/verify-identity.yml","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in declared workflow paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"Run repository lint and policy gates with the worktree virtualenv."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788625019159593001,"uuid":"b45dda4f-fb31-40bc-b286-9ae9a7083dc4"}