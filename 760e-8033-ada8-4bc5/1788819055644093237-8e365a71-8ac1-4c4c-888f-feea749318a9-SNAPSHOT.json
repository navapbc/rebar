leaf commit changes only standalone comments or blank lines in declared workflow paths."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import re,subprocess,sys\npat=re.compile(r\"#\\s*(?:shellcheck\\b|zizmor:|predates-gate-ok:|mechanism-ok:)\",re.I)\ndef rows(ref,path):\n lines=subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True).splitlines()\n out=[]\n for i,line in enumerate(lines):\n  if pat.search(line):\n   nxt=next((x for x in lines[i+1:] if x.strip() and not x.lstrip().startswith(\"#\")),\"<EOF>\")\n   out.append((line,nxt))\n return out\nbad=[p for p in sys.argv[1:] if rows(\"HEAD^\",p)!=rows(\"HEAD\",p)]\nassert not bad,f\"workflow directive text or attachment changed: {bad}\"' .github/workflows/reconcile-bridge.yml .github/workflows/release.yml .github/workflows/structured-output-baseline.yml .github/workflows/terraform-drift.yml .github/workflows/test.yml .github/workflows/verify-identity.yml","dd_id":"directive-preservation","dd_text":"Preserve shellcheck, zizmor, predates-gate, and mechanism markers with their code attachment."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/workflow/test_reconcile_workflow_lint.py tests/unit/workflow/test_bridge_primary_workflow_heldout.py tests/interfaces/store/test_reconcile_workflow_merge_driver.py tests/interfaces/store/test_reconcile_workflow_no_shallow_rebase.py tests/scripts/test_reconcile_bridge_push_retry.py","dd_id":"reconcile-contracts","dd_text":"Exercise reconciliation workflow concurrency, merge-driver, history, and push-retry contracts."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_release_workflow_pins.py tests/unit/test_release_guards.py tests/unit/test_mcp_publisher_pin.py tests/unit/test_dependency_advisory_wiring.py tests/unit/test_structured_matrix_scorer.py","dd_id":"release-structured-contracts","dd_text":"Exercise release pins/guards, publisher provenance, advisory wiring, and structured ma