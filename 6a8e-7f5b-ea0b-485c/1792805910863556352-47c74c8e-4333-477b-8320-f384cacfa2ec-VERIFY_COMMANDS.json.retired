{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nBASE=\"a74d0073e84fc8b772f79b6ed1b1af13d0df67c6\"\nclass StripDocstrings(ast.NodeTransformer):\n    def generic_visit(self, node):\n        node = super().generic_visit(node)\n        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n            if node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n                node.body = node.body[1:]\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n        return node\ndef normalized(raw):\n    return StripDocstrings().visit(ast.parse(raw, type_comments=True))\nfor path in sys.argv[1:]:\n    before = subprocess.check_output([\"git\", \"show\", f\"{BASE}:{path}\"], text=True)\n    after = subprocess.check_output([\"git\", \"show\", f\"HEAD:{path}\"], text=True)\n    if ast.dump(normalized(before), include_attributes=False) != ast.dump(normalized(after), include_attributes=False):\n        raise SystemExit(f\"normalized AST changed: {path}\")' tests/interfaces/facades/test_attestation_parity_heldout_2e16.py tests/interfaces/facades/test_bridge_programmatic.py tests/interfaces/facades/test_central_mount_gate_ad9f.py tests/interfaces/facades/test_cli_argparse.py tests/interfaces/facades/test_cli_js_safe_integers.py tests/interfaces/facades/test_fsck_structured_326f.py tests/interfaces/facades/test_mcp.py tests/interfaces/facades/test_mcp_http_transport.py tests/interfaces/facades/test_mcp_js_safe_integers.py tests/interfaces/facades/test_mcp_list_read_surface.py tests/interfaces/facades/test_mcp_push_status.py tests/interfaces/facades/test_mcp_stateless_transport.py tests/interfaces/facades/test_plan_review_attestation_facades.py tests/interfaces/facades/test_verify_completion_facades.py","dd_id":"semantic","dd_text":"All scoped Python files have exactly equal normalized ASTs against the current parent."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import re, subprocess, sys\nBASE=\"a74d0073e84fc8b772f79b6ed1b1af13d0df67c6\"\nPATTERN=re.compile(r\"^#!|#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\")\ndef lines(ref, path):\n    raw=subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\n    return [line for line in raw.splitlines() if PATTERN.search(line)]\nfor path in sys.argv[1:]:\n    before=lines(BASE, path)\n    after=lines(\"HEAD\", path)\n    if before != after:\n        raise SystemExit(f\"directive/shebang lines changed: {path}\")' tests/interfaces/facades/test_attestation_parity_heldout_2e16.py tests/interfaces/facades/test_bridge_programmatic.py tests/interfaces/facades/test_central_mount_gate_ad9f.py tests/interfaces/facades/test_cli_argparse.py tests/interfaces/facades/test_cli_js_safe_integers.py tests/interfaces/facades/test_fsck_structured_326f.py tests/interfaces/facades/test_mcp.py tests/interfaces/facades/test_mcp_http_transport.py tests/interfaces/facades/test_mcp_js_safe_integers.py tests/interfaces/facades/test_mcp_list_read_surface.py tests/interfaces/facades/test_mcp_push_status.py tests/interfaces/facades/test_mcp_stateless_transport.py tests/interfaces/facades/test_plan_review_attestation_facades.py tests/interfaces/facades/test_verify_completion_facades.py","dd_id":"directives","dd_text":"Shebang and directive-bearing physical lines remain byte-identical in every scoped file."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess,sys; expected=sorted(sys.argv[1:]); actual=sorted(subprocess.check_output([\"git\",