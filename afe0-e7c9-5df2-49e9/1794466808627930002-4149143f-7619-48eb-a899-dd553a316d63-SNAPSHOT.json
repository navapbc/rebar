\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Related: rebar already has a per-model output ceiling table, MODEL_MAX_OUTPUT_TOKENS (see cumulative-insensible-asianlion for Nova). Maverick is likely just missing from it; check that table before designing anything new.","timestamp":1794466808627930001}],"created_at":1794466773468852001,"creation_channel":"python","deps":[{"link_uuid":"c3a56de3-cf4b-4dd8-a73b-b13ee3ef4b33","relation":"discovered_from","target_id":"a81a-946a-31c9-4d03"}],"description":"## Observation\nOn 2026-11-11 a live agentic run of `us.meta.llama4-maverick-17b-instruct-v1:0` on Bedrock (us-west-2) with rebar's default `max_tokens` (`DEFAULT_MAX_TOKENS = 16000`, src/rebar/llm/config.py:111) was rejected before generation: HTTP 400 ValidationException \"The maximum tokens you requested exceeds the model limit of 8192\". The same run with `max_tokens=8192` completed.\nSo every rebar LLM operation on Maverick fails unless the operator lowers `max_tokens`, and nothing in rebar tells them the model's limit. Other Bedrock models with output caps below 16000 are likely affected the same way; not surveyed.\nFound while fixing garlicky-leery-seal.\n## Acceptance criteria\n- [ ] A rebar run on a model whose output cap is below the configured max_tokens either sends a value within the cap or fails with an error naming the cap and the setting to change.\n","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"afe0-e7c9-5df2-49e9","ticket_type":"bug","title":"Default llm max_tokens 16000 exceeds Llama 4 Maverick's 8192 limit on Bedrock","verify_commands":[]},"source_event_uuids":["ef85224c-e393-4318-876a-3bd242b1fe4e","c3a56de3-cf4b-4dd8-a73b-b13ee3ef4b33","f5823b7e-b35f-484d-a682-4c69f4046272"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1794466808627930002,"uuid":"4149143f-7619-48eb-a899-dd553a316d63"}