res\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"72a04fb045c66e53b2d14e3db6fc7a335651b0403be74508d84d123384e27790","event_uuid":"3cc9473d-b843-4913-bf8c-f614bf797025","position":{"commit_sha":"b26329a977e6584d3adbff8207d1136972f0664f","position":"1787709376344176001-3cc9473d-b843-4913-bf8c-f614bf797025"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"74ac321eb1814f311478661c5e15c9114cd3054d3db84e791cb27199fc9efa8f","event_uuid":"95553e2f-1e07-442e-884b-7009962cf44e","position":{"commit_sha":"b26329a977e6584d3adbff8207d1136972f0664f","position":"1787709382116766001-95553e2f-1e07-442e-884b-7009962cf44e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b1c0b2a2b9ea11c43fd38f0b29e26ad19353ca5e8f501f9a3659b555ff4745fe","event_uuid":"40de27ed-160d-4180-905e-6a7d011b898e","position":{"commit_sha":"7af297589f1eae714eca6784cd9c8480cb3e31c7","position":"1787709591709259001-40de27ed-160d-4180-905e-6a7d011b898e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"907b3290ccf666c9716b6e325a1270fe75bfb825bf97e0cd62bfe55c9d2ac398","event_uuid":"e5006eff-1ec8-46a7-84f1-e9e088421243","position":{"commit_sha":"3132e2cb26383da79353903503a0841dd74154d2","position":"1787710107843332001-e5006eff-1ec8-46a7-84f1-e9e088421243"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented + validated locally: platform_compat marker registered; conftest auto-marks by path; macOS DEFAULT_SUITE_MARKS branch = 'platform_compat and not external'; parity guard updated + silent-shrink guard added. Collection: 900 platform_compat tests. Parity guard: 28 passed. make lint clean. Landing via Gerrit.","timestamp":1787709591709259001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed to Gerrit as change 2228: https://rebar.solutions.navateam.com/c/rebar/+/2228 (stacked parent of C/2229). Awaiting LLM-Review +1 and Verified +1.","timestamp":1787710107843332001}],"created_at":1787705222556769001,"creation_channel":"cli","deps":[],"description":"# Reduce the macOS pytest cell to a platform-compatibility subset\n\n## Context / Problem\nThe Gerrit Verified Gate's critical path is the macOS pytest cell. It runs the FULL default\nsuite plus the integration tier, while every other gate job finishes by ~20 min. Measured over\nfour recent successful runs the macOS py3.13 cell is ~2140-2486s and is the sole long pole\n(gate ~43 min). On the IDENTICAL test selection the macOS runner is ~3.7x slower per test than\nUbuntu (macOS ~2140s vs Ubuntu ~572-595s), attributable to per-test process-spawn + git-store\nfixture overhead — the CPU-bound AST/policy scanners are equal/faster on macOS. Running full\nbreadth on the slow runner buys latency, not confidence.\n\n## Approach\nKeep the full suite on Linux (Ubuntu 3.11/3.12/3.13 unchanged) and reduce the macOS cell to the\ntests whose behaviour genuinely differs between Darwin and Linux: file locking (flock/fcntl/\nmkdir), atomic directory/rename, subprocess timeout (gtimeout vs timeout), and cross-process git\ncontention. macOS keeps its existing `integration` tier step (cross-process concurrency\nend-to-end) and runs a new `platform_compat`-marked subset in place of the full default suite.\nSelection is centralised in ONE auditable place — a path-keyed auto-marker in tests/conftest.py\n— rather than per-file markers, so the macOS suite cannot silently drift. This fits the goal of\ncutting CI runtime without cutting confidence: Linux still runs everything.\n\n## Scope\n- pyproject.toml — register a `platform_compat` marker in the `[tool.pytest.ini_options]`\n  `markers` list (the block currently ends at the `e2e:` entry).\n- tests/conftest.py — extend the existing `pytest_collection_modifyitems` hook (which already\n  auto-applies the `external` marker by path) to also apply `platform_compat` by path, driven by\n  a documented `_PLATFORM_COMPAT_PATH_FRAGMENTS` tuple (store/lock/atomic/timeout/snapshot/\n  contention seams).\n- .github/workflows/_build-and-test.yml — change the `DEFAULT_SUITE_MARKS` env expression\n  (currently the two-branch ternary at the \"Run the default suite\" step) so the macOS cell\n  selects `platform_compat and not external`; Ubuntu keeps its existing selection. The macOS\n  integration-tier step is unchanged.\n- tests/unit/test_ci_workflow_parity.py — update\n  `test_repo_policy_nodes_run_only_in_the_existing_primary_cell` (its regex hardcodes the old\n  two-branch `DEFAULT_SUITE_MARKS`) for the new three-branch expression, and add a guard that\n  the macOS subset still collects the core OS-sensitive files.\n\n## Testing\n- Collect and run `-m \"platform_compat and not external\"` locally; confirm it selects the\n  store-lock / timeout / snapshot / contention tests and passes.\n- Run tests/unit/test_ci_workflow_parity.py (the CI-shape guard) to green.\n- A new guard test asserts a representative set of platform-sensitive files (store lock,\n  stamped_lock, timeout_budget, repo_snapshot, event_append_index_lock, atomic_ticket_dir_create)\n  collect under the marker, so pattern drift fails loudly rather than silently emptying the macOS\n  suite (the failure path).\n\n## Acceptance Criteria\n- [ ] A `platform_compat` marker is registered in pyproject.toml and `pytest -m platform_compat`\n      collects a non-empty set (verified by collection + the new parity guard test).\n- [ ] tests/conftest.py auto-applies `platform_compat` by path via\n      `_PLATFORM_COMPAT_PATH_FRAGMENTS`, and the macOS `DEFAULT_SUITE_MARKS` branch in\n      _build-and-test.yml is `platform_compat and not external` (verified by\n      test_repo_policy_nodes_run_only_in_the_existing_primary_cell).\n- [ ] The Ubuntu default-suite selection is unchanged — the primary/non-primary branches still\n      read `not integration and not external` and `... and not repo_policy` (verified by the same\n      parity test).\n- [ ] tests/unit/test_ci_workflow_parity.py passes in full.\n- [ ] The platform_compat subset runs green locally via\n      `pytest -m \"platform_compat and not external and not integration\"`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"pyproject.toml","reason":"register the platform_compat pytest marker"},{"path":"tests/conftest.py","reason":"auto-apply platform_compat by path in pytest_collection_modifyitems"},{"path":".github/workflows/_build-and-test.yml","reason":"macOS default-suite branch selects platform_compat and not external"},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"update DEFAULT_SUITE_MARKS regex and add macOS-subset coverage guard"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"3cc9473d-b843-4913-bf8c-f614bf797025","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"3ba8-49d5-fee5-445d","ticket_type":"story","title":"Reduce the macOS pytest cell to a platform-compatibility subset","verify_commands":[]},"source_event_uuids":["8277ce10-1286-49cf-b623-dba6e03cfe63","a8baec80-3eaf-4767-8eee-ac9f2cc13d2a","21a264ad-2abb-44b1-8c05-7a0a64107437","3cc9473d-b843-4913-bf8c-f614bf797025","95553e2f-1e07-442e-884b-7009962cf44e","40de27ed-160d-4180-905e-6a7d011b898e","e5006eff-1ec8-46a7-84f1-e9e088421243"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787710107843332002,"uuid":"fba8df0d-5404-432d-9ee9-9dda3811bedd"}