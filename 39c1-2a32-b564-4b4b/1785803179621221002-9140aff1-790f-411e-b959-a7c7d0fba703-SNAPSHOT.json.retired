nd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d69ba70f6ef9af40b0181c6ea7508cd935323441237c927c0fd40124f74da762","event_uuid":"ce49d04d-3a2d-47be-a80d-cb9a27c34abe","position":{"commit_sha":"5e5250c128e88f4378a9e42fc900a4eb6aec9ef0","position":"1785794678585440001-ce49d04d-3a2d-47be-a80d-cb9a27c34abe"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a5a6c48b9355180d25766aed777fd92960f5483e835f8dc8d81e4f6b98957c51","event_uuid":"fa1a29a0-210f-4f32-a822-10ee8f572f4d","position":{"commit_sha":"5b0e052555eceed2ef0301b60c5bba499836bb31","position":"1785797469149649001-fa1a29a0-210f-4f32-a822-10ee8f572f4d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ff797aa8f861e235a5ad8ab5c8e042a368ebcf3016ad72b4e6f98d5ff730cf1d","event_uuid":"69974971-9e5e-4c38-b782-ca7bc71b628b","position":{"commit_sha":"e17a7e69ca0c34fba375e1551c4356ced02cd07d","position":"1785797623553980001-69974971-9e5e-4c38-b782-ca7bc71b628b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"361c20a81b9488f1574d3a8f8be3ccf0c4e561d75d48ec1c296602d621b8656f","event_uuid":"7051ec11-3513-4327-b7b9-90e6a1b24977","position":{"commit_sha":"e7113b83c549d04e98a456377f2c952596e8a7e5","position":"1785803179621221001-7051ec11-3513-4327-b7b9-90e6a1b24977"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"ee14304c-31e8-403a-8276-d36a719f0771","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## CLAIMED, AND THE CHOSEN FIX (satisfies the AC that the decision + rejected option be recorded)\n\n**CHOSEN: option B — DC's `set_parent` writes the EPIC LINK through the Agile API for a non-sub-task\nchild.** The emit gate is left ALONE.\n\nWhy this one, in the terms the ACs ask for:\n\n * It makes the two gates OVERLAP without touching either policy. The emit gate already emits exactly\n   when the local parent's `ticket_type` is `epic` (`outbound_field_diff._resolve_local_parent:136-139`).\n   Teaching the DC apply side to accept an EPIC parent for a non-sub-task child is therefore all that is\n   required for the sets to intersect — and it intersects on the SHAPE THE EMIT GATE ALREADY PREFERS.\n * **It satisfies \"the 8b25 hierarchy guard's Cloud behaviour is UNCHANGED\" for free**, because no line\n   of the emit path changes. `tests/unit/rebar_reconciler/conflict/test_parent_hierarchy_guard.py` keeps\n   passing as-is, which is the strongest form of that AC — untouched code, not re-argued code.\n * It is what the transport's OWN docstring already prescribes as the lift: \"epic-link field id +\n   `add_issues_to_epic` against a real DC instance under `agile_rest_path='greenhopper'`\"\n   (`adapters/jira_datacenter/transport.py:675-689`). The decline at :695-710 was written as a\n   placeholder for exactly this work, naming the mechanism. I am implementing the thing the author\n   deferred, not inventing a route.\n\n**REJECTED: option A — teach the emit gate DC's sub-task shape** (emit a parent when the child is a\nsub-task, whose parent is a standard issue). Rejected for three reasons:\n 1. it would require the emit gate to become DEPLOYMENT-AWARE, so a Cloud-correct hierarchy policy starts\n    branching on backend — the exact coupling the Jira-family seam (ADR 0035 / J2) exists to prevent;\n 2. rebar's local model has no `sub-task` type at all (types are epic/story/task/bug), so \"the child is a\n    sub-task\" is not expressible locally without inventing a fifth type or leaking a remote concept\n    inward;\n 3. it would WEAKEN bug 8b25's guard, whose whole purpose is refusing to write a parent Jira will not\n    accept — and 8b25 was itself a defect fix. Loosening a guard to make a second guard reachable is how\n    this epic got its 63-ticket incident.\n\n### The empirical unknown, and how it gets settled\n\nWhether `add_issues_to_epic` works against DC 8.17.1 under `agile_rest_path='greenhopper'` is NOT\nestablished from documentation — the transport author called it a spike for that reason, and pycontribs\nroutes it to `POST /rest/greenhopper/1.0/epics/{epic_id}/add`, which some DC versions key by epic ID\nrather than key. **This will be settled on the live harness, not by reading.** For anything with a live\noracle the harness is the arbiter — that is the lesson 2b16 and 88d9 both paid for. If the Agile call is\nunavailable, the documented fallback is a direct write of the instance-discovered `Epic Link`\n`customfield_NNNNN`; the fallback stays a fallback, and whichever path is used is recorded here with the\nrun id.\n\n### AC4 — the silent-drop must end regardless of which path works\n\nIndependent of the Epic Link work: a parent that genuinely CANNOT be represented on the deployment must\nraise an OPERATOR-VISIBLE signal instead of vanishing. Today `dispatch_one.py:571-578` swallows\n`set_parent`'s exception (warn-and-continue), and on DC the emit gate drops the field before the decline\nis even reached — which is why this class survived FIVE instances. This is the half of the ticket that\ncarries value even if the platform turns out to refuse the write, so it is built and tested\nindependently of the Epic Link path succeeding.\n\nRED FIRST, per the standing direction on this epic: the pass-level overlap oracle is written and shown\nRED before any transport change, so \"no outbound parent was emitted for DC\" is a failed ASSERTION rather\nthan a passing vacuous test.","timestamp":1785775915080278001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"LOCK PROBE: verifying store writes still work (the session log 558e is refusing writes with flock timeouts).","timestamp":1785776826326054001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## IMPLEMENTED — Gerrit change 1302, awaiting votes\n\nApply-side only, so the 8b25 emit gate is untouched and its Cloud guard tests pass UNEDITED (that is the\n'Cloud behaviour unchanged' AC satisfied by construction rather than by argument).\n\n * 'set_parent' now writes a non-sub-task's parent as an EPIC LINK via 'add_issues_to_epic'; the\n   greenhopper sentinel epic 'none' expresses a CLEAR. The decline survives only where the parent is\n   genuinely unrepresentable (an injected client with no 'add_issues_to_epic').\n * 'build_client_from_settings' now sets agile_rest_path='greenhopper'. Without it the call targets the\n   'agile' path DC does not expose, so the epic-link route would have been DEAD ON ARRIVAL. Found by\n   grepping for the option after writing the transport half; the docstring named it and no code set it.\n * the stale docstring describing the old decline is rewritten — an inaccurate docstring is what\n   contributed to 88d9's incident.\n\nRED first: 'test_dc_epic_link_parent_39c1.py' failed on the real NotImplementedError decline, and the\noverlap cell localised the defect by getting PAST the emit assertion before failing on apply. The\nsub-task regression cell passed throughout, so the working path was protected rather than asserted after\nthe fact. 2047 passed / 1 xfailed over tests/unit/rebar_reconciler; lint + mypy clean; transport 780/800.\n\nSTILL OPEN, and the unit suite does NOT settle it: whether 'add_issues_to_epic' succeeds against DC\n8.17.1. pycontribs routes it to {agile_rest_path}/1.0/epics/{epic}/add and some DC versions key that by\nepic ID rather than KEY. The live cell 'test_outbound_clear_parent_round_trips' is the arbiter. If it\nrejects either the path or the key form, the fallback is a direct write of the instance-discovered\n'Epic Link' customfield_NNNNN. Record the run id and which path worked.\n\nAC4 (an unrepresentable parent must surface an OPERATOR-VISIBLE signal, rather than being swallowed at\ndispatch_one.py:571-578) is NOT in 1302. It is independent of the epic-link path and still owed.","timestamp":1785777537656828001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC4 IS IMPLEMENTED — Gerrit change 1305; and the harness changes what AC1 can claim\n\n### 1305 — the operator-visible signal (AC4)\n\n`update_one`'s parent dispatch caught every `set_parent` failure and emitted a `logger.warning` and\nnothing else. 1305 adds a `bridge_alerts` record on each failure arm, keeping warn-and-continue so a\nparent failure still cannot abort the rest of the batch.\n\nDeliberately the EXISTING channel, not a new one: `apply_handlers.record_backstop_failure` already\nwrites `bridge_alerts` for this exact shape of non-fatal-but-real failure, and\n`jira_datacenter/transitions.py:34-49` documents `IllegalTransitionError` being routed there on\npurpose for the same reason. Inventing a second signal would have split the surface an operator has\nto watch.\n\nThree kinds, because the operator's next move differs and collapsing them would say the same words\nfor very different situations:\n * `outbound-parent-unrepresentable` — the deployment cannot hold the relationship at all\n   (`NotImplementedError` from the transport). No retry and no different parent helps.\n * `outbound-parent-rejected` — the 8b25 HTTP 400; Jira refused THIS parent on hierarchy grounds\n   and a different one would be accepted.\n * `outbound-parent-failed` — anything else.\n\nFail-open by construction: an unwritable state directory degrades to a warning rather than failing a\nmutation that would otherwise land. Observability must not cost delivery.\n\n**Evidence.** RED first — 3 of the 5 cells failed against the pre-change tree for the right reasons\n(no record written; no distinct kind; the pass aborting). One cell's assertion was wrong on the\nfirst draft and was FIXED rather than weakened: a parent-ONLY mutation deliberately skips the scalar\nupdate, so it cannot show the rest of the mutation surviving; the fixture now carries a summary too.\n\n**Mutation-checked (AC5), 4 mutations, all killed, each by exactly one cell:**\n\n    M1  drop the alert on the unrepresentable arm      -> 1 failed  (the core cell)\n    M2  collapse the two kinds into one                -> 1 failed  (the distinct-kind cell)\n    M3  alert unconditionally, including on success    -> 1 failed  (the no-alert-on-success cell)\n    M4  remove the fail-open guard in pass_io          -> 1 failed  (the broken-store cell)\n\nM3 is the one that matters most: without that negative cell, an implementation that alerts on every\nparent op passes everything else here and floods the operator's only divergence channel on the happy\npath — worthless as fast as having no signal.\n\nGates: ruff clean, mypy 419 files clean, **2081 passed / 1 xfailed** across\n`tests/unit/rebar_reconciler` + `tests/integration/rebar_reconciler`; 433 passed again after the\nrebase onto current `gerrit/main` (`30c522cde9`).\n\n**Module size, flagged rather than left at the edge.** The first cut put a thin adapter in\n`dispatch_one` and landed at **794/800** — six lines of headroom, the same trap `binding_store` hit\nat 795. I collapsed the adapter into the `pass_io` helper it wrapped (one function instead of two,\nwhich reads better anyway) and it is now **783/800**. `pass_io` is 274.\n\n### THE HARNESS FINDING THAT BEARS ON AC1 — read this before ticking it\n\nRun **30834117797** (main @ `25ead49f3e`, PRE-1302) reported\n`test_outbound_clear_parent_round_trips` RED, which is expected and is this ticket. But it also\nreported **both directions of the SUB-TASK parent path failing**:\n\n * outbound: *\"fields.parent on RBJUUVX-3 is STILL 'RBJUUVX-1' — the parent it had BEFORE the\n   mutation\"* — read back over raw REST, not through the search index.\n * inbound: `get_parent_map` never reflected a reparent within 90s / 45 attempts.\n\nThis ticket's mechanism analysis rests on \"the one child shape DC accepts (sub-task)\". That premise\nis now in doubt: a search-index lag cannot explain a DIRECT field read returning the pre-mutation\nvalue. Filed as [rebar:1a9f-50c0-e7a5-4fda] rather than absorbed here.\n\n**Consequence for AC1** (\"the emit gate and DC's accepted child shape overlap for at least one real\nconfiguration\"): if the sub-task write is also a no-op on DC 8.17.1, the Epic Link path added in\n**1302** is not a second candidate — it is the ONLY one, and AC1 stands or falls on the next harness\nrun. AC1 must NOT be ticked off the unit suite. That is exactly the mistake 1276 made.\n\n1305 also makes the next run more informative: if DC is ERRORING on these writes and the swallow was\nhiding it, an `outbound-parent-*` alert will now appear; if no alert appears, DC returned success and\nlied, which is the accept-and-ignore reading.","timestamp":1785779634741853001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## CORRECTION — 1305 does NOT make harness run 30840572608 diagnostic. I overstated it.\n\nI claimed (in 39c1's AC4 comment and in e369's HANDOFF #24) that 1305 would let the next harness run\ndistinguish the two readings of the parent no-op:\n\n> if DC is ERRORING on these writes and the swallow was hiding it, an alert will now appear; if no\n> alert appears, DC returned success and lied.\n\n**That is wrong, and it is wrong in the direction that would have let me read a false negative as\nevidence.** I checked before relying on it:\n\n    grep -rn \"bridge_alert\" tests/external/live_jira_dc/      -> nothing\n    grep -rn \"bridge_alerts\" .github/workflows/external-integration.yml -> nothing\n\nNo live cell reads the alert store, and no workflow step prints or uploads it. `record_parent_divergence`\nwrites to `<repo_root>/bridge_state/bridge_alerts/<date>.jsonl` inside the ephemeral runner's working\nrepo, which is destroyed when the job ends. The records are produced and then discarded unread.\n\nSo \"no alert appeared\" in run 30840572608 will mean **nothing was looked at**, not \"DC returned\nsuccess\". Had I not checked, the absence of alerts was exactly the kind of silence I would have been\ntempted to read as a signal — which is the same mistake, in miniature, that this epic keeps paying for.\n\n### What the run CAN and CANNOT settle\n\n**CAN** — whether the Epic Link path works. The parent cells read `fields.parent` (and the epic link)\nback over raw REST and compare against what was written. That is a direct observation and needs no\nalerting.\n\n**CANNOT** — whether a failed parent write ERRORED or was ACCEPTED-AND-IGNORED. That distinction is\n[rebar:1a9f-50c0-e7a5-4fda]'s first acceptance criterion, and it remains open after this run.\n\n### What 1305 is still worth\n\nIt is not wasted: in PRODUCTION the alert store is a real operator surface (`rebar` reads bridge\nalerts; `reads_cli._bridge_alert_warning` surfaces them), and 39c1's AC4 asks for an operator-visible\nsignal in a deployment, not for harness observability. The AC is met. What is missing is a separate\nthing — the harness has no window onto the alert store — and I have recorded that on 1a9f as the\nconcrete way to settle its AC1 rather than leaving it implied.","timestamp":1785781545451866001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## ARBITRATED LIVE: 1302's EPIC LINK PATH DOES NOT WORK ON DC 8.17.1, AND IT REGRESSED A GREEN CELL\n\nRun **30840572608**, job **91776309249**, main @ **`364c4e8f5e`** (carries 1302 + 1303 + 1305).\n`[jira-live-canary] collected=58 executed=57 skipped=1` — **6 failed, 51 passed, 1 xfailed** in 2201s.\n\n### The verdict on AC1: NOT MET. Option B is refuted.\n\n`test_set_parent_declines_the_epic_case_loudly` **FAILED**, and the reason is the platform, verbatim:\n\n    jira.exceptions.JIRAError: JiraError HTTP 404\n      url:  http://localhost:2990/jira/rest/greenhopper/1.0/epic/RBJONBO-1/issue\n      text: null for uri: http://localhost:2990/jira/rest/greenhopper/1.0/epic/RBJONBO-1/issue\n\n**The endpoint does not exist.** `\"null for uri\"` is Jira's unmapped-path response, not a permissions\nor payload error — so this is not the epic-ID-vs-KEY ambiguity the ticket anticipated. The route\nitself is absent on this deployment. Which path worked, as this ticket asked me to record: **none.**\n\n### AND IT IS A REGRESSION — that cell was GREEN one run ago\n\n    run 30834117797 (pre-1302):  PASSED test_set_parent_declines_the_epic_case_loudly\n    run 30840572608 (post-1302): FAILED  (BackendHTTPError 404)\n\nThe cell asserts `pytest.raises(NotImplementedError)` — the DELIBERATE, loud decline. 1302 replaced\nthat decline with a real call, and the call 404s, so the cell now gets the wrong exception type. **1302\nmade this worse, not better:** before it, an epic parent produced a clean, named refusal; now it\nproduces a 404 from a nonexistent endpoint. (Non-fatal either way — the dispatcher warns and\ncontinues, and since 1305 it also raises a `bridge_alerts` entry — but a 404 against a dead route is\nnot a contract, it is an accident.)\n\nThis is the third time this epic has shipped a mutation-proven change whose feature could not fire\n(1276, 1288, now 1302). The unit suite passed 2047 tests. The live cell took one run to refute it.\n\n### THE OTHER FIVE REDS — all previously known, none new\n\n * `test_outbound_create_stamps_both_provenance_markers` — still no binding\n   ([rebar:18a5-2bd8-3e56-4bd8]). Now with `stdout: FILTERED PASS: scope restricted to 1 local IDs`\n   and no traceback, so the create is being planned-or-skipped silently rather than crashing.\n * `test_outbound_set_subtask_parent_round_trips` — `fields.parent` on RBJHBID-3 STILL 'RBJHBID-1'\n   ([rebar:1a9f-50c0-e7a5-4fda], reproduced on a second instance with different keys).\n * `test_inbound_set_subtask_parent_round_trips` — 90s/45-attempt timeout, same as before.\n * `test_inbound_clear_parent_round_trips` — SETUP FAILED, DC refuses the null\n   ([rebar:37e7-d751-0042-4b94], reproduced).\n * `test_outbound_clear_parent_round_trips` — still red. This is 39c1's own cell and it stays red\n   because option B does not work.\n\n**1303 is confirmed working:** `XFAIL test_inbound_delete_link_round_trips - DECIDED, …` — the cell\nxfails with its reason rather than failing, and it did not xpass.\n\n### TWO CANDIDATE FIXES, and 1302 may have chosen the wrong path for a documentable reason\n\n 1. **`agile_rest_path='agile'` instead of `'greenhopper'`.** 1302 set `greenhopper` on the strength\n    of the transport docstring's claim that DC does not expose the `agile` path. **That claim is now\n    suspect**: Jira Software Server/DC 8.x does ship the Agile REST API at `/rest/agile/1.0/`, and\n    the endpoint that 404'd is the *greenhopper* one. This is a ONE-LINE change and the cheapest\n    possible test of the hypothesis.\n 2. **Direct write of the instance-discovered `Epic Link` custom field** — the fallback this ticket\n    documented up front. Discover the id via `GET /rest/api/2/field` (match `name == \"Epic Link\"`),\n    then `PUT /rest/api/2/issue/{child}` with `{\"fields\": {\"customfield_NNNNN\": \"<EPIC-KEY>\"}}`;\n    clear by setting it to `null`. Version-independent and does not depend on any agile route\n    existing.\n\nOption 1 first because it is one line and falsifiable in a single run; option 2 if it 404s too.\n**Neither may be ticked off a unit suite** — that is precisely the error under discussion.\n\n### A SIDE EFFECT OF 1303 WORTH FLAGGING\n\nThe canary now reports `skipped=1` where its contract has always been `skipped=0`, because the xfail\ncounts as a skip in that accounting. **`skipped=1` is now the expected baseline, not an alarm** — but\nthat also means the canary can no longer distinguish \"deliberately xfailed\" from \"silently skipped\nfor want of a harness\", which is the exact failure it exists to catch. A genuine skip would now have\nto reach `skipped=2` to look wrong. Worth tightening to an explicit expected-xfail allowance.","timestamp":1785783679633041001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## THE FALLBACK IS UP — Gerrit 1311, built under HELD-OUT TDD, and the hold-out earned its keep twice\n\nChange **1311**: `set_parent` writes a non-sub-task's parent as an ordinary update to the\ninstance-discovered **\"Epic Link\"** custom field, replacing 1302's refuted `add_issues_to_epic`\nroute. The dead `agile_rest_path=\"greenhopper\"` option goes with it.\n\n### Method — and it differed from every prior change on this epic\n\nRun under the `/rebar-implement` held-out discipline at the operator's direction, which matters\nbecause this epic has now shipped THREE mutation-proven changes whose feature could not fire (1276,\n1288, 1302). The orchestrator authored the full oracle; the **edge and E2E cells were physically\nremoved from the working tree** — not merely omitted from the prompt, since a subagent can read\nfiles — and a SEPARATE implementation subagent was given ONLY the happy-path cell.\n\n    IN THE TREE (implementer saw):  test_epic_parent_on_a_non_subtask_is_written_as_an_epic_link\n    HELD OUT (never saw):           clearing_an_epic_parent_nulls_the_epic_link_field\n                                    the_epic_link_field_is_discovered_once_not_per_call\n                                    a_client_without_fields_declines_rather_than_raising_attributeerror\n                                    an_undiscoverable_epic_link_declines_and_never_writes_fields_parent\n                                    subtask_parent_still_uses_fields_parent\n                                    the_emit_gate_and_dc_apply_now_overlap\n\n### What the hold-out caught — the part worth recording\n\nFirst validation against the restored oracle: **2 of the 6 held-out cells FAILED.**\n\n 1. no caching — the field was rediscovered on every `set_parent`, a REST round trip per parent\n    write on a reparent-heavy pass (the cost concern b586 already had to address here);\n 2. `self._client.fields()` called UNGUARDED — a client without it raised `AttributeError` rather\n    than the attributed decline. Not cosmetic: `dispatch_one` classifies by exception type, so\n    since 1305 that mis-alerts as the retryable `outbound-parent-failed` instead of the accurate\n    `outbound-parent-unrepresentable`.\n\n**Defect 2 is the same mistake I made myself.** Before the operator asked for held-out discipline I\nhad written this implementation inline, and it had the identical unguarded call — my own six cells\nall passed with it present, because every double I wrote has `fields()`. Two independent\nimplementations fell into the same trap. That is not a fluke; it is a generalization trap that only\na test the implementer could not see was going to catch.\n\nPer the protocol the missing BEHAVIOUR was described to the implementer, not the withheld tests —\nso it implemented to a contract rather than over-fitting to an assertion string. Both fixed in one\npass; full oracle then **7/7 GREEN**.\n\n### Teeth — 6 mutations, all killed\n\n    M1  substring match instead of equality (\"Epic Name\" decoy wins)  -> 4 failed\n    M2  drop the per-instance cache                                   -> 1 failed\n    M3  drop the getattr capability guard                             -> 1 failed\n    M4  clear writes the sentinel \"none\" instead of JSON null         -> 1 failed\n    M5  hardcode customfield_10001 instead of discovering it          -> 5 failed\n    M6  never decline (skip the guard)                                -> 2 failed\n\nMy first M6 attempt was malformed — it still raised, so it was a no-op that \"passed\" — and I\nre-ran it properly rather than bank a mutation that proved nothing. Refactoring litmus: the cells\nassert recorded client calls and exception types, not private names or source text, so a rename or\nextraction would not break them.\n\nGates: ruff clean, mypy 421 files clean, **2132 passed** across\n`tests/unit/rebar_reconciler` + `tests/integration/rebar_reconciler`, transport **781/800**.\n\n### The live cell is REWRITTEN, and this is the part to scrutinise\n\n`test_set_parent_declines_the_epic_case_loudly` asserted the epic case DECLINES — correct while no\nfix existed. It is now `test_outbound_epic_parent_round_trips_via_the_epic_link`: seed a real Epic,\n`set_parent` a standard issue under it, read the Epic Link back **over raw REST** (so the write path\nand the proving read share no code), then clear and assert the field is null.\n\nThis is not an inverted assertion hiding a failure — the expected OUTCOME changed because the\nshipped behaviour changed, and the cell still fails if the parent does not land. But it does mean\n**5200's row-12 AC now prescribes the wrong mechanism** (it specifies\n`pytest.raises(NotImplementedError)` for the epic case). Flagged on 5200 rather than silently\ndiverging from it.\n\n### STILL UNSETTLED — do not tick AC1 off this\n\nWhether writing the Epic Link custom field actually takes effect on DC 8.17.1 is NOT established.\nThe unit suite cannot settle it; that is exactly the error 1302 made with 2047 green tests. Only the\nnext harness run decides, and [rebar:1a9f-50c0-e7a5-4fda] gives independent reason for caution —\nDC may accept-and-ignore parent writes. **Record the run id and whether the field actually held.**","timestamp":1785785093209940001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## PREDICTION, RECORDED BEFORE THE RUN — the failure mode I expect if 1311 does not work live\n\nWritten now, deliberately, so a red result is interpretable on sight instead of rationalised\nafterwards. This epic's pattern has been to explain each live failure convincingly *after* seeing\nit; a prediction made in advance is falsifiable and cheap.\n\n### Most likely failure mode: the Epic Link is not on the issue's EDIT SCREEN\n\nJira rejects an update to a field absent from the relevant screen with **HTTP 400** and a body of the\nform:\n\n    {\"errorMessages\":[],\"errors\":{\"customfield_10014\":\"Field 'customfield_10014' cannot be set.\n     It is not on the appropriate screen, or unknown.\"}}\n\nThis is a well-known Jira behaviour and it is **screen configuration, not a code defect**. It is\nplausible here specifically because the harness's scratch project is created from whichever template\nthe DC image happens to ship (the same reason `_subtask_type_name` and `_seed_epic` discover the\nissue types rather than hardcoding them) — nothing guarantees that template puts Epic Link on the\nEdit screen of a standard issue type.\n\n**How to tell it apart from the alternatives, from the run output alone:**\n\n * **HTTP 400 naming the customfield and \"not on the appropriate screen\"** → screen configuration.\n   The code is right; the harness project needs the field added to the screen, or the cell needs to\n   add it during setup. This should be reported as SETUP FAILED, not as a rebar defect.\n * **HTTP 200 and the read-back still shows the OLD value (or null)** → accept-and-ignore, i.e. the\n   same shape as [rebar:1a9f-50c0-e7a5-4fda]. That would be the serious outcome: it would mean DC\n   silently discards parent writes across BOTH the `fields.parent` and Epic Link routes, and the\n   \"silent success\" class this epic exists to eliminate is deeper than one field.\n * **HTTP 404 on a `/rest/agile/` or `/rest/greenhopper/` path** → impossible by construction now;\n   1311 issues an ordinary `PUT /rest/api/2/issue/{key}`. If this appears, something other than\n   `set_parent` is making the call.\n * **`SETUP FAILED ... no 'Epic Link' field`** → the instance has no Jira Software epic fields at\n   all, and the transport's decline is correct; the epic-parent path simply cannot be exercised on\n   this harness.\n\n### What I expect\n\nThe Epic Link write is an ordinary custom-field update on the standard REST v2 endpoint, which is\nfar better-supported on DC than the greenhopper route that 404'd — so I expect it to SUCCEED. But\n1302 was expected to succeed too, on a docstring's authority, so this is a prediction and not a\nclaim. **AC1 is ticked off the harness or not at all.**\n\n### If the screen-configuration mode is what happens\n\nThe fix is in the CELL, not the transport: discover the Edit screen and add the field during setup,\nor fail as SETUP with the field name — the pattern `_seed_epic` already follows for the missing Epic\ntype. Do NOT respond by writing `fields.parent` as a fallback; DC no-ops it, which is the silent\nfailure the whole ticket exists to remove.","timestamp":1785785345020524001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## MY OWN CHANGE CREATED A VACUOUS TEST, AND A GREEN 2132-TEST SUITE HID IT\n\nFound by sweeping the repo for stale references to the refuted greenhopper route — not by any test\nfailing, which is the whole point.\n\n`tests/unit/rebar_reconciler/test_dc_live_oracles_discriminate_5200.py` carried\n`test_dc_set_parent_DECLINES_the_non_subtask_case_by_raising`, asserting the epic case raises\n`NotImplementedError`. Change 1311 makes the epic case WRITE the Epic Link. **That test kept\npassing.**\n\n### The mechanism, because it is subtle and worth remembering\n\nThat module's client double defines only `issue()` — it has **no `fields()`**. 1311's capability\nguard (`getattr(self._client, \"fields\", None)`) therefore returns `None`, the field is\nundiscoverable, and `set_parent` declines. The assertion passes.\n\nSo the cell went green for a reason that has nothing to do with what it claims to test. Its\ndocstring says the decline happens \"because epic membership on DC is an 'Epic Link' custom field\nwritten through the Agile API under the `greenhopper` path\" — a mechanism that is now doubly wrong\n(the Agile route is refuted, and the epic case no longer declines at all). It was testing that a\ntest double is incomplete.\n\n**The guard that caused this is correct behaviour.** Without it the double would have raised\n`AttributeError` and the test would have failed loudly, alerting me. With it, the failure is\nsilent. A correct defensive behaviour masked a stale oracle — worth noting because the instinct\nwould be to blame the guard.\n\n### Why this is the epic's signature failure class, again\n\nThis is the same shape as the `08-assign` cell **this very story had to repair**: an oracle that\npasses whether or not the behaviour under test works. It is also the same shape as the five\n\"silent success\" product bugs (d067, 8d68, 751e, 2b16/88d9, 39c1). The suite reported **2132\npassed** with a dead cell inside it.\n\n### The repair, intent preserved\n\nSplit into two cells rather than deleted, because both behaviours still matter:\n\n * `test_dc_set_parent_USES_A_DIFFERENT_PATH_for_the_non_subtask_case` — the double now carries\n   `fields()` (the real client has it), and the cell asserts the epic path writes the discovered\n   Epic Link and NEVER `fields.parent`. Same intent as before: the two paths must stay\n   distinguishable.\n * `test_dc_set_parent_DECLINES_when_the_instance_has_no_epic_link_field` — the decline survives,\n   narrowed to where it is still correct. Dropping it would have lost coverage of the attributed\n   failure that keeps `dispatch_one`'s classification honest (1305).\n\nBoth mutation-checked: writing `fields.parent` instead of the Epic Link fails the first; removing\nthe decline guard fails the second.\n\n### The transferable lesson\n\n**A test double that lags the real client's interface turns a behaviour change into a silent\ngreen.** When a change makes production code call a NEW method on an injected collaborator, every\nexisting double of that collaborator becomes a candidate vacuous oracle — and none of them will\nfail to tell you. Sweeping for doubles of the changed interface belongs in the checklist next to\nsweeping for callers. This is a second-order argument for the verbosity/staleness review criterion\nfiled as [rebar:95c1-f6eb-0fa9-402e]: the stale DOCSTRING is what led me to the dead ASSERTION.","timestamp":1785785944026548001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## THE APPROVED REWRITE IS INFEASIBLE AS SPECIFIED — inbound cannot SEE an Epic Link parent\n\nChecked before writing the test rather than after, and it is decisive.\n\n### The finding\n\n`JiraDataCenterTransport.get_parent_map` (`transport.py:515-546`) — the ONLY inbound parent read —\nsearches with `fields=\"parent\"` and extracts `fields.parent` alone:\n\n    for issue in self._paged_search(query, fields=\"parent\", rate_limit_retry=True):\n        ...\n        parent = fields.get(\"parent\") if isinstance(fields, dict) else None\n        out[key] = parent.get(\"key\") if isinstance(parent, dict) else None\n\nIt never reads the Epic Link custom field. Confirmed repo-wide: `Epic Link` / `_epic_link` appears\n**only** in `transport.py`'s outbound `set_parent`; nothing on the inbound side references it.\n\n### Why that kills the approved plan\n\nThe agreed rewrite was: clear a NON-sub-task's Epic Link in DC, run an inbound pass, assert the\nlocal parent clears. But inbound never sees an Epic Link parent at all — `get_parent_map` reports\n`None` for that issue BEFORE the clear and `None` after. **There is no observable transition**, so\nthe differ emits nothing and the cell would pass or fail for reasons unrelated to the clear path.\nWriting it would produce exactly the vacuous oracle this epic keeps generating.\n\n### THE LARGER FINDING — change 1311 leaves the parent ASYMMETRIC on Data Center\n\nThis is the part that matters beyond this ticket. After 1311:\n\n    OUTBOUND: rebar WRITES a non-sub-task's parent to the Epic Link custom field   ✅\n    INBOUND:  rebar reads ONLY fields.parent, so it NEVER SEES that parent again   ❌\n\nA parent rebar sets on DC is invisible on the next inbound pass. That is the **same\n\"Cloud has the translation, DC never got its half\" class** this epic exists to eliminate — d067,\n8d68, 751e, 2b16, 88d9, 39c1 — now in a fresh instance, created by the fix for the sixth one.\n\nIt is not a regression (nothing read the Epic Link before either), and it does not make 1311 wrong:\n1311's job was to make the outbound parent emittable, and the emit gate only ever emits an EPIC\nparent, so writing the Epic Link is the correct half. But the ROUND TRIP is not closed, and the\nepic's headline criterion is BIDIRECTIONAL reconcile.\n\nTwo further consequences worth stating plainly:\n * **39c1's AC1 is satisfiable as literally worded** (\"a local parent/child relationship … is ALSO\n   EMITTED for DC\") — emission is the outbound half, which 1311 delivers. The asymmetry does not\n   block that AC. It does mean closing 39c1 must not be read as \"DC parent sync works\".\n * **The idempotence risk is real but unproven**: if outbound writes an Epic Link the next inbound\n   pass cannot see, the differ may keep re-emitting the same parent every pass — the perpetual\n   re-emission shape bug 8b25 was filed for. NOT asserted here; it needs the harness to confirm or\n   refute, and `test_a_repeat_pass_over_a_converged_pair_plans_nothing` is the cell that would show\n   it.\n\n### 37e7 is BLOCKED pending an operator decision\n\nThe approved option is not implementable without first teaching inbound to read the Epic Link, which\nis a larger change than this ticket was scoped for and belongs to the asymmetry, not to the\nplatform refusal. Options are re-presented to the operator rather than chosen here.","timestamp":1785794136228005001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## 1311 IS MERGED — `b301e7513d`. What that does and does NOT establish.\n\n`LLM-Review +1` + `Verified +1`, submitted 22:03. Landed standalone after Gerrit **1314** (my\nparallel comment-hygiene fix) was ABANDONED as superseded — another change, `36e986c188`, fixed the\nsame f124 run-id references first and mine conflicted with it. Rebased onto current main and\nre-verified before submit: hygiene gate exits 0, ruff clean, 30 unit cells green.\n\n**ESTABLISHED:** the epic-parent path is implemented and unit-proven. `set_parent` writes a\nnon-sub-task's parent to the instance-discovered \"Epic Link\" custom field, with the id looked up BY\nNAME and cached per transport; a clear nulls the same field; the decline survives only where the\nfield genuinely cannot be found, and never falls back to `fields.parent`. Built under held-out TDD —\n2 of 6 withheld cells caught real defects the implementer could not see, 6 mutations all killed.\n\n**NOT ESTABLISHED — and AC1 stays unticked until a harness run says otherwise:** whether the write\ntakes effect against DC 8.17.1. This is exactly where changes 1276, 1288 and 1302 each died with a\ngreen unit suite. A prediction was recorded on this ticket BEFORE the run so a red result is\ninterpretable on sight rather than rationalised after; the most likely failure remains the Epic Link\nnot being on the issue's Edit screen, which presents as HTTP 400 naming the customfield and is\nSETUP, not a code defect.\n\n**ALSO NOT ESTABLISHED, and newly known:** the round trip does not close. Inbound never reads the\nEpic Link ([rebar:9bb9-56a3-e9c0-46e9], now a child of this epic). AC1 as WORDED asks only that the\nparent be **emitted** for DC, which this change delivers — but closing 39c1 must not be read as \"DC\nparent sync works\", and I will not word it that way.\n\n**Next:** harness run on the merged sha. Dispatch was deliberately held — `origin/main` was one\ncommit behind `gerrit/main` at submit time, and a run dispatched then would have silently excluded\nthis change. Waiting for the mirror rather than trusting the submit's MERGED status.","timestamp":1785794678585440001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"=== HANDOFF #25 — 1311 landed; AC1 STILL unarbitrated, and the blocker moved again ===\n\n--- HARNESS RUN 30857265932 (main @ `b301e7513d`, WITH 1311) ---\n`collected=58`, **6 failed / 51 passed / 1 xfailed**. Dispatched only after confirming `origin/main`\ncontained the merged sha (it was one commit behind at submit time) and after verifying the run's own\n`headSha` matched — both checks earned; the mirror really was stale.\n\n**THE VERDICT THAT MATTERS — 39c1 AC1 is STILL NOT ARBITRATED, for a THIRD distinct reason:**\n\n    test_outbound_epic_parent_round_trips_via_the_epic_link\n    SETUP FAILED (not a rebar defect): project RBJSXPQ offers no 'Epic' issue type\n    (has ['Sub-task', 'Task'])\n\nThe harness's scratch project cannot create an Epic, so the Epic Link relationship cannot exist, so\nthe cell cannot reach the code. Filed as [rebar:3fe5-c22e-dc2d-4c9e] (child of this epic; 39c1 and\n9bb9 both now `depends_on` it). The three reasons AC1 has gone unproven, in order: the emit/apply\ngates were disjoint → the greenhopper route 404'd → the fixture cannot build the fixture.\n\nThe cell reported SETUP FAILED distinctly rather than as an ambiguous red, so diagnosis cost one\ngrep. `_seed_epic` discovering issue types instead of hardcoding `Epic` is what bought that.\n\nOther five reds are all previously filed and reproduced: 18a5 (no binding), 1a9f x2 (sub-task\nreparent no-op, both directions), 37e7 (DC refuses the sub-task clear), and 39c1's own\n`test_outbound_clear_parent_round_trips`.\n\n--- LANDED TODAY ---\n  1302 `8ab91b3f33`, 1303 `29f9627128`, 1305 `364c4e8f5e`, 1311 `b301e7513d`.\n  CLOSED: 88d9, 2b16 (both `--class preexisting`), 0cfd (duplicate).\n  ABANDONED: 1314 — superseded by `36e986c188`, which fixed the same hygiene refs first.\n\n--- IN REVIEW, a 3-deep stack on `b301e7513d` ---\n  **1319** 18a5 — `assert_bridge_alert_for_mutation`; takes the pass's CompletedProcess as a\n     REQUIRED arg so \"no alert\" cannot be confused with \"nobody looked\".\n  **1320** 1a9f — raw-REST probes (both verb forms + editmeta ops), answering AC1 without depending\n     on any rebar code path. Also carries 37e7's two falsifiers.\n  **1324** 9bb9 — inbound reads the Epic Link. Discovery EXTRACTED and SHARED with `set_parent`\n     (`_resolve_epic_link_field_id`), not duplicated. Caught a latent bug 1311 shipped: the cache was\n     a bare attribute read, which breaks for `__new__`-constructed transports — 3 pagination tests\n     went red when a second caller was wired to it.\n  All three verified together on current main: hygiene 0, ruff clean, mypy 421, 2105 unit tests.\n\n--- OPERATOR RULINGS APPLIED ---\n * Criterion 11 = COVERAGE reading, but bugs filed as CHILDREN of e369, so they block closure.\n   18a5, 1a9f, 37e7, 9bb9, 3fe5 are all children now.\n * Row 12's oracle AMENDED to the Epic Link + raw-REST read-back (the old text prescribed\n   `pytest.raises(NotImplementedError)`, which 1311 inverts).\n * 37e7: NOT RESOLVABLE escalated → ruled \"test it a different way\" (non-sub-task + Epic Link),\n   then found INFEASIBLE until 9bb9 lands, so 37e7 is PARKED behind it.\n * transport.py split APPROVED as its own change → [rebar:465d-c541-5e52-4e62], with a capability-\n   mixin architecture rather than another rescue extraction. It is at **799/800**; nothing further\n   can land in it.\n\n--- WHAT REMAINS FOR e369 ---\n 1. land 1319/1320/1324\n 2. **3fe5 first** — without an Epic issue type, 39c1 AC1 and 9bb9 AC3 can never be proven\n 3. 465d (transport split) before further parent work\n 4. 37e7's rewrite, unblocked by 9bb9\n 5. one more harness run → then close 39c1, 5200, and the epic\n 6. re-run `rebar review-plan e369 --ref <sha>` immediately before the epic close (`--ref` pins it\n    so it does not re-stale as main moves; it currently reads `stale-code`)\n\n--- TWO METHOD NOTES WORTH KEEPING ---\n * Held-out TDD earned its keep twice: on 1311 two of six withheld cells caught real defects,\n   INCLUDING an unguarded `.fields()` call I had made myself when I wrote the same fix inline. Two\n   independent implementations, same trap.\n * My change created a VACUOUS test and a 2132-green suite hid it: a client double lacking `fields()`\n   made the code decline for the wrong reason, so an assertion about epic-vs-subtask paths passed\n   while testing nothing. **When a change makes production code call a NEW method on an injected\n   collaborator, every existing double of that collaborator is a candidate vacuous oracle — and none\n   of them will fail to tell you.**","timestamp":1785797623553980001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC1's PLATFORM QUESTION IS ANSWERED: the Epic Link write WORKS, and my predicted failure did NOT occur\n\nCapability-map run **30863672922**:\n\n    Epic SCRUM-1 created (with Epic Name).\n    PUT /rest/api/2/issue/SCRUM-2 {\"fields\":{\"customfield_10001\":\"SCRUM-1\"}} -> HTTP 204  [req-0040]\n    GET SCRUM-2?fields=customfield_10001 -> \"SCRUM-1\"                                     [req-0041]\n\n**Writing the instance-discovered Epic Link on a child DOES take effect and round-trips.** So change\n1311's mechanism is sound on DC 8.17.1 — the approach that replaced 1302's refuted greenhopper route\nis correct.\n\n**And the failure I predicted before the run did NOT happen.** I recorded that the likeliest failure\nwas the Epic Link not being on the child's EDIT screen, presenting as HTTP 400 \"not on the\nappropriate screen\". The map confirms **Epic Link is indeed NOT on the default edit screen**\n(`epic_link_on_standard_edit_screen: False`, req-0034) — **yet the raw REST PUT still succeeded and\npersisted.** Screen presence did not gate the API write. My prediction had the right mechanism and\nthe wrong consequence, and it is worth recording that screen configuration does not block REST\nwrites on this version, because that assumption would otherwise have shaped the 3fe5 provisioning\nwork unnecessarily.\n\nAlso resolved: `Epic Link = customfield_10001`, `Epic Name = customfield_10003`, and **all three\nsoftware templates yield an Epic issue type** — so [rebar:3fe5-c22e-dc2d-4c9e] is a solvable\nprovisioning change, not a platform limit.\n\n**AC1 still needs the harness cell to EXECUTE** before it is ticked. The platform question is\nanswered; the pass-level assertion is not. That distinction is the whole discipline of this epic and\nI am not collapsing it here.","timestamp":1785803179621221001}],"created_at":1785730356429557001,"creation_channel":"cli","deps":[{"link_uuid":"1c457d30-f992-4038-8e28-e872b459f7c2","relation":"discovered_from","target_id":"5200-e04e-246e-4aae"},{"link_uuid":"393505e2-d8cd-4209-8f86-3c15b6dbc5a6","relation":"relates_to","target_id":"1a9f-50c0-e7a5-4fda"},{"link_uuid":"03207053-68e6-409a-bbed-c706d9d5e3d1","relation":"relates_to","target_id":"b4ec-f371-0ff2-4d19"},{"link_uuid":"159f9e57-e2bd-4c1d-ae6a-2a8278878a03","relation":"relates_to","target_id":"983e-0da7-dde1-4acb"},{"link_uuid":"a6891d75-3d50-4a3e-baf5-29d4904b4ecd","relation":"relates_to","target_id":"70fd-8b23-4a54-4201"},{"link_uuid":"3e977189-cf41-49df-a30d-ffac0882dd87","relation":"relates_to","target_id":"768e-a7b9-090e-44b2"},{"link_uuid":"51982258-200c-493c-91ac-19708432c778","relation":"relates_to","target_id":"f346-96f6-28f3-4308"},{"link_uuid":"1dda0b8b-c697-4068-a262-67fc72b0aac4","relation":"relates_to","target_id":"0a54-87c6-2da9-4f94"},{"link_uuid":"7ad1c227-5e52-41a6-b039-fdb0c4b9f9d3","relation":"relates_to","target_id":"b854-acfa-1abd-4e0f"},{"link_uuid":"fa1a29a0-210f-4f32-a822-10ee8f572f4d","relation":"depends_on","target_id":"3fe5-c22e-dc2d-4c9e"}],"description":"# Outbound parent-set can never be carried by a reconcile pass on Data Center (two gates that do not compose)\n\n## Provenance\n\nFound while building story 5200's missing row-12-OUTBOUND live cell, by an agent instructed to establish\nthe real contract before writing an oracle rather than assume a round-trip was supported. It is a PRODUCT\ngap, not a test gap.\n\n## Mechanism — each gate is defensible alone; on DC they are DISJOINT\n\n**The APPLY side wants a SUB-TASK child.** `adapters/jira_datacenter/transport.py` `set_parent` (:668-712)\nreads the issue, checks `fields.issuetype.subtask` (:693-694), and for a sub-task writes\n`issue.update(fields={\"parent\": {\"key\": parent_key}})` (:711-712). For a NON-sub-task child it raises\n`NotImplementedError` (:695-710) naming the reason: epic membership on DC is the \"Epic Link\" CUSTOM FIELD\nwritten through the Agile API under `greenhopper`, not `fields.parent`. That decline is deliberate and\ncorrect — it stops `fields.parent` being written and silently no-op'd.\n\n**The EMIT side wants an EPIC parent.** `outbound_field_diff._resolve_local_parent:136-139` returns\n`(False, None)` — omitting the parent field ENTIRELY — for any parent whose local `ticket_type` is not\n`epic`. That is bug 8b25's hierarchy guard, built over `local_ticket_types`\n(`outbound_differ.py:475-477`) and already unit-covered by\n`tests/unit/rebar_reconciler/conflict/test_parent_hierarchy_guard.py` — verified UNEDITED: `git diff 7fc96b277 gerrit/main` on that path is EMPTY across the whole epic, and change 1302 adds only a new test file.\n\n**A DC sub-task's parent is a STANDARD issue, which imports as local `ticket_type` `\"task\"`.** So the one\nchild shape DC accepts (sub-task) can only have a parent shape the emit gate refuses (non-epic). The sets\nare disjoint: **no reconcile pass can ever emit an outbound parent-set that DC would accept.**\n\nBoth gates were written for Cloud's next-gen Epic-parent hierarchy, where they compose fine. Nobody\ncomposed them against DC's model.\n\n## Why this is the FIFTH instance of a known class\n\n\"Cloud has the translation, DC never got its half\" — d067 (outbound status submitted as a field edit,\nnever a transition), 8d68 (inbound UPDATE never minted an identity), 751e (empty assignee never\nunassigns), 2b16 / 88d9 (inbound link removal and parent clear never emitted). Every one was a SILENT\nsuccess: no traceback, no alert, the pass reports OK. This is the same shape — a local parent/child\nrelationship simply never reaches Data Center, and nothing reports that it did not.\n\n`dispatch_one.py:571-578` swallows `set_parent`'s exception (warn-and-continue, keyed at :546), so even\nthe DECLINE is invisible; but on DC the decline is not even reached, because the emit gate dropped the\nfield first.\n\n## Scope note — deliberately NOT gating e369\n\nRecorded rather than folded into epic e369, consistent with the operator's ruling on\n`e39f-5055-f5af-424a` (a DC write-path gap ruled follow-up, not gating). Two supporting reasons:\n * the fix is a HIERARCHY-MODEL change, not a patch — either the emit gate learns DC's sub-task shape or\n   DC's `set_parent` learns the Epic Link field. Either is a design pass with a real blast radius.\n * closing e369 does not assert this works. Its operator-attested criterion is bidirectional reconcile\n   (an issue created in DC appears locally; a local EDIT appears in DC), both proven live; no criterion\n   claims outbound parent sync.\n\n**I am flagging this as a BORDERLINE call.** The operator's earlier ruling on the three J11-surfaced\ndefects took the strictest available option, and unlike e39f this one does NOT fail safe — it is a silent\nDIVERGENCE, not a safe refusal. If the operator prefers the strict reading, reparenting this under e369\nis one command. The tension is recorded here on purpose rather than resolved quietly.\n\n## What story 5200 does and does not now cover\n\n5200's row-12-outbound cell (change 1283) asserts the PRIMITIVE at the transport level —\n`dc_transport.set_parent(child, B)` then a raw-REST read-back of `fields.parent` — following the same\nprecedent row 14 outbound set for the same reason. It deliberately does NOT assert the pass-level\nsuppression as correct behaviour, because that would freeze this gap into the suite.\n\n## Acceptance criteria\n\n- [ ] a test asserts, at the pass level, that a local parent/child relationship syncable on Cloud is\n      ALSO emitted for DC — i.e. the emit gate and DC's accepted child shape overlap for at least one\n      real configuration\n- [x] the chosen fix is stated explicitly: either the emit gate learns DC's sub-task shape, or DC's\n      `set_parent` writes the Epic Link custom field through the Agile API — with the rejected option and\n      the reason recorded. Option B (DC set_parent writes the Epic Link through the Agile API) CHOSEN with three reasons; option A (teach the emit gate DC's sub-task shape) REJECTED with three reasons — both recorded in the CLAIMED comment\n- [x] the 8b25 hierarchy guard's Cloud behaviour is UNCHANGED, pinned by its existing tests in\n      `tests/unit/rebar_reconciler/conflict/test_parent_hierarchy_guard.py` — verified UNEDITED: `git diff 7fc96b277 gerrit/main` on that path is EMPTY across the whole epic, and change 1302 adds only a new test file\n- [x] a parent that genuinely cannot be represented on the deployment surfaces an OPERATOR-VISIBLE signal\n      rather than being silently dropped — DONE in change 1305 (merged `364c4e8f5e`): a `bridge_alerts` entry on every set_parent failure arm, three distinct kinds (`outbound-parent-unrepresentable` / `-rejected` / `-failed`), fail-open, warn-and-continue preserved. the swallow at `dispatch_one.py:571-578` is why this class\n      stayed invisible for five instances running\n- [x] mutation-checked, with verdicts recorded here — 1305: 4 mutations, ALL killed, each by exactly one cell (M1 drop-the-alert, M2 collapse-the-kinds, M3 alert-unconditionally, M4 remove-the-fail-open)","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","3fe5-c22e-dc2d-4c9e"],["parent","e369-a449-4773-48fb"],["relates_to","0a54-87c6-2da9-4f94"],["relates_to","1a9f-50c0-e7a5-4fda"],["relates_to","70fd-8b23-4a54-4201"],["relates_to","768e-a7b9-090e-44b2"],["relates_to","983e-0da7-dde1-4acb"],["relates_to","b4ec-f371-0ff2-4d19"],["relates_to","b854-acfa-1abd-4e0f"],["relates_to","f346-96f6-28f3-4308"]],"no_file_impact_reason":"","parent_id":"e369-a449-4773-48fb","parent_status_uuid":"7b8dd6f7-4b74-4373-9f28-aa3998a8ea80","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[]