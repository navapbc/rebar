{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785803179621221002,"compiled_state":{"alias":"limitless-taurine-egret","assignee":"joeoakhart@navapbc.com","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":21,"unsigned":7},"authorship_ledger":[{"content_hash":"3e192cd1a5fc20c4763c3fca144d20379703f92ce488c40bcf564be18801094e","event_uuid":"f15f5e22-2d99-4544-b6cd-f7462ce1c6fe","position":{"commit_sha":"edcd92265ca4f279aa39c6b90d6dbf75f52231e4","position":"1785730356429557001-f15f5e22-2d99-4544-b6cd-f7462ce1c6fe"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b44a8cfd965f526dc0c906db2b03a0dc6617ee6a5ae1daecc49a4811dc90f585","event_uuid":"1c457d30-f992-4038-8e28-e872b459f7c2","position":{"commit_sha":"3c00973ac3b05cdcc99dff1ad11761ad9fdd4018","position":"1785730400712622001-1c457d30-f992-4038-8e28-e872b459f7c2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"80d8398bf1ca5b7fc82044e604b75bce7ffc0aef41209ddb4180a3b3ede59dc2","event_uuid":"55eca4f7-e3cd-4694-8d22-33e4b53832de","position":{"commit_sha":"ac9163c979db383a7b8ca1d26bede1396a06e60b","position":"1785775584922986001-55eca4f7-e3cd-4694-8d22-33e4b53832de"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b2608a99f688ef36414e1fbaeb7c70f03940d5c20f081ec0323f79d843fd95cf","event_uuid":"7b8dd6f7-4b74-4373-9f28-aa3998a8ea80","position":{"commit_sha":"a68ca63d61e6ec973422ac5e0d9ec3d82a9bd49c","position":"1785775781844081001-7b8dd6f7-4b74-4373-9f28-aa3998a8ea80"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4d4dc5c47caf745b58a592f1e16c489044fedf34bddd7e52deeddc592810b91f","event_uuid":"936642a1-4c7a-478b-ac38-adeb131a531b","position":{"commit_sha":"a68ca63d61e6ec973422ac5e0d9ec3d82a9bd49c","position":"1785775782413633001-936642a1-4c7a-478b-ac38-adeb131a531b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"adcda386f396c8e6c1ea4d4799b9f96f9c6994d23ec7b5e5e737e1e4c44c1e12","event_uuid":"8d19b906-cd70-476a-8eca-d40fc8d1e7fa","position":{"commit_sha":"5c14e593237e31505520d1a62dcbce87d18597b3","position":"1785775915080278001-8d19b906-cd70-476a-8eca-d40fc8d1e7fa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c18d27f07530b83274621cda2046ce574b65a04b7dff88ed0fc4e035d6a27457","event_uuid":"11df7ce4-559d-41f9-9b00-c96eda05