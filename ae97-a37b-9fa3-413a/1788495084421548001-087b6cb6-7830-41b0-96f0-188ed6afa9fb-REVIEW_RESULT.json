ms_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Resolve the AC1/AC4 ordering: either verify AC4's doctor findings BEFORE running the AC1 fix, or specify a fixture/injected-state path so `rebar doctor` findings are provable independent of the live host being stalled.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["COH","E6"],"decision":"advisory","decision_margin":-0.0137,"drop_reason":null,"evidence":["AC1: 'cat ~/.local/state/rebar-dev/reject-streak returning 0' and 'readlink ... matching git ls-remote origin main'","AC4: 'rebar doctor emitting both a reject-streak and a build-stale finding on this host'"],"finding":"AC1 and AC4 have a sequencing/state conflict: AC1's checks require the streak to be 0 and current==origin/main after a fix, but AC4 requires `rebar doctor` to emit BOTH a reject-streak and a build-stale finding 'on this host' — which can only be observed while the host is still stalled/stale. Once AC1 is satisfied the live conditions AC4 checks against no longer exist.","group_criteria":null,"group_id":null,"id":"fd7e46526dfa00679","impact":0.67,"is_primary":null,"location":"AC1 vs AC4","norm_id":"n685213ada3bae6b7","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["Executor fixes the updater (AC1), then cannot reproduce the stalled/stale state to demonstrate AC4's doctor findings live"],"severity":null,"suggested_fix":"Note that AC4's doctor findings are captured against the pre-fix host state (or via the pytest fixture in test_doctor_build_freshness.py) before AC1 is applied.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] State AC2's failure-arm disposition explicitly: when no uv satisfies the candidate pin, say whether the run is transient (leaves `current` untouched, retries next tick) or fatal, so it cannot silently re-stall.","cohort":["E3","E5","G5","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["project.failure-disposition-contract"],"decision":"advisory","decision_margin":-0.4812,"drop_reason":null,"evidence":["\"the run fails with a message naming the required version, each version found, and each path inspected\"","AC1's existing log line \"candidate rejected at sync; current left untouched\" implies a soft-retry disposition that AC2's hard-fail may or may not preserve"],"finding":"AC2 alters the resolver's failure path (no available uv satisfies the candidate's pin) to fail with a diagnostic message, but the plan never states the DISPOSITION of that failed run: whether it leaves `current` untouched and simply retries on the next hourly tick (recoverable/transient), or is a terminal/permanent stop requiring operator action. The prior behavior ('candidate rejected at sync; current left untouched') is an effective soft-retry; the new hard-fail arm's disposition is unstated.","group_criteria":null,"group_id":null,"id":"fa356c8e3afed8bf9","impact":0.67,"is_primary":null,"location":"AC2","norm_id":"nc903d77702370390","priority":0.4188,"reason":"default-advisory","recalled":false,"scenarios":["An hourly run where no local uv satisfies the moving pin: does the agent keep `current` on the last-good build and retry next hour (transient), or hard-stop and re-enter the same silent-stall it is meant to fix?"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify AC4's behavior when ~/.local/state/rebar-dev is absent (no finding vs. explicit not-installed) and whether reject-streak/build-stale are advisory-only (outside the exit code, mirroring the existing HOME-sourced mcp_client_findings precedent).","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.1812,"drop_reason":null,"evidence":["\"Checked by `rebar doctor` emitting both a `reject-streak` and a `build-stale` finding on this host\"","doctor.py already treats HOME-sourced findings (mcp_client_findings) as deliberately advisory and OUTSIDE the exit code: 'read from the operator's HOME, not from the store, so folding them into this exit code would make a store-health gate depend on whichever ... happen to sit on the box'","AC4 names only 'this host'; most doctor invocations have no ~/.local/state/rebar-dev/"],"finding":"AC4 requires `rebar doctor` to emit `reject-streak` and `build-stale` findings, sourced from host-local ~/.local/state/rebar-dev state, but `rebar doctor` runs on any developer laptop and in CI where that state directory does not exist; the plan does not specify the behavior (silent no-finding vs. an 'unreadable'/'not-installed' report) when the rebar-dev-update state is absent, nor whether these advisory findings feed the doctor exit code.","group_criteria":null,"group_id":null,"id":"f449bc1490132cfce","impact":0.67,"is_primary":null,"location":"Acceptance Criteria — AC4","norm_id":"n0e267427eb3ae347","priority":0.4188,"reason":"default-advisory","recalled":false,"scenarios":["A dev runs `rebar doctor` on a machine with no rebar-dev updater installed.","CI runs doctor as a health gate on a runner with no such state directory."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["verify command `grep -c 'Required uv version' ~/.local/state/rebar-dev/update.log` greps the unanchored word 'Required' — it substring-matches (e.g. 'review_Required'); anchor it (\\b, ^$, or a quoted key like '\"Required\":')","verify command `cat ~/.local/state/rebar-dev/reject-streak` inspects output with `cat` but asserts nothing — add an exit-code or comparison (-q, [ \"$(...)\" -eq N ], jq -e) so a failure is observable","verify command `ls ~/.local/state/rebar-dev/releases` inspects output with `ls` but asserts nothing — add an exit-code or comparison (-q, [ \"$(...)\" -eq N ], jq -e) so a failure is observable"],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate the `rebar doctor` edit targets AC4 requires — the doctor command/finding model in `src/rebar/_commands/doctor.py` and the closed `kind` enum in `src/rebar/schemas/doctor.schema.json` — and specify how `reject-streak`/`build-stale` extend them.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"dropped","decision_margin":-0.7,"drop_reason":null,"evidence":["AC4: \"`rebar doctor` emitting both a `reject-streak` and a `build-stale` finding on this host\"","src/rebar/schemas/doctor.schema.json:17-19 — \"kind\": {\"enum\": [\"ancestor-blocking\", \"mis-escalated\", \"unreadable\"]}","doctor.schema.json:5 describes each finding as \"a net-active blocking edge that disagrees with the structural link rule\" — a different concept from host build-freshness","src/rebar/_commands/doctor.py module docstring frames doctor as a blocking-edge/link + lock-health audit only"],"finding":"AC4 adds two new `rebar doctor` finding kinds (`reject-streak`, `build-stale`) but does not enumerate the doctor finding model / JSON schema that constrains findings — `src/rebar/schemas/doctor.schema.json` pins the finding `kind` to a closed enum `['ancestor-blocking','mis-escalated','unreadable']` and describes findings as net-active blocking edges from the structural-link audit, so the new host-health kinds are an unenumerated consumer a change must update.","group_criteria":null,"group_id":null,"id":"f80f3d3b67efd71a4","impact":0.0,"is_primary":null,"location":"AC4","norm_id":"n6dd1b02ae7eabf9e","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["Emitting a build-stale/reject-streak finding through `rebar doctor --output json` fails schema validation against the closed `kind` enum","A reviewer of the implementation cannot tell which module (doctor.py) and schema the new finding kinds land in"],"severity":null,"suggested_fix":"In AC4, name `src/rebar/_commands/doctor.py` and `src/rebar/schemas/doctor.schema.json` as edit targets and state that the finding `kind` enum (and the schema's link-audit-only description) is extended to admit the two host build-freshness finding kinds.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify that the `rebar doctor` build-stale/reject-streak finding no-ops (not errors, not false-positives) when `~/.local/state/rebar-dev/` state is absent, and cover the absent-state case in `test_doctor_build_freshness.py`.","cohort":["E3","E5","G5","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":-0.615,"drop_reason":"novelty","evidence":["\"rebar doctor emitting both a reject-streak and a build-stale finding on this host\"","Testing section: \"rebar-dev-update.sh is machine-local and git-ignored, so it lies outside any test's reach\" — implying most hosts lack this state entirely"],"finding":"AC4 adds a `rebar doctor` `reject-streak` / `build-stale` finding that reads host-local state under `~/.local/state/rebar-dev/`, but the plan does not state that this consumer tolerates the ABSENCE of that state — on any host with no rebar-dev updater (the common case, since the script is machine-local and git-ignored) the finding path must no-op rather than error or falsely fire.","group_criteria":null,"group_id":null,"id":"fa7f2dcf93b3cefa9","impact":0.67,"is_primary":null,"location":"AC4","norm_id":"nab2573a8da80a3d1","priority":0.335,"reason":"default-advisory","recalled":false,"scenarios":["A developer or CI host running `rebar doctor` with no `~/.local/state/rebar-dev/` directory: the build-stale check must skip cleanly, not raise on a missing symlink or emit a spurious finding."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Make AC1's freshness check race-free: capture the origin/main sha the run resolved at sync time (e.g. compare `current` against the sha recorded in update.log for that run, or re-check that `current` is an ancestor of / equal-or-newer-than the pre-run ls-remote), rather than against a live `git ls-remote` sampled after the build.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.27,"drop_reason":"novelty","evidence":["\"publishes a `current` whose sha equals `origin/main` at that moment\"","\"Checked by `readlink ~/.local/state/rebar-dev/current` matching `git ls-remote origin main`\"","Symptom section: build is '201 commits behind origin/main ... and climbing hourly' — main is a moving target"],"finding":"AC1's success check compares readlink current against a freshly-computed git ls-remote origin main, but the plan's own premise is that origin/main advances hourly; if main moves between the kickstart completing and the operator running ls-remote, the equality check fails even when the updater behaved correctly.","group_criteria":null,"group_id":null,"id":"f480d2c5ef6d612c0","impact":0.44,"is_primary":null,"location":"Acceptance Criteria — AC1","norm_id":"ne961e291fe8a031a","priority":0.33,"reason":"default-advisory","recalled":false,"scenarios":["A commit lands on main during the ~seconds/minutes the kickstarted run takes to build and publish; the operator's ls-remote returns the newer sha and the AC reads as failed despite a correct run."],"severity":null,"suggested_fix":"Assert that the published `current` equals the origin/main sha the run itself resolved (recorded in update.log), instead of a fresh ls-remote taken after the run completes.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_en