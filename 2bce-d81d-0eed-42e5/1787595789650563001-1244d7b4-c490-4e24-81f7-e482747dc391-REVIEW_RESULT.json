d desired state.","container pairing: parent + 1b8b-fa85-b280-42ee/38f8-9409-ac3b-4408/5cda-6f1e-533f-4e0b/881f-2df2-f3bc-4f95/c119-2f8c-dfb2-4f52/c479-74a6-8b3b-4171/c92d-2b20-273c-4f78/dde7-d1a4-bb8e-4432"],"finding":"Parent acceptance criterion AC2 defines the landing gate as 'LLM-Review +1, Verified +1', but child 38f8's plan/ACs document that both LLM-Review and Verified must reach MAX (which per Gerrit label ranges is typically +2, not +1). If the project.config MAX for these labels is +2, the parent's '+1' gate description contradicts the authoritative gate the children implement and describe, so the completion verifier cannot reconcile 'landed after +1' with a config that requires MAX.","group_criteria":null,"group_id":null,"id":"f8fde8a1ddda0bb03","impact":0.0,"is_primary":null,"location":"child 38f8-9409-ac3b-4408 (vs parent AC2)","norm_id":"n2534559bd6995972","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["A reviewer applies +1 (not MAX) to a repository child per parent AC2 wording, but submit requirements enforce MAX, so the change cannot land — the parent AC and the config-derived runbook disagree on the passing threshold."],"severity":"none","suggested_fix":"Restate parent AC2 to require each label at its configured MAX (matching project.config and child 38f8) rather than a hardcoded +1, or confirm MAX==+1 for both labels and note it.","tier":"LLM","validity":0.25,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none"