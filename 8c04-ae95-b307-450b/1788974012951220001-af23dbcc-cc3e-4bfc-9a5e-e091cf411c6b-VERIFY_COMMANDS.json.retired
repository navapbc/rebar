{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c '\nimport ast, io, subprocess, tokenize\nfrom pathlib import Path\nB = \"HEAD^\"\nA = {\"src/rebar/_engine_support/reads.py\":[\"module\",\"sort_states\",\"tracker_dir\",\"_sync_disabled\",\"ensure_fresh\",\"inbound_deps_state\",\"lean_projection\",\"list_states\",\"recent_session_logs_state\"],\"src/rebar/attest/authorship_resolution.py\":[\"resolve_event_commit\",\"resolve_position_commit\",\"build_ticket_position_commit_map\",\"build_introducing_commit_map\",\"build_position_commit_map\"],\"src/rebar/graph/_links.py\":[\"_write_link_event\",\"add_dependency\",\"remove_dependency\"],\"src/rebar/opcert_service/app.py\":[\"module\"],\"src/rebar/opcert_service/workspace.py\":[\"module\",\"_git\"]}\nTOKENS = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in A[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                qualified = f\"{prefix}.{child.name}\" if prefix else child.name\n                visit(child, qualified)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    found = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type != tokenize.COMMENT:\n            continue\n        body = tok.string[1:].lstrip()\n        if tok.string.startswith(\"#!\") or any(body.startswith(prefix) for prefix in TOKENS):\n            found.append(lines[tok.start[0] - 1])\n    return found\nfor path in A:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\n'","dd_id":"immutable-prose-only","dd_text":"Only allowlisted prose may change; after stripping those owner docstrings, implementation parent and final AST/runtime trees match, with only TypeIgnore.lineno normalized, and directive/shebang physical lines are identical."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess; expected=set([\"src/rebar/_engine_support/reads.py\",\"src/rebar/attest/authorship_resolution.py\",\"src/rebar/graph/_links.py\",\"src/rebar/opcert_service/app.py\",\"src/rebar/opcert_service/workspace.py\"]); actual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":sorted(expected),\"actual\":sorted(actual)}'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/unit/test_sort_states.py tests/unit/test_read_freshness_parity.py tests/interfaces/facades/test_mcp_list_read_surface.py tests/interfaces/contracts/test_pinned_ticket_read_failed_0aee.py tests/unit/test_authorship_batched_ticket_map_7084.py tests/unit/test_identity_perf_1cc0.py tests/unit/test_verify_identity_a2c7_perf.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/interfaces/lifecycle/test_unlink_relation_scoped_e39f.py tests/interfaces/store/test_link_broken_pipe_persists.py tests/unit/test_opcert_service_app.py tests/unit/test_ensures_boot_budget_e43f.py tests/unit/test_git_timeout_bounds_77e1.py tests/unit/test_network_fetch_stall_abort_851e.py","dd_id":"focused-contracts","dd_text":"Focused tests for every preserved subsystem contract pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_engine_support/reads.py src/rebar/attest/authorship_resolution.py src/rebar/graph/_links.py src/rebar/opcert_service/app.py src/rebar/opcert_service/workspace.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788974012951220001,"uuid":"af23dbcc-cc3e-4bfc-9a5e-e091cf411c6b"}