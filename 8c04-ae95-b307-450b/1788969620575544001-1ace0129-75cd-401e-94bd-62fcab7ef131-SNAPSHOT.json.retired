20ea31c92f99802a711068fdb0bda58b15d575c363cb113a3a9da5da1fc4875","event_uuid":"2c05a04c-7689-4c71-aa9a-2f2b7356c3ca","position":{"commit_sha":"e9cce16120e732f8f0aa4ac2822b76526b8da561","position":"1788967707617267001-2c05a04c-7689-4c71-aa9a-2f2b7356c3ca"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2a080c35858b7796253a36a4b35cb0e3eeacc115166e90502454472e0c7a89b7","event_uuid":"9c71700a-b7d5-40e7-be15-69760783e0dc","position":{"commit_sha":"cca76f5dc5cb6f75a11dd125d247a45b8c4acd81","position":"1788967777083360001-9c71700a-b7d5-40e7-be15-69760783e0dc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Execution blocked before edits: the signed plan requires base/final AST and non-allowlisted-source equality against immutable base d49fea41cc383dc70d465903e94598a6dc790bd1, but current origin/main c8af0eb82f2656b1102a137169bdb436cb2872bd already differs in src/rebar/_engine_support/reads.py. Current lines 494-508 add a non-allowlisted lean-reduce comment and executable omit_fields=() if include_body else LEAN_OMITTED_FIELDS; neither exists at the immutable base. Therefore the required oracle cannot pass even with no remediation edits. Worktree is clean and no source was changed. This leaf needs its audit base/allowlist and plan certification refreshed by a separate planning pass; it is being released without force.","timestamp":1788967707617267001}],"created_at":1788570655761915585,"creation_channel":"mcp","deps":[{"link_uuid":"15d16fcc-497a-402a-b4cd-6b07418167db","relation":"supersedes","target_id":"24cb-6ed5-658a-4ca6"},{"link_uuid":"d894936f-48b2-46b7-942a-c915aaa626b6","relation":"supersedes","target_id":"2992-af5d-3bb5-42d3"},{"link_uuid":"8bab1b51-3dcd-4e3c-985c-a4c8fa6b329c","relation":"supersedes","target_id":"3edb-6b89-29cc-46e3"},{"link_uuid":"ce648807-e4cf-4869-b2f1-3729abb3dd23","relation":"supersedes","target_id":"7699-28ee-23a4-4ee3"},{"link_uuid":"5f1699a6-0f82-425b-9078-f11ab5107426","relation":"supersedes","target_id":"04ca-92be-ba1f-4f9a"},{"link_uuid":"33ed0c72-c7ce-4827-8331-029f0315cd79","relation":"relates_to","target_id":"f365-34f2-c72c-4074"}],"description":"## Context / immutable audit base\nAt d49fea41cc383dc70d465903e94598a6dc790bd1, these five files contain 36 confirmed bloated prose blocks. The former older-SHA ranges mixed executable code, section labels, directives, and concise/load-bearing docs while missing long read, ancestry, graph, and op-cert explanations. Lines are immutable-base citations only.\n\n## Exact prose allowlist\nA stable ID is the full path plus :: plus the listed suffix. Only these blocks may change.\n\n- src/rebar/_engine_support/reads.py (18): module-docstring@1-22; sort_states-docstring@71-77; tracker_dir-docstring@100-110; tracker_dir::comment(A repo-root was supplied)@141-148; module::comment(Read-path reconverge waits only briefly)@160-164; _sync_disabled-docstring@210-215; ensure_fresh-docstring@225-233; ensure_fresh::comment(sync.pull and tickets.branch are code-repo config)@236-240; ensure_fresh::comment(Claim the throttle window before reconverging)@275-280; ensure_fresh::comment(Reconverge in-process)@286-290; inbound_deps_state-docstring@321-334; show_state::comment(Show emits the same compiled-state shape)@361-364; _load_scratch::comment(scratch.base_dir via typed config)@379-384; module::comment(Fields a discovery list never consumes)@416-425; lean_projection-docstring@437-443; list_states-docstring@448-463; search_state::comment(Enrich each state with its bound Jira key)@580-584; recent_session_logs_state-docstring@608-612.\n- src/rebar/attest/authorship_resolution.py (5): resolve_event_commit-docstring@11-30; resolve_position_commit-docstring@71-82; build_ticket_position_commit_map-docstring@119-154; build_introducing_commit_map-docstring@213-243; build_position_commit_map-docstring@293-315.\n- src/rebar/graph/_links.py (5): _is_active_link::comment(SNAPSHOT fallback)@92-97; _write_link_event-docstring@127-147; add_dependency-docstring@222-244; add_dependency::comment(Steps zero-one validate relation grammar)@245-251; remove_dependency-docstring@353-370.\n- src/rebar/opcert_service/app.py (3): module-docstring@1-20; lifespan::comment(An app-owned executor)@59-66; lifespan::comment(Bound the cancel and await)@77-80.\n- src/rebar/opcert_service/workspace.py (5): module-docstring@1-11; module::comment(Wall-clock bound on every git subprocess)@23-30; module::comment(Write-lock acquisition budget)@33-39; _git-docstring@60-70; _populate::comment(Converge the freshly-mounted tracker)@141-145.\n\n## Contracts, consumers, and exclusions\nPreserve the single read implementation, sort/null rules, relocated-store resolution, short-lock freshness, throttle-before-sync, inbound-edge derivation, show/list/search shape, lean omission set, filtering, Jira-key enrichment, and session-log ordering. Preserve oldest-add commit semantics, full-history/no-merge/no-rename walks, record framing, map fallback, and fail-closed resolution. Preserve link idempotency/cycle/promotion/reciprocal semantics and durable-write-before-output order. Preserve op-cert async API/authentication, app-owned executor shutdown, authoritative workspace, git/stall bounds, boot lock budget, and stripped remotes.\n\nNo allowlisted docstring is directly read via __doc__/inspect.getdoc. FastAPI does consume the decorated health/submit_job/get_job docstrings for OpenAPI; those concise docs are deliberately outside the allowlist. Preserve reads.py tickets-boundary-ok line 122 and BLE001 lines 295/297/549; authorship_resolution.py BLE001 lines 64/112/208/288/366; _links.py T201 line 258; app.py BLE001 line 202; workspace.py raw-git-ok lines 58/88. All other non-allowlisted prose, runtime strings, assertions, fixtures, decorators, subprocess arguments, config keys/values, directives, and shebangs remain byte-identical.\n\n## Verification and independent review\nParse base/final Python with type_comments=True; strip only allowlisted owner docstrings, normalize only ast.TypeIgnore.lineno, and require remaining AST/runtime equality plus directive/shebang physical-line equality. Require exact HEAD^..HEAD paths. Run focused read/ancestry/link/op-cert contracts, path diff-check, hygiene, and untimed worktree-venv make verify.\n\nA non-author reviewer records a leaf-linked TSV with exactly 36 PASS rows: stable_id, before_citation, final_citation, preserved_contract_or_consumer, directives_exact, before_words, final_words, reviewer_session, semantic_pass, bloat_pass. Every block must shrink.\n\n## Acceptance Criteria\n- [ ] Exactly the 36 allowlisted blocks are shortened; all other prose/directives are unchanged.\n- [ ] The immutable AST/runtime and directive oracle passes for all five files.\n- [ ] Every read, ancestry, graph, op-cert, and workspace contract has an independent-review PASS citation.\n- [ ] HEAD^..HEAD changes exactly the five paths; focused checks, diff-check, hygiene, and make verify exit 0.\n- [ ] The independent TSV has exactly 36 complete PASS rows with lower final word counts.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_engine_support/reads.py","reason":"Condense only 18 audited read-path prose blocks while preserving sort, relocation, freshness, shape, lean-projection, filtering, enrichment, session-log, and directive contracts."},{"path":"src/rebar/attest/authorship_resolution.py","reason":"Condense only 5 audited ancestry-resolution docstrings while preserving oldest-add semantics, full-history walk flags, record framing, fallbacks, fail-closed behavior, and directives."},{"path":"src/rebar/graph/_links.py","reason":"Condense only 5 audited graph-link prose blocks while preserving idempotency, cycle/promotion/reciprocal semantics, durable-write-before-output ordering, and the T201 directive."},{"path":"src/rebar/opcert_service/app.py","reason":"Condense only 3 audited app/lifespan prose blocks while preserving async API/authentication, app-owned executor shutdown, OpenAPI-consumed endpoint docs, and directives."},{"path":"src/rebar/opcert_service/workspace.py","reason":"Condense only 5 audited workspace prose blocks while preserving authoritative-state isolation, git/stall bounds, boot lock budget, stripped remotes, and raw-git directives."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","d6eb-1c6c-88c3-48f6"],["relates_to","f365-34f2-c72c-4074"]],"no_file_impact_reason":"","parent_id":"d6eb-1c6c-88c3-48f6","parent_status_uuid":"9c71700a-b7d5-40e7-be15-69760783e0dc","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"8c04-ae95-b307-450b","ticket_type":"task","title":"Condense comments in src/rebar — cohort 02: reads–workspace","verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c '\nimport ast, io, subprocess, tokenize\nfrom pathlib import Path\nB = \"d49fea41cc383dc70d465903e94598a6dc790bd1\"\nA = {\"src/rebar/_engine_support/reads.py\":[\"module\",\"sort_states\",\"tracker_dir\",\"_sync_disabled\",\"ensure_fresh\",\"inbound_deps_state\",\"lean_projection\",\"list_states\",\"recent_session_logs_state\"],\"src/rebar/attest/authorship_resolution.py\":[\"resolve_event_commit\",\"resolve_position_commit\",\"build_ticket_position_commit_map\",\"build_introducing_commit_map\",\"build_position_commit_map\"],\"src/rebar/graph/_links.py\":[\"_write_link_event\",\"add_dependency\",\"remove_dependency\"],\"src/rebar/opcert_service/app.py\":[\"module\"],\"src/rebar/opcert_service/workspace.py\":[\"module\",\"_git\"]}\nTOKENS = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in A[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                qualified = f\"{prefix}.{child.name}\" if prefix else child.name\n                visit(child, qualified)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    found = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type != tokenize.COMMENT:\n            continue\n        body = tok.string[1:].lstrip()\n        if tok.string.startswith(\"#!\") or any(body.startswith(prefix) for prefix in TOKENS):\n            found.append(lines[tok.start[0] - 1])\n    return found\nfor path in A:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\n'","dd_id":"immutable-prose-only","dd_text":"Only allowlisted prose may change; after stripping those owner docstrings, base and final AST/runtime trees match, with only TypeIgnore.lineno normalized, and directive/shebang physical lines are identical."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess; expected=set([\"src/rebar/_engine_support/reads.py\",\"src/rebar/attest/authorship_resolution.py\",\"src/rebar/graph/_links.py\",\"src/rebar/opcert_service/app.py\",\"src/rebar/opcert_service/workspace.py\"]); actual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":sorted(expected),\"actual\":sorted(actual)}'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/unit/test_sort_states.py tests/unit/test_read_freshness_parity.py tests/interfaces/facades/test_mcp_list_read_surface.py tests/interfaces/contracts/test_pinned_ticket_read_failed_0aee.py tests/unit/test_authorship_batched_ticket_map_7084.py tests/unit/test_identity_perf_1cc0.py tests/unit/test_verify_identity_a2c7_perf.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/interfaces/lifecycle/test_unlink_relation_scoped_e39f.py tests/interfaces/store/test_link_broken_pipe_persists.py tests/unit/test_opcert_service_app.py tests/unit/test_ensures_boot_budget_e43f.py tests/unit/test_git_timeout_bounds_77e1.py tests/unit/test_network_fetch_stall_abort_851e.py","dd_id":"focused-contracts","dd_text":"Focused tests for every preserved subsystem contract pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_engine_support/reads.py src/rebar/attest/authorship_resolution.py src/rebar/graph/_links.py src/rebar/opcert_service/app.py src/rebar/opcert_service/workspace.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"source_event_uuids":["ef04b158-5a98-4e15-a985-ddaf0e9d6df8","eb76e05f-dd95-4793-8d38-33d3b4f65b27","f2e5a4ef-e8a9-4133-8cd4-b838c793838f","b88dd1b0-3efa-42d5-b468-e96fa0e79d76","d7db26c3-05a3-47bf-bac2-416cb07e7a0e","0bb9b885-ec80-49f9-aaf4-b018e025720c","97a2e380-ab92-4984-ac71-5894f3b230cf","5fb4a7c7-e71a-4683-8a35-479492b97eba","4da0eb7d-b7cb-4fc8-a76b-6b467b5574f2","cff31cd8-15ab-490c-bee8-806b62ba7623","33ed0c72-c7ce-4827-8331-029f0315cd79","2c05a04c-7689-4c71-aa9a-2f2b7356c3ca","9c71700a-b7d5-40e7-be15-69760783e0dc"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788969620575544001,"uuid":"1ace0129-75cd-401e-94bd-62fcab7ef131"}