{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788969620575544001,"compiled_state":{"alias":"cloudy-primitive-scaup","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"84ef284833beb747cda637c6d8bd1e561798f170","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 8c04-ae95-b307-450b","material: 2bb8344597a502f6","material-part: children 647ea2107ca5072f 0","material-part: description afcf7b6ebee50a3f 4888","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 1205c5743bd45ac1 5","material-part: ticket_id 240dcb2dac502e76 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.13.1 (84ef284833be)","regver: aa61189569d34126","verified-at-sha:1d60c5f72ff008ddc3acdff42fd5b84ecdfb2752","dep 564b1ce3373556183b1b895d06ff9393e1757bec97e5d8efcbc37517dd837464 src/rebar/_engine_support/reads.py","dep a754e37519959d28a46868cabe1ff1319a027c752fb0a675d9030271e07b759b src/rebar/attest/authorship_resolution.py","dep f713a07535c923b91b9d2a851c82bb2f2bec0ead4b64a2d8222103402d375e08 src/rebar/graph/_links.py","dep ea4fbd8d95329d48ef158eebaba9a08dc554d73b00bdab335a6325b901da1d44 src/rebar/opcert_service/app.py","dep 9ebd4e991d9f197ab6618542e567349dac4739a3b13d5db1fce132ce5613b460 src/rebar/opcert_service/workspace.py","read-set: 5","read-path: src/rebar/_engine_support/reads.py","read-path: src/rebar/attest/authorship_resolution.py","read-path: src/rebar/graph/_links.py","read-path: src/rebar/opcert_service/app.py","read-path: src/rebar/opcert_se