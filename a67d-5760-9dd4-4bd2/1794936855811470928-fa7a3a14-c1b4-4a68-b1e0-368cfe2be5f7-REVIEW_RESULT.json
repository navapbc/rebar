up_id":null,"id":"f28ef68d86a3977ba","impact":0.55,"is_primary":null,"location":"Scope / src/rebar/_commands/reclaim_collapse.py `_StreamedRewrite` docstring (lines ~420-426)","norm_id":"n2d4779d9d4d471f8","priority":0.4125,"reason":"default-advisory","recalled":false,"scenarios":["A future maintainer reads the docstring, believes the streamed engine must match the old writer's parents, and 'restores' the checkpoint parent, which brings the grandfathering bug back."],"severity":null,"suggested_fix":"In the Scope bullet for reclaim_collapse.py, add: \"and the `_StreamedRewrite` docstring, which must now say that a replayed commit whose original parent is the boundary is parented on the ledger anchor, so the anchor (enforce_since) is an ancestor of every replayed commit.\"","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["3 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] In `_replay`, decide and document what happens when a replayed merge's boundary parent and an outside-range parent both resolve to the anchor (duplicate check reduces the parents to one), and add a regression case if parent count must be preserved.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.6,"drop_reason":null,"evidence":["reclaim_collapse.py:512-516: `mapped = self.old_to_new.get(parent)`; `if mapped is None and parent not in in_range: mapped = self.current_tip`; `if mapped is not None and mapped not in new_parents: new_parents.append(mapped)`","reclaim_collapse.py:505: `self.current_tip = self.ledger_anchor_sha` before the first replay","Plan: \"Its expectations are parent counts and SNAPSHOT SHA mappings, and both still hold.\" (true for the `_build_branchy_store` fixture, whose merge parents are both in range, but not in general)"],"finding":"Mapping the boundary parent to `self.ledger_anchor_sha` interacts with the duplicate-parent check in `_replay`. A parent outside the range that is not in `old_to_new` already maps to `self.current_tip`, which is the anchor while the first commit is being replayed. So a replayed merge whose parents are [boundary, X], with X outside the range, would now produce [anchor, anchor] and be reduced to one parent. Before the fix it got two distinct parents, [checkpoint, anchor]. That silently turns a merge into a non-merge and breaks the parent-count invariant that the plan says still holds. The `--no-merges` position map would also start counting that commit's added files. The plan's Approach and Testing sections don't cover this case.","group_criteria":null,"group_id":null,"id":"f9c8a90932a399d9e","impact":0.0,"is_primary":null,"location":"Approach / src/rebar/_commands/reclaim_collapse.py `_StreamedRewrite._replay` (parent loop, lines 511-516); Testing bullet on `test_streamed_engine_matches_the_rewrite_oracle`","norm_id":"n84dfcf86bbf4c8b1","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["A `--no-ff` merge at the start of the replay range whose first parent is the boundary and whose second parent is an ancestor of the boundary (outside `boundary..tip`). After the fix both parents map to the anchor and the merge is written with one parent."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.8125,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"insufficient","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a regression test asserting that, for a collapse with ≥1 replayed commit (including one that touches a SNAPSHOT the anchor re-resolved), every rewritten commit's tree and the tip's SNAPSHOT bytes are identical to what the pre-fix engine produced (or to the oracle), so that only parentage changes.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e","T9"],"criteria":["T2","E6"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["Approach: \"A child of the anchor therefore diffs against the boundary and inherits the anchor's rewritten SNAPSHOT bytes. It re-resolves only the SNAPSHOTs that reference commits mapped after the anchor, which is the same dirty rule the engine already applies.\"","Testing: the oracle test's \"expectations are parent counts and SNAPSHOT SHA mappings\". Neither checks tree or blob equality of the replayed commits."],"finding":"The plan asserts, without a test, that re-parenting the first replayed commit onto the ledger anchor leaves every rewritten tree and SNAPSHOT byte unchanged. The fix should change parentage only, but the Approach depends on tree-diff and inheritance claims about engine internals. No planned test checks that the rewritten commits' trees and SNAPSHOT contents match the pre-fix output.","group_criteria":null,"group_id":null,"id":"fe508d5c37dad9abf","impact":0.0,"is_primary":null,"location":"Approach / Testing","norm_id":"n5153da7a9a2fd8ca","priority":0.0,"reason":"veto:cited-reference-inaccurate","recalled":false,"scenarios":["A replayed commit edits a SNAPSHOT that the anchor also re-resolved. Inheriting from the anchor rather than the checkpoint either double-applies the rewrite or reverts it, so the tip tree silently diverges.","The anchor's source_of / k_of bookkeeping does not behave as the Approach describes, and the rewritten tip loses or corrupts ledger content. No test notices, because the existing tests check only ancestry and enforcement."],"severity":null,"suggested_fix":"In the new ancestry test, also compare `git rev-parse <new_commit>^{tree}` for each replayed commit, and the tip's SNAPSHOT blobs, against the expected oracle output. Extend `_build_collapsible_store` with one replayed commit that modifies a SNAPSHOT file the anchor rewrites.","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"no","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] In the enforcement test, assert exact counts: unsigned/enforced count == number of replayed events in the fixture, and grandfathered count == number of below-boundary events. Assert on verify-identity's structured output or verify_authorship's return value, not on exit code or prose alone.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e","T9"],"criteria":["E6"],"decision":"dropped","decision_margin":-0.8871,"drop_reason":null,"evidence":["\"(exit non-zero, the event counted unsigned). Below-boundary events stay grandfathered.\""],"finding":"The enforcement test's assertions are loosely specified: \"exit non-zero, the event counted unsigned\" and \"below-boundary events stay grandfathered\". It names no exact count and no structured output to assert on. A test that only checks exit status could pass for an unrelated reason, such as an invalid ENFORCE_SINCE ref.","group_criteria":null,"group_id":null,"id":"f73985fcf167ed159","impact":0.44,"is_primary":null,"location":"Testing — Enforcement bullet; AC 2","norm_id":"ne6338336ce3fe24e","priority":0.0629,"reason":"low-validity","recalled":false,"scenarios":["verify-identity exits non-zero because the anchor ref is missing or unparseable, not because the replayed event was enforced. The test goes green without proving the fix."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.1429,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State explicitly either that no collapse has been applied to a real store (dry runs only), or give the remediation for already-collapsed stores (for example, a reachable replacement value for REBAR_IDENTITY_ENFORCE_SINCE).","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e","T9"],"criteria":["E2","T4"],"decision":"dropped","decision_margin":-0.6,"drop_reason":null,"evidence":["\"The same result came from the current engine ... and from the original S1 engine (a758402f065 ...).\"","The only real-scale evidence is a \"dry run\" on a TMPDIR copy, and the plan is silent on production applies."],"finding":"The plan says the defect predates the streamed rewrite and exists in the original S1 engine. It does not state whether any collapse has already been applied to a real store with an unreachable anchor. If one has, it gives no remediation, such as re-anchoring REBAR_IDENTITY_ENFORCE_SINCE to the checkpoint's child or another reachable commit.","group_criteria":null,"group_id":null,"id":"fc23ad9254c480151","impact":0.0,"is_primary":null,"location":"Evidence / Scope","norm_id":"ncbd386ebed7e8d04","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["A store collapsed with the S1 engine keeps grandfathering every event after this fix merges, because the fix only affects future collapses."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.1875,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"insufficient","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Split the Gerrit `Verified +1` into its own `[non-codebase]` AC that records the change id and vote on the ticket, and say what evidence demonstrates a `make verify` failure is environmental.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e","T9"],"criteria":["F1"],"decision":"dropped","decision_margin":-0.3643,"drop_reason":null,"evidence":["\"`make verify` is run and any failure is fixed or shown environmental; the Gerrit change gets `Verified +1`\""],"finding":"The last AC bundles a Gerrit `Verified +1` vote, whose evidence lives outside the repo, with in-repo commands. It is not tagged `[non-codebase]` and does not say what attestation is recorded on the ticket. The phrase \"fixed or shown environmental\" also gives no evidence standard.","group_criteria":null,"group_id":null,"id":"f3dd7c86e1eb779bd","impact":0.55,"is_primary":null,"location":"Acceptance Criteria — final bullet","norm_id":"n95356ca9af8a2ee8","priority":0.2357,"reason":"low-validity","recalled":false,"scenarios":["An executor cannot tell what counts as \"shown environmental\", or where to record the Gerrit vote as evidence."],"severity":null,"suggested_fix":"- [ ] [non-codebase] Gerrit change <Change-Id> has Verified +1, with the change id and vote timestamp recorded on the ticket.","tier":"LLM","validity":0.4286,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State how test_streamed_engine_matches_the_rewrite_oracle computes expected rewritten SHAs. If it models the parentage independently, plan the matching oracle update so that it parents boundary-children on the ledger anchor. If not, say why it still independently validates the new parentage.","cohort":["E3","E5","F4","G5","T6","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.net-mechanism","project.portability"],"criteria":["E5","E3"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["\"test_streamed_engine_matches_the_rewrite_oracle keeps passing. Its expectations are parent counts and SNAPSHOT SHA mappings, and both still hold.\"","Approach: \"map a parent equal to the boundary to self.ledger_anchor_sha instead of old_to_new[boundary]\". This changes the first replayed commit's parent and so its SHA and all descendant SHAs."],"finding":"The plan asserts that test_streamed_engine_matches_the_rewrite_oracle keeps passing because its expectations are 'parent counts and SNAPSHOT SHA mappings'. It never establishes how that oracle derives the expected rewritten SHAs. Re-parenting the first replayed commit onto the ledger anchor changes that commit's SHA and every descendant's SHA. Any SNAPSHOT that references a replayed commit therefore re-resolves to a different SHA. If the oracle computes the expected rewrite independently, modelling the old boundary→checkpoint parentage, it will diverge from the engine. Either the oracle needs the same change, or it is shown to read mappings from the engine's own old_to_new and so cannot detect the change. In both cases the changed behaviour lacks explicit modify-test work.","group_criteria":null,"group_id":null,"id":"f71609e204551d2db","impact":0.0,"is_primary":null,"location":"Testing — third bullet (test_streamed_engine_matches_the_rewrite_oracle)","norm_id":"n0389b36c51c2c139","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["The oracle independently replays the history with the boundary mapped to the checkpoint. The engine's rewritten SHAs then differ and the oracle test goes red after the fix. An implementer may 'fix' that by weakening the oracle.","The oracle reads mappings from the engine under test. It passes, but it cannot catch a regression in the new parentage, so it is a self-authored oracle for this change."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.3333,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"no","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"6346669d28deceaa","material_parts":{"children":["647ea2107ca5072f",0],"description":["755f13850e9cbfd0",4620],"description_boxes":["1a0f564ddc603945",0],"file_impact":["ca849a755abf0c66",2],"ticket_id":["e9409bbfb6c77d26",19]},"metrics":{"cache_read_tokens":611439,"cache_write_tokens":253257,"claim_path":"no-llm/no-network (structural;