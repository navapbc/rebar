\"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d7012c46ec4eff792e5779f37ac84faf40ebfa9091f854d3754e87811931ef2c","event_uuid":"dab2e163-42ad-4180-bbd3-f91204b71f63","position":{"commit_sha":"42c0d3d94e621205ca4fcdef190c374c9c274330","position":"1787051799386487001-dab2e163-42ad-4180-bbd3-f91204b71f63"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"34e997539a3af86789bb4fe2e5ab1d8d1151f7b20e8da7d7128062520bf97a7a","event_uuid":"7397cbf2-2e3c-41ff-8a62-597399cc81e9","position":{"commit_sha":"b45b4990d6093b128bf335e3a47cf36b3dd3b5b5","position":"1787052147569461001-7397cbf2-2e3c-41ff-8a62-597399cc81e9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"820986d49f02ea49eaf9083f72177b38a57ca4ce875b30f6be5a58a6e4fd3c10","event_uuid":"4af20634-cb26-4b96-9633-6d30fbf0b2d3","position":{"commit_sha":"fe8f4c75dd371931530c1edb972672bef19a4827","position":"1787052508355460001-4af20634-cb26-4b96-9633-6d30fbf0b2d3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786995167427720001,"creation_channel":"cli","deps":[{"link_uuid":"1c4d7875-4026-4bc4-9458-9314442c912d","relation":"depends_on","target_id":"e042-4780-6c63-4b09"},{"link_uuid":"0b65621e-8f94-4c37-b724-d2181dbee91c","relation":"relates_to","target_id":"486a-69ef-6370-48ff"},{"link_uuid":"de191814-c7ac-415e-b629-0fa655b4f451","relation":"relates_to","target_id":"f5ac-6373-5e33-4374"},{"link_uuid":"1ebc8a4f-c145-4010-96a6-48a5bfb82745","relation":"relates_to","target_id":"28a3-a62d-6345-44a0"},{"link_uuid":"d0595090-b724-45e2-838a-9e64f7ba415d","relation":"relates_to","target_id":"59b0-d1b9-ad94-4339"},{"link_uuid":"2f6f1650-952b-4aed-b68d-235b7b90297f","relation":"relates_to","target_id":"acdf-d998-296c-46e6"},{"link_uuid":"6620b0f8-25ba-47bc-af49-17f5a6049770","relation":"relates_to","target_id":"4eef-c459-ff29-4dc7"}],"description":"## Context / Problem\nAfter S2, read/check paths use operation bindings, but live apply, Git push, ACLI/delivery, and bridge orchestration still rebuild config or reuse broad parent environments. Jira Cloud scope still has implicit `DIG` fallbacks (write path, the live access-check probe, the runtime default, and the create-time default). These paths can write under an unintended scope or leak a Rebar-materialized credential to an unrelated sibling child.\n\n## Outcome\nCut write/apply and subprocess paths over to the S2 runtime. Add one shared child-environment builder: trusted same-capability children start from ambient inheritance, owning children receive their adapter overlay, unrelated siblings remove exact secret names declared by other Rebar adapters, unknown native Git/SSH/AWS/proxy/CA variables survive, and Rebar never mutates global `os.environ`.\n\n## Plan\n1. Thread `ReconcilerSettings`, `GitRuntime`, selected `BridgeRuntime`, and the already-constructed backend through applier, mutation planning/dispatch, inbound/outbound handlers, binding updates, Git adapter/ref/lock/push, and `_bridge_runner` delivery paths. Remove their ambient `load_config`/cwd/default fallbacks.\n2. Add `src/rebar/_child_env.py` with a pure environment projection API and a checked-in registry of exact secret names owned by each Rebar adapter. The registry contains names, never values; native SDK/helper chains remain ambient.\n3. Ensure CLI `-c` tracker/Jira/reconciler selections cross the reconciler subprocess boundary as non-secret snapshot material. Pass static adapter material only to the exact owning process/adapter.\n4. Eliminate every implicit `DIG` Jira-project default so no request (write OR live probe) uses `DIG` unless it is explicitly configured: (a) the write path `resolve_jira_settings(project_default=\"DIG\")` in `adapters/jira/backend.py` (:200/:230/:316); (b) the live access-check probe `JIRA_PROJECT` `or \"DIG\"` in `access_check.py` (:72/:77/:262); (c) the `_CLOUD_PROJECT_DEFAULT = \"DIG\"` constant in `rebar_reconciler/runtime.py` (:46); and (d) the create-time `_DEFAULT_PROJECT = \"DIG\"` in `_store/project_ensures.py` (:50). Each unset case fails closed with a typed/redacted pre-mutation (or pre-probe) error; `DIG` is used only when `JIRA_PROJECT`/config is explicitly `DIG`. Preserve existing retry, rate-limit, TLS, output, partial-failure, idempotency, and ticket-delivery behavior unless a test names the approved delta.\n\n## Testing (RED -> GREEN)\n- End-to-end verified-fake Cloud/DC runs cover create/update/comment/link/delete/inbound apply plus Git commit/push/delivery under custom tracker dir/branch/remote with ambient resolvers poisoned after composition.\n- Child-process contract tests assert unknown ambient/native-chain variables survive; the owning overlay appears only for its child; unrelated siblings lose other adapters' exact declared names; argv/URL/log/output contain no secret sentinel.\n- Concurrency tests run distinct operations with different overlays and timeouts, asserting `os.environ` is byte-equal before/during/after and no cross-operation value is observed.\n- Failure-injection tests cover missing project/auth, revoked credential, TLS error, retry/rate-limit exhaustion, provider partial failure, and delivery failure; existing provider-neutral output and recovery/idempotency oracles remain authoritative.\n- A red test demonstrates each current `DIG` default (write path AND the live access-check probe); green asserts zero provider mutation and no probe request targeting `DIG` when write scope is absent.\n\n## Compatibility / rollback\nUntil bounded-live validation, a compatibility facade may invoke the legacy write path. Before cutover, rollback selects it. After any new snapshot-aware caller ships, rollback requires the S1 envelope-compatible floor. Ticket, event, bridge, and binding formats remain unchanged.\n\n## Acceptance Criteria\n- [x] Verified-fake Cloud/DC apply plus Git/delivery paths complete with ambient resolvers poisoned and use the configured tracker directory/branch/remote and explicit project scope.\n- [x] Missing Cloud write scope produces a typed/redacted pre-mutation failure and no request uses `DIG` unless `DIG` was explicitly configured.\n- [x] Same-capability child tests preserve unknown Git/SSH/AWS/proxy/CA variables, owning children receive only their overlay, and unrelated siblings omit every other adapter's exact declared secret name.\n- [x] Concurrent-operation tests prove no global environment mutation and no cross-operation credential/config observation.\n- [x] Existing retry, rate-limit, TLS, output, partial-failure, recovery, and idempotency scenarios retain their provider-neutral behavior except explicitly approved deltas.\n- [x] Disabling the write facade restores the legacy path before cutover; no stored ticket/event/bridge/binding format changes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_child_env.py","reason":"Pure adapter-owned child environment projection and exact secret-name registry."},{"path":"src/rebar/_bridge_runner.py","reason":"Pass the operation snapshot/runtime and scope child delivery environments."},{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"Use the one selected backend/runtime for apply."},{"path":"src/rebar/_engine/rebar_reconciler/apply_base.py","reason":"Thread runtime through common mutation services."},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"Replace handler ambient config reads with projections."},{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound.py","reason":"Use operation runtime for inbound apply."},{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound_records.py","reason":"Use injected identity/backend without ambient construction."},{"path":"src/rebar/_engine/rebar_reconciler/apply_outbound.py","reason":"Use operation runtime for outbound apply."},{"path":"src/rebar/_engine/rebar_reconciler/apply_planning.py","reason":"Carry configured root/layout and policy through write planning."},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_one.py","reason":"Thread immutable runtime through single-ticket dispatch."},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_apply_phases.py","reason":"Thread immutable runtime through apply phases."},{"path":"src/rebar/_engine/rebar_reconciler/git_adapter.py","reason":"Honor configured Git runtime and tracker layout."},{"path":"src/rebar/_store/push.py","reason":"Use scoped child environments for Git push without global mutation."},{"path":"tests/unit/rebar_reconciler/mutate/","reason":"Apply/delta/failure/idempotency and explicit-project oracles."},{"path":"tests/unit/test_child_env.py","reason":"Ambient inheritance, exact sibling removal, owning overlay, and concurrency oracles."},{"path":"tests/interfaces/store/test_reconciler_apply_bindings.py","reason":"Verified-fake Cloud/DC apply plus Git/delivery end-to-end coverage."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"Remove the write-side project_default='DIG' fallback; fail closed on unset write scope."},{"path":"src/rebar/_engine/rebar_reconciler/access_check.py","reason":"Remove the live-probe `JIRA_PROJECT or DIG` default (:72/:77/:262); fail closed unless DIG explicitly configured."},{"path":"src/rebar/_engine/rebar_reconciler/runtime.py","reason":"Gate the `_CLOUD_PROJECT_DEFAULT='DIG'` runtime default so DIG is used only when explicitly configured."},{"path":"src/rebar/_store/project_ensures.py","reason":"Gate the create-time `_DEFAULT_PROJECT='DIG'` default consistently with the write/probe paths."},{"path":"docs/env-vars.md","reason":"Regenerated env-var registry (added REBAR_RECONCILER_WRITE_FACADE; DIG-removal changed JIRA_* read sites)."},{"path":"src/rebar/_engine/rebar_reconciler/reconcile.py","reason":"AC1: thread composed runtime through _PassContext; forward client= into apply."},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"AC1/AC6: extracted binding cluster (bind_operation_runtime, write-facade toggle) to respect the 800-LOC cap."},{"path":"tests/scripts/bridge/test_jira_capability_probe.py","reason":"AC2 delta: DIG default removal updates."},{"path":"tests/unit/rebar_reconciler/state/test_backend_scalar_surface.py","reason":"AC2 delta: DIG default removal updates."},{"path":"tests/unit/rebar_reconciler/state/test_backend_scalar_surface_heldout.py","reason":"AC2 delta: DIG default removal updates."},{"path":"tests/unit/rebar_reconciler/state/test_config_jira_wiring.py","reason":"AC2 delta: DIG default removal updates."},{"path":"tests/unit/test_rp04_s3_dig_removal.py","reason":"AC2: new negative tests proving no implicit DIG default."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","e042-4780-6c63-4b09"],["parent","e215-ab23-ed6a-4791"],["relates_to","28a3-a62d-6345-44a0"],["relates_to","486a-69ef-6370-48ff"],["relates_to","4eef-c459-ff29-4dc7"],["relates_to","59b0-d1b9-ad94-4339"],["relates_to","acdf-d998-296c-46e6"],["relates_to","f5ac-6373-5e33-4374"]],"no_file_impact_reason":"","parent_id":"e215-ab23-ed6a-4791","parent_status_uuid":"76e700f6-6660-4547-9701-f451681cceba","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["rp04","config","reconciler","security"],"ticket_id":"6e3b-3d1a-0ff7-44b6","ticket_type":"story","title":"RP-04 S3 — Cut reconciler apply and child processes to scoped runtimes","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_child_env.py","dd_id":"AC2-AC4","dd_text":"Child environment ownership and concurrent no-global-mutation contract"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/interfaces/store/test_reconciler_apply_bindings.py","dd_id":"AC1-AC6","dd_text":"Verified-fake Cloud/DC apply plus Git/delivery end-to-end behavior"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/mutate","dd_id":"REGRESSION","dd_text":"Existing mutation failure/idempotency and provider output behavior"}]},"source_event_uuids":["0b65621e-8f94-4c37-b724-d2181dbee91c","de191814-c7ac-415e-b629-0fa655b4f451","1ebc8a4f-c145-4010-96a6-48a5bfb82745","d0595090-b724-45e2-838a-9e64f7ba415d","845a463c-282c-4409-9c6f-ba8177bee868","2ccfe320-7361-4cb2-988e-3579df34f82b","4784a6c1-2a5a-4635-9093-cc11bc3e82df","76e700f6-6660-4547-9701-f451681cceba","1bced68d-e245-4d13-a93c-576a5a5a0ffe","2f6f1650-952b-4aed-b68d-235b7b90297f","6620b0f8-25ba-47bc-af49-17f5a6049770","dab2e163-42ad-4180-bbd3-f91204b71f63","7397cbf2-2e3c-41ff-8a62-597399cc81e9","4af20634-cb26-4b96-9633-6d30fbf0b2d3"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787052508355460002,"uuid":"cb06e56f-2085-4f5c-af28-ddffdc9baf84"}