t_tokens":164380,"output_tokens":3516,"requests":6}},{"kind":"success","lineage":{"dependencies":[],"digest":"1000a4f7f1a642292a6f17040d5d60cb11498e55accff5b8be08e617de252c55"},"namespace_version":1,"reason":null,"unit_id":"agent:G6","usage":{"input_tokens":384989,"output_tokens":7185,"requests":12}},{"kind":"success","lineage":{"dependencies":[],"digest":"0dc2fbed2c122cbaa344d7d1eb0ab6369d001b3d7d1f361fde96b6bd525e6a49"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":405839,"output_tokens":6237,"requests":10}},{"kind":"success","lineage":{"dependencies":[],"digest":"e06a7fdca93ccea3ba371097367d06af1752c1b4cf72008f8c7b93465cbb6a13"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":163975,"output_tokens":5059,"requests":8}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"Specify how the prefetch manifest (currently discarded as `_manifest` at gate_ops.py:200, produced deep inside the completion_precheck workflow op) is propagated out of run_workflow to the verdict result consumed at the emit site — name the carrier (e.g. attach onto the verdict result alongside completion_read_basis) and state the REBAR_VERIFY_PREFETCH=0 (no-prefetch) behavior for the fingerprint basis.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["gate_ops.py:200: `section, _manifest = completion_prefetch.assemble_prefetch(spec, repo_root=ctx.repo_root)` — the manifest is captured to `_manifest` and DISCARDED today.","The verdict that reaches the emitter (close_precheck.py:405 `completion_sidecar.emit(result, ...)`) is `res.terminal_output` from `produce_completion_verdict` (gate_dispatch.py:736); `completion_read_basis` is attached to the result in a DIFFERENT place (completion.py:186 `_attach_completion_read_basis`), not from the workflow op.","No symbol `completion_prefetch_manifest` or `prefetch_manifest` exists anywhere in src/rebar (search returned no matches), i.e. there is no existing carrier the plan can lean on — the propagation must be built."],"finding":"The prefetch manifest the fingerprint basis depends on is produced inside the completion_precheck workflow op and currently discarded; the plan asserts it is 'threaded from the precheck PRE-LOAD MANIFEST' but does not specify the mechanism by which it reaches the emit site across the run_workflow terminal_output boundary.","group_criteria":null,"group_id":null,"id":"fb7f272a91bc6b091","impact":1.0,"is_primary":null,"location":"Fix plan (2026-08-31) — 'completion_prefetch_manifest identifiers ... threaded from the precheck's PRE-LOAD MANIFEST'; File impact lists src/rebar/llm/workflow/gate_ops.py","norm_id":"n999dc0f6106752ed","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer enriches build_payload expecting a `completion_prefetch_manifest` on the verdict dict, but the workflow op never propagates `_manifest` out of run_workflow, so pinned PASS/FAIL sidecars silently omit the prefetch identifiers (or the fingerprint is computed over a manifest that is always empty).","REBAR_VERIFY_PREFETCH=0 disables prefetch entirely (gate_ops.py:196) — the plan does not say whether a prefetch-disabled run yields an empty manifest that still counts as 'pinned' or degrades to unpinned."],"severity":null,"suggested_fix":"Attach the manifest onto the verdict result at the same seam that already attaches completion_read_basis (completion._attach_completion_read_basis), or return it from produce_completion_verdict, so build_payload reads it off the result dict; define prefetch-disabled runs as an empty manifest that stays 'pinned_completion_inputs' (the code_oid/tickets_oid/receipt_digest basis is unaffected).","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Specify how verifier_version.prompt_content_sha256 is sourced on the produce_completion_verdict preflight-ERROR path (where no prompt has been resolved) — e.g. resolve get_prompt('completion-verifier') + prompt_content_hash at emit time, or explicitly allow the field to be absent for preflight ERROR and state how the reader treats that.","cohort":["T8"],"criteria":["T8"],"decision":"advisory","decision_margin":-0.13,"drop_reason":null,"evidence":["Plan: 'every new completion sidecar carries verifier_version={prompt_id:\"completion-verifier\", prompt_content_sha256:\"<git-canonical prompt hash>\", formula_version:\"<signing.gate_code_version()>\"}'","Plan: 'Completion ERROR call sites covered: produce_completion_verdict preflight and completion_failures.raise_completion_workflow_failure.'","gate_dispatch.py:677-688 — runner_sel.preflight() raises LLMUnavailableError and emit_gate_error is called BEFORE _gate_doc/CompletionAgentStep/run_workflow, i.e. before the completion-verifier prompt is resolved or run; the plan does not say the emitter should resolve get_prompt('completion-verifier') + prompt_content_hash independently, nor that prompt_content_sha256 may be absent on this arm.","prompt_content_hash (prompt_model.py:243) requires the prompt TEXT as input, so the preflight path must resolve the prompt out-of-band to compute it — an unstated step."],"finding":"The version contract mandates verifier_version.prompt_content_sha256='<git-canonical prompt hash>' on EVERY new completion sidecar including the preflight ERROR, but the produce_completion_verdict preflight-ERROR path raises before any prompt is resolved or hashed, and the plan gives no rule for sourcing that hash there.","group_criteria":null,"group_id":null,"id":"fba92ac14ebbceef7","impact":0.67,"is_primary":null,"location":"Fix plan → 'Version contract' and 'Shared ERROR scope' (Completion ERROR call sites: produce_completion_verdict preflight)","norm_id":"nd9ed250865e9ec75","priority":0.67,"reason":"default-advisory","recalled":false,"scenarios":["A verifier provider outage trips the preflight; the gate_error_v1 sidecar is written but the executor has no defined source for prompt_content_sha256, so it either omits verifier_version (violating AC2 for ERROR sidecars) or fabricates a value."],"severity":null,"suggested_fix":"State that the preflight-ERROR emitter resolves the completion-verifier prompt via get_prompt('completion-verifier') and stamps prompt_content_sha256 = prompt_content_hash(prompt.text) (prompt resolution is deterministic and independent of a run), keeping prompt_id/formula_version identical to the normal path; if resolution fails, define prompt_content_sha256 as explicitly absent and note the reader treats absence as unknown era.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","