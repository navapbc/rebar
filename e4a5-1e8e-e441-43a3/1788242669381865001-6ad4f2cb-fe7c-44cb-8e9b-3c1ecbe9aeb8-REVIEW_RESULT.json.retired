ull,"unit_id":"agent:T3","usage":{"input_tokens":56631,"output_tokens":1923,"requests":4}},{"kind":"success","lineage":{"dependencies":[],"digest":"20dc84e2ed38fff404b4bd1edfbeeb16e028ec3dbc80234192896d8ab0053d76"},"namespace_version":1,"reason":null,"unit_id":"agent:G1G2","usage":{"input_tokens":188007,"output_tokens":4571,"requests":10}},{"kind":"success","lineage":{"dependencies":[],"digest":"9cab7dd60635ef4d3624cee49455fc592019b22a251f8a5988c4b5eecd042265"},"namespace_version":1,"reason":null,"unit_id":"agent:E4","usage":{"input_tokens":150305,"output_tokens":6268,"requests":10}},{"kind":"success","lineage":{"dependencies":[],"digest":"0b254e7cbc4dda086471f9bbbd9b1c49d3c40fe7430596d096d91e4e081be1c6"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":164572,"output_tokens":3125,"requests":7}},{"kind":"success","lineage":{"dependencies":[],"digest":"2f3df6e27d3837ce1cbcb360a7976eee88fe69c3251b90d506eab947e085cd45"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":172448,"output_tokens":2976,"requests":6}}],"version":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State that enrichment-component lookup/read failures are logged (or counted) at emit time so silent degradation to 'unknown' is observable to operators, not swallowed without signal.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["T5b"],"decision":"dropped","decision_margin":-0.862,"drop_reason":null,"evidence":["'If either lookup fails, that component is recorded as unknown without changing the gate outcome'","'If no ticket material can be read, material remains absent/unknown and the gate outcome is unchanged'","The ticket's whole purpose is observable attribution; silent degradation to unknown defeats that for the degraded runs without any signal"],"finding":"When prompt lookup, prompt hashing, gate_code_version read, or ticket-material read fails, the plan silently records the component as 'unknown'/absent with no log or metric — reintroducing the very unattributable-era gap this ticket fixes, but without any operator signal that degradation occurred.","group_criteria":null,"group_id":null,"id":"f1316cd25dc029a2f","impact":0.264,"is_primary":null,"location":"Fix plan, Version contract and Fallbacks paragraphs","norm_id":"nf623edb2ce12e0a0","priority":0.088,"reason":"veto:absence-refuted","recalled":false,"scenarios":["get_prompt('completion-verifier') raises after a prompt rename, so every sidecar records verifier_version.prompt_content_sha256='unknown' and no one notices the observability regression"],"severity":null,"suggested_fix":"Add a note that each fallback-to-unknown (prompt lookup, hash, gate_code_version, ticket material) emits a warn-level log line identifying which component degraded, so silent regression back to unknown-era records is detectable.","tier":"LLM","validity":0.3333,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["G6"],"decision":"dropped","decision_margin":-0.6,"drop_reason":null,"evidence":["completion_sidecar.py:110 `payload = build_payload(verdict, material=material)` omits repo_root even though emit() receives it at :94","Plan only says 'atomic PASS passes repo_root into build_payload' — the emit()/close/standalone path is not covered","Unpinned fallback per plan hashes 'current plan material with no read basis' i.e. current_material_fingerprint(ticket_id, repo_root=...) which needs repo_root"],"finding":"The fix plan threads `repo_root` into `build_payload` only at the atomic-PASS call site, but the standalone/close FAIL+ERROR emit path (`completion_sidecar.emit` → `build_payload(verdict, material=material)` at completion_sidecar.py:110) never forwards its own `repo_root`. The `material_basis=\"unpinned_completion_inputs\"` fallback requires computing `current_material_fingerprint(ticket_id, repo_root=...)`, and version stamping resolves `get_prompt`/`gate_code_version` inside the emitter — both need repo_root on the emit path, which the plan does not provide.","group_criteria":null,"group_id":null,"id":"f9d0c75085aa0cd18","impact":0.0,"is_primary":null,"location":"Fix plan (2026-08-31) — 'atomic PASS passes `repo_root` into `build_payload`'; code: src/rebar/llm/completion_sidecar.py:110, emit() at :94","norm_id":"n1f0574d838ad1987","priority":0.0,"reason":"veto:cited-reference-inaccurate","recalled":true,"scenarios":[],"severity":null,"suggested_fix":"Change `emit()` to call `build_payload(verdict, material=material, repo_root=repo_root)` and give `build_payload` a `repo_root=None` parameter used by the unpinned-fallback and version resolution.","tier":"LLM","validity":0.2222,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"no","cited_reference_accurate":"no","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["G6"],"decision":"dropped","decision_margin":-0.6,"drop_reason":null,"evidence":["build_payload currently sets `\"material_fingerprint\": material` on both branches (lines 346, 380)","Both emit sites pass `material=None` (close_precheck.py:405, transition_close.py:240) and the plan does not list those files in its Fix-plan File-impact block","completion.py:184 already sets result['material_fingerprint'] on the attested verdict (PASS or FAIL) via current_material_fingerprint, which build_payload currently overwrites with the None arg"],"finding":"The plan states the composite fingerprint is computed 'over the verifier's actual inputs' and lists a new `completion_verifier_material_v1` schema, but does not state HOW `build_payload` stops emitting `material_fingerprint = material` (the current line 346/380 behavior) given that both emit call sites keep passing `material=None`. On the attested path `_attach_completion_read_basis` already sets `result['material_fingerprint']` and `result['completion_read_basis']` on the verdict — so the plan needs to specify whether build_payload derives the composite from the verdict dict internally (ignoring/superseding a None `material` arg) or whether the emit sites are edited. Left implicit, an implementer could preserve `material_fingerprint = material` and re-null the field.","group_criteria":null,"group_id":null,"id":"f6ca880ca1023ae05","impact":0.0,"is_primary":null,"location":"Fix plan — 'Root cause: … build_payload only serializes the explicit material argument' and 'Fingerprint contract'; code: src/rebar/llm/completion_sidecar.py:346,380; src/rebar/llm/completion.py:184","norm_id":"nfdc4e0313def691b","priority":0.0,"reason":"veto:cited-reference-inaccurate","recalled":true,"scenarios":[],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.2222,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"no","cited_reference_accurate":"no","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"e99bb85e8a1a820f","material_parts":{"children":["647ea2107ca5072f",0],"description":["d603c3d0e9b0a259",7040],"description_boxes":["2481a63c85a62cf8",4],"file_impact":["b04617a7ba28f3c4",9],"ticket_id":["3c20e062c84f0801",19]},"metrics":{"cache_read_tokens":748317,"cache_write_tokens":226207,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":2090.1,"input_tokens":996257,"llm_calls":26,"llm_ms":200850.1,"output_tokens":29544,"precheck":{"cited_anchor_warning":false},"total_ms":209391.3,"verify_requests":11},"model"