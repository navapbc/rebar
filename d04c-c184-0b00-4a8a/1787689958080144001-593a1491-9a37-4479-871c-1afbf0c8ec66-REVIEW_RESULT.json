.","group_criteria":null,"group_id":null,"id":"f39c21ec36d36b83e","impact":0.264,"is_primary":null,"location":"Plan steps 1-4 / Outcome","norm_id":"n6dafbda50f5ed168","priority":0.0754,"reason":"veto:absence-refuted","recalled":false,"scenarios":["An implementer reading only the plan cannot tell whether persist-before-create is load-bearing (recovery correctness) or incidental, risking reordering that reintroduces orphan issues."],"severity":"minor","suggested_fix":"In the Outcome or step 1, add: 'Persist the pending record before create because a keyless/keyed-pending binding is the only durable evidence that lets recovery deterministically re-observe or retro-attach an ambiguous create — create-then-persist would leave an unrecoverable orphan issue on crash.'","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"226e48f07a89547a","material_parts":{"children":["647ea2107ca5072f",0],"description":["9920d8d4b147052d",1798],"description_boxes":["399141be1d30ac26",0],"file_impact":["1c7da86786d07d19",6],"ticket_id":["91cfc556d65e0972",19]},"metri