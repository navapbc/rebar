es on that name for the find_spec-based EXTRAS probe, but this import name is not verified from any citable source (resolve_symbol cannot confirm it here, and a distribution can ship a console-script entry point without an importable module of that name). If the actual import name differs, extra_installed('s3')/guard_import('s3') fail closed on a working install.","group_criteria":null,"group_id":null,"id":"fbf7d2be2272e2bdf","impact":0.0,"is_primary":null,"location":"Approach step 2 — EXTRAS entry \"s3\": (\"git_remote_s3\", \"<blurb>\")","norm_id":"n2b3df894f1c18b02","priority":0.0,"reason":"default-advisory","scenarios":["An operator runs pip install 'nava-rebar[s3]', the helper installs and git-remote-s3 is on PATH, yet find_spec('git_remote_s3') returns None because the top-level import name differs, so guard_import('s3') still raises the missing-extra error."],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.65,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"insufficient","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["T1"],"decision":"advisory","drop_reason":null,"evidence":[],"finding":"The EXT