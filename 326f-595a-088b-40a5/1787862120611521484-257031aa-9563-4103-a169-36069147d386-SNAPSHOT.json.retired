{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787862120611521484,"compiled_state":{"alias":"cutprice-untameable-stork","assignee":"joeoakhart@navapbc.com","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":13,"unsigned":0},"authorship_ledger":[{"content_hash":"cadba0fd007ac44ec59eb49015504081b709cc173f816caf8965ab0a15f8ad09","event_uuid":"3645621b-c3ad-49e6-9cb6-73f441fe63a9","position":{"commit_sha":"92eb6b75371513ee2df52f1b9112e9ac6756a1b8","position":"1787858225689088001-3645621b-c3ad-49e6-9cb6-73f441fe63a9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1af7e588f0950fd07604801cbdb3621bade361234a44b1402a19649058291164","event_uuid":"3ebffb1f-5b4b-47ec-b65a-31832da1e6b9","position":{"commit_sha":"cc5ccff9330186b3c5111e117c0db11b5a3a30fc","position":"1787859183358950311-3ebffb1f-5b4b-47ec-b65a-31832da1e6b9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fc6fdc579b356e88c742954eebfeb108e3ebe0e5830f1f0db5b34320ed7cdb42","event_uuid":"9fb8d532-4629-4b34-912f-dac36a010a15","position":{"commit_sha":"477964fbe1d929c9b26c5da7e776586e68f382c9","position":"1787859215736706097-9fb8d532-4629-4b34-912f-dac36a010a15"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"98622ba1763989834c6fe66c7560e078565d0ab9ba82e51a5701686856d75793","event_uuid":"36c3f619-f482-4269-9286-d36e6434acd1","position":{"commit_sha":"3c0a7cc58d08a2c05bbd8a34a319921856b5702c","position":"1787859231755774159-36c3f619-f482-4269-9286-d36e6434acd1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1b07f70760365deca2ef051c671bff433192353ad3eaf43d553f272eeb115005","event_uuid":"cd464cb1-247e-4976-b2b4-dfb3706cfc5d","position":{"commit_sha":"408c2be9dc75a66933d189f5ad95fbc2590e4a9d","position":"1787859293333818818-cd464cb1-247e-4976-b2b4-dfb3706cfc5d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1ac3f267ed8b9c5a34da6b8ec0d7c011400f4f76adf234373b2bbcf405d7e6b8","event_uuid":"88e92086-68b4-497b-aad8-e69cb1e7f1d3","position":{"commit_sha":"717d56a2c63f8cabfd3da2a91d2ec1277538d78f","position":"1787859357368837760-88e92086-68b4-497b-aad8-e69cb1e7f1d3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6d7a0cefee0df4b251420d56c6490467122f40c19e6aa28e1b5c83c44ca55cb2","event_uuid":"6b484729-ee83-499b-a578-a4be7cdde22c","position":{"commit_sha":"7861a198b3e0450b610d4f8d1af864e194d62f11","position":"1787859441510054101-6b484729-ee83-499b-a578-a4be7cdde22c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fbefffd13b2e11d3044c3adf367d7084c688a3b4b7e60c8e0d86e05f713ed585","event_uuid":"c46ba14f-93d9-41f5-95bc-db206d9853a6","position":{"commit_sha":"7861a198b3e0450b610d4f8d1af864e194d62f11","position":"1787859441524288186-c46ba14f-93d9-41f5-95bc-db206d9853a6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"739b3168e6f62db656946edd1dc0c3c87e8be407d20769d9776abd17c9330e9a","event_uuid":"bfd3a0aa-a3aa-4f0a-a230-d0d79c602512","position":{"commit_sha":"4362490a0a1313e1eb136118974f219c56634dd4","position":"1787859701914721166-bfd3a0aa-a3aa-4f0a-a230-d0d79c602512"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"de92b2aa8b1f2b6154b0837c40d9826be0ac1ab3c3a0de0529233a7d1bea92a0","event_uuid":"e23ada66-578a-4f59-a748-d82ef971d2f6","position":{"commit_sha":"547e5c43f63f071299979c6838fb9286220d30c9","position":"1787860129784552284-e23ada66-578a-4f59-a748-d82ef971d2f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"466a49aedc9b5d9f70d43e45f8dd612cd9264a498d11977706f32a58ae7a57b4","event_uuid":"28e9c1b9-a6ed-49ef-8843-55ffa2ea306e","position":{"commit_sha":"9cf4a1fe635a1e1348dc9fc1ec588b7e38d1a001","position":"1787860150344906001-28e9c1b9-a6ed-49ef-8843-55ffa2ea306e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c4445f520504c7fee91872e1286ed2fdf77d3446c80a0dd4c068761f6a8bb21c","event_uuid":"8e7c1224-a929-48e8-a599-109bb4079ae5","position":{"commit_sha":"68ac8d3c4a42cf385236caece5305bf4e00a3187","position":"1787861293581220887-8e7c1224-a929-48e8-a599-109bb4079ae5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"23b0058ca971c8af9f32983e5c5b9495b9a38b688775b2aa3f4a6e7715526398","event_uuid":"53318c52-8947-4d78-bb16-668dfc10d1ef","position":{"commit_sha":"4a54f008e16b5e2452c45bb796c8f138848eb5d0","position":"1787862120611521483-53318c52-8947-4d78-bb16-668dfc10d1ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## RCA — confirmed root cause (runtime-verified)\n\n**Mechanism (confirmed, not merely read).** Reproduced in a scratch store seeded with a\nCREATE-less ticket dir:\n\n- `rebar fsck --output json` → **rc 1** and a fully structured payload\n  `{\"issues\": [{\"kind\": \"missing_create\", \"ticket_id\": \"...\", \"detail\": \"no CREATE event found\"}, {\"kind\": \"warn\", ...}], \"fixed\": [], \"issue_count\": 2}`.\n- `rebar.fsck(repo_root=...)` on the SAME store → **raises `RebarError`**, `returncode=1`,\n  message = the whole newline-joined TEXT report.\n\nSo the structure already exists one layer down and is thrown away.\n\n**The three sites, and which one is the defect.**\n\n1. `src/rebar/_commands/fsck.py:242-243` — `rc = 0 if issue_count == 0 else 1`, then writes the\n   report. **Correct and NOT the defect** — `git fsck`/`fsck(8)` convention; scripts depend on it.\n2. `src/rebar/_lib_reads.py:347-353` — `rc = _fsck_mod.fsck_cli([...])`; `if rc != 0: raise\n   RebarError(f\"rebar fsck failed (exit {rc}): ...\")`. **This is the defect.** It maps *every*\n   non-zero rc to a failed call. It calls `fsck_cli` with an **empty argv** — i.e. text mode —\n   so it never even asks for the JSON the CLI can already produce, then flattens the text into\n   an exception message.\n3. `src/rebar/_mcp_reads.py:385,396` — `def fsck(...) -> str: return rebar.fsck(...)`. The\n   `-> str` annotation means **no `outputSchema`**, and the raise from (2) surfaces to the client\n   as `{\"error\":\"command_failed\",\"exit_code\":1,\"message\":\"<whole report>\"}`.\n\n**Why (2) is wrong and not merely surprising.** fsck's own rc vocabulary already separates the\ntwo states the ticket says must stay distinguishable: `0` = clean, `1` = **issues found** (a\ncompleted run), `2` = usage error / uninitialised store (`docs/exit-codes.md:63,96,135`;\n`src/rebar/_commands/fsck.py:17-18` \"Exit 0 = no issues, 1 = issues found\"). `rc != 0` collapses\n\"the diagnosis is: 12 findings\" into \"the tool failed\". A completed run is `rc in (0, 1)`.\n\n**Inconsistent with its own neighbours.** `clarity_check`, `check_ac`, `quality_check`,\n`validate` — the tools registered immediately after `fsck` in `_mcp_reads.py` — all return typed\n`_Out` models with `outputSchema`. `fsck` is the odd one out even though its canonical schema\n**already exists**: `src/rebar/schemas/fsck.schema.json`, registered as `schemas.FSCK`.\n\n## Defect origin — `42a0-25c8-7d97-4764`, commit `ffe34ca90c88` (unmet obligation, not a regression)\n\nBlame on the raise (`_lib_reads.py:348-353`) names `9f7bd2464d552`, and on the MCP tool\n(`_mcp_reads.py:385`) names `04117bd74a8cf`. **Both are carriers.** `9f7bd24` is a\ncompact-porting commit whose own comment says it is \"preserving the prior `_ok(_run(...))`\ncontract\"; at `04117bd` the library was still `_ok(_run([\"fsck\"]))`, which already raised. The\nbehaviour was never right, so nothing \"broke\" it — this is an **unmet obligation**, and the\nfix site (`_lib_reads.py`) is not the cause site.\n\nThe commit that created the obligation is **`ffe34ca90c88`** (2026-06-09), story\n**`42a0-25c8-7d97-4764`**, \"`--output json` for list-epics/summary/check-ac/quality-check/**fsck**/bridge-fsck\":\n\n- it authored `src/rebar/schemas/fsck.schema.json` — the exact `{issues, fixed, issue_count}`\n  contract this bug asks for;\n- it added `_transform_json` so the CLI emits that shape;\n- **in the same commit** it did the MCP-parity work for fsck's siblings (\"MCP\n  check_ac/quality_check typed (GateResultOut, outputSchema)\");\n- and left `def fsck(recover: bool = False) -> str: return rebar.fsck(...)` untouched, sitting\n  directly above `def clarity_check(...) -> ClarityResultOut` (verified in that commit's tree).\n\nThat is the change where a reviewer had every piece in front of them at once. Attribution is by\n**scope-of-work / obligation**, not by an introducing defect — recorded because a whole-file\nblame would instead name the carrier commits above, which is the wrong answer for the escape\nmetric.\n\nRejected alternative: `fe3e-346e-e5eb-42db` (hyper-scuff-kale, \"typed MCP returns\", commit\n`45c4ae4`, an **ancestor** of `ffe34ca`). It carries the broader AC \"All read MCP tools advertise\noutputSchema\", and its plan text even lists fsck under \"Unify issue reports\" while dismissing the\nMCP fsck signature as \"F: … cosmetic; document\". But at `45c4ae4` no fsck JSON shape existed yet,\nso there was nothing to type against. `ffe34ca` is the sharper and later target.\n","timestamp":1787859183358950311},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC4 decision — self-resolved `STATUS_FORK_RESOLVED` should NOT count toward the failure exit\n\n**Decision: uncount it. Keep emitting it.** The line stays, its `kind` stays in `--output json`'s\n`issues[]`, `show`/`list` keep the `status_fork_resolutions` field. Only its contribution to\n`_scan`'s issue counter — and therefore to the exit code — is dropped.\n\n### Evidence gathered before deciding\n\n1. **The condition is permanent, not transient.** `status_fork_resolutions` is written once at\n   `src/rebar/reducer/_processors_status.py:160-162` and there is **no** delete/clear/prune/TTL\n   path anywhere in `src/`. Compaction preserves it: `compact_txn.py:67-73` strips exactly\n   `{\"updated_at\", \"signature\"}`, and `reducer/_processors.py:549-553` restores every\n   `compiled_state` key verbatim from a SNAPSHOT. The only attenuation is archiving\n   (`fsck_scan.py:105,112-113`). So **one** cross-clone claim race pins that store's `fsck` exit\n   at 1 for the rest of its life. The ticket's \"permanently failing by design\" claim is exact.\n\n2. **\"Emit but never count\" is an established rule here, not an invention.** Three existing\n   flavours:\n   - `is_issue=False` on a structured, JSON-visible kind — `PUSH_PENDING`\n     (`fsck_tracker_health.py:232-238`) and `TRACKER_DIRTY_TMP_EVENT` (`:276-281`), both driven\n     by the explicit per-line `is_issue` boolean at `fsck_tracker_health.py:58-70`;\n   - `WARN:` lines that reach JSON as `kind:\"warn\"` but never increment (index-lock\n     `fsck_scan.py:157-161`, forward-compat `:244-249`);\n   - lowercase advisories excluded from JSON entirely (`ensures:`, `authorship:` `:263-266`).\n\n   It is even **user-documented**: `docs/user-guide.md:449-450` states\n   `TRACKER_DIRTY_TMP_EVENT` is \"Report-only and never counted or auto-touched\".\n\n3. **The precedent's rationale is verbatim this argument.** `fsck_tracker_health.py:256-260`:\n   *\"counting it would make fsck flake against concurrent writers; it is reported for MANUAL\n   triage and never auto-touched.\"* `STATUS_FORK_RESOLVED` is the same hazard and strictly worse:\n   the tmp-event noise is transient, a resolved fork is permanent.\n\n4. **The nearest analogue for \"self-healed\" already exits 0.** `FIXED:` lines are `continue`d out\n   of `issues[]` at `fsck.py:114-116`, and `_repair_cli` takes its count from a **post-repair\n   rescan** (`fsck.py:232-243`), so a repaired finding contributes nothing. \"fsck fixed it →\n   don't fail\" is the existing shape; a fork the *reducer* fixed is the same category.\n\n5. **Nothing pins the current counting.** No test asserts fsck's exit code or `issue_count` on a\n   `STATUS_FORK_RESOLVED`: `tests/unit/test_reducer_status_fork_record.py:56-79` is reducer-only;\n   `tests/integration/test_concurrency_regression.py:1294-1299` and `:1703-1709` both run with\n   `check=False` and assert only `kind` membership inside `issues[]`. And no doc states the\n   contract: `docs/concurrency.md` I8 (`:392-405`) says only \"discoverable\" / \"reports as a\n   finding\" / \"surfaced\"; `docs/exit-codes.md` has no fsck finding→exit mapping.\n\n### Reasoning\n\nAn integrity checker's exit code answers one question: *is this store in a state that needs\nattention?* A resolved STATUS fork is not that. The reducer already decided it, deterministically\nand skew-independently (lower-UUID-wins, `docs/concurrency.md` I8), and it will decide it the\nsame way on every replay forever. There is no repair to run, no operator action that clears it,\nand no state to converge — the record is the *history* of a race, not a live condition. Counting\nhistory toward \"needs attention\" makes the signal constant, and a constant signal is not a\nsignal.\n\nStory 3003's stated goal was to make a lost claim **discoverable** rather than silent. That is\ndelivered by the finding itself plus `claim`'s exit-10 post-push re-read — not by the exit code,\nwhich cannot tell you *which* ticket forked. Discoverability is fully preserved.\n\n### This is a deliberate CLI behaviour change, and is treated as one\n\nIt narrows what counts as an \"issue\"; it does **not** touch the `issue_count > 0 → exit 1`\nmapping, which stays exactly as `git fsck`/`fsck(8)` scripts expect. Accordingly it ships with:\na dedicated counted-ness test modelled on\n`tests/unit/test_doctor_dirty_tree.py:228-241`; a `docs/user-guide.md` entry beside the\n`TRACKER_DIRTY_TMP_EVENT` precedent; and a note on `docs/concurrency.md` I8.\n\n**Known residual (pre-existing, deliberately NOT fixed here).** `--output json`'s `issue_count`\nis recomputed as `len(issues)` at `fsck.py:139` over every uppercase `KIND:` line, so it already\ndisagrees with the exit code for `PUSH_PENDING` and `TRACKER_DIRTY_TMP_EVENT` today\n(`tests/unit/test_doctor_dirty_tree.py:202-218` pins that). `STATUS_FORK_RESOLVED` will join that\nset. Reconciling text-count vs JSON-count is a separate, wider CLI change affecting kinds this\nbug does not own — filed as its own ticket rather than smuggled in here.\n","timestamp":1787859215736706097},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## `caused_by` link REFUSED — recorded here instead, NOT forced\n\nAttempted: `link cutprice-untameable-stork 42a0-25c8-7d97-4764 caused_by`.\n\nRefused, exit 1:\n\n> cannot create caused_by link — target ticket '42a0-25c8-7d97-4764' has no commit referencing\n> it, so it cannot be shown to have introduced anything. Point caused_by at the ticket whose\n> commit carries its 'rebar-ticket:' trailer, or override with --force=\"<reason>\".\n\n**Cause of the refusal, verified.** The originating commit `ffe34ca90c88` (2026-06-09) predates\nthe `rebar-ticket:` trailer convention and cites its ticket as a free-text\n`Story: 42a0-25c8-7d97-4764` line, so the guard's trailer scan finds nothing. The attribution\nitself is sound (see the RCA comment); only the *edge* cannot be written.\n\n**Not forced.** The documented escape hatch is `--force=\"<reason>\"`, and agents must not use\nforce overrides — that is a human operator's call. Escalating rather than bypassing.\n\n**For a human operator**, the intended edge and its reason:\n\n```\nrebar link cutprice-untameable-stork 42a0-25c8-7d97-4764 caused_by \\\n  --force=\"scope-of-work attribution: commit ffe34ca90c88 predates the rebar-ticket: trailer\n           convention and cites the story as a free-text 'Story:' line, so the guard's trailer\n           scan cannot see it; that commit authored fsck.schema.json and typed fsck's MCP\n           siblings while leaving MCP fsck untyped\"\n```\n\nUntil then the attribution lives only in the RCA comment, and `git blame` auto-derivation on any\nfuture close would name the carrier commits (`9f7bd2464d552` / `04117bd74a8cf`) instead — which\nis the wrong answer for the escaped-defect metric.\n","timestamp":1787859357368837760},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Plan review — Layer-1 clean, LLM layer could not run (server environment)\n\n`review_plan(source=\"local\")` on the plan above:\n\n- **All 11 deterministic checks PASS**, zero blocking, zero advisory, zero coaching, zero\n  indeterminate findings: P1 readiness-shape (5 AC items, 0 empty, clarity 4), P2 resolution\n  (9 references probed, 8 resolved), P3 package-existence, P4 oversize (5322/8000 chars,\n  13 file-impact entries), P5 task-dag, P6 ac-quality (0 citation gaps, 0 provenance gaps),\n  P7 destructive-sniff (no hits), P8 reviewability (1353/868000 tokens), P9 file-impact-coverage\n  (13, applicable), P10 verification-presence (3 qualifying AC items), P11 ac-vagueness (0 vague).\n- **Verdict INDETERMINATE, unsigned**, solely because the LLM layer did not run:\n  `\"llm_unavailable\": true`, `\"llm_error\": \"a bedrock model/provider is configured but the\n  optional bedrock provider package is not installed: pip install 'pydantic-ai-slim[bedrock]'\"`.\n  That is an environment fault on the MCP server host, not a finding against this plan.\n\nTwo further environment notes from the same attempt, recorded so the next session does not\nre-derive them:\n\n- `review_plan` with the DEFAULT `source=\"attested\"` fails outright:\n  `cannot resolve ref 'origin/main' to a commit in '.'` — and the same for an explicit full SHA.\n  The primary checkout resolves `origin/main` to `269f7b49c44f` fine, so the MCP server process\n  is rooted somewhere that is not that repo. `source=\"local\"` is the working path today.\n- `claim` succeeded WITHOUT a signed attestation and WITHOUT any force override, so the\n  plan-review claim gate is not enforcing on this project at present.\n\n**No force override was used anywhere in this session.**\n","timestamp":1787859701914721166},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Second defect found by the held-out oracle: an UNSCANNABLE store was reported as CLEAN\n\nThe first pass of the fix went 7/8 against the held-out RED test. The one failure was the AC2\ntest (\"a genuine execution failure stays distinguishable\"), and it caught something the plan had\nmis-modelled.\n\n**The plan assumed an uninitialised store makes fsck exit `2`. It does not — it exits `1`.**\nVerified in-process:\n\n```\nrc = fsck_cli([\"--output=json\"], repo_root=<git repo with no .tickets-tracker>)\n# rc: 1\n# STDOUT: '{\"issues\": [], \"fixed\": [], \"issue_count\": 0}\\n'\n# STDERR: ''\n```\n\n`src/rebar/_commands/fsck.py:246-268` (`_missing_tracker_result`) returns `1`, and in JSON mode\n(`:260-262`) writes a payload byte-indistinguishable from a clean store — the \"not initialized\"\ndiagnostic reaches stderr only in TEXT mode. So the first-pass `fsck_report` returned\n\n```\n{'issues': [], 'fixed': [], 'issue_count': 0, 'returncode': 1}\n```\n\nfor a store it could not scan at all: **a fabricated clean report**. That is worse than the\noriginal bug — the original at least screamed; this would have told a caller \"your store is\nfine\" when the truth is \"there is no store here\". The `json.loads` guard could not catch it\nbecause the payload is valid JSON.\n\n**The discriminator, and why it is exact rather than a heuristic.** The exit code comes from\n`_scan`'s COUNTED tally, while `--output json`'s `issues[]` is every uppercase `KIND:` line the\ntext report emitted — a strict SUPERSET of the counted ones (`fsck.py:120-139`). A genuine scan\nthat exits 1 must have counted ≥1 issue, hence emitted ≥1 `KIND:` line, hence has a non-empty\n`issues[]`. So **`returncode == 1` with an empty `issues[]` is unreachable for a real scan** and\nuniquely identifies the could-not-run path. `fsck_report` now raises `RebarError` on it. No CLI\nchange is needed.\n\nThis is the value of holding the oracle out from the implementer: the test encoded the\n*property* (\"a run that could not happen must never be reported as a completed clean run\"), not\nthe plan's guess about the mechanism (`exit >= 2`), so it failed the incomplete fix instead of\nagreeing with it.\n\n**Residual, NOT fixed here.** The CLI's own `fsck --output json` still renders an uninitialised\nstore as `{\"issues\": [], \"fixed\": [], \"issue_count\": 0}` with exit 1, discarding the\n\"not initialized\" diagnostic that TEXT mode prints to stderr. That is a pre-existing CLI output\ndefect on a path this bug does not own; folded into the follow-up ticket\n`29c3-b025-04d7-454e` (sugarcane-scrummy-arctichare), which already owns fsck's\nJSON-vs-exit-code disagreements.\n","timestamp":1787860129784552284},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## LIVE VALIDATION — attempted against the deployed endpoint. **PRE-FIX reproduction confirmed; the new AC is NOT satisfied and its box stays UNTICKED.**\n\n**Tool called:** `fsck`\n**Arguments:** `{}` (no arguments; `recover` left at its default `false`)\n**Endpoint:** the deployed rebar MCP server this session is connected to\n**When:** 2026-08-27, against the live shared store\n\n**Actual response — an ERROR object, verbatim:**\n\n```json\n{\"error\": \"command_failed\", \"input\": \"\", \"exit_code\": 1,\n \"message\": \"rebar fsck failed (exit 1): STATUS_FORK_RESOLVED: 218e-0ec1-385d-493a — concurrent claim/status race resolved (dropped uuid=968473b9-c90d-4c2f-88a7-a38bf3ce43b8)\\nSTATUS_FORK_RESOLVED: 3b78-de05-a125-418f — …\\nSTATUS_FORK_RESOLVED: 3e3f-8236-d619-43d7 — …\\nSTATUS_FORK_RESOLVED: 4214-ac28-d19c-41b9 — …\\nSTATUS_FORK_RESOLVED: 8ed5-9c7d-cb86-42c8 — …\\nSTATUS_FORK_RESOLVED: b043-9490-32ca-4548 — …\\nSTATUS_FORK_RESOLVED: fc9e-8c2e-cb2f-465f — …\\nORPHAN_EVENT: 79ef-23b3-04f2-42d2/1787486680190948001-…-COMMENT.json — pre-snapshot event not captured in source_event_uuids\\nORPHAN_EVENT: 8c8a-2756-ecfa-4b90/…-LINK.json — …\\nORPHAN_EVENT: cf34-9b8b-1aa7-4d95/…-LINK.json — …\\nORPHAN_EVENT: e042-4780-6c63-4b09/…-EDIT.json — …\\nENV_ID_MISMATCH: this environment ('eea68b7f-6697-488b-ac52-744e2ed8e96f') has also written events under 2 other environment id(s) (ad49f17f-…, b2b5c498-…) — …\\nensures: 9/9 applied\\nauthorship: 31707 signed, 17760 unsigned event(s) — run `rebar verify-authorship`\\nfsck complete: 12 issues found\"}\n```\n\n**This is the BUG reproducing live, not the fix working.** It matches the original report\nexactly — 12 findings (7 `STATUS_FORK_RESOLVED`, 4 `ORPHAN_EVENT`, 1 `ENV_ID_MISMATCH`),\nnewline-joined into a single `message` string inside an `error` object, with no way for a client\nto enumerate them. The container is still serving the pre-fix build; the change is committed\nlocally and has not been landed or deployed.\n\n**Status of the new criterion: PENDING DEPLOYMENT.** The box is deliberately left unticked — a\npassing local test is not evidence, and I have not deployed anything. Re-run this exact call\nafter the change lands and the container redeploys; the expected post-fix response is a\nstructured object, i.e. `{\"issues\": [{\"kind\": \"status_fork_resolved\", \"ticket_id\":\n\"218e-0ec1-385d-493a\", \"detail\": \"…\"}, …], \"fixed\": [], \"issue_count\": …, \"returncode\": 1}`.\n\n### Two things this live store tells us that the local fixtures could not\n\n1. **The AC4 change does not mask real damage on this store.** 7 of the 12 findings are\n   self-healed `STATUS_FORK_RESOLVED`. After the change those stop counting, so the counted\n   tally drops from 12 to 5 — but `ORPHAN_EVENT` ×4 and `ENV_ID_MISMATCH` are genuine, still\n   counted, and this store still exits 1. Uncounting the self-healed class narrows the signal;\n   it does not silence it. That is the outcome the AC4 decision predicted, now observed on real\n   data.\n2. **The \"permanently failing\" claim is real, at scale.** Seven distinct tickets on the shared\n   store carry a permanent resolved-fork record. Since `status_fork_resolutions` never clears,\n   this store's `fsck` could never have returned 0 again — exactly the constant-signal failure\n   mode the decision comment argued from.\n\n### Plan-review attestation\n\n`plan_review_status` reports `{\"ok\": false, \"verdict\": \"unsigned\", \"reason\": \"no certified\nplan-review attestation (signature: unsigned; ticket has no signature)\"}`. This is not\n`stale-material` from the description edit — there was never a signed attestation to go stale:\nthe earlier `review_plan` run returned INDETERMINATE and therefore did not sign, because the\nLLM layer could not run on the server (`\"llm_error\": \"a bedrock model/provider is configured but\nthe optional bedrock provider package is not installed\"`). Its 11 deterministic checks all\npassed with zero blocking findings. Re-running would hit the same missing provider package, so\nit would consume 15-20 minutes and still return unsigned. Recorded rather than repeated. The\n`claim` succeeded without an attestation and **without any force override**, so nothing is being\nbypassed.\n","timestamp":1787861293581220887},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Fix landed locally — commit `191838cb37399086a6aa08f0b5fe25dc1c99518d`\n\n`rebar verify-commit-ticket --rev HEAD` → `OK - resolved 326f-595a-088b-40a5` (exit 0).\nSigned-off-by RebarBotNava <joeoakhart+bot@navapbc.com>, Change-Id stamped, all pre-commit\nhooks passed. **Committed locally only — not pushed, not submitted**, per the operator's\ninstruction.\n\n### What changed (12 files, +377 / -8)\n\n| File | Why |\n|---|---|\n| `src/rebar/_lib_reads.py` | new `fsck_report()` — asks `fsck_cli` for `--output=json` so the shape comes from the CLI's OWN transform (text and JSON cannot drift); returns a dict for any COMPLETED run with the exit code as data in `returncode`; raises only on a genuine execution failure |\n| `src/rebar/__init__.py` | export `fsck_report` (+ `__all__`) |\n| `src/rebar/_mcp_models.py` | new `FsckOut` mirroring `fsck.schema.json`, following the `_Out` / `ClarityResultOut` / `BridgeFsckOut` pattern (incl. the `None` fallback in the no-pydantic branch) |\n| `src/rebar/_mcp_reads.py` | `fsck` tool → `-> FsckOut` via `fsck_report`; advertises the canonical outputSchema like every read tool around it. `recover`/`REBAR_MCP_READONLY` guards untouched |\n| `src/rebar/schemas/fsck.schema.json` | declare optional `returncode` (kept OUT of `required`, so the CLI's own `--output json` payload validates unchanged) |\n| `src/rebar/schemas/check_mcp_models.py` | register `FsckOut → fsck` so the CI drift gate covers it |\n| `src/rebar/_commands/fsck_scan.py` | AC4 — drop the `issues += 1` for `STATUS_FORK_RESOLVED`; line emission byte-identical |\n| `docs/user-guide.md`, `docs/concurrency.md` | document the new never-counted class beside the `TRACKER_DIRTY_TMP_EVENT` precedent; note it on invariant I8 |\n| `tests/interfaces/facades/test_mcp_output_schema_coverage.py` | move `fsck` out of `EXEMPT_GENERIC` into `CANONICAL` (+ its `_call_args` entry) — a STRENGTHENING: the tool's real result is now schema-validated instead of excused |\n| `tests/unit/api_surface_baseline.json` | record the new public `fsck_report` symbol |\n| `tests/interfaces/facades/test_fsck_structured_326f.py` | NEW — the 8-test held-out oracle |\n\n`rebar.fsck()` is **unchanged**: still `-> str`, still raises on non-zero. Its ~10 existing\ncallers across `tests/interfaces/**` are untouched.\n\n### RED → GREEN, with the oracle held out from the implementer\n\nThe oracle was written first, observed RED, then physically MOVED OUT of the working tree\nbefore the fix was written, so the implementer never saw it.\n\n**RED (fix absent), 6 failed / 2 passed** — each for the right reason:\n- `test_mcp_fsck_with_findings_...` → `ToolError: Error executing tool fsck: {\"error\"...` (the reported bug)\n- three × `AttributeError: module 'rebar' has no attribute 'fsck_report'`\n- `test_mcp_fsck_advertises_the_canonical_output_schema` → `AssertionError: {'result'}` (the generic string wrapper)\n- `test_status_fork_resolved_...` → exits 1 on a self-healed-only store\n\nThe 2 that passed RED are the PRESERVED-contract tests (CLI exit; legacy `rebar.fsck`) —\ncorrect: they must be green before AND after.\n\n**GREEN: 8 passed.**\n\n### Mutation check — the test has teeth (run under an OS sandbox)\n\nPer protocol the mutation run executed inside a `sandbox-exec` profile denying writes outside\nthe worktree and a scratch dir (probed first: worktree write OK, outside write\n`Operation not permitted`). Four defect-seeded mutations, each re-introducing a specific\nconfirmed defect:\n\n```\nBASELINE (unmutated fix)                                  8 passed\nM1  re-seed `rc != 0 -> raise` (the root cause)           3 failed  <- killed by\n      test_mcp_fsck_with_findings_returns_enumerable_structure_not_an_error\n      test_library_fsck_report_with_findings_returns_completed_run\n      test_fsck_report_raises_when_fsck_could_not_run\nM2  re-seed the fabricated-clean-report defect            1 failed  <- test_fsck_report_raises_when_fsck_could_not_run\n                                                                       (Failed: DID NOT RAISE RebarError)\nM3  restore `issues += 1` for STATUS_FORK_RESOLVED        1 failed  <- test_status_fork_resolved_is_reported_but_does_not_fail_the_run\nM4  MCP tool back to `-> str` via rebar.fsck              2 failed  <- the enumerable-structure test + the outputSchema test\nRESTORED                                                  8 passed\n```\n\nEvery mutation is killed by the test that owns that behaviour. No mutation survived.\n\n**Refactoring litmus:** the oracle asserts only observable output — returned dict contents,\n`returncode`, the raised exception and its message, CLI exit codes, and the advertised\n`outputSchema` properties. No private names, no intermediate variables, no source greps. A\nrename or a behaviour-preserving extraction would not turn it red.\n\n### One honest test correction, done under the strict guard\n\nThe plan assumed a could-not-run fsck exits ≥ 2. It exits **1** (see the previous comment).\nWhen the oracle's *secondary* assertion (`returncode not in (0, 1)`) failed on a correct fix, I\nfollowed the guard in order: **reverted the fix completely → revised the test → re-verified it\nRED with no fix present (6 failed) → re-applied the fix → confirmed GREEN (8 passed)**. The\nrevised assertion tests the observable contract (it raised, and the error names the unscannable\nstore) instead of the plan's guess about the exit code, and says in its docstring why the exit\ncode cannot carry that distinction. The fix was never edited alongside the test.\n\n### Verification (real output)\n\n```\n$ make lint\nruff check src tests scripts        -> All checks passed!\nruff format --check src tests scripts -> 2464 files already formatted\npython scripts/check_complexity_baseline.py --check -> active=40 new=0 increased=0 stale=9\nConfig-read gate: OK   wall-clock-asserts: clean   zizmor: No findings to report\nLINT EXIT=0\n\n$ make typecheck\nmypy src/rebar scripts -> Success: no issues found in 677 source files\n\n$ python -m rebar.schemas.check_mcp_models --check\nsrc/rebar/_mcp_models.py: MCP model schema drift gate OK — no missing declarations\n\n$ python -m pytest <targeted suites> -q\n110 passed   (test_mcp_output_schema_coverage, test_library, test_fsck_ensures,\n              test_gen_mcp_reference, test_schema_outputs, test_doctor_dirty_tree,\n              test_reducer_status_fork_record)\n\n$ python -m pytest tests/interfaces/facades/test_fsck_structured_326f.py -q\n8 passed\n```\n\nComplexity ratchet `new=0 increased=0` — no function got more complex; the baseline JSON was\nnot touched. Module sizes after the change: `_lib_reads.py` 443, `_mcp_reads.py` 550,\n`_mcp_models.py` 458, `fsck_scan.py` 416 — all well under the 800 cap.\n\n### Step 7 sweep\n\n**Axis 1 (construct: \"a library facade converts a diagnostic verdict exit into an exception\").**\nSwept every `raise RebarError` in the library facades (`_lib_reads.py`, `_lib_gates.py`,\n`_lib_mutations.py`). **Zero other live instances.** The four commands whose non-zero exit is a\nVERDICT rather than a failure — `check_ac` (0=has-AC, 1=missing), `quality_check`,\n`clarity_check`, `validate` (3/4 = poor/critical health) — already return structured verdicts:\n`_lib_gates.py:35,61,75,90` all return `ClarityResult`/`GateResult`/`ValidateReport`, none\nraise. `_lib_gates.py:168` is a not-found raise, a different thing. `fsck` was the only offender.\n\n**Axis 2 (parity census).** Rule: *a completed fsck run yields a structured, enumerable result.*\n- CLI — HOLDS (`_commands/fsck.py:139-146`).\n- MCP tool — was **MISSING** → fixed here.\n- Library facade — was **MISSING** → fixed here.\n- Automated callers — **N/A**: the MCP startup sweep calls `_store.ensures.run_ensures`\n  (`_mcp_health.py:179-183`), not fsck; `doctor` imports fsck's classifier LEAVES directly\n  (`doctor.py:202,372`), not `rebar.fsck`/`fsck_cli`. The only `fsck_cli` callers in `src/` are\n  `_lib_reads.py:347,389` and the CLI registry `_registry.py:566`. Neither automated path\n  crosses the exit-code→exception conversion.\n- Dual-direction (`bridge fsck`, the sibling audit) — HOLDS: MCP `bridge_fsck` already returns\n  `BridgeFsckOut` and is in the coverage suite's CANONICAL list.\n\nNo MISSING slot left undispositioned.\n\n### Fix-safety audit\n\n- **Restoration/wiring, not creation.** The capability was designed and its artifacts already\n  shipped — `fsck.schema.json` exists and is registered as `schemas.FSCK`, and the coverage\n  suite recorded the MCP gap in prose. This wires approved-but-unwired work; it adds no new\n  entry point, user-visible artifact, or mutating external call. The one API addition\n  (`rebar.fsck_report`) is recorded in `api_surface_baseline.json`.\n- **No new dependency.** Only stdlib (`contextlib`, `io`, `json`) and intra-package imports the\n  module already used.\n- **No test weakening.** The only pre-existing test changes are the coverage-suite move\n  (excused → schema-validated, strictly stronger) and a baseline addition. No assertion removed\n  or loosened, no `skip`/`xfail` added.\n\n### Caller-dependency gate\n\n`rebar.fsck()`'s ~12 call sites depend on its string return — preserved by not touching it.\nThe MCP tool's only in-repo dependency was the coverage suite's exemption entry, updated. No\ntest or doc pinned `STATUS_FORK_RESOLVED`'s counting (the two integration assertions at\n`test_concurrency_regression.py:1294-1299,1703-1709` run `check=False` and assert `kind`\nmembership only). No behavioural dependency blocks the change.\n","timestamp":1787862120611521483}],"created_at":1787858225689088001,"creation_channel":"cli","deps":[],"description":"## Summary\n\n`fsck` is a DIAGNOSTIC tool: finding problems is its purpose and its success condition. The MCP\ntool nevertheless converts a completed report into `command_failed`, so the caller receives an\nerror object with the entire report stuffed into a message STRING rather than a structured\nresult.\n\n## Mechanism (runtime-confirmed — see the RCA comment)\n\n- `src/rebar/_commands/fsck.py:242-243` — the CLI exits non-zero when `issue_count > 0`.\n  **Correct; NOT the defect.**\n- `src/rebar/_lib_reads.py:347-353` — calls `fsck_cli([])` (TEXT mode, so it never asks for the\n  JSON the CLI can already produce) and raises `RebarError(f\"rebar fsck failed (exit {rc}): ...\")`\n  on ANY non-zero rc, flattening the report into an exception message. **This is the defect.**\n- `src/rebar/_mcp_reads.py:385,396` — `def fsck(...) -> str` (so no `outputSchema`) returning\n  `rebar.fsck(...)`, so that raise reaches the client as\n  `{\"error\":\"command_failed\",\"exit_code\":1,\"message\":\"<whole report>\"}`.\n\nVerified: on a store with findings, `rebar fsck --output json` returns rc 1 AND a structured\n`{\"issues\":[{\"kind\",\"ticket_id\",\"detail\"}],\"fixed\":[],\"issue_count\":2}` — while `rebar.fsck()`\nraises on the same store. The structure exists one layer down and is discarded.\n\nfsck's rc vocabulary already separates the two states: `0` clean, `1` **issues found** (a\ncompleted run), `2` usage error / uninitialised store. `rc != 0` collapses them.\n\n## What is EXPECTED and what is the BUG\n\n**Expected: the CLI exiting non-zero on findings.** Conventional for an integrity checker\n(`git fsck`, `fsck(8)`); scripts depend on it. Not a defect. **The bug is the library/MCP layer\ntreating that as a FAILED CALL.**\n\n## Plan\n\n1. **`src/rebar/_lib_reads.py` — new `fsck_report(*, recover=False, report_only=False,\n   repo_root=None) -> dict`.** Runs the same in-process `fsck_cli`, but passes `--output=json`\n   so the CANONICAL shape comes from the CLI itself (no second implementation, so text and JSON\n   cannot drift). Returns `{issues, fixed, issue_count, returncode}` when\n   `returncode in (0, 1)` — a COMPLETED run, findings or not. Raises `RebarError` when\n   `returncode not in (0, 1)` — fsck could not RUN (usage error, uninitialised store,\n   `RepairPauseError`) — so a genuine execution failure stays distinguishable from a completed\n   run with findings. The `recover=True` path has no `--output json` in `fsck_recover_cli`, so\n   its text is put through the SAME shared `_transform_json` transform for a uniform shape.\n2. **`rebar.fsck()` is left exactly as it is** — `-> str`, raising on non-zero. It has ~10\n   existing callers across `tests/interfaces/**` that assert on its string return; changing it\n   would break them, and nothing requires it.\n3. **`src/rebar/_mcp_models.py` — add `FsckOut`** mirroring `src/rebar/schemas/fsck.schema.json`\n   (which ALREADY EXISTS, registered as `schemas.FSCK`), following the `_Out` /\n   `ClarityResultOut` / `BridgeFsckOut` pattern its neighbours use.\n4. **`src/rebar/_mcp_reads.py` — `fsck` returns `FsckOut`** built from `rebar.fsck_report()`, so\n   the tool advertises an `outputSchema` like every read tool registered around it. `recover` and\n   `report_only`/`REBAR_MCP_READONLY` handling is unchanged.\n5. **`src/rebar/schemas/fsck.schema.json`** — declare `returncode` as an OPTIONAL property (kept\n   out of `required` so the CLI's own `--output json` payload still validates unchanged), and\n   register `FsckOut -> fsck` in `check_mcp_models.MODEL_SCHEMAS` so the CI drift gate covers it.\n6. **AC4 (`src/rebar/_commands/fsck_scan.py`)** — `STATUS_FORK_RESOLVED` stops incrementing the\n   issue counter; the line and its `issues[]` entry are unchanged. Reasoning, evidence, and the\n   deliberate-behaviour-change treatment are in the AC4 decision comment.\n7. **Docs**: regenerate `docs/mcp-reference.md`; document the new counted-ness in\n   `docs/user-guide.md` beside the `TRACKER_DIRTY_TMP_EVENT` precedent and on `docs/concurrency.md`\n   I8.\n\n## Test plan\n\nRED first, held out from the implementer:\n`tests/interfaces/facades/test_fsck_structured_326f.py` builds a store WITH findings and asserts\nthe MCP-layer call returns an enumerable structured result (findings addressable by `kind` and\n`ticket_id`) rather than raising; that `returncode` distinguishes 0/1; that a store fsck cannot\nRUN against still raises; and that `STATUS_FORK_RESOLVED` is emitted but not counted. Mutation-\nchecked by re-seeding the confirmed defect (restoring the `rc != 0` raise) and confirming RED.\n\n## Acceptance Criteria\n\n- [ ] The MCP `fsck` tool returns a STRUCTURED result (findings enumerable by kind and ticket)\n      for a completed run, whatever the findings, and advertises an `outputSchema`.\n- [ ] A genuine execution failure (fsck could not run, rc not in 0|1) remains distinguishable\n      from a completed run that found issues.\n- [ ] The CLI's non-zero-on-findings exit is PRESERVED — scripts depend on it; only the\n      library/MCP surfacing changes.\n- [ ] `rebar.fsck()`'s existing `-> str`/raise contract is unchanged for its existing callers.\n- [ ] Decided and recorded whether self-resolved `STATUS_FORK_RESOLVED` entries count toward the\n      failure exit; the CLI's exit reflects that decision.\n\n## Reported by\n\nA parallel Copilot CLI session against the deployed server.\n\n- [ ] **LIVE VALIDATION — REQUIRED TO CLOSE.** `fsck` called through the deployed endpoint returns a STRUCTURED result with enumerable findings, not `command_failed`.\n      Evidence must be OBSERVED against the deployed server at\n      `https://rebar.solutions.navateam.com/mcp` and recorded in a ticket comment naming\n      the tool(s) called, the arguments, and the actual response. A passing local test is\n      NOT sufficient, and neither is a merged change: the container must have redeployed\n      and served the call. This exists because a fix here was previously reported complete\n      on the strength of a merge while the deployed behaviour was still broken.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_lib_reads.py","reason":"add fsck_report(): structured dict for a COMPLETED run (rc 0|1); raise RebarError only on rc not in (0,1) (genuine execution failure). rebar.fsck() str/raise contract untouched."},{"path":"src/rebar/__init__.py","reason":"re-export fsck_report from _lib_reads and add to __all__"},{"path":"src/rebar/_mcp_models.py","reason":"add FsckOut mirroring fsck.schema.json ({issues,fixed,issue_count,returncode})"},{"path":"src/rebar/_mcp_reads.py","reason":"MCP fsck returns FsckOut (advertises outputSchema) via rebar.fsck_report() instead of str via rebar.fsck()"},{"path":"src/rebar/schemas/fsck.schema.json","reason":"declare optional returncode (0=clean, 1=completed-with-findings) so the completed/failed distinction is machine-readable"},{"path":"src/rebar/schemas/check_mcp_models.py","reason":"register FsckOut -> fsck in MODEL_SCHEMAS so the drift gate covers it"},{"path":"src/rebar/_commands/fsck_scan.py","reason":"AC4: STATUS_FORK_RESOLVED no longer increments the issue counter (still emitted, still in issues[])"},{"path":"docs/mcp-reference.md","reason":"regenerate: fsck row gains its typed/outputSchema entry"},{"path":"docs/user-guide.md","reason":"document STATUS_FORK_RESOLVED as report-only/never-counted beside the TRACKER_DIRTY_TMP_EVENT precedent"},{"path":"docs/concurrency.md","reason":"I8: note the resolved fork is surfaced but does not fail the fsck exit"},{"path":"tests/unit/api_surface_baseline.json","reason":"add the new fsck_report public library symbol"},{"path":"tests/interfaces/facades/test_fsck_structured_326f.py","reason":"NEW: RED->GREEN oracle — MCP-layer fsck against a store WITH findings returns enumerable structured findings, not an error; rc>=2 still raises; STATUS_FORK_RESOLVED counted-ness"},{"path":"tests/interfaces/contracts/test_schema_outputs.py","reason":"extend fsck conformance to the new structured library/MCP shape"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"6b484729-ee83-499b-a578-a4be7cdde22c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["mcp","fsck","dx","api"],"ticket_id":"326f-595a-088b-40a5","ticket_type":"bug","title":"MCP fsck turns a SUCCESSFUL diagnostic report into a tool error, so the report is unusable","verify_commands":[]},"source_event_uuids":["3645621b-c3ad-49e6-9cb6-73f441fe63a9","3ebffb1f-5b4b-47ec-b65a-31832da1e6b9","9fb8d532-4629-4b34-912f-dac36a010a15","36c3f619-f482-4269-9286-d36e6434acd1","cd464cb1-247e-4976-b2b4-dfb3706cfc5d","88e92086-68b4-497b-aad8-e69cb1e7f1d3","6b484729-ee83-499b-a578-a4be7cdde22c","c46ba14f-93d9-41f5-95bc-db206d9853a6","bfd3a0aa-a3aa-4f0a-a230-d0d79c602512","e23ada66-578a-4f59-a748-d82ef971d2f6","28e9c1b9-a6ed-49ef-8843-55ffa2ea306e","8e7c1224-a929-48e8-a599-109bb4079ae5","53318c52-8947-4d78-bb16-668dfc10d1ef"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787862120611521484,"uuid":"257031aa-9563-4103-a169-36069147d386"}