  tree=ast.parse(raw,type_comments=True); seen=set(); allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path):\n    tree=ast.parse(raw,type_comments=True); lines=raw.splitlines(); scopes=[(\"<module>\",1,len(lines))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno)); walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\"); full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]; i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1; continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((s for s in scopes if s[1]<=comments[0][0]<=s[2]),key=lambda s:s[2]-s[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(text for _,text in comments)))\n    rules=ALLOWED[path][\"comments\"]\n    for scope,prefix in rules:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in regions)>1:\n            raise SystemExit(\"ambiguous comment stable id: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    protected=[r for r in regions if not any(r[0]==scope and r[1].startswith(prefix) for scope,prefix in rules)]\n    return inline,protected,regions\nfor path in sys.argv[1:]:\n    before=source(BASE,path); after=source(\"HEAD\",path)\n    if normalize(before,path,True)!=normalize(after,path,False):\n        raise SystemExit(\"normalized AST changed: \"+path)\n    bi,bp,br=comment_state(before,path); ai,ap,ar=comment_state(after,path)\n    for scope,prefix in ALLOWED[path][\"comments\"]:\n        if sum(o==scope and a.startswith(prefix) for o,a,_ in br)!=1:\n            raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    if bi!=ai:\n        raise SystemExit(\"inline comment changed: \"+path)\n    if bp!=ap:\n        raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)\n' tests/unit/test_canonical_consolidation.py tests/unit/test_caplog_coverage_integrity.py tests/unit/test_cas_backoff_refetch_baldish.py tests/unit/test_caused_by_dedup_10d0.py tests/unit/test_caused_by_provenance.py tests/unit/test_change_input_not_an_outage_43d4.py tests/unit/test_changed_criteria.py tests/unit/test_check_build_env_locked.py tests/unit/test_check_criteria_vocabulary.py tests/unit/test_check_deploy_manifest.py tests/unit/test_check_templatefile_escapes.py tests/unit/test_child_env_concurrency.py tests/unit/test_child_env.py tests/unit/test_child_oracle_fail_open.py tests/unit/test_ci_actionlint_install.py tests/unit/test_ci_actionlint_scope.py tests/unit/test_ci_main_push_policy.py tests/unit/test_ci_provider_matrix.py","dd_id":"semantic","dd_text":"Immutable/final Python parses; only allowlisted leading docstrings and full-line comment regions may differ; normalized runtime ASTs match."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nPATTERN=re.compile(r\"#\\s*(?:!|-*-|coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef signatures(raw):\n    lines=raw.splitlines(); found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string):\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            anchor=(\"inline\",left.strip())\n        else:\n            anchor=(\"next\",\"<EOF>\")\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    anchor=(\"next\",stripped); break\n        found.append((tok.string,anchor))\n    return found\nfor path in sys.argv[1:]:\n    if signatures(source(BASE,path))!=signatures(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \"+path)\n' tests/unit/test_canonical_consolidation.py tests/unit/test_caplog_coverage_i