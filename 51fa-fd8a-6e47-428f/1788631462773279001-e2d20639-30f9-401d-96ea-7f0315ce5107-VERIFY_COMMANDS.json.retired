{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nALLOWED=json.loads(\"{\\\"tests/unit/test_canonical_consolidation.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_caplog_coverage_integrity.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_POISONED_TESTS =\\\"],[\\\"<module>\\\",\\\"_LEVEL_POISONED_TESTS =\\\"]]},\\\"tests/unit/test_cas_backoff_refetch_baldish.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_caused_by_dedup_10d0.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_caused_by_provenance.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_change_input_not_an_outage_43d4.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_a_genuine_outage_still_raises_the_outage_type\\\",\\\"test_a_rejected_input_reaches_the_size_ladder_instead_of_aborting_the_review\\\",\\\"test_the_new_prefix_does_not_itself_look_like_a_context_limit\\\",\\\"test_a_rejected_input_still_fails_the_epic_bug_screen_closed\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_changed_criteria.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"from types import SimpleNamespace\\\"]]},\\\"tests/unit/test_check_build_env_locked.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_NORM_LOCK =\\\"]]},\\\"tests/unit/test_check_criteria_vocabulary.py\\\":{\\\"docs\\\":[],\\\"comments\\\":[[\\\"<module>\\\",\\\"def _init_git_repo\\\"],[\\\"test_make_lint_rejects_live_vocabulary_through