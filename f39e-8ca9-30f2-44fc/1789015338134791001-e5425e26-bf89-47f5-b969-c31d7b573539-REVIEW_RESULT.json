nts are emitted under normal conditions.","group_criteria":null,"group_id":null,"id":"fce59452ba52c67c8","impact":0.0,"is_primary":null,"location":"AC1 and Testing/Verification (existing test list)","norm_id":"neb943ffec6550271","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["Next total outage recurs, the runbook points at a memory series that in practice still truncates under load, and the ticket closed green because the cited unit tests only proved emission under normal conditions, not survival of the run-up through probe SIGTERM."],"severity":null,"suggested_fix":"In AC1's verification, cite the exact assertion in test_observability_memory_9ea3.py (or add one) that reproduces the probe-timeout/truncation condition and asserts memory datapoints still reach CloudWatch across the run-up window; if no such assertion exists, state that as a gap to close.","tier":"LLM","validity":0.2222,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Make AC1's verification prove the RELIABILITY claim it makes: either cite/measure current live