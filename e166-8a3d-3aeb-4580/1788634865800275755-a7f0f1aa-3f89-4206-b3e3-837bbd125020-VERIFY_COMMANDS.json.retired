{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, re, subprocess, sys, tokenize\nBASE='\"'\"'d6669496cae441fc8381b5ee6de21a3993defd84'\"'\"'\nCURRENT='\"'\"'6e3c3571dd5b4f82a0faf55ac4b3f3a44401b708'\"'\"'\nALLOWED=json.loads('\"'\"'{\"tests/unit/test_code_review_criteria_normalization.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_criteria_routing.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_discovery.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_finalize.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_fp_ledger.py\":{\"docs\":[\"<module>\"],\"comments\":[{\"scope\":\"<module>\",\"before\":\"def _verified\"}]},\"tests/unit/test_code_review_gate_session.py\":{\"docs\":[\"<module>\",\"test_code_review_gate_runner_is_rebuilt_from_rerooted_ticket_store\"],\"comments\":[]},\"tests/unit/test_code_review_per_pass_classes.py\":{\"docs\":[\"<module>\",\"test_the_batch_steps_declare_inside_batch_not_at_step_level\",\"test_no_pass_resolves_to_anthropic_when_configured_for_bedrock\"],\"comments\":[]},\"tests/unit/test_code_review_provenance_heldout_2d1c.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_provenance.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_code_review_triggers.py\":{\"docs\":[\"<module>\"],\"comments\":[{\"scope\":\"<module>\",\"before\":\"def test_concurrency_registered_in_overlay_vocabulary\"},{\"scope\":\"<module>\",\"before\":\"def test_project_concurrency_tokens_fire_only_under_repo_routing\"}]},\"tests/unit/test_code_review_verifier_class.py\":{\"docs\":[\"<module>\",\"test_the_superseded_equality_rule_has_no_production_consumers\"],\"comments\":[]},\"tests/unit/test_code_review_ws2.py\":{\"docs\":[],\"comments\":[{\"scope\":\"test_secrets_security_keys_are_the_ws5_blocking_handoff\",\"before\":\"blocking = [k for k, v in idx.items()\"}]},\"tests/unit/test_code_review_ws4.py\":{\"docs\":[\"_local_gate_source\",\"test_sidecar_round_trips_a_findings_pass2_verification_block\"],\"comments\":[{\"scope\":\"test_review_code_runs_gate_even_when_config_key_is_off\",\"before\":\"monkeypatch.setattr(gate_dispatch, \\\\\"code_review_enabled\\\\\"\"}]},\"tests/unit/test_collection_isolation_guard.py\":{\"docs\":[\"<module>\",\"test_the_live_unit_tier_collects_clean\"],\"comments\":[]},\"tests/unit/test_commit_tickets_branch_pathspec_11a9.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_compact_all_selection.py\":{\"docs\":[\"<module>\",\"test_a_sweep_that_folds_nothing_still_pushes\"],\"comments\":[]},\"tests/unit/test_compact_crash_atomicity.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_compact_sweep_perf.py\":{\"docs\":[\"<module>\",\"_sign_and_commit\",\"test_the_map_argument_is_optional_for_the_rebuild_path\",\"test_the_sweep_commit_does_not_steal_a_concurrent_writers_event\",\"test_a_failed_map_build_degrades_to_per_ticket_not_per_event\"],\"comments\":[]}}'\"'\"')\nWORD=re.compile(r\"[A-Za-z0-9_]+(?:['\"'\"'’-][A-Za-z0-9_]+)*\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"rtk\",\"proxy\",\"git\",\"show\",ref+\":\"+path],text=True)\ndef docs(tree):\n    out={}\n    def visit(node,owner):\n        if isinstance(node,SCOPES) and node.body:\n            first=node.body[0]\n            if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n                out[owner]=first.value.value\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    return out\ndef scopes(tree,lines):\n    out=[(\"<module>\",1,len(lines))]\n    def visit(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                out.append((name,child.lineno,child.end_lineno or child.lineno)); visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\"); return out\ndef comments(raw,tree):\n    lines=raw.splitlines(); owners=scopes(tree,lines); full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT: continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left: inline.append((tok.string,left.strip()))\n        else: full[row]=tok.string\n    regions=[]; i=1\n    while i<=len(lines):\n        if i not in full: i+=1; continue\n        entries=[]; start=i\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full: entries.append((i,full[i]))\n            i+=1\n        owner=min((s for s in owners if s[1]<=entries[0][0]<=s[2]),key=lambda s:s[2]-s[1])[0]\n        nxt=i\n        while nxt<=len(lines) and lines[nxt-1].lstrip().startswith(\"@\"): nxt+=1\n        before=\"<EOF>\" if nxt>len(lines) else lines[nxt-1].strip()\n        prev=start-1; after=\"<BOF>\"\n        while prev>=1:\n            stripped=lines[prev-1].strip()\n            if stripped and not stripped.startswith(\"#\"): after=stripped; break\n            prev-=1\n        regions.append((owner,before,after,\"\\n\".join(text for _,text in entries)))\n    return regions,inline\ndef select(regions,rule,path):\n    hits=[r for r in regions if r[0]==rule[\"scope\"] and r[1].startswith(rule[\"before\"]) and (\"after\" not in rule or r[2].startswith(rule[\"after\"]))]\n    if len(hits)!=1: raise SystemExit(\"comment selector mismatch: \"+path+\" \"+repr(rule)+\" hits=\"+str(len(hits)))\n    return hits[0]\ndef normalize(raw,path):\n    tree=ast.parse(raw,type_comments=True); wanted=set(ALLOWED[path][\"docs\"]); seen=set()\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore): node.lineno=0\n        if isinstance(node,SCOPES) and owner in wanted and node.body:\n            first=node.body[0]\n            if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n                node.body=node.body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else: visit(child,owner)\n    visit(tree,\"<module>\")\n    if seen!=wanted: raise SystemExit(\"docstring allowlist mismatch: \"+path+\" missing=\"+repr(sorted(wanted-seen)))\n    return ast.dump(tree,include_attributes=False)\nfor path in sys.argv[1:]:\n    base=source(BASE,path); current=source(CURRENT,path); final=source(\"HEAD\",path)\n    bt=ast.parse(base,type_comments=True); ct=ast.parse(current,type_comments=True); ft=ast.parse(final,type_comments=True)\n    bd,cd,fd=docs(bt),docs(ct),docs(ft)\n    br,bi=comments(base,bt); cr,ci=comments(current,ct); fr,fi=comments(final,ft)\n    rules=ALLOWED[path]\n    base_text=[]; current_text=[]; final_text=[]\n    for owner in rules[\"docs\"]:\n        if owner not in bd or owner not in cd or owner not in fd: raise SystemExit(\"selected docstring missing: \"+path+\"#\"+owner)\n        base_text.append(bd[owner]); current_text.append(cd[owner]); final_text.append(fd[owner])\n    for rule in rules[\"comments\"]:\n        base_text.append(select(br,rule,path)[3]); current_text.append(select(cr,rule,path)[3]); final_text.append(select(fr,rule,path)[3])\n    if base_text!=current_text: raise SystemExit(\"frozen prose differs at current code basis: \"+path)\n    for before,after in zip(base_text,final_text):\n        bw=len(WORD.findall(before)); aw=len(WORD.findall(after))\n        if not 0<aw<bw: raise SystemExit(\"selected block is not nonempty and shorter: \"+path+\" \"+str((bw,aw)))\n    if normalize(current,path)!=normalize(final,path): raise SystemExit(\"normalized runtime AST changed: \"+path)\n    def protected(regions):\n        return [r for r in regions if not any(r is select(regions,rule,path) for rule in rules[\"comments\"])]\n    if ci!=fi: raise SystemExit(\"inline comment changed: \"+path)\n    if protected(cr)!=protected(fr): raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)\n' tests/unit/test_code_review_criteria_normalization.py tests/unit/test_code_review_criteria_routing.py tests/unit/test_code_review_discovery.py tests/unit/test_code_review_finalize.py tests/unit/test_code_review_fp_ledger.py tests/unit/test_code_review_gate_session.py tests/unit/test_code_review_per_pass_classes.py tests/unit/test_code_review_provenance_heldout_2d1c.py tests/unit/test_code_review_provenance.py tests/unit/test_code_review_triggers.py tests/unit/test_code_review_verifier_class.py tests/unit/test_code_review_ws2.py tests/unit/test_code_review_ws4.py tests/unit/test_collection_isolation_guard.py tests/unit/test_commit_tickets_branch_pathspec_11a9.py tests/unit/test_compact_all_selection.py tests/unit/test_compact_crash_atomicity.py tests/unit/test_compact_sweep_perf.py","dd_id":"semantic","dd_text":"Frozen/current prose identity, per-block shortening, normalized runtime AST equality, and exact protected-comment preservation."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nCURRENT='\"'\"'6e3c3571dd5b4f82a0faf55ac4b3f3a44401b708'\"'\"'\nPATTERN=re.compile(r\"#\\s*(?:!|-\\*-|coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path): return subprocess.check_output([\"rtk\",\"proxy\",\"git\",\"show\",ref+\":\"+path],text=True)\ndef signatures(raw):\n    lines=raw.splitlines(); found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string): continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left: anchor=(\"inline\",left.strip())\n        else:\n            anchor=(\"next\",\"<EOF>\")\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"): anchor=(\"next\",stripped); break\n        found.append((tok.string,anchor))\n    return found\ndef shebang(raw): return raw.splitlines()[0] if raw.startswith(\"#!\") else None\nfor path in sys.argv[1:]:\n    before=source(CURRENT,path); after=source(\"HEAD\",path)\n    if signatures(before)!=signatures(after): raise SystemExit(\"directive text or attachment changed: \"+path)\n    if shebang(before)!=shebang(after): raise SystemExit(\"shebang changed: \"+path)\n' tests/unit/test_code_review_criteria_normalization.py tests/unit/test_code_review_criteria_routing.py tests/unit/test_code_review_discovery.py tests/unit/test_code_review_finalize.py tests/unit/test_code_review_fp_ledger.py tests/unit/test_code_review_gate_session.py tests/unit/test_code_review_per_pass_classes.py tests/unit/test_code_review_provenance_heldout_2d1c.py tests/unit/test_code_review_provenance.py tests/unit/test_code_review_triggers.py tests/unit/test_code_review_verifier_class.py tests/unit/test_code_review_ws2.py tests/unit/test_code_review_ws4.py tests/unit/test_collection_isolation