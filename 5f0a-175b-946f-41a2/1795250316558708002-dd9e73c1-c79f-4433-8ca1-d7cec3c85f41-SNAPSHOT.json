b19-2ed2-45cb-b081-fb88d385db82"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"cf74dce89ea61972f14da6d94030f43dde0908ce627ee25e80f0a7902cc37016","event_uuid":"9747bab4-e5f3-4248-8327-7cfea427c171","position":{"commit_sha":"2db4c468cd000371a9696400006895f69b0d877f","position":"1795250305409031001-9747bab4-e5f3-4248-8327-7cfea427c171"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"bfcddcca8d7ab277eaaed4ec8ac5efe5783c7b073899d6bc9d54fbba2ee35ca8","event_uuid":"fb02aa7c-7af3-4a9e-a25c-0171ac6c876a","position":{"commit_sha":"2db4c468cd000371a9696400006895f69b0d877f","position":"1795250316558708001-fb02aa7c-7af3-4a9e-a25c-0171ac6c876a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[],"created_at":1795249592832062001,"creation_channel":"cli","deps":[{"link_uuid":"bc597aa4-6004-4a53-82a6-fac1f03e726e","relation":"discovered_from","target_id":"d492-04db-b79e-428f"}],"description":"## Context / Problem\nThe scheduled Windows sweep on main (run 44877036143, job 136763903330, at ebd2a68a451, after 2693d59a047 landed) failed 3 tests, all in `tests/unit/test_check_verify_host.py`; nothing else failed (20381 passed). This blocks charitable-tyrannical-hydra and sporting-feudalist-bluet, which need 3 consecutive green Windows sweeps.\n- `test_unix_socket_probe_passes_when_bind_listen_and_connect_succeed`: `assert [] == ['bind', 'listen', 'connect', 'close', 'close']`\n- `test_unix_socket_probe_reports_a_denied_bind`: `assert not True`\n- `test_unix_socket_probe_passes_where_the_platform_has_no_af_unix`: `AttributeError: AF_UNIX` at `monkeypatch.delattr(mod.socket, \"AF_UNIX\")`\n\n## Root cause (verified from the job log)\nCPython on Windows has no `socket.AF_UNIX`. `unix_socket_probe` returns `(True, \"\")` before touching the socket factory when `AF_UNIX` is absent, which is its intended contract: the tests that need AF_UNIX skip there (`test_reclaim_resign.py` skips on win32, `test_network_guard_local_ipc.py` skips without `AF_UNIX`). The 3 tests assumed the host has `AF_UNIX`: the two fake-socket tests never reached the fake, and `monkeypatch.delattr` raises on a missing attribute. A product defect it is not.\n\n## Approach\nMake the 3 tests set the platform condition they test instead of inheriting it from the host, in `tests/unit/test_check_verify_host.py`:\n- The two fake-socket tests set `socket.AF_UNIX` on the probe module's `socket` with `monkeypatch.setattr(mod.socket, \"AF_UNIX\", 1, raising=False)`, and `_FakeSocket` stops asserting the family value against the host constant.\n- The no-AF_UNIX test uses `monkeypatch.delattr(mod.socket, \"AF_UNIX\", raising=False)`.\nNo skip is added: all 3 tests run on every platform, and the probe is unchanged.\n\n## Scope\n- `tests/unit/test_check_verify_host.py`\n\n## Testing\n- macOS: the module passes.\n- Windows: a `gh workflow run 294845723 --ref <temp branch>` dispatch of the Windows sweep on the change shows the 3 tests passing, recorded here; the temp branch is deleted afterwards.\n\n## Acceptance Criteria\n- [ ] The 3 tests pass on macOS and in a Windows sweep dispatched on the change, with the run recorded here.\n- [ ] No test in the module is skipped on any platform.\n- [ ] `make verify` passes and Gerrit gives Verified +1.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"tests/unit/test_check_verify_host.py","reason":"tests set the AF_UNIX platform condition they test"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"9747bab4-e5f3-4248-8327-7cfea427c171","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"5f0a-175b-946f-41a2","ticket_type":"bug","title":"Windows sweep: verify-host probe tests assume the host has socket.AF_UNIX","verify_commands":[]},"source_event_uuids":["3974a74b-e9d7-42a5-b8e1-01739f514af0","bc597aa4-6004-4a53-82a6-fac1f03e726e","e920e11d-0950-457f-a1fe-031500fda50e","69783b19-2ed2-45cb-b081-fb88d385db82","9747bab4-e5f3-4248-8327-7cfea427c171","fb02aa7c-7af3-4a9e-a25c-0171ac6c876a"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1795250316558708002,"uuid":"dd9e73c1-c79f-4433-8ca1-d7cec3c85f41"}