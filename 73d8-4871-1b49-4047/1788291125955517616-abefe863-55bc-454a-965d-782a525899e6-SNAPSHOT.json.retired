{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788291125955517616,"compiled_state":{"alias":"brainy-convulsant-unicorn","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 73d8-4871-1b49-4047","material: b1f6b03f85c71c48","material-part: children 647ea2107ca5072f 0","material-part: description 2370ee060a357c82 2389","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 072737ecdc673b1f 2","material-part: ticket_id d03bd1c0d2f2196f 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:1c8232b0ee4e943f021cb51b63d16656e7f4df0e","plan-material-pin: prerequisite eb64-844b-ab7a-4915 75fcd7cfe98043ce","dep 269a59d27fd9583dd5716494cad6d5861adf140bc68bc771ee99b6a93e91645f src/rebar/llm/workflow/executor.py","dep absent tests","read-set: 7","read-path: docs/output-schemas.md","read-path: src/rebar/_errors.py","read-path: src/rebar/llm/errors.py","read-path: src/rebar/llm/workflow/executor.py","read-path: src/rebar/llm/workflow/interpreter.py","read-path: tests/interfaces/contracts/test_error_code_taxonomy_contract.py","read-path: tests/unit/api_surface_baseline.json","currency-basis: file_impact"],"material_fingerprint":"b1f6b03f85c71c48","merged_log_commit":"1c8232b0ee4e943f021cb51b63d16656e7f4df0e","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1788288171438180274}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"0f9735135459554cd083cc9a78ce8d58271a3ff94881b9c4b370961f9c77968c","event_uuid":"1bfb18ca-e010-456e-b7cb-1194d3a2ed41","position":{"commit_sha":"ec7176913fd757de96ade9fadb5279e69ee6156c","position":"1788055951435845209-1bfb18ca-e010-456e-b7cb-1194d3a2ed41"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"345828b2cbebdf12be03c18e9e935ab2e3c551c8a857e8dfd46829bf0c4a6d2d","event_uuid":"ed489979-fe50-4c0a-bfd8-2325b6d8d52a","position":{"commit_sha":"ffe3915f8ae6ce36c4af673205ea325c2b9b98a5","position":"1788056685869154721-ed489979-fe50-4c0a-bfd8-2325b6d8d52a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"db04ec802e8723c736fda5e8b72149b07b1eca950255b681e9a2f7a413870a9c","event_uuid":"0c65f6fa-31b0-4137-a282-d49f4773ae3b","position":{"commit_sha":"34db279626cb3fa6831f9a5bef16a4a4727a8d68","position":"1788056972326382181-0c65f6fa-31b0-4137-a282-d49f4773ae3b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"76b901af1613ee2b5a9563ee75f57bf89f462d182ea651f34d3c1713a6d82a45","event_uuid":"8f0ded43-cb2f-41ea-b507-b4e0a116eaa4","position":{"commit_sha":"84bcc35844d17fff019d0810a990d5923d2d4a3f","position":"1788108886242336453-8f0ded43-cb2f-41ea-b507-b4e0a116eaa4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e3727aa5f59fba12e1a95bff29a8f140c111982b32209a115290a44d120174eb","event_uuid":"63e5b74f-f706-48f3-a410-f1af96397eeb","position":{"commit_sha":"1df081c5b1e3ebf987a442f6a4079fce418ed177","position":"1788130407682841284-63e5b74f-f706-48f3-a410-f1af96397eeb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a04b69494e1f0ce95a43fc67fb76ebf94175249801fc69687067125392b1e110","event_uuid":"d1455bb3-a8c0-4b73-95c6-926ce4099825","position":{"commit_sha":"bf96f60e4f9b1b5c80e3922ccf5a921401c52898","position":"1788130407946062039-d1455bb3-a8c0-4b73-95c6-926ce4099825"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2860d8243e64275cf8ac83a9527f645cb9ab801043b18d007a8f4e3dd30fe6f2","event_uuid":"4167dbd7-69b0-4f18-a7d5-e27933b3ce6d","position":{"commit_sha":"6839a14d09c950baf9e58f9b1fe6868d3a5f3040","position":"1788130421713753151-4167dbd7-69b0-4f18-a7d5-e27933b3ce6d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c77194697b485b3bc6dbf82216ebcc6199b5785dab22dc297082da3add1054d1","event_uuid":"3ec40610-866f-4bff-95d7-5886d44da999","position":{"commit_sha":"cd8fb66f5c3d15136b6271272081e8808488ff01","position":"1788226552739990001-3ec40610-866f-4bff-95d7-5886d44da999"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"21f0224c5f217d5576662422c3604d990e38fdc3c9212b147704453d2a1c557b","event_uuid":"3fcd4d08-dad0-4d0a-99bb-6bb4d3b8b408","position":{"commit_sha":"926138f7ad24f3ac47cd59a93d565d97f24f7594","position":"1788286595727220766-3fcd4d08-dad0-4d0a-99bb-6bb4d3b8b408"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ddaefe7a9462d48c02038b12cc9861fe632fcb736cf2215b113659b9819e0313","event_uuid":"0289dfe0-4fe2-42a9-88d5-f577fe8a7795","position":{"commit_sha":"8957d655aa3c86951970ecab20c08d6a44bf60e0","position":"1788287223400169402-0289dfe0-4fe2-42a9-88d5-f577fe8a7795"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"53275980838d8fe939f3d27263f904a221397c49644d8404048afe4097e9974a","event_uuid":"4c68604c-59ef-4d85-bbc4-ede60f48f7e8","position":{"commit_sha":"184b487198e16fdce344246ced8cb0241932f79a","position":"1788288171442777567-4c68604c-59ef-4d85-bbc4-ede60f48f7e8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"12cc3aed6f40db4fa15d9824261bb6802ed769ad1bb2476428f915bf6ca0a0f4","event_uuid":"b0325706-647b-458d-85f3-bcda8d0889c1","position":{"commit_sha":"98c6cb84d9ed4524cca8bb9071d72389f53fc5a0","position":"1788289136834326034-b0325706-647b-458d-85f3-bcda8d0889c1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d725d2da6a23afb7def46ee500b4c1106cef35c004c1bea9859059f9f1fe9e9e","event_uuid":"f2cd01a6-9a7c-4cb2-aa76-1596b008b439","position":{"commit_sha":"98c6cb84d9ed4524cca8bb9071d72389f53fc5a0","position":"1788289136945718235-f2cd01a6-9a7c-4cb2-aa76-1596b008b439"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c54012da1662ddf97a377bfcd718c314ac09ae28f210a1254815da6e9143cffc","event_uuid":"7c4d917d-2302-4198-a8be-3c6c9e477e29","position":{"commit_sha":"4b76de0ea611155c719bcc990ea9f1e855b29d6c","position":"1788289189177344758-7c4d917d-2302-4198-a8be-3c6c9e477e29"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Audit note (epic 3405-c0b7) — refined-bar guidance may resolve this deferred design decision\n\nRe-triaging under the sharpened standard: an error code need not be narrow; prefer an **existing broad-but-accurate** code over new vocabulary, and reserve escalation for when NO existing code fits.\n\nApplying that here: `ExpressionError` (execute-time input/step-output/loop-var/secret/env resolution failures) is not a provider-availability condition, so `llm_unavailable` MIS-fits it. The honest existing-vocab fit is **`command_failed`** (\"an unclassified rebar command failure\") — which accurately describes an execute-time wiring/resolution failure without asserting an outage.\n\nThis also dissolves the dbca-AC3 tension you flagged (\"keep execute-time on llm_unavailable to protect genuine outages\"): the correct discriminator is the exception TYPE, not the phase. Narrow `error_code_for` branch 6 to fire `llm_unavailable` only for `LLMUnavailableError` — then a genuine execute-time provider outage (raised as `LLMUnavailableError`) STILL maps to `llm_unavailable`, while `ExpressionError` (a `WorkflowError`, not an availability fault) falls to `command_failed`. No new vocabulary, no phase special-casing.\n\nSuggest this may be **downgradable from an escalate/design-decision to ready-to-fix** (target code `command_failed`), unless an operator wants a finer `workflow_invalid`/`expression_unresolved` code — which the refined bar says to add only on demonstrated observable need. Not transitioning this ticket myself (read-only audit); flagging for the owner. See the observable sibling 7d47 (render_workflow, load-time) and the unifying recommendation on 5f96.","timestamp":1788056972326382181},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Decision (operator, 2026-08-30): Option B approved — add a dedicated `expression_unresolved` code\n\n`ExpressionError` (execute-time workflow expression-resolution failure: unset input, missing\nstep output, loop var out of scope, unresolvable `${{ }}`, missing secret/env) will map to a\nnew **`expression_unresolved`** code, NOT `llm_unavailable` (misleading — asserts an outage)\nand NOT `command_failed` (accurate but too vague to guide an agent's retry-vs-fix decision on\nthe `run_workflow` surface).\n\n**Rationale / precedent.** gRPC canonical status codes reserve `UNAVAILABLE` for transient\noutages and give caller/state faults specific codes, explicitly warning against dumping a\nclassifiable fault into the generic `UNKNOWN`/`INTERNAL` bucket (= our `command_failed`).\nHTTP's 4xx-vs-5xx split says the same. `invalid_input` was rejected: `ExpressionError` also\nfires for environment faults (missing secret, empty upstream output), so \"invalid input\" would\nbe a *different* misleading code.\n\n**Implementation shape (low blast radius):**\n- Set `error_code = \"expression_unresolved\"` as an attribute on `ExpressionError` (or\n  `WorkflowError` if the whole family fits) so `error_code_for` branch 5 (explicit\n  `error_code`) fires BEFORE branch 6 (`LLMError → llm_unavailable`). Only `ExpressionError`\n  changes; other `LLMError`s untouched.\n- Add `expression_unresolved` to `KNOWN_ERROR_CODES` (`src/rebar/_errors.py`) + the guardrail\n  contract test `tests/interfaces/contracts/test_error_code_taxonomy_contract.py`.\n- Tests through the REAL `run_workflow`/execute surface (per AC): a genuine execute-time LLM\n  outage still returns `llm_unavailable`; an `ExpressionError` returns `expression_unresolved`.\n\n**Separate follow-up (not this ticket):** narrow `error_code_for` branch 6 to fire\n`llm_unavailable` only for `LLMUnavailableError` (reserve it for true outages) — a broader\ncleanup with its own blast radius (sweep all `LLMError` subclasses). File discovered_from this\nticket when implemented.\n\nOrigin unchanged: 8a31 (blanket LLMError→llm_unavailable). Ready to move from\nescalate/design-decision to ready-to-fix.","timestamp":1788108886242336453},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Disposition correction (orchestrator, 2026-08-30): NOT superseded — ready-to-fix, deferred behind eb64\n\nA prior orchestrator note tentatively framed this ticket as \"resolved/superseded by ce6b\" (branch-6 narrowing → `command_failed`). **That framing was wrong and is retracted.** Re-reading this ticket's own record:\n\n- The **operator already decided this ticket (2026-08-30, comment above)**: `ExpressionError` maps to a **new dedicated `expression_unresolved` code**, explicitly rejecting BOTH `llm_unavailable` (false outage) AND `command_failed` (too vague to guide retry-vs-fix on `run_workflow`), citing gRPC/HTTP status-code precedent. So `command_failed` is the very outcome the operator ruled out — ce6b does not resolve this ticket.\n- ce6b (`bleareyed-claimable-quelea`) is the **separate follow-up this ticket's own decision calls for** (\"narrow branch 6 to `LLMUnavailableError` … File discovered_from this ticket\"), and is linked `discovered_from` 73d8. The two **compose, not conflict**: 73d8 sets an explicit `error_code = \"expression_unresolved\"` on `ExpressionError` so `error_code_for` **branch 5** fires before branch 6; ce6b then narrows **branch 6** for every *other* non-outage `LLMError`. Neither supersedes the other.\n\n**Status: ready-to-fix (decision made), no remaining design question.** Blast radius is small: set the `error_code` attribute on `ExpressionError` (`src/rebar/llm/workflow/executor.py:251`), add `expression_unresolved` to `KNOWN_ERROR_CODES` (`src/rebar/_errors.py`) + the taxonomy contract test, and add held-out tests through the real `run_workflow` surface (outage still `llm_unavailable`; `ExpressionError` → `expression_unresolved`). Origin `8a31` to be recorded `caused_by` at close.\n\n**Deferred behind epic eb64 (`financial-stoneware-brant`):** the fix site `src/rebar/llm/workflow/executor.py` is inside eb64's declared `src/rebar/llm/` scope (runner lifecycle / LLM config convergence). Launching a parallel agent now would edit files the epic is actively converging. Tagging `eb64-coord` and adding `depends_on eb64` so `ready`/`next-batch` hold it until the epic lands, then fix it (with ce6b) against the converged surface.","timestamp":1788130407946062039},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## DECISION NEEDED — what code should an execute-time `ExpressionError` map to? (currently `llm_unavailable`)\n\n**The fault.** `ExpressionError` (`executor.py:251`) fires at EXECUTE time for wiring/state faults: an input not set, no such step output, a loop/map var out of scope, a missing secret/env, an unresolvable `${{ }}`. `error_code_for` already distinguishes families (`src/rebar/_errors.py`): branch 6 remaps workflow parse/lint/unknown-step faults to `invalid_input` (bug dbca), and the bare `WorkflowError` base is *deliberately* kept on `llm_unavailable` so a real LLM outage inside an execute step still reads as an outage (dbca AC3). `ExpressionError` is a `WorkflowError` subclass that falls through to that base — so it inherits `llm_unavailable` even though it is a caller/state wiring bug, not an outage.\n\n**Prior art.** Bug `35ab` already moved the executor's unknown-step (a plan-authoring fault) to `invalid_input`; this is the sibling case one phase later.\n\n**OSS grounding.** gRPC and HTTP deliberately separate \"you sent something wrong / precondition unmet\" (`INVALID_ARGUMENT`/`FAILED_PRECONDITION`, HTTP 4xx — do NOT retry) from \"service is down\" (`UNAVAILABLE`, HTTP 503 — retry later). Mapping a wiring bug to \"unavailable\" tells callers/alerting to retry a fault that will never self-heal and pollutes outage signals.\n\n**Recommendation:** Reclassify `ExpressionError` → `invalid_input` (caller-input class), matching `35ab`, by giving it an explicit `error_code='invalid_input'` so it is honest regardless of branch order. This is coupled with **ce6b** (which narrows the `llm_unavailable` branch generally) — approve the two together so they don't collide.","timestamp":1788226552739990001}],"created_at":1788045342307125671,"creation_channel":"mcp","deps":[{"link_uuid":"77bce49b-396c-4bb9-a691-256a67ff101f","relation":"discovered_from","target_id":"35ab-f0e0-3e4a-4b72"},{"link_uuid":"1bfb18ca-e010-456e-b7cb-1194d3a2ed41","relation":"relates_to","target_id":"3405-c0b7-0436-4b46"},{"link_uuid":"ed489979-fe50-4c0a-bfd8-2325b6d8d52a","relation":"relates_to","target_id":"7d47-2131-42bd-4832"},{"link_uuid":"4167dbd7-69b0-4f18-a7d5-e27933b3ce6d","relation":"depends_on","target_id":"eb64-844b-ab7a-4915"},{"link_uuid":"7c4d917d-2302-4198-a8be-3c6c9e477e29","relation":"relates_to","target_id":"59a7-cb88-f2f9-4148"}],"description":"Discovered during the Step 7 sibling sweep of 35ab-f0e0-3e4a-4b72 (fightable-nirvanic-kitten).\n\n## Site\n`ExpressionError(WorkflowError)` is defined at `src/rebar/llm/workflow/executor.py:251` and raised from workflow execute-time expression resolution (`interpreter.py` and `executor.py`) for wiring/state faults: input not set, no such step output, loop/map var out of scope, missing secret/env, or unresolvable `${{ }}` expression.\n\n## Symptom\n`error_code_for(ExpressionError(...))` currently reaches the broad `LLMError`/`WorkflowError` branch and returns `llm_unavailable`. That asserts a provider outage for a caller/state wiring fault and encourages retries that will not self-heal.\n\n## Operator decision\nLatest DECISION NEEDED comment (operator-approved 2026-09-01) supersedes the earlier `expression_unresolved` option for this ticket: reclassify `ExpressionError -> invalid_input`, matching prior bug 35ab (executor unknown-step -> invalid_input) and dbca (parse/lint -> invalid_input). Give `ExpressionError` an explicit `error_code = \"invalid_input\"` so the mapping is honest regardless of branch order. Preserve dbca AC3 by ensuring genuine execute-time LLM outages still map to `llm_unavailable` through the true outage type/wrapper path. Implement this with ce6b's umbrella narrowing as one coherent change.\n\n## Acceptance Criteria\n- [ ] `ExpressionError` has an explicit `error_code = \"invalid_input\"` and `error_code_for(ExpressionError(...))` returns `invalid_input`, verified by a focused unit/contract test.\n- [ ] A real workflow execute-surface expression-resolution failure returns `invalid_input`, not `llm_unavailable`, verified through the real workflow execution surface or the smallest existing production error conversion seam that exercises the same exception.\n- [ ] A genuine LLM outage inside an execute step still returns `llm_unavailable`, verified by a focused test covering the preserved dbca AC3 path.\n- [ ] The implementation lands in the same Gerrit change as ce6b and references both tickets.\n\n## Testing\nRun the focused workflow/error taxonomy tests added or updated for this ticket with `env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q`, then run `env PATH=\"$PWD/.venv/bin:$PATH\" make lint` and `env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck`. After commit, run `env PATH=\"$PWD/.venv/bin:$PATH\" rebar verify-commit-ticket HEAD` to verify ticket trailers.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/workflow/executor.py","reason":"add explicit ExpressionError invalid_input classification"},{"path":"tests","reason":"focused workflow expression error taxonomy tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["depends_on","eb64-844b-ab7a-4915"],["relates_to","3405-c0b7-0436-4b46"],["relates_to","59a7-cb88-f2f9-4148"],["relates_to","7d47-2131-42bd-4832"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"b0325706-647b-458d-85f3-bcda8d0889c1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":["eb64-coord"],"ticket_id":"73d8-4871-1b49-4047","ticket_type":"bug","title":"ExpressionError (execute-time workflow wiring) also classifies as llm_unavailable — decide correct code","verify_commands":[]},"source_event_uuids":["1bfb18ca-e010-456e-b7cb-1194d3a2ed41","ed489979-fe50-4c0a-bfd8-2325b6d8d52a","0c65f6fa-31b0-4137-a282-d49f4773ae3b","8f0ded43-cb2f-41ea-b507-b4e0a116eaa4","63e5b74f-f706-48f3-a410-f1af96397eeb","d1455bb3-a8c0-4b73-95c6-926ce4099825","4167dbd7-69b0-4f18-a7d5-e27933b3ce6d","3ec40610-866f-4bff-95d7-5886d44da999","3fcd4d08-dad0-4d0a-99bb-6bb4d3b8b408","0289dfe0-4fe2-42a9-88d5-f577fe8a7795","4c68604c-59ef-4d85-bbc4-ede60f48f7e8","b0325706-647b-458d-85f3-bcda8d0889c1","f2cd01a6-9a7c-4cb2-aa76-1596b008b439","7c4d917d-2302-4198-a8be-3c6c9e477e29"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1788291125955517616,"uuid":"abefe863-55bc-454a-965d-782a525899e6"}