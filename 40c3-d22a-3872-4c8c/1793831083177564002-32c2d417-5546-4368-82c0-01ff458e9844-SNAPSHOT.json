8b7e693fd15b9e321d2577d2082a56e87d","position":"1793830574800658001-86c833a2-5a9e-43d1-bd00-637d89b3ff60"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"74e26f9accbe109ea0d4457b73f364d6cbae13a80f25f80b2b139ddaaa64e8a8","event_uuid":"53622147-699d-4a55-8ac4-e60583c7f380","position":{"commit_sha":"da51f9e1fa87263d003127df334fdccb590db2e7","position":"1793831080077340001-53622147-699d-4a55-8ac4-e60583c7f380"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"4f3498be06c7d5a5d7d142d6181244cf8efb7ab4a21873b5cbf50797bebb881e","event_uuid":"045f00bb-ab88-44e1-acbe-21125f67178d","position":{"commit_sha":"bfacfe95ee36299bd6e6df3dd0069db5ea81456f","position":"1793831083177564001-045f00bb-ab88-44e1-acbe-21125f67178d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: fix pushed as Gerrit 3323 (patch set 1, `230645c455f`, on `7c3cb5e9a4f`).\n\n**Root cause.** `ensure_fresh` read the 60 s throttle marker only after `repo_root_or_none()` (which runs `git rev-parse --show-toplevel` when `REBAR_ROOT` is unset) and `git rev-parse --verify <branch>`. Every exit between those calls and the age check is a side-effect-free return, so the fix reads the marker first and leaves the rest of the order unchanged. A new helper, `_sync_marker_age`, keeps `ensure_fresh` at complexity 10.\n\n**Per-caller git spawns with a throttled marker** (throwaway two-repo store; every git `Popen` attributed to its calling frame):\n\n| request | caller | before (`REBAR_ROOT` set / unset) | after |\n|---|---|---|---|\n| `show_ticket` | `reads.py:ensure_fresh` `rev-parse --verify` | 2 / 2 | 0 / 0 |\n| `show_ticket` | `_config_resolvers.py:repo_root_or_none` (inside `ensure_fresh`) | 0 / 2 | 0 / 0 |\n| `show_ticket` | `_config_sources.py:repo_root` (tracker/config lookup) | 0 / 5 | 0 / 5 |\n| `list_tickets` | `ensure_fresh` total | 1 / 2 | 0 / 0 |\n| `list_tickets` | `_config_sources.py:repo_root` | 0 / 2 | 0 / 2 |\n| audit `GET /`, 1 ticket | `ensure_fresh` total | 5 / 10 | 0 / 0 |\n\nThe remaining `repo_root` discovery is out of scope and filed as carbonous-bipartisan-ammonite.\n\n**Tests.**\n- `tests/unit/test_read_freshness_git_spawns.py` is new. On `b7c6ed6c834` it had 4 failures and 3 passes; with the fix all 7 pass.\n- Targeted read, freshness, audit and store modules: 746 passed, 9 skipped, and 1 load-dependent failure. That failure was then reproduced on base and filed as weakwilled-catchable-cattle.\n- `make lint` and `make typecheck` exit 0.\n- Default tier of `make verify`: 20,785 passed, 3 failed. All 3 are preexisting and tracked:\n  - 2 facade tests fail on unmodified `origin/main` too, under bald-diagnostic-cricket and fibre-beamy-angora.\n  - The fetch-race positive control passes in isolation on both arms; it is tracked as numbing-hasty-shark.\n- Integration tier (`integration and not live`): 202 passed, 2 skipped.","timestamp":1793827910545250001}],"completion_expectation":"required","created_at":1793804211554605001,"creation_channel":"cli","deps":[{"link_uuid":"557d8936-fd17-4fc5-bd64-a23671e4a890","relation":"discovered_from","target_id":"b0f0-3dd2-fcf2-4707"},{"link_uuid":"acb0ddd8-8a8b-4622-b883-ee36ad7e0ba8","relation":"relates_to","target_id":"8943-29c1-f54c-4f53"}],"description":"## Context / Problem\n`ensure_fresh` (`src/rebar/_engine_support/reads.py:193`) is the shared read-freshness policy behind every library, CLI and MCP read. It spawns git before it checks the 60 s `/tmp/.ticket-sync-*` marker throttle (`reads.py:229-239`), so a throttled read still pays per-read git spawns:\n\n- `git rev-parse --verify <branch>` (`reads.py:221-228`) on every call.\n- `git rev-parse --show-toplevel`, via `repo_root_or_none()` (`reads.py:208`, `src/rebar/_config_resolvers.py:225-247`), whenever `REBAR_ROOT` is unset.\n\nMeasured on current main (`b7c6ed6c834`), with the marker fresh and each git spawn recorded with its calling frame:\n\n| request | `ensure_fresh` spawns, `REBAR_ROOT` set | `ensure_fresh` spawns, `REBAR_ROOT` unset |\n|---|---|---|\n| `rebar.show_ticket` | 2 | 4 |\n| `rebar.list_tickets` | 1 | 2 |\n| `rebar audit serve` `GET /`, 1 audited ticket | 5 | 10 |\n\nThe audit index (`src/rebar/audit/server.py` `_audited_tickets`) reaches `ensure_fresh` from `list_tickets` once, plus 4 times per ticket from `audit_trail`: 2 `show_ticket`, 1 `verify_signature` (`src/rebar/signing.py:238`) and 1 `list`. Every one of those spawns is a throttled no-op.\n\nDiscovered while root-causing smalltime-repressive-sealion (b0f0-3dd2-fcf2-4707).\n\n## Approach\nMove the throttle check to the top of `ensure_fresh`, directly after the existing `_LOCAL_READ_CONTEXT` / `no_sync` exits:\n\n1. Compute `tracker_abs = os.path.realpath(tracker)` and read the marker age. The marker path depends only on `tracker_abs`, and computing it spawns nothing.\n2. If the marker is younger than 60 s and `force` is false, return.\n3. Otherwise run the existing steps unchanged and in the same order: config-root resolution, the `sync.pull = off` check, the tracker `isdir` check, the branch-existence `rev-parse --verify`, the marker write, then `reconverge`.\n\nThis preserves behaviour exactly. Every step currently between the opt-outs and the age check either returns with no side effect (sync off, no tracker dir, missing branch, swallowed exception) or falls through to the throttle's own no-op return. When the marker is fresh, every path therefore ends in a side-effect-free return, so testing the age first changes only the spawn count.\n\nAn unthrottled read, or `force=True`, still resolves config, checks the branch before writing the marker, and fetches. `force` still skips only the age check. The marker read stays inside the existing best-effort `try`, so a failure still never breaks a read.\n\nTo keep `ensure_fresh` under its McCabe ceiling, the marker-age read moves into a small private helper in `reads.py`, which returns the marker path and its age. `ensure_fresh` scores 10 today and is not in `.github/complexity-baseline.json`.\n\nOut of scope: with `REBAR_ROOT` unset, `config.tracker_dir` / `load_config` discover the repo root through `src/rebar/_config_sources.py:53` (`repo_root`), costing 5 `rev-parse --show-toplevel` per `show_ticket`. That spawn locates the tracker for the read itself and is not part of the freshness throttle. It is filed separately as a `discovered_from` bug.\n\n## Scope\n- `src/rebar/_engine_support/reads.py`: reorder `ensure_fresh` and extract the marker-age helper.\n- `tests/unit/test_read_freshness_git_spawns.py` (new): git-spawn-count tests.\n\n## Testing\nNew unit tests build a real two-repo store, with a tracker that has an `origin` remote and a `tickets` branch. Each git process is started through `subprocess_env` from `tests/_subprocess_env.py`. Spawns are counted by wrapping `subprocess.Popen` for the duration of each test only, with no autouse fixture.\n\n- Throttled (marker age 0): `ensure_fresh(tracker)` spawns 0 git processes, with `REBAR_ROOT` both set and unset. This fails on main, which spawns 1 and 2.\n- Throttled through the library: `rebar.show_ticket` and `rebar.list_tickets` with `REBAR_ROOT` set spawn 0 git processes from `reads.py:ensure_fresh`.\n- Unthrottled (marker removed): `ensure_fresh` runs `rev-parse --verify <branch>` before the first `fetch`, writes the marker, and adopts the remote commit.\n- `force=True` with a fresh marker still fetches.\n- Missing tickets branch with no marker: no fetch, and no marker is written.\n\nThe existing modules `tests/unit/test_read_freshness_parity.py`, `tests/unit/test_compact_fold_prelock.py`, `tests/interfaces/store/` and `tests/unit/` audit tests must still pass.\n\n## Acceptance Criteria\n- [x] A throttled `ensure_fresh` call (marker younger than 60 s, `force` false) spawns 0 git processes, with `REBAR_ROOT` set and unset. Verified by a git-spawn-count test in `tests/unit/test_read_freshness_git_spawns.py` that fails on `b7c6ed6c834`.\n- [x] The branch-existence `rev-parse --verify` still runs before any fetch on an unthrottled read, and a missing branch still means no fetch and no marker write. Verified by the same test module.\n- [x] `force=True` still fetches inside the throttle window. Verified by a test, and by `tests/unit/test_read_freshness_parity.py` passing.\n- [x] [non-codebase] A throttled `rebar audit serve` `GET /` with 1 audited ticket spawns 0 git processes from `ensure_fresh`, down from 5 with `REBAR_ROOT` set and 10 with it unset, as recorded in the before/after profile ticket comment.\n  provenance: environment=local macOS dev host, throwaway two-repo store (code repo plus .tickets-tracker with an origin remote) under the session scratch dir, before at b7c6ed6c834 and after at 230645c455f; principal=local operator account running the worktree .venv; privilege_posture=narrower; instrument=simulation — a scripted FastAPI TestClient request against the real audit app with a fresh throttle marker, every git Popen attributed to its calling frame; no production store, network or credentials involved.\n- [x] `make lint` and `make typecheck` exit 0, every `src/rebar` file stays at or under 800 lines, and `python scripts/check_complexity_baseline.py --check` exits 0.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_engine_support/reads.py","reason":"check the throttle marker before any git spawn in ensure_fresh"},{"path":"tests/unit/test_read_freshness_git_spawns.py","reason":"new git-spawn-count tests for throttled and unthrottled reads"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","8943-29c1-f54c-4f53"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"53622147-699d-4a55-8ac4-e60583c7f380","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"40c3-d22a-3872-4c8c","ticket_type":"bug","title":"Throttled reads still spawn a git rev-parse each","verify_commands":[]},"source_event_uuids":["252fd381-f3ee-488c-a07a-67a393b3a7a6","ccd7c8ff-6035-4678-8e09-886c937393da","0c2da811-9b02-4fce-8b2e-848dead3ce0f","90125509-558b-455e-81a6-7a6d46e8c2c3","6efdb780-7193-491f-abc2-8530d1cd069a","acb0ddd8-8a8b-4622-b883-ee36ad7e0ba8","015c162f-5c83-4eab-b976-cffc47c3c323","1902b6d3-cbc2-47ff-b7ab-666865c746fb","86c833a2-5a9e-43d1-bd00-637d89b3ff60","53622147-699d-4a55-8ac4-e60583c7f380","045f00bb-ab88-44e1-acbe-21125f67178d"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1793831083177564002,"uuid":"32c2d417-5546-4368-82c0-01ff458e9844"}