\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0e070b05e54c7b10b64ec43d5054b802217cf1f5fd4d5bcc5fad01cabbcfe411","event_uuid":"2be443fe-4223-4b15-aec3-493cfaa6bce4","position":{"commit_sha":"6c1819abc59fb462c0ac749b54772d25537fec91","position":"1788838826817326001-2be443fe-4223-4b15-aec3-493cfaa6bce4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c0d369f6e3a8ea4319994f80f35480055b0caae9c884bcd802145b6f5815e0b1","event_uuid":"f126111b-d20a-4c26-8734-d81f20d850a1","position":{"commit_sha":"beffc45aafd43fa566cd48c103a2f7533619c794","position":"1788839549351450001-f126111b-d20a-4c26-8734-d81f20d850a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1f365ece96debe059839f35739f51442dae574e7a408ea5e98f577ceed455739","event_uuid":"878ef7c9-a945-4ab1-a962-bb1231988c34","position":{"commit_sha":"bfebfad04796445c84a35698c04d4d32a0478777","position":"1788839577928979001-878ef7c9-a945-4ab1-a962-bb1231988c34"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9f6452f626a3209cbefaf9984d9b8c8116486b30f44794fba1ff9ca83776681e","event_uuid":"9c45bef8-c4b9-42e0-ba11-7e939b966561","position":{"commit_sha":"bfebfad04796445c84a35698c04d4d32a0478777","position":"1788839582743832001-9c45bef8-c4b9-42e0-ba11-7e939b966561"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"53997a07423593c41adb54efea49157834c3e2e57767dc2844b5f7feb290318a","event_uuid":"f3da720e-fa3d-4f8b-a109-c4347c2f8ed1","position":{"commit_sha":"81e7e663618205449bc97a477a4f5331aa5de01d","position":"1788840671374191001-f3da720e-fa3d-4f8b-a109-c4347c2f8ed1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: withheld-oracle TDD is now GREEN in worktree /Users/joeoakhart/alm-85a5. RED coverage added for (1) no-op tick restarting a dead nginx-pinned MCP backend in place, (2) failed restart preserving identity/upstream and recording MCP backoff/deploy_failed, and (3) MCP_SELF_HEAL=0 kill switch restoring old log-only behavior. Implementation adds an in-place live-backend watchdog before no-op/source-change decisions, docker inspect port fallback for exited containers, health-contract wait, and existing deploy_failed/backoff reuse on failure. Focused validation: bash -n infra/scripts/autodeploy.sh and pytest -q tests/scripts/test_autodeploy_mcp_bluegreen.py both pass (58 tests). Next: lint/ratchets and full verify before commit/push.","timestamp":1788840671374191001}],"created_at":1788753773815803001,"creation_channel":"cli","deps":[{"link_uuid":"79b431f2-e058-4e7e-b4ec-ba3848660744","relation":"supersedes","target_id":"9ea3-7d07-ea55-4496"},{"link_uuid":"cbe3e2fe-ab92-4364-a329-188055694a26","relation":"discovered_from","target_id":"9ea3-7d07-ea55-4496"}],"description":"## Problem\n\n`/mcp` can return persistent HTTP 502 after concurrent gate load if nginx's single-server upstream points at a dead MCP container. Parent `witted-invisible-roan` made autodeploy retain a crashed live backend instead of deleting it, but recovery can still wait for Docker/humans.\n\n## RCA / design decision\n\nRelated load-side ticket `enduring-ironclad-arrowana` already removed the biggest measured retained-memory multiplier: retained plan-review snapshot state fell from 256,646,460 bytes to 37,046 bytes on a 9,081-ticket store. This ticket fixes the serving-path residue.\n\nSelected prevention: an autodeploy in-place watchdog for the live MCP backend. On each serialized autodeploy tick (the existing flock owns check/start/readiness/backoff), `MCP_SELF_HEAL` defaults to `1` inside `autodeploy.sh` so the fix is active after merge; setting it to `0` is the kill switch. The watchdog uses the existing `MCP_HEALTH_TIMEOUT` readiness deadline. If `MCP_SELF_HEAL=1` and the nginx upstream port maps to a managed MCP container that is not running, autodeploy runs `docker start <live-container>` and readiness-checks that same port. A healthy running backend is a strict no-op. The port-to-container lookup must work for exited containers using inspect data, not `docker port` alone. Success leaves nginx byte-identical, clears MCP backoff, and logs recovery; failure leaves the container/upstream identity intact, emits existing `AUTODEPLOY_ERROR mcp-live-backend-down`, records MCP backoff, and remains a retryable transient path; repeated backoff cycles are the operator escalation signal for a fatal start/config problem. `MCP_SELF_HEAL=0` disables the new branch and restores log-and-wait behavior.\n\nRejected alternatives: blue/green self-heal doubles MCP memory under pressure; nginx passive failover needs an already-live spare; Docker `--restart always` is already present but is passive and not readiness/log evidenced; healthcheck watchdog/autoheal prior art supports this design and is implemented here through the existing autodeploy tick instead of a new daemon; instance sizing/off-box gates remain with `inherited-americium-porpoise`.\n\n## Testing / verification plan\n\n- RED test in `tests/scripts/test_autodeploy_mcp_bluegreen.py`: no source change pending, nginx points at an exited managed MCP backend, one tick runs `docker start` for that exact container, upstream remains unchanged, success log appears, and readiness passes.\n- RED test for failure/kill switch: failed start or readiness does not remove the dead live backend, upstream remains unchanged, `AUTODEPLOY_ERROR ... mcp-live-backend-down` appears, MCP backoff is recorded, and `MCP_SELF_HEAL=0` skips restart.\n- Run `env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/test_autodeploy_mcp_bluegreen.py` and full `make verify` before push.\n- Live check after merge: inspect `/mcp/health` and autodeploy logs; no Terraform apply is required because failure visibility reuses existing deploy_errors wiring and success is operator-visible journald evidence.\n\n## Acceptance Criteria\n\n- [ ] The selected design is recorded with why alternatives were accepted/rejected.\n- [ ] A simulated MCP backend death recovers without persistent nginx 502.\n- [ ] The prevention is covered by tests and visible through existing deploy-error alarm wiring plus logs.\n- [ ] Capacity/concurrency measurements cite `enduring-ironclad-arrowana` and the residual campaign `inherited-americium-porpoise`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/scripts/autodeploy.sh","reason":"Add MCP live-backend self-heal path that replaces a dead nginx upstream backend without waiting for a source-changing deploy."},{"path":"tests/scripts/test_autodeploy_mcp_bluegreen.py","reason":"Withheld-oracle tests for dead-live-backend self-heal and low-memory refusal."},{"path":"infra/runbooks/review-bot-ops.md","reason":"If needed, document the operator-visible self-heal marker and recovery semantics."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"878ef7c9-a945-4ab1-a962-bb1231988c34","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"85a5-97ff-4a47-4c77","ticket_type":"bug","title":"Prevent persistent MCP 502 recurrence","verify_commands":[]},"source_event_uuids":["d22b1876-3e53-4841-adc4-11ff03000c31","d2c0aeb5-349a-48e8-87e7-4b37a25b9e35","34d6a802-cada-44fc-892c-efa4980f9156","5fb41ed6-0481-46d7-ad0d-c0108bee9785","f5d0889b-5e75-4a42-ac04-b0ebfb1f8d70","cce1831f-8462-4147-869f-0ef64fb91ae4","52d1416d-23c8-42bc-9fcb-9f6d3273402f","2be443fe-4223-4b15-aec3-493cfaa6bce4","f126111b-d20a-4c26-8734-d81f20d850a1","878ef7c9-a945-4ab1-a962-bb1231988c34","9c45bef8-c4b9-42e0-ba11-7e939b966561","f3da720e-fa3d-4f8b-a109-c4347c2f8ed1"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788848496516730166,"uuid":"f186d8b8-2c7f-4358-9a76-68975fdd72de"}