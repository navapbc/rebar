da1d-4456-ba00-d895a6f067ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5b8b369b85b7267b1171a2ea8917d891d424edd0551a699d2269561361e76618","event_uuid":"bd72c192-33e4-42a5-8319-2ba40ec088ef","position":{"commit_sha":"0799311e911555903ac3329ffe336846f4b5dd14","position":"1788804442390389001-bd72c192-33e4-42a5-8319-2ba40ec088ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5a472f42cbb22a967dc7a6b75cbd48278e22a9b1fb73e9bd503bf58bbbee0391","event_uuid":"950da8b3-1511-4593-8844-a127b9c85286","position":{"commit_sha":"0799311e911555903ac3329ffe336846f4b5dd14","position":"1788804445825860001-950da8b3-1511-4593-8844-a127b9c85286"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ea7741d172adc09ced4852ed8561c97ae58e9b9fd246ed11b1bbc67e963c8ef0","event_uuid":"cc3fdbfe-5d6f-490c-b4b6-668f112638ba","position":{"commit_sha":"8ca3ac93174c9766253ea25deb540cf2baa1d04b","position":"1788804452239575001-cc3fdbfe-5d6f-490c-b4b6-668f112638ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2a40b560b91a3eb90ddf70ae21f9f8512665c1788461af2a0918f2a907fa5021","event_uuid":"a5ecbc66-9ca6-4700-86d9-9b272ff2fa97","position":{"commit_sha":"699df00f08cbd7fdf15fd5c1b101725c5f47e954","position":"1788807353540847624-a5ecbc66-9ca6-4700-86d9-9b272ff2fa97"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator decision 2026-09-06: alarm work APPROVED — mirror existing alarm best practices in this environment; every alarm must provide meaningful health signal, not noise.","timestamp":1788761607696330001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: plan review passed after adding workflow-level run-state surfacing and tests to the plan. Claiming and implementing in fresh worktree alm-1e28.","timestamp":1788804452239575001}],"created_at":1788642726301872001,"creation_channel":"cli","deps":[{"link_uuid":"e806125e-50df-4a6c-9d4f-988bb45fa190","relation":"relates_to","target_id":"5bba-45dd-3bfc-42f1"},{"link_uuid":"a5ecbc66-9ca6-4700-86d9-9b272ff2fa97","relation":"relates_to","target_id":"3c10-1f97-96b2-4dad"}],"description":"## Summary\n\n`Mirror Guard` reports `healthy: false` when it cannot REACH the host to compare SHAs, which is\nindistinguishable at the run level from the mirror having actually diverged. The two conditions\nneed different operator responses — one is \"replication is broken, investigate Gerrit\nreplication\", the other is \"the network was briefly unavailable, ignore\" — and the red run does\nnot tell them apart.\n\n## Observed twice in 30 minutes, 2026-09-05\n\n```\nrun 33990613226  20:36Z   {\"exit_code\":2,\"verdicts\":[{\"check\":\"io\",\"healthy\":false,\n                            \"reason\":\"fetch error: <urlopen error _ssl.c:993:\n                             The handshake operation timed out>\"}]}\nrun 33991235523  20:49Z   identical\n```\n\n**The mirror was in sync throughout.** Verified directly at 21:10Z:\n\n```\ngerrit main:  4c9940348148fb255b17ddf1cb124701ad4565d7\ngithub main:  4c9940348148fb255b17ddf1cb124701ad4565d7   -> IN SYNC\n```\n\nCorroborating context: the same window produced four CloudWatch alarms firing on missing data\n(`gerrit-gate-down`, `mcp-serving-path-down`, `root-disk-pressure`, `gerrit-data-disk-high`) while\nGerrit itself answered HTTPS 200 in 0.27 s, and a `curl` from this host to the Gerrit REST API\nfailed once and succeeded on retry. A transient reachability dip, not an outage and not a\ndivergence. All four alarms have since self-cleared.\n\n## Why this is worth fixing despite failing SAFE\n\nThis is NOT a dangerous defect. The guard fails LOUD and in the conservative direction: it never\nreports a diverged mirror as healthy. That is the right bias and should be kept.\n\nThe cost is investigation time and false escalation. Reading four coherent alarms plus a red Mirror\nGuard, the orchestrator concluded a live host incident was underway and said so, before the\ndatapoints showed every signal was missing-data or IO. A guard that cannot say \"I was unable to\ncheck\" trains readers to treat its red as a divergence, which is exactly the wrong prior.\n\nThe information ALREADY EXISTS in the output — the verdict carries `\"check\": \"io\"` distinctly from\na SHA-comparison verdict. What is missing is that the distinction survives to the run level and to\nwhatever reads it.\n\n## Relationship to a sibling finding\n\nChange 2683 documents the same conflation on the alarm side: when the observability probe truncates\nbefore section 2, `disk_used_percent` is absent for reasons unrelated to the volume, and\n`gerrit-data-disk-high` cannot distinguish \"the disk is full\" from \"the probe never measured it\".\nIts resolution is `probe_ok`/`probe_truncated` in change 2684, which state truncation as FACT\nrather than leaving it inferred from absence. The same remedy shape applies here: report\nreachability as its own signal rather than folding it into the health verdict.\n\n## Acceptance criteria\n\n- [ ] AC1 An IO/reachability failure is DISTINGUISHABLE at the run level from a genuine SHA\n      divergence, without reading the JSON body.\n- [ ] AC2 The conservative bias is preserved: an unreachable host must never be reported as a\n      healthy mirror. Decide and RECORD whether an IO failure should still fail the run (loud) or\n      warn, and justify it — \"fail loud but say why\" is a legitimate answer.\n- [ ] AC3 Repeated IO failures remain visible; a transient must not be silently swallowed, or this\n      trades a false positive for a false negative.\n- [ ] AC4 A test covers both branches: unreachable host, and reachable host with divergent SHAs.\n\n## Constraints\n\nNever use `--force` or any gate bypass. `timeout` does not exist on this macOS host (exit 127) —\nbound with `perl -e 'alarm N; exec @ARGV'`. Terraform may be written and validated but NEVER\napplied. Do not touch the shared main checkout; do not `git stash` anywhere.\n\n## Testing / Verification\n\n- RED/GREEN unit coverage in `tests/unit/test_mirror_guard.py`: one test asserts an unreachable Gerrit/GitHub fetch produces a distinct run-level IO/unreachable state and does not report the mirror as healthy; a second test asserts reachable-but-different SHAs still reports a replication/divergence failure.\n- Run `env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_mirror_guard.py` for targeted proof.\n- Run `env -u GIT_CONFIG_COUNT -u GIT_CONFIG_KEY_0 -u GIT_CONFIG_VALUE_0 -u GIT_CONFIG_KEY_1 -u GIT_CONFIG_VALUE_1 -u GIT_CONFIG_KEY_2 -u GIT_CONFIG_VALUE_2 PATH=\"$PWD/.venv/bin:$PATH\" make verify` before push.\n- Decision for AC2: IO failures stay fail-loud (non-zero) but are classified separately as unreachable/io so operators do not mistake them for SHA divergence.\n\n## Plan-review remediation 2026-09-07\n\nThe run-level consumer is `.github/workflows/mirror-guard.yml`, whose current final step runs\n`python -m rebar.mirror_guard --replication` directly. That makes exit 1 (true divergence) and\nexit 2 (IO/unreachable) both appear as the same red step in Actions. The fix must therefore touch\nthat workflow as well as `src/rebar/mirror_guard.py`/unit tests: wrap the CLI invocation, inspect\nits exit code, and emit a distinct GitHub annotation/summary for exit 2 such as\n`mirror-guard: host unreachable — could NOT verify mirror; not a divergence`, while exit 1 remains\nthe divergence failure. The run still fails loud for exit 2; it is just classified separately at the\noperator-facing run layer.\n\nAdditional verification: add a workflow-shape test that proves `mirror-guard.yml` uses the wrapper\nrather than invoking the module directly, and add unit coverage that two consecutive IO failures each\nreturn the distinct IO exit/outcome (not swallowed as transient). Update file impact to include the\nworkflow.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/mirror_guard.py","reason":"Expose/run distinct IO-unreachable outcome separately from true divergence."},{"path":"tests/unit/test_mirror_guard.py","reason":"Cover unreachable-host, repeated IO, and reachable divergence branches."},{"path":".github/workflows/mirror-guard.yml","reason":"Surface exit 2 as a distinct run-level Actions annotation/summary instead of an undifferentiated red run."},{"path":"tests/unit/test_mirror_guard_workflow.py","reason":"Pin the workflow-level mapping for IO vs divergence outcomes."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","3c10-1f97-96b2-4dad"],["relates_to","5bba-45dd-3bfc-42f1"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"bd72c192-33e4-42a5-8319-2ba40ec088ef","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"1e28-1322-9560-4707","ticket_type":"bug","title":"Mirror Guard reports healthy:false when it cannot reach the host, indistinguishable from real divergence","verify_commands":[]},"source_event_uuids":["e806125e-50df-4a6c-9d4f-988bb45fa190","fc63e431-4d84-4b52-96c3-9d3416410c13","39fcd434-fd2d-4489-b330-4a5ba0a26691","a2000161-d145-487a-aa2e-31b60649a538","4fbd2416-d851-4e28-9f9b-53cafbb214da","04ae6872-200b-481a-98a1-fe0dabc55cbf","d1c1a637-da1d-4456-ba00-d895a6f067ba","bd72c192-33e4-42a5-8319-2ba40ec088ef","950da8b3-1511-4593-8844-a127b9c85286","cc3fdbfe-5d6f-490c-b4b6-668f112638ba","a5ecbc66-9ca6-4700-86d9-9b272ff2fa97"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788807353540847625,"uuid":"4931b449-4dce-4c77-83af-1ed150e44cdf"}