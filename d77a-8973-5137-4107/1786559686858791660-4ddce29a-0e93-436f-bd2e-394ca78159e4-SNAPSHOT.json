 \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5c8db948381983916901b12e4fc73f7a1b355418c2f6b48063f1c979ae10209c","event_uuid":"89a32320-4172-43d6-8da2-8690ce18f966","position":{"commit_sha":"b82a252e5e2e1a187fc9c035652fac4ebf136b26","position":"1786558695590796001-89a32320-4172-43d6-8da2-8690ce18f966"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ce6d673138f8f5d10fd0db0594db9321576023af984f0b175775dca5559015e2","event_uuid":"aa78381e-01b7-4fe4-88e4-fd026c779014","position":{"commit_sha":"0300df64b00e208da389cc58c1f026683a2a7d31","position":"1786559145488384001-aa78381e-01b7-4fe4-88e4-fd026c779014"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"86c6fc81bd3162723ce43f661fc5cf0f0dec04a8ec0985dba541fb4ce2584d79","event_uuid":"2c5c4f07-5d5d-499f-ba85-31b9ef0f918e","position":{"commit_sha":"92500865e17f396baa4893ca81fff13da7abcc8c","position":"1786559686858791659-2c5c4f07-5d5d-499f-ba85-31b9ef0f918e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented as change https://rebar.solutions.navateam.com/c/rebar/+/1662 (commit 308215c677).\n\nPREMISE VERIFIED in origin/main cc69cc1179. `classify_plan_review_attestation` (src/rebar/llm/plan_review/resign.py:485) discriminated three failure cases but its catch-all — reached for any non-material failure, including the lock timeout — never inspected `sidecar_emitted`, despite that field being present on the very result dict it is handed (set unconditionally at src/rebar/llm/plan_review/__init__.py:747, contracted in schemas/plan_review_verdict.schema.json:83). Confirmed real, exactly one missing discriminator.\n\nCHANGE. New `ATTESTATION_SIDECAR_LOST = \"sidecar_lost\"` cause with `recovery_tool=\"review_plan\"`, branching ahead of the catch-all.\n\nDESIGN NOTE — the predicate is `result.get(\"sidecar_emitted\") is False`, NOT falsy. Absence is not evidence: keying on falsiness would have reclassified every result that simply does not carry the field, and in fact flipped the pre-existing facade test at tests/interfaces/facades/test_plan_review_attestation_facades.py:152 from `sign_failed` to `sidecar_lost`. That test is now pinned by test_absent_sidecar_field_is_not_read_as_a_lost_sidecar.\n\nThe message names no recovery that cannot work: an earlier draft said \"\\`rebar sign-review\\` has nothing to re-sign\", which still put the string in front of an agent grepping for it. Removed — the text now names only `review-plan`.\n\nEVIDENCE. 6 new tests in tests/interfaces/facades/test_plan_review_attestation_facades.py (11 pass in that module). Wider related suites green: 634 passed, 1 skipped across tests/unit/test_plan_review_resign*.py, tests/interfaces/facades/, test_bugfix_size_gate_ad0d.py, test_review_bot_retrigger_attestation_6a81.py. make lint and make typecheck (509 files) clean.\n\nAlso updated the MCP review_plan docstring (src/rebar/_mcp_llm.py) so the documented cause vocabulary includes sidecar_lost.","timestamp":1786559145488384001}],"created_at":1786531890854460001,"creation_channel":"cli","deps":[{"link_uuid":"23a55639-6340-44d5-bc62-4d7ca8840364","relation":"discovered_from","target_id":"10c3-5a33-2e25-4584"},{"link_uuid":"2c5c4f07-5d5d-499f-ba85-31b9ef0f918e","relation":"relates_to","target_id":"26c3-d827-3758-4528"}],"description":"## Report\n\nWhen `review-plan` PASSES but the attestation write fails, it prints:\n\n    plan review PASSED but the attestation could not be persisted: flock: could not acquire lock after 60s\n    run `rebar sign-review <id>` to re-sign from the recorded review (no LLM re-run) — the claim gate needs the signature.\n\nThat guidance is sound only when the PASS **sidecar** persisted and only the signature\nfailed. When one contention episode takes BOTH, `sign-review` cannot recover and returns:\n\n    {\"ok\": false, \"signed\": false, \"verdict\": \"BLOCK\",\n     \"reason\": \"the latest review was not a signable PASS (verdict=BLOCK) — run `rebar review-plan` to produce a fresh verdict\"}\n\nObserved twice while earning the attestation for bug royal-weariless-zebrafish; the payload\ncarried `\"sidecar_emitted\": false` both times. Each occurrence cost a full ~14-minute,\n28-LLM-call review. Worse than losing the result: the recorded verdict silently remains the\nPREVIOUS round's BLOCK, so the system retains a **stale contradicting** verdict rather than\nno verdict, and the advertised recovery walks the reader into it.\n\n## Premise verified in current `origin/main` (cc69cc1179)\n\n`src/rebar/llm/plan_review/resign.py`:\n\n* `classify_plan_review_attestation(result)` — line **485** — is the single producer of the\n  post-failure guidance. It already discriminates three cases on the *signature* dict:\n  `plan_review_generation_changed` (line 505, `recovery_tool=\"review_plan\"`),\n  `_is_relation_read_failure` (line 526, `recovery_tool=\"review_plan\"`), and a final\n  catch-all (lines **544-556**, `recovery_tool=\"sign_review\"`).\n* That catch-all is reached for **any** non-material failure — including the lock timeout —\n  and it **never inspects `sidecar_emitted`**, which is present on the very `result` dict it\n  is handed (`src/rebar/llm/plan_review/__init__.py:747` sets\n  `verdict[\"sidecar_emitted\"]`; the field is contracted in\n  `src/rebar/schemas/plan_review_verdict.schema.json:83`).\n\nSo the bug is exactly one missing discriminator on an existing, well-shaped decision\nfunction. `sign-review`'s own refusal is correct and is not changed here.\n\n## Direction\n\nAdd a fourth branch to `classify_plan_review_attestation`, ahead of the catch-all, taken when\nthe failure is a sign failure AND `result.get(\"sidecar_emitted\")` is falsy: a new\n`ATTESTATION_SIDECAR_LOST` cause with `recovery_tool=\"review_plan\"`, whose message\n\n1. does **not** name `sign-review`,\n2. states that no PASS record persisted, so a fresh `rebar review-plan <id>` is required, and\n3. warns that the recorded verdict is still the PREVIOUS round's and must not be read as\n   current.\n\nThe existing `sidecar_emitted=True` path keeps the cheap no-LLM `sign-review` recovery\nunchanged. `ATTESTATION_SIDECAR_LOST` joins the sibling constants at lines 412-425 and is\ncovered by the same `as_dict()` machine-branchable payload (line 457), so agents branch on\n`cause`/`recovery_tool` without parsing English.\n\nScope note: this is a **classification + message** change only. No LLM behaviour, no sidecar\nwrite path, no `sign-review` semantics, and no CLI exit code changes.\n\n## Acceptance criteria\n\n- [ ] A failed-sign result with `sidecar_emitted=False` classifies as\n      `cause=ATTESTATION_SIDECAR_LOST` with `recovery_tool=\"review_plan\"`, and its message\n      contains no `sign-review` string — verified by a unit test on\n      `classify_plan_review_attestation`\n- [ ] A failed-sign result with `sidecar_emitted=True` still classifies as\n      `cause=ATTESTATION_SIGN_FAILED` with `recovery_tool=\"sign_review\"` and still emits the\n      no-LLM re-sign guidance — verified by a unit test\n- [ ] The sidecar-lost message states that the recorded verdict is the previous round's and\n      is not current — verified by a test asserting that text\n- [ ] The `plan_review_generation_changed` and relation-read-failure branches are unchanged\n      when `sidecar_emitted=False` (the new branch does not shadow them) — verified by a test","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/plan_review/resign.py","reason":"add ATTESTATION_SIDECAR_LOST branch to classify_plan_review_attestation"},{"path":"tests/interfaces/facades/test_plan_review_attestation_facades.py","reason":"tests for the new sidecar-lost branch and the unchanged sign_review branch"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","26c3-d827-3758-4528"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"65af3159-aad6-43ee-8ba5-6f48666d4068","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"d77a-8973-5137-4107","ticket_type":"bug","title":"sign-review advertises a recovery path that cannot work when the PASS sidecar was also lost","verify_commands":[]},"source_event_uuids":["2fbe3ff2-6c2e-4d08-9132-f418c7bde05a","23a55639-6340-44d5-bc62-4d7ca8840364","979e39a2-bd95-420d-82aa-5eb54a1cd065","6e79db0e-5807-43ee-b388-feee44e3aef7","c289ef5d-20fb-42db-bd6e-7cb313320f0e","d043d0ab-6759-4cb8-9d49-c7e85771343b","65af3159-aad6-43ee-8ba5-6f48666d4068","89a32320-4172-43d6-8da2-8690ce18f966","aa78381e-01b7-4fe4-88e4-fd026c779014","2c5c4f07-5d5d-499f-ba85-31b9ef0f918e"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786559686858791660,"uuid":"4ddce29a-0e93-436f-bd2e-394ca78159e4"}