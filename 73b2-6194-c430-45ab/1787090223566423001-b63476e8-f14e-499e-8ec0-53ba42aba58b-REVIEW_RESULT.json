ce_close_reason=...)","tests/interfaces/lifecycle/test_completion_gate.py:264-267 and multiple lifecycle tests call rebar.transition(..., force_close=...) — the lib alias covers these, but the internal transition_compute/close_ticket/close_precheck param renames are NOT alias-covered","Plan Testing lists only NEW tests; it does not enumerate the existing keyword-arg consumers that a param rename will break."],"finding":"The internal rename of force_close / force_close_reason params to force_reason on transition_compute, close_ticket, close_precheck._completion_precheck, and txn.close_class_refusal breaks numerous existing test call sites that pass these as keyword arguments; these consumers are not enumerated, and the deprecation alias only covers the public rebar.transition kwarg, not the internal params.","group_criteria":null,"group_id":null,"id":"f8bdffe00fb3ce9ae","impact":0.85,"is_primary":null,"location":"Scope: 'Internal naming: unify the IN-MEMORY spelling … to force_reason' vs. Testing section","norm_id":"ne24a85014bfe8fc7","priority":0.6375,"reason":"default-advisory","recalled":false,"scenarios":["make test fails on TypeError: unexpected keyword argument 'force_close' / 'force_close_reason' at the many internal call sites once the params are renamed."],"severity":"critical","suggested_fix":"","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_impleme