":6549,"output_tokens":281,"requests":1}},{"kind":"success","lineage":{"dependencies":[],"digest":"df265d70857057d0cd64c9dcdda2a92e75cfa1bfa3bc08cbc34edcaec309e100"},"namespace_version":1,"reason":null,"unit_id":"agent:G7","usage":{"input_tokens":17289,"output_tokens":601,"requests":3}},{"kind":"success","lineage":{"dependencies":[],"digest":"dfde2155ec87b0ba47c56019d82bebc46caa4e03fe23e94cc87bdfb1567c9c0d"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":11968,"output_tokens":568,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"71d9e7d050389192b94a1b74dbc3c65e574fa90667da411eea2caf0bdf433ef7"},"namespace_version":1,"reason":null,"unit_id":"agent:G6","usage":{"input_tokens":13097,"output_tokens":2233,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"4e0dafa6976c497c5dba93e50c484ab87aea2f093e1a4cadc67f5484cd0f7ca8"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":22525,"output_tokens":1715,"requests":3}}],"version":1},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"Align the guide's LLM-review trigger wording with the actual escalation predicate (file_impact declaring a non-test path) rather than 'has an implementation plan', so the doc and gates/orchestrator behavior agree.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.0975,"drop_reason":null,"evidence":["docs/plan-review-gate.md:1583-1584: 'A bug whose persisted file_impact declares any non-test path leaves the tier and is reviewed by the FULL, blocking-capable rubric'","docs/plan-review-gate.md:1587-1588: predicate is orchestrator.bug_blast_radius_escalates(file_impact); a path counts as test iff under tests/ or basename conftest.py","The plan defines the review trigger as 'implementation plan and recorded file impact' rather than the code's actual 'non-test path in file_impact' condition."],"finding":"The plan's operational description ('a complex bug with an implementation plan and recorded file impact must receive LLM plan review') does not precisely track the actual escalation predicate, which fires on file_impact declaring any NON-TEST path — not on the mere presence of an implementation plan. A bug whose recorded file_impact is test-only stays in the light advisory tier regardless of plan complexity.","group_criteria":null,"group_id":null,"id":"fe2297f5aaa4f7694","impact":0.67,"is_primary":null,"location":"Approach section / AC line 2 ('a complex bug -- one with an implementation plan and recorded file impact after RCA -- must receive LLM plan review')","norm_id":"nbaf0acee8aa92feb","priority":0.5025,"reason":"default-advisory","recalled":false,"scenarios":["A bug with a substantial RCA-derived plan but test-only file_impact: under the code it stays advisory-only (no blocking LLM verdict), but the proposed doc wording implies it 'must receive LLM plan review', creating a doc/behavior mismatch the plan explicitly promised to avoid."],"severity":null,"suggested_fix":"State the sequence as: a bug may be claimed without plan review to perform RCA; once RCA yields a remediation whose recorded file_impact names any non-test path, the bug escalates out of the light tier (orchestrator.bug_blast_radius_escalates) and an explicit review-plan run returns a real, blocking-capable verdict before implementation.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attri