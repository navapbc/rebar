{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793699138498276001,"compiled_state":{"alias":"copper-arboresque-pekingese","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"c1bd8000453d2441a3aa529a968bac5911542565","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: a350-2e7e-71eb-4f5b","material: ed86e143a642ad1d","material-part: children 647ea2107ca5072f 0","material-part: description 5e5a8d067194fea1 7998","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 0c4ea7c93af2d875 5","material-part: ticket_id ba2df0fb316a9ac2 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.14.0 (c1bd8000453)","regver: aa61189569d34126","verified-at-sha:93a822c18aed62dbdac4349aaa2b1b8a68f96226","plan-material-pin: prerequisite 4e89-30b9-1666-4e53 f20d090f22920819","dep absent src/rebar/llm/plan_review/overlap.py","dep 8939f987c9bf4713e1bbd3b5534548ad5dfd82fd80a57ac3c2d5a1d9dbac5c39 src/rebar/llm/plan_review/pass1.py","dep f06394990e4f47b7a50972b9c175c11137f3c3e8c6e9f50dbd825c00b3c15bce src/rebar/llm/plan_review/passes.py","dep b40701214ea9b0529000dc1952fa6230559783d84d28fabf39c57bbcbfc33a31 src/rebar/similar/__init__.py","dep absent tests/test_plan_review_overlap.py","read-set: 17","read-path: .rebar/criteria_routing.json","read-path: src/rebar/_commands/recent_creates.py","read-path: src/rebar/llm/plan_review/__init__.py","read-path: src/rebar/llm/plan_review/checkpoints.py","read-path: src/rebar/llm/plan_review/claimability.py","read-path: src/rebar/llm/plan_review/det_invariants.py","read-path: src/rebar/llm/plan_review/det_lint.py","read-path: src/rebar/llm/plan_review/orchestrator.py","read-path: src/rebar/llm/plan_review/pass1.py","read-path: src/rebar/llm/plan_review/passes.py","read-path: src/rebar/llm/plan_review/production_batch_runner.py","read-path: src/rebar/llm/plan_review/workflow_ops.py","read-path: src/rebar/llm/workflow/gate_dispatch.py","read-path: src/rebar/llm/workflow/gates/plan-review.yaml","read-path: src/rebar/similar/__init__.py","read-path: src/rebar/similar/embedding.py","read-path: src/rebar/similar/lexical.py","currency-basis: file_impact"],"material_fingerprint":"ed86e143a642ad1d","merged_log_commit":"93a822c18aed62dbdac4349aaa2b1b8a68f96226","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1793697162676180000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":8,"unsigned":12},"authorship_ledger":[{"content_hash":"013a21d3727dc25e52781c35bbc05756b68a72bf85b7d6b3b6dba65619b84526","event_uuid":"228d2b1d-9cab-47b2-8d0b-7636b4d23804","position":{"commit_sha":"0d86456d8b5f01ef2a785c6c866bb3cff201295f","position":"1793672550810731381-228d2b1d-9cab-47b2-8d0b-7636b4d23804"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ccb6901c6ec64b8eccd8d178a9e45261337da0c43c3fb7ee18e70d3f46a6a26f","event_uuid":"e43ba141-4a5c-44f0-a4a6-ff14091e9be0","position":{"commit_sha":"d47a38542edbe99cbc12b52a962ae02fd5c1c69c","position":"1793678684842333940-e43ba141-4a5c-44f0-a4a6-ff14091e9be0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d25270f752b5b6183c887621fd383fdedf8302967076e82b22a0b14d05ca99e9","event_uuid":"9b1cdc8c-457b-4e31-b7d9-58eda0b96af7","position":{"commit_sha":"0d108043436aa4be7a13aca69427fb7ca330c9a2","position":"1793679795734114891-9b1cdc8c-457b-4e31-b7d9-58eda0b96af7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"edc51787a5d4f0ce5e48f7a471e3579d9bf05c5d966ad4fe4688a9662ce90e4c","event_uuid":"ec73b3f8-214b-46f0-9b32-8a3f46d9be7e","position":{"commit_sha":"de5279cd9ca325ba12e9c05c07a95b154694babc","position":"1793679829392348122-ec73b3f8-214b-46f0-9b32-8a3f46d9be7e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review remediation — both findings from the BLOCK at material fingerprint `2d839e13b0615543` are fixed. The review was deterministic (`llm_ran: false`, 0 LLM calls, 3.9s), so this cost no model budget.\n\n**P4 BLOCKING — description was 8,919 chars against the 8,000 limit.** Both causes were my own edits in the preceding minutes: splitting 3 bundled criteria into 6, and adding a citation-provenance paragraph. Per the finding's own guidance, narration moves here rather than the work being split. Removed from the description and preserved below:\n\n> **Cites re-measured against the merge of Gerrit 3246.** Every line reference in this plan was checked individually rather than sampled: `similar/__init__.py` (91 lines) `:8`, `:46-54`, `:51`, `:52`, `:55`, `:63-64`, `:67-72`, `:73`, `:79-82`, `:83-85`; `pass1.py` (658 lines) `:215`, `:219-222`, `:326`, `:331`, `:339`; `checkpoints.py` (144 lines) `:54`, `:61-63`, `:70`; `passes.py` (510 lines) `:122`; `lexical.py` (120 lines) `:39`. All 21 resolve to the cited construct.\n\nThree Approach paragraphs were also tightened — the index-reuse, Pass-1-seam, and budget paragraphs — with every citation retained. Description is now **7,948 chars**.\n\n**P6 advisory — 4 criterion lines bundled deliverables with \"and\"; I had measured 1.** My check scanned only the text before `Checked by:`; the gate scans the whole line. All 4 bundles were in the verification half. Corrected rather than left advisory, since an unsplit criterion is not independently verifiable:\n\n- AC1 \"asserting the finding is present and names the expected ticket id\" -> \"asserting the finding names the expected ticket id\" (presence is entailed by naming).\n- AC9 \"With no model provider configured and no network ... clearing provider credentials and asserting\" -> condition restated as a clause, verification restated with the credential state as a precondition.\n- AC11, AC13 \"the diagnostic is present and the overlap finding set is empty\" -> \"the diagnostic is present, with the overlap finding set empty\".\n\nNow 16 criteria, 0 bundled on a whole-line check matching the gate's.\n\nUnverified: whether the LLM tier passes. The prior run never reached it — P4 is a deterministic admission gate that fast-fails before any model call, so no criterion-level judgment has yet been applied to this plan.","timestamp":1793678684842333940},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan rewritten against the 9 LLM findings from review 1793678989234928081. 7,989 chars (cap 8,000), 18 AC items, 0 P6-bundled items — both measured with the gate's own `det_operator_attested.ac_item_lines()` plus the `det_advisory.py:130` rule rather than by eye.\n\n**Finding 1 (block, E2) — opt-in switch named.** One keyword-only parameter `overlap: bool = False` on `review_plan` (`src/rebar/llm/plan_review/__init__.py:199`, signature verified in this worktree), threaded to `run_pass1` (`pass1.py:232`) then `_chunk_extra_context` (`:215`). Not a config key, not a CLI flag — the gate is a library entry point and the switch belongs on it.\n\n**Finding 2 (block, E2/E1) — diagnostic shape and channel defined.** `find_similar` gains `diagnostics: dict | None = None`; when a dict is passed it records `status` plus a human `detail`. The channel is `coverage[\"overlap\"]`, carried through the existing `coverage_extra` seam.\n\n**Finding 3 (block, G6) — path to a test-queryable record.** `claimability.py:132` accepts `coverage_extra` and `:153` merges it into `coverage`; `:140` documents it as carrying \"e.g. a diagnostic record\", and `:120` already uses the same mechanism for `not_claimable`. Tests assert `coverage[\"overlap\"][\"status\"]`, not a log line. I read those four lines before citing them.\n\n**Finding 4 (block, T8) — closed vocabulary.** `ok`, `index-absent`, `catch-up-failed`, `provider-error`. Each of the three failure values gets two ACs: one asserting the verdict is unchanged, one asserting the status value.\n\n**Finding 5 (advisory, E1/T5b) — provider-error degradation now has ACs.** Two of them, same shape as the other failure modes.\n\n**Finding 8 (advisory, G6) — the contradiction is resolved, and it was mine.** My earlier edit moved the design onto the Pass-1 `extra_context` seam, which makes overlap judging cost zero additional LLM calls, while leaving ACs that capped \"2 LLM calls\" and spoke of passing candidates \"to the judge\". Those ACs are gone. The replacement asserts call-count equality between `overlap=True` and `overlap=False`, and the cap is stated on injected candidates, where it actually binds.\n\n**Findings 6 and 7 (dropped) — addressed anyway.** `find_similar` has exactly one consumer in `src/`, `recent_creates.py:196` (imported `:27`); I confirmed that by sweeping the tree, not by sampling. The new parameter is default-valued and the return type is unchanged, and an AC asserts that call's result is unchanged.\n\n**Finding 9 (advisory, T5e) — not taken.** No ADR. The decision is a default-off parameter on one function plus a diagnostic dict on another; ADR 0025's bar is cross-component architecture, which this is not. Recording the reasoning here instead.\n\nRoughly 1,500 chars of narration were cut to make room. All 21 previously verified line citations are retained unchanged.","timestamp":1793679829392348122}],"created_at":1793579383398922712,"creation_channel":"mcp","deps":[{"link_uuid":"ce3abd4b-6bd2-46f1-bf58-9784c98e26d1","relation":"depends_on","target_id":"4e89-30b9-1666-4e53"}],"description":"## Context / Problem\n\nEpic 62dc's criterion 5 is undelivered: plan review never tells a reviewer that the plan overlaps work another ticket describes. Each plan is read in isolation, so two tickets planning one change both pass. Create-time surfacing matches a title plus a short description; plan review runs against a full plan. One index serves both.\n\n## Approach\n\n**Reuse the index; add no second retrieval path.** The sibling story builds a lexical FTS5 index under `.rebar/cache/similar-tickets/`, caught up in the read phase. Its whole public surface is `find_similar` (`src/rebar/similar/__init__.py:46-54`), taking query text via `text=` (`:51`) plus `exclude_id=` for self-hits (`:52`). With the optional embedding tier configured it ranks through that tier, otherwise lexically (`:79-82`): no model provider is required.\n\n**The one gap: failure distinguishability.** Every failure returns `[]`, per \"Never raises\" (`:55`), so a caller cannot tell an absent index from a failed catch-up from an empty match.\n\n**Diagnostic contract.** `find_similar` gains one keyword-only parameter `diagnostics: dict | None = None`; given a dict it records a single `status`. The set is closed, being one value per branch: `index-absent` `:63`, `catch-up-failed` `:66-71`, `retrieval-error` at the outer handler `:84`, else `ok` (`:80` embedding, `:82` lexical). An embedding-provider failure is NOT a status: `embedding.rank` returns `None` for every cause it cannot serve (`:76-79`), with `:82` then serving lexical results, so that path is `ok`. Return type, \"Never raises\", every existing call stay unchanged: the signal travels through the dict. The only `src/` consumer, `recent_creates.py:196`, passes no `diagnostics`.\n\n**Recording channel: coverage, written in place.** `run_pass1` takes `coverage` as a mutable dict (`pass1.py:238`), assigning diagnostic keys directly -- e.g. `coverage[\"isf\"]` `:473`; `coverage[\"overlap\"]` is written the same way. `coverage_extra` is not the seam: it belongs to `indeterminate_verdict` (`claimability.py:132`), reached only on LLM-skipping early returns the overlap path never takes.\n\n**Ride the existing Pass-1 extra-context seam.** A Pass-1 finder unit already accepts store-derived `extra_context` (`checkpoints.py:54`), its identity binding that context by `context_digest`, a sha256 over the injected text (`:61-63`). That text is built by `_chunk_extra_context` (`pass1.py:215`), called at `:326`, so injection lands in `pass1.py`. The seam is already criterion-keyed -- `:219` injects G5 context when G5 is in the chunk, `:221` the no-file-impact block when that criterion is -- so overlap adds a third branch on the same test, keyed to `project.plan-overlap`. Riding it rather than adding a pass leaves checkpoint identity plus caching unchanged: a changed candidate set yields a different `context_digest`.\n\n**Zero marginal LLM cost: the existing Pass-1 unit does the judging.** Candidates ride a chunk already being sent, so judging adds no LLM call; lexical retrieval is not one either. The cap is on candidates, not calls: 5, the default `RESULT_LIMIT` (`similar/lexical.py:39`). ADR 0122 makes k=5 load-bearing, so overlap keeps that operating point.\n\n**On demand, not on every review.** The switch is one keyword-only parameter `overlap: bool = False` on `review_plan` (`src/rebar/llm/plan_review/__init__.py:199`), threaded exactly as `probe_criteria`, because `review_plan` assembles no batch request. The chain: `review_plan` -> `gate_dispatch.produce_plan_review_verdict` (`workflow/gate_dispatch.py:64`, called at `__init__.py:473`) -> `run_workflow` inputs (`:183`) -> a new `overlap:` input in `workflow/gates/plan-review.yaml` (`:24` declares `probe_criteria`) wired into the finders batch `with:` (`:54`, `:66`) -> `req.with_inputs` -> `ProductionBatchRunner.run` (`production_batch_runner.py:120-124`) -> `run_pass1` (`pass1.py:232`) -> `_chunk_extra_context`. Always threaded, `False` = off, so `${{ inputs.overlap }}` always resolves.\n\n**The flag gates FAN-IN, so the off switch is total.** For a PROJECT criterion the `include_project_plan_overlap` key (`workflow_ops.py:267`) is only a coverage record: `_project_criteria` never reads it, filtering solely on the `probe` allowlist (`production_batch_runner.py:283-287`, fed at `:123`). `overlap` therefore rides beside `probe` at `:120-124`, and `_keep` gains one arm dropping the id when it is false. Not fanned in, the id never reaches `registry.chunk_by_facet` (`pass1.py:262`), so with `overlap=False` it sits in no chunk's rubric and is absent from `prompt_id` (`checkpoints.py:66`) -- checkpoint identity stays byte-identical, and no finder can emit the finding from plan text alone.\n\n**Decision rule: posture, not prompt.** Mirroring `decomposition_state_block` (`det_lint.py:46`, shape at `:66-70`), `overlap.py` emits a `## POSSIBLE OVERLAP (from store)` heading, a directive to judge whether this plan does work a listed ticket already describes, then one `alias -- title (status)` line per candidate. A new `project.plan-overlap` entry in `.rebar/criteria_routing.json` carries `exec: \"1-TURN\"`, `facet: \"project-invariants\"`, `default_posture: \"advisory\"` -- the shape `project.symbol-reference-completeness` already has. `exec: \"1-TURN\"` attributes the finding: the fan-in above puts the id in a chunk's rubric, and `P1Finding.criteria` (`passes.py:51`) is the finder's rubric-id field, so it is tagged because it is IN the rubric, not because prose asks. Posture then decides, not prose: the decide pass partitions findings by `decision` (`orchestrator.py:294-301`) and `_any_blocking_criterion` (`:325-330`) intersects a finding's `criteria` with blocking-posture ids only, keyed to `default_posture` (`det_invariants.py:85`), so an advisory id can never reach `blocking`.\n\n**Degradation.** On any non-`ok` status the candidate list is empty, no overlap finding is emitted, the review proceeding normally.\n\n**Injection site has little headroom, so work is extracted.** `pass1.py` is 658 lines against the 800 cap, so overlap retrieval plus its diagnostic live in a new `src/rebar/llm/plan_review/overlap.py`; `_chunk_extra_context` gains only the call.\n\nAny ratcheted mechanism added carries a `# mechanism-ok:` marker naming this ticket at its definition site.\n\n## Acceptance Criteria\n\n- [ ] With `overlap=True`, reviewing a ticket whose plan restates an existing ticket's plan emits an advisory overlap finding naming that ticket; on a store seeded with over 5 matches exactly 5 candidates are injected. Checked by: one seeded-store test per case.\n- [ ] The off switch is total, one test per case: with `overlap=False` no overlap finding is emitted; `project.plan-overlap` is absent from `coverage[\"batch_resolution\"][\"single\"]`; the run's checkpoint identity stays byte-identical to the same review before this change; with `overlap=True` the LLM call count equals the `overlap=False` count.\n- [ ] An overlap finding can never turn a verdict from pass to block, one test per case: it is attributed to a criterion whose routing `default_posture` is `advisory`; the decide pass places it there; a passing plan's verdict is unchanged with one present.\n- [ ] Two compatibility invariants, one test each: `find_similar` called without `diagnostics` returns exactly what it did before this change (the `recent_creates.py:196` call); with no model provider configured overlap retrieval still returns lexical-tier candidates.\n- [ ] Degradation, one test per status (`index-absent` absent index; `catch-up-failed` catch-up raises; `retrieval-error` retrieval raises): `coverage[\"overlap\"][\"status\"]` records it; the overlap finding set is empty; the verdict equals that of the same review with `overlap=False`.\n- [ ] The tree-wide gates pass, one check each: every module added or modified under `src/rebar/` is at most 800 lines (module-size gate); `python scripts/check_mechanism_delta.py --check` exits 0; `python scripts/check_complexity_baseline.py --check` exits 0.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/similar/__init__.py","reason":"find_similar gains the opt-in failure-distinguishability signal that separates an absent index, a failed catch-up and an empty match"},{"path":"src/rebar/llm/plan_review/overlap.py","reason":"new unit holding overlap retrieval, the capped judge call and its diagnostic, because pass1.py is 658 of the 800-line cap"},{"path":"src/rebar/llm/plan_review/pass1.py","reason":"_chunk_extra_context (:215, sole call site :326) gains the overlap-context call"},{"path":"src/rebar/llm/plan_review/passes.py","reason":"the plan_review_findings Pass-1 discovery contract (:122) gains the advisory overlap finding"},{"path":"tests/test_plan_review_overlap.py","reason":"new sidecar tests for the finding, the 10-candidate and 2-call caps, opt-out identity, and the degradation paths"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["depends_on","4e89-30b9-1666-4e53"],["parent","62dc-535b-5d05-421d"]],"no_file_impact_reason":"","parent_id":"62dc-535b-5d05-421d","parent_status_uuid":"d9124f2c-f722-4f38-bb1e-d3fb88bda4f1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["complexity-reduction"],"ticket_id":"a350-2e7e-71eb-4f5b","ticket_type":"story","title":"Surface plan-review overlap findings on demand against the similar-ticket index","verify_commands":[]},"source_event_uuids":["359bb810-422b-49f4-9377-3a2a3ebd4d20","228d2b1d-9cab-47b2-8d0b-7636b4d23804","aa5e771b-a803-4497-a2dc-c810df441de7","c4265086-6d08-4c67-9971-12764ef1b4c3","e43ba141-4a5c-44f0-a4a6-ff14091e9be0","9b1cdc8c-457b-4e31-b7d9-58eda0b96af7","ec73b3f8-214b-46f0-9b32-8a3f46d9be7e","144431eb-5363-49a6-b3f9-c6de0c96e019","080f62dc-26f4-4977-9f8f-43ab9794a2b8","832a1d10-a001-494c-a68c-dfde09196622","239c2370-9426-4936-ae7a-58f2905df9d5","8a285308-200f-467d-ac87-31a666110a13","f0c91228-bbb2-4e0f-806c-c5b054af41f6","1456abb3-fc43-434a-8f3c-b4b1060b3e41","d9124f2c-f722-4f38-bb1e-d3fb88bda4f1","fdf7f279-f579-44c3-9bc2-48854d728d75"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793699138498276001,"uuid":"3ae95864-2f9f-43d4-b104-a6865a6c3c15"}