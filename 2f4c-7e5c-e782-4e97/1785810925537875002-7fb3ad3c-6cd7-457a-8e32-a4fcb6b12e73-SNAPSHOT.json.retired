": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a20797a412202f67d01cca34172f3ce068427e1cc16c3722aa4a78d3fb38acfb","event_uuid":"429f79b5-2fbc-42e0-bde4-dbbdcb2cf324","position":{"commit_sha":"6f4a2803c9f73d5a3b3b97adb367d4497db57fde","position":"1785710465978602001-429f79b5-2fbc-42e0-bde4-dbbdcb2cf324"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b02700cd6e624c19c2badd87b8e7f558a29de6d22f6911b5a0dddd5c824f5b09","event_uuid":"b2a5cc6a-3c2b-49c0-b23f-cfe2d00a50bf","position":{"commit_sha":"9a27327ca266923501873a06bec400ce5e593165","position":"1785810167586771001-b2a5cc6a-3c2b-49c0-b23f-cfe2d00a50bf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e94f37c0bcd37a55794b423ef120b46f04cf1f0d2f081c1bcf683a78d3ecee0d","event_uuid":"fee8cd03-ce39-464a-8dcd-79ea2d415bc3","position":{"commit_sha":"bcc4416a77cfc4f7aab8d0ab3b2c9cb2a1243e55","position":"1785810218989290001-fee8cd03-ce39-464a-8dcd-79ea2d415bc3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b6ffa49c950855450614b3d89783ed3c4d7d5cce84458033ad53ff9628ab0c04","event_uuid":"93c085c5-3bb8-45cd-9f83-99918a273145","position":{"commit_sha":"80c3fc5a364647b10aff78e5a2f0a1c3b230a6eb","position":"1785810925537875001-93c085c5-3bb8-45cd-9f83-99918a273145"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Epic complete: 19/19 children closed, every change through Gerrit (LLM-Review +1 AND Verified +1) and merged to main. AC evidence by line: (1) detected-by provenance at creation + bug_trends metrics lens landed (creation-seam capture, zero new required user input). (2) Deterministic pre-LLM gates live in CI/store: raw-git-write gate (d37e, 6739ea54fa), unread-config-field detection, wall-clock-assert gate (1e95, 9af88c3ada), AC-checkbox completeness close precheck (433c) with 330c box-flip normalization. (3) Transport typed end-to-end; declared asymmetries pinned by property tests; pagination deduplicated into the shared cursor iterator (ab7f, 30c522cde9). (4) reconcile-bridge/canary workflow bodies, probe harness, vote normalizer migrated to Python per strangler-fig. (5) Canary bug filing uses hardened dedup + documented bug-creation contract; dedup-key normalization fixed under a32a (1329). (6) Engine-layer validation placement advisory-enforced via project criterion in plan review. (7) rebar-debug + rebar-implement skills and the shared test-design standard encode the approved discipline upgrades. (8) review-plan on bugs runs a real review; Gerrit bugfix-size backstop blocks oversized unreviewed bug fixes (B2, 4527/de0deb0c89) — live-calibrated on 5 historical fixtures (4b54 attestation). (9) Comment-hygiene remediation landed with CI guard (b047). Post-epic bug dispositions: a32a/d32b/cabc closed with class + evidence; 05cb/18a4 reasoned deferrals (pre-existing, not epic deliverables); ee2a (gate skew regression caused by d37e+1e95 gates) fixed + closed (1338, 52cd34f169). Follow-ups filed: 51c1 (330c doc gap).","timestamp":1785810218989290001}],"created_at":1785639928087547001,"creation_channel":"cli","deps":[{"link_uuid":"fc9b7bd3-36e5-4889-ab64-fbacfea5140e","relation":"relates_to","target_id":"5eb0-52a3-45f0-43e5"},{"link_uuid":"051336f3-6592-4de2-bc77-12db83163413","relation":"relates_to","target_id":"ce1c-4a7d-8822-4ea4"}],"description":"## Context / Problem\n\nA 344-bug corpus analysis (session log 5eb0-52a3-45f0-43e5) identified recurring escape channels: surface-parity gaps, contention semantics missed at authoring time, inert/miswired config, wall-clock flakes, unlocked store writes, auto-filer breakage, prose-only provenance rotting in code comments, and bug fixes landing without plan review. Each child was individually design-reviewed and approved by the operator (decision table in the session log; per-change experiments under /tmp/exp*.py referenced in child descriptions).\n\n## Acceptance Criteria\n\n- [x] Bug provenance is observable at creation (detected-by) and trend-queryable (bug_trends metrics lens), without new required user input.\n- [x] Deterministic pre-LLM gates exist for: raw git writes bypassing the store seam, unread config schema fields, upper-bound wall-clock asserts in tests, unchecked AC checkboxes at close, historical-context rot in code comments, and oversized bug-fix diffs lacking a current plan-review attestation.\n- [x] The reconciler transport is typed end-to-end, declared field asymmetries are pinned by property tests, and pagination loops are deduplicated into shared iterators.\n- [x] Production shell logic (reconcile-bridge/canary workflow bodies, probe harness, vote normalizer) is migrated to Python per the strangler-fig policy.\n- [x] Canary/automation bug filing follows the hardened dedup pattern and a documented bug-creation contract.\n- [x] Engine-layer validation placement is advisory-enforced at plan review.\n- [x] rebar-debug and rebar-implement skills (and the shared test-design standard) encode the approved discipline upgrades: ticket writebacks, two-axis invariant sweeps, surface census, config-effect contrast, case-(c) contention triggers, gate-finding oracle upgrades, and residual-gap disposition.\n- [x] Explicit review-plan on a bug runs a real review, and the Gerrit backstop blocks oversized bug fixes lacking one.\n- [x] Code comments citing dead SHAs/run-ids/dates are remediated to ticket citations, with a CI guard preventing regression.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"examples/agent-skills/","reason":"skill prose upgrades"},{"path":"src/rebar/llm/","reason":"gate criteria and prechecks"},{"path":"scripts/","reason":"detectors and shell migration"},{"path":".github/workflows/","reason":"CI lints and bridge migration"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","5eb0-52a3-45f0-43e5"],["relates_to","ce1c-4a7d-8822-4ea4"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f383a6ee-3864-4254-8fba-63e2e4dd27a6","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["bug-trends","prevention"],"ticket_id":"2f4c-7e5c-e782-4e97","ticket_type":"epic","title":"Bug-trend prevention program: observability, gates, migrations, and skill discipline from the 344-bug analysis","verify_commands":[]},"source_event_uuids":["76a46da1-fd85-4555-9bc6-8e0185a19f55","be94c726-895a-48c1-8407-b1b68f958d90","fc9b7bd3-36e5-4889-ab64-fbacfea5140e","051336f3-6592-4de2-bc77-12db83163413","8179b84c-7c6a-4696-a6ba-9f1fdeb4a9c7","f383a6ee-3864-4254-8fba-63e2e4dd27a6","429f79b5-2fbc-42e0-bde4-dbbdcb2cf324","b2a5cc6a-3c2b-49c0-b23f-cfe2d00a50bf","fee8cd03-ce39-464a-8dcd-79ea2d415bc3","93c085c5-3bb8-45cd-9f83-99918a273145"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785810925537875002,"uuid":"7fb3ad3c-6cd7-457a-8e32-a4fcb6b12e73"}