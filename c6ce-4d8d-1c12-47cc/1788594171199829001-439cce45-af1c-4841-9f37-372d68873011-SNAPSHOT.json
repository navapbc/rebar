{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788594171199829001,"compiled_state":{"alias":"schematic-gleesome-ballpython","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"10af5f28bcaf1ad003e411965917deea2bf9791a","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: c6ce-4d8d-1c12-47cc","material: 85cb3d06406aca50","material-part: children 647ea2107ca5072f 0","material-part: description 9f953d2122448081 7992","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact 600b36087834df03 13","material-part: ticket_id 5b9b9dab62fde5bc 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.13.1 (10af5f28bcaf)","regver: aa61189569d34126","verified-at-sha:268bc97338513986f68598489618fbebe621c796","plan-material-pin: prerequisite 1c52-5e73-4d61-4124 3d1c36c23505ce91","dep 69a92500a876560ddf58928003edaba07e118730921967eb6122b697c45cf572 .github/workflows/_optionality.yml","dep 7cfbc395044ecbaa6a4f6a8398389625a997afd60eddd0552f4d516d30d93487 docs/adr/0115-terraform-structural-grounding.md","dep e835424bdd333c7477d97771acac5cf478eb651d31d5804fb4f83f3b5d48c5db docs/grounding.md","dep absent src/rebar/grounding/terraform_corroborator.py","dep feeee41c28f079365cfa224e67aa2749fdc938670451928fe612b99ebb85510f src/rebar/grounding/terraform_receipt.py","dep 5b5a0f97e5adebffdb0a03a2ebc41ec84c5735254906a11119fcdef062274180 src/rebar/grounding/terraform_tools.py","dep 5c8fb32c454bd4cd94c36a526e742e08ad5df8d9891c9fd6b51a196f13323bc7 src/rebar/llm/pl