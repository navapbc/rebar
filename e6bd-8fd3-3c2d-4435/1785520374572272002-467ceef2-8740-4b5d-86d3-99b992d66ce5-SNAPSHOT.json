_uuid":"5b203838-7d81-4114-bfb9-d543cb45cbbd","position":{"commit_sha":"ab425b70fa614769f1f6dab5807738572841f7d8","position":"1785515624924797001-5b203838-7d81-4114-bfb9-d543cb45cbbd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a0b7aea90de2d56a04c0f317d0fb024e5bf6c69893e8e501d3dca35a19dbed65","event_uuid":"55bd4b61-e547-4e39-8d25-380fb8a95df9","position":{"commit_sha":"866ee75e3b07e6cdfaf703deadef58f2b608372d","position":"1785519094026755001-55bd4b61-e547-4e39-8d25-380fb8a95df9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"eeb17979b8b28e7fa3e01e867633d5906338ef6f1b5f7420d71ec9b07c4b5d30","event_uuid":"8170a44c-d549-402a-82cf-375bb69e731b","position":{"commit_sha":"e7b8548dda200ebf212b19287325f6a79385c764","position":"1785519540847687001-8170a44c-d549-402a-82cf-375bb69e731b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"457faa3bf44cd8ad6099b25653882bb4588831947808fe674ee74d3638a21175","event_uuid":"c8e84634-1dd6-41ff-b52c-197a72afd3b2","position":{"commit_sha":"a40f34ef6efbeb32e4889ffd9566b2f2ba472aba","position":"1785520374541704001-c8e84634-1dd6-41ff-b52c-197a72afd3b2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4f10bca807ca89da1c0dbd31aca17ba1d570e3855826dd5296fd73a54bfc7907","event_uuid":"9cbbb97a-2811-442e-83ba-6d9ccef96484","position":{"commit_sha":"a40f34ef6efbeb32e4889ffd9566b2f2ba472aba","position":"1785520374572272001-9cbbb97a-2811-442e-83ba-6d9ccef96484"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"2e857a0a-03b6-414c-b41a-2fd1809c94b8","comments":[],"created_at":1785510698883889001,"creation_channel":"cli","deps":[{"link_uuid":"ba92a5fe-5ab3-4d65-8056-926bbcbc81f2","relation":"blocks","target_id":"8229-916b-dc27-4426"}],"description":"# Extract interpret_failure() -- run()'s except spine\n\nADR 0056 decision 3, FIRST extraction. The ordering is deliberate and was corrected by adversarial\nreview.\n\n## Why this one first\n\nAn earlier draft ordered resolution first, claiming \"every\" recent commit touching runner.py was a\npre-call resolution concern. Review disproved it -- at least five were not: 8e4d6a46d and 5144a9009\n(usage/cost, post-call), 4291b9a56 (disposition classifier, in the except arm), 3938c7ed2 (gate\nposture, in preflight), c8aa1ecdd (refusal fail-closed, in the call section). The real figure is ~70%.\n\nThe except spine is also the DENSEST code region in the file: 75 lines at only 20% comment (58 code),\nversus the pre-call region's 50% comment (113 code across 254 lines). Per line extracted it returns\nthe most headroom, and it is where several of the most recent growth commits actually landed.\n\n## Scope\n\n- `src/rebar/llm/runner.py:555-629` -> `interpret_failure(...)`.\n  MEASURED on the cc33 base (commit ad5ced165): line 555 is the first `except UsageLimitExceeded as\n  exc:` and line 629 is `raise provider_err from exc`, the last statement of the last arm. An earlier\n  draft of this bullet said \"507-581\", which was wrong at BOTH ends: 507 is the `_call_label`\n  observability setup that sits BEFORE the `try:`, and 581 stops inside the middle arm, omitting the\n  entire broad `except Exception` arm (582-629) — the one carrying the load-bearing\n  sampling-rejection ordering. Re-locate by content, not by these offsets, if the base moves.\n- Destination: `src/rebar/llm/structured_run.py` — the run-execution cluster already split from\n  runner.py (task 2682/3a98). NOT `failure.py`, which stays pure classification, and NOT a new file\n  (AGENTS.md forbids creating one under 100 LOC by splitting).\n- The `finally:` block at 630 STAYS in `run()`. It is teardown, not interpretation.\n- tests/unit/\n\n### Parameters the arms genuinely read (name them explicitly; no carrier unless >~6)\n\n`exc`, `run_messages`, `req_limit`, `eff_max_iter`, `ran_model`, `_call_label`,\n`req.execution_mode`, and `_t0` (for the elapsed-time log). `ran_model` is required by BOTH the\n`translate_sampling_parameter_rejection` call and the `ClassifyContext`, so it is not optional.\nADR 0056 permits a carrier above ~6 parameters; a small frozen context object holding the logging\nand counter fields is in-bounds here, since none of its fields is mutated after construction (the\nADR's objection to `ResolvedCall` was that two of ITS fields were).\n\n## Preserve the arm ORDER — it is the whole contract\n\nKeep `UsageLimitExceeded`, then `LLMError`, then broad `Exception`; and within the broad arm try\n`translate_sampling_parameter_rejection` FIRST. Python's type lattice hides a regression here:\n`UsageLimitExceeded` and every `LLMError` are plain `Exception` subclasses, so a broad-first spine\nsilently reclassifies a step-budget stop or a typed failure as a provider OUTAGE. And\n`LLMConfigError` is a SUBCLASS of `LLMUnavailableError`, so an `isinstance` assertion CANNOT\ndistinguish a correctly-translated sampling rejection from the broad fallback — arm-ordering tests\nmust assert `type(x) is`, never `isinstance`.\n\nNOTE for the implementer: translate_sampling_parameter_rejection performs NO retry -- it inspects and\nreclassifies. An earlier architecture draft wrongly described it as rebuilding settings and retrying.\nIt does not break the resolve-then-execute shape.\n\n## Monkeypatch repoints: MEASURED ZERO for this child\n\nNone of the eight `monkeypatch.setattr(runner_mod, \"...\")` targets in the suite\n(`_import_pydantic_ai`, `_local_proxy_bypass_base_url`, `_pai_model`, `_pai_structured`,\n`cache_settings_for`, `capabilities_for`, `get_runner`, `ProviderSession`) lies in the except spine,\nso this extraction needs no repoints. That zero was MEASURED for this region and does NOT transfer to\nthe sibling children.\n\n## Pre-existing decay this ticket should tidy, not be blamed for\n\n`tests/unit/test_llm_failure_matrix.py` carries 23 descriptive labels of the form\n`\"CURRENT(runner.py:NNN): ...\"` (e.g. `runner.py:346`, `runner.py:365`). They are the third element\nof test-case tuples — human-readable descriptions, NOT assertions, which is why the suite passes\nregardless. They were ALREADY WRONG before this ticket: they cite 346/365 while the spine actually\nsits at 555-629, so they date from a layout two splits ago. Since this extraction moves the code they\ndescribe, retarget them to name `structured_run.interpret_failure` WITHOUT a line number, so they\ncannot rot again. This is label text only — no assertion changes.\n\n## Testing\n\nUnit tier: pure given an exception and the counters. Plus one end-to-end assertion through the real\n`PydanticAIRunner.run()`, because a `run()` that stopped calling the seam would still pass every\nisolated unit test.\n\n## Acceptance Criteria\n\n- [ ] a test asserts a sampling-parameter rejection is reclassified to the typed config error and NOT\n      to LLMUnavailableError -- the arm-ordering property; it fails if the broad classification runs\n      first. MUST assert `type(err) is LLMConfigError`, because LLMConfigError subclasses\n      LLMUnavailableError and an isinstance check would pass vacuously\n- [ ] a test asserts the raised TYPE is unchanged for each of the three arms, so every existing\n      `except LLMUnavailableError` caller keeps working\n- [ ] the classified disposition is still attached as METADATA without changing the raised type,\n      asserted as: the raised error's `.outcome` is not None AND `type(err) is LLMUnavailableError`\n- [ ] an end-to-end test drives the real `run()` with a failing model and asserts the sampling\n      rejection still surfaces as the typed config error -- proving run() still routes through the seam\n- [ ] runner.py's before/after LOC is recorded in the commit message, AND the resulting file is under\n      the 700 headroom guard on THIS commit (parent 7f86 AC3: `Verified` is cast per patchset, so a\n      red ancestor blocks the whole relation chain)\n- [ ] any monkeypatch target that moved is repointed IN THE SAME COMMIT and named in the message with\n      its reason (expected: none — see \"MEASURED ZERO\" above)\n- [ ] no comment moved or rewritten in `run()` lost a measured number, a `file:line` citation, a\n      bug/story/epic id, a named failure mode, or a stated invariant","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/runner.py","reason":"collapse the three except arms into one call to the extracted seam"},{"path":"src/rebar/llm/structured_run.py","reason":"new home for interpret_failure and FailureContext"},{"path":"tests/unit/test_interpret_failure_seam.py","reason":"contract tests for the extracted spine"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["blocks","8229-916b-dc27-4426"],["parent","7f86-d935-3742-476a"]],"no_file_impact_reason":"","parent_id":"7f86-d935-3742-476a","parent_status_uuid":"c8e84634-1dd6-41ff-b52c-197a72afd3b2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"e6bd-8fd3-3c2d-4435","ticket_type":"task","title":"Extract interpret_failure() from run()'s except spine","verify_commands":[]},"source_event_uuids":["35f57ae8-9b6e-43c6-97a7-b121602e4830","ba92a5fe-5ab3-4d65-8056-926bbcbc81f2","6c9a6d8c-1b36-4a69-b8b5-bbe8a5906591","68f5cd3b-430e-4048-af89-07d64142a973","5b203838-7d81-4114-bfb9-d543cb45cbbd","55bd4b61-e547-4e39-8d25-380fb8a95df9","8170a44c-d549-402a-82cf-375bb69e731b","c8e84634-1dd6-41ff-b52c-197a72afd3b2","9cbbb97a-2811-442e-83ba-6d9ccef96484"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785520374572272002,"uuid":"467ceef2-8740-4b5d-86d3-99b992d66ce5"}