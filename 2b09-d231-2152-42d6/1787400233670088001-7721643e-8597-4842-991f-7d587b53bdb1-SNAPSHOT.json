{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787400233670088001,"compiled_state":{"alias":"unanimated-detectible-cow","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"57f4ab26f522202a89a95fb5a3b5120ca6d95644","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 2b09-d231-2152-42d6","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (57f4ab26f5)","material: 38c8827ec70236f5","verified-at-sha:57f4ab26f522202a89a95fb5a3b5120ca6d95644"],"material_fingerprint":"38c8827ec70236f5","merged_log_commit":"57f4ab26f522202a89a95fb5a3b5120ca6d95644","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787395543882807000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"5552af07350086458344e4a69f57263f7206460f","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 2b09-d231-2152-42d6","material: 38c8827ec70236f5","material-part: children 647ea2107ca5072f 0","material-part: description 6e6876b415be3b5f 5417","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 7a1b72a332848444 5","material-part: ticket_id b880881e0979730f 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phas