:"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787441418358126001,"creation_channel":"cli","deps":[{"link_uuid":"97db3cf2-34ad-4205-ae4b-4c849ea40c56","relation":"discovered_from","target_id":"89af-b080-1216-4229"}],"description":"## Context\nF09 found `/rebar/prod/mcp-hmac-signing-key` and `MCP_HMAC_SIGNING_KEY` in deployment documentation, Terraform, secret-loading scripts, and a restore runbook. No compose or application consumer appeared in the repository search. Closed infrastructure tickets record why the secret was introduced, but ADR 0049 replaced gated HMAC signing with environment-attributed Ed25519 operation certificates. Removal must follow an evidence-based compatibility and deployment assessment.\n\nKnown paths include `docs/gerrit-aws-setup.md`, `infra/scripts/fetch-secrets.sh`, `infra/runbooks/provision-restore.md`, `infra/terraform/ssm.tf`, and `infra/terraform/user_data.sh`.\n\n## Plan\n- Trace every producer, transport, and consumer of the parameter and environment variable.\n- Compare the current deployed service contract with ADR 0049 and the operation-certificate key path.\n- Determine whether any supported rollback, migration, or generic HMAC consumer still requires the secret.\n- Propose retention, deprecation, or removal with an exact file and deployment impact.\n- Do not remove infrastructure before operator approval.\n\n## Acceptance Criteria\n- [ ] Every repository reference and runtime consumer is identified.\n- [ ] The originating closed tickets and superseding ADR decisions are cited.\n- [ ] The recommendation states compatibility, rollback, and secret-rotation consequences.\n- [ ] Any remediation proposal has a bounded file and deployment impact.\n- [ ] No infrastructure is changed during the assessment.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"none","keyring":[],"managed_refs":[],"no_file_impact_reason":"Read-only assessment. Remediation scope requires operator approval.","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["infrastructure","security","research"],"ticket_id":"6f14-cefb-e3e2-4ed2","ticket_type":"task","title":"Assess obsolete MCP HMAC secret infrastructure","verify_commands":[]},"source_event_uuids":["d646db96-6a5a-48ac-bcf9-83dc4e2100f6","97db3cf2-34ad-4205-ae4b-4c849ea40c56","15c24aa9-a86c-4a21-95ac-d0e4cc767af2"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787441490630263002,"uuid":"222db708-eaa3-459b-a939-860140596320"}