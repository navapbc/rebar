lication/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5680889a358850b68efa9a1be008733892cebdbc3f50bb6413bd8dd749ccb135","event_uuid":"ea4b4537-31c8-498f-a171-ec2187964ab9","position":{"commit_sha":"40a2644411fb96a5a86e5a177f42d4fb850a3ade","position":"1787559999029355555-ea4b4537-31c8-498f-a171-ec2187964ab9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"efd37a4aaaac897ae5476921407e9728bd7d2b129c38f2f76e0ad91a8700826c","event_uuid":"67cfc6fe-c843-49ee-95e8-d0a5cf4a6af0","position":{"commit_sha":"371284d9cba7ed4e687510826aaa87aa46ca9aad","position":"1787561061920873001-67cfc6fe-c843-49ee-95e8-d0a5cf4a6af0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6a42d799aa99117dfad5b87e35ab06be2673a8180ddb05dbb1bb7537cf9af8d2","event_uuid":"0c8b429e-65df-4180-977b-06766b0fe912","position":{"commit_sha":"c0cbabaf395f49515f6d330893262f6b6e9b8568","position":"1787561496480629001-0c8b429e-65df-4180-977b-06766b0fe912"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"45fc3c246e252501b887ade7d1225a7c5e1a31ca6319bef6aaa9a9cad66f4fdf","event_uuid":"13b48801-34bc-47e7-8bf4-885499ef5cb8","position":{"commit_sha":"476a1ab75f77656c587b4e9e147a5a7708bda794","position":"1787561534616368001-13b48801-34bc-47e7-8bf4-885499ef5cb8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1f6ad949e9507a01dc505cdff4b33baf42b784ef737574566c065ff450b5b3e7","event_uuid":"7d24717f-e204-4212-95ae-3f90896ac0a2","position":{"commit_sha":"29f047073f9aaadecaca507a5296bd2711f798c0","position":"1787561752893246001-7d24717f-e204-4212-95ae-3f90896ac0a2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented: route_for now resolves aliases to their owning Route with canonical-name precedence (retired routes' aliases do not resolve). Added _index(routes) helper + module-level _BY_ALIAS and an optional routes=ROUTES param mirroring derive_policy_sets. RED->GREEN unit tests added in tests/unit/test_cli_registry.py. make lint + typecheck + registry/dispatch/cutover tests all green (module 791 LOC, under cap). Pushed as Gerrit change 2179 (https://rebar.solutions.navateam.com/c/rebar/+/2179), awaiting LLM-Review +1 and Verified +1.","timestamp":1787558489285247001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"LANDED: Gerrit change 2179 submitted (MERGED); merged to origin/main as commit 4179dd690023. LLM-Review +1 and Verified +1 both green; 0 unresolved comments. Ticket closed.","timestamp":1787561752893246001}],"completion_expectation":"required","created_at":1787192030729157001,"creation_channel":"cli","deps":[{"link_uuid":"4bd07407-d24b-44e5-a1f2-43e758ac9b33","relation":"discovered_from","target_id":"09ae-e827-1cac-452d"},{"link_uuid":"ced26ff1-93f3-4381-aa18-1d8c1d0b7af0","relation":"relates_to","target_id":"8733-e072-0621-4bb5"},{"link_uuid":"ea4b4537-31c8-498f-a171-ec2187964ab9","relation":"relates_to","target_id":"6b4c-dea2-60cc-42e6"}],"description":"## Context / Problem\nPS5 code-review (advisory, edge-cases) on RP-05 S2a change 1925 found that\n`rebar._cli._registry.route_for()` resolves only canonical route names (via the\n`_BY_NAME` index) and returns `None` for any alias spelling. The `Route.aliases`\nfield is validated (no collisions with live canonical names, no duplicates, no\nretired-name collisions — see `_check_duplicates` / `_check_alias_retired` at\n`src/rebar/_cli/_registry.py:667-700`) but the registry offers no way to resolve\nan invocation typed as an alias to its owning `Route`. The execution-dispatch\ncutover needs `route_for` to be the authoritative resolver, so it must accept an\nalias and return the owning route.\n\n## Approach\nExtend `route_for` to consult an alias index in addition to the existing\n`_BY_NAME` index, with **canonical names taking precedence over aliases**.\nConcretely, add a small pure `_index(routes)` helper that returns\n`(by_name, by_alias)` where `by_alias` maps each alias of every **non-retired**\nroute to that route (retired routes are unrouted, so their aliases must not\nresolve — mirrors `derive_policy_sets`'s live-only filter). Build the module-level\n`_BY_NAME`/`_BY_ALIAS` from `ROUTES` once via `_index`. `route_for(spelling)`\nreturns `by_name.get(spelling)` first, falling back to `by_alias.get(spelling)`,\nso a canonical spelling always wins over an alias (validation already forbids an\nalias colliding with a live canonical name, so this is defensive precedence, and\nit never resolves to a retired route). Add an optional `routes=ROUTES` parameter\n(mirroring the existing `derive_policy_sets(routes=ROUTES)` pattern at\n`src/rebar/_cli/_registry.py:635`) with a `routes is ROUTES` fast-path reusing the\nprebuilt indexes, so callers and tests can resolve against a synthetic table\nwithout a per-call rebuild on the hot dispatch path.\n\nThis is portable: the resolver is pure in-process logic over the route table with\nno CI-provider or external-service trigger.\n\n## Scope\n- `src/rebar/_cli/_registry.py` — add `_index` helper; build `_BY_NAME`/`_BY_ALIAS`\n  from it; extend `route_for` to fall back to the alias index with name precedence\n  and accept an optional `routes` table. Kept well under the 800-LOC module cap\n  (currently 770) and within the per-function complexity ceiling (route_for stays\n  a trivial two-lookup function).\n- `tests/unit/test_cli_registry.py` — add tests for alias resolution and precedence.\n\n## Testing\nLeaf, adds behavior. RED→GREEN unit tests in `tests/unit/test_cli_registry.py`:\n- Happy path: `route_for(\"<alias>\", routes=<synthetic table>)` returns the owning\n  `Route` whose `aliases` contains that spelling.\n- Precedence: when a spelling is a canonical name of one route and an alias of\n  another route in the table, `route_for` returns the **canonical** owner.\n- Retired: an alias declared by a `retired=True` route does **not** resolve\n  (returns `None`), matching the unrouted contract.\n- Regression: the shipped table (no aliases today) still resolves canonical names\n  and returns `None` for unknown spellings; import-isolation is preserved.\n\n## Acceptance Criteria\n- [x] `route_for` resolves an alias to its owning `Route`; verified by a new unit\n      test in `tests/unit/test_cli_registry.py` that passes a synthetic table with\n      an aliased route and asserts the returned route's `name`.\n- [x] Canonical names take precedence over aliases; verified by a unit test where a\n      spelling is both a canonical name and another route's alias and `route_for`\n      returns the canonical owner.\n- [x] A retired route's aliases do not resolve (`route_for` returns `None`);\n      verified by a unit test.\n- [x] No regression: `make lint`, `make typecheck`, and\n      `pytest tests/unit/test_cli_registry.py` all pass; the module stays ≤800 LOC\n      and the complexity ratchet (`scripts/check_complexity_baseline.py --check`)\n      reports no `new>0`/`increased>0`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/_registry.py","reason":"extend route_for to resolve aliases with name precedence; add _index helper and _BY_ALIAS"},{"path":"tests/unit/test_cli_registry.py","reason":"add RED->GREEN tests for alias resolution, precedence, and retired-alias non-resolution"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","6b4c-dea2-60cc-42e6"],["relates_to","8733-e072-0621-4bb5"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"0c8b429e-65df-4180-977b-06766b0fe912","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"03e1-473d-a0e3-4eaa","ticket_type":"task","title":"route_for should resolve aliases to their owning Route","verify_commands":[]},"source_event_uuids":["cc0e3120-0437-4a3b-9eda-5b1d3a186f99","a5719bfb-d76e-474e-b6e2-82658c0cf766","75a4b404-39c0-4cab-aa64-394bf5d9ac7f","1869bac8-d244-4a0f-8844-bfcf90669847","9753f50d-d32b-4b21-b22d-3721f18c0937","81165e48-1ff7-478a-9aea-d2c0acebeaf9","ced26ff1-93f3-4381-aa18-1d8c1d0b7af0","ea4b4537-31c8-498f-a171-ec2187964ab9","67cfc6fe-c843-49ee-95e8-d0a5cf4a6af0","0c8b429e-65df-4180-977b-06766b0fe912","13b48801-34bc-47e7-8bf4-885499ef5cb8","7d24717f-e204-4212-95ae-3f90896ac0a2"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787564331744169001,"uuid":"4acc131d-4e5f-47e1-adb6-85514d40cf41"}