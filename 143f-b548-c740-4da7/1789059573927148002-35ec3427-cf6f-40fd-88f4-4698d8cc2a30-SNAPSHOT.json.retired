_thread\\\"],[\\\"register_llm_tools.verify_completion\\\",\\\"ro = _readonly()\\\",1,\\\"C:register_llm_tools.verify_completion:before:ro\\\"],[\\\"register_llm_tools.review_plan\\\",\\\"ro = _readonly()\\\",1,\\\"C:register_llm_tools.review_plan:before:ro\\\"]]},\\\"src/rebar/_mcp_models.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"_OmitUnsetOut\\\",\\\"PushStatusOut\\\",\\\"WriteAckOut\\\",\\\"FsckOut\\\"],\\\"comments\\\":[[\\\"TicketStateOut\\\",\\\"cross_session_warning: str | None = None\\\",1,\\\"C:TicketStateOut:before:cross_session_warning\\\"],[\\\"TicketStateOut\\\",\\\"author: str | None = None\\\",1,\\\"C:TicketStateOut:before:author\\\"],[\\\"TicketStateOut\\\",\\\"created_at: int | str | None = None\\\",1,\\\"C:TicketStateOut:before:created_at\\\"],[\\\"WriteAckOut\\\",\\\"description_warning: str | None = None\\\",1,\\\"C:WriteAckOut:before:description_warning\\\"],[\\\"WriteAckOut\\\",\\\"cross_session_warning: str | None = None\\\",1,\\\"C:WriteAckOut:before:cross_session_warning\\\"],[\\\"CreateResultOut\\\",\\\"duplicate_warning: str | None = None\\\",1,\\\"C:CreateResultOut:before:duplicate_warning\\\"],[\\\"GateResultOut\\\",\\\"verdict: str\\\",1,\\\"C:GateResultOut:before:verdict: str\\\"],[\\\"SignResultOut\\\",\\\"ticket_id: str\\\",1,\\\"C:SignResultOut:before:ticket_id: str\\\"],[\\\"VerifySignatureResultOut\\\",\\\"trust_basis: str | None = None\\\",1,\\\"C:VerifySignatureResultOut:before:trust_basis\\\"],[\\\"PlanReviewStatusOut\\\",\\\"ok: bool\\\",1,\\\"C:PlanReviewStatusOut:before:ok: bool\\\"],[\\\"VerifyCompletionStatusOut\\\",\\\"ok: bool\\\",1,\\\"C:VerifyCompletionStatusOut:before:ok: bool\\\"],[\\\"GateRunOut\\\",\\\"job_id: str\\\",1,\\\"C:GateRunOut:before:job_id: str\\\"],[\\\"WorkflowRunOut\\\",\\\"run_id: str\\\",1,\\\"C:WorkflowRunOut:before:run_id: str\\\"],[\\\"<module>\\\",\\\"except ImportError:  # pragma: no cover - pydantic ships with the mcp extra\\\",1,\\\"C:<module>:before:except:ImportError\\\"]]},\\\"src/rebar/_mcp_opcert_health.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"opcert_signing_status\\\",\\\"run_startup_opcert_check\\\"],\\\"comments\\\":[]},\\\"src/rebar/_mcp_reads.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"_register_plan_review_tools.plan_review_status\\\",\\\"_register_plan_review_tools.verify_completion_status\\\",\\\"_register_plan_review_tools.gate_status\\\",\\\"_register_bridge_projects_read\\\",\\\"_register_bridge_projects_read.bridge_projects_list\\\",\\\"_discovery_rows\\\",\\\"register_read_tools.explain_criterion\\\",\\\"register_read_tools.list_tickets\\\",\\\"register_read_tools.audit_trail\\\",\\\"register_read_tools.ready_tickets\\\",\\\"register_read_tools.search\\\",\\\"register_read_tools.verify_signature\\\"],\\\"comments\\\":[]}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\nWORDS=re.compile(r\"\\b[\\w][\\w’'\"'\"'\\'\"'\"''\"'\"'-]*\\b\",re.UNICODE)\nDIRECTIVE=re.compile(r\"#\\s*(?:!|-\\*-|coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef definitions(tree):\n    found=[]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                found.append((name,child.lineno,child.end_lineno or child.lineno,child))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    return found\ndef anchor_after(lines,end):\n    i=end\n    while i<len(lines) and (not lines[i].strip() or lines[i].lstrip().startswith(\"#\")):\n        i+=1\n    while i<len(lines) and lines[i].lstrip().startswith(\"@\"):\n        i+=1\n    return \"<EOF>\" if i>=len(lines) else lines[i].strip()\ndef inventory(raw,path):\n    tree=ast.parse(raw,type_comments=True); lines=raw.splitlines(); defs=definitions(tree)\n    scopes=[(\"<module>\",1,max(1,len(lines)))]+[(n,a,b) for n,a,b,_ in defs]\n    docs={}\n    for owner,node in [(\"<module>\",tree)]+[(n,node) for n,_,_,node in defs]:\n        if node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n            expr=node.body[0]\n            docs[owner]={\"raw\":ast.get_source_segment(raw,expr),\"text\":expr.value.value,\"span\":(expr.lineno,expr.end_lineno or expr.lineno)}\n    full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]; row=1\n    while row<=len(lines):\n        if row not in full:\n            row+=1; continue\n        start=row; values=[]\n        while row<=len(lines) and row in full:\n            values.append(full[row]); row+=1\n        owner=min((s for s in scopes if s[1]<=start<=s[2]),key=lambda s:s[2]-s[1])[0]\n        regions.append({\"scope\":owner,\"anchor\":anchor_after(lines,row-1),\"raw\":\"\\n\".join(values),\"text\":\"\\n\".join(values),\"span\":(start,row-1)})\n    cfg=ALLOWED[path]; targets={}; picked=set()\n    for owner in cfg[\"docs\"]:\n        if owner not in docs:\n            raise SystemExit(\"missing allowlisted docstring: \"+path+\"#D:\"+owner)\n        targets[\"D:\"+owner]=docs[owner]\n    for rule in cfg[\"comments\"]:\n        scope,prefix,occ,label=rule\n        matches=[i for i,r in enumerate(regions) if r[\"scope\"]==scope and r[\"anchor\"].startswith(prefix)]\n        if len(matches)<occ:\n            raise SystemExit(\"missing allowlisted comment: \"+path+\"#\"+label)\n        idx=matches[occ-1]\n        if idx in picked:\n            raise SystemExit(\"duplicate comment identity: \"+path+\"#\"+label)\n        picked.add(idx); targets[label]=regions[idx]\n    protected_docs=sorted((k,v[\"raw\"]) for k,v in docs.items() if k not in cfg[\"docs\"])\n    protected_comments=[(r[\"scope\"],r[\"anchor\"],r[\"raw\"]) for i,r in enumerate(regions) if i not in picked]\n    return {\"targets\":targets,\"docs\":protected_docs,\"comments\":protected_comments,\"inline\":inline,\"lines\":lines}\ndef normalized(raw,path):\n    tree=ast.parse(raw,type_comments=True); wanted=set(ALLOWED[path][\"docs\"]); seen=set()\n    def walk(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES) and owner in wanted:\n            if not node.body or not isinstance(node.body[0],ast.Expr) or not isinstance(node.body[0].value,ast.Constant) or not isinstance(node.body[0].value.value,str):\n                raise SystemExit(\"allowlisted leading docstring missing: \"+path+\"#D:\"+owner)\n            node.body=node.body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    if seen!=wanted:\n        raise SystemExit(\"docstring allowlist mismatch: \"+path+\" \"+repr(sorted(wanted-seen)))\n    return ast.dump(tree,include_attributes=False)\ndef directive_signature(raw):\n    lines=raw.splitlines(); out=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not DIRECTIVE.match(tok.string):\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            attach=(\"inline\",left.strip())\n        else:\n            attach=(\"next\",anchor_after(lines,row))\n        out.append((tok.string,attach))\n    return out\ndef expanded_lines(lines,targets):\n    allowed=set()\n    for rec in targets.values():\n        start,end=rec[\"span\"]; allowed.update(range(start,end+1))\n        i=start-1\n        while i>=1 and not lines[i-1].strip():\n            allowed.add(i); i-=1\n        i=end+1\n        while i<=len(lines) and not lines[i-1].strip():\n            allowed.add(i); i+=1\n    return allowed\ndef check_hunks(path,before,after):\n    old_ok=expanded_lines(before[\"lines\"],before[\"targets\"]); new_ok=expanded_lines(after[\"lines\"],after[\"targets\"])\n    diff=subprocess.check_output([\"git\",\"diff\",\"--unified=0\",\"--no-color\",\"HEAD^..HEAD\",\"--\",path],text=True)\n    headers=[line for line in diff.splitlines() if line.startswith(\"@@\")]\n    if not headers:\n        raise SystemExit(\"owned path has no zero-context hunk: \"+path)\n    pattern=re.compile(r\"^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\")\n    for header in headers:\n        match=pattern.match(header)\n        if not match:\n            raise SystemExit(\"unparsed hunk header: \"+path+\" \"+header)\n        old_start=int(match.group(1)); old_n=int(match.group(2) or \"1\")\n        new_start=int(match.group(3)); new_n=int(match.group(4) or \"1\")\n        if old_n and not set(range(old_start,old_start+old_n))<=old_ok:\n            raise SystemExit(\"hunk leaves immutable old spans: \"+path+\" \"+header)\n        if new_n and not set(range(new_start,new_start+new_n))<=new_ok:\n            raise SystemExit(\"hunk leaves allowlisted final spans: \"+path+\" \"+header)\nfor path in sys.argv[1:]:\n    base_raw=source(BASE,path); parent_raw=source(\"HEAD^\",path); final_raw=source(\"HEAD\",path)\n    base=inventory(base_raw,path); parent=inventory(parent_raw,path); final=inventory(final_raw,path)\n    if {k:v[\"raw\"] for k,v in base[\"targets\"].items()}!={k:v[\"raw\"] for k,v in parent[\"targets\"].items()}:\n        raise SystemExit(\"im