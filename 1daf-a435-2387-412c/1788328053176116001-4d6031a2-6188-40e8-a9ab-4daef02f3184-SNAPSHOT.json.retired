d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788317703158884001,"creation_channel":"cli","deps":[{"link_uuid":"82179208-2854-42bc-a405-c4fd65c5c515","relation":"discovered_from","target_id":"f9b9-83ad-931c-4833"}],"description":"Mirror inventory finding F11 (reports/stability/mirror-inventory.md), LOW.\n\n- src/rebar/_cli/_registry.py ROUTES (78 live route names)\n- src/rebar/_cli/_execute.py:22 _CROSS_SESSION_WARN_COMMANDS — 14 hardcoded spellings, used at :74\n\nAll 14 are live route names today, so this is preventive.\n\nScope note from the sweep: WHICH verbs warn cross-session is a DISTINCT CONCEPT (a predicate subset,\nthe same rule that makes _NOT_CLAIMABLE_STATUSES not a mirror). The mirror is only the SPELLINGS,\nwhich must match route names with nothing enforcing it. It is the one CLI policy subset not folded\ninto derive_policy_sets (_registry.py:680), so a route rename silently drops the warning.\n\nProposed fix: add-route-flag — a warn_cross_session flag on Route, folded into derive_policy_sets.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[["parent","f79d-0d71-0fd7-439f"]],"no_file_impact_reason":"","parent_id":"f79d-0d71-0fd7-439f","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"1daf-a435-2387-412c","ticket_type":"task","title":"Validate _CROSS_SESSION_WARN_COMMANDS spellings against ROUTES, or add a route flag (mirror F11)","verify_commands":[]},"source_event_uuids":["6db3cf1d-ecda-4976-8b6a-5551c200e2e2","82179208-2854-42bc-a405-c4fd65c5c515","216169ef-2b91-4db2-9b87-98730e93af38"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","