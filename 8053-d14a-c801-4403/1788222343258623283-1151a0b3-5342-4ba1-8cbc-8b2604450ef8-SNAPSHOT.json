594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4068c63fde11433d4588e4e894f78cd6f0864c7b66a79b65e6ab933196377fa3","event_uuid":"c2435c45-deb5-4788-ab7d-24a41d5b1dfe","position":{"commit_sha":"d065e7771112c35311d270256469517c359140e4","position":"1788219368951609001-c2435c45-deb5-4788-ab7d-24a41d5b1dfe"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"duplicate","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"[orchestrator 2026-08-30] Duplicate of 408c-9c78-c523-4d1c (and of 5025-c661-db2e-42f9, already closed). The materialize-deploy-key.sh detect-only drift fix landed on origin/main via commit f87719be9999 ('fix(autodeploy): add 2 sources to path manifests', Verified+1): CONFIG_PATHS now enumerates infra/gerrit/materialize-deploy-key.sh, with regression test tests/scripts/test_autodeploy_signals_gerrit_config.py present and green. Closing as duplicate.","timestamp":1788219346483717001}],"completion_expectation":"disposition","created_at":1788216541335589001,"creation_channel":"python","deps":[{"link_uuid":"d0887873-3e31-487e-a0fd-91598646b4f1","relation":"duplicates","target_id":"408c-9c78-c523-4d1c"}],"description":"## Summary\n\nFound by the Step 7 (Axis 1 construct) sibling sweep while fixing `satiated-activated-aardwolf` (5524-e353-2e2d-4dbe). Same detect-only drift class as `CONFIG_PATHS`, but on the gerrit deploy-key materializer, which was overlooked when `materialize-g2p-config.sh` was added to `CONFIG_PATHS`.\n\n`infra/gerrit/materialize-deploy-key.sh` is an SSM→file materializer (it puts the replication deploy key into the gerrit user's dir), a direct sibling of `infra/gerrit/materialize-g2p-config.sh`. `materialize-g2p-config.sh` IS enumerated in `CONFIG_PATHS` (detect-only, `reason=config_manual`); `materialize-deploy-key.sh` is in **no** manifest. So a merged change to the deploy-key materializer rsyncs to `/opt/rebar` and silently does nothing — the same drift class `CONFIG_PATHS` detect-only was created to make visible.\n\n## Class-level plan (PRIMARY ticket for the manifest-omission class)\n\nThis ticket is the primary for a ONE class-level change fixing both confirmed instances of the class \"an infra SOURCE that affects the running environment is absent from every path manifest in `infra/scripts/autodeploy.sh`, so a merged change to it drifts silently\". The change touches ONLY `infra/scripts/autodeploy.sh` (two manifest additions) plus the new/extended regression tests. Sibling ticket `5d4c-a25b-b612-4aca` (broke-choleric-hound) is fixed in the same change.\n\nBoth instances proven at runtime with a discriminating contrast against the sibling source that IS in the manifest (see RCA comments on each ticket).\n\n## Acceptance criteria (both instances are criteria)\n\n- [ ] **Instance 1 (this ticket, DETECT-ONLY):** `infra/gerrit/materialize-deploy-key.sh` is enumerated in `CONFIG_PATHS` in `infra/scripts/autodeploy.sh`, so a deploy-key-materializer-only change emits `AUTODEPLOY_ERROR reason=config_manual` (parity with `materialize-g2p-config.sh`). Applying it touches gerrit — the same operator-judgement boundary as the rest of `CONFIG_PATHS` — so signal only, no auto-reload.\n- [ ] **Instance 2 (sibling 5d4c, APPLY-PARITY):** `infra/scripts/mcp-entrypoint.sh` is enumerated in `MCP_PATHS`, so an entrypoint-source-only change rebuilds the MCP image via the EXISTING blue-green mcp deploy path (ADR 0079 v1 mcp auto-apply scope; reuse the existing path exactly — no new apply semantics).\n- [ ] RED→GREEN regression test per instance (held out from the fixer), mirroring `tests/scripts/test_autodeploy_signals_gerrit_config.py` (instance 1) and `tests/scripts/test_autodeploy_mcp_bluegreen.py` (instance 2), each shown RED first and with mutation teeth (empty the manifest entry → back to RED).\n- [ ] `observability.sh` already counts the `config_manual` signal (it counts every `AUTODEPLOY_ERROR {` regardless of reason) — verified, no observability change needed.\n- [ ] `make lint` (incl. shellcheck) + full `tests/scripts` suite green.\n\n## Structural guard (decided separately — NOT in this change)\n\nA structural manifest-completeness guard for this class is being evaluated separately and is intentionally out of scope here. This change closes the two confirmed instances; any further same-class instances found are enumerated in the final report, not filed, per the sweep-containment directive.\n\n## Evidence\n\n- `CONFIG_PATHS='… infra/gerrit/materialize-g2p-config.sh …'` includes the g2p materializer but NOT `materialize-deploy-key.sh`.\n- `grep -oE \"^[A-Z_]+_PATHS='[^']*'\" infra/scripts/autodeploy.sh | grep materialize-deploy-key` → no match.\n- Runtime: deploy-key-materializer-only change → NO signal; g2p-materializer-only change → `config_manual` fires.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/scripts/autodeploy.sh","reason":"Instance 1: add infra/gerrit/materialize-deploy-key.sh to CONFIG_PATHS (detect-only, config_manual). Instance 2: add infra/scripts/mcp-entrypoint.sh to MCP_PATHS (apply-parity, existing blue-green mcp deploy). Two manifest-string additions only."},{"path":"tests/scripts/test_autodeploy_signals_gerrit_config.py","reason":"Instance 1 RED->GREEN: extend to assert AUTODEPLOY_ERROR reason=config_manual on a materialize-deploy-key.sh-only change, mirroring the existing gerrit.config signal test."},{"path":"tests/scripts/test_autodeploy_mcp_bluegreen.py","reason":"Instance 2 RED->GREEN: add a test that drives autodeploy under a git shim where only infra/scripts/mcp-entrypoint.sh changed and asserts the existing mcp blue-green deploy path fires (compose build mcp + upstream flip)."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e97c71a4-4e35-4b29-88bc-9a7326d112a2","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"8053-d14a-c801-4403","ticket_type":"bug","title":"Autodeploy never signals a materialize-deploy-key.sh source change — gerrit deploy-key materializer absent from CONFIG_PATHS (detect-only silent-drift sibling of 5524)","verify_commands":[]},"source_event_uuids":["b0f944ab-e619-4e23-98a3-bd1038900e1f","277e4ffc-7327-47af-9619-f399a42f6bec","abc8ab1e-9a30-473e-a9c1-3fdfa27f3d24","d0887873-3e31-487e-a0fd-91598646b4f1","e97c71a4-4e35-4b29-88bc-9a7326d112a2","c2435c45-deb5-4788-ab7d-24a41d5b1dfe"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1788222343258623283,"uuid":"1151a0b3-5342-4ba1-8cbc-8b2604450ef8"}