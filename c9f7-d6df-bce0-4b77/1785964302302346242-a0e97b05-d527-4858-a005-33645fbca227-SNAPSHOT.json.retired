74,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 21,\n      \"row\": 145\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/health.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 145\n    },\n    \"message\": \"`capture_baseline` is too complex (13 > 10)\",\n    \"noqa_row\": 145,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 24,\n      \"row\": 126\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/inbound_differ.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 126\n    },\n    \"message\": \"`_diff_jira_vs_local` is too complex (14 > 10)\",\n    \"noqa_row\": 126,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 27,\n      \"row\": 254\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/inbound_differ.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 254\n    },\n    \"message\": \"`_diff_comments_inbound` is too complex (12 > 10)\",\n    \"noqa_row\": 254,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 28,\n      \"row\": 460\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/inbound_differ.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 460\n    },\n    \"message\": \"`_build_outbound_context` is too complex (13 > 10)\",\n    \"noqa_row\": 460,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 30,\n      \"row\": 532\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/inbound_differ.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 532\n    },\n    \"message\": \"`compute_inbound_mutations` is too complex (14 > 10)\",\n    \"noqa_row\": 532,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 33,\n      \"row\": 234\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/invariants.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 234\n    },\n    \"message\": \"`check_dual_identity_complete` is too complex (11 > 10)\",\n    \"noqa_row\": 234,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 29,\n      \"row\": 27\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/local_label_intent.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 27\n    },\n    \"message\": \"`_extract_tags_from_event` is too complex (13 > 10)\",\n    \"noqa_row\": 27,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 19,\n      \"row\": 186\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/outbound_comments.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 186\n    },\n    \"message\": \"`_diff_comments` is too complex (13 > 10)\",\n    \"noqa_row\": 186,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 17,\n      \"row\": 369\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/outbound_fields.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 369\n    },\n    \"message\": \"`_diff_fields` is too complex (32 > 10)\",\n    \"noqa_row\": 369,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 24,\n      \"row\": 154\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/outbound_links.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 154\n    },\n    \"message\": \"`_diff_link_removals` is too complex (13 > 10)\",\n    \"noqa_row\": 154,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 21,\n      \"row\": 525\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine/rebar_reconciler/reconcile.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 525\n    },\n    \"message\": \"`_persist_and_log` is too complex (11 > 10)\",\n    \"noqa_row\": 525,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 26,\n      \"row\": 85\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/bridge_fsck.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 85\n    },\n    \"message\": \"`audit_bridge_mappings` is too complex (21 > 10)\",\n    \"noqa_row\": 85,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 24,\n      \"row\": 248\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/bridge_fsck.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 248\n    },\n    \"message\": \"`audit_binding_drift` is too complex (24 > 10)\",\n    \"noqa_row\": 248,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 19,\n      \"row\": 403\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/bridge_fsck.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 403\n    },\n    \"message\": \"`_format_report` is too complex (17 > 10)\",\n    \"noqa_row\": 403,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 19,\n      \"row\": 108\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/gates.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 108\n    },\n    \"message\": \"`_clarity_score` is too complex (17 > 10)\",\n    \"noqa_row\": 108,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 22,\n      \"row\": 170\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/gates.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 170\n    },\n    \"message\": \"`clarity_check_cli` is too complex (13 > 10)\",\n    \"noqa_row\": 170,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 26,\n      \"row\": 268\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/gates.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 268\n    },\n    \"message\": \"`quality_check_compute` is too complex (11 > 10)\",\n    \"noqa_row\": 268,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 12,\n      \"row\": 97\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/next_batch.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 97\n    },\n    \"message\": \"`compute` is too complex (42 > 10)\",\n    \"noqa_row\": 97,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 27,\n      \"row\": 393\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/next_batch.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 393\n    },\n    \"message\": \"`render_conflict_matrix` is too complex (11 > 10)\",\n    \"noqa_row\": 393,\n    \"url\": \"https://docs.astral.sh/ruff/rules/complex-structure\"\n  },\n  {\n    \"cell\": null,\n    \"code\": \"C901\",\n    \"end_location\": {\n      \"column\": 8,\n      \"row\": 446\n    },\n    \"filename\": \"/private/tmp/rebar-quality-ratchet/src/rebar/_engine_support/next_batch.py\",\n    \"fix\": null,\n    \"location\": {\n      \"column\": 5,\n      \"row\": 446\n    },\n    \"message\": \"`run` is too complex (24 > 10)\",\n    \" … [truncated by reconciler]","jira_comment_id":"958494","timestamp":1784523970597671237},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"DRIFT BLOCKER found during rebar-implement (green-on-origin-main AC). Plan hard-codes 53 C901 findings @ Ruff 0.15.19 (commit 0f5dbc88b). CURRENT origin/main 1767d9e401: pinned Ruff is 0.16.1 and 'ruff check --select C901 --config lint.mccabe.max-complexity=15 --statistics src/rebar' reports 69 findings (raw exit 1; JSON len 69; max 'validate_scorer' 16>15). ~8 ACs and the Baseline JSON Contract hard-code 'exactly 53' (baseline entries / active=53 / JSON findings), which is now unsatisfiable AND contradicts the green-on-origin-main AC that requires the baseline reflect the CURRENT census. The plan's own step 7 says treat baseline numbers as dated observations, not the gate contract. Reconciliation needed BEFORE implementation: replace the dated 53 with the current census (69) and make the count assertions parametric (assert against the live census, not a literal), then re-review (this edit will stale the current attestation). Not proceeding with implementation until reconciled.","timestamp":1785953378299308001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Re-review returned INDETERMINATE due to a transient Bedrock infra error ('Grammar compilation timed out' -> max output retries) on one criterion call; 0 blocking findings, all DET gates pass except a non-blocking P6 ac-quality advisory (compound 'and' ACs). Addressed the one COH/E1 coherence finding: the raw-census Exit-Code Contract command used --statistics (text) while Testing/AC1 asserted JSON findings. Added command 5 (raw JSON census: --output-format=json without --exit-zero, exit 1) and pointed the Raw-state test + AC1 at it; command 1 (--statistics) remains the human-readable equivalent. Re-running review (also retries past the transient infra failure).","timestamp":1785955304653007001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented and pushed to Gerrit change 1438 (stacked on d9f5/1436; both touch pyproject.toml so sequential landing is conflict-free). scripts/check_complexity_baseline.py (490 LOC) + .github/complexity-baseline.json (69 live ceilings, generated via the wrapper from the current-tree census) + pyproject [tool.ruff.lint.mccabe] max-complexity=15 + make lint wiring + tests/unit/test_complexity_baseline.py (72 tests) + runbook update. Live C901 census=69 (max validate_scorer 16>15); --check prints 'active=69 new=0 increased=0 stale=0' exit 0. Independent held-out mutation probes (parent-run, not the implementer's tests) confirmed the gate catches new/increased debt and rejects all schema violations, and that symbol identity (nested equal-leaf under different parents, dup-qualified-key redefinition) resolves correctly. make lint green, 72/72 tests pass.","timestamp":1785959297615103001}],"created_at":1784487788704532001,"creation_channel":"cli","deps":[{"link_uuid":"486db4ce-7700-4004-97a3-3ff6861c7e28","relation":"relates_to","target_id":"56d4-04e7-d0fd-4716"},{"link_uuid":"fb8ceb23-7c6a-472c-8b9b-6f1af62407c7","relation":"relates_to","target_id":"13e9-71f1-913a-4ca3"},{"link_uuid":"939a4364-d849-450d-ade9-42882e6a20ea","relation":"relates_to","target_id":"4493-96f8-4d17-4b19"},{"link_uuid":"f8dde33a-87f3-42cf-bbe5-efe9287a1b00","relation":"relates_to","target_id":"6403-b658-9e5f-4950"}],"description":"## Context / Problem\nAt plan authoring (commit 0f5dbc88b, Ruff 0.15.19) the pinned Ruff reported 53 production C901 diagnostics above complexity 15 with a maximum score of 45; those figures are dated observations, not the gate contract. The pinned Ruff is now `ruff==0.16.1` (`pyproject.toml`) and the authoritative census is whatever the live commands below print against the **current** `origin/main` tip. Raw Ruff command `ruff check --select C901 --config 'lint.mccabe.max-complexity=15' --statistics src/rebar` exits 1 because findings exist and prints `<N> C901 complex-structure` followed by `Found <N> errors.`, where `<N>` is the live census count against current `origin/main`. Adding Ruff's explicit `--exit-zero` option changes only that subprocess exit code to 0; it does not suppress those diagnostics. Enabling raw C901 as the repository gate would therefore block every change, while per-file or inline C901 ignores would permit new complexity debt. The declared grounding metric threshold at `src/rebar/grounding/detectors/builtin/smell_metric_oversize.yaml:20` is not an implementation of per-function enforcement; `src/rebar/grounding/engine_b_backends.py:370-374` documents that gap.\n\nThe complexity ratchet intentionally covers production Python under `src/rebar`, while the existing Ruff and format portions of `make lint` continue to cover both `src` and `tests`. Test-helper complexity is outside this story because the reliability risk being bounded is production control flow; this asymmetry is explicit rather than an accidental mismatch with the canonical lint target.\n\n## Exit-Code Contract\nThere are five distinct commands:\n1. Raw census: `ruff check --select C901 --config 'lint.mccabe.max-complexity=15' --statistics src/rebar`. Expected exit is 1 and the expected count is the live raw census against current `origin/main` (read from this Ruff run, never hardcoded). This proves the debt exists.\n2. Machine-readable census: `ruff check --select C901 --config 'lint.mccabe.max-complexity=15' --exit-zero --output-format=json src/rebar`. Expected exit is 0 and the JSON length equals the live raw census count. The `--exit-zero` flag allows the wrapper to read findings without treating known lint debt as a scanner crash.\n3. Repository gate: `python scripts/check_complexity_baseline.py --check`. Expected exit is 0 only when every current finding is at or below its recorded ceiling and no scanner/schema error exists. Its summary is `active=<live-census-count> new=0 increased=0 stale=0` on the initial committed baseline.\n5. Raw JSON census: `ruff check --select C901 --config 'lint.mccabe.max-complexity=15' --output-format=json src/rebar` (no `--exit-zero`). Expected exit is 1 because findings exist, and the JSON length equals the live raw census count against current `origin/main`. This is the machine-readable form asserted by the \"Raw state\" test and its acceptance criterion; command 1's `--statistics` form is the human-readable equivalent of the same census.\n4. Maintenance rewrite: `python scripts/check_complexity_baseline.py --update-stale`. It may only lower an existing ceiling or remove an existing entry whose diagnostic disappeared. It refuses to write and exits nonzero if `new > 0`, `increased > 0`, or any scanner/schema error exists. On success it atomically writes canonical sorted JSON, then reports the post-write counters.\n\nThus Ruff itself does not consider those findings passing. The wrapper considers those exact, bounded findings accepted legacy debt and fails only on new/increased debt or operational errors. The maintenance mode removes stale debt without allowing the baseline to absorb regressions.\n\n## Approach\n1. Add `[tool.ruff.lint.mccabe] max-complexity = 15` to `pyproject.toml` as the single source for the Ruff threshold.\n2. Add `scripts/check_complexity_baseline.py`. Its scanner subprocess is exactly `ruff check --select C901 --exit-zero --output-format=json src/rebar`; `--exit-zero` is mandatory on both `--check` and `--update-stale`. The wrapper accepts Ruff return code 0 and, defensively, return code 1 as normal diagnostic-bearing operation, then parses stdout; return code 1 is not a scanner failure when stdout is valid C901 JSON. Although the pinned Ruff currently coerces findings to return code 0 under `--exit-zero`, accepting 1 prevents known findings from being confused with a transport failure. A missing executable, Ruff return code 2 or greater, invalid JSON, or non-C901 output is a scanner failure. The wrapper derives a stable qualified symbol from the Python AST node at each Ruff location, normalizes filenames to repository-relative POSIX paths, extracts the integer score from Ruff's message, and then computes its own exit code from the baseline comparison.\n3. Add `.github/complexity-baseline.json` using the exact schema below.\n4. Compare current diagnostics with the checked-in ceilings using the exact counter definitions below. Fail for new or increased debt; allow reductions and removals while reporting them as stale baseline work.\n5. Implement `--update-stale` as a guarded maintenance operation: lower still-over-threshold ceilings, delete entries with no current diagnostic, preserve all other entries, and refuse new/increased debt. Persist the canonical JSON through `rebar._store.fsutil.atomic_write`, which creates a same-directory temporary file, publishes with `os.replace`, and removes the temporary file on every raised failure while leaving the target unchanged. Do not add a second bespoke atomic-write implementation.\n6. Wire `python scripts/check_complexity_baseline.py --check` into `make lint` so pre-commit and both CI lanes inherit the wrapper verdict rather than raw Ruff's expected debt exit.\n7. Update `docs/maintenance-audit-runbook.md` so its C901 recipe uses the project Ruff resolved by `ruff --version`, threshold 15, and production scope `src/rebar`; identify historical baseline numbers as dated observations rather than the gate contract.\n\nRejected: putting C901 directly in the global Ruff select list before removing all current findings, because raw Ruff would exit 1 on every change. Rejected: per-file and inline C901 ignores, because they cannot reject a new complex function inside an exempt file. Rejected: line-number keys, because unrelated edits would churn the baseline. Rejected: an unrestricted baseline-regeneration command, because it could silently bless new or increased complexity.\n\n## Baseline JSON Contract\nThe UTF-8 JSON document is one object with exactly these fields:\n- `schema_version`: the JSON integer 1.\n- `ceilings`: an object mapping a symbol key to a score ceiling.\n\nEach `ceilings` key has the form `<repo-relative-posix-python-path>::<qualified-symbol>`. The path must start with `src/rebar/`, end with `.py`, contain no backslash or `..` component, and not be absolute. The qualified symbol is the dot-joined class/function ancestry from the Python AST and consists only of Python identifier segments, for example `src/rebar/example.py::Service.run` or `src/rebar/example.py::outer.inner`. Each ceiling is a JSON integer greater than 15; booleans, floats, strings, null, and integers at or below 15 are invalid.\n\nOnly `ast.FunctionDef` and `ast.AsyncFunctionDef` nodes can supply a symbol identity. Class and function ancestry disambiguates equal leaf names in different parents. Lambdas cannot become keys because Ruff C901 is normalized only from function-definition diagnostics. Overload declarations do not receive a key unless Ruff reports C901 at that declaration; the concrete implementation maps to its qualified function name. If two diagnostics resolve to the same qualified key, including duplicate same-scope definitions or an unexpected Ruff/AST ambiguity, normalization fails rather than choosing by line number or overwriting a ceiling.\n\nThe loader rejects unknown top-level fields, missing fields, duplicate JSON member names using `object_pairs_hook` before dict conversion, duplicate normalized symbol keys, unsorted `ceilings` keys, invalid UTF-8, and malformed JSON. The committed file contains one ceiling entry per live C901 finding against current `origin/main`; the entry count equals the live census, not a fixed number.\n\n## Counter Semantics\nThe four counters are mutually exclusive for a symbol key:\n- `active`: the key exists in current Ruff output and the baseline, and `current_score == ceiling`.\n- `new`: the key exists in current Ruff output but not the baseline.\n- `increased`: the key exists in both and `current_score > ceiling`.\n- `stale`: the key exists in the baseline and either has no current Ruff diagnostic or `current_score < ceiling`.\n\nA current key cannot increment more than one counter. `new > 0` or `increased > 0` makes the wrapper exit nonzero. `stale > 0` is an allowed improvement and `--check` exits zero when no other error exists. Ruff return codes 0 and 1 both proceed to JSON validation and counter computation; return code 1 is normal diagnostic-bearing operation, not a scanner failure. Ruff return code 2 or greater, malformed baseline data, duplicate current keys, Ruff missing, non-JSON scanner output, or a non-C901 scanner diagnostic makes the wrapper exit nonzero.\n\n## Scope\n- `pyproject.toml`\n- `scripts/check_complexity_baseline.py`\n- `.github/complexity-baseline.json`\n- `Makefile`\n- `tests/unit/test_complexity_baseline.py`\n- `docs/maintenance-audit-runbook.md`\n\n## Testing\n- Raw state: an integration-style unit test launches Ruff via the raw JSON census (Exit-Code Contract command 5: `--output-format=json` without `--exit-zero`) and asserts return code 1 plus a finding count equal to the live raw census against current `origin/main`.\n- Census transport: the test launches Ruff with `--exit-zero` and asserts return code 0 plus the same live census count.\n- Wrapper state: the committed baseline produces wrapper exit 0 and `active=<live-census-count> new=0 increased=0 stale=0`.\n- Schema: table-driven tests reject every invalid field, key, value, duplicate, ordering, encoding, and JSON case listed in the contract.\n- Symbol identity: fixtures cover nested functions with equal leaf names under different parents, async methods, lambdas, overload declarations plus an implementation, and duplicate same-qualified-key rejection.\n- Debt failures: fixtures for an unlisted symbol and a score above its ceiling exit nonzero and increment only `new` or `increased` respectively.\n- Improvements: fixtures for a lower score and a removed diagnostic exit zero and increment only `stale`.\n- Maintenance rewrite: fixtures prove `--update-stale` lowers/removes stale entries through `fsutil.atomic_write`, is byte-idempotent when no stale entry exists, refuses to write for new/increased debt or scanner/schema errors, and leaves the target unchanged with no sibling temporary file after an injected write/replace failure.\n- Scanner outcomes: return codes 0 and 1 with valid C901 JSON proceed to comparison; missing Ruff, return code 2 or greater, invalid JSON, non-C901 output, and duplicate current keys exit nonzero.\n\n## Acceptance Criteria\n- [ ] `tests/unit/test_complexity_baseline.py` launches the raw JSON census (Exit-Code Contract command 5: `--output-format=json` without `--exit-zero`) and asserts return code 1 with a C901 JSON finding count equal to the live raw census against current `origin/main` (derived from the live Ruff run, not a literal).\n- [ ] `tests/unit/test_complexity_baseline.py` launches Ruff with `--exit-zero` and asserts return code 0 with the same live census count of C901 JSON findings as the raw run.\n- [ ] `pyproject.toml` sets `tool.ruff.lint.mccabe.max-complexity` to the integer 15; `pytest -q tests/unit/test_complexity_baseline.py` verifies the parsed setting.\n- [ ] `.github/complexity-baseline.json` contains `schema_version` 1 and one ceiling per live C901 finding against current `origin/main`; `pytest -q tests/unit/test_complexity_baseline.py` verifies the count matches the live census and the schema.\n- [ ] Every baseline key and value satisfies the Baseline JSON Contract; `pytest -q tests/unit/test_complexity_baseline.py` verifies valid and invalid examples.\n- [ ] Duplicate JSON member names and duplicate normalized keys make the wrapper exit nonzero; `pytest -q tests/unit/test_complexity_baseline.py` verifies both cases.\n- [ ] Symbol fixtures prove ancestry-based identity for nested and async functions; `pytest -q tests/unit/test_complexity_baseline.py` verifies the cases.\n- [ ] Lambda and overload fixtures produce no ambiguous baseline identity, and duplicate same-qualified-key diagnostics fail normalization; `pytest -q tests/unit/test_complexity_baseline.py` verifies the cases.\n- [ ] A new current symbol increments only `new` and makes the wrapper exit nonzero; `pytest -q tests/unit/test_complexity_baseline.py` verifies the fixture.\n- [ ] A current score above its ceiling increments only `increased` and makes the wrapper exit nonzero; `pytest -q tests/unit/test_complexity_baseline.py` verifies the fixture.\n- [ ] A current score below its ceiling increments only `stale` and leaves `--check` at exit zero; `pytest -q tests/unit/test_complexity_baseline.py` verifies the fixture.\n- [ ] A baseline symbol absent from current Ruff output increments only `stale` and leaves `--check` at exit zero; `pytest -q tests/unit/test_complexity_baseline.py` verifies the fixture.\n- [ ] `--update-stale` lowers and removes stale ceilings through `rebar._store.fsutil.atomic_write`, writes sorted canonical JSON, and makes no byte change when there is no stale entry; `pytest -q tests/unit/test_complexity_baseline.py` verifies each case.\n- [ ] `--update-stale` refuses to write for new debt, increased debt, scanner failure, or schema failure; injected write and `os.replace` failures prove the target bytes remain unchanged and no sibling temporary file remains; `pytest -q tests/unit/test_complexity_baseline.py` verifies each case.\n- [ ] Ruff return codes 0 and 1 with valid C901 JSON both reach counter comparison; missing Ruff, Ruff return code 2 or greater, invalid scanner JSON, non-C901 output, and duplicate current keys each make the wrapper exit nonzero; `pytest -q tests/unit/test_complexity_baseline.py` verifies each fixture.\n- [ ] `python scripts/check_complexity_baseline.py --check` exits zero and prints `active=<live-census-count> new=0 increased=0 stale=0` on the committed tree.\n- [ ] `tests/unit/test_complexity_baseline.py` asserts `pyproject` per-file ignores contain no C901 and `src/rebar` contains no inline `noqa` selecting C901.\n- [ ] `python scripts/check_complexity_baseline.py --help` documents the raw-Ruff, census, check, and guarded `--update-stale` exit-code contracts plus the JSON key/value/counter contract.\n- [ ] `docs/maintenance-audit-runbook.md` identifies threshold 15, scope `src/rebar`, the project-resolved Ruff version command, and the wrapper check command; `pytest -q tests/unit/test_complexity_baseline.py` verifies those documented tokens.\n- [ ] `make lint` invokes the complexity wrapper over `src/rebar` while retaining the existing Ruff and format checks over `src` and `tests`; `pytest -q tests/unit/test_complexity_baseline.py` verifies both target scopes.\n- [ ] `make lint` exits zero.\n\n<!-- green-on-origin-main AC -->\n- [ ] After `git fetch origin`, the shrink-only complexity baseline reflects the **current** `origin/main` C901 census (any drift-introduced findings since the measured commit are captured), and `python scripts/check_complexity_baseline.py --check` exits 0 against current `origin/main`; the gate is not landed while the check reports `new > 0` or `increased > 0`.\n","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"pyproject.toml","reason":"Single-source Ruff max-complexity at 15"},{"path":"scripts/check_complexity_baseline.py","reason":"Implement strict schema loading, Ruff normalization, counters, and check-only exit behavior"},{"path":".github/complexity-baseline.json","reason":"Store the 53 current path-qualified-symbol score ceilings"},{"path":"Makefile","reason":"Invoke the complexity ratchet from make lint"},{"path":"tests/unit/test_complexity_baseline.py","reason":"Verify census, schema, counter partition, failures, improvements, and ignore prohibition"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","facb-44c3-2ada-41ee"],["relates_to","13e9-71f1-913a-4ca3"],["relates_to","4493-96f8-4d17-4b19"],["relates_to","56d4-04e7-d0fd-4716"],["relates_to","6403-b658-9e5f-4950"]],"no_file_impact_reason":"","parent_id":"facb-44c3-2ada-41ee","parent_status_uuid":"41302024-6626-4fbb-95ae-b6e201da8411","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[{"author":"Joe Oakhart","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","reason":"Remove malformed remediation comment produced by shell backtick interpolation; retain the immediately preceding plan edit.","target_event_type":"EDIT","target_event_uuid":"e9155833-ceca-4871-a467-c680e939171c","timestamp":1784523281721035001,"uuid":"398116c9-906d-400f-8151-50bf9f9dc230"},{"author":"Joe Oakhart","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","reason":"Remove malformed remediation comment produced by shell backtick interpolation.","target_event_type":"COMMENT","target_event_uuid":"ab142e67-3cc5-4bb4-8df1-844ed85d6c2c","timestamp":1784523301614871001,"uuid":"5e6f5fea-7f05-45d0-9114-fd5998a783b7"}],"status":"in_progress","tags":["quality","ruff","complexity","ratchet"],"ticket_id":"c9f7-d6df-bce0-4b77","ticket_type":"story","title":"Add shrink-only function-complexity baseline","verify_commands":[]},"source_event_uuids":["637396d3-e2a5-4ab4-983b-7d73db25d00e","76a64509-2993-49c1-8c51-e1e7f63b4827","4066fb41-440b-4e37-a22d-15f61043ccb4","fcfb3ec6-004c-485e-99a6-8d34dc6ff99d","631c1408-d211-4019-8ac9-68a71ab2c174","7f6c90e7-be43-41a5-a636-66a12bddfee9","8b8d0382-638c-4282-a1c6-a1bdf0eb83e4","4c4d7059-ec2c-4613-84ac-c92fcefc2441","a0a80fda-d661-4563-9430-96c51b08a4d7","c0c2fdd2-9ef8-4a00-971b-5c989982bf12","e9155833-ceca-4871-a467-c680e939171c","ab142e67-3cc5-4bb4-8df1-844ed85d6c2c","398116c9-906d-400f-8151-50bf9f9dc230","5e6f5fea-7f05-45d0-9114-fd5998a783b7","e45ac9e6-8037-43e1-bb74-23a9d0573953","2e9136d9-24be-4876-abef-1017f533a164","75dcea4b-16ce-40f4-9de7-f853f70bf9db","ec9135bb-caf2-493b-8565-828a9c615148","4453e25a-88b9-471a-a887-b3664b18ea74","41302024-6626-4fbb-95ae-b6e201da8411","ff1ed4e7-87e8-49e0-927e-7969ab8c87a2","081d7e63-0b91-46a8-86ec-5cb97a6c42b7","b7076835-d309-4ba9-b733-d565e749e26f","5ed086b9-3e8e-45a7-9631-dd1624e65d26","f833e4e0-008d-4aa7-88e4-1dcb3d9307d6","019a8f69-f5cf-4a92-8055-d1de6c236703","e78d46a3-df7d-4ea2-9b87-1abeed0b849e","486db4ce-7700-4004-97a3-3ff6861c7e28","fb8ceb23-7c6a-472c-8b9b-6f1af62407c7","939a4364-d849-450d-ade9-42882e6a20ea","f8dde33a-87f3-42cf-bbe5-efe9287a1b00"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785964302302346242,"uuid":"a0e97b05-d527-4858-a005-33645fbca227"}