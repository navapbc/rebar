e at origin/main 91c31a41"},{"path":"src/rebar/llm/workflow/completion_verdict_cache.py","reason":"Current surviving comment/docstring remediation scope at origin/main 91c31a41"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["parent","d6eb-1c6c-88c3-48f6"]],"no_file_impact_reason":"","parent_id":"d6eb-1c6c-88c3-48f6","parent_status_uuid":"97167de8-a7e7-4bf3-895d-f501114e7ae9","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"87a6-53f7-0d01-4726","ticket_type":"task","title":"Condense comments in src/rebar/llm — cohort 03: guide_parity–completion_verdict_cache","verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, subprocess, sys, tokenize\nBASE=\"91c31a4109ec34672aecac76f3ae081bf2e9a20a\"\nBASES=json.loads(\"{}\")\nALLOWED=json.loads(\"{\\\"src/rebar/llm/plan_review/guide_parity.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/plan_review/manifest.py\\\":{\\\"docs\\\":[\\\"_hash_basis\\\"],\\\"comments\\\":[[\\\"dependency_hashes\\\",\\\"if (\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/plan_review/orchestrator.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"route_criteria\\\",\\\"escalated_bug = ctx.ticket_type == \\\\\\\"bug\\\\\\\" and bug_blast_radius_escalates(file_impact)\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/plan_review/registry.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"\\\\\\\"ac-process-gate\\\\\\\",\\\",1],[\\\"<module>\\\",\\\"_GATE_KEY = \\\\\\\"plan_review\\\\\\\"\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/plan_review/resign.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>