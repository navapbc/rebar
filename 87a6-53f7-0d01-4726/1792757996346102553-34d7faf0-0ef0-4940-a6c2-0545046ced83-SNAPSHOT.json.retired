._runtime}\\\",1],[\\\"PydanticAIRunner.run\\\",\\\"if fallback_targets:\\\",1],[\\\"PydanticAIRunner.run\\\",\\\"_structured_run.warn_if_cache_ineffective(\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/step_failures.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/structured_run.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"build_usage_limits\\\"],\\\"comments\\\":[[\\\"build_model_settings\\\",\\\"_ceiling = _known_model_output_ceiling(resolved)\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/structured.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"output_mode\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_NATIVE_MAX_OPTIONAL_PROPERTIES = 16\\\",1],[\\\"<module>\\\",\\\"def _bedrock_converse_output_config_support() -> bool | None:\\\",1],[\\\"validate_to\\\",\\\"if isinstance(data, list):\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/usage_log.py\\\":{\\\"docs\\\":[\\\"record\\\",\\\"record_failure\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"OUTCOME_OK = \\\\\\\"ok\\\\\\\"\\\",1],[\\\"<module>\\\",\\\"_ACTIVE_STEP: ContextVar[tuple[str, str | None] | None] = ContextVar(\\\",1]],\\\"kind\\\":\\\"python\\\"},\\\"src/rebar/llm/workflow/completion_verdict_cache.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[],\\\"kind\\\":\\\"python\\\"}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef normalize(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True)\n    seen=set()\n    allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]\n                seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True)\n    lines=raw.splitlines()\n    scopes=[(\"<module>\",1,max(1,len(lines)))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    full={}\n    inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]\n    i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1\n            continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((scope for scope in scopes if scope[1]<=comments[0][0]<=scope[2]),key=lambda scope:scope[2]-scope[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(value for _,value in comments)))\n    picked=set()\n    for scope,anchor,occurrence in ALLOWED[path][\"comments\"]:\n        matches=[index for index,region in enumerate(regions) if region[0]==scope and region[1]==anchor]\n        if len(matches)<occurrence:\n            if require_all:\n                raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+anchor+\":occ\"+str(occurrence))\n            continue\n        index=matches[occurrence-1]\n        if index in picked:\n            raise SystemExit(\"duplicate comment stable id: \"+path+\"#C:\"+scope+\":before:\"+anchor+\":occ\"+str(occurrence))\n        picked.add(index)\n    protected=[region for index,region in enumerate(regions) if index not in picked]\n    return inline,protected\ndef text_state(raw,path,require_all):\n    lines=raw.splitlines()\n    regions=[]\n    i=1\n    while i<=len(lines):\n        if not lines[i-1].lstrip().startswith(\"#\"):\n            i+=1\n            continue\n        start=i\n        comments=[]\n        while i<=len(lines) and (lines[i-1].lstrip().startswith(\"#\") or not lines[i-1].strip()):\n            if lines[i-1].lstrip().startswith(\"#\"):\n                comments.append(lines[i-1].lstrip())\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((\"<file>\",anchor,\"\\n\".join(comments),start,i-1))\n    picked=set()\n    for scope,anchor,occurrence in ALLOWED[path][\"comments\"]:\n        matches=[index for index,region in enumerate(regions) if region[0]==scope and region[1]==anchor]\n        if len(matches)<occurrence:\n            if require_all:\n                raise SystemExit(\"missing immutable text-comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+anchor+\":occ\"+str(occurrence))\n            continue\n        picked.add(matches[occurrence-1])\n    removed=set()\n    for index in picked:\n        removed.update(range(regions[index][3],regions[index][4]+1))\n    protected=[region[:3] for index,region in enumerate(regions) if index not in picked]\n    body=[line for number,line in enumerate(lines,1) if number not in removed]\n    return protected,body,raw.endswith(\"\\n\")\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    before=source(base,path)\n    after=source(\"HEAD\",path)\n    if ALLOWED[path][\"kind\"]==\"python\":\n        if normalize(before,path,True)!=normalize(after,path,False):\n            raise SystemExit(\"normalized AST changed: \"+path)\n        before_inline,before_protected=comment_state(before,path,True)\n        after_inline,after_protected=comment_state(after,path,False)\n        if before_inline!=after_inline:\n            raise SystemExit(\"inline comment changed: \"+path)\n        if before_protected!=after_protected:\n            raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)\n    else:\n        if text_state(before,path,True)!=text_state(after,path,False):\n            raise SystemExit(\"non-allowlisted text changed: \"+path)' 'src/rebar/llm/plan_review/guide_parity.py' 'src/rebar/llm/plan_review/manifest.py' 'src/rebar/llm/plan_review/orchestrator.py' 'src/rebar/llm/plan_review/registry.py' 'src/rebar/llm/plan_review/resign.py' 'src/rebar/llm/plan_review/sidecar.py' 'src/rebar/llm/prompting/prompt_library.py' 'src/rebar/llm/prompting/prompt_model.py' 'src/rebar/llm/review_kernel/__init__.py' 'src/rebar/llm/review_kernel/decide.py' 'src/rebar/llm/run_failure.py' 'src/rebar/llm/runner.py' 'src/rebar/llm/step_failures.py' 'src/rebar/llm/structured_run.py' 'src/rebar/llm/structured.py' 'src/rebar/llm/usage_log.py' 'src/rebar/llm/workflow/completion_verdict_cache.py'","dd_id":"semantic","dd_text":"Immutable/final Python parses; only allowlisted leading docstrings and full-line comment regions may differ; normalized runtime ASTs match."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, json, re, subprocess, sys, tokenize\nBASE=\"91c31a4109ec34672aecac76f3ae081bf2e9a20a\"\nBASES=json.loads(\"{}\")\nPATTERN=re.compile(r\"#\\s*(?:!|(?:-\\*-\\s*)?coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef next_anchor(lines,row):\n    for line in lines[row:]:\n        stripped=line.strip()\n        if stripped and not stripped.startswith(\"#\"):\n            return stripped\n    return \"<EOF>\"\ndef python_signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string):\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        anchor=(\"inline\",left.strip()) if left else (\"next\",next_anchor(lines,row))\n        found.append((tok.string,anchor))\n    return found\ndef text_signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for row,line in enumerate(lines,1):\n        position=line.find(\"#\")\n        if position<0:\n            continue\n        comment=line[position:]\n        if not PATTERN.match(comment):\n            continue\n        left=line[:position].rstrip()\n        anchor=(\"inline\",left.strip()) if left else (\"next\",next_anchor(lines,row))\n        found.append((comment,anchor))\n    return found\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    check=python_signatures if path.endswith(\".py\") else text_signatures\n    if check(source(base,path))!=check(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \