\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3659cd65c0e3a7eec13177b34acd686fe15f49a6662009f18519a6c63a84b9c7","event_uuid":"8ab45d67-46c4-4acc-95ec-822075393b9a","position":{"commit_sha":"06c61b10587a2bc666b07b269b9039d48a35d24c","position":"1788254045851457656-8ab45d67-46c4-4acc-95ec-822075393b9a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dd5b725ce8b951e6f8215ea6deabcb74982625742812d6edc566740c47cd3302","event_uuid":"796ac182-a2d9-4ef1-87f6-0c16285e642a","position":{"commit_sha":"40b09a26dee95dd41f2bba8be040396f55b7cf21","position":"1788254738028785674-796ac182-a2d9-4ef1-87f6-0c16285e642a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation landed in Gerrit change 2476 (patch set 3), gated by LLM-Review +1 and Verified +1, then submitted/merged. No defect origin applies: this is completed story work, not a bug close. Per the non-bug ticket-model rules, the completion close should run without --class/--caused-by so it receives normal completion verification rather than an administrative disposition.","timestamp":1788254738028785674}],"created_at":1787594759856421001,"creation_channel":"cli","deps":[{"link_uuid":"8d1fe3b6-048c-44d3-9695-704bc6c5dc64","relation":"depends_on","target_id":"866f-440c-3686-42df"},{"link_uuid":"3cf2936d-d436-4497-b864-b04c88922b8f","relation":"relates_to","target_id":"59a7-cb88-f2f9-4148"},{"link_uuid":"5c51f18a-b2f1-4f60-9b15-351bc0d78281","relation":"relates_to","target_id":"e31f-3d86-c034-4541"},{"link_uuid":"644c767a-04a8-46ea-98ad-18f04556f278","relation":"relates_to","target_id":"8e6c-a002-ba8c-44c8"},{"link_uuid":"8ab45d67-46c4-4acc-95ec-822075393b9a","relation":"relates_to","target_id":"f337-c58e-6605-4128"}],"description":"Compute GC-eligibility for a below-horizon reclamation unit — PRIMARILY a commit/tree **collapse checkpoint** (and, secondarily, a `.retired` tombstone): its folding compaction/collapse commit has been reachable from the sync remote's tickets ref for >= N days (config key from ADR 0106). Read-only; no deletion, no rewrite. Independently verifiable: eligibility true/false against synthetic remote-reachability + age fixtures, for both a collapse-checkpoint commit and a `.retired` tombstone. (Re-scoped 2026-08-29: the eligibility primitive is lever-agnostic and now gates commit/tree collapse, not only `.retired` GC — see epic comment 'Child-roster re-scope'.)\n\n## Implementation plan\n\nAdd a small read-only predicate module under `src/rebar/_store/` that evaluates ADR 0106 C3 horizon eligibility for two target forms:\n\n1. `checkpoint_commit_eligible(repo_root, checkpoint_commit, *, now=None)` resolves the configured tickets branch (`tracker.branch`) and sync remote (`sync.remote`), checks the corresponding remote-tracking tickets ref, and returns true only when the checkpoint commit is an ancestor of that ref and the checkpoint commit's committer timestamp is at least `[reclaim].horizon_days` old.\n2. `retired_tombstone_eligible(repo_root, retired_path, *, now=None)` resolves the tombstone's folding commit by read-only git history inspection (the commit that introduced the `.retired` path), then delegates to the same remote-anchored age predicate.\n3. Add typed config support for ADR 0106's `[reclaim].horizon_days` (default 30, env `REBAR_RECLAIM_HORIZON_DAYS`) without inventing a new key.\n4. Do not fetch, push, update refs, delete files, rewrite history, compact, or sweep. All git operations are read-only (`rev-parse`/`merge-base --is-ancestor`/`show`/`log`) against the current local view of the configured sync remote's tickets ref.\n\n## Acceptance Criteria\n\n- [ ] Given a synthetic tickets remote where an old checkpoint commit is reachable from `refs/remotes/<sync.remote>/<tracker.branch>`, `checkpoint_commit_eligible` returns true.\n- [ ] Given the same reachable checkpoint commit is newer than `[reclaim].horizon_days`, `checkpoint_commit_eligible` returns false.\n- [ ] Given a checkpoint commit is not reachable from the configured sync remote tickets ref, `checkpoint_commit_eligible` returns false even when it is old.\n- [ ] Given a synthetic `.retired` tombstone whose introducing/folding commit is old and reachable from the sync remote tickets ref, `retired_tombstone_eligible` returns true.\n- [ ] Given the tombstone's introducing/folding commit is reachable but newer than `[reclaim].horizon_days`, `retired_tombstone_eligible` returns false.\n- [ ] Given the tombstone's introducing/folding commit is not reachable from the configured sync remote tickets ref, `retired_tombstone_eligible` returns false even when it is old.\n- [ ] Tests prove `[reclaim].horizon_days` changes eligibility through the real config read path.\n- [ ] The predicate is strictly read-only: no deletion, no sweep, no compaction, no ref update, no fetch/push, and no history mutation.\n\n## Testing\n\n- RED first: add `tests/integration/test_reclaim_eligibility.py` with real synthetic git repos/remotes covering old-reachable, recent-reachable, and old-unreachable cases for both checkpoint commits and `.retired` tombstones; run the new nodes and confirm they fail because `rebar._store.reclaim_eligibility` does not exist yet.\n- GREEN: implement the read-only predicates and rerun those integration nodes.\n- Config proof: add unit coverage in `tests/unit/test_config_typed.py` and `tests/unit/test_config_loader.py` for default, file, env, and invalid `[reclaim].horizon_days` behavior.\n- Preflight before push: run targeted tests, `python scripts/gen_config_reference.py --check`, `python scripts/gen_env_registry.py --check`, then the repo verification command(s) from `rebar get-verify-commands able-tidy-massasauga` or the documented default (`make lint`, `make typecheck`, `make test`) as needed.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/config.py","reason":"Add approved config-seam accessor for ADR 0106 reclaim.horizon_days used by the _store predicate."},{"path":"src/rebar/_config_schema.py","reason":"Add ADR 0106 reclaim.horizon_days typed config default."},{"path":"src/rebar/_config_sections.py","reason":"Accept and coerce the [reclaim].horizon_days config section/key."},{"path":"src/rebar/_store/reclaim_eligibility.py","reason":"New read-only remote-anchored GC eligibility predicates."},{"path":"tests/integration/test_reclaim_eligibility.py","reason":"Synthetic git fixtures for reachable old/recent/unreachable checkpoint and .retired tombstone cases."},{"path":"tests/unit/test_config_typed.py","reason":"Pin typed default and validation for reclaim.horizon_days."},{"path":"tests/unit/test_config_loader.py","reason":"Pin env/config loading for REBAR_RECLAIM_HORIZON_DAYS/[reclaim].horizon_days."},{"path":"docs/config.md","reason":"Document ADR 0106 reclaim horizon config key."},{"path":"docs/config-reference.md","reason":"Regenerate/add config reference row for reclaim.horizon_days."},{"path":"docs/env-vars.md","reason":"Document/check env registry; generator check proved no generated row change was required for this auto-derived config env."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["depends_on","866f-440c-3686-42df"],["parent","536b-8930-b922-4063"],["relates_to","59a7-cb88-f2f9-4148"],["relates_to","8e6c-a002-ba8c-44c8"],["relates_to","e31f-3d86-c034-4541"],["relates_to","f337-c58e-6605-4128"]],"no_file_impact_reason":"","parent_id":"536b-8930-b922-4063","parent_status_uuid":"e1eba75c-d396-4226-b4ed-baf0260c029e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"e32d-6ea1-029a-435d","ticket_type":"story","title":"Remote-anchored eligibility check for .retired GC (horizon computation)","verify_commands":[]},"source_event_uuids":["12935234-97e2-412c-8daa-de92b20ae194","3cf2936d-d436-4497-b864-b04c88922b8f","dd489f8b-ca63-487e-a178-7cc7323c5a29","77a2ba54-06cc-4d5e-9b0c-31184a064b31","ce8eac1b-d90e-4587-a669-f9b995f2c5b4","25ad2bff-2680-4a1b-ac60-1aa0408c3c6c","e1eba75c-d396-4226-b4ed-baf0260c029e","c37b0c17-907f-44d1-8c07-1765f3c30409","c3444246-33a9-4726-bc09-8279792d5008","5c51f18a-b2f1-4f60-9b15-351bc0d78281","644c767a-04a8-46ea-98ad-18f04556f278","8ab45d67-46c4-4acc-95ec-822075393b9a","796ac182-a2d9-4ef1-87f6-0c16285e642a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788254738028785675,"uuid":"c4849b8f-5df4-4913-b78b-5e39e29ef730"}