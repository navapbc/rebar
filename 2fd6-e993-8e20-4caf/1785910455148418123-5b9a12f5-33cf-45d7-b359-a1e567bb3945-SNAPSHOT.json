d8ff86403ba6c0424","position":"1785905530410242001-d76e0ddf-4913-4c4a-965a-01eab26b6951"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"38d4d20e1673b97a7b589ada6b7d6f06531a3b785140533ea3a04938f310e9a0","event_uuid":"8621baf6-9fc4-47d9-b292-ec7f63a73e55","position":{"commit_sha":"c6683aa2562b3896b5a65b7bb899fa8b53c02a1c","position":"1785906240865752001-8621baf6-9fc4-47d9-b292-ec7f63a73e55"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review returned BLOCK: E4/G1G2 flagged that the plan misattributed the new llm.parse_failure_artifact_dir key to core src/rebar/config.py, but llm.* is a RESERVED section resolved on LLMConfig in src/rebar/llm/config.py (via _read_llm_file_table/read_reserved_section + _llm_str). Revised Approach/Scope to: add the field to LLMConfig + resolve in from_env via _llm_str/REBAR_LLM_PARSE_FAILURE_ARTIFACT_DIR; name the exact write seam (_pai_structured prompted branch before 'raise last', dir read via resolve_gate_config); and added G6 positive rationale + edge/failure handling (best-effort write never masks the original error, mkdir, mtime rotation). Re-reviewing.","timestamp":1785905102732180001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented via held-out TDD. Gerrit change: https://rebar.solutions.navateam.com/c/rebar/+/1414 (stacked on a40f 1412). Oracle tests/unit/test_structured_run.py 6/6 GREEN; 3 mutation teeth bite; lint+typecheck clean; blast-radius 88+16 passed. Awaiting LLM-Review+1 & Verified+1.","timestamp":1785906240865752001}],"created_at":1785891863463743001,"creation_channel":"cli","deps":[{"link_uuid":"f159bd6c-46ca-4a1a-b7d8-8d86afc902ac","relation":"depends_on","target_id":"df3a-5a7a-01e5-43f6"},{"link_uuid":"1a3fd1fc-87e6-44a5-ae36-13e4863b72dc","relation":"relates_to","target_id":"c55a-4c7b-324b-44d3"},{"link_uuid":"cd0c4035-0a93-4ffb-b10e-370a33896f42","relation":"relates_to","target_id":"462b-7bae-d0ee-4e8e"}],"description":"## Context / Problem\n\nEvery recurrence of the schema-blind extraction class was diagnosed from a lucky console\ncapture; when the reask loop in src/rebar/llm/structured_run.py (the prompted branch of\n`_pai_structured`, the `for _ in range(structured.OUTPUT_RETRIES + 1)` loop that ends in\n`raise last`) exhausts `OUTPUT_RETRIES` today, the raw reply is discarded and the failure is\nnot replayable. The store's posture is that durable records carry no response text (usage-log\nprecedent), so capture must be opt-in and local — never a default, never in ticket events.\n\n## Approach\n\nOn the FINAL structured-parse failure of the prompted reask loop (immediately before the\nterminal `raise last` in `_pai_structured`, after the bounded retries are exhausted), when the\nnew config key `llm.parse_failure_artifact_dir` resolves to a non-empty path, write one\ntimestamped file into that directory containing the raw reply text (the last attempt's\n`str(result.output)`), the model id, the contract (response-model) name, and the attempt count;\nthen append the artifact path to the raised error's message. Key unset (the default) → behavior\nis byte-for-byte today's `raise last`.\n\n**Config plumbing — `llm.*` is a RESERVED section resolved in `src/rebar/llm/config.py`, NOT\ncore `src/rebar/config.py`.** `llm.*` keys are fields on `LLMConfig` (src/rebar/llm/config.py),\nresolved in `LLMConfig.from_env` off the file table from `_read_llm_file_table` (which calls\n`_root_config.read_reserved_section(\"llm\", …)`), with the standard CLI > env > file > default\nprecedence provided by the `_llm_str` helper. So the key is added as a new\n`parse_failure_artifact_dir: str | None = None` field on `LLMConfig`, resolved in `from_env`\nvia `_llm_str(table, cli, \"REBAR_LLM_PARSE_FAILURE_ARTIFACT_DIR\", \"parse_failure_artifact_dir\",\nNone)` — exactly the pattern the file's other string knobs use (e.g. `base_url`). The failure\nhook in `structured_run.py` obtains the resolved value on the failure path via\n`rebar.llm.config.resolve_gate_config(...)` (the active gate config if a gate is running, else a\nfresh `LLMConfig.from_env`), which is how the other helpers in that module already read config.\n\n**Why this approach (rationale).** It reuses the one config-resolution path every other `llm.*`\nknob uses (no new loader, no core-config coupling — importing `rebar.llm.config` is already on\nthe failure path), and it fails CLOSED and LOCAL: the default-None key means zero behavior\nchange and nothing is ever written unless an operator opts in on their own host, honoring the\nusage-log \"no durable response text\" posture. The write is confined to the prompted branch\nbecause the NativeOutput branch never runs the reask loop (constrained decoding validates\nin-SDK), so that is the only reask-exhaustion seam. The write is BEST-EFFORT: it is wrapped so\nany I/O error (missing/unwritable dir it cannot create, full disk) is swallowed and the ORIGINAL\n`last` validation error is still raised unchanged — a debugging aid must never convert a parse\nfailure into a different, misleading failure. The directory is created if absent\n(`mkdir(parents=True, exist_ok=True)`). Rotation is by count: after writing, prune oldest-by-mtime\nso at most 20 artifacts remain per directory, so an unattended host cannot grow unbounded;\nconcurrent writers racing the prune is acceptable (best-effort, local debugging only). A\nsuccessful parse takes the `return` path and never reaches the hook, so it writes nothing.\n\nAlternatives considered: (a) threading the dir down as a new `_pai_structured` parameter — heavier\nsignature churn across callers for a value only the failure path needs; (b) capturing in the\ngeneric `interpret_failure` enricher — wrong seam, it handles typed provider errors, not the\nprompted-parse-exhaustion path. The chosen in-branch resolve is the smallest correct change.\n\nDocument the key (name, default None = off, `REBAR_LLM_PARSE_FAILURE_ARTIFACT_DIR` env alias,\nrotation-keeps-newest-20) in docs/config.md alongside the other `llm.*` keys.\n\n## Scope\n\n- src/rebar/llm/structured_run.py — the failure hook in `_pai_structured`'s prompted branch,\n  before `raise last`; reads the dir via `resolve_gate_config`, writes the artifact best-effort,\n  appends the path to the error message.\n- src/rebar/llm/config.py — the new `parse_failure_artifact_dir: str | None` field on\n  `LLMConfig` and its `_llm_str` resolution in `from_env` (the RESERVED-`llm`-section path;\n  core src/rebar/config.py is deliberately NOT touched — it does not own `llm.*`).\n- docs/config.md — key documentation (default + env alias + rotation).\n- tests/unit/test_structured_run.py — new contrast tests (fault injected at the parse seam).\n\n## Testing\n\nUnit tier with config-effect contrast (shared test-design standard §6), fault injected at the\nparse seam (a reply fixture that fails all candidates, forcing retry exhaustion), the model\ndriven by the `fake` runner / a stubbed agent so no live call is made:\n\n- Key set + forced final failure → exactly one artifact exists containing the reply bytes and\n  metadata (model id, contract name, attempt count); the raised error names the path.\n- Key unset + same failure → no artifact, error byte-for-byte unchanged (negative control).\n- Key set + successful parse → nothing written (success negative control).\n- Rotation: writing a 21st artifact evicts the oldest (by mtime).\n- Best-effort: an unwritable configured dir still raises the ORIGINAL parse error (the artifact\n  write never masks it).\n\n## Acceptance Criteria\n\n- [ ] Forced final parse failure with the key set writes exactly one artifact with reply +\n      model id + contract name — checked by the new unit test.\n- [ ] With the key unset the failure path is byte-for-byte unchanged and writes nothing —\n      checked by the contrast test.\n- [ ] A successful parse writes nothing even with the key set — checked by the negative\n      control test.\n- [ ] The key is documented with its default and rotation behavior — checked by the\n      docs/config.md section existing and naming both.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/structured_run.py","reason":"opt-in artifact hook on final parse failure"},{"path":"src/rebar/config.py","reason":"llm.parse_failure_artifact_dir key read path"},{"path":"docs/config.md","reason":"document the key"},{"path":"tests/unit/test_structured_run.py","reason":"config-effect contrast tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","df3a-5a7a-01e5-43f6"],["parent","196d-28c4-ef0f-445c"],["relates_to","462b-7bae-d0ee-4e8e"],["relates_to","c55a-4c7b-324b-44d3"]],"no_file_impact_reason":"","parent_id":"196d-28c4-ef0f-445c","parent_status_uuid":"fc23e4f6-e819-4922-ab03-47762e0d1794","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"2fd6-e993-8e20-4caf","ticket_type":"story","title":"Opt-in raw-reply artifact when structured parsing fails","verify_commands":[]},"source_event_uuids":["eb946bd2-1027-42fd-a699-7dd034eab8d6","f159bd6c-46ca-4a1a-b7d8-8d86afc902ac","ebf9b501-b533-4bdd-add1-029a97a46f8f","5aab94ed-2c3e-429c-b82a-e399412c88ca","c52ee619-7491-45f4-9936-d66ace0b6a78","3e67a48e-4fb7-4bcd-844e-9a26a73e1bd2","fc23e4f6-e819-4922-ab03-47762e0d1794","d76e0ddf-4913-4c4a-965a-01eab26b6951","8621baf6-9fc4-47d9-b292-ec7f63a73e55","1a3fd1fc-87e6-44a5-ae36-13e4863b72dc","cd0c4035-0a93-4ffb-b10e-370a33896f42"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785910455148418123,"uuid":"5b9a12f5-33cf-45d7-b359-a1e567bb3945"}