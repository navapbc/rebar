e-4e1e-98d4-c45cbd373349","position":{"commit_sha":"10b6fac064223022e7395fd835b99180b3983e55","position":"1787380199576574001-185c080e-ae6e-4e1e-98d4-c45cbd373349"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fc80423f3fb3166b658d3d8d6f4f6c7fe409ff4b9cb32624b2fe05f103ddb335","event_uuid":"b74fc03b-88e5-4b5c-a19e-68f2f4f12753","position":{"commit_sha":"da4dd2b50abc01ea91639b74075934916fc8019d","position":"1787380217819107001-b74fc03b-88e5-4b5c-a19e-68f2f4f12753"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-239_agent","claim_remote_session":null,"claimed_session":"e50ec61e-3a77-4eb8-b56b-c1d0f90ff9bc","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC self-contradiction found while implementing and corrected: AC1 demanded exactly one 'def _shadow' under src/rebar while AC3 demanded _lib_ops._shadow stay unchanged - both cannot hold, since leaving _lib_ops' definition in place leaves two. Resolved by consolidating all FOUR sites rather than three: emit_shadow_snapshot already declares repo_root: ... | None = None (_operation_config.py:225), so passing repo_root=None is byte-identical to omitting it and a single _shadow(surface, repo_root=None) serves the three MCP twins and the library variant alike. _lib_ops' call sites move from positional _shadow(repo_root, surface) to _shadow(surface, repo_root=repo_root). _config_resolvers._positive_int remains genuinely out of scope - it returns a default instead of raising, so merging it into the argparse converter would turn a rejected CLI value into a silent default.","timestamp":1787372722064125001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed as Gerrit 2064 (independent change from a second worktree, not stacked). Held-out TDD: 9 tests, implementer saw only 2; RED baseline 7 RED / 1 pinning-green. Gates: lint rc=0, mypy 626 files clean, complexity new=0 increased=0 with THREE entries going stale (simpler), 3101 pinning tests green with zero assertion edits, net -46 tracked src lines.\n\nMUTATION TESTING FOUND A REAL HOLE IN MY OWN ORACLE, worth recording. Mutation 1 dropped 'repo_root=repo_root' from ONE of the ten _lib_ops call sites and SURVIVED: my behavioural test called _lib_ops._shadow(...) directly, so it proved the shared helper CAN forward a repo_root but never that the call sites DO. A consolidation that rewired nine sites correctly and dropped the tenth would have passed, leaving that one operation composing its shadow snapshot against the wrong repository, silently. Added test_every_library_shadow_call_site_forwards_its_repo_root (an AST completeness check - structural by necessity, since the contract is 'EVERY call site forwards it' and no single runtime path crosses all ten). It now kills that mutation. Mutation 2 (re-declaring _shadow locally instead of importing it - the exact failure mode this ticket exists to prevent) is killed by two tests: the definition count and the identity check.\n\nAC self-contradiction found and fixed before implementing: AC1 required exactly one 'def _shadow' while AC3 required _lib_ops._shadow to remain unchanged. Resolved by consolidating all FOUR sites; recorded in an earlier comment.\n\nImplementation note verified by the implementer: src/rebar/_engine has no __init__.py, so request.py is path-loaded and imported flat as rebar_reconciler.*. It confirmed the shared import resolves under that load (_positive_int.__module__ == rebar._cli._parsers._common) and that the real subprocess entrypoint still runs. This is now a hard module-level dependency on rebar from the engine, unlike __main__.py which wraps its rebar import in a try/except compatibility boundary - flagged as a follow-up consideration, not a blocker.","timestamp":1787374504594989001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC EVIDENCE (verified against merged main b86a1b4c293, Gerrit 2064 MERGED). AC1: 'grep -rn \"def _shadow\" src/rebar' returns exactly ONE definition, _operation_config.py:271, with the underscore retained so the oracle measures the right name; all three MCP surfaces carry 'from rebar._operation_config import _shadow' (_mcp_llm.py:19, _mcp_writes.py:33, _mcp_reads.py:42). AC2: exactly one argparse converter 'def _positive_int(value: str) -> int' at _cli/_parsers/_common.py:19, imported by all THREE twins (request.py:15, bridge.py:15, reconcile.py:17); the only other definition is the out-of-scope namesake. AC3: _lib_ops.py:27 imports the shared helper and its 10 call sites forward repo_root, enforced by an AST test that walks every _shadow( call in the module and fails on any that omits the keyword. AC4: _config_resolvers.py does not appear in the landed diff at all (numstat match count 0), so the (raw, default) namesake that returns a default rather than raising is untouched. AC5: the landed tests/ delta is 205 added / 0 deleted in a single NEW file - no existing assertion was edited - and all 11 tests pass.\n\nGUARD TEETH PROVEN BY MUTATION, not merely asserted: appending a second 'def _shadow' to src/rebar/_store/hlc.py made test_each_helper_is_defined_exactly_once FAIL with \"_shadow: ['rebar/_operation_config.py:271', 'rebar/_store/hlc.py:160']\", then restored. The guard scans _SRC.rglob('*.py') by AST rather than by text, so a re-introduced copy cannot merge silently - which is the durability property the parent epic exists to establish, and the property that 4329 and 111a were found to be MISSING.","timestamp":1787380199576574001}],"created_at":1787352394860525001,"creation_channel":"cli","deps":[{"link_uuid":"8776c7ab-33ce-4255-b8a2-451600d06aa4","relation":"relates_to","target_id":"e215-ab23-ed6a-4791"},{"link_uuid":"ea52ccd1-6895-4770-a12c-48e6444fd817","relation":"relates_to","target_id":"70a4-502a-7c8b-4cf2"},{"link_uuid":"0eedd558-cb47-459c-8d86-7e61044d5658","relation":"relates_to","target_id":"6a93-56d7-442a-4538"}],"description":"## Context / Problem\nThe `_shadow` helper is md5-identical in `src/rebar/_mcp_llm.py:52`, `src/rebar/_mcp_reads.py:43`, `src/rebar/_mcp_writes.py:122` (6/34/24 call sites) with a fourth variant `src/rebar/_lib_ops.py:29` taking `(repo_root, surface)`; `_ticket_id` is AST-identical in `src/rebar/llm/workflow/steps.py:35` and `src/rebar/llm/plan_review/decide_ops.py:52`; `_positive_int` in `src/rebar/_engine/rebar_reconciler/request.py:24` and `src/rebar/_cli/_parsers/advanced/reconcile.py:18`. These are the token-identical twins the AST scan finds; RP-04 (`vibrant-legal-hind`) owns operation-scoped config composition and does not touch these helpers.\n\n## Approach\nOne `shadow(surface, repo_root=None)` in `src/rebar/_operation_config.py` (or the module `_lib_ops` already imports for the operation snapshot), imported by the four modules; `_ticket_id` moves to `src/rebar/llm/workflow/step_contracts.py`; `_positive_int` to `src/rebar/_cli/_parsers/_common.py` (new). Guard: `tokensave`-style AST-isomorphism is not required — a test asserts each helper name is defined once under `src/rebar`.\n\n\n## Guard construction\nFollow the guard-test construction rule in the parent epic `airborne-wellloved-kingfisher`: owner module exempt, match the constituent conjunction or AST shape named in Approach (or the definition count where no distinctive atom exists), `# <construct>-ok: <reason>` escape marker, and behaviour pinned only by the named existing tests.\n\n## Scope\n`src/rebar/_operation_config.py`, `src/rebar/_mcp_llm.py`, `src/rebar/_mcp_reads.py`, `src/rebar/_mcp_writes.py`, `src/rebar/_lib_ops.py`, `src/rebar/llm/workflow/steps.py`, `src/rebar/llm/workflow/step_contracts.py`, `src/rebar/llm/plan_review/decide_ops.py`, `src/rebar/_engine/rebar_reconciler/request.py`, `src/rebar/_cli/_parsers/advanced/reconcile.py`, `tests/unit/test_single_definition_helpers.py` (new).\n\n**Added by review remediation:** `src/rebar/_cli/_parsers/advanced/bridge.py` — the THIRD\n`_positive_int` twin (`bridge.py:17`). The census named it but the Scope list omitted it, which\nwould have left the twin unrewired and made AC1's definition-count assertion unsatisfiable.\n\n\n## Testing\nMechanical refactor; no new behaviour. Pinning: `tests/interfaces/facades/test_mcp.py`, `tests/unit/test_mcp_*`, the plan-review decide tests, and `tests/unit/rebar_reconciler/test_request*.py` pass unchanged.\n\n\n## Exact census of the twins (review remediation — verified by grep on the tree)\n\n### `_positive_int` — FOUR definitions, THREE of them twins\nToken-identical argparse converters, `(value: str) -> int`, all raising\n`ArgumentTypeError(\"must be a positive integer\")`:\n- `src/rebar/_engine/rebar_reconciler/request.py:25`\n- `src/rebar/_cli/_parsers/advanced/bridge.py:17`\n- `src/rebar/_cli/_parsers/advanced/reconcile.py:19`\n\n**A fourth is a NAMESAKE, not a twin, and is explicitly out of scope:**\n`src/rebar/_config_resolvers.py:55` `_positive_int(raw: str | None, default: int) -> int` —\nan env-var coercer that RETURNS a default instead of raising. Merging it into the argparse\nconverter would turn a rejected CLI value into a silent default. It keeps its name and body.\n\nThe earlier plan named only two sites and located the second as \"reconcile.py:18\"; the real\nthird twin is under `_cli/_parsers/advanced/`, not `_engine/rebar_reconciler/`.\n\n### `_shadow` — FOUR definitions, THREE of them twins\nToken-identical `(surface: str) -> None`:\n- `src/rebar/_mcp_writes.py:123`\n- `src/rebar/_mcp_reads.py:44`\n- `src/rebar/_mcp_llm.py:53`\n\nA fourth, `src/rebar/_lib_ops.py:29` `_shadow(repo_root, surface)`, differs only by forwarding\nan explicit `repo_root`. It IS consolidated too: `emit_shadow_snapshot` already declares\n`repo_root: ... | None = None` (`_operation_config.py:225`), so passing `repo_root=None` is\nbyte-identical to omitting it and one `_shadow(surface, repo_root=None)` serves all four. Its\ncall sites change from positional `_shadow(repo_root, surface)` to `_shadow(surface,\nrepo_root=repo_root)`.\n\n## Naming: the helper keeps the leading underscore\nThe consolidated helper is `_shadow(surface, repo_root=None)` — **with** the underscore — so\nAC1's `def _shadow` count is a meaningful oracle. An earlier revision introduced it as\n`shadow(...)`, which would have made `def _shadow` occur ZERO times and the guard would have\nmeasured the wrong name while passing.\n\n## Acceptance Criteria\n- [x] Exactly one `def _shadow` remains under `src/rebar` (the consolidated helper, underscore retained), and the three MCP twins (`_mcp_writes.py:123`, `_mcp_reads.py:44`, `_mcp_llm.py:53`) all route through it; checked by the guard test.\n- [x] Exactly one `def _positive_int` argparse converter remains, and ALL THREE twins — `_engine/rebar_reconciler/request.py:25`, `_cli/_parsers/advanced/bridge.py:17` and `_cli/_parsers/advanced/reconcile.py:19` — route through it; checked by the guard test asserting the converter definition count is 1 outside the owner.\n- [x] All FOUR `_shadow` sites route through the one helper, `_lib_ops` included, and the library surface still forwards its explicit `repo_root`; checked by a test asserting `emit_shadow_snapshot` receives that repo_root from `_lib_ops`.\n- [x] The out-of-scope namesake `_config_resolvers._positive_int` (`(raw, default) -> int`, returns a default rather than raising) is unchanged; checked by `git diff --stat` showing that file unmodified.\n- [x] Pinning suites pass with no assertion edits; checked by `pytest` and `git diff --stat`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_operation_config.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_mcp_llm.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_mcp_reads.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_mcp_writes.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_lib_ops.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/llm/workflow/steps.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/llm/workflow/step_contracts.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/llm/plan_review/decide_ops.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_engine/rebar_reconciler/request.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_cli/_parsers/advanced/reconcile.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_cli/_parsers/_common.py","reason":"consolidation edit or new shared module/test"},{"path":"tests/unit/test_single_definition_helpers.py","reason":"consolidation edit or new shared module/test"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","2ddd-b523-06da-4b4a"],["relates_to","6a93-56d7-442a-4538"],["relates_to","70a4-502a-7c8b-4cf2"],["relates_to","e215-ab23-ed6a-4791"]],"no_file_impact_reason":"","parent_id":"2ddd-b523-06da-4b4a","parent_status_uuid":"12209063-ab93-4a5c-a8a6-da1af9af162a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["consolidation","janitor","fortnight-review"],"ticket_id":"7931-faee-53ba-47b1","ticket_type":"story","title":"Single definitions for the token-identical helpers (_shadow, _ticket_id, _positive_int)","verify_commands":[]},"source_event_uuids":["7da27fe8-5595-48da-a307-31c475a015c5","02800fc8-2c9c-4af0-b216-6aa83f873c73","f7a0da61-5c5b-44f3-959b-ab3a45e7102c","a627d627-62b7-44ee-aad0-344c9463102f","12209063-ab93-4a5c-a8a6-da1af9af162a","56232c77-85b4-4ec4-a24e-1bc8bcba51f2","b0e990da-84b3-46bd-977b-fe7f3f23e74d","24317cbd-e634-4ea7-8fe6-885bc2a42ade","b8298bf5-7669-4789-868d-f351da419cb2","ea52ccd1-6895-4770-a12c-48e6444fd817","0eedd558-cb47-459c-8d86-7e61044d5658","185c080e-ae6e-4e1e-98d4-c45cbd373349","b74fc03b-88e5-4b5c-a19e-68f2f4f12753"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787384176093260001,"uuid":"497e0b06-0f6c-449a-898c-9adbbbebf4a3"}