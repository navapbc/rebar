ommit_sha":"96a4e91325dc91fa88162b6908eb5d42230f89f2","position":"1785888376540712001-f37ced4f-c17e-4b4d-8611-9e00872686b9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0d5576fca3a923d901616075bf2c5dcc4ea0a2c26ba5cbbbe94e890637d292c5","event_uuid":"10ccd64a-6ca7-4311-9f94-2b4371e1619f","position":{"commit_sha":"b94b5a2e5c17e6d852848eb881fd191fa8292c18","position":"1785891564647975001-10ccd64a-6ca7-4311-9f94-2b4371e1619f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f614749106354016fc2c49c6d3d585760c704b123690812d96aa53b4cff178f4","event_uuid":"4d70bd0e-8e17-4b85-a517-142c389febf0","position":{"commit_sha":"da1e8d6cec195f1c220ede2e1ca09545ceb5d3d5","position":"1785892450849103001-4d70bd0e-8e17-4b85-a517-142c389febf0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e63aaec388118cefea7d1725d571f9ec5030e3b23cac76e3f5113b715e632504","event_uuid":"7871341f-f717-4e9b-854f-be44a6e30f11","position":{"commit_sha":"aa12d729f02e5c8a98fa360fe2ae623b921323d7","position":"1785894048545523001-7871341f-f717-4e9b-854f-be44a6e30f11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5