{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1789021389325572395,"compiled_state":{"alias":"necessary-compatible-tick","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"6f334a067513f2d3543ff5f81dcabe812ebc4f75","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: da05-fddb-89f9-4494","material: 73f706d5d757816c","material-part: children 647ea2107ca5072f 0","material-part: description 6cefb7711e0439dc 3285","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: ticket_id 3f552307b504d03b 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.13.1 (6f334a067513f)","regver: aa61189569d34126","verified-at-sha:6f334a067513f2d3543ff5f81dcabe812ebc4f75","currency-basis: fail-safe"],"material_fingerprint":"73f706d5d757816c","merged_log_commit":"6f334a067513f2d3543ff5f81dcabe812ebc4f75","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788988544638354000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"459aa64fb8633660df72f65a5852367278711a5cbe24379c9ea0f87984832cab","event_uuid":"c7fe4338-f97e-40d9-adc2-9a27a3d56b85","position":{"commit_sha":"201ce3f155ab4a9bfe931976a046ae9e8d1b461f","position":"1788737331425304001-c7fe4338-f97e-40d9-adc2-9a27a3d56b85"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.auth