{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"d2b69be861e0399ca189d66cc4119a5fab774b8fdcb5e98e45ada3ee0e73191d","digest":{"component_or_area":"grounding worker harness","key_entities":["run_in_worker","src/rebar/grounding/harness.py","src/rebar/grounding/__init__.py","multiprocessing.get_context()","Process.start()","multiprocessing/popen_fork.py","RunResult","abstractReason","tests/unit/grounding/test_spawn_contract.py"],"problem_keywords":["multiprocessing","fork","spawn","deadlock","cpython 3.12","deprecation warning","pickling","serialization","worker harness"],"propositions":["CPython 3.12+ warns about deadlock risk when fork() is called in a multithreaded process; the grounding harness hard-codes fork context by default.","The default spawn context requires worker callables to be importable module-level names and all arguments/return values to be pickleable, whereas the old fork behavior accepted unpicklable closures.","Process start failures, pickling failures, and parent receive/unpickling failures must return RunResult(abstain_reason='other') instead of propagating exceptions to preserve the fail-open contract.","An optional caller-supplied multiprocessing context parameter allows informed callers to explicitly select fork for single-threaded or frozen-executable environments at their own thread-safety risk."]},"digest_hash_version":1,"model":"claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1787363574657304443,"uuid":"28d93086-9b0b-4801-bb70-4c1b113c6295"}