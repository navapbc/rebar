03-3558-40a4-905f-e9f93595c7a0","position":{"commit_sha":"0a0e3304596288098006f24ab28d0edc3fc37b2e","position":"1787763751918001001-5b7d1c03-3558-40a4-905f-e9f93595c7a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8c196bb477530592ed49b061275f30149f2bc01704bcb1eea20d4cef46c9e728","event_uuid":"2f8a2593-cb5d-43cb-a0c5-b446ea1f5fb7","position":{"commit_sha":"8404c6a7ec5fc7a9368febde7f17077737c3973d","position":"1787764001267179001-2f8a2593-cb5d-43cb-a0c5-b446ea1f5fb7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"31eb80b3a699523286022f47c63ce68953fa228f5367fec897e3a27be711c754","event_uuid":"cf5ee01e-785f-42c6-af33-9eba3d03fabf","position":{"commit_sha":"ddef891d78237b97de516e955f7a5aa17bce57af","position":"1787766113421768677-cf5ee01e-785f-42c6-af33-9eba3d03fabf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented S1+S2+S3 and pushed to Gerrit for review: https://rebar.solutions.navateam.com/c/rebar/+/2246 (change 2246, 'ci: audit + pin the Verified-gate vote path').\n\nContents (8 files, +74/-27):\n- S1: Makefile ZIZMOR_WORKFLOWS widened release.yml -> release.yml + gerrit-verify.yaml + the 5 reusables it calls.\n- S2: SHA-pinned all mutable actions/checkout@v7 (@9c091bb2 v7.0.0) and actions/setup-python@v7 (@5fda3b95 v7.0.0) across _build-and-test.yml, _artifact-probe.yml, _optionality.yml, _eval-discipline.yml, and gerrit-verify.yaml's 3 setup-python refs. gerrit-verify.yaml line-21 all-pinned claim now true.\n- zizmor remediation: persist-credentials:false on non-pushing branch-head checkouts (artipacked); _mutation.yml matrix.shard routed through env: (template-injection). make lint zizmor now green across all 7 vote-path workflows offline.\n- S3: _artifact-probe.yml installs twine + runs twine check --strict dist/* on both lanes.\n- test_ci_workflow_parity.py one_matrix_shard contract updated for the env-indirected shard dataflow (still teeth: reverting the env change flips it red).\n\nLocal gates green: make lint (full), test_ci_workflow_parity.py (29 passed), test_release_workflow_pins.py. Awaiting Verified +1 and LLM-Review +1.","timestamp":1787764001267179001}],"created_at":1787761519071428001,"creation_channel":"cli","deps":[{"link_uuid":"cf5ee01e-785f-42c6-af33-9eba3d03fabf","relation":"relates_to","target_id":"1806-93b2-cdaa-4e77"}],"description":"## Summary\n\nTier-1 supply-chain + packaging hygiene for the Gerrit **Verified-gate vote path**, with **zero\nadded hot-path latency**. Actions epic 5664 findings S1 (widen zizmor), S2 (make the SHA-pin\nclaim true), and S3 (`twine check` pre-merge). All checks run inside existing steps (`make lint`\nand the already-present `_artifact-probe.yml` build), so no new job and no measurable Verified\nminutes are added.\n\n## Context / Problem\n\nThe workflows that actually cast the authoritative `Verified` vote were unaudited and partly\nmispinned:\n\n- **Zizmor audited `release.yml` only** (`Makefile` `RELEASE_WORKFLOW`), so `gerrit-verify.yaml`\n  and every reusable it calls were never checked for pinning / credential-persistence /\n  template-injection issues.\n- **The SHA-pin claim was partly false.** `gerrit-verify.yaml:21` asserts all third-party\n  actions are SHA-pinned. In `gerrit-verify.yaml` itself only `actions/setup-python@v7`\n  (lines 76, 175, 359) was mutable — its `actions/checkout` steps (lines 141, 445) were already\n  pinned. The mutable `actions/checkout@v7` refs lived in the reusables the vote path calls\n  (`_build-and-test.yml`, `_artifact-probe.yml`, `_optionality.yml`, `_eval-discipline.yml`),\n  alongside their mutable `actions/setup-python@v7`. `_mutation.yml` was already fully pinned.\n- **`twine check` ran only at release**, so a packaging-metadata regression could earn\n  `Verified +1` and only fail at publish. The `_artifact-probe.yml` job installs only\n  `pip`+`build`, so a pre-merge `twine check` must install `twine` itself first.\n\n## Approach\n\n1. **S2 (pin):** pin every mutable `actions/checkout@v7` -> `@9c091bb2…  # v7.0.0` and\n   `actions/setup-python@v7` -> `@5fda3b95…  # v7.0.0`, matching the repo's existing pin+comment\n   convention. Coverage: `_build-and-test.yml`, `_artifact-probe.yml`, `_optionality.yml`, and\n   `_eval-discipline.yml` (both action families); `gerrit-verify.yaml` (only its three\n   `setup-python@v7` refs — its checkouts are already pinned). This makes the line-21 claim true.\n2. **Zizmor remediation (surfaced by S1):** add `persist-credentials: false` to the non-pushing\n   branch-head checkouts (the repo's established `artipacked` remedy, already used in\n   `gerrit-verify.yaml`), and route `_mutation.yml`'s `${{ matrix.shard }}` through `env:` to\n   clear the `template-injection` finding — a behaviour-preserving hardening (still exactly one\n   bounded shard per job).\n3. **S1 (widen zizmor):** extend the `make lint` zizmor target from `release.yml` to\n   `release.yml` + `gerrit-verify.yaml` + all five reusables it calls (`_build-and-test.yml`,\n   `_mutation.yml`, `_optionality.yml`, `_artifact-probe.yml`, `_eval-discipline.yml`). Runs\n   inside the existing `make lint` step; no new job.\n4. **S3 (twine):** add a step to `_artifact-probe.yml` right after the existing wheel/sdist build\n   that FIRST installs twine (`python -m pip install --upgrade twine`, since the probe env has\n   only pip+build) and THEN runs `twine check --strict dist/*` (seconds; validates package\n   metadata pre-merge, on both the branch-head and Gerrit-patchset lanes).\n5. Update the `test_ci_workflow_parity.py` `one_matrix_shard` contract so it verifies the shard\n   still flows to exactly one `--shard` from `matrix.shard`, now via `env:` (dataflow preserved).\n\n## Portability\n\nNo new capability is gated on a specific CI provider. Zizmor runs under `make lint`, which is the\nportable, provider-agnostic entry point (offline locally, online in CI) — a checkout with no CI\nprovider still gets the audit by running `make lint`. Pinning and the `env:` change are static\nYAML. `twine check` lives in the artifact-probe job but validates the same `python -m build`\noutput a developer can check locally with `pip install twine && twine check dist/*`.\n\n## Latency\n\nZero measurable Verified hot-path minutes added: S1/S2/zizmor-remediation change files and the\nexisting `make lint` argument set (no new step); S3 adds a seconds-scale check (twine install +\ncheck) to a job that already builds the artifacts.\n\n## Acceptance Criteria\n\n- [ ] `make lint`'s zizmor target audits `release.yml` + `gerrit-verify.yaml` + all five\n      reusables it calls, and a full `make lint` passes green (zizmor: no findings).\n- [ ] Every `actions/checkout` / `actions/setup-python` ref across the vote path is SHA-pinned\n      with a `# vX.Y.Z` comment, so `gerrit-verify.yaml`'s line-21 SHA-pin claim is true.\n- [ ] Non-pushing branch-head checkouts on the vote path set `persist-credentials: false`\n      (zizmor `artipacked` clear), and `_mutation.yml` passes `matrix.shard` via `env:`\n      (`template-injection` clear).\n- [ ] `_artifact-probe.yml` installs twine and runs `twine check --strict dist/*` after the\n      build, on both the branch-head and Gerrit-patchset lanes.\n- [ ] `tests/unit/test_ci_workflow_parity.py` passes, its `one_matrix_shard` contract updated to\n      assert the shard reaches exactly one `--shard` from `matrix.shard` via `env:` (never\n      `--all-shards`).\n- [ ] No new Gerrit Verified hot-path job or measurable added latency.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/gerrit-verify.yaml","reason":"S2: SHA-pin setup-python refs; makes the line-21 all-pinned claim true"},{"path":".github/workflows/_build-and-test.yml","reason":"S2: SHA-pin checkout/setup-python; add persist-credentials:false to branch-head checkouts"},{"path":".github/workflows/_mutation.yml","reason":"zizmor template-injection: pass matrix.shard via env"},{"path":".github/workflows/_optionality.yml","reason":"S2: SHA-pin refs; persist-credentials:false on branch-head checkouts"},{"path":".github/workflows/_artifact-probe.yml","reason":"S2 pin + persist-credentials; S3: twine check --strict dist/*"},{"path":".github/workflows/_eval-discipline.yml","reason":"S2: SHA-pin refs; persist-credentials:false on branch-head checkout"},{"path":"Makefile","reason":"S1: widen ZIZMOR_WORKFLOWS from release.yml to the full Verified-gate vote path"},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"update one_matrix_shard contract for env-indirected matrix.shard dataflow"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","5664-b797-60b9-49ef"],["relates_to","1806-93b2-cdaa-4e77"]],"no_file_impact_reason":"","parent_id":"5664-b797-60b9-49ef","parent_status_uuid":"5d0f85b4-6fd5-44bf-9670-42c4b07b21d2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"ab50-2fd0-b0ce-4fb6","ticket_type":"story","title":"Tier 1 CI: zizmor vote-path audit, SHA-pin the Verified gate, twine metadata check","verify_commands":[]},"source_event_uuids":["16e6c38e-bdff-4afb-afb7-20692ac9d3e6","677c1938-b00c-40e1-bba3-129757051e7c","4c48329d-0d6c-43b5-baa3-56a5326d19b3","9b2931d0-ce9f-4c2f-b55a-4db80be78465","5d0f85b4-6fd5-44bf-9670-42c4b07b21d2","5b7d1c03-3558-40a4-905f-e9f93595c7a0","2f8a2593-cb5d-43cb-a0c5-b446ea1f5fb7","cf5ee01e-785f-42c6-af33-9eba3d03fabf"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787766113421768678,"uuid":"97567089-a927-46db-96b1-f9e957424055"}