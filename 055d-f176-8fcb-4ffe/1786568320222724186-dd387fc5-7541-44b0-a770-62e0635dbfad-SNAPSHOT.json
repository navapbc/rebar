365-4bfed26bc6d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"93e92dba949699eec23caf7c7ddf7f97472bb2dfc952a89bffec3465d1a7699b","event_uuid":"63c5c649-0945-4adb-ae91-d8e77103e455","position":{"commit_sha":"e063384233227e6f1c9bb8ceb4197015d67c746b","position":"1786567590928999001-63c5c649-0945-4adb-ae91-d8e77103e455"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"55ba1e4c8e86f051fe7d381b68af027d85fde3f5ced40a9b9d52f51a127ea3eb","event_uuid":"83ae40d9-ef73-483b-ad90-e4a977afdd10","position":{"commit_sha":"370e8c81f4bc08a15a6c03ddcf8c44ed29f64d81","position":"1786568320222724185-83ae40d9-ef73-483b-ad90-e4a977afdd10"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented as change https://rebar.solutions.navateam.com/c/rebar/+/1680 (commit 6cb803c918, stacked on 1673).\n\nPREMISE VERIFIED. force_close_reason was declared at txn.py:198 and occurred exactly once in the file — accepted and never read — while transition_close passed the operator's --force=<reason> into it. Confirmed real.\n\nCHANGE. Written onto the *->closed STATUS event present-only, folded into reduced state, mirroring close_class at every step: same write guard, same winner-only fold (so a losing concurrent close cannot overwrite the winner's reason), same ticket_state.schema.json declaration. Renamed _fold_close_class -> _fold_close_metadata since it now folds two fields on that edge; only 3 references, all in one file.\n\nEVIDENCE. 4 new tests, 15 passing in tests/unit/test_transition_close.py. Wider -k 'transition or close or reduc or txn or state or schema': 874 passed, 3 skipped. make lint (incl. complexity baseline) and make typecheck (512 files) clean. Regenerated src/rebar/types.py via python -m rebar.schemas.gen_types after the schema edit — that file is GENERATED, and hand-editing it is what caused damselfly's first CI failure.\n\nTWO TEST-CONSTRUCTION FINDINGS worth recording, because both would have made a green test that proved nothing:\n\n1. Raw STATUS event files do not survive a close. _compact_on_close absorbs them into a SNAPSHOT, so a post-close glob finds zero *-STATUS.json. The two tests asserting on the raw event now disable compaction explicitly (it is orthogonal to what they assert); the reduced-state test needs no such help and reads through the snapshot, which is the better evidence for AC2 anyway.\n\n2. My first helper guessed the tracker path (repo/.tickets-tracker/<id>). It now resolves through rebar's own config.tracker_dir and asserts the event list is non-empty before indexing, so a moved layout FAILS loudly instead of silently passing an empty-list assertion.\n\nAC4 is pinned structurally rather than behaviourally: test_transition_core_does_not_accept_a_parameter_it_discards inspects transition_core's source and asserts every close-metadata parameter it declares is actually read in the body. That is the defect class itself — a parameter accepted and dropped — so it guards close_class and force_close_reason against rotting into no-ops the same way.","timestamp":1786567590928999001}],"created_at":1786562681158374001,"creation_channel":"cli","deps":[{"link_uuid":"84b98489-f8a6-4070-bb8b-b79c5e1505ff","relation":"discovered_from","target_id":"23b2-1a94-6a01-466b"},{"link_uuid":"83ae40d9-ef73-483b-ad90-e4a977afdd10","relation":"relates_to","target_id":"2fcb-30fb-fffb-4a9c"}],"description":"Found while validating mechanical-coherent-wolverine's premise (23b2-1a94-6a01-466b).\n\n## Report\n\n`rebar._commands.txn.transition_core` declares `force_close_reason: str = \"\"` at\n`src/rebar/_commands/txn.py:198` and **never reads it**. The identifier occurs exactly once in\nthe whole file — the parameter declaration itself.\n\nThe caller does supply a real value: `src/rebar/_commands/transition_close.py:474` passes\n`force_close_reason=force_close`, the string an operator typed into `--force=<reason>`. It is\naccepted, threaded one call deep into the locked write, and silently dropped before it reaches\nthe STATUS event.\n\n## Premise verified in current `origin/main`\n\n* `txn.py:198` — the parameter, declared with a default and never referenced again.\n* `transition_close.py:474` — the caller passing it.\n* `txn.py:277-296` — the close STATUS event `data`: `status`, `current_status`,\n  `parent_status_uuid`, and present-only `close_class`. No reason field of any kind.\n* `transition_close.py:511-521` — the ONLY durable trace of a force-close reason today is a\n  best-effort `FORCE_CLOSE` audit comment written AFTER the close, via a SECOND lock\n  acquisition, and swallowed on failure with only a `logger.warning`.\n\nThat last point is what makes this more than tidiness. Force-closing is most attractive\nprecisely when gates or the store are contended — and that is exactly when the second lock\nacquisition is most likely to time out and take the bypass reason with it, while the parameter\ndesigned to record it durably, in the write that already holds the lock, sits unused.\n\n## Direction\n\nWrite the reason into the close STATUS event, mirroring `close_class` — which is the exact\nsame shape of datum (a present-only, close-only string) and already has a complete, proven\npath through the system:\n\n| step | `close_class` (precedent) | `force_close_reason` (this change) |\n|---|---|---|\n| event write | `txn.py:287-288`, present-only so an absent value omits the key and stays byte-identical to a pre-feature event | same guard, same place |\n| reducer fold | `_fold_close_class`, called at BOTH `*->closed` edges (`reducer/_processors.py:203`, `:274` fork-winner, `:301` plain) | a sibling fold at the same two sites |\n| reduced state | declared in `schemas/ticket_state.schema.json:187` | declared alongside it |\n\nPresent-only matters for the same reason it did for `close_class`: a close with no `--force`\nomits the key entirely, so ordinary close events are unchanged byte-for-byte and an older\nreader that does not know the field is unaffected.\n\n**Alternative considered and rejected: delete the parameter as dead.** That is smaller and\nwould also satisfy \"no caller silently passes a discarded value\". It is rejected because the\ncaller has a genuinely useful value to record, the operator supplied it expressly to explain a\ngate bypass, and the existing audit-comment path is unreliable under exactly the conditions\nthat produce force-closes. Deleting would lock in the weaker of the two records.\n\nScope note: this does NOT add wolverine's `completion_expectation` enum, its derivation table,\nor any computation of gate state. This is one present-only string moved from a discarded\nparameter into the event that already carries `close_class`. The two tickets touch the same\nevent and should be sequenced, not merged.\n\n## Acceptance criteria\n\n- [ ] A `--force=<reason>` close records that reason on the close STATUS event, written in the\n      SAME locked write as the close with no additional lock acquisition — verified by a test\n      reading the event\n- [ ] The reason is readable from reduced state by a later reader holding no lock — verified by\n      a test\n- [ ] A close WITHOUT `--force` omits the key entirely, leaving the event byte-identical to the\n      pre-change shape — verified by a test asserting absence\n- [ ] No caller passes a value that `transition_core` discards — verified by a test that would\n      fail if the parameter were reintroduced as unused","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/txn.py","reason":"write force_close_reason into the close STATUS event, present-only, mirroring close_class"},{"path":"src/rebar/reducer/_processors.py","reason":"fold the reason at both *->closed edges alongside _fold_close_class"},{"path":"src/rebar/schemas/ticket_state.schema.json","reason":"declare the reason in reduced state"},{"path":"tests/unit/test_transition_close.py","reason":"tests for the durable reason, reduced-state read, and present-only absence"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","2fcb-30fb-fffb-4a9c"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"8820dce7-bb94-4301-b307-14ae9d31423c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"055d-f176-8fcb-4ffe","ticket_type":"bug","title":"force_close_reason is accepted by transition_core and discarded","verify_commands":[]},"source_event_uuids":["e89ecd4c-4f93-46ae-a86f-2572bab8f11c","84b98489-f8a6-4070-bb8b-b79c5e1505ff","32c68186-81b6-4c4b-9c63-84fccf671b3b","f3126692-a918-4f09-9207-ea7a120eb9ab","12261462-2d38-4d3a-a7da-d401628805d6","8820dce7-bb94-4301-b307-14ae9d31423c","abf6c4b8-51a5-49bc-8365-4bfed26bc6d0","63c5c649-0945-4adb-ae91-d8e77103e455","83ae40d9-ef73-483b-ad90-e4a977afdd10"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786568320222724186,"uuid":"dd387fc5-7541-44b0-a770-62e0635dbfad"}