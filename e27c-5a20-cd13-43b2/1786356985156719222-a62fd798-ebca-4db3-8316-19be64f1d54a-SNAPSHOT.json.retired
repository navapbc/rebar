028 §1)\n  absent_in_window_unprobed: local=3f04-f8a2-1009-4f34 jira_key=REB-423 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=3f42-81a9-6f87-4e13 jira_key=REB-1311 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4001-185c-1a51-44ee jira_key=REB-1060 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4014-d34b-d312-45d3 jira_key=REB-101 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=401a-0802-8469-4b93 jira_key=REB-1068 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=406f-7a43-fb96-47a9 jira_key=REB-872 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=40b8-b066-efe9-4165 jira_key=REB-102 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4158-eb34-870d-481c jira_key=REB-103 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4168-c28e-6505-406d jira_key=REB-104 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=416d-c02a-5be4-46ad jira_key=REB-881 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4214-ac28-d19c-41b9 jira_key=REB-957 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=424c-c66a-a5c0-49ab jira_key=REB-849 (absent from windowed snapshot; NOT a deletion signal — ADR 0028 §1)\n  absent_in_window_unprobed: local=4253-ced1-6c1d-47f4 jira_key=REB-105 (absent from … [truncated by reconciler]","jira_comment_id":"962493","timestamp":1786337483750150837}],"created_at":1786095601138647001,"creation_channel":"cli","deps":[{"link_uuid":"007f5c2e-1892-4a66-a25f-724c01c77bfe","relation":"depends_on","target_id":"4752-3afb-e8bd-448a"},{"link_uuid":"69ad170c-6a81-43ab-a3c3-067fa032dbdb","relation":"relates_to","target_id":"28f9-1bab-6eb2-4127"},{"link_uuid":"4769a11b-76b9-4f36-873b-d9d3640fe169","relation":"relates_to","target_id":"d9c1-85d0-9af4-43de"},{"link_uuid":"1a4aba49-ef65-4609-bd2c-d9649b3b852d","relation":"relates_to","target_id":"86de-92a5-b200-4f31"},{"link_uuid":"69875b55-06ba-499c-8b3e-4bc13a38e38e","relation":"relates_to","target_id":"c46a-2487-e27a-4637"},{"link_uuid":"2155a1a9-44f9-4378-8d59-86da79629473","relation":"relates_to","target_id":"362e-f302-2dd6-43dc"}],"description":"Add primary `bridge`-noun spellings for the three surviving bridge verbs, migrate every\nenumerated in-tree consumer, and preserve the old spellings as compatibility entrypoints for\nworkflows and environments that have not migrated yet:\n\n* `rebar bridge-fsck`   -> `rebar bridge fsck`\n* `rebar bridge-probe`  -> `rebar bridge check-access`\n* `rebar jira-onboard`  -> `rebar bridge setup`\n\nCarved out of `4752-3afb-e8bd-448a`, which now owns only the `bridge` verb-group registration.\n`depends_on 4752` because the noun and its dispatch must exist before verbs can attach to it.\n\n## These are RENAMES, not new features — this is what the reviews caught\n\n`check-access` is NOT new work. `bridge-probe` already ships the identical create/label/search/\ndelete Jira round-trip (`src/rebar/_engine/jira-capability-probe.py`, launched via\n`_cli/__init__.py:163`'s `_bridge_probe`), so this is a rename plus consumer migration, not an\nimplementation. `bridge setup` is likewise the EXISTING `jira-onboard` wizard renamed\n(`src/rebar/_cli/_jira_onboard.py`), which already implements persist-config-then-probe. Scoping\nthese as renames is the whole point of the split: the work is enumerating and migrating consumers,\nand each rename's consumer set is listed below rather than left implicit.\n\n## Why `check-access` stays its own verb rather than becoming a flag (carried from `4752`)\n\nAll three narrowing-flag precedents — `flux check --pre`, `dbt debug --connection`,\n`gh auth status` — are READ-ONLY, and none mutates the remote. The precedent therefore does not\ntransfer to an operation that CREATES AND DELETES A REAL JIRA ISSUE. `fsck` audits your records;\n`check-access` proves your access. They are different questions with different blast radii.\n\n`setup` calls `check-access` as its final validation step (this is already how `jira-onboard`\nends, via `_jira_onboard.py:196-200` invoking `_bridge_probe` with the just-persisted settings\ninjected as an env overlay; the rename must preserve that overlay behaviour and the\n`--no-validate` escape hatch).\n\n## Enumerated consumers — `bridge-fsck` -> `bridge fsck`\n\nCLI: `src/rebar/_cli/__init__.py` (`_BRIDGE` frozenset ~121, the `_dispatch_bridge` arm at ~255-264 calling `bridge_fsck.main(rest)`),\n`src/rebar/_cli/help/bridge-fsck.txt`, `src/rebar/_cli/help/overview.txt`.\nSchema: `src/rebar/schemas/bridge_fsck.schema.json` — BOTH the `$id`\n(`.../schemas/bridge_fsck.schema.json`) and the `description`, which names\n`rebar bridge-fsck --output json`.\nScripts/CI: `scripts/canary_bridge.py:375` (`runner([\"rebar\",\"bridge-fsck\",\"--output\",\"json\"])`)\nplus its ticket-body strings at 412/427/429/460/494; `.github/workflows/reconcile-bridge-canary.yml`\n(header comment :8, step comment :186); `scripts/probe_rebar.py:505,515,516`.\nTests: `tests/unit/test_canary_bridge_wiring.py:78` (asserts the literal `\"rebar bridge-fsck\"`),\n`tests/scripts/test_canary_bridge.py` (FakeRunner keys `(\"rebar\",\"bridge-fsck\")` and the drift\ntitle assertion at ~510), `tests/scripts/test_canary_bridge_heldout.py`,\n`tests/scripts/bridge/test_bridge_fsck.py`,\n`tests/scripts/bridge/test_bridge_fsck_binding_drift.py`,\n`tests/scripts/bridge/test_bridge_fsck_keyset_prev_heldout.py`,\n`tests/unit/rebar_reconciler/conftest.py`,\n`tests/interfaces/contracts/test_schema_outputs.py`,\n`tests/interfaces/contracts/test_schema_coverage.py`,\n`tests/interfaces/facades/test_mcp_output_schema_coverage.py`.\nDocs: `docs/cli-reference.md`, `docs/jira-sync-setup.md`, `docs/exit-codes.md:78`,\n`docs/output-schemas.md:50`, `docs/mcp-reference.md`, `docs/architecture.md`,\n`docs/event-schema.md`, `docs/maintenance-audit-runbook.md`, `docs/adr/0027-reconciler-binding-lifecycle.md`.\nOUT OF SCOPE: the LIBRARY/MCP `bridge_fsck` symbol names (`src/rebar/__init__.py`,\n`src/rebar/_lib_ops.py:84`, `src/rebar/_mcp_reads.py`, `src/rebar/_mcp_models.py`,\n`src/rebar/types.py`) belong to sibling `f789-3f9d-8b35-4e0d`, which owns the library and MCP\nbridge surface. This ticket renames the CLI verb and updates the shared JSON-schema text only.\n\n## Enumerated consumers — `bridge-probe` -> `bridge check-access`\n\nCLI: `src/rebar/_cli/__init__.py:163` (`_bridge_probe` launcher + its docstring) and the dispatch\narm at `393-394`; `src/rebar/_cli/help/bridge-probe.txt` (renamed);\n`src/rebar/_cli/help/overview.txt:31`.\nImplementation docstring: `src/rebar/_engine/jira-capability-probe.py:7` (\"Run it as a preflight\nbefore relying on Jira sync (`rebar bridge-probe`)\").\nIn-tree caller: `src/rebar/_cli/_jira_onboard.py:14,94,102,182,186,191,196-200` — the wizard's\nhelp text, its `--no-validate` help string, its two user-facing \"run `rebar bridge-probe`\" hints,\nand its actual `_bridge_probe(...)` call.\nTests: `tests/unit/test_jira_onboard.py` — asserts the literal string `\"bridge-probe\"` in wizard\noutput (239, 266, 274) AND monkeypatches the symbol BY NAME at 251, 268, 280\n(`monkeypatch.setattr(\"rebar._cli._bridge_probe\", ...)`), so a symbol rename must be grepped for as\na string, not just resolved by the LSP;\n`tests/interfaces/contracts/test_help_overview_coverage.py:59` (verb inventory).\nDocs: `docs/cli-reference.md:30,33`, `docs/jira-sync-setup.md:52,55,59-62,69,257`,\n`docs/releasing.md:430,433` (the release checklist runs the six-step round-trip).\n\n## Enumerated consumers — `jira-onboard` -> `bridge setup`\n\nCLI: `src/rebar/_cli/__init__.py:66` (the intercept-verb list) and the intercept at `584-589`;\n`src/rebar/_cli/_jira_onboard.py:1,87-90` (module docstring, `jira_onboard()` entry, and its\nargparse `prog=\"rebar jira-onboard\"` — the `prog` string is user-facing in `--help`).\nNOTE the established precedent recorded when the wizard shipped (`b5db-7433`): it is an INTERCEPT,\nso argparse owns `--help`, and there is intentionally NO pinned `help/jira-onboard.txt` and no\n`overview.txt` entry. Moving it under the `bridge` noun must either preserve that intercept shape\nor wire overview + routing + a `.txt` together — adding a `.txt` alone BREAKS\n`test_help_overview_coverage`.\nReference generator: `scripts/gen_cli_reference.py:62` (the `\"jira-onboard\"` entry) and its pin\n`tests/unit/test_gen_cli_reference.py:39`.\nTests: `tests/unit/test_jira_onboard.py` drives `main([\"jira-onboard\", ...])` at 183, 203, 212,\n228, 236, 252, 270, 281, 294, 305 — every one migrates.\nDocs: `docs/cli-reference.md:479`, `docs/jira-sync-setup.md:51,58,59,61`, `docs/config.md:259`\n(the https-only note), `docs/adr/0070-jira-onboard-config-write.md` (its title and body name the\nverb; the ADR is amended with a rename note rather than rewritten, since ADRs record history).\n\n\n## Compatibility and migration contract\n\nThis change is additive at the command boundary. The new noun-based spellings become canonical in\nhelp, generated references, workflows, scripts, runbooks, and examples, but the three old spellings\nremain executable compatibility entrypoints. Each old spelling delegates to the exact same parser\nand implementation path as its new spelling; it does not fork behavior, state, exit policy, or\noutput schema. Behavioral parity tests exercise both spellings for success, representative failure,\noptions/arguments, output, and exit status. Any future removal requires a separately tracked\ndeprecation decision and cannot occur in this epic.\n\n## Acceptance Criteria\n\n- [ ] `rebar bridge fsck`, `rebar bridge check-access` and `rebar bridge setup` are the primary\n      documented spellings and all dispatch; the old spellings `bridge-fsck`, `bridge-probe`, and\n      `jira-onboard` remain functional compatibility entrypoints routed through the identical\n      implementations so existing workflows and environments do not break. Top-level help may hide\n      the compatibility spellings, but invoking them must continue to work.\n- [ ] Each rename is proven to be BEHAVIOUR-PRESERVING, not a reimplementation: `bridge\n      check-access` performs the same create/label/search/delete Jira round-trip `bridge-probe` did\n      (same `jira-capability-probe.py` code path), and `bridge setup` runs the same\n      detect/prompt/persist/validate wizard, with `--no-validate`, `--reset`, `--yes`,\n      `--url/--user/--project` all still accepted\n- [ ] `bridge setup` calls `bridge check-access` as its FINAL validation step, still injecting the\n      just-persisted settings as an env overlay, and still skipping the check when\n      `JIRA_API_TOKEN` is unset (exit 0) or `--no-validate` is passed\n- [ ] `check-access` ships as its own primary verb — there is no `bridge fsck --check-access` flag\n      spelling. The legacy `bridge-probe` compatibility entrypoint routes to the same operation;\n      the rationale (all three narrowing-flag precedents are read-only, while this creates and\n      deletes a real Jira issue) is recorded in the shipped help text or docs.\n- [ ] `src/rebar/schemas/bridge_fsck.schema.json` has BOTH its `$id` and its `description` updated\n      to the new verb name, and the schema-coverage / schema-output / MCP-schema contract tests pass\n      against the new registration\n- [ ] Every consumer enumerated above is migrated in the same change. In particular the STRING-named\n      sites are covered: `tests/unit/test_jira_onboard.py`'s\n      `monkeypatch.setattr(\"rebar._cli._bridge_probe\", ...)` (3 sites) and\n      `tests/unit/test_canary_bridge_wiring.py:78`'s literal `\"rebar bridge-fsck\"` — a symbol-graph\n      search alone misses these, so the change is validated with a plain grep for each old verb name\n- [ ] A test greps current docs, workflow invocations, and primary help for stale uses of\n      `bridge-fsck`, `bridge-probe`, or `jira-onboard`, while explicitly allowing the\n      compatibility registrations, parity tests, release/migration notes, CHANGELOG,\n      `docs/archive`, and ADR history.\n- [ ] `scripts/canary_bridge.py` and `.github/workflows/reconcile-bridge-canary.yml` invoke the new\n      verb, and the canary still classifies binding drift identically (exit 1 with valid JSON is\n      still DRIFT DATA, not an error)\n- [ ] `scripts/gen_cli_reference.py` + `tests/unit/test_gen_cli_reference.py` are updated together\n      and the regenerated `docs/cli-reference.md` matches\n- [ ] The library and MCP `bridge_fsck` entrypoints are UNCHANGED by this ticket and still callable\n      at its boundary; their rename belongs to `f789-3f9d-8b35-4e0d`\n- [ ] Release notes record all three old -> new mappings, identify the new spellings as primary,\n      and document that the old spellings remain supported compatibility entrypoints for continuity.\n\n## Binding review remediation\n\nThe following decisions and inventory corrections supersede any earlier ambiguous or stale\nreferences in this plan.\n\n### `bridge setup` dispatch shape\n\n`bridge setup` is a real child in the `rebar bridge` argparse group, but it is a pass-through child:\n`src/rebar/_cli/_bridge_commands.py` registers `setup` with `add_help=False` and one\n`argparse.REMAINDER` argument, then delegates those remaining arguments to\n`_jira_onboard.jira_onboard`. The wizard therefore continues to own all of its options, validation,\ninteractive flow, and `--help`; the bridge parser owns only noun-child discovery. `bridge` group\nhelp and `help/bridge.txt` list setup, but no standalone `help/bridge-setup.txt` is created and the\ntop-level overview continues to list the bridge group rather than every child. The legacy\ntop-level `jira-onboard` intercept remains and delegates to the same wizard. The\n`test_help_overview_coverage` contract is updated/preserved for this exact shape.\n\n### Correct ADR and consumer inventory\n\nThe Jira onboarding ADR was renumbered under the repository convention. Amend\n`docs/adr/0070-jira-onboard-config-write.md`; `docs/adr/0007-review-bot-receiver.md` is unrelated\nand must not be edited. This is an amendment, not a new ADR, so the existing number marker and\ngenerated index remain authoritative and their checks must pass.\n\nThe string-reference sweep adds these live sites to the migration/allowlist inventory:\n\n- `src/rebar/_engine_support/bridge_fsck.py` docstrings/comments naming `rebar bridge-fsck`;\n- `src/rebar/_engine_support/output.py:22` report-profile docstring naming `bridge-fsck`;\n- `src/rebar/_cli/__init__.py` `_bridge_probe` docstring naming `rebar jira-onboard`;\n- `docs/user-guide.md` compatibility note naming all three old spellings;\n- `docs/exit-codes.md` rows for `bridge-probe` and `jira-onboard` as well as `bridge-fsck`;\n- `.github/workflows/_build-and-test.yml` and `.github/workflows/test.yml` comments naming\n  `bridge-probe`.\n\nPrimary help, examples, scripts, workflow commands/comments, implementation docstrings, and current\nreference docs migrate to `bridge fsck`, `bridge check-access`, and `bridge setup`. Compatibility\nregistrations, parity tests, release/migration notes, CHANGELOG, `docs/archive`, immutable\n`docs/experiments` review corpora, and historical ADR cross-references may retain the old spellings\nonly through explicit categorized allowlist entries.\nThe current `docs/user-guide.md` compatibility sentence is rewritten to present the noun spellings\nas primary and the old spellings as retained compatibility entrypoints.\n\n### Additional acceptance criteria\n\n- [ ] `bridge setup --help` and all setup arguments are owned by the unchanged onboarding parser\n      through the pass-through subparser; no double parse and no orphan help file exists.\n- [ ] The corrected ADR 0070 is amended and ADR marker/index checks pass; ADR 0007 is untouched.\n- [ ] The added source/doc/workflow string sites are migrated or explicitly categorized as\n      compatibility/history, and a repository-wide stale-vocabulary test proves no uncategorized\n      live old-spelling reference remains.\n\n### Explicit nested dispatch for `fsck` and `check-access`\n\n`src/rebar/_cli/_bridge_commands.py` registers `fsck` and `check-access` as children of the same required bridge subparser group and includes both in its metavar/group help. Their dispatch arms pass the untouched remainder to the existing implementations: `fsck` calls `bridge_fsck.main(rest)` with the same auto-init policy as legacy `bridge-fsck`, and `check-access` calls the existing `_bridge_probe(rest)` launcher. Neither child may fall through to `launch_reconciler`; that launcher remains limited to preview/sync. The legacy top-level `bridge-fsck` and `bridge-probe` arms delegate to those same call paths. Parity tests assert both names preserve help, options, stdout/stderr, and exit status.\n\n### Entrypoint-specific setup help\n\n`_jira_onboard.jira_onboard` accepts an entrypoint-specific `prog` value while retaining `rebar jira-onboard` as its default. The canonical `bridge setup` dispatch passes `prog=\"rebar bridge setup\"`; the legacy top-level intercept uses the default. Both entrypoints therefore share the exact same parser and wizard implementation while each `--help` usage line names the command the operator invoked. Parity tests assert both usage lines and all existing options.\n\n- [ ] `rebar bridge setup --help` starts its usage with `rebar bridge setup`, while `rebar jira-onboard --help` remains functional and starts its usage with `rebar jira-onboard`; both expose the same option set and wizard behavior.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":".github/workflows/_build-and-test.yml","reason":"migrate live bridge-probe comments or categorize compatibility-only text"},{"path":".github/workflows/reconcile-bridge-canary.yml","reason":"the canary runs and documents bridge-fsck (8, 186)"},{"path":".github/workflows/test.yml","reason":"migrate live bridge-probe comments or categorize compatibility-only text"},{"path":"CHANGELOG.md","reason":"announce canonical spellings and explicitly retained compatibility commands"},{"path":"docs/adr/0027-reconciler-binding-lifecycle.md","reason":"names bridge-fsck as the offline classifier arm; amended with a rename note"},{"path":"docs/adr/0070-jira-onboard-config-write.md","reason":"amend the correctly renumbered onboarding ADR with the compatibility-preserving bridge setup name; marker/index remain unchanged"},{"path":"docs/architecture.md","reason":"names bridge-fsck in the bridge subsystem description"},{"path":"docs/cli-reference.md","reason":"the bridge-probe section (30, 33) and the jira-onboard row (479) and the bridge-fsck entry are regenerated under the new names"},{"path":"docs/config.md","reason":"the https-only wizard note names jira-onboard (259)"},{"path":"docs/event-schema.md","reason":"names bridge-fsck alongside the bridge event semantics"},{"path":"docs/exit-codes.md","reason":"the bridge-fsck row (78) is re-keyed"},{"path":"docs/jira-sync-setup.md","reason":"the wizard walkthrough (51, 58-61) and the bridge-probe references (54, 68, 242) move to the new verbs"},{"path":"docs/maintenance-audit-runbook.md","reason":"the operator runbook invokes bridge-fsck"},{"path":"docs/mcp-reference.md","reason":"names bridge-fsck in the tool inventory"},{"path":"docs/output-schemas.md","reason":"the bridge-fsck -> bridge_fsck schema row (50) is re-keyed"},{"path":"docs/release-notes.md","reason":"record the three old-to-new mappings and continuity guarantee"},{"path":"docs/releasing.md","reason":"the release checklist runs `rebar bridge-probe` (430, 433)"},{"path":"docs/user-guide.md","reason":"make noun spellings primary and document all retained old-vocabulary compatibility entrypoints"},{"path":"scripts/canary_bridge.py","reason":"invokes `rebar bridge-fsck --output json` (412) and names it in five ticket-body strings (449, 464, 466, 497, 531)"},{"path":"scripts/gen_cli_reference.py","reason":"the \"jira-onboard\" entry (62) becomes the bridge setup entry"},{"path":"scripts/probe_rebar.py","reason":"smoke probe runs bridge-fsck -o json and asserts its shape (505, 515, 516)"},{"path":"src/rebar/_cli/__init__.py","reason":"re-key the _BRIDGE set (~121) and the bridge-fsck arm (~309) to `bridge fsck`; rename the _bridge_probe launcher (163) and its arm (393-394) to check-access; move the jira-onboard intercept (66, 562-567) under `bridge setup`"},{"path":"src/rebar/_cli/_bridge_commands.py","reason":"register canonical fsck/check-access/setup children; setup is add_help=False argparse.REMAINDER pass-through while old top-level routes remain"},{"path":"src/rebar/_cli/_jira_onboard.py","reason":"the wizard IS `bridge setup`: module docstring (1), entry (87-88), argparse prog=\"rebar jira-onboard\" (90), the bridge-probe help/hint strings (14, 94, 102, 182, 186, 191, 196) and the _bridge_probe call (197-200)"},{"path":"src/rebar/_cli/help/bridge-fsck.txt","reason":"help page renamed to the new verb spelling"},{"path":"src/rebar/_cli/help/bridge-probe.txt","reason":"help page renamed to check-access"},{"path":"src/rebar/_cli/help/bridge.txt","reason":"list the canonical nested verbs including setup without creating an orphan bridge-setup help file"},{"path":"src/rebar/_cli/help/overview.txt","reason":"the bridge-fsck and bridge-probe lines (31) become the bridge verb group"},{"path":"src/rebar/_engine/jira-capability-probe.py","reason":"docstring names `rebar bridge-probe` (7); the round-trip implementation is unchanged, only the verb it is reached by"},{"path":"src/rebar/_engine_support/bridge_fsck.py","reason":"migrate live bridge-fsck docstrings/comments to canonical bridge fsck vocabulary"},{"path":"src/rebar/schemas/bridge_fsck.schema.json","reason":"both the $id and the description (which names `rebar bridge-fsck --output json`) are updated to the new verb"},{"path":"tests/interfaces/contracts/test_help_overview_coverage.py","reason":"verb inventory includes bridge-probe (59) and must match the new group"},{"path":"tests/interfaces/contracts/test_schema_coverage.py","reason":"maps verbs to schemas; the bridge-fsck key changes"},{"path":"tests/interfaces/contracts/test_schema_outputs.py","reason":"binds the emitted bridge_fsck JSON to its schema registration"},{"path":"tests/interfaces/facades/test_mcp_output_schema_coverage.py","reason":"asserts the MCP surface covers the bridge_fsck schema whose $id this ticket updates"},{"path":"tests/scripts/bridge/test_bridge_fsck.py","reason":"primary bridge-fsck cover; migrates to the new verb spelling"},{"path":"tests/scripts/bridge/test_bridge_fsck_binding_drift.py","reason":"binding-drift arm cover; migrates with the rename"},{"path":"tests/scripts/bridge/test_bridge_fsck_keyset_prev_heldout.py","reason":"held-out keyset cover; migrates with the rename"},{"path":"tests/scripts/test_canary_bridge.py","reason":"FakeRunner keys on (\"rebar\",\"bridge-fsck\") and asserts the drift ticket title (~510)"},{"path":"tests/scripts/test_canary_bridge_heldout.py","reason":"held-out canary cover naming bridge-fsck"},{"path":"tests/unit/rebar_reconciler/conftest.py","reason":"names bridge-fsck in shared reconciler fixtures"},{"path":"tests/unit/test_canary_bridge_wiring.py","reason":"asserts the literal string \"rebar bridge-fsck\" (78) — a string-named site a symbol search misses"},{"path":"tests/unit/test_gen_cli_reference.py","reason":"pins the generator's verb list including jira-onboard (39)"},{"path":"tests/unit/test_jira_onboard.py","reason":"drives main([\"jira-onboard\", ...]) at 10 sites, asserts the literal \"bridge-probe\" (239, 266, 274), and monkeypatches \"rebar._cli._bridge_probe\" BY NAME (251, 268, 280)"},{"path":"src/rebar/_engine_support/output.py","reason":"migrate the live report-profile docstring from bridge-fsck to canonical bridge fsck vocabulary"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","4752-3afb-e8bd-448a"],["parent","2f79-2b32-28c5-4eb3"],["relates_to","28f9-1bab-6eb2-4127"],["relates_to","362e-f302-2dd6-43dc"],["relates_to","86de-92a5-b200-4f31"],["relates_to","c46a-2487-e27a-4637"],["relates_to","d9c1-85d0-9af4-43de"]],"no_file_impact_reason":"","parent_id":"2f79-2b32-28c5-4eb3","parent_status_uuid":"e156cfd4-2cd9-4828-94e6-a6c9208f0d2d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["bridge","ux"],"ticket_id":"e27c-5a20-cd13-43b2","ticket_type":"story","title":"Rename the three surviving bridge verbs onto the bridge noun","verify_commands":[]},"source_event_uuids":["0fcf1412-b063-4114-b476-8bc467077cfd","007f5c2e-1892-4a66-a25f-724c01c77bfe","c9e34ad3-a685-442c-9469-04d5f6c070d7","7674ff79-0a1a-4b41-8928-a954aec53573","7a209767-8c2f-416f-adb0-ef1d927001f3","573e2abc-4c61-4bf1-bce8-20ee3e98c65a","2c2ca7cb-7bf7-4843-842f-89feaf34319d","f53b24c4-5850-453e-946a-58d8a694abc1","375cf13f-a04b-482d-b5be-73fae805775a","301deb80-230b-45af-8db6-6dc70a174acb","977e1d17-42a3-4dec-b564-08b67099d947","42320836-7f59-46a2-ab18-2e5d7ada8344","1d293784-83ab-4a72-8a6f-c003c5d15e16","d9ae718b-bb48-4a06-8f54-0406e7cb8a48","beb907cc-bb57-4592-8947-a913fce65a83","4e936f9d-baaf-4ef6-89df-6d1d917ae05d","9ff963c3-52bc-4d87-a84b-b2ecde46f488","6a751584-23b4-42b3-b24a-a4082b1c0d17","f5a31fe0-ce16-411d-909c-3093ea7d4191","e156cfd4-2cd9-4828-94e6-a6c9208f0d2d","e8db59f1-2c02-45ea-89cc-2c03f4f1f3e0","69ad170c-6a81-43ab-a3c3-067fa032dbdb","4769a11b-76b9-4f36-873b-d9d3640fe169","11130c58-024a-4c2d-a5dc-ca0f514e684f","1a4aba49-ef65-4609-bd2c-d9649b3b852d","2aad553c-0323-4fee-8613-7449e4b33391","bc0bc263-dd86-47e3-9c90-ac9d0fd90b86","69875b55-06ba-499c-8b3e-4bc13a38e38e","f3be4daa-c8e1-4d9a-a624-eecb33b33fe7","2155a1a9-44f9-4378-8d59-86da79629473"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786356985156719222,"uuid":"a62fd798-ebca-4db3-8316-19be64f1d54a"}