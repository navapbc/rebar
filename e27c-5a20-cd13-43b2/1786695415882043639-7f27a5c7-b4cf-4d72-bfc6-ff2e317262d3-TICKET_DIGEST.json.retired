{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b5028ddca921534a772828551ff3c88e77814ba47ffb43912ce94e72497c8427","digest":{"component_or_area":"CLI command-line interface","key_entities":["rebar bridge fsck","rebar bridge check-access","rebar bridge setup","bridge-fsck","bridge-probe","jira-onboard","src/rebar/_cli/__init__.py","src/rebar/_cli/_bridge_commands.py","src/rebar/_cli/_jira_onboard.py","src/rebar/_engine/jira-capability-probe.py","src/rebar/schemas/bridge_fsck.schema.json","docs/cli-reference.md","scripts/canary_bridge.py"],"problem_keywords":["CLI verb rename","bridge commands","jira configuration","backward compatibility","command consolidation"],"propositions":["Three existing CLI verbs are being renamed to nest under a bridge noun while retaining old spellings as compatibility entrypoints: bridge-fsck becomes `bridge fsck`, bridge-probe becomes `bridge check-access`, and jira-onboard becomes `bridge setup`","`bridge check-access` performs the same Jira create/label/search/delete round-trip as the legacy `bridge-probe` without behavioral changes","`bridge setup` invokes the same onboarding wizard as `jira-onboard` and calls `bridge check-access` as a final validation step, preserving the `--no-validate` flag behavior","All three old verb spellings remain executable as compatibility entrypoints routed through identical implementations with preserved exit codes, output schemas, and parser options","Consumer migrations span CLI dispatch routing, help text, JSON schemas (both `$id` and `description` fields), test fixtures, scripts, CI workflows, and documentation across all enumerated sites"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1786695415882043639,"uuid":"7f27a5c7-b4cf-4d72-bfc6-ff2e317262d3"}