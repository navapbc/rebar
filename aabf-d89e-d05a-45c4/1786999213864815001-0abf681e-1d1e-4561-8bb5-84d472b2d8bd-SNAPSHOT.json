mit_sha":"dca048dec0ecb7f301f76a1cc249c5cd93f450b1","position":"1786995665422604001-fe6e99fc-878a-4b18-b85f-4eb70c82144c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"34dc7a47854e48ed8c9bed8661af1ea0f41203292a4bbd4ad2b062a65b219ff5","event_uuid":"f3dd81a1-dc39-46c4-aa87-d7920b38365d","position":{"commit_sha":"c01535a2effd086f3e8c6f59b78f859d3d02d87c","position":"1786995677104078001-f3dd81a1-dc39-46c4-aa87-d7920b38365d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2f4d717b4180e52589df0e87cbd0cd3fe375b1dccba9b76ea94d33ec9444e2aa","event_uuid":"25df45bc-0a6c-4483-b059-6a0e58dcc9bd","position":{"commit_sha":"6c90217e529d382cf1ca3c761f2c8489a7529392","position":"1786995749743124001-25df45bc-0a6c-4483-b059-6a0e58dcc9bd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a88cb0191a4dfac8fb0e26846e1d155705693d74a5ba5acd5da6afec3e651697","event_uuid":"cc99d96a-11a0-4330-a4b9-3b9ce853f6d4","position":{"commit_sha":"25ca453116800a7f310468e5bbcbee0dc11c34ab","position":"1786996146224729001-cc99d96a-11a0-4330-a4b9-3b9ce853f6d4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786995188595091001,"creation_channel":"cli","deps":[{"link_uuid":"ec7b5fa7-aa72-452b-aec5-f69ce83544b4","relation":"depends_on","target_id":"6e3b-3d1a-0ff7-44b6"},{"link_uuid":"a22efcac-9f4a-4fe2-a98f-0af7558c8710","relation":"depends_on","target_id":"5851-51d7-fda8-4966"},{"link_uuid":"30bbe0e3-7130-4eb6-83f4-b1e1e8f325f3","relation":"depends_on","target_id":"6f14-21a7-d806-44b2"}],"description":"## Context / Problem\nS1-S6 provide the new composition paths, but RP-04 is not complete while legacy ambient reads can return or future code can bypass the central seam. The recovered design explicitly requires an AST ownership guard, generated operator documentation, hosted parity/delta canaries, and contract-phase removal. The existing `scripts/check_config_reads.py` proves each schema field is consumed; it does not prove only approved owners consume configuration.\n\n## Outcome\nEnforce centralized ownership with a separate deterministic AST gate, wire it into the portable local gate and CI, generate configuration/security lifecycle documentation from the authoritative registry, run final canaries, and remove legacy facades only after all proof passes.\n\n## Plan\n1. Add `scripts/check_config_ownership.py` and an explicit registry of approved composition roots/provider boundaries. Derive configurable environment spellings and provider credential names from the authoritative config/adapter registries, and fail when a newly declared name lacks one owner. Reject direct/aliased `load_config`, `os.getenv`, `os.environ.get`, `os.environ[...]`, literal-`getattr` equivalents, backend property reload, credential reads, and configurable adapter defaults below those seams. Test-only controls and protocol constants require exact path+symbol+rationale entries, not broad path globs.\n2. Add synthetic red-proof fixtures for direct and import/local-alias call forms, every prohibited environment access form, and self-tests that deliberately insert a new bypass or registry name without an owner. The gate reports path, symbol, access kind, and owning seam. Legacy migration exceptions are exact, shrink-only, and empty before close. Document that this deterministic change detector covers conventional static forms rather than claiming to be a security sandbox; S1-S6 behavioral oracles remain authoritative.\n3. Wire the guard through `make lint` (portable/no-CI path) and the build workflow; extend CI parity tests so the workflow cannot silently omit it. Keep `check_config_reads.py` as the opposite-direction field-consumption gate.\n4. Generate the config precedence/source/lifecycle reference in `docs/config.md` and a new indexed `docs/security.md` from schema plus ownership/secret-name registries; update `docs/README.md` and `docs/architecture.md` navigation. Drift checks cover MCP/CLI exposure, restart/redeploy rotation, native refresh, observability exception, subprocess limitations, and explicit behavior deltas.\n5. Run focused suites and bounded Anthropic/Bedrock, AWS review-bot/op-cert, reconciler check/dry-run/bounded-live canaries. Compare redacted snapshot fingerprints and provider-neutral outcomes; record each approved delta. Then delete legacy ambient/per-job facades, migration switches, and exception entries.\n\n## Testing (RED -> GREEN)\n- Structural change-detector tests feed synthetic modules for direct/import/local aliases, attribute/subscript/literal-`getattr` environment access, backend property reload, newly registered credential/config names, configurable duplicate defaults, broad/glob exceptions, missing rationales, and expired migration exceptions; each must fail with the expected diagnostic.\n- Real-tree held-out tests assert the ownership registry maps each approved read to one seam, the legacy exception set is empty, generated docs are current, and local/CI invocation exists.\n- Behavioral regression suites from S1-S6 remain the correctness oracle; the AST gate supplements rather than substitutes for them.\n- [operator-attested] Live evidence includes run/change ids, timestamps, selected provider/auth-source kind, retry/cache counters where applicable, redacted fingerprint/outcome, and rollback decision. No credential value/path is recorded.\n\n## Compatibility / rollback\nDo not remove a legacy facade until its focused suite and bounded live path pass. Before removal, rollback selects the facade. At contract phase, retain only the S1 snapshot-envelope compatibility floor; rollback below it is unsupported and documented. Stored ticket/event/bridge/binding formats remain unchanged.\n\n## Acceptance Criteria\n- [ ] Every synthetic prohibited access/alias/default/exception and unowned-new-registry-name fixture fails the ownership gate with path, symbol, access kind, and expected owning seam; clean approved fixtures pass.\n- [ ] `make lint` and CI execute both ownership-direction and existing field-consumption gates, and parity tests fail if either invocation disappears.\n- [ ] The real tree has no direct ambient config/credential read, backend reload, or configurable adapter default below approved seams; every declared config/credential name has one owner, the legacy exception set is empty, and no exception uses a path glob.\n- [ ] Generated config/security/operator docs are byte-current with schema/ownership registries and cover every lifecycle, precedence, restart, observability, subprocess, and behavior-delta topic named in the epic.\n- [ ] All S1-S6 behavioral suites pass after legacy removal; structural gates remain change detectors, not substitutes for those observable oracles.\n- [ ] [operator-attested] Bounded provider, AWS review-bot/op-cert, and reconciler check/dry-run/live canaries pass with required redacted evidence and no unauthorized fallback/leakage.\n- [ ] Legacy facades, switches, per-job SSM path, ambient reloads, and migration exceptions are removed only after their proof passes; documented rollback retains the snapshot-envelope compatibility floor.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"scripts/check_config_ownership.py","reason":"New deterministic ownership-direction AST guard with exact seam registry and diagnostics."},{"path":"scripts/check_config_reads.py","reason":"Preserve and document the opposite-direction field-consumption gate."},{"path":"tests/scripts/test_check_config_ownership.py","reason":"Synthetic direct/alias/environment/default/exception detection tests."},{"path":"tests/scripts/test_check_config_ownership_heldout.py","reason":"Real-tree zero-legacy-exception and approved-owner oracle."},{"path":"Makefile","reason":"Portable local invocation of both config gates."},{"path":".github/workflows/_build-and-test.yml","reason":"CI invocation and cutover protection."},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"Fail when either config guard disappears from CI."},{"path":"scripts/gen_config_reference.py","reason":"Generate precedence, ownership, lifecycle, and security operator reference."},{"path":"docs/config.md","reason":"Generated authoritative config precedence/source/lifecycle reference."},{"path":"docs/security.md","reason":"New generated secret ownership, subprocess limitations, rotation, and observability reference."},{"path":"docs/README.md","reason":"Index the new application security reference."},{"path":"docs/architecture.md","reason":"Point the living architecture to the implemented ADR 0098 composition boundary."},{"path":"src/rebar/","reason":"Remove remaining legacy ambient/per-job facades and migration switches after proof."},{"path":"tests/external/","reason":"Final bounded provider/review-bot/opcert/reconciler live canaries."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","5851-51d7-fda8-4966"],["depends_on","6e3b-3d1a-0ff7-44b6"],["depends_on","6f14-21a7-d806-44b2"],["parent","e215-ab23-ed6a-4791"]],"no_file_impact_reason":"","parent_id":"e215-ab23-ed6a-4791","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp04","config","guard","docs","migration"],"ticket_id":"aabf-d89e-d05a-45c4","ticket_type":"story","title":"RP-04 S7 — Enforce composition ownership and remove legacy paths","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/scripts/test_check_config_ownership.py tests/scripts/test_check_config_ownership_heldout.py","dd_id":"AC1-AC3","dd_text":"Ownership AST red proofs and real-tree zero-exception contract"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"AC2-AC3","dd_text":"Portable local ownership/consumption gates and lint"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/gen_config_reference.py --check","dd_id":"AC4","dd_text":"Generated config/security/operator reference is current"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make test","dd_id":"AC5-AC7","dd_text":"Full behavioral regression after legacy removal"}]},"source_event_uuids":["885048e6-dcf3-45fe-82a0-3d0f49aed16b","cbfdc9eb-df7d-4fc9-bdae-6997215bf38f","ec7b5fa7-aa72-452b-aec5-f69ce83544b4","a22efcac-9f4a-4fe2-a98f-0af7558c8710","30bbe0e3-7130-4eb6-83f4-b1e1e8f325f3","6dceafeb-7ac5-441d-add9-13ecfe013a17","fe6e99fc-878a-4b18-b85f-4eb70c82144c","f3dd81a1-dc39-46c4-aa87-d7920b38365d","25df45bc-0a6c-4483-b059-6a0e58dcc9bd","cc99d96a-11a0-4330-a4b9-3b9ce853f6d4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786999213864815001,"uuid":"0abf681e-1d1e-4561-8bb5-84d472b2d8bd"}