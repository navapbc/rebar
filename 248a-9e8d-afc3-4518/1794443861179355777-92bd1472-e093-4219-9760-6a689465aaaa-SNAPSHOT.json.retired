{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794443861179355777,"compiled_state":{"alias":"nonfat-wimpy-aurochs","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"aa1e294069a5fee3506dec2f1e6e924bf50c771b","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 248a-9e8d-afc3-4518","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","rebar-version: 0.15.1","material: 37f4d501119f2792","verified-at-sha:c80576dfdb390411d45183afd0cdaffcbb56cd12"],"material_fingerprint":"37f4d501119f2792","merged_log_commit":"c80576dfdb390411d45183afd0cdaffcbb56cd12","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794443861179054657},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"3835269d792b7764e0beeca95798250487c78895","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 248a-9e8d-afc3-4518","material: 172e475720e0c84d","material-part: children 647ea2107ca5072f 0","material-part: description 37f84092ae6fd9f7 5938","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 04517c1403a2bdb6 7","material-part: ticket_id 3700fa4f4bd2e5ae 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 5","review-phase: planning","rebar-version: 0.15.0","regver: aa61189569d34126","verified-at-sha:9f8b2af21c8eff24ba85f9625fcc6d80f77d5742","dep e0494009cc941a3286c4ebcabd1c3f3007485bf948551976470d57c2b8e786ce .github/workflows/_mutation.yml","dep 7710d8022551d84e12a3a27c365ca1f95b97b355a5acb7cea4ab436bc9661be3 docs/local-dev-env.md","dep f9dfd2ae2751113228761ad57e289342c53e049788fc353789c35cb15d796496 docs/mutation-testing.md","dep a62566c694fdf096882bc53e6175947e8edaa133bd9471baa10da497bb2c5c17 scripts/mutation_gate.py","dep 43577ffe41b1531d3b02618706b39746911bebf41996051d21174b63766b341f scripts/mutation_sandbox.py","dep 461d86cd7459c149ce8117ed81f79ad715798436dc49f47251a5c53f5f3990b9 tests/scripts/test_mutation_gate.py","dep fb1747436a2cc16e51832784caa4cd4a832a62f647ecd0c4545648fd4128703e tests/scripts/test_mutation_sandbox.py","read-set: 12","read-path: .github/workflows/_build-and-test.yml","read-path: .github/workflows/_mutation.yml","read-path: .github/workflows/gerrit-verify.yaml","read-path: .github/workflows/mutation.yml","read-path: .github/workflows/test.yml","read-path: docs/local-dev-env.md","read-path: docs/mutation-testing.md","read-path: scripts/mutation_gate.py","read-path: scripts/mutation_sandbox.py","read-path: tests/scripts/test_mutation_gate.py","read-path: tests/scripts/test_mutation_sandbox.py","read-path: tests/unit/test_ci_workflow_parity.py","currency-basis: file_impact"],"material_fingerprint":"172e475720e0c84d","merged_log_commit":"9f8b2af21c8eff24ba85f9625fcc6d80f77d5742","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794371955577367967}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"d85e808ee46703f09154929a50a11f27ba93f0ba5951795c9e727e74b6ec073e","event_uuid":"facfeedd-750c-45bd-b367-fad4b8b88e96","position":{"commit_sha":"bdfa2712066a3a914c3a2c3d298491cf3ca134ba","position":"1794371136206754499-facfeedd