{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788087223295017001,"compiled_state":{"alias":"expectable-clownlike-ynambu","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"89fe367d50df0858b46dceef685b29518dec025c","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 4bd8-a2bb-813b-427e","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (89fe367d50df)","material: 6fc00cb8dbd412e6","verified-at-sha:89fe367d50df0858b46dceef685b29518dec025c"],"material_fingerprint":"6fc00cb8dbd412e6","merged_log_commit":"89fe367d50df0858b46dceef685b29518dec025c","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788082291024481000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"89fe367d50df0858b46dceef685b29518dec025c","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4bd8-a2bb-813b-427e","material: 6fc00cb8dbd412e6","material-part: children 647ea2107ca5072f 0","material-part: description 7212902c7cbf429f 7868","material-part: description_boxes 2481a63c85a62cf8 4","material-part: file_impact 8024a2a2f50439ec 3","material-part: ticket_id cf005e8a21749905 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 5","review-