{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787376821463550002,"compiled_state":{"alias":"spongy-rich-lizard","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"b46a9019375e290a6c168f27030c9d046c08b0f3","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 8408-54bb-a8a5-49a7","material: 3eebfd6003472d4c","material-part: children 647ea2107ca5072f 0","material-part: description b836f5af7c774a90 7500","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 178be48ed4a5736e 11","material-part: ticket_id bfc03f9de4455e03 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: planning","rebar-version: 0.12.0 (b46a901937)","regver: aa61189569d34126","verified-at-sha:960fbfef2fc0e5664470d18fc1d53cb9327b1a9b","dep 10e0b443021df353853e9ac331991aa1c4e0b887eb0a3b02cbb6a47ac12c39a8 CHANGELOG.md","dep 1b29a23efeeb9fc7fdbd0c5b924ffe103e80a8fbbd0b794b620e1c0044eb1aca docs/config.md","dep f60f6d6ba171f034c1b947711f87f9f028bacb55ec6756df4d6284b7fdd99dcb docs/event-schema.md","dep 6c5b8326bc55d98f708be9e3e52abe1dd0edae16b7b3eac8c51dcba78e066e44 docs/mcp-reference.md","dep 6aed167537c2845341e6c9101e6b91f2de26d1b891e212976817754db4ed7502 src/rebar/_errors.py","dep a14739b5040b408fd58ee2ea370a48bbf17f293cb7d7fb1829fd3c1959f0fb40 src/rebar/_mcp_errors.py","dep f45dfbc577322f53f6beb9a3ec1702d0a18f1cc003c69332bd78453785fb4227 src/rebar/config.py","dep 06bf80ece14e8a7510e077ecdfefba85f618ec4327897c2be742f88fb9c626fe src/rebar/llm/runner_support.py","dep f5f0ee08f2aa2a057d