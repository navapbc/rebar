b51-41dd-adaa-cd67149023dd","relation":"discovered_from","target_id":"3e73-72b5-cff2-40f0"},{"link_uuid":"24e821dd-226f-4a5b-898d-ad8cea0277bc","relation":"discovered_from","target_id":"e369-a449-4773-48fb"},{"link_uuid":"10bdabee-2552-410e-a70d-2a3bc3cdeabc","relation":"relates_to","target_id":"e369-a449-4773-48fb"}],"description":"Discovered during the DC<->Cloud test-parity re-audit (epic 3e73-72b5-cff2-40f0).\n\nDC guards that status is NEVER edited as a field:\n`tests/unit/rebar_reconciler/test_dc_outbound_status_routing_5200.py::test_the_dc_transport_never_edits_status_as_a_field`.\n\nCloud has the correct implementation — `src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py`\n`update_issue()` pops `status` out of kwargs and routes it to `transition_issue()`, and only the\nremaining kwargs become `jira workitem edit --<field>` argv — but NO Cloud test pins it. A future\nrefactor could leave `status` in the edit payload (a partial fix Jira keeps rejecting) with every\nexisting Cloud test still green.\n\nScope: TEST-ONLY. Behaviour-preserving; no production file is modified. The new test drives the\nreal `acli.update_issue` with `acli.transition_issue` and `acli_subprocess._run_acli` stubbed\n(deterministic, no subprocess, no network), mirroring the stubbing style of\n`test_acli_status_resolution_heldout.py`.\n\n## Acceptance Criteria\n\n- [ ] New file `tests/unit/rebar_reconciler/test_cloud_outbound_status_routing_6194.py` exists and\n      contains the Cloud parity guard, with a docstring naming the DC test it mirrors.\n- [ ] A test asserts that `acli.update_issue(\"PROJ-1\", status=\"in_progress\", summary=\"s\")` produces\n      a `jira workitem edit` argv that contains `--summary` and does NOT contain `--status` (nor the\n      string `status` as any flag), proving status never reaches the field set.\n- [ ] A test asserts that same call dispatches exactly one `transition_issue(key, \"in_progress\")`,\n      so the guard cannot be satisfied by simply dropping status on the floor.\n- [ ] A test asserts that a status-ONLY update (`update_issue(\"PROJ-1\", status=\"closed\")`) spawns NO\n      `workitem edit` subprocess at all and returns `{\"key\": \"PROJ-1\", \"status\": \"closed\"}`.\n- [ ] No file under `src/` changes (verified: `git diff --stat` touches only `tests/`).\n\n## Testing\n\n- [ ] Proof: `python -m pytest tests/unit/rebar_reconciler/test_cloud_outbound_status_routing_6194.py -q`\n      passes.\n- [ ] Proof: `make lint` and `make typecheck` pass from the worktree venv.\n- [ ] Proof: the guard is falsifiable — checked by temporarily re-adding `status` to the edit kwargs\n      locally and confirming the new test FAILS, then reverting.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"tests/unit/rebar_reconciler/test_cloud_outbound_status_routing_6194.py","reason":"New Cloud parity guard pinning that outbound status routes to transition_issue and never reaches the workitem edit field set (test-only)."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","e369-a449-4773-48fb"],["relates_to","e369-a449-4773-48fb"]],"no_file_impact_reason":"","parent_id":"","parent_status_uuid":"971e52c1-7b3a-490e-b970-3f709136da74","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"6194-8815-8ebb-42d0","ticket_type":"bug","title":"Cloud outbound status never edited as a field (parity guard with DC test_dc_outbound_status_routing_5200)","verify_commands":[]},"source_event_uuids":["23ee82a4-5b18-4f07-9c6c-ee95e46dc27d","cf66f18c-6b51-41dd-adaa-cd67149023dd","24e821dd-226f-4a5b-898d-ad8cea0277bc","7b937804-d3a8-4156-abda-fad6352aacc8","85601f59-1042-4dce-aa9f-71348322cb56","10bdabee-2552-410e-a70d-2a3bc3cdeabc","115f4ef1-eb2c-493a-8e69-25a5495e2412","ffdbcef6-b3d3-4bf5-bda3-7e7aa37e0292","a579c12e-aa19-4156-8c28-4298752ed872","