{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787028089790288002,"compiled_state":{"alias":"dragonish-sylphic-sheep","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1d22-40ba-8e2b-4f67","material: 5051231acbbb43eb","material-part: children 647ea2107ca5072f 0","material-part: description fa8526738ac7e8d3 3586","material-part: description_boxes 670af646a34cdc2a 0","material-part: file_impact 052571bb3e164b7c 11","material-part: ticket_id 8992e867902e66aa 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (5b5008bbfb-dirty)","regver: 1da3feeb7c09e17f","verified-at-sha:5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","dep 62bf9d51c6b6c575ba1b6f7f03f80f8fdc4e806f181b04a8d45164462bfbaabc docs/llm-example-configs.md","dep 2fe978379fccce65a62fad08979a7d8eba454d73eab4817e90f76ce333fd66d9 docs/llm-framework.md","dep dffc26932237e34babb09d580467f921b4efadc450d17f5bc5d19fd3a3dd61cd docs/workflow-authoring-v2.md","dep 7feb76286aaf90a734c70fafef66235c7756141aa8b991df6ebd63547d4c9973 src/rebar/llm/anthropic_model.py","dep f569ee3ecdb1686d7afc2a3d950c7759130bc76961d7c04c4abc2246829fc7b6 src/rebar/llm/model_classes.py","dep b043a07807c192cf7d8d06804f49bda377bd4a03e05bfc1f43c6a2f88e108893 src/rebar/llm/providers.py","dep 32b9c4646ca92a1a164b46506053038b704bdf32e2d82db355babef9d7f1f1de tests/interfaces/store/test_llm_framework.py","dep dea14950f3789358285f973d3cb7e841a4e1c1331ffd2f06591ee7d3817a6b9b tests/unit/test_model_classes.py","dep 5cd4f9612c5c4d2fd21693ee225946b93e95271683c736b783e746188b2ef44f tests/unit/test_openai_compatible_provider.py","dep 0039828393d667acdaaca3058d07214362763c71c01ba728c757147859cf57dc tests/unit/test_provider_qualifier.py","dep 721057bb736e6b95237deb11b046cc9fbcf75cfee330982913fad2b63e3b5a6a tests/unit/test_pydantic_ai_runner.py","read-set: 12","read-path: .github/llm-providers/openai.toml","read-path: docs/llm-framework.md","read-path: docs/reuse-surface.md","read-path: src/rebar/llm/anthropic_model.py","read-path: src/rebar/llm/capabilities.py","read-path: src/rebar/llm/config.py","read-path: src/rebar/llm/model_classes.py","read-path: src/rebar/llm/providers.py","read-path: src/rebar/llm/runner.py","read-path: tests/unit/test_ci_provider_matrix.py","read-path: tests/unit/test_openai_compatible_provider.py","read-path: tests/unit/test_provider_qualifier.py","currency-basis: file_impact"],"material_fingerprint":"5051231acbbb43eb","merged_log_commit":"5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787028089787614000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"9ef9de1fa64bc384e187385d18502dfbfa0872cddddf64d35f4c3f89761a502a","event_uuid":"b5ab46a5-6596-4738-a26b-b1f3c3f6bd97","position":{"commit_sha":"18b8e0569b0635159532e15b7b24df21cfd11bd2","position":"1787017351072818001-b5ab46a5-6596-4738-a26b-b1f3c3f6bd97"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"db195b74654fb81f7e8947d915cd6da50a27f356d