4c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"9021efc927d21e70ca4c7216a9acb9335e549bd4828300fc1e464b88a163b435","event_uuid":"e54a6e88-307c-405d-9231-308c6c80f407","position":{"commit_sha":"a868e8560ebf41be6de28bfd745a4b4b929869b7","position":"1795210369539977001-e54a6e88-307c-405d-9231-308c6c80f407"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Evidence detail: sandboxed logs are .rebar/scratch/05f74084-win/verify-willet.log and .rebar/worktrees/{bug-create-replay,fix-janitor-byte-race,fix-ref-lock-test-bound,fix-test-git-maint-detach}/.rebar/scratch/s05f74084/make-verify.log; their pip output shows the sandbox proxy's 'Tunnel connection failed: 403 not in this command's allowed_domains'. The A/B logs are .rebar/scratch/s05f74084-f2/ab-sandboxed.log and ab-unsandboxed.log in worktree f2-verify-parity. Unsandboxed complete runs (temp dirs under /var/folders) failed only the then-red test_resign_makes_enforced_verify_pass_with_era_keys (fixed by 2825b4fe283) and once the review-bot 3 s marker (stinky-blushing-gelding). Probe timings outside the sandbox: python -m build --sdist of a minimal hatchling project 2.2 s; semgrep --validate of a one-rule config 1.7 s. Inside: build fails in 8.7 s (deny network-outbound pypi.org:443); semgrep --validate fails after 97 s (deny network-outbound semgrep.dev:443, /c/p/semgrep-rule-lints).","timestamp":1795207693580370001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan revised after review: probe 2 now runs the build_provenance command itself (python -m build --outdir, sdist then wheel, inherited env and pip cache); probe 3 states it mirrors the test session's semgrep redirect rather than the detector backend, which sets no SEMGREP_ variables.","timestamp":1795209507770725001}],"created_at":1795206129594136001,"creation_channel":"cli","deps":[{"link_uuid":"af53e765-8297-4acd-860a-05c26a92b951","relation":"relates_to","target_id":"985f-0ec5-a61c-46ee"}],"description":"## Context / Problem\n5 local `make verify` runs of Nov 19-20 2026 ran inside the Claude Code agent sandbox (temp dirs under the sandbox TMPDIR `/private/tmp/claude-502`) and each failed 37 to 45 tests that pass in CI. The 5 complete unsandboxed runs failed none of these.\n\n## Verified cause\nA controlled A/B on Nov 20 2026 ran one fixed set of 21 test modules (origin/main 8e1d15e664f, `-n 4`, same host, minutes apart, load 17-21). Outside the sandbox all 379 tests passed in 187.58 s. Inside, 18 failed and 3 errored (655.42 s). Every failure traces to 2 capabilities the sandbox denies, each reproduced directly in a sandboxed shell:\n- AF_UNIX sockets. `socket(AF_UNIX).bind()` in the temp dir raises `PermissionError: [Errno 1] Operation not permitted`. Breaks all 9 tests in `tests/unit/test_reclaim_resign.py` (their private `ssh-agent -a <sock>` never binds, so `ssh-add` fails) and both tests in `tests/unit/test_network_guard_local_ipc.py`.\n- Outbound HTTPS to 2 hosts:\n  - `semgrep.dev`. The opengrep/semgrep backend pre-validates each detector with `semgrep --validate`, which downloads the `p/semgrep-rule-lints` ruleset from `semgrep.dev`. In the sandbox that request is denied (`deny network-outbound semgrep.dev:443`), so validation retries for about 60 s and the harness abstains. This fails 4 tests in `tests/unit/test_code_review_conflict_markers.py` / `test_code_review_public_exposure.py` (their negative tests pass falsely after 122 s each) and 2 in `tests/unit/grounding/test_conformance.py`. The existing `configure_semgrep_settings_file` redirect (ticket 985f-0ec5) works: with it `semgrep scan` succeeds in the sandbox; only `--validate` fails, on the network.\n  - `pypi.org`. Isolated builds (`python -m build`) cannot fetch `hatchling` (`deny network-outbound pypi.org:443`): the 3 `tests/unit/test_build_provenance.py` errors and `tests/unit/test_attestation_signing.py::test_hook_falls_back_to_git_when_env_unset`.\nThese are not test defects: CI hosts provide both capabilities, and a per-test shim cannot cover them because the denied capability is the operation under test.\n\n## Approach\n`make verify` refuses up front on a host that lacks one of these capabilities, and says which, instead of a misleading red (or false green) after 25 minutes.\n- New `scripts/check_verify_host.py` (marked `# mechanism-ok: ci_gate scripts/check_verify_host.py — d492-04db-b79e-428f`). Three probes, each a function returning `(ok, detail)` and taking its I/O as an injectable argument for tests:\n  1. `unix_socket_probe(socket_factory=socket.socket)`: bind, listen and connect an AF_UNIX socket in a fresh `tempfile.mkdtemp()` directory, then remove it.\n  2. `package_index_probe(runner=subprocess.run)`: write a minimal throwaway project (`pyproject.toml` with `build-backend = \"hatchling.build\"`) to a temp dir and run `[sys.executable, \"-m\", \"build\", \"--outdir\", <tmp>, <project>]` with `timeout=300` and the inherited environment. That is the command `tests/unit/test_build_provenance.py` runs (sdist, then a wheel from it), with the same isolated-env install of `hatchling` from the package index and the same pip cache, so the probe and the tests see the same network and cache state.\n  3. `semgrep_validate_probe(runner=subprocess.run, which=shutil.which)`: when neither `opengrep` nor `semgrep` is on PATH it passes (those tests skip without an engine); otherwise it runs `<engine> --validate --config <one-rule temp file> --metrics=off` (the same flags `_opengrep_validate` in `src/rebar/grounding/engine_b_backends.py` passes) with `timeout=300`. It points `SEMGREP_SETTINGS_FILE` and `SEMGREP_LOG_FILE` into its temp dir, mirroring the test session's own redirect (`configure_semgrep_settings_file`, called from `tests/conftest.py`, which uses `.rebar/scratch/pytest-sandbox-<pid>/`), so a host whose home directory is unwritable is not refused for a cause the suite already handles; the probe then fails only on what the tests would fail on, the rule-lint download.\n  Each failed probe prints one line naming the capability and the error detail (no test lists, so the message cannot go stale), followed by one closing line: `make verify` needs these to give the same verdict as CI; run it where they are available (for an agent sandbox, outside it), see docs/local-dev-env.md. Exit 1 on any failure, 0 and no output otherwise. A probe that raises unexpectedly is reported as that capability failing, with the exception text. The probes are not retried: a transient network failure costs a re-run of a 10-second preflight, not of a 25-minute suite. The script imports nothing from `tests/`, so it does not reuse `tests/_sandbox_capabilities.CapabilityProbe`.\n- `Makefile`: new `verify-host` target running the script. `verify` becomes `verify: verify-host` with the recipe `@$(MAKE) --no-print-directory lint typecheck import-convention test`, so the preflight strictly precedes the gates even under `make -j` or `-k` (a failed prerequisite means the recipe never starts), while the sub-make keeps today's parallelism for the rest. The `##` help text on the `verify` line gains \"host-capability preflight\". `make test` and its two pytest lines stay unchanged, so `tests/unit/test_ci_workflow_parity.py` is unaffected. No skip is added anywhere.\n- Docs: in `docs/local-dev-env.md`, a \"Where `make verify` can run\" subsection naming the 2 capabilities and the agent-sandbox case; correct the \"Sandboxed agent hosts without POSIX named semaphores\" subsection, whose claim that the counted-skip probes \"restore a real `make verify` verdict under the sandbox\" is no longer true (the shims stay for targeted pytest runs); update the `make verify` line in the command list (line ~547) and the \"stops at the failing prerequisite\" paragraph to include the preflight. In `AGENTS.md`, add `verify-host` to the `make verify` formula and one sentence pointing to the new subsection.\n- No config key, environment variable, or command-line flag is added.\n\n## Scope\n- `scripts/check_verify_host.py` (new)\n- `tests/unit/test_check_verify_host.py` (new)\n- `Makefile`\n- `docs/local-dev-env.md`\n- `AGENTS.md`\n\n## Testing\n- `tests/unit/test_check_verify_host.py`, all through the injected seams (no real network, no permission-bit tricks): each probe's pass path; AF_UNIX `PermissionError`; build runner returning exit 1 and raising `TimeoutExpired`; semgrep runner returning exit 2; no engine on PATH passes; `main()` with 2 failing probes prints both capability lines plus the closing line and exits 1; `main()` with all passing prints nothing and exits 0; a probe raising `RuntimeError` is reported as a failure, not a crash.\n- A test parses the Makefile and asserts `verify`'s only prerequisite is `verify-host` and its recipe runs `lint typecheck import-convention test`.\n- Manual, recorded on this ticket: inside the agent sandbox `make verify` exits 1 before `lint`, naming AF_UNIX sockets and network access; outside it `make verify-host` exits 0 silently.\n\n## Acceptance Criteria\n- [ ] Inside the agent sandbox, `make verify` stops before `lint` with a message naming the denied capabilities (AF_UNIX sockets and outbound HTTPS to the package index and semgrep.dev), recorded on this ticket.\n- [ ] Outside the sandbox, `make verify-host` exits 0 with no output, and the full `make verify` passes on the change (run unsandboxed through the operator's host-local verify-slot wrapper, which only caps concurrent runs and then calls `make verify`), recorded on this ticket.\n- [ ] `tests/unit/test_check_verify_host.py` covers each probe's pass and fail path, the exception path, and the Makefile ordering.\n- [ ] `docs/local-dev-env.md` and `AGENTS.md` state where `make verify` can run, and no doc still says the sandbox shims restore a real `make verify` verdict.\n- [ ] Gerrit gives Verified +1.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"scripts/check_verify_host.py","reason":"new capability preflight for make verify"},{"path":"tests/unit/test_check_verify_host.py","reason":"unit tests for each probe and the Makefile ordering"},{"path":"Makefile","reason":"verify-host target strictly before the verify gates"},{"path":"docs/local-dev-env.md","reason":"document where make verify can run; correct the sandbox-shim claim"},{"path":"AGENTS.md","reason":"verify formula and pointer"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","985f-0ec5-a61c-46ee"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"2753c029-ac5d-4720-abe5-5c5c00e1a35b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"d492-04db-b79e-428f","ticket_type":"bug","title":"make verify inside the agent sandbox cannot match CI: AF_UNIX sockets and outbound HTTPS are denied; refuse up front","verify_commands":[]},"source_event_uuids":["9342e488-3a43-4072-a361-6bac81b2caf5","3c30db1e-b24a-443b-81e9-6658d9ce4bee","af53e765-8297-4acd-860a-05c26a92b951","544bfad1-3724-494a-8b6a-220e63b7c830","ad9713d4-dc17-4383-bd3e-37cf9b699976","a8be21d2-4e4e-4aa2-b193-2aa5825527dc","743ae39a-f599-49e9-8203-3ad43daf9614","363fb40c-2b3e-484c-a1cf-ccf9227e7353","054ae988-104a-4ffa-899d-8ed3ba76258c","a7075f63-c64f-48e8-bcd2-e03052d2f4da","6754ec63-dbfa-4634-a129-9176f72e8250","2753c029-ac5d-4720-abe5-5c5c00e1a35b","e54a6e88-307c-405d-9231-308c6c80f407"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1795210369539977002,"uuid":"cf118eb5-7ee8-487c-8e68-bd32d9a5d867"}