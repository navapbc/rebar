787289088860800001-28a1c54a-d6cc-46da-8374-bae1c3bad198"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1b57d065ec909c488bd93b8b7e5e8bee9c3a8184ba7a86e46907883efe304025","event_uuid":"f9092df1-16b7-44dd-a49b-f1c979d908d3","position":{"commit_sha":"8a4a0e3d8180cffc1bb34b7ed0d8dd1297c72155","position":"1787289258294600001-f9092df1-16b7-44dd-a49b-f1c979d908d3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b12d0417b2539de48bdb4cdc40dd98cb4dbd887fcd6b16b4c440f2835fcfa0cc","event_uuid":"0d8ba075-4517-4604-8b50-1c5d087d6f03","position":{"commit_sha":"c0033cbd0920ea4f490f8131eeed4aa83bf0f3c7","position":"1787289505654331001-0d8ba075-4517-4604-8b50-1c5d087d6f03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d41dcf2856ed7f9edd97973bc801ebb96798a39a61f5ea1cb94791ae90525efe","event_uuid":"42edf023-cf13-48fc-afcf-79818b56f244","position":{"commit_sha":"2e9bd70d822e3c798ecd03a5bd7d7bd4f95409c8","position":"1787289976545168001-42edf023-cf13-48fc-afcf-79818b56f244"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"be01b62199a80c7a672db8cba3f8239eddfea82e063a1f3615851cfcef23724c","event_uuid":"7d9596e2-551b-478e-85e4-aa893de8664f","position":{"commit_sha":"8cd42dc28e9df6dc230de359a6f10dec98ca1baf","position":"1787290148510776001-7d9596e2-551b-478e-85e4-aa893de8664f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787287206477113001,"creation_channel":"cli","deps":[],"description":"# Config schema + layered-merge core + capability descriptor (provider-neutral)\n\n## Context / Problem\n\nThe reconciler's rebar↔Jira mappings are hardcoded literals in\n`adapters/jira_family/value_maps.py`, `config.py`, and `inbound_fields.py` (all under\n`src/rebar/_engine/rebar_reconciler/`). Before any axis can become config-driven, the seam\nneeds a provider-neutral foundation: a config schema, a layered overlay/merge, fail-closed\nvalidation, and a capability descriptor declaring which axes a target has. This is the\nwalking skeleton every other child depends on; it ships with **no axis wired yet** — S2–S5\nmove each axis onto it.\n\n## Approach\n\nAdd a provider-neutral module (new file\n`src/rebar/_engine/rebar_reconciler/mapping_config.py`) that:\n\n1. **Parses** the mapping block as a **reserved config section**, not as keys on the typed\n   `JiraConfig` — the coercer would route them through `_warn_unknown`, which hard-errors\n   under `REBAR_CONFIG_UNKNOWN_KEYS=error`. Add a new reserved section name `mapping` to\n   `_RESERVED_SECTIONS` (`src/rebar/_config_schema.py:633`, today `{\"llm\", \"snapshot\"}`) so\n   `[tool.rebar.mapping]` is recognised (not coerced or warned), read raw via\n   `rebar.config.read_reserved_section(\"mapping\")` (`src/rebar/config.py:597`) — as the\n   optional `llm.*` layer does. Shape:\n   a `default` block and a `projects.<KEY>` table, each carrying axis sub-tables\n   (`status_map`, `type_map`, `link_map`, `priority_map`, `create_defaults`) plus\n   discovered-vocabulary declarations: three string lists (`statuses`, `issue_types`,\n   `link_types`) plus a `hierarchy` **table** mapping level-name → integer level. Absent\n   section ⇒ empty overlay (today's behavior). Cross-file precedence is whole-section,\n   project-file-wins — rebar's reserved-section convention (`read_reserved_section`, as\n   `llm`/`snapshot`); the deep merge below applies to the layers within that section.\n2. **Resolves** an effective mapping per project key with two merge rules (load-bearing for\n   validation): (a) the **five axis maps** **deep-merge per key** — built-in ← `default` ←\n   `projects.<KEY>` — so an overlay entry overrides only the key it names and unnamed keys\n   inherit; (b) the **vocabulary declarations** (the three lists + the `hierarchy` table)\n   **replace wholesale, most-specific wins** (NOT unioned): a project's declared vocabulary\n   is authoritative-complete, so `projects.<KEY>.statuses` fully supersedes\n   `default.statuses`, and a layer with no declaration inherits the next-outer one (unioning\n   would wrongly accept a default-only value).\n3. **Validates** fail-closed at load against the **effective** (resolved) vocabulary from\n   rule (b): every axis-map value must appear in its declared vocabulary set when one is\n   declared (e.g. every `status_map` value ∈ effective `statuses`); a value referencing a\n   capability-absent axis is rejected; a **malformed block** raises — a sub-table that is\n   not a mapping, an axis-map value that is neither a string nor the `skip` sentinel (the\n   reserved literal `\"skip\"`, a named constant in `mapping_config`, the sole non-vocabulary\n   value an axis-map entry may hold), a vocabulary **list** that is not a list of strings,\n   or a `hierarchy` that is not a string→integer mapping. The raised type is a new\n   `MappingConfigError` subclassing `rebar._config_coercion.ConfigError`\n   (`src/rebar/_config_coercion.py:20`), failing closed on the same load path as every\n   other config error. Validation is **offline** — config only, never the network.\n4. Defines a **`Capability` descriptor** dataclass declaring which mapping **axes** the\n   target's vocabulary has (`has_types`, `has_transitions`, `has_hierarchy`,\n   `has_link_types`, `has_priorities`) — data about the target's vocabulary, distinct from\n   the backend role/behaviour Protocols in `_backend.py` (`@runtime_checkable`\n   `SupportsLinks`/`SupportsComments`), which describe operations a backend implements. Each\n   flag gates one axis: `has_types`→`type_map`, `has_link_types`→`link_map`,\n   `has_priorities`→`priority_map`, `has_hierarchy`→the `hierarchy` table,\n   `has_transitions`→transition replay (S6). `status_map` and `create_defaults` are ungated.\n\nThe module imports nothing from the Jira adapter (provider-neutral); the adapter injects\nits built-in defaults and capability values, respecting the vendor-adapter seam's one-way\ndependency direction (concrete backends import the neutral core, never the reverse) —\n`docs/adr/0083-reconciler-vendor-adapter-seam.md` (cite the filename; bare \"ADR 0035\" is\nambiguous), amended by `docs/adr/0055-jira-family-sub-seam.md`.\n\nRelationship to the existing per-project surface: `.bridge_state/projects.json`\n(`projects_store.py`, ADR 0097) binds a store to a Jira project **identity**;\n`projects.<KEY>` here declares that key's **vocabulary/semantics** — orthogonal concerns\njoined on the same Jira key without duplicating identity data.\n\n## Scope\n\n- `src/rebar/_config_schema.py` — add `\"mapping\"` to `_RESERVED_SECTIONS`.\n- `src/rebar/_engine/rebar_reconciler/mapping_config.py` (new) — schema dataclasses,\n  `MappingConfigError`, `load_mapping_config`, `resolve_for_project`, `validate`,\n  `Capability`.\n- `tests/unit/rebar_reconciler/test_mapping_config.py` (new).\n- `docs/config.md` — document the `[tool.rebar.mapping]` section shape, three-layer merge,\n  and its orthogonality to `.bridge_state/projects.json`.\n\n## Testing\n\n- **Reserved-section recognition (unit, real parser):** a `[tool.rebar.mapping]` section\n  is neither warned as unknown nor coerced into `JiraConfig`, and is returned raw by\n  `read_reserved_section` — even under `REBAR_CONFIG_UNKNOWN_KEYS=error`.\n- **Merge precedence (unit):** a `projects.REB.status_map` entry wins over\n  `default.status_map` over an injected built-in default, an unnamed key inherits; a\n  `projects.REB.statuses` list wholesale-replaces `default.statuses` (not unioned), and a\n  layer with no declaration inherits the outer one.\n- **Fail-closed validation (failure path):** a `status_map` value outside declared\n  `statuses`, a malformed block, and an axis-absent reference each raise\n  `MappingConfigError`, with the nearest valid config as the negative control (must NOT\n  raise).\n- **Neutrality:** `mapping_config` imports no `adapters.jira*` module and contains no Jira\n  value literal.\n\n## Acceptance Criteria\n\n- [ ] `[tool.rebar.mapping]` is registered as a reserved section and read raw via\n  `read_reserved_section`, so its keys do not trip `_warn_unknown` even under\n  `REBAR_CONFIG_UNKNOWN_KEYS=error` — verified by\n  `test_mapping_config.py::test_reserved_section_not_unknown`.\n- [ ] Axis maps deep-merge per key (built-in ← default ← project; unnamed key inherits) and\n  vocabulary declarations replace wholesale (most-specific wins, not unioned) — verified by\n  `::test_perkey_merge_precedence` and `::test_vocab_lists_replace_wholesale`.\n- [ ] A non-default overlay yields a different effective mapping than the built-in default\n  through the real resolve path — verified by `::test_config_effect_contrast`.\n- [ ] `validate` fails closed offline with `MappingConfigError` on a value outside the\n  effective vocabulary, a malformed block (non-mapping sub-table, non-string map value, or\n  non-string-list vocabulary), and a capability-absent axis reference; the nearest valid\n  config does not raise — verified by `::test_validate_fails_closed`.\n- [ ] The core is provider-neutral: `mapping_config` imports no `adapters.jira*` module,\n  carrying no Jira value literal — verified by `::test_core_is_provider_neutral`.\n- [ ] `docs/config.md` documents the `[tool.rebar.mapping]` shape plus its three-layer\n  merge, with a note on orthogonality to `.bridge_state/projects.json`.\n\nTest tier: **in-process unit** — the mechanism is config parse/merge/validate over real\nfunctions (the real reserved-section parser plus the new pure resolve/validate); no\nexternal boundary is crossed, so no lower or higher tier applies.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/mapping_config.py","reason":"new provider-neutral config schema, layered merge, validation, capability descriptor"},{"path":"tests/unit/rebar_reconciler/test_mapping_config.py","reason":"unit tests for merge precedence, fail-closed validation, neutrality"},{"path":"docs/config.md","reason":"document the [tool.rebar.jira] mapping block shape and merge semantics"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","3d7a-7795-efde-4df7"]],"no_file_impact_reason":"","parent_id":"3d7a-7795-efde-4df7","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["reconciler","config","mapping-seam"],"ticket_id":"bfe7-0900-c3d1-4141","ticket_type":"story","title":"Config schema + layered-merge core + capability descriptor (provider-neutral)","verify_commands":[]},"source_event_uuids":["77c69d5c-0c5b-4348-9ff2-cec05907414c","d241bee9-a9fc-49d7-8bb2-1c7afcdcfc19","6f44d03c-11c6-4073-94d6-3474b4a2caac","a298982f-5859-43bb-9ca2-4c8dead21200","e33c0fc7-ef1c-4124-bc99-c689b70115bb","c62906b9-0984-4780-8323-ef675aaedadd","28a1c54a-d6cc-46da-8374-bae1c3bad198","f9092df1-16b7-44dd-a49b-f1c979d908d3","0d8ba075-4517-4604-8b50-1c5d087d6f03","42edf023-cf13-48fc-afcf-79818b56f244","7d9596e2-551b-478e-85e4-aa893de8664f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787299835012050001,"uuid":"5043f5e8-504c-4d45-9245-482f87d463b7"}