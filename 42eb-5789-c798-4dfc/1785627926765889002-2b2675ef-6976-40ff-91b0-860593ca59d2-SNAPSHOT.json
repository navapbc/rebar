{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785627926765889002,"compiled_state":{"alias":"vanitied-tall-crustacean","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"fcdb0b221502a144e69a6eadef7d9e76a59e3c9f","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 42eb-5789-c798-4dfc","material: ac13f21ab1a73010","model: claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 8","review-phase: planning","rebar-version: 0.10.1 (fcdb0b221)","regver: 98022a04a68b0fef","verified-at-sha:fcdb0b221502a144e69a6eadef7d9e76a59e3c9f","plan-material-pin: child 037b-879e-fe13-47d2 e1c94958bbce0c31","plan-material-pin: child 040e-3f0c-ae86-4212 845f5bdaccdb3883","plan-material-pin: child 3036-cb14-86b5-44a3 8f7ff3685c2c37c6","plan-material-pin: child 42fa-676d-fbbb-4ac5 9b3a5eafbc795c3d","plan-material-pin: child e6c1-ff43-5e6c-4067 a3d8c2b00d130f31","plan-material-pin: child e879-2d83-e925-4f2b 3f24c000fe42b7a2","dep absent .bridge_state.bak-retarget/","dep 8b44ad6284c24365d2dc0e8f0988eb4d2bc9d3463ee143f71ab06e5eb23b1e57 .github/workflows/reconcile-bridge-canary.yml","dep 6ffd182235e9e04ea98a14ddfb35918d6170a22ef9c00b2258733c4023bd229d .github/workflows/reconcile-bridge.yml","dep c4f2d55f6e4fe6f1605b54145dcfbae10cbba28d5a68c5cfdd1136eb5e085402 .github/workflows/verify-identity.yml","dep absent docs/","dep 28bd30f798312a75a97d930ce975cac183486f82f8537bcec6db23ca67d41dca src/rebar/_commands/init.py","dep 06efb8a65647bf28fb92d86dca30d73138fd1737912c7ccc502391c8585a6714 src/rebar/attest/authorship.py","dep 9dfeb4bff41cc40286e8917cf46ff572bb45731fc