e08b"},"dropped":[{"agreement":1,"block_threshold":0.5,"blocking_enabled":true,"checklist_item":"- [ ] Add errors=\"replace\" to the git call in metrics/blame.py `_git` (or at least to the blame invocation) so non-UTF-8 file content cannot make blame look like it failed to run","criteria":["edge-cases","error-handling","regression"],"decision":"dropped","drop_reason":"novelty-region","evidence":["src/rebar/metrics/blame.py:42-49: `proc = subprocess.run([\"git\", \"-C\", repo_root, *args], capture_output=True, text=True, encoding=\"utf-8\", timeout=_GIT_TIMEOUT, check=False)` — no errors= argument","src/rebar/metrics/blame.py:50: `except Exception:  # noqa: BLE001 — best-effort: any git/OS error → no culprit` followed by `return None`","src/rebar/metrics/blame.py:160: `out = _git(repo_root, \"blame\", \"-l\", ref, \"--\", path)` — blame output includes each line's file content","src/rebar/metrics/blame.py:167: `tok = line.lstrip(\"^\").split(\" \", 1)[0]` — only the SHA prefix is used, so replacement characters would be harmless","Commit message: \"The git grep in sunset_markers and the git show in engine_comparison carry arbitrary file content, so they decode with errors=\\\"replace\\\"\" — blame is the same kind of call but was left strict"],"finding":"metrics/blame.py `_git` now decodes `git blame` output as strict UTF-8 with no `errors=\"replace\"`. `git blame` prints each source line's contents, so a non-UTF-8 file (e.g. Latin-1) raises UnicodeDecodeError. The broad `except Exception` turns that into `None` ('blame could not run'), and derive_caused_by silently finds no culprit, even though only the leading SHA token of each line is used. On Windows this is a new failure: cp1252 used to decode those bytes. The commit applies errors=\"replace\" to the other calls that return file content but misses this one.","id":"0","impact":0.15,"location":"src/rebar/metrics/blame.py:42","norm_id":"n7298334d8fe58d95","novelty":1.0,"priority":0.15,"reason":"default-advisory","scenarios":["Running derive_caused_by on a bug whose file_impact lists a Latin-1 or binary-ish source file: blame decoding fails, _blame_file_commits returns None, and no culprit is derived","On Windows, where cp1252 decoding used to succeed for such files"],"suggested_fix":"In src/rebar/metrics/blame.py `_git`, add `errors=\"replace\"` after `encoding=\"utf-8\"`. Callers only parse SHAs and commit messages, so replacement characters are harmless.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"yes"},"severity_attributes":{"blast_radius":"local","capability_degraded":true,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"low","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":true,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}}],"impact_model_version":"code-v5","indeterminate":[],"model":"bedrock:us.anthropic.claude-opus-5-5","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-5-5","anthropic:claude-sonnet-5-5"],"capabilities":{"native_structured_output":false,"prompt_cache_style":"bedrock","supports_temperature":false,"supports_t