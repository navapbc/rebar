3b13fdee2e8570da9146f5deae20f43d26b7ab57011"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":143068,"output_tokens":2391,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"50215d448a79b17cd0766cc7c8cf05554212483caa59a1776a71bd0d39e95132"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":136943,"output_tokens":2632,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"ec03618138e22713349c85e9c5b546360813f6530e9b179a5992a867bf884a3b"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":226663,"output_tokens":5160,"requests":8}}],"version":1},"findings":[{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Correct the LIVE VALIDATION auth precondition to name the deployed mechanism (a per-client STATIC bearer PAT via the `static` verifier, presented as `Authorization: Bearer <PAT>`) instead of an 'OAuth bearer token / OAuth gate', reconciling it with docker-compose.yml (`REBAR_MCP_AUTH_STRATEGIES=static`), docs/mcp-auth.md (Resource-Server-only, no token issuance), and docs/mcp-client-setup.md (static PAT).","cohort":["T3"],"criteria":["T3"],"decision":"advisory","decision_margin":-0.3333,"drop_reason":null,"evidence":["Plan text: 'That endpoint is HTTPS and behind the OAuth gate ... The validating client MUST present the OAuth bearer token that docs/mcp-client-setup.md configures for this server (docs/mcp-auth.md), obtained from the already-configured local client entry'","infra/compose/docker-compose.yml:363 'REBAR_MCP_AUTH_STRATEGIES: \"static\"' with comment line 361 'Auth ON at /mcp (static bearer)' and line 371 REBAR_MCP_AUTH_STATIC_TOKENS_FILE","docs/mcp-client-setup.md:1 title 'static bearer PAT'; lines 7-8 'presents a per-client bearer PAT ... which the server's static verifier authenticates. None of the three requires OAuth for this deployment — one static-bearer shape covers all three.'","docs/mcp-auth.md:9-12 'rebar is only a Resource Server. It does not issue tokens, run an Authorization Server, or do Dynamic Client Registration (DCR).'","REBAR_MCP_AUTH_ISSUER_URL / RESOURCE_SERVER_URL are RFC 9728 Protected-Resource-Metadata advertisement values (docker-compose.yml:365-368 comment; mcp-auth.md:74-83), not an OAuth token endpoint the client obtains a token from"],"finding":"The LIVE VALIDATION auth precondition asserts an OAuth bearer-token flow, but the deployed server and every source the plan cites describe a STATIC bearer PAT (Resource-Server-only) — the endpoint runs no OAuth authorization server, so the stated credential-acquisition mechanism is a mismatch.","group_criteria":null,"group_id":null,"id":"fb1dc5a15f11b0de3","impact":0.85,"is_primary":null,"location":"Acceptance criteria → LIVE VALIDATION → 'Auth precondition' paragraph","norm_id":"n99c65a249b6baba6","priority":0.5667,"reason":"default-advisory","recalled":false,"scenarios":["A validator provisioning the credential looks for an OAuth authorization-code / device flow at the endpoint, finds none, and either stalls or mis-configures the client","The 'obtained from the already-configured local client entry' step points at mcp-clients.local.json which holds a STATIC PAT env var (MCP_CLIENT_PAT_*), not an OAuth token — the plan's own citation contradicts its 'OAuth bearer token' wording"],"severity":"critical","suggested_fix":"Replace 'behind the OAuth gate' / 'present the OAuth bearer token' with 'behind the static-bearer auth gate (REBAR_MCP_AUTH_STRATEGIES=static)' and 'present its per-client static bearer PAT (Authorization: Bearer <PAT>) from mcp-clients.local.json as docs/mcp-client-setup.md configures'. If an OAuth/jwt strategy is genuinely intended for the validating principal, cite the deployed config that enables it; otherwise drop the OAuth framing. The RFC 9728 issuer/resource-server URLs may still be mentioned as metadata, but not as a token source.","tier":"