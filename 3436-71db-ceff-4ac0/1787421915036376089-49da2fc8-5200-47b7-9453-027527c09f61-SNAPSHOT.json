_hash":"35c784b1b025b15bd596d83e807559e7a4ec3bbd5c30b29b9bce7979f8b2c4f9","event_uuid":"e09d8eb7-4324-42d7-bfae-ee65475706e5","position":{"commit_sha":"92f215636c2d3887c3d517a7148dd2aa0a77b58f","position":"1787393311102649520-e09d8eb7-4324-42d7-bfae-ee65475706e5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6fe98b5a23d711dc583b3541b81eee3bba927b0f17df5d009d0d8b1f7fd2fd53","event_uuid":"981bc816-378a-458c-84e7-69979a9dd78d","position":{"commit_sha":"e22893dc9daaac74f8beaea4f699a7aec5db2987","position":"1787411789104338954-981bc816-378a-458c-84e7-69979a9dd78d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7de8c268d3441e533ffabf5e3e762c5dcf9bb90c4ef18a93d29d4b1929e8ee70","event_uuid":"a56aa9ae-a0bf-4d72-80b7-24e9ac3499db","position":{"commit_sha":"9d0fd82c3ce88e70032cf34496041f6bad429218","position":"1787414918281001061-a56aa9ae-a0bf-4d72-80b7-24e9ac3499db"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d37e368cd30a1710356713d98e9efc48f70633008fb7475ce4a9b6cda7f742c8","event_uuid":"83fed123-9fe2-43ca-ab3a-dd7e4a554bb4","position":{"commit_sha":"b526376a472a4166dd33ec71c157cf5f4b83caa2","position":"1787418877190102140-83fed123-9fe2-43ca-ab3a-dd7e4a554bb4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-239_agent","claim_remote_session":null,"claimed_session":"e50ec61e-3a77-4eb8-b56b-c1d0f90ff9bc","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Investigation before review — what the original plan asserted vs what the tree holds.\n\nCorrect as written: every line reference (compact_txn.py:522-654/196-223/633-637/297-326/329-454/401-415, compact_rebuild.py:107-238/59-84/76-79/164-195/88-103/198-205, compact_recovery.py:128-202, compact.py:176-225/228-283/314-350, compact_trigger.py:118-147), and both bug attributions (aea0 privileged-nephelite-colt added the fold's SNAPSHOT-exclusion filter; the rebuild had it from day one).\n\nWrong, and fixed in the description:\n* Two named pinning tests do not exist at the paths given. They are tests/interfaces/lifecycle/test_creation_channel_compaction.py and tests/interfaces/lifecycle/test_compact_rebuild_counter_b2bb.py, not tests/unit/.\n* \"rebuild gains rollback for free\" and the SIGKILL acceptance criterion built on it were dropped. Bug e72e (compulsory-pernickety-mantis) scoped its journal + rollback design to the FOLD; the rebuild's crash model is the .snapshot-rebuild.bak sentinel plus an idempotent restart, and today a per-file rename failure there is logged while the rebuild still succeeds. Giving it abort-and-roll-back would change observable behaviour on a repair path, which the epic's consolidation guarantee forbids. Also: REBAR_TEST_COMPACT_RENAME_BARRIER is only reachable from compact_txn._retire_folded_sources, so the proposed \"SIGKILL a rebuild at the existing barrier\" criterion had nothing to fire it, and a SIGKILL runs no rollback code by definition.\n\nConstraints found by grep that shaped the implementation (Serena cannot see them — they are monkeypatch string targets): tests/unit/test_compact_crash_atomicity.py patches _txn._retire_folded_sources, _txn._commit_compaction and calls _txn._rollback_fold directly, and src/rebar/_commands/leaf.py plus compact_trigger call compact._foldable_event_count. All four keep their names and signatures; only their internals now delegate.\n\nMutation evidence for the new tests (each perturbation applied to live code, the named test observed RED, then restored):\n1. source_uuids_of stops excluding snapshots -> test_neither_engine_cites_a_consumed_prior_snapshot FAILED.\n2. _is_event_file drops the .json requirement -> test_a_rebuild_ignores_a_stray_non_event_file FAILED (\"a stray non-event file was retired by the rebuild\").\n3. needs_folding or -> and -> test_needs_folding_keeps_both_selection_arms FAILED.\n4. restore_retired never records a failed rename -> test_restore_retired_reports_a_stuck_source FAILED.\n5. _ENVELOPE_KEY_RE neutered -> test_the_scan_flags_an_envelope_builder FAILED.\n6. Guard, all three directions: an unmarked second envelope in compact_trigger -> tree scan FAILED; the same line with a bare \"# compact-plan-ok:\" -> still FAILED; with \"# compact-plan-ok: fixture writer\" -> PASSED.\n\nLine accounting for the epic's net-negative criterion: the five existing modules lose 169 non-test lines net (+120/-289); the new owner module is 328, so this child alone is +159. It is a new-owner child, so the negative sum has to come from the deletion-heavy children.\n\nGerrit change 2098.","timestamp":1787388582857937001}],"created_at":1787352265992262001,"creation_channel":"cli","deps":[{"link_uuid":"fb4bc999-c094-4876-9c3d-bd9c7cc5f832","relation":"relates_to","target_id":"535e-4bc1-4e48-4fc5"},{"link_uuid":"3a139ed1-b4be-481b-aaee-0db20aa619c4","relation":"depends_on","target_id":"6f18-05de-beaf-42be"},{"link_uuid":"a5c2f892-256d-4ada-89dd-56b7c69c45db","relation":"depends_on","target_id":"1cf6-f902-5bfa-438f"},{"link_uuid":"e09d8eb7-4324-42d7-bfae-ee65475706e5","relation":"relates_to","target_id":"d70c-5ea0-ec69-4518"},{"link_uuid":"981bc816-378a-458c-84e7-69979a9dd78d","relation":"relates_to","target_id":"416c-0b1c-9bc7-4e50"},{"link_uuid":"a56aa9ae-a0bf-4d72-80b7-24e9ac3499db","relation":"relates_to","target_id":"2ea2-5094-e4cf-4027"},{"link_uuid":"83fed123-9fe2-43ca-ab3a-dd7e4a554bb4","relation":"relates_to","target_id":"f223-5a62-b107-45bf"}],"description":"## Context / Problem\nNormal compaction (`compact_txn._compact_locked`, `compact_txn.py:522-654`), the fsck rebuild\n(`compact_rebuild.rebuild_snapshot_from_full_log`, `compact_rebuild.py:107-238`) and crash\nrecovery (`compact_recovery.py:128-202`) each re-derive the same decisions in their own code:\n\n* **candidate listing** — `compact_txn._parse_candidate_events` (196-223) vs\n  `compact_rebuild._partition_rebuild_sources` (59-84) vs `compact._foldable_event_count`\n  (`compact.py:176-225`): three hand-rolled `listdir` + dotfile/`-SYNC.json` filters + JSON\n  parses.\n* **the \"is this a SNAPSHOT file\" test** — `compact_txn._is_snapshot_path` (226-228),\n  re-inlined at `compact_txn.py:633-637` (the source-uuid filter added by bug\n  `privileged-nephelite-colt` / `aea0`), and spelled a third way at `compact_rebuild.py:75-79`.\n* **the SNAPSHOT envelope** — `compact_txn._build_snapshot_event` (297-326) vs the inline copy\n  at `compact_rebuild.py:164-195`; the former's docstring already admits it is \"mirroring\" the\n  latter. `\"source_event_uuids\":` and `\"compacted_at\":` appear as dict keys in exactly these\n  two places.\n* **the `*.retired` rename-back rule** — `compact_txn._retire_folded_sources` (329-397),\n  `compact_txn._rollback_fold` (418-454) and `compact_recovery._revert_partial_fold` (128-164)\n  each restore sources, then remove the uncommitted SNAPSHOT *only* when every reverse-rename\n  succeeded (the data-loss guard from bug `compulsory-pernickety-mantis` / `e72e`), and two of\n  them also `git reset` the ticket dir. `os.rename(retired, ...)` appears three times.\n* **the commit step** — `compact_txn._commit_compaction` (401-415) vs\n  `compact_rebuild._commit_rebuild` (88-103): the same `add -A <id>/` → `diff --cached --quiet`\n  → `commit --no-verify -m` skeleton, differing only in message and error handling.\n* **the two-arm \"needs folding\" rule** — `compact._scan_snapshot_state` (228-283) vs\n  `compact_trigger.ticket_needs_folding` (88-117), including the `any(n.endswith(\n  \"-SNAPSHOT.json\") ...)` probe in both.\n\nOpen story `plush-excessive-willet` (snapshot as derived cache) is a later design change this\nplanner makes cheaper; it does not overlap.\n\n## Approach\nAdd `src/rebar/_commands/compact_plan.py` — no I/O policy of its own, only the shared\nderivations — and route the three paths through it:\n\n* `Candidate` (frozen dataclass: `path`, `name`, `uuid`, `timestamp`, `event_type`, with\n  `is_snapshot` / `is_active` / `is_known_type`) and\n  `list_candidates(ticket_dir, *, include_retired=False)`.\n* `is_snapshot_event_file(name)` and `source_uuids_of(candidates)` — the `aea0` exclusion rule\n  in one place.\n* `has_snapshot(ticket_dir, *, default)` and `needs_folding(foldable, has_snap, threshold)`.\n* `build_snapshot_event(tracker, ticket_dir, compiled_state, source_uuids, snapshot_ts)`\n  returning `(event, final_path)`; `git_author()` moves here with it.\n* `restore_retired(originals) -> bool`, `discard_uncommitted_snapshot(path)`,\n  `unstage_ticket_dir(tracker, ticket_id)` — the rename-back rule and its data-loss guard.\n* `commit_ticket_dir(tracker, ticket_id, message) -> tuple[bool, str]`; each caller keeps its\n  own reaction (`compact_txn` writes the stderr line and returns 1; `compact_rebuild` ignores).\n\n**Deliberately NOT consolidated.** `compact_rebuild`'s forward retire loop\n(`compact_rebuild.py:198-205`) keeps its per-file tolerance and its `.snapshot-rebuild.bak`\nidempotent-restart crash model. Giving it the fold's abort-and-roll-back semantics would change\nobservable behaviour on a repair path (today a rename failure is logged and the rebuild still\nsucceeds), and bug `e72e` scoped its journal/rollback design to the fold, not to the rebuild.\nThe intent journal, `.bak` sentinel and in-process abort seams are unchanged; fsck remains the\nsole owner of mixed state (`compact_recovery.py:22-26`).\n\n**Recorded convergence.** `_partition_rebuild_sources` filters only dotfiles and `-SYNC.json`,\nso a stray non-event file in a ticket dir (no `.json` suffix) was cited in\n`source_event_uuids` and renamed to `*.retired`. `list_candidates` requires the `.json` (or\n`.json.retired`) suffix that the other two scans already required. This is the one behaviour\nthat converges; it is covered by a new test and is not pinned by any existing test.\n\n## Guard construction\n`compact_plan._offending_line(line)` (mirroring `rebar._store.paths._offending_line`) flags a\nline outside the owner that either writes a SNAPSHOT-envelope key (`source_event_uuids` or\n`compacted_at` in dict-KEY position — the call-target/argument-position shape the epic rule\nsanctions) or performs the retired rename-back (`os.rename(` with `retired` in first-argument\nposition). A `# compact-plan-ok: <reason>` marker excuses a line; a bare marker is itself an\noffence. `tests/unit/commands/test_compact_plan.py` scans every `src/rebar/**/*.py` except the\nowner, and unit-tests `_offending_line` in both directions.\n\n## Scope\n`src/rebar/_commands/compact_plan.py` (new), `compact_txn.py`, `compact_rebuild.py`,\n`compact_recovery.py`, `compact.py`, `compact_trigger.py`,\n`tests/unit/commands/test_compact_plan.py` (new). `_compact_locked` and `compact_all_cli` sit\nat their C901 ceilings, so edits there are subtractive only.\n\n## Testing\nHappy path: a normal fold and a rebuild over the same ticket directory produce SNAPSHOT events\nwhose `source_event_uuids` agree, and both envelopes carry the same key set. Edge: a stray\nnon-`.json` file is neither cited nor retired by the rebuild. Guard: the tree scan plus the\nfour `_offending_line` direction tests. Pinning (must pass with no assertion edits):\n`tests/unit/test_compact_crash_atomicity.py`,\n`tests/interfaces/lifecycle/test_compact_process_death.py` (real SIGKILL at the rename\nbarrier), `tests/interfaces/lifecycle/test_compact_rollback_recovery.py`,\n`tests/integration/test_b636_rebuild_history_loss.py`,\n`tests/interfaces/lifecycle/test_creation_channel_compaction.py`,\n`tests/interfaces/lifecycle/test_compact_rebuild_counter_b2bb.py` (`_REBUILD_COUNT` stays in\n`compact_rebuild`), `tests/unit/test_compact_all_selection.py`,\n`tests/unit/test_compact_trigger.py`.\n\n## Acceptance Criteria\n- [ ] A normal fold and a rebuild over the same ticket directory agree on\n      `source_event_uuids`; checked by the new equivalence test in\n      `tests/unit/commands/test_compact_plan.py`.\n- [ ] No second SNAPSHOT-envelope builder or retired rename-back exists under `src/rebar`\n      outside `compact_plan.py`, and an unmarked copy fails while a reasoned\n      `# compact-plan-ok:` marker excuses it; checked by the guard tests.\n- [ ] A rebuild over a ticket dir holding a stray non-`.json` file leaves that file in place\n      and excludes it from `source_event_uuids` (the recorded convergence); checked by the new\n      edge test.\n- [ ] The pinning suites listed above pass with no assertion edits, and\n      `python scripts/check_complexity_baseline.py --check` reports `new=0 increased=0`;\n      checked by running both.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/compact_plan.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_commands/compact_txn.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_commands/compact_rebuild.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_commands/compact_recovery.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_commands/compact.py","reason":"consolidation edit or new shared module/test"},{"path":"src/rebar/_commands/compact_trigger.py","reason":"consolidation edit or new shared module/test"},{"path":"tests/unit/commands/test_compact_plan.py","reason":"consolidation edit or new shared module/test"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","1cf6-f902-5bfa-438f"],["depends_on","6f18-05de-beaf-42be"],["parent","2ddd-b523-06da-4b4a"],["relates_to","2ea2-5094-e4cf-4027"],["relates_to","416c-0b1c-9bc7-4e50"],["relates_to","535e-4bc1-4e48-4fc5"],["relates_to","d70c-5ea0-ec69-4518"],["relates_to","f223-5a62-b107-45bf"]],"no_file_impact_reason":"","parent_id":"2ddd-b523-06da-4b4a","parent_status_uuid":"86aa6b70-10da-4d69-8567-9aa9456edb9a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["consolidation","janitor","fortnight-review"],"ticket_id":"3436-71db-ceff-4ac0","ticket_type":"story","title":"compact_plan: one candidate/source/envelope/retire planner for normal, rebuild and recovery compaction","verify_commands":[]},"source_event_uuids":["a71e22f8-16d4-424c-b9cb-bc705c88ff96","3a139ed1-b4be-481b-aaee-0db20aa619c4","a5c2f892-256d-4ada-89dd-56b7c69c45db","c3620c55-a7e3-464e-b261-aa1354265ad9","4600218e-3e3f-41b3-be30-374f324101ae","9e46a019-85dc-441a-af84-6a7448945be4","86aa6b70-10da-4d69-8567-9aa9456edb9a","1acf49b8-b53b-4e0c-bf8d-dc62ab574f42","96eff30c-c177-4466-b0b2-4bdf3ee3e528","e09d8eb7-4324-42d7-bfae-ee65475706e5","981bc816-378a-458c-84e7-69979a9dd78d","a56aa9ae-a0bf-4d72-80b7-24e9ac3499db","83fed123-9fe2-43ca-ab3a-dd7e4a554bb4"]},"env_id":"","event_type":"SNAPS