{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788934905992788100,"compiled_state":{"alias":"jadeite-circular-roadrunner","assignee":null,"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"1474a922cc456961b15aedf4821e23b27a157bc321982239bd570ca456f98f88","event_uuid":"82d0ba07-a186-4251-a787-0f5e018c9fad","position":{"commit_sha":"cd5a6af3a2b7126c9c13a0e383876ecb81c7a99f","position":"1788901596901654001-82d0ba07-a186-4251-a787-0f5e018c9fad"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a566049f7af82858fa178cef39e321e031098ad7bd80c23adeb200d84648dae6","event_uuid":"fd0267b4-a7f5-4d03-a322-ee18e7f40b46","position":{"commit_sha":"9b11e2f2b497b393e0dfc3ca708dab9bef4cc332","position":"1788921200506892001-fd0267b4-a7f5-4d03-a322-ee18e7f40b46"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"74f96886e9ad946b5576b3d15cff7f915d5eaf499c06638b48f781a92d334150","event_uuid":"868ac1b7-be6e-43ea-9417-5b5104d3a742","position":{"commit_sha":"382be9bcbe126029b14d5ac3eb2e72f493c4e353","position":"1788921225308594001-868ac1b7-be6e-43ea-9417-5b5104d3a742"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dccf63655638d91cd0273570e55213f24057de734b047da8e29ef72437483b1b","event_uuid":"8e2ebdc2-d42b-43e8-8136-854c3d8a4900","position":{"commit_sha":"27e4bb91df37fecc5cb9a4eba8cfd06567133b47","position":"1788921236662787001-8e2ebdc2-d42b-43e8-8136-854c3d8a4900"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"47200adbf3c0243998cb6cbd50112039d073e69aa936d1f2c73ee6e6b1184145","event_uuid":"1ff6c354-e6de-4e50-bbd4-723239bedd17","position":{"commit_sha":"c73c454b2d3e63ad0ab01a228b21ab9823b18369","position":"1788922871222928001-1ff6c354-e6de-4e50-bbd4-723239bedd17"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"215c8693d3ba3fc74ecc91d91e66ae4361e9b4da074895703bcceb9c3786fab6","event_uuid":"3c96f9e0-ede0-4ce0-aef0-5cb5d35b9192","position":{"commit_sha":"69ea7e5062a5660ee8e35fcd6e29124dc5809403","position":"1788922885780231001-3c96f9e0-ede0-4ce0-aef0-5cb5d35b9192"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1b235839ab418d359c2791b0bd8660c51fa036fda529eb0dc8d2dc7b4d287b9f","event_uuid":"b91d8403-e0c8-4522-a1ed-f2b647d25567","position":{"commit_sha":"fc1ae0b6a7a18cd46da4868e282581b642ba1578","position":"1788924483307552001-b91d8403-e0c8-4522-a1ed-f2b647d25567"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ff3cf02028a7f1b2a0bc0ec8989f15b624cd84be27df519d3ce205e204e43b38","event_uuid":"a46e9584-fa80-49db-bbb4-745e08deaf3d","position":{"commit_sha":"6f519da92492219be4193385369de989b79e586a","position":"1788929086372655001-a46e9584-fa80-49db-bbb4-745e08deaf3d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"43589b588075e63ea56e5d84faca83d832b8a61f18d4792df7c05aa50b71012e","event_uuid":"c95af3ef-18e7-47d4-bec9-66047062a8fc","position":{"commit_sha":"9e1370bd5bca2896057504341ffadf7ceb88a217","position":"1788929190051914001-c95af3ef-18e7-47d4-bec9-66047062a8fc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"413c80212009a0c7308399ca67c4371ab2c3e830f4f163e5a5e155cd3202c874","event_uuid":"e0f2675e-648d-464d-bea4-39c610e722b5","position":{"commit_sha":"9e8cf196a82d360fa2e9f087c0b27e5189a54b70","position":"1788929215988025001-e0f2675e-648d-464d-bea4-39c610e722b5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9e9a688d8afb119de5c403bdeea28ffca54437541d6b348bc62e77335a83682a","event_uuid":"69e7103e-6cca-4e87-abc3-ee1b0b7475b6","position":{"commit_sha":"499ab0fd806058ce0b78a26bd318fae40edea5d1","position":"1788930969510802001-69e7103e-6cca-4e87-abc3-ee1b0b7475b6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dd3d63820b778da562332d5f01baefca20979d4cb944d725e02da77c876b3a19","event_uuid":"28bb9cc4-bff1-425b-a112-643d3509f488","position":{"commit_sha":"ce5f37c6dc37cfd35044338b43b40f35c97303c5","position":"1788930991100836001-28bb9cc4-bff1-425b-a112-643d3509f488"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ffdee04a65a6bcc719f95ee45398795eb071b3a152833de9dec50b91eac7f4b3","event_uuid":"ab69abfa-eb10-4746-9fb4-b53e4115e633","position":{"commit_sha":"e62b4178cb70e9b2c637ceece13c3af43cfa5207","position":"1788932918608226001-ab69abfa-eb10-4746-9fb4-b53e4115e633"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fresh orphan sweep triage 2026-09-08: parentless non-epic and not in the prior TSV, but not executable inside this sweep. The ticket itself says a separate /rebar-debug session owns the Gerrit incident investigation and that the comment-remediation epic should continue without debugging Gerrit here. Disposition: keep open for the dedicated debugging owner; do not claim here, because the next step is evidence reconstruction/root-cause proof rather than a small implementable fix.","timestamp":1788901596901654001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA progress 2026-09-09: Phase 1 observation reconstructed from durable CI/Gerrit evidence. Failed run 34235734839 was change 2834 patchset 1. The failing job was require resolvable rebar ticket, and its checkout log shows the external checkout-gerrit-change-action first checked out the workflow dispatch ref from GitHub (`ref: 665d1d0480187380f82e59bd95af1f0c44274732`, the main/workflow ref), then tried `git fetch origin refs/changes/34/2834/1` (GitHub mirror does not advertise Gerrit refs), then fell back to `git fetch https://rebar.solutions.navateam.com/rebar refs/changes/34/2834/1`, which failed immediately with HTTP 502. Gerrit later recovered; recheck run 34236969595 passed Verified, and change 2834 ultimately merged as 02e0fae923d45329a3e1dc1921d70e19484401b8. Working comparison: the patchset commit SHA itself (`d09bfdc154fe825ab0f8865c78f4f2c4f70c4590`) is fetchable from the GitHub mirror by object id, while `refs/changes/...` is not. Hypothesis H1: the failure class is not an invalid commit or bad trailer; it is the CI checkout helper treating Gerrit ref fetch as mandatory even when the patchset object is already mirrored by SHA, so a transient Gerrit HTTP 502/504 can fail Verified before any repository validation. Next experiment/fix should make Verified checkout prefer `GERRIT_PATCHSET_REVISION` from the GitHub mirror and only use Gerrit refspec as fallback, while verifying any fallback FETCH_HEAD equals the dispatch SHA.","timestamp":1788921200506892001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"decision-needed after RCA 2026-09-09: I reconstructed the concrete CI failure and found a design fork before a safe implementation. Evidence: run 34235734839 failed in the checkout step before repository validation; log lines show the helper first checked out the workflow dispatch/main ref from GitHub (`ref: 665d1d0480187380f82e59bd95af1f0c44274732`), then `git fetch origin refs/changes/34/2834/1` failed because GitHub does not expose Gerrit change refs, then Gerrit fallback `https://rebar.solutions.navateam.com/rebar refs/changes/34/2834/1` returned HTTP 502. Gerrit recovered; recheck run 34236969595 passed and change 2834 merged as 02e0fae923d45329a3e1dc1921d70e19484401b8. I also fetched the third-party action source at the pinned SHA and confirmed this is its real algorithm: actions/checkout of `inputs.ref` (default `${{ github.sha }}`, i.e. the workflow ref), then mandatory Gerrit-refspec fetch from origin/Gerrit. Hypothesis confirmed for the checkout failure class: Verified depends on Gerrit being healthy because our mirror does not provide `refs/changes/*`, so transient Gerrit 502/504 can fail CI before tests. I did NOT claim or change code because the remediation choice is operator/design-sensitive. Options: (A) configure Gerrit→GitHub replication to publish `refs/changes/*`, preserving the current action and its intended mirror-first behavior; tradeoff: infra/Gerrit config change, but keeps CI YAML simple. (B) replace the action with an inline SHA-first checkout that fetches `GERRIT_PATCHSET_REVISION` from GitHub by object id then falls back to Gerrit and verifies FETCH_HEAD equals the dispatch SHA; tradeoff: portable in YAML if GitHub reliably serves pre-merge Gerrit objects by SHA, but that reachability must be proven/enforced. (C) accept Gerrit checkout 502/504 as infra-only and document `recheck` as the remedy; tradeoff: no code churn, but Verified remains sensitive to transient Gerrit outages. Recommended default: A if refs/changes replication to GitHub is acceptable; otherwise B only after an operator confirms pre-merge patchset SHA fetch is supported on the mirror. Specific question: should Verified be made independent of transient Gerrit HTTP availability by changing replication/checkout semantics, or should this remain an infra-retry class?","timestamp":1788924483307552001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator ruling 2026-09-08: proceed with Option A. Configure Gerrit→GitHub replication to publish refs/changes/* to the GitHub mirror, preserving the pinned checkout-gerrit-change-action mirror-first path. Patchset visibility on the org-private GitHub mirror is acceptable. Implementation should avoid disturbing main/tickets replication, apply with minimal downtime via replication plugin reload where possible, trigger full replication, verify refs/changes/* on the mirror, prove Verified checkout can fetch refs/changes from origin without Gerrit, watch Mirror Guard, then close with evidence.","timestamp":1788929086372655001}],"created_at":1788892467914096001,"creation_channel":"cli","deps":[{"link_uuid":"f7942ba2-4b88-4f69-83d8-f2571d3f5943","relation":"discovered_from","target_id":"3e32-a859-2153-4a1b"}],"description":"## Context\nDuring the comment-remediation epic, Gerrit briefly advertised `main` with parent `0fe2cc2e…` while Gitiles returned 404 for that object. Ref history appeared rewound and omitted merged commit `2a93f180…`. `git fetch gerrit main` returned timeout/HTTP 504, and CI run `34235734839` failed checkout when Gerrit returned HTTP 502 fetching change 2834. The service later recovered: the parent became readable and ref advertisement worked again.\n\nThis ticket owns the `/rebar-debug` investigation requested by the operator. RCA confirmed the actionable failure class: the pinned `checkout-gerrit-change-action` is mirror-first only when the GitHub mirror exposes the requested Gerrit change ref. Run 34235734839 showed GitHub lacked `refs/changes/34/2834/1`, forcing Gerrit fallback; the fallback returned HTTP 502 before repository validation. A later check found the ref visible on GitHub, proving the versioned refspec can work but that the live mirror can lag/miss until replication is triggered. The operator approved Option A: publish `refs/changes/*` to the org-private GitHub mirror and preserve the pinned action's mirror-first path.\n\n## Operator ruling\nProceed with Option A and use push spec `+refs/changes/*:refs/changes/*`. This is an explicit accepted trade-off for the change-ref namespace only: branch/tag history remains non-force; `refs/meta/config` remains unreplicated via `replicatePermissions = false` and by avoiding wildcard `refs/*`. The force applies to patchset refs and `refs/changes/NN/NNNN/meta`; it is not what creates a missing ref, but it ensures the full replication sweep converges the mirrored change namespace even if Gerrit rewrites change metadata while preserving the one-way-door guard for `main`, tags, and feature branches.\n\n## Plan\n- Record the RCA/timeline on the ticket: run 34235734839 failed before validation because GitHub lacked `refs/changes/34/2834/1`; Gerrit fallback returned 502; recheck run 34236969595 later passed; current mirror checks show the change-ref namespace can be published.\n- Update only the Gerrit change-ref replication spec to the operator-approved forced refspec `+refs/changes/*:refs/changes/*`, keeping `refs/heads/main`, `refs/tags/*`, `refs/heads/feature/*`, `projects = rebar`, `mirror = false`, and `replicatePermissions = false` intact.\n- Add a narrow repository test that parses `infra/gerrit/replication.config` and proves the exact forced change-ref refspec is present while the branch/tag/feature refspecs and privacy/safety filters remain unchanged.\n- Apply the repository config on the Gerrit host through the supported replication setup/materialization path, snapshotting the live `replication.config` first and using plugin reload if available; otherwise use the minimal documented Gerrit restart only if needed.\n- Trigger full replication for remote `github`; this trigger/backfill is the mechanism that creates any missing refs, while the forced refspec is the operator-approved convergence behavior for the change namespace.\n- Monitor replication output/disk/CPU enough to catch obvious initial-load failures.\n- Verify `refs/changes/*` visibility on GitHub with `git ls-remote`, spot-check an open change ref, and prove a CI-style `git fetch origin <refs/changes/...>` succeeds from the GitHub mirror without contacting Gerrit.\n- Watch the first Mirror Guard run after the change and confirm it stays green with no replication-lag alarm.\n\n## Testing\n- RED: `pytest tests/scripts/test_gerrit_replication_config.py::<new refs_changes_refspec test>` fails before the config change because the file uses non-forced `refs/changes/*:refs/changes/*`.\n- GREEN targeted: `pytest tests/scripts/test_gerrit_replication_config.py` plus `make config-check`.\n- Final repository verification: `make verify PYTEST_WORKERS=2` with ambient GIT_CONFIG_* variables unset.\n- Operational verification: after host apply and replication, `git ls-remote https://github.com/navapbc/rebar 'refs/changes/*'` returns change refs and a local fresh repo can `git fetch origin <open-change-ref>` from GitHub only.\n\n## Acceptance Criteria\n- [ ] The incident timeline is recorded on this ticket with exact Gerrit and CI evidence.\n- [ ] The root cause is recorded on this ticket: the mirror-first action fell back to Gerrit because the GitHub mirror lacked the requested change ref at validation time.\n- [ ] The versioned Gerrit replication config publishes `+refs/changes/*:refs/changes/*` while retaining main/tag/feature replication and refs/meta/config privacy controls.\n- [ ] The live Gerrit host has the updated replication config applied and full replication has been triggered successfully.\n- [ ] `refs/changes/*` visibility and a CI-style origin fetch are verified from the GitHub mirror without contacting Gerrit.\n- [ ] Mirror Guard remains green after the change and no replication-lag alarm is observed.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/gerrit/replication.config","reason":"Change the GitHub remote change-ref push spec to the operator-approved +refs/changes/*:refs/changes/* while preserving existing filters."},{"path":"tests/scripts/test_gerrit_replication_config.py","reason":"Regression coverage that the replication config carries the exact change-ref refspec and preserves safety filters."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["gerrit","infra","debug"],"ticket_id":"93e5-b934-b2ec-43d2","ticket_type":"bug","title":"Investigate transient Gerrit ref inconsistency and checkout 502","verify_commands":[]},"source_event_uuids":["82d0ba07-a186-4251-a787-0f5e018c9fad","fd0267b4-a7f5-4d03-a322-ee18e7f40b46","868ac1b7-be6e-43ea-9417-5b5104d3a742","8e2ebdc2-d42b-43e8-8136-854c3d8a4900","1ff6c354-e6de-4e50-bbd4-723239bedd17","3c96f9e0-ede0-4ce0-aef0-5cb5d35b9192","b91d8403-e0c8-4522-a1ed-f2b647d25567","a46e9584-fa80-49db-bbb4-745e08deaf3d","c95af3ef-18e7-47d4-bec9-66047062a8fc","e0f2675e-648d-464d-bea4-39c610e722b5","69e7103e-6cca-4e87-abc3-ee1b0b7475b6","28bb9cc4-bff1-425b-a112-643d3509f488","ab69abfa-eb10-4746-9fb4-b53e4115e633"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788934905992788100,"uuid":"0f28f728-2e10-4410-95fd-e6e315ebf092"}