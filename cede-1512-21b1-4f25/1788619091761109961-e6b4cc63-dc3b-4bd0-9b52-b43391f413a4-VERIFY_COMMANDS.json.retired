{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nBASE=\"0033662b5534531d84e39d4a14bf75c8e768e85e\"\nclass StripDocstrings(ast.NodeTransformer):\n    def generic_visit(self, node):\n        node = super().generic_visit(node)\n        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n            if node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n                node.body = node.body[1:]\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n        return node\ndef normalized(raw):\n    return StripDocstrings().visit(ast.parse(raw, type_comments=True))\nfor path in sys.argv[1:]:\n    before = subprocess.check_output([\"git\", \"show\", f\"{BASE}:{path}\"], text=True)\n    after = subprocess.check_output([\"git\", \"show\", f\"HEAD:{path}\"], text=True)\n    if ast.dump(normalized(before), include_attributes=False) != ast.dump(normalized(after), include_attributes=False):\n        raise SystemExit(f\"normalized AST changed: {path}\")' tests/mocks/jira-cassette-loader.py","dd_id":"semantic","dd_text":"The cassette loader has exactly equal normalized Python ASTs against the immutable audit basis."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nBASE=\"0033662b5534531d84e39d4a14bf75c8e768e85e\"\nDIRECTIVE=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\")\ndef blob(ref, path):\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"])\ndef js_tail(raw, path):\n    lines=raw.splitlines(keepends=True)\n    index=next((i for i, line in enumerate(lines) if line.startswith(b\"import \")), None)\n    if index is None:\n        raise SystemExit(f\"missing import boundary: {path}\")\n    if any(line.strip() and not line.lstrip().startswith(b\"//\") for line in lines[:index]):\n        raise SystemExit(f\"non-comment content before first import: {path}\")\n    return b\"\".join(lines[index:])\nfor path in sys.argv[1:-1]:\n    if js_tail(blob(BASE, path), path) != js_tail(blob(\"HEAD\", path), path):\n        raise SystemExit(f\"bytes changed from first import onward: {path}\")\npath=sys.argv[-1]\nbefore=blob(BASE, path)\nafter=blob(\"HEAD\", path)\nif not after.startswith(b\"#!/usr/bin/env python3\\n\"):\n    raise SystemExit(\"cassette-loader shebang changed or moved from line 1\")\ndef directives(raw):\n    text=raw.decode()\n    return [token.string for token in tokenize.generate_tokens(io.StringIO(text).readline) if token.type == tokenize.COMMENT and DIRECTIVE.match(token.string)]\nif directives(before) != directives(after):\n    raise SystemExit(\"cassette-loader directive signature changed\")' tests/e2e/js/browser_batch_library.mjs tests/e2e/js/browser_batch.mjs tests/e2e/js/browser_structured.mjs tests/mocks/jira-cassette-loader.py","dd_id":"headers","dd_text":"All JavaScript bytes from the first import onward, the line-1 shebang, and the Python directive signature remain exact."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\"], text=True).splitlines())\nif actual != expected:\n    raise SystemExit(f\"changed paths differ from file impact: actual={actual!r} expected={expected!r}\")' tests/e2e/js/browser_batch_library.mjs tests/e2e/js/browser_batch.mjs tests/e2e/js/browser_structured.mjs tests/mocks/jira-cassette-loader.py","dd_id":"paths","dd_text":"The one-commit leaf diff changes exactly the four recorded file-impact paths."},{"command":"rtk git diff --check HEAD^ HEAD -- tests/e2e/js/browser_batch_library.mjs tests/e2e/js/browser_batch.mjs tests/e2e/js/browser_structured.mjs tests/mocks/jira-cassette-loader.py","dd_id":"diff","dd_text":"The four impacted paths contain no whitespace errors."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py","dd_id":"hygiene","dd_text":"The deterministic comment-hygiene policy passes."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/e2e/test_editor_batch_library.py::test_editor_batch_library_select_and_author tests/e2e/test_editor_browser.py::test_editor_batch_criteria_render_add_remove_edit tests/e2e/test_editor_browser.py::test_editor_structured_fields_roundtrip_error_and_no_raw_editor","dd_id":"focused","dd_text":"The exact browser consumers execute and pass."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python tests/mocks/jira-cassette-loader.py","dd_id":"cassette-self-test","dd_text":"The cassette loader direct executable self-test passes."},{"command":"rtk proxy node --check tests/e2e/js/browser_batch_library.mjs","dd_id":"node-batch-library","dd_text":"browser_batch_library.mjs parses as JavaScript."},{"command":"rtk proxy node --check tests/e2e/js/browser_batch.mjs","dd_id":"node-batch","dd_text":"browser_batch.mjs parses as JavaScript."},{"command":"rtk proxy node --check tests/e2e/js/browser_structured.mjs","dd_id":"node-structured","dd_text":"browser_structured.mjs parses as JavaScript."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"full","dd_text":"The complete repository verification gate passes in the worktree virtualenv."}]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"VERIFY_COMMANDS","timestamp":1788619091761109961,"uuid":"e6b4cc63-dc3b-4bd0-9b52-b43391f413a4"}