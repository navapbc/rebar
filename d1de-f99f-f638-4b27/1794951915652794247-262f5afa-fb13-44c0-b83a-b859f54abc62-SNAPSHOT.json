262df12a9ace8e2c2eed2c35bfa8217","position":"1794951900385633691-ec1de377-06e3-44fb-8ca0-44e1d5b9bf38"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8981627bc72c54363c41c2cf91380239a77501e8e9f49da3f5496f6b7a8d795f","event_uuid":"86b534a0-0318-4c22-9f41-20da517102a6","position":{"commit_sha":"c246f967ad068fec431479953d365ace4f161df7","position":"1794951911819656182-86b534a0-0318-4c22-9f41-20da517102a6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ed2095b570a92d119791a811d8dce22b6528cd0ed06e565607b705fabc7ca128","event_uuid":"9fea3c7b-8696-41de-8452-c49a829d7614","position":{"commit_sha":"9cd7f9d27ba61d16648967b37b888f6e2e104c06","position":"1794951915652794246-9fea3c7b-8696-41de-8452-c49a829d7614"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed: Gerrit 3415 (LLM-Review +1, Verified +1), merged as 23e8764dada3dcba2a1cde28fcd0cb37af9ce818. Evidence:\n- Before the fix, the new xdist test failed: the output held only `worker 'gw0' crashed while running 'test_hangs.py::test_hangs_past_its_budget'`, with no Timeout text. After the fix it passes.\n- The original reproduction (`-n 2 -o timeout=3`) now prints `+++ Timeout +++ pytest-timeout expired after 3.0s in …::test_hangs (xdist worker gw0)` plus all thread stacks.\n- `make verify` exited 0 on d0125c22943: 21345 passed, 30 skipped; integration tier 222 passed, 2 skipped.","timestamp":1794951656358284572}],"completion_expectation":"required","created_at":1793778430874723001,"creation_channel":"cli","deps":[{"link_uuid":"195576d6-9cbc-4873-b851-66760aa27af5","relation":"discovered_from","target_id":"8629-d0b1-30fd-4c34"},{"link_uuid":"2eba7c89-5356-4d02-b8fa-00b57900d918","relation":"relates_to","target_id":"f688-32d4-52c0-4d6f"},{"link_uuid":"9fea3c7b-8696-41de-8452-c49a829d7614","provenance":"derived","relation":"caused_by","target_id":"bab8-eb45-4dc2-4f02"}],"description":"## Context / Problem\nWith `timeout_method = \"thread\"` (pyproject.toml:762), a test that exceeds its pytest-timeout budget under xdist does not report `Failed: Timeout`. pytest-timeout's watchdog thread calls `os._exit(1)` in the worker. The controller sees `[gwN] node down: Not properly terminated`, the crash guard (`tests/_crash_guard.py`) prints `xdist worker=gwN terminated abnormally: Not properly terminated`, and the test is FAILED with no traceback, no stack dump, and no sign that a timeout fired. Every such incident starts as a mystery-crash investigation (e.g. uneducated-conveyable-nabarlek, subjective-forgeable-banteng, albinic-agrologic-dolphin, skipping-unamorous-massasauga).\n\n## Root cause (confirmed 2026-11-17 PST, origin/main 57d45053272, pytest-timeout 2.4.0, pytest-xdist 3.8.0)\n- pytest-timeout does print a `+++ Timeout +++` banner, any captured output, and every thread's stack before it exits. It writes them through `item.config.get_terminal_writer()` (`.venv/lib/python3.12/site-packages/pytest_timeout.py:513-535`, `timeout_timer`).\n- In an xdist worker, that terminal writer writes to fd 1. execnet's popen bootstrap points fd 1 at `/dev/null` in every worker (`execnet/gateway_base.py:1787-1789`).\n- Measured: inside a `-n 1 -s` worker, the terminal writer's file is `name=1`. `os.write(1, …)`, `sys.__stdout__` and the terminal writer all produce no output, while `os.write(2, …)` reaches the controller's stderr. So the dump is written, but to `/dev/null`.\n- Reproduction, run in the repo so pyproject's thread method applies: `pytest -p no:cacheprovider -n 2 -o timeout=3` on a module whose test sleeps 30 s. The output shows `[gw0] node down: Not properly terminated`, `worker 'gw0' crashed while running '…::test_hangs'`, `1 failed, 1 passed`, and no `Timeout` text anywhere.\n\n## Approach\nWrite the timeout announcement to the worker's stderr (fd 2), the one stream xdist workers share with the controller. Keep pytest-timeout's thread method and its exit path.\n- In `tests/_crash_guard.py`, the plugin `tests/conftest.py:23` already loads in every process, add a `pytest_timeout_set_timer` hookimpl. It is `tryfirst=True, optionalhook=True`, because the hookspec exists only when pytest-timeout is installed (`pytest_timeout.py:114`, `firstresult=True`). It acts only when `settings.method == \"thread\"` and the process is an xdist worker (`hasattr(item.config, \"workerinput\")`). Otherwise it returns `None`, so pytest-timeout's own `trylast` implementation (`pytest_timeout.py:303-336`) runs unchanged.\n- In a worker, it arms the same `threading.Timer(settings.timeout, …)` and sets `item.cancel_timeout` (cancel + join), the protocol pytest-timeout's `pytest_timeout_cancel_timer` (`pytest_timeout.py:339-348`) calls.\n- When the timer fires, the handler does the following in order:\n  1. If `pytest_timeout.is_debugging()` says a debugger is attached (and the settings do not disable debugger detection), it returns, matching `timeout_timer`.\n  2. It suspends global capture through the `capturemanager` plugin, which puts the worker's real fd 2 back.\n  3. It writes one line to fd 2: `+++ Timeout +++ pytest-timeout expired after <N>s in <nodeid> (xdist worker <id>); the worker exits now`.\n  4. It writes every thread's stack with `faulthandler.dump_traceback(file=2, all_threads=True)`.\n  5. It calls `pytest_timeout.timeout_timer(item, settings)`, which keeps pytest-timeout's exact `os._exit(1)` behaviour.\n- The crash guard's existing `pytest_testnodedown` reporting is unchanged.\nThis fixes the class: every thread-method timeout in any xdist worker names itself and its test id in the controller's output.\n\n## Scope\n- `tests/_crash_guard.py`: add the worker-side `pytest_timeout_set_timer` hook and timer handler described above.\n- `tests/unit/test_crash_guard.py`: add 2 nested-run tests. The nested runs execute in a tmp project with no ini file (`tests/unit/test_crash_guard.py:40-51`; `tests/_nested_pytest.py:44-56` injects only `-p no:cacheprovider` and `--basetemp`), and pytest-timeout's default method on POSIX is `signal`. So both nested runs pass `-o timeout=2 -o timeout_method=thread` explicitly, to reproduce the thread-method shape of the repo's configuration:\n  - xdist: `-n 2 -p _crash_guard -o timeout=2 -o timeout_method=thread` on a module whose test sleeps 60 s. It asserts exit code ≠ 0 and a line containing both `Timeout` and that test's node id.\n  - single process (no `-n`): `-p _crash_guard -o timeout=2 -o timeout_method=thread` on the same module. It asserts exit code ≠ 0 and that pytest-timeout's own `Timeout` banner is present, which shows the hook stays out of the non-worker path.\n\n## Testing\n- Happy path (the bug): the new xdist test fails against origin/main's `tests/_crash_guard.py` (output has `Not properly terminated` and no `Timeout`) and passes after the change.\n- Edge path: the single-process nested test passes both before and after the change (hook returns `None` outside workers).\n- All existing `tests/unit/test_crash_guard.py` tests still pass, including the source-scan test that forbids output scraping in `_crash_guard.py`.\n\n## Acceptance Criteria\n- [x] Under xdist with the thread method, a test that exceeds its pytest-timeout budget is reported in the controller output as a timeout naming the test id, not only as `Not properly terminated`. Checked by the new xdist test in `tests/unit/test_crash_guard.py`.\n- [x] A test reproduces the silent-crash shape and fails before the fix. Checked by running the new xdist test with origin/main's `tests/_crash_guard.py` (fails) and with the change (passes).\n- [x] `make verify` exits 0 on the change.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"tests/_crash_guard.py","reason":"worker-side pytest_timeout_set_timer hook that announces a thread-method timeout on fd 2 with the test id"},{"path":"tests/unit/test_crash_guard.py","reason":"regression test: xdist timeout output names the test; single-process path unchanged"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","f688-32d4-52c0-4d6f"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ec1de377-06e3-44fb-8ca0-44e1d5b9bf38","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"d1de-f99f-f638-4b27","ticket_type":"bug","title":"xdist timeout kills report as silent worker crashes","verify_commands":[]},"source_event_uuids":["8d6844ce-07bf-4167-9370-58db9c53f267","d590f032-c7f8-4c11-9721-30cb31add574","809f9061-c49d-48ea-9bbf-afc437107bdf","81d237b8-dae8-492c-89df-f58b7cc650a4","acdfcb38-ff7c-4b05-829e-9d80a0869451","945508b8-6b8b-4ecf-9db9-75cc0527ac5c","2eba7c89-5356-4d02-b8fa-00b57900d918","13c1bdf0-ccf0-4aba-8fc6-792368f69815","72557089-2a50-48f7-b3fc-b342a49a550f","3c5794be-7c4b-453f-b8dd-93eafb21a4ba","ec1de377-06e3-44fb-8ca0-44e1d5b9bf38","86b534a0-0318-4c22-9f41-20da517102a6","9fea3c7b-8696-41de-8452-c49a829d7614"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794951915652794247,"uuid":"262f5afa-fb13-44c0-b83a-b859f54abc62"}