IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c13dd95d1589a872e532f921999448e38c2abb35789cd92d61f4c551049b2d20","event_uuid":"f71a104c-67ea-4aac-937a-80b8a4bdc91a","position":{"commit_sha":"7e55ccdc0a2229c25283c6761d4c29b0ac3e7c26","position":"1787568546756572001-f71a104c-67ea-4aac-937a-80b8a4bdc91a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"53bc3f2b47f4f060606becf61eff3fc990f2c63fe29b389bc9a41ea8b57052a7","event_uuid":"fc4bca8a-a585-484c-a15a-baac3b255d78","position":{"commit_sha":"13e5249b69e5e750cddae8423512e2b0e7fabeca","position":"1787571028757607663-fc4bca8a-a585-484c-a15a-baac3b255d78"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c778f1f095ad44f31a540acfc6d15ef45dc37ae882a25b0a6c6116ef9c2bcee1","event_uuid":"03850e92-68df-43f5-8385-24048e518f74","position":{"commit_sha":"97dbcab7b6cdd9824398972a804106f289d0a2c2","position":"1787574371081294689-03850e92-68df-43f5-8385-24048e518f74"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Jira 3.10.5 seam evidence (2026-08-17): in this dedicated worktree venv, inspect.signature(jira.JIRA.__init__) exposes top-level max_retries: int = 3; installed source assigns self._session.max_retries = max_retries. A credential-free/no-network construction probe using JIRA(server=\"https://jira.invalid\", token_auth=\"probe\", get_server_info=False, max_retries=0) completed and produced client._session.max_retries == 0. Implementation must preserve a real-client constructor test for that exact pinned-version path and fail loud if it changes. Follow-up on pycontribs/jira issue #789: the report was against jira 2.0.0, Python 3.7, and basic_auth during eager server_info authentication; it was stale-closed in 2019. Rebar's DC seam is pinned to jira 3.10.5, uses token_auth, and the constructor oracle disables server-info network I/O, so #789 does not contradict the verified constructor/read-back capability. S3 venue-gated validation remains the owner of real authentication/cutover evidence.","timestamp":1787033810576125001}],"created_at":1787027890137885001,"creation_channel":"cli","deps":[{"link_uuid":"f789b47d-e258-4209-8d98-8750c5c687dc","relation":"depends_on","target_id":"7bc2-5203-d5f4-4a4a"},{"link_uuid":"fc4bca8a-a585-484c-a15a-baac3b255d78","relation":"relates_to","target_id":"e425-71f7-6859-436d"},{"link_uuid":"03850e92-68df-43f5-8385-24048e518f74","relation":"relates_to","target_id":"b2b1-41d8-d4be-41ca"}],"description":"## Context\nJira DC summary updates can retry in both pycontribs/Jira and `_with_connection_retry`. The selected route needs a dedicated no-SDK-retry client and per-call wrapper policy without changing legacy callers.\n\n## Outcome\nImplement the DC summary executor with a guarded `max_retries=0` client and fixed GET -> PUT -> GET invocation. Ambiguous PUT recovery uses a separate single-attempt GET under the shared budget.\n\n## Plan\n1. Construct a dedicated executor client through the pinned public `jira.JIRA(..., max_retries=0)` argument; fail fast unless `_session.max_retries == 0`. Preserve legacy client construction.\n2. Add an injected one-attempt/no-sleep policy to `_with_connection_retry` for selected executor calls; preserve legacy wrapper defaults.\n3. Make one write invocation issue exactly GET/PUT/GET. Failure ends the invocation; successful read-back is authoritative.\n4. After ambiguous PUT, consume another physical invocation for one GET observation. Desired state recovers, conclusive old state may replay within budget, and failed/inconclusive observation returns `commit_unknown`.\n5. Return classification/delay metadata to the shared owner; do not sleep or replay in SDK/adapter layers.\n6. Emit exactly one redacted completion log for every DC terminal/exhausted outcome or cleanup failure. Include only logical id, disposition, invocation count, request count, cleanup status, `retry_not_before`, and one redacted message capped at 512 Unicode code points; cap the whole serialized log at 1,024 Unicode code points.\n\n## Testing\nUse fake sessions with raw request counters and poison sleepers/retry adapters. Include the proven Jira 3.10.5 constructor/session guard plus completion-log field, cardinality, redaction, and size assertions.\n\n## Acceptance Criteria\n- [ ] The dedicated executor client passes `max_retries=0` and rejects a nonzero session value.\n- [ ] Legacy DC client SDK retry remains unchanged.\n- [ ] Each selected write invocation is exactly GET/PUT/GET without hidden repeats.\n- [ ] Selected wrapper calls perform one attempt and no sleep, while legacy wrapper behavior remains unchanged.\n- [ ] Desired observation recovers without another write.\n- [ ] Conclusive old state permits only remaining-budget replay.\n- [ ] Failed or inconclusive observation returns non-replaying `commit_unknown`.\n- [ ] Every DC terminal/exhausted outcome or cleanup failure emits exactly one completion log with only logical id, disposition, invocation/request counts, cleanup status, `retry_not_before`, and one redacted message capped at 512 Unicode code points; the whole log is at most 1,024 Unicode code points.\n\n## Out of scope\nCore dispatch/handler integration and other DC operation families.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/transport.py","reason":"Construct the dedicated guarded no-SDK-retry executor client."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/retry.py","reason":"Add a selected per-call one-attempt policy while preserving legacy defaults."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/_issues.py","reason":"Execute and observe the DC summary postcondition."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","reason":"Expose the typed DC operation."},{"path":"tests/unit/rebar_reconciler/test_jira_dc_transport_heldout.py","reason":"Constructor/session guard and legacy-policy tests."},{"path":"tests/unit/rebar_reconciler/test_dc_rate_limit_retry_heldout.py","reason":"Selected and legacy wrapper policy regressions."},{"path":"tests/unit/rebar_reconciler/mutate/test_jira_dc_summary_operation.py","reason":"DC request-order, ambiguity, classification, and raw-count stateful tests."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","7bc2-5203-d5f4-4a4a"],["parent","f5ac-6373-5e33-4374"],["relates_to","b2b1-41d8-d4be-41ca"],["relates_to","e425-71f7-6859-436d"]],"no_file_impact_reason":"","parent_id":"f5ac-6373-5e33-4374","parent_status_uuid":"d80ecdcc-db3a-4fb4-9351-48370e166f13","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["rp03","retry","jira-dc","tdd"],"ticket_id":"c6f3-cda5-c460-4c5c","ticket_type":"task","title":"RP-03 S1 T3 — Execute and observe one Jira DC summary postcondition","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/test_jira_dc_transport_heldout.py tests/unit/rebar_reconciler/test_dc_rate_limit_retry_heldout.py tests/unit/rebar_reconciler/mutate/test_jira_dc_summary_operation.py -k \"dc or legacy_retry\"","dd_id":"AC1-AC4","dd_text":"Dedicated client guard, legacy preservation, fixed request order, and wrapper policy"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/mutate/test_jira_dc_summary_operation.py -k \"dc and ambiguity\"","dd_id":"AC5-AC8","dd_text":"Recovery, replay limits, commit-unknown behavior, and bounded one-log completion telemetry"}]},"source_event_uuids":["bedd07db-9e62-4b10-88b7-fba2c22c811e","848d6f4f-1e37-4ef0-80b2-a96c26a9f1b4","f66c4b26-b0f1-415d-8780-4dd54e4e9dfe","887d57b6-3ce6-4bf5-b1c9-582faec3cb6c","04e7b65d-d086-4286-8f01-62aba7781a1e","9485f86a-dd82-4dd6-b846-b50efd3958ed","93b4055e-f545-4775-9b71-bfc60abefecc","d80ecdcc-db3a-4fb4-9351-48370e166f13","f71a104c-67ea-4aac-937a-80b8a4bdc91a","fc4bca8a-a585-484c-a15a-baac3b255d78","03850e92-68df-43f5-8385-24048e518f74"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787574371081294690,"uuid":"146b8d72-482e-4c73-a6d7-cd0da2376475"}