25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ab89b75909f7bfca98c42ba3612fd28f0123a7e547b11317a7184670a660caf5","event_uuid":"f789b47d-e258-4209-8d98-8750c5c687dc","position":{"commit_sha":"8afbdd2e094c5700f4ea6e56682d0085287f0d9f","position":"1787027921689050001-f789b47d-e258-4209-8d98-8750c5c687dc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027890137885001,"creation_channel":"cli","deps":[{"link_uuid":"f789b47d-e258-4209-8d98-8750c5c687dc","relation":"depends_on","target_id":"7bc2-5203-d5f4-4a4a"}],"description":"## Context\nJira DC summary updates can retry in both pycontribs/Jira and `_with_connection_retry`. The selected route needs a dedicated no-SDK-retry client and per-call wrapper policy without changing legacy callers.\n\n## Outcome\nImplement the DC summary executor with a guarded `max_retries=0` client and fixed GET -> PUT -> GET invocation. Ambiguous PUT recovery uses a separate single-attempt GET under the shared budget.\n\n## Plan\n1. Construct a dedicated executor client through the pinned public `jira.JIRA(..., max_retries=0)` argument; fail fast unless `_session.max_retries == 0`. Preserve legacy client construction.\n2. Add an injected one-attempt/no-sleep policy to `_with_connection_retry` for selected executor calls; preserve legacy wrapper defaults.\n3. Make one write invocation issue exactly GET/PUT/GET. Failure ends the invocation; successful read-back is authoritative.\n4. After ambiguous PUT, consume another physical invocation for one GET observation. Desired state recovers, conclusive old state may replay within budget, and failed/inconclusive observation returns `commit_unknown`.\n5. Return classification/delay metadata to the shared owner; do not sleep or replay in SDK/adapter layers.\n\n## Testing\nUse fake sessions with raw request counters and poison sleepers/retry adapters. Include the proven Jira 3.10.5 constructor/session guard.\n\n## Acceptance Criteria\n- [ ] The dedicated executor client passes `max_retries=0` and rejects a nonzero session value.\n- [ ] Legacy DC client SDK retry remains unchanged.\n- [ ] Each selected write invocation is exactly GET/PUT/GET without hidden repeats.\n- [ ] Selected wrapper calls perform one attempt and no sleep, while legacy wrapper behavior remains unchanged.\n- [ ] Desired observation recovers without another write.\n- [ ] Conclusive old state permits only remaining-budget replay.\n- [ ] Failed or inconclusive observation returns non-replaying `commit_unknown`.\n\n## Out of scope\nCore dispatch/handler integration and other DC operation families.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/transport.py","reason":"Construct the dedicated guarded no-SDK-retry executor client."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/retry.py","reason":"Add a selected per-call one-attempt policy while preserving legacy defaults."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/_issues.py","reason":"Execute and observe the DC summary postcondition."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","reason":"Expose the typed DC operation."},{"path":"tests/unit/rebar_reconciler/test_jira_dc_transport_heldout.py","reason":"Constructor/session guard and legacy-policy tests."},{"path":"tests/unit/rebar_reconciler/test_dc_rate_limit_retry_heldout.py","reason":"Selected and legacy wrapper policy regressions."},{"path":"tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py","reason":"DC request-order and ambiguity stateful tests."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","7bc2-5203-d5f4-4a4a"],["parent","f5ac-6373-5e33-4374"]],"no_file_impact_reason":"","parent_id":"f5ac-6373-5e33-4374","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp03","retry","jira-dc","tdd"],"ticket_id":"c6f3-cda5-c460-4c5c","ticket_type":"task","title":"RP-03 S1 T3 — Execute and observe one Jira DC summary postcondition","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/test_jira_dc_transport_heldout.py tests/unit/rebar_reconciler/test_dc_rate_limit_retry_heldout.py tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py -k \"dc or legacy_retry\"","dd_id":"AC1-AC4","dd_text":"Dedicated client guard, legacy preservation, fixed request order, and wrapper policy"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py -k \"dc and ambiguity\"","dd_id":"AC5-AC7","dd_text":"DC ambiguity recovery and replay decisions"}]},"source_event_uuids":["08c780db-7604-4de4-b5ba-e97f752e896e","50dece06-224a-43e9-9473-b54c703f0fe4","eb656895-0fec-4374-bdf9-4066b97d4ca6","f789b47d-e258-4209-8d98-8750c5c687dc"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029934918681001,"uuid":"b6e21db5-3144-4dff-9039-e3c731ed1f94"}