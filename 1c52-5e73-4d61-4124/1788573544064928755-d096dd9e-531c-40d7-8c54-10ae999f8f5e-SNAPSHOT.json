{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788573544064928755,"compiled_state":{"alias":"depraved-classless-rooster","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"71342780ff8c226d0d3b8b72be94510e8f8b5edd","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1c52-5e73-4d61-4124","material: d01a650b8d193e83","material-part: children 647ea2107ca5072f 0","material-part: description a78701e727a8dd78 7998","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact 81a216e2c47af3e8 10","material-part: ticket_id 2a866ceda34e1b38 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.13.1 (71342780ff8c)","regver: aa61189569d34126","verified-at-sha:446b1ba27770e329460559f2d39c3eaad26816da","plan-material-pin: prerequisite afe3-5aec-51cb-4e02 2a3a08cc2cb850aa","dep 876c42e4dc0b7ea291b399d69e7871da5fa76ec1cf2c3b941f40dd420e18bcc8 docs/adr/0115-terraform-structural-grounding.md","dep 41c931e3db1dc46d4d5c11e0922cdec632157ae8ac01e8518ab35fc17caa59e6 docs/grounding.md","dep ce18e5924c7c60c8eef5f91e9d432af5c0cbd824309a0111c0fe52c170f27407 src/rebar/grounding/terraform_receipt.py","dep absent src/rebar/grounding/terraform_source.py","dep dcba2ce6aea4da27e43e850fb05d1a5c8a49529d22ec0b32c314cfc002d09f60 src/rebar/grounding/terraform_tools.py","dep e963fa0af10b066c896675e34b65adcc7c7f1e705aa5175b47cf6dd1b1f6e68d src/rebar/llm/plan_review/terraform_seam.py","dep 6781f26252e231b172b89a9abbcf1a55b57346f3d85099ac1db200c162036fe5 src/rebar/schema