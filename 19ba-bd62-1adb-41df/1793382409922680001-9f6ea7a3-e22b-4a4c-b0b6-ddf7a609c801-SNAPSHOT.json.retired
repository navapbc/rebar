{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793382409922680001,"compiled_state":{"alias":"censurable-exotic-snake","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"3835269d792b7764e0beeca95798250487c78895","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 19ba-bd62-1adb-41df","material: dd766e8c272ca7fc","material-part: children 647ea2107ca5072f 0","material-part: description 644fb2fd89b623e8 7743","material-part: description_boxes 83b7db61ca197115 0","material-part: file_impact 8be7b6df71628551 11","material-part: ticket_id eff6e45ec0cb4d90 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:50d5a36539d929115c59e3932e4ff1c1496f044b","dep a9fe547e197c13187e19148e3cc58f12d430a99ffc036cff5e15411ecf13930d docs/release-notes.md","dep 9d9e5034ebf1c48fd682e98bed5ff64d85ffa97d80f28bd0248c521873d8265a src/rebar/reducer/_processors.py","dep 808fc39e0e9e2d538ef8553001d52c5921d04cae72519dae65e47af91f3b00b1 src/rebar/reducer/_replay.py","dep 6dba2abb71fca5ca838858fb19774a8eee7cb093f5d3b2d2d51a065bf23c59ee tests/unit/test_attestations_reducer.py","dep 5a180c12eb8792732d2f3fd48b1e18616aee72df248ca34895afa06fa25684c9 tests/unit/test_claimed_session.py","dep 1526c260ba8342e99d8841a45503b4c01de3e40c02eab39e6206ad41b79cffd3 tests/unit/test_harness_provenance.py","dep da3b4f8184f65b6b61eff559d8828708ae1c1bb77d3f4b4142b2433265570372 tests/unit/test_internal_shims_removed_3a46.py","dep 63c1ffb4750af643d29665e9de960ab32994c96f1ff91b3088b8ad2b8df2175e tests/unit/test_legacy_signature_mirror_drop.py","dep 21f7e6eadd3795519358df304faf1e311bd1729025ce35de65b293c86f67b7ad tests/unit/test_plan_review_phase_happy.py","dep 3a9d9ee5925f8d8c6c76c99c7b2c1a1aa894eeb111111eff7ddc640dcc3f8d2a tests/unit/test_plan_review_phase_reducer.py","dep b6d114dc0d6ffeb5ac135c5e2abe9bc7fe622b92248501e8beca5b1b996b30f4 tests/unit/test_signing.py","read-set: 12","read-path: docs/event-schema.md","read-path: src/rebar/reconciler/_field_contract.py","read-path: src/rebar/reducer/_processors.py","read-path: src/rebar/reducer/_replay.py","read-path: tests/unit/test_attestations_reducer.py","read-path: tests/unit/test_claimed_session.py","read-path: tests/unit/test_harness_provenance.py","read-path: tests/unit/test_internal_shims_removed_3a46.py","read-path: tests/unit/test_legacy_signature_mirror_drop.py","read-path: tests/unit/test_plan_review_phase_happy.py","read-path: tests/unit/test_plan_review_phase_reducer.py","read-path: tests/unit/test_signing.py","currency-basis: file_impact"],"material_fingerprint":"dd766e8c272ca7fc","merged_log_commit":"50d5a36539d929115c59e3932e4ff1c1496f044b","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1793379535668348824}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":6,"unsigned":0},"authorship_ledger":[{"content_hash":"3433d6b672443bb0b9f1a0f01f18b1e380398b6bc78eebfc419da0fba7022101","event_uuid":"4b35704a-19c4-499a-b564-a499ce3a35f6","position":{"commit_sha":"fc52170d2891e629577ea47fa9cad05bad48f6c1","position":"1793377801717212037-4b35704a-19c4-499a-b564-a499ce3a35f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8dcac1d437514268ea6e5058b0057355306442c58a026f2644bf519d830087ba","event_uuid":"81dce7b1-fa5e-49e0-abed-07159c6bd5f7","position":{"commit_sha":"a92389c47bef8854022885938d9218cfebba69aa","position":"1793377889805050603-81dce7b1-fa5e-49e0-abed-07159c6bd5f7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"80e25efd3b035a9ae1aefd54c1b213e23b80639b3231f6fbb1535f1b06ff34d0","event_uuid":"11304576-c196-4a4b-a550-baaa8e027247","position":{"commit_sha":"828b580f97f68198ee36729239d9da27c08022cc","position":"1793379296627665324-11304576-c196-4a4b-a550-baaa8e027247"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"67219eff05008240abf68739aff12976f1383415b2f9291527335cadd0575cbd","event_uuid":"923f7399-5bc8-4f58-a081-4737b57fc0e8","position":{"commit_sha":"994d7ddd1c40db73b2cc931874ecdcd1e90ef117","position":"1793379535668651579-923f7399-5bc8-4f58-a081-4737b57fc0e8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"06cdd8423203f0507c633bf73f1ef014fa561d0af0d3b8404fdbaf9c978f1896","event_uuid":"6b605a5a-c827-42aa-b482-4d7a4f08fb41","position":{"commit_sha":"d966d0be6cff56f178192f36889988966d8cc936","position":"1793380034238289476-6b605a5a-c827-42aa-b482-4d7a4f08fb41"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"680c4bb41844ed6f871cfa254d30fc6e3fe299a0110377cdbd1caddfeac90504","event_uuid":"91548d18-6af0-4b55-8716-1915d5c14d36","position":{"commit_sha":"068e41de00137c99c43161713acc10f673f8c5c9","position":"1793380079593564377-91548d18-6af0-4b55-8716-1915d5c14d36"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1793377801717212037,"creation_channel":"mcp","deps":[],"description":"## Context / Problem\n\n`src/rebar/reducer/_processors.py` re-exports 7 names it does not define, each marked\n`# noqa: F401  (re-exported for back-compat)` — 3 from `._processors_identity`\n(`_rederive_keyring_keys`, `process_key_event`, `process_signature`) and 4 from\n`._processors_status` (`_fold_claimed_session`, `_fold_close_metadata`,\n`_fold_plan_review_phase`, `process_status`). ADR 0111 forbids internal shims.\n\nCensused on `origin/main` at `50d5a36539d` with an AST pass over `src`, `tests` and\n`scripts` that resolves relative imports and scans `ast.Attribute` and string constants\nseparately. A line-oriented grep is the wrong instrument here and undercounts, because\nthe two densest importers spell the name inside a multi-line parenthesized statement.\n\n- **4 names have zero importers** and are deleted outright: `_fold_claimed_session`,\n  `_fold_close_metadata`, `_fold_plan_review_phase`, `_rederive_keyring_keys`. None is\n  used inside `_processors.py` either, so they are dead in both directions.\n- `process_key_event` — 1 importer: `src/rebar/reducer/_replay.py:19`.\n- `process_signature` — 5 sites: `_replay.py:19`,\n  `tests/unit/test_attestations_reducer.py:13`,\n  `tests/unit/test_legacy_signature_mirror_drop.py:15`, `tests/unit/test_signing.py:117`\n  and `:133`.\n- `process_status` — 6 sites: `_replay.py:19`,\n  `tests/unit/test_attestations_reducer.py:13`, `tests/unit/test_claimed_session.py:20`,\n  `tests/unit/test_harness_provenance.py:20`,\n  `tests/unit/test_plan_review_phase_happy.py:6`,\n  `tests/unit/test_plan_review_phase_reducer.py:10`.\n- No attribute-style access anywhere. Two string constants name\n  `rebar.reducer._processors`; both were read and neither needs editing (see Out of scope).\n\n**`docs/event-schema.md` names 2 moving symbols in a shape no code census can see.** It\nlocates processors as a bare filename plus symbol — `_processors.py process_status` at\n`:234`, `_processors.py _fold_claimed_session` at `:249` — so a census keyed on the\ndotted path matches neither. Both go wrong when the re-exports are deleted. Line `:82`\nshows the file's own correct form: `reducer/_processors_status.py:_fold_close_metadata`.\n\n## Change\n\n1. Repoint the 3 names that have importers to the modules defining them:\n   `process_key_event` and `process_signature` to `rebar.reducer._processors_identity`,\n   `process_status` to `rebar.reducer._processors_status`.\n2. **Four** importers pull a genuine `_processors` member on the same statement, so they\n   split rather than rewrite wholesale:\n   - `_replay.py:19` imports 18 names, 3 of which move — from two different siblings, so\n     it becomes **three** statements: 15 names stay, `process_key_event` and\n     `process_signature` go to `_processors_identity`, `process_status` to\n     `_processors_status`.\n   - `test_attestations_reducer.py:13` likewise becomes **three**: `attestation_kind` and\n     `process_snapshot` stay, `process_signature` and `process_status` move to their\n     respective siblings.\n   - `test_legacy_signature_mirror_drop.py:15` and `test_plan_review_phase_reducer.py:10`\n     each also import `process_snapshot` (defined at `_processors.py:469`, stays) — two\n     statements each.\n3. Delete all 7 re-exports. The whole `from ._processors_status import (...)` statement\n   goes, since all 4 of its names are re-export-only. The `._processors_identity`\n   statement keeps `_bootstrap_genesis_keyring` (`:139`, `:520`),\n   `_fold_author_attribution` (`:81`, `:185`, `:296`) and `attestation_kind` (`:508`),\n   which carry no `noqa` because `_processors.py` uses them.\n4. Extend the held-out oracle `tests/unit/test_internal_shims_removed_3a46.py`, which\n   already covers these modules and sets the convention: assert the re-exports are absent\n   AND that the canonical modules still expose them, so it cannot pass vacuously.\n5. Add a `docs/release-notes.md` entry naming the 3 moved import paths and their new\n   owning module.\n6. Correct the 2 stale locators in `docs/event-schema.md` to\n   `reducer/_processors_status.py:process_status` (`:234`) and\n   `reducer/_processors_status.py:_fold_claimed_session` (`:249`), matching `:82`'s form.\n\n## Testing\n\nNo behavior change: every moved name keeps its definition, only its import path moves.\nThe existing suite is therefore the oracle, with the held-out shim test as the direct\nassertion. `make verify` covers the reducer replay suites that exercise `_replay.py`'s\ndispatch, the one production consumer.\n\n## Acceptance criteria\n\n- [ ] **AC1** `grep -cF 're-exported for back-compat' src/rebar/reducer/_processors.py`\n      prints 0.\n- [ ] **AC2** Re-running the AST census reports 0 importers for all 7 names.\n- [ ] **AC3** `python -c \"from rebar.reducer import _processors as p; assert not any(hasattr(p, n) for n in ['_rederive_keyring_keys','process_key_event','process_signature','_fold_claimed_session','_fold_close_metadata','_fold_plan_review_phase','process_status'])\"`\n      exits 0.\n- [ ] **AC4** `python -c \"from rebar.reducer._processors_identity import process_key_event, process_signature; from rebar.reducer._processors_status import process_status\"`\n      exits 0.\n- [ ] **AC5** `python -c \"from rebar.reducer._processors import process_snapshot, attestation_kind\"`\n      exits 0.\n- [ ] **AC6** `ruff check src tests` exits 0 with no output.\n- [ ] **AC7** `pytest tests/unit/test_internal_shims_removed_3a46.py -q` exits 0.\n- [ ] **AC8** That file's collected case count is strictly greater than its count on\n      `origin/main`, measured with `pytest --collect-only -q` on both.\n- [ ] **AC9** `git diff --name-only origin/main...HEAD` lists exactly 12 paths:\n      `src/rebar/reducer/_processors.py`, `src/rebar/reducer/_replay.py`, the 7 named\n      test modules, `tests/unit/test_internal_shims_removed_3a46.py`,\n      `docs/release-notes.md`, `docs/event-schema.md`.\n- [ ] **AC10** `docs/release-notes.md` gains an entry naming all 3 moved import paths,\n      and that file's only diff is additions.\n- [ ] **AC11** `grep -cF '_processors.py process_status' docs/event-schema.md` prints 0.\n- [ ] **AC12** `grep -cF '_processors.py _fold_claimed_session' docs/event-schema.md`\n      prints 0.\n- [ ] **AC13** `grep -cF 'reducer/_processors_status.py:process_status' docs/event-schema.md`\n      prints 1, and\n      `grep -cF 'reducer/_processors_status.py:_fold_claimed_session' docs/event-schema.md`\n      prints 1.\n- [ ] **AC14** `make verify` exits 0.\n\n## Ordering\n\nIndependent of `insanitary-divine-moa` and `peckish-marmatite-cuckoo` — different\nmodules, no shared file. May land in any order relative to them.\n\n## Out of scope — checked, not merely unexamined\n\n- **`docs/event-schema.md:256`** names `_processors.py _clear_claimed_session`. That\n  locator is already wrong on `origin/main`: the symbol is defined at\n  `_processors_status.py:35` and was never re-exported. Pre-existing defect, not\n  breakage this slice introduces; tracked separately.\n- **`attestation_kind`**, imported from `_processors` by 5 files\n  (`verify_opcert.py:45`, `_opcert_signing.py:354` and `:437`, `_opcert_verify.py:176`,\n  `test_attestations_reducer.py:13`). Not a re-export — used at `:508` — so it stays.\n- **`test_plan_review_phase_reducer.py:63`** captures logs on logger\n  `\"rebar.reducer._processors\"`, emitted at `_processors.py:495` inside `process_snapshot`,\n  which stays. The string remains correct and must not change.\n- **`_field_contract.py:114`** prose names `rebar.reducer._processors.process_tag_delta`,\n  defined at `_processors.py:434`, which stays.\n- Any behavior change in the processors themselves.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/reducer/_processors.py","reason":"Delete the 7 back-compat re-exports and their noqa comments"},{"path":"src/rebar/reducer/_replay.py","reason":"Split the multi-line import; repoint 3 names to their defining modules"},{"path":"tests/unit/test_attestations_reducer.py","reason":"Repoint process_signature and process_status"},{"path":"tests/unit/test_claimed_session.py","reason":"Repoint process_status to _processors_status"},{"path":"tests/unit/test_harness_provenance.py","reason":"Repoint process_status to _processors_status"},{"path":"tests/unit/test_legacy_signature_mirror_drop.py","reason":"Split the import; process_snapshot stays at _processors"},{"path":"tests/unit/test_plan_review_phase_happy.py","reason":"Repoint process_status to _processors_status"},{"path":"tests/unit/test_plan_review_phase_reducer.py","reason":"Split the import; process_snapshot and the caplog logger name stay"},{"path":"tests/unit/test_signing.py","reason":"Repoint process_signature at both import sites"},{"path":"tests/unit/test_internal_shims_removed_3a46.py","reason":"Extend the held-out oracle to cover the 7 removed re-exports"},{"path":"docs/release-notes.md","reason":"Record the removed import paths, additions only"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","e12f-a994-29d3-4f72"]],"no_file_impact_reason":"","parent_id":"e12f-a994-29d3-4f72","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"19ba-bd62-1adb-41df","ticket_type":"story","title":"Repoint reducer _processors re-exports and delete them","verify_commands":[]},"source_event_uuids":["4b35704a-19c4-499a-b564-a499ce3a35f6","81dce7b1-fa5e-49e0-abed-07159c6bd5f7","11304576-c196-4a4b-a550-baaa8e027247","923f7399-5bc8-4f58-a081-4737b57fc0e8","6b605a5a-c827-42aa-b482-4d7a4f08fb41","91548d18-6af0-4b55-8716-1915d5c14d36"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793382409922680001,"uuid":"9f6ea7a3-e22b-4a4c-b0b6-ddf7a609c801"}