nsigned":0},"authorship_ledger":[{"content_hash":"58581c5f7a5ad2def82611fdd7fe98820917c492c36882224e6af504afcea118","event_uuid":"adcc444c-3d54-43c8-b10d-4e789a9bf74a","position":{"commit_sha":"34d5aefe661883f814e8eee1f18575be223f895b","position":"1788480050989538696-adcc444c-3d54-43c8-b10d-4e789a9bf74a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b97a345224fc0b1c5e7d8b28a6bab8c378d8d39780ca83da0a1e5aae6c9206d9","event_uuid":"d530ee6a-7b3b-4485-a7e3-933c23b35137","position":{"commit_sha":"cbdf3278852fd88809cd09eab440ab0d9a79d057","position":"1788481711241879202-d530ee6a-7b3b-4485-a7e3-933c23b35137"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"20dd3ec2057fca4cf05ac4d3728fd34e6f2c73bb39e3c554c0c5492e42e840e7","event_uuid":"c982bf72-ab7c-4976-a634-38aa1c8ae5ff","position":{"commit_sha":"cbdf3278852fd88809cd09eab440ab0d9a79d057","position":"1788481711257059028-c982bf72-ab7c-4976-a634-38aa1c8ae5ff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d11f075096326f33374d45b7b5aab6d52e7e7c1bb6c77737a860f609a38301f2","event_uuid":"8f9e52d5-0a96-487c-8263-ff8abd747c5a","position":{"commit_sha":"74fd8ab9551ca3a443170ab6a69adadbb3f9405b","position":"1788481737206071294-8f9e52d5-0a96-487c-8263-ff8abd747c5a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4c591f8f9c52e18193fc3764a828693af6ad5007a1afdbaea257608b5c3bfe9c","event_uuid":"fc117f50-e6a0-