{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788500259279220639,"compiled_state":{"alias":"forcible-diminished-lamb","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 08ab-60d2-3082-4b47","material: b00704474393fb8e","material-part: children 647ea2107ca5072f 0","material-part: description 53dae083473d13b1 7976","material-part: description_boxes 670af646a34cdc2a 0","material-part: file_impact 5fae6ed7286da34e 22","material-part: ticket_id 524f10ada2f763f5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:ebbcd7a030d6029216127c83fb43c415117af366","dep c52cadb0a14eb034174317a7a5f5fb4327687a757aa6bf6cd4e3fa6073d323bf .github/workflows/_optionality.yml","dep absent docs/adr/0111-terraform-structural-grounding.md","dep 323f2201183a3fe85794661c190f5ef8e395b23b08c956c989210069dce7a280 docs/grounding.md","dep f83c0f866a6349c32dc5e1b09c1847d6bc9cbcd38b6c4bac65c5f048519c415f pyproject.toml","dep c3ad9e18f485d57c67e77a9d4f888af97c9aede3666ebf6c72aba2c0c4e8ef05 src/rebar/_capabilities.py","dep f0dcc6c5ad32c7811c33fcbea8f5947444404d5672a97d4882c9d8456618bdf9 src/rebar/_optional.py","dep absent src/rebar/grounding/terraform_index.py","dep absent src/rebar/grounding/terraform_tools.py","dep 5d4f7abe273a6a28a1b10fcfd7ad562746a45cfc738303951002c32dda14fc47 src/rebar/llm/plan_review/pass1.py","dep cf8c6e6085285ae301a5aa3f20fba