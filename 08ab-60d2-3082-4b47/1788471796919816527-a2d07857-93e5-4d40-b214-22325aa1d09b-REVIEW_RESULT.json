entical digests for the freshness/receipt contract to hold.","group_criteria":null,"group_id":null,"id":"f9cc0e3d125de2754","impact":0.264,"is_primary":null,"location":"Operations and contracts — receipt fields; 'result_digest ... hashes canonical safe facts'","norm_id":"nb04d6c8ebdfad11b","priority":0.099,"reason":"veto:absence-refuted","recalled":false,"scenarios":["Two agents (Pass 1 and Pass 2) or two CI runs hash the same facts but serialize dict/list ordering differently, yielding divergent result_digest and a spurious freshness/receipt mismatch."],"severity":null,"suggested_fix":"Add one sentence to Operations and contracts: 'All digests are sha256 over a canonical UTF-8 JSON encoding with lexicographically sorted keys and no insignificant whitespace.'","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"58f9fad7523cd1ad","material_parts":{"children":["647ea2107ca5072f",0],"description":["bc884663e7391cfe",7902],"description_boxes":["670af646a34cdc2a",0],"file_impact":["5fae6ed7286da34e",22],"ticket_id":["524f10ada2f763f5",19]},"metrics