{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794955556787871508,"compiled_state":{"alias":"democratic-untiring-saiga","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"d89abfa4e16b33733ea3e2bba566c8abb2811ad6","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 8dc4-1541-92a7-4351","material: 8b2b7c88898d21f4","material-part: children 647ea2107ca5072f 0","material-part: description aaf4f034d8b81094 7973","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 2efca4a7fffb54f4 2","material-part: ticket_id 7379dced1ed0e4e1 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 20","review-phase: execution","priority-floor: 0.80","rebar-version: 0.16.0","regver: aa61189569d34126","verified-at-sha:d89abfa4e16b33733ea3e2bba566c8abb2811ad6","plan-material-pin: prerequisite 11aa-b3fb-f239-4f7a 72b330673b191f6c","plan-material-pin: prerequisite 4b2a-3ae8-14ee-463a 53286a6d7d2c6ea7","plan-material-pin: prerequisite bdf3-e7e3-c96f-4b9f 72cee11e95c682d8","dep absent src/rebar/_commands/reclaim_dry_run.py","dep absent tests/unit/test_reclaim_dry_run.py","read-set: 17","read-path: .github/workflows/verify-identity.yml","read-path: infra/scripts/reclaim_bridge_history.py","read-path: scripts/_mechanism_delta/detect_code.py","read-path: scripts/check_complexity_baseline.py","read-path: scripts/check_raw_git_writes.py","read-path: src/rebar/_cli/_parsers/core/reclaim.py","read-path: src/rebar/_commands/reclaim_collapse.py","read-path: src/rebar/_commands/reclaim_publish.py","read-path: src/rebar/_commands/verify_authorship.py","read-path: src/rebar/_config_schema.py","read-path: src/rebar/_config_sources.py","read-path: src/rebar/_store/reclaim_eligibility.py","read-path: src/rebar/attest/authorship_resolution.py","read-path: src/rebar/config.py","read-path: tests/integration/test_ci_tickets_partial_clone.py","read-path: tests/integration/test_reclaim_bridge_history.py","read-path: tests/unit/test_reclaim_collapse.py","currency-basis: file_impact"],"material_fingerprint":"8b2b7c88898d21f4","merged_log_commit":"d89abfa4e16b33733ea3e2bba566c8abb2811ad6","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794948462881439514}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"02399c2523c650583910ceea72e4cb3f5205433d83252dc8d75e88d78110c1ee","event_uuid":"b0a59d24-54f6-415e-a2b8-5e9a61510e9b","position":{"commit_sha":"1c3d70905faaf3c2bbfaebb400b3a629e94a8191","position":"1794874560841806197-b0a59d24-54f6-415e-a2b8-5e9a61510e9b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8c8516923e7f77aa806485f0a235d0b5196de7e395e7139fc494ab10deb652c3","event_uuid":"6418cc6e-1152-44a4-bd3b-6bea87470099","position":{"commit_sha":"0a8fb955b6abb9ca7b06f24b1c67308b2bc5e100","position":"1794874698791901553-6418cc6e-1152-44a4-bd3b-6bea87470099"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f93dbce45631d65defbfbe2dc927fb8965d0bcbc3a91652cd6037453682f3c85","event_uuid":"7b7a49f1-dc67-4d05-aa95-4099760c8730","position":{"commit_sha":"a36bd1fc20420c9c8fa7a17c67396e3717eef598","position":"1794874702863