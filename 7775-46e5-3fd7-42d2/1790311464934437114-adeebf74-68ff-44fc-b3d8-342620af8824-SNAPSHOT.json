{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1790311464934437114,"compiled_state":{"alias":"diet-capsizable-sparrow","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"0ca99c39f90892a276ea2ae3f2cde30911b76466","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 7775-46e5-3fd7-42d2","material: 34f0fdf918a3c97d","material-part: children 647ea2107ca5072f 0","material-part: description 7e53fbe643f0c7c3 6412","material-part: description_boxes c1351524deb82257 0","material-part: file_impact 732126eb9555758f 3","material-part: ticket_id 45294e3c8b461d32 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:1be63283dd546f35208ade506f9959500b0b14ea","dep a41552eb0966dd77291f88e35dc5ec325ff69cd3c38c37443e43a77aaeda6be6 infra/terraform/bedrock-spend-cap/handler.py","dep 1b9ccdc2e1d016d118a0c0b09f0fe697ceab32a34af747ab7c7c9849806129fc infra/terraform/bedrock_spend_cap.tf","dep 60a971296cf1fd2e6f583ca29793b1325a0bba17627211bfab6b060819e3ef3b tests/infra/test_bedrock_spend_cap_handler.py","read-set: 3","read-path: infra/terraform/bedrock-spend-cap/handler.py","read-path: infra/terraform/bedrock_spend_cap.tf","read-path: infra/terraform/versions.tf","currency-basis: file_impact"],"material_fingerprint":"34f0fdf918a3c97d","merged_log_commit":"1be63283dd546f35208ade506f9959500b0b14ea","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1790305457812685615}},"author":"Rebar Bot","author_emai