985450662eeccaf77ae1d669b622ce1cf13e11f3","position":"1790303461686932124-2164c18a-cf47-4403-9319-1f1e1ac12928"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3d10f790a8f6e4356deab7273005c16696e69a80a3173a8b391f828b636f50c7","event_uuid":"148f1a59-71d2-4c81-9127-dfd545a3a4c8","position":{"commit_sha":"f2c33a1ec17eee5f3df8e5636d27129f76e63709","position":"1790305204372601455-148f1a59-71d2-4c81-9127-dfd545a3a4c8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"64f35f5fbd32b53a4deb35a4786fc0bef5e5b7cdac51617a5bc43e1b5b673d43","event_uuid":"38cf939c-4b88-4926-aeab-b6d7e0f9c0f3","position":{"commit_sha":"a43acc9e3a39fd61e3b314f3a14c089df333786f","position":"1790305457812983688-38cf939c-4b88-4926-aeab-b6d7e0f9c0f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"34ae1373d0f3268a58701a5f060edee9bb8f68080dc4f06f8d20fb2df1411d14","event_uuid":"ff08bdbe-338f-44d9-b858-81b6f17f4bee","position":{"commit_sha":"84fbe91f9e3bb8cd5b050f27f6c9b31d26f23697","position":"1790305536122276976-ff08bdbe-338f-44d9-b858-81b6f17f4bee"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"16f0fea42c70766a1ebaa3caf6c44b07c140b204b42547d55d599fed5acc28b1","event_uuid":"08b3b4c5-9cd8-4ac9-a44a-9c738ca8af40","position":{"commit_sha":"84fbe91f9e3bb8cd5b050f27f6c9b31d26f23697","position":"1790305536149154277-08b3b4c5-9cd8-4ac9-a44a-9c738ca8af40"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b7de1d1588f8bf7e5bdf9394688ab54926f6a0a1d1ec741b23d247f558243822","event_uuid":"d65d24e3-ccfc-4788-9fbd-8b677bea10b0","position":{"commit_sha":"98d771e16d2eaec7dbcc867c5eb07af8bfa9f2b3","position":"1790308337828214703-d65d24e3-ccfc-4788-9fbd-8b677bea10b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e011eccea7b5f6e4e4418a99e01fd8b7530318200839982e77c6a869f1a29b42","event_uuid":"be5939ee-72f1-4500-80df-42aac6382233","position":{"commit_sha":"ffea0f3b74346a1a4435b94629ee8b13d60d371e","position":"1790311464934437113-be5939ee-72f1-4500-80df-42aac6382233"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC 1 satisfied. Re-ran the undimensioned-versus-per-ModelId token equivalence over\na fresh ten-day window, 2026-09-15 to 2026-09-25, per region and per metric.\nExactly equal in all eight comparisons, so the undimensioned read is safe to ship\nand no escalation is needed.\n\n    us-east-1  InputTokenCount              48,847,172 == 48,847,172\n    us-east-1  OutputTokenCount             21,243,452 == 21,243,452\n    us-east-1  CacheReadInputTokenCount    783,742,147 == 783,742,147\n    us-east-1  CacheWriteInputTokenCount   110,298,792 == 110,298,792\n    us-west-2  InputTokenCount                      12 == 12\n    us-west-2  OutputTokenCount                      4 == 4\n    us-west-2  CacheReadInputTokenCount              0 == 0\n    us-west-2  CacheWriteInputTokenCount             0 == 0\n\nThis is a different window from the one in the plan (2026-09-14 to 09-24), so it is\nan independent confirmation rather than a restatement.\n\nCEILING derived from the trailing 60 days of Cost Explorer as 1.25x the highest\nper-token rate per direction, classifying Bedrock rows by the same predicate the\nhandler will use. The binding model is Claude Opus in every direction — 4.8 for\ninput and cache-write, 4.7 for output, 4.5 for cache-read — which is the expected\nresult, since Opus is the priciest family in use. Values go in the code with the\nderivation commented beside them; the figures themselves stay out of the tracker\nper the machine-local policy.","timestamp":1790308337828214703}],"created_at":1790270993411121757,"creation_channel":"mcp","deps":[{"link_uuid":"d5e10748-cb22-45c5-8ff6-328908dd4aee","relation":"relates_to","target_id":"3083-ada3-3a0f-4051"},{"link_uuid":"be5939ee-72f1-4500-80df-42aac6382233","relation":"relates_to","target_id":"b94b-9573-e6ac-4419"}],"description":"## Problem\n\nThe handler prices CloudWatch token counts with a Cost-Explorer-derived rate table\nmatched to models by substring and suffix heuristics. That layer produced four\ndefects in the twelve days after deployment (2026-09-12): a direction-suffix\ncollision in `_rate_for`/`_match`, a `_normalise` label/id mismatch, the\n`BEDROCK_SERVICE_VALUES` allowlist omitting five live services, and\n`MARKETPLACE_TOKEN_SUFFIXES` handling only CamelCase. Two reached production\nunalarmed, one for seven days. They are one class — matching model identifiers\nagainst billing labels — so this story deletes the class, not the instances.\n\n## Approach\n\nPrice every token at a ceiling rate for its direction, above the highest rate\nobserved on this account, so the estimate is an upper bound and the cap cannot fire\nlate. Per UTC day:\n\n    spend = max( sum over regions and the four token metrics of\n                   undimensioned CloudWatch Sum * CEILING[metric],\n                 ce_spend )\n\n`THRESHOLD_USD` is deliberately left unchanged. Scaling it up to centre the metered\narm would raise the bar for `ce_spend` too, and `ce_spend` is real billed dollars —\nthe authoritative arm would then trip late, which is the failure mode this story\nexists to remove. Unscaled, the CE arm trips at exactly the configured cap and the\nmetered arm trips early, both safe directions.\n\nCost Explorer stays in enforcement: it is the only signal covering Bedrock spend\nthat publishes no token metric, and it is orthogonal to all four defects.\n`BEDROCK_SERVICE_VALUES` is currently the `Filter.Dimensions.Values` list of that\nrequest, so the request is re-issued with no SERVICE filter, grouped by SERVICE, and\nthe predicate classifies the returned groups.\n\nThe undimensioned series is requested with `Dimensions: []` (omitting the key is\nnot equivalent). It matched the per-ModelId sum exactly over 2026-09-14 to 09-24,\n930,831,660 tokens both ways — an external-system assumption AC 1 re-verifies.\n\nAn all-empty read is ambiguous: both a metrics gap and the idle/new-day state\nrelease depends on. CE cannot disambiguate it, lagging 8-24h. The handler persists\nthe day's high-water token total keyed by UTC date; the criteria give the four\ndispositions. It governs release only, so a gap cannot manufacture a trip.\n\nCeiling pricing over-estimates cheap models — the cheapest here by two orders of\nmagnitude, and two bill nothing for cache-write — so an embedding job can trip the\ncap at a fraction of intended spend. Accepted; the remedy is an exact-match\n`{ModelId: rate}` override, equality only. Fixtures, the drift guard, the README\nand the `ListMetrics` re-grant are the dependent story be3d-712b-c1ac-442b.\n\n## Figures\n\nBill figures are barred from the tracker; the tickets branch is public.\n`CEILING[d]` is 1.25x the highest per-token rate for direction `d` across all\nBedrock services in the trailing 60 days of Cost Explorer. No other figure changes.\n\n## Acceptance Criteria\n\n- [ ] The undimensioned-versus-per-ModelId equivalence is re-run over a fresh\n  ten-day window and is exactly equal per region and metric; on divergence the work\n  halts and escalates. Checked: output recorded as a comment here.\n- [ ] `_refresh_rates`, `_rate_for`, `_seed_for`, `_normalise`,\n  `_strip_billing_region`, `_marketplace_rate_key`, `_rate_key_for_ce_group`,\n  `SEED_RATES`, `RATE_OVERRIDES`, `BEDROCK_SERVICE_VALUES`,\n  `MARKETPLACE_TOKEN_SUFFIXES`, `UNKNOWN_RATE_PER_1K`,\n  `MARKETPLACE_TOKENS_PER_RATE_UNIT` and the `TOKEN_METRICS` multipliers are absent.\n- [ ] The now-unreferenced `re` and `typing.Literal` imports are removed.\n- [ ] The module docstring no longer describes a derived rate table, seed rates,\n  `UNKNOWN_RATE_PER_1K` or a daily refresh.\n- [ ] `tests/infra/test_bedrock_spend_cap_handler.py` is rewritten: the harness\n  stops setting `UNKNOWN_RATE_PER_1K`, stubbing `_refresh_rates` and constructing\n  `metered_estimated`, and no test references a removed symbol.\n- [ ] `_metered_spend` issues exactly four undimensioned `GetMetricData` queries per\n  region, each sending `Dimensions: []`, and calls no `list_metrics`.\n- [ ] `cloudwatch:ListMetrics` is removed from the role's `ReadSpendSignals`\n  statement, leaving `ce:GetCostAndUsage` and `cloudwatch:GetMetricData`.\n- [ ] `CEILING` gives one rate per token metric, each at least the highest for that\n  direction over the trailing 60 days of CE, with the derivation commented beside it.\n- [ ] Enforcement compares `max(ceiling_estimate, ce_spend)` against an unchanged\n  `THRESHOLD_USD`. Checked: a test asserting a `ce_spend` at the cap trips, proving\n  the authoritative arm is not scaled.\n- [ ] `_ce_spend_today` issues its Cost Explorer request with no SERVICE filter,\n  grouped by SERVICE, and sums only the groups its predicate accepts — service\n  equals `Amazon Bedrock` or ends with the Bedrock Edition suffix. Checked: a test\n  over a stub carrying all ten live services and one non-Bedrock service.\n- [ ] The day's high-water token total is persisted keyed by UTC date.\n- [ ] An empty read with today's key present and zero-valued may release.\n- [ ] An empty read after a nonzero reading that day holds the deny.\n- [ ] An empty read with today's key absent and a deny attached holds the deny.\n- [ ] A partial-region failure holds the deny.\n- [ ] Any exception from a metered or CE read fails closed.\n- [ ] The `SEED_RATES`, `RATE_OVERRIDES`, `UNKNOWN_RATE_PER_1K` and\n  `RATE_WINDOW_DAYS` env entries are deleted with whichever `variable` or `locals`\n  blocks are left unreferenced; `terraform plan` shows exactly those deletions and\n  the IAM removal, with no threshold change, and `terraform validate` passes.\n- [ ] `state[\"rates\"]`, `state[\"rates_day\"]`, `metered_estimated`, `MeteredRate`\n  and its `RateSource` alias, and the `\" (estimated)\"` rendering are removed.\n\n## Testing\n\n`env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/infra/test_bedrock_spend_cap_handler.py -q`\nproves every criterion except the Terraform ones, proved via\n`python3 scripts/terraform_prod.py plan --out <scratch>/plan.tfplan` and\n`terraform validate`, and the unused imports, proved by `make lint`.\n`make lint`/`make typecheck` gate commits; `make verify` runs before push.\n\n## Rollback\n\n`DRY_RUN=true` halts attach and detach while keeping the function observable. Full\nback-out: revert the change and re-run the mediated plan and apply, restoring prior\ncode, env and IAM exactly.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/terraform/bedrock-spend-cap/handler.py","reason":"Delete the seven pricing functions and six constants; replace _metered_spend with four undimensioned aggregates priced at CEILING; keep max(ceiling, ce); predicate-classify CE services; add the high-water-mark release discriminator, partial-region hold, exception fail-closed and old-state tolerance; drop the rate keys, MeteredRate and RateSource"},{"path":"infra/terraform/bedrock_spend_cap.tf","reason":"Set threshold and warning values; delete the SEED_RATES, RATE_OVERRIDES, UNKNOWN_RATE_PER_1K and RATE_WINDOW_DAYS env entries and whichever variable/locals blocks are left unreferenced"},{"path":"tests/infra/test_bedrock_spend_cap_handler.py","reason":"Cover the absent names, four-queries-per-region, no list_metrics, the max() arms, the CE predicate over all ten live services, and the four release/failure dispositions including old-state tolerance"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","3083-ada3-3a0f-4051"],["relates_to","b94b-9573-e6ac-4419"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ff08bdbe-338f-44d9-b858-81b6f17f4bee","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["bedrock","cost","infra","simplification"],"ticket_id":"7775-46e5-3fd7-42d2","ticket_type":"story","title":"Price the Bedrock spend cap at a per-direction ceiling and delete the pricing-derivation layer","verify_commands":[]},"source_event_uuids":["391aa288-9525-44f2-92a1-f2f10db13836","35722a29-60fa-4042-a964-8abda1f01ec0","fd2116a9-f5b1-4785-8b90-20c10f3a5101","ffcdd937-5746-42ad-a7ba-fd544d2b932f","a62d8321-9ec3-4400-94b3-8a2532173855","3a4fff52-a7fe-4925-90f3-1c57c7aeb5e9","b8212a6c-119e-4431-aa9d-379466f3622b","2657f8d4-8831-4842-aea3-8089ab5c32e4","2164c18a-cf47-4403-9319-1f1e1ac12928","148f1a59-71d2-4c81-9127-dfd545a3a4c8","38cf939c-4b88-4926-aeab-b6d7e0f9c0f3","ff08bdbe-338f-44d9-b858-81b6f17f4bee","08b3b4c5-9cd8-4ac9-a44a-9c738ca8af40","d65d24e3-ccfc-4788-9fbd-8b677bea10b0","be5939ee-72f1-4500-80df-42aac6382233"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1790311464934437114,"uuid":"adeebf74-68ff-44fc-b3d8-342620af8824"}