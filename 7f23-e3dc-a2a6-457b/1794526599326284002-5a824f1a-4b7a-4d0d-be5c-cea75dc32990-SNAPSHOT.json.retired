{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794526599326284002,"compiled_state":{"alias":"naughty-analytical-crossbill","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"7bcc3560efdb5cf777a5911a8a2e20f9c2ceab8c","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 7f23-e3dc-a2a6-457b","material: e8329e5538192b28","material-part: children 647ea2107ca5072f 0","material-part: description 8cd37acc03528f3e 7330","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 102860f2930068f0 6","material-part: ticket_id b4f155c40277b655 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 8","review-phase: planning","rebar-version: 0.15.1 (7bcc3560efd)","regver: aa61189569d34126","verified-at-sha:7bcc3560efdb5cf777a5911a8a2e20f9c2ceab8c","dep c2d94086f5c0d2593fda47e9479cd1c07ea8c6ca92ea8fe6ac536d904bd57693 .github/workflows/external-integration.yml","dep 3d0de9f39939754c7f6867a380e70de3b5f4249e112d41d028483d5e3974130d tests/external/live_jira_cloud_mutation/README.md","dep 6b8cae9082cfa59bd64ac64ec6572b7e073d23ce661cbd45e2ee72a53e3b4aa5 tests/external/live_jira_cloud_mutation/_cloud_mutation_support.py","dep 58bd64e88814018405fd0882d279e1fc3414b520a9fe612b52e6e7d2378053ec tests/external/live_jira_cloud_mutation/conftest.py","dep absent tests/external/live_jira_cloud_mutation/test_cloud_fix_versions.py","dep 71063ee6ee124ba91bc945649727f95828ca94205055400653c6a2cdeee3684f tests/unit/test_external_integration_cloud_mutation_workflow.py","read-set: 29","read-path: .github/workflows/external-integration.yml","read-path: src/rebar/_lib_mutations.py","read-path: src/rebar/reconciler/access_check.py","read-path: src/rebar/reconciler/adapters/jira/acli_graph.py","read-path: src/rebar/reconciler/adapters/jira/acli_rest.py","read-path: src/rebar/reconciler/apply_phase.py","read-path: src/rebar/reconciler/apply_planning.py","read-path: src/rebar/reconciler/binding_walk.py","read-path: src/rebar/reconciler/config.py","read-path: src/rebar/reconciler/differ.py","read-path: src/rebar/reconciler/guarded_pass.py","read-path: src/rebar/reconciler/inbound_differ.py","read-path: src/rebar/reconciler/load_phase.py","read-path: src/rebar/reconciler/mode.py","read-path: src/rebar/reconciler/outbound_labels.py","read-path: src/rebar/reconciler/outbound_mutation_builders.py","read-path: src/rebar/reconciler/outbound_pass.py","read-path: src/rebar/reconciler/outbound_releases.py","read-path: src/rebar/reconciler/pass_support.py","read-path: src/rebar/reconciler/release_alerts.py","read-path: src/rebar/reconciler/request.py","read-path: src/rebar/reconciler/run_differs.py","read-path: src/rebar/reconciler/snapshot_lagfree_refresh.py","read-path: tests/external/live_jira_cloud_mutation/README.md","read-path: tests/external/live_jira_cloud_mutation/_cloud_mutation_support.py","read-path: tests/external/live_jira_cloud_mutation/conftest.py","read-path: tests/external/live_jira_dc/_dc_support.py","read-path: tests/unit/reconciler/test_release_alerts.py","read-path: tests/unit/test_external_integration_cloud_mutation_workflow.py","currency-basis: file_impact"],"material_fingerprint":"e8329e5538192b28","merged_log_commit":"7bcc3560efdb5cf777a5911a8a2e20f9c2ceab8c","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1794526493407942000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":12,"unsigned":0},"authorship_ledger":[{"content_hash":"6ae1afba379674573712b37094c3cddeaf2ed