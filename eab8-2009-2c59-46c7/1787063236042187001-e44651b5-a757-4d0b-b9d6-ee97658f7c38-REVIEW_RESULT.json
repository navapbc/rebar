r — the approach deliberately chosen and documented in ADR-0098 (principle 4, reference R20) — with a hand-rolled stdlib carrier, without reconciling the existing documented decision or addressing the JSON/serialization-masking property that ADR-0098 explicitly attributed to SecretStr.","group_criteria":null,"group_id":null,"id":"f4c18918acf18e45a","impact":1.0,"is_primary":null,"location":"Repair plan, bullet 1 ('Replace the Pydantic SecretStr dependency in runtime.py with a frozen stdlib credential carrier')","norm_id":"nd7ff8aa71dbbed1d","priority":0.8889,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A future serializer or JSON dump of ReconcilerSettings/StaticAuth relies on the SecretStr-provided serialization masking that a bare stdlib dataclass field does not automatically supply","Reviewers of the ADR find the recorded R20 decision silently contradicted by the implemented runtime"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"low","likelihood":"medium","prod_impact":"low","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false