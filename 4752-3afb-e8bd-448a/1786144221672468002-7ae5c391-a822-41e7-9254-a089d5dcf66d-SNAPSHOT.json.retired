{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786144221672468002,"compiled_state":{"alias":"chaste-natant-harpseal","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"bd3e4f97b6868b44d57a809ed66a263a51f8a9b1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4752-3afb-e8bd-448a","material: f8c5609365c4dd67","material-part: children 4d0a7879ad4dde93 1","material-part: description 6d27d4c3317f9c26 3246","material-part: file_impact 6ee80663948a535d 9","material-part: ticket_id 7381b80cd067d0c6 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (bd3e4f97b6)","regver: 368938c5729d4170","verified-at-sha:998efb1615415ff81e259e91766f43b75b17d045","plan-material-pin: child b42a-ffc3-deeb-4491 9736b07615475ac3","dep c858eb107b8bae3057c4f925a68f8ad2750727066bea133c3cb2406343a5dbeb docs/cli-reference.md","dep 8ea262a3110a89fb8f81bd86ecc7e4bdec97ad80b800b8900fdcaf3428c99ba4 docs/exit-codes.md","dep eed8519bad35992d20131d4b5f3b65fe38589e7f5a4aa11fa1085c3a86148ee1 docs/release-notes.md","dep 28379af0a6a0fb79b0edc9437c66a4edd672e22d358a45cd1aee0923a3777660 docs/user-guide.md","dep 1b335767d4c8c64ec0168caf754d99ebc27b045dba7286a6463429ade6669fa1 scripts/gen_cli_reference.py","dep 532ca34479f2a4bf3c446859b33858a2baa8f3bc730ed9f4b7a37cb623bf59ec src/rebar/_cli/__init__.py","dep absent src/rebar/_cli/_bridge_commands.py","dep absent src/rebar/_cli/help/bridge.txt","dep 1097ac10c0338c20912c147a86445d64c441c1f44a402611f09383a7e3c4eb18 src/rebar/_cli/help/overview.txt","dep e1e07706c092a8aaea0f11af63a8ef9d342b5befcf08ec2a7dcef552ba553601 tests/interfaces/contracts/test_help_overview_coverage.py","dep absent tests/interfaces/facades/test_bridge_cli.py","dep 38b4731c35ac1a05a426127d67748c2d8f4c5591f6c3bee18f5e6a6360a31ca1 tests/unit/test_gen_cli_reference.py"],"material_fingerprint":"f8c5609365c4dd67","merged_log_commit":"998efb1615415ff81e259e91766f43b75b17d045","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1786144176438133000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"0a7d7ef343698c5ebc1e0aa0aec9c5954f4a4fbb8721fa2c98d0dd9e0dc39cb0","event_uuid":"7dca94a3-8896-4dc1-a91d-e29fef92a674","position":{"commit_sha":"3e4568508c5c83d7417ec6b4ecdd9c3c783f2607","position":"1786047482259664001-7dca94a3-8896-4dc1-a91d-e29fef92a674"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bb1da389e753d7bb37566d1ac20e92da96e6af66dd249e0104b91904c9c4bcf6","event_uuid":"f1d0a683-cd08-45cf-bdd8-b4b466c71d12","position":{"commit_sha":"26b9307555c720cd62f33f58c2c05a9c82dd56c7","position":"1786082258096644001-f1d0a683-cd08-45cf-bdd8-b4b466c71d12"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"18d3c29133876df9fe2e1090ade3bfa993a23fb8cc23ef728db08b2b8f52c251","event_uuid":"d24a8c50-e658-4b6a-bd9a-f2384164b6aa","position":{"commit_sha":"fd7ba2e4