ries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_autodeploy_signals_nginx_materializer.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_canary_bridge.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_check_adr_numbers.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_check_config_ownership.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_check_config_ownership_heldout.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."},{"path":"tests/scripts/test_check_config_reads_heldout.py","reason":"Shared Group15 Gerrit 3084 commit carries sibling comment remediation; this path is outside syllabic-humoristic-tarantula's owned Scope."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","2d43-3c39-307e-4450"],["relates_to","4adf-20fe-3f02-4164"],["relates_to","5f67-844a-4162-445f"]],"no_file_impact_reason":"","parent_id":"2d43-3c39-307e-4450","parent_status_uuid":"1f82ef10-c48a-401b-879b-1684149366a8","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"f669-d70d-28f0-46c7","ticket_type":"task","title":"Condense comments in tests/scripts/graph","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, io, re, subprocess, sys, tokenize\nBASE=\"9800670821a3e25f3301026c0fb1271b1176e20a\"\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\ndef source(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(source,path):\n tree=ast.parse(source,filename=path,type_comments=True)\n for node in ast.walk(tree):\n  if isinstance(node,(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)) and node.body:\n   head=node.body[0]\n   if isinstance(head,ast.Expr) and isinstance(head.value,ast.Constant) and isinstance(head.value.value,str): node.body.pop(0)\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(source):\n lines=source.splitlines()\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\",[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(source).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)])\nfor path in sys.argv[1:]:\n before=source(BASE,path); after=source(\"HEAD\",path)\n assert norm(before,path)==norm(after,path),f\"runtime AST changed: {path}\"\n assert protected(before)==protected(after),f\"directive/shebang changed: {path}\"\nprint(f\"parent-to-final AST/directive PASS: {len(sys.argv)-1} paths\")' tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"parent-prose-only","dd_text":"Grouped parent and final commit preserve executable AST and directive/shebang lines on every declared path."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys\nactual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nexpected=set(sys.argv[1:])\nassert actual==expected,f\"changed paths differ: missing={sorted(expected-actual)} extra={sorted(actual-expected)}\"\nprint(f\"exact grouped paths PASS: {len(actual)}\")' tests/_bank_observer.py tests/_child_diag.py tests/_extra_guard.py tests/_git_counts.py tests/_git_floor.py tests/_git_upkeep.py tests/_isolation.py tests/_jira_shape_contract.py tests/_live_jira_confinement.py tests/_log_integrity.py tests/_nested_pytest.py tests/_repo_root.py tests/_stall_remote.py tests/_subprocess_isolation.py tests/_topology_template.py tests/_tree_scan.py tests/conftest.py tests/module_size_support.py tests/scripts/conftest.py tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py tests/scripts/test_alert_dedup.py tests/scripts/test_autodeploy_disk_pressure.py tests/scripts/test_autodeploy_fetch_secrets.py tests/scripts/test_autodeploy_health_gate.py tests/scripts/test_autodeploy_materialize_certbot.py tests/scripts/test_autodeploy_materialize_probe.py tests/scripts/test_autodeploy_mcp_bluegreen.py tests/scripts/test_autodeploy_review_drain.py tests/scripts/test_autodeploy_signals_gerrit_config.py tests/scripts/test_autodeploy_signals_nginx_edge.py tests/scripts/test_autodeploy_signals_nginx_materializer.py tests/scripts/test_canary_bridge.py tests/scripts/test_check_adr_numbers.py tests/scripts/test_check_config_ownership.py tests/scripts/test_check_config_ownership_heldout.py tests/scripts/test_check_config_reads_heldout.py","dd_id":"exact-grouped-paths","dd_text":"The grouped commit changes exactly the 47-path union of the 3 claimed leaves."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Repository comment-history hygiene passes."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"focused-contracts","dd_text":"Focused current consumers of edited prose pass."},{"command":"git diff --check HEAD^ HEAD -- tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"diff-integrity","dd_text":"Owned-path patch has no whitespace errors."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"Complete local CI contract passes without a timeout."}]},"source_event_uuids":["ea9606e6-c6fb-4b9d-ac9d-7f3fb89002cc","2c752633-cf70-454c-b9c1-a199f43dd57f","1b14b8cb-de74-4fd7-9ab5-ed5e9ea2209b","dab12574-a8c9-4ec5-b5dd-1845da0940a5","5fcf7b17-3834-4698-a42f-f723f0142313","3e2d048a-112f-4d57-950b-27e5d6c8d9fe","c1046230-84ec-4f5c-8d19-62830b2c6bea","fda55aaa-6cd6-4923-b8d0-973a2ae90359","ed7134d4-2bac-478a-9f23-5f48650f912f","7a6c0595-3741-4313-8c87-5f6d1d0cd909","16d24d48-065a-491e-8d4f-9b823954e59a","97a1761d-229d-4a15-b936-9b38a64334ac","9b081b8a-6c3d-4473-bf73-2f8e68c90b0e"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1792799992901291976,"uuid":"0114eb5e-51f0-473e-9642-7f28d3660555"}