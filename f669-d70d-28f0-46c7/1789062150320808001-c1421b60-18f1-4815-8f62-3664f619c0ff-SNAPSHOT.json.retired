2ba12fc310ef7c619240cfd811ab1264","position":"1789042024816315001-3c34a1dc-48d9-41bc-964c-7e8a88dcdae8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bcac3911e37d461532052ee2c9836b35678f5e6cd3ce02a171a298d977ef793b","event_uuid":"b6ef42d5-27e8-42bb-be6c-fe216d174908","position":{"commit_sha":"f1d9acc04c638a7d3ac652993c9c00bea6d62a16","position":"1789047554300791001-b6ef42d5-27e8-42bb-be6c-fe216d174908"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Candidate authored at d53c88a5a7cdd941a5d01ca4926aaa4c87d9cb5a from parent 8ded030769729557c9ba9ca441b26f306b257d94 in /Users/joeoakhart/comment-remediation-f669-20260910-a. Exactly the 12 declared paths changed; automated 91-row scope audit reports every scoped block shorter (5,007 -> 1,275 words) and every unscoped comment/docstring exact. Immutable-base allowlisted normalized-AST/runtime and protected directive/shebang oracle PASS. Comment hygiene, path-scoped diff-check, Ruff/format, mypy commit gate, verify-commit-ticket, and 124 focused hermetic tests PASS. Local make verify intentionally omitted per operator direction; Gerrit Verified will supply repository-wide CI. An orphaned prior /Users/joeoakhart/comment-remediation-f669 worktree with six uncommitted paths was preserved unchanged and its more concise wording incorporated read-only. Awaiting independent non-author exact-SHA TSV review before push.","timestamp":1789042024816315001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Policy-corrected final candidate is d4f7f39fcccd2997e38de7dc6cb18c00037bfc1d with Change-Id I964144cad7d1b7e9984ffe6fd684425735f8b2b4. The worktree is clean and the change is not yet pushed. Against this exact SHA, the immutable-base normalized-AST/runtime/directive/shebang guard, exact 12-path scope, comment hygiene, path-scoped diff integrity, and verify-commit-ticket all PASS; the focused graph suite reports 124 passed. Independent inventory confirms exactly 80 changed docstrings and 11 changed ordinary-comment blocks, 91 total, reduced from 5,007 to 1,289 words with every block shorter. The final added prose contains none of the documentation-policy punctuation or banned-term patterns. Per operator direction, make verify remains intentionally omitted and Gerrit CI will provide the repository-wide gate. Awaiting a non-author exact-SHA 91-row TSV review before push.","timestamp":1789047554300791001}],"created_at":1788571180695809501,"creation_channel":"mcp","deps":[{"link_uuid":"5b078df0-2882-4b8b-9c8b-beb8a930be0f","relation":"supersedes","target_id":"a809-9283-9eab-4677"},{"link_uuid":"556bb565-a920-49b3-93bf-4f95f8d9ec96","relation":"supersedes","target_id":"35ba-aa2b-6ade-4a07"},{"link_uuid":"5674e0ad-86cd-491f-a9ec-42bef7405a66","relation":"supersedes","target_id":"4a67-1079-89b8-47ec"},{"link_uuid":"cc18a3f2-8a08-4435-bf74-1465a5ce91c8","relation":"supersedes","target_id":"a6c4-a2a1-2c51-4015"},{"link_uuid":"257e74fc-d7b2-4878-97be-417c8f56ca50","relation":"supersedes","target_id":"d65c-2b80-fbff-4d97"},{"link_uuid":"7e087428-03be-4c85-963c-d02d3b511187","relation":"supersedes","target_id":"3c14-4da9-c62a-4f61"},{"link_uuid":"2dfc4a8d-9224-452d-9b3d-1c7cb9417b6c","relation":"supersedes","target_id":"2c40-da47-94d3-4aa1"},{"link_uuid":"af974afe-5f90-41ae-97fb-5600b6975613","relation":"supersedes","target_id":"c161-a0f0-1273-479e"},{"link_uuid":"4c74b2dd-b68e-4570-b80d-8ffe3737872b","relation":"supersedes","target_id":"b839-fc34-fb98-4f9b"},{"link_uuid":"11455a37-fa60-498e-bf30-3c713ab0ea6a","relation":"supersedes","target_id":"4ecf-b2fa-b3fa-4e60"},{"link_uuid":"68f19232-f3cf-4344-bae3-52d02e56f9fd","relation":"supersedes","target_id":"7eb6-75c8-322f-4c94"},{"link_uuid":"d4fc4cd7-6c47-4d8d-9477-4beb36dc15e7","relation":"supersedes","target_id":"565f-b974-e609-40ac"},{"link_uuid":"58f147f6-d530-4754-ba8e-92aaad30396c","relation":"relates_to","target_id":"5f67-844a-4162-445f"}],"description":"## Context / Problem\nTwelve `tests/scripts/graph` files contain 91 audited prose blocks with repetition, history, or obvious narration. Scope and behavior were revalidated against immutable commit `0033662b5534531d84e39d4a14bf75c8e768e85e`. The later `origin/main` advance to `10533b1e3f651a60e8cea5691318c108ff1f3396` does not touch these targets and is irrelevant to the citations. `test_graph_perf.py` changed since the superseded `9e65567b79ffe872534c3c656ade7b34340d8192` audit; the allowlist includes its new shim-absence test and post-refactor comment.\n\n## Approach and identity\nCondense only allowlisted ordinary comments and true leading docstrings. Preserve all runtime strings, prompts, fixtures, decorators, assertions, subprocess arguments, and executable behavior. Stable block IDs are `path::module-docstring`, `path::<qualified-symbol>-docstring`, or `path::<qualified-symbol>::comment(<opening words>)`; use `<module>` as the owner for module-level comments. The line spans below are immutable base citations, never the identity anchor. Adjacent blank-line cleanup is allowed only when attached to an edited block.\n\nFor each declared path, compare the immutable `0033662b5534531d84e39d4a14bf75c8e768e85e:<path>` blob directly with the final leaf commit, even if the implementation branch is based on a later main. Parse with `type_comments=True`; remove only allowlisted leading docstrings from `ast.Module`, `ast.ClassDef`, `ast.FunctionDef`, and `ast.AsyncFunctionDef` by their qualified-owner anchors; normalize only `ast.TypeIgnore.lineno`; and require the remaining AST to match. This preserves runtime strings and every executable expression. Tokenize comments and compare every matched directive-bearing physical line plus any shebang byte-for-byte. The exact leaf changed-path set (`HEAD^..HEAD`) must equal the first-class `file_impact` set.\n\n## Scope — immutable base citations\n- `_helpers.py:1-7,89-93,115-119` — preserve LINK direction/storage and ARCHIVED semantics.\n- `conftest.py:1-6,31-48,69-81` — preserve parent-repository discovery isolation and graph fixture ownership.\n- `test_doctor_locks.py:1-15,36-41` — preserve live-holder informational status, stale-holder findings, and host-global snapshot-root isolation.\n- `test_doctor.py:1-8,345-356,461-472,628-639` — preserve link-before-unlink safety, rollback-anchor refresh, the non-reentrant lock rule, and continue-on-unrepairable behavior.\n- `test_graph_children_archive.py:1-6,28-33,76-89,128-139,172-189,221-233,255-259,265-278,309-321` — preserve archived filtering, transitive traversal, and redundant-edge-versus-cycle distinctions.\n- `test_graph_cycles.py:1-6,32-36,51-55,72-76,94-103,129-140,157-166,181-189,200-202,262-271,336-352,383-395,411-417` — preserve level-scoped traversal, hidden-directory exclusion, virtual/missing endpoint behavior, and accumulator termination.\n- `test_graph_hierarchy_adddep.py:1-6,29-44,88-96,112-117,161-170,206-215,247-257,301-307,361-365,427-430,438-443,487-493,513-518,546-551,591-597,625-631` — preserve structural promotion, relation grammar, quiet MCP behavior, and returned redirect records.\n- `test_graph_hierarchy_resolve.py:1-6,26-35,64-81,111-129,160-168,194-201,223-231,251-255,280-285,337-345,352,370-385,409-413,421-427,451-456,483-488,508-513,534-540` — preserve NCA-based resolution, virtual-root behavior, ancestor refusal, the non-blocking carve-out, and cycle termination.\n- `test_graph_links_push.py:1-13,26-29,37-48,63-65,106-108` — preserve LINK-before-UNLINK same-second ordering.\n- `test_graph_perf.py:1-6,35-45,75-80,107-112,118-128,165-176,194,208-219` — preserve mtime-sensitive cache invalidation, single-batch scanning, `_loader.reduce_ticket` / `_loader.reducer.reduce_all_tickets` ownership, and asserted absence of private `_reduce_ticket` / `_reducer` shims.\n- `test_graph_traversal.py:1-6,28-35,53-60,78-86,144-157,213-221,248-261,267-270` — preserve ready/blocker schema and missing/deleted tombstones as satisfied blockers.\n- `test_graph_unresolved_blocker.py:1-13,35-39` — preserve deliberate absent-target tombstone fail-open behavior.\n\nConsumers are pytest/CI and `scripts/check_comment_hygiene.py`; `_helpers.py` is imported across the graph suite and `conftest.py` is pytest-discovered. Graph, observability, and architecture documentation cite these contracts. No target-specific runtime docstring reader was found. Preserve `_helpers.py:182` type-ignore, `conftest.py:20` E402, `test_doctor_locks.py:70,175` no-cover pragmas, and `test_graph_perf.py:146,189,233` type-ignore directives byte-for-byte; preserve exact shebang absence.\n\n## Acceptance Criteria\n- [ ] The leaf commit changes exactly the declared `file_impact` paths and only allowlisted prose blocks or their adjacent blank lines; the immutable-base normalized-AST/runtime/directive/shebang guard passes.\n- [ ] Every edited block is shorter and retains its listed contract and real consumers; repetition, chronology, obvious narration, and ornament are removed rather than moved.\n- [ ] A reviewer who did not author the edits posts a leaf-linked TSV with one row per edited block: stable block ID, immutable-before citation, final-commit citation (or `DELETED` plus surviving neighbor), preserved contract/consumer, `directives_exact`, before/after words, reviewer session, `semantic-preservation`, and `bloat-removal`.\n- [ ] Every TSV row records `directives_exact=PASS`, `semantic-preservation=PASS`, and `bloat-removal=PASS`; missing rows, duplicate IDs, bad citations, or any non-PASS result block closure.\n- [ ] The focused hermetic checks, `scripts/check_comment_hygiene.py`, path-scoped `git diff --check`, and no-timeout worktree-venv `make verify` all pass. Collection-only checks never execute live Jira mutations.\n\n## Verification\nThe authoritative executable commands and DD intent are recorded in first-class `verify_commands`. Do not replace `make verify` with `make lint`, and do not put a timeout around it.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"tests/scripts/graph/_helpers.py","reason":"Condense graph-helper prose while preserving LINK direction/storage and archive semantics."},{"path":"tests/scripts/graph/conftest.py","reason":"Condense graph-fixture prose while preserving repository isolation and fixture ownership."},{"path":"tests/scripts/graph/test_doctor_locks.py","reason":"Condense doctor-lock prose while preserving live/stale classification and snapshot-root isolation."},{"path":"tests/scripts/graph/test_doctor.py","reason":"Condense doctor prose while preserving safe repair ordering, rollback anchors, locks, and continuation."},{"path":"tests/scripts/graph/test_graph_children_archive.py","reason":"Condense archive/children prose while preserving filtering, traversal, and redundancy-versus-cycle behavior."},{"path":"tests/scripts/graph/test_graph_cycles.py","reason":"Condense cycle prose while preserving level scope, hidden-dir exclusion, and terminating accumulation."},{"path":"tests/scripts/graph/test_graph_hierarchy_adddep.py","reason":"Condense hierarchy-add prose while preserving promotion, relation grammar, quiet MCP, and redirects."},{"path":"tests/scripts/graph/test_graph_hierarchy_resolve.py","reason":"Condense hierarchy-resolution prose while preserving NCA, virtual-root, ancestor, carve-out, and cycle behavior."},{"path":"tests/scripts/graph/test_graph_links_push.py","reason":"Condense graph-link ordering prose while preserving same-second LINK-before-UNLINK semantics."},{"path":"tests/scripts/graph/test_graph_perf.py","reason":"Condense graph-performance prose while preserving cache invalidation, batch reducers, and shim absence."},{"path":"tests/scripts/graph/test_graph_traversal.py","reason":"Condense traversal prose while preserving blocker schema and tombstone satisfaction."},{"path":"tests/scripts/graph/test_graph_unresolved_blocker.py","reason":"Condense unresolved-blocker prose while preserving absent-target tombstone fail-open behavior."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","2d43-3c39-307e-4450"],["relates_to","5f67-844a-4162-445f"]],"no_file_impact_reason":"","parent_id":"2d43-3c39-307e-4450","parent_status_uuid":"1f82ef10-c48a-401b-879b-1684149366a8","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"f669-d70d-28f0-46c7","ticket_type":"task","title":"Condense comments in tests/scripts/graph","verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast,io,re,subprocess,sys,tokenize\nBASE=\"0033662b5534531d84e39d4a14bf75c8e768e85e\"\nALLOWED={\"tests/scripts/graph/_helpers.py\":[\"<module>\",\"_write_blocks_link\",\"_write_archive_event\"],\"tests/scripts/graph/conftest.py\":[\"<module>\",\"_isolate_git_from_enclosing_repo\",\"_link_writes_persist_without_repo\"],\"tests/scripts/graph/test_doctor_locks.py\":[\"<module>\",\"_isolated_snapshot_store\"],\"tests/scripts/graph/test_doctor.py\":[\"<module>\",\"test_repair_force_writes_the_pre_repair_tag_and_repoints_it\",\"test_run_repair_does_not_hold_a_lock_that_blocks_its_own_writes\",\"test_unrepairable_finding_leaves_its_edge_and_the_run_continues\"],\"tests/scripts/graph/test_graph_children_archive.py\":[\"<module>\",\"test_build_dep_graph_includes_children\",\"test_compute_archive_eligible_regression\",\"test_transitive_traversal_includes_archived_midchain\",\"test_check_would_create_cycle_no_false_positive_for_transitive_depends_on\",\"test_add_dependency_allows_redundant_transitive_depends_on\",\"test_build_dep_graph_excludes_archived_children\",\"test_build_dep_graph_excludes_archived_blockers\"],\"tests/scripts/graph/test_graph_cycles.py\":[\"<module>\",\"test_graph_cycle_detection_rejects_direct_cycle\",\"test_graph_cycle_detection_rejects_transitive_cycle\",\"test_graph_cycle_detection_allows_dag\",\"test_graph_visited_set_prevents_infinite_loop\",\"test_add_dependency_raises_on_cycle_at_level\",\"test_add_dependency_raises_on_self_loop_at_level\",\"test_add_dependency_skips_cycle_check_when_no_type\",\"test_cycle_detection_ignores_suggestions_dir\",\"test_get_all_blocked_by_accumulates_targets_without_a_ticket_dir\",\"test_check_cycle_at_level_refuses_a_target_at_another_level\",\"test_check_cycle_at_level_does_not_route_through_a_lower_level_hop\"],\"tests/scripts/graph/test_graph_hierarchy_adddep.py\":[\"<module>\",\"test_add_dependency_cross_story_redirects_to_story_level\",\"test_add_dependency_redundant_link_exits_nonzero\",\"test_add_dependency_cross_story_emits_redirect_json_to_stdout\",\"test_add_dependency_same_parent_still_works\",\"test_dep_graph_correctness_after_cross_story_link\",\"test_add_dependency_rejects_non_canonical_relation\",\"test_add_dependency_rejects_all_non_canonical_relations\",\"test_add_dependency_accepts_all_canonical_relations\",\"test_add_dependency_task_to_sibling_story_writes_the_requested_edge\",\"test_add_dependency_rejects_pair_that_only_resolves_to_an_ancestor\",\"test_link_dry_run_reports_ancestor_descendant_rejection\",\"test_add_dependency_returns_the_redirect_record_when_it_escalates\",\"test_quiet_link_core_returns_the_record_while_writing_nothing_to_stdout\",\"test_rebar_link_carries_the_record_through_the_whole_library_chain\"],\"tests/scripts/graph/test_graph_hierarchy_resolve.py\":[\"<module>\",\"test_resolve_hierarchy_link_same_parent_story_sc1\",\"test_resolve_hierarchy_link_cross_story_same_epic_sc3\",\"test_resolve_hierarchy_link_cross_epic_sc5\",\"test_resolve_hierarchy_link_orphan_ticket_sc10\",\"test_resolve_hierarchy_link_unreadable_ticket_sc11\",\"test_resolve_hierarchy_link_is_redundant_direct_parent\",\"test_resolve_hierarchy_link_non_blocking_never_promoted\",\"test_resolve_hierarchy_link_task_to_epic_promotes_to_epic\",\"test_resolve_hierarchy_link_cousins_escalate_to_their_parents\",\"test_resolve_hierarchy_link_disjoint_trees_escalate_to_their_roots\",\"test_resolve_hierarchy_link_task_and_story_siblings_link_directly\",\"test_resolve_hierarchy_link_jira_reb_1582_worked_example\",\"test_resolve_hierarchy_link_grandparent_pair_is_redundant\",\"test_resolve_hierarchy_link_grandparent_pair_allowed_for_non_blocking\",\"test_resolve_hierarchy_link_deep_chain_escalates_to_nca_children\"],\"tests/scripts/graph/test_graph_links_push.py\":[\"<module>\",\"test_is_active_link_same_second_unlink_sorts_after_link\"],\"tests/scripts/graph/test_graph_perf.py\":[\"<module>\",\"test_graph_cache_invalidated_on_new_link\",\"test_graph_cache_key_invalidated_on_same_size_rewrite\",\"test_build_dep_graph_single_batch_scan\",\"test_find_direct_blockers_no_per_ticket_scan\",\"test_compute_dep_graph_children_use_preloaded_state\"],\"tests/scripts/graph/test_graph_traversal.py\":[\"<module>\",\"test_graph_ready_to_work_all_blockers_closed\",\"test_graph_ready_to_work_blocker_still_open\",\"test_graph_ready_to_work_direct_blockers_only\",\"test_graph_archived_ticket_treated_as_closed\",\"test_graph_tombstone_tombstone_json_respected\",\"test_ready_to_work_when_blocker_has_deleted_tombstone\"],\"tests/scripts/graph/test_graph_unresolved_blocker.py\":[\"<module>\",\"test_depends_on_absent_target_is_treated_as_closed_tombstone\"]}\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nclass Strip(ast.NodeTransformer):\n def __init__(self,allowed): self.allowed=allowed;self.stack=[]\n def enter(self,node,q):\n  self.stack.append(q)\n  if q in self.allowed and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str): node.body.pop(0)\n  node=self.generic_visit(node);self.stack.pop();return node\n def visit_Module(self,node): return self.enter(node,\"<module>\")\n def named(self,node):\n  parent=self.stack[-1] if self.stack else \"<module>\";q=node.name if parent==\"<module>\" else parent+\".\"+node.name;return self.enter(node,q)\n def visit_ClassDef(self,node): return self.named(node)\n def visit_FunctionDef(self,node): return self.named(node)\n def visit_AsyncFunctionDef(self,node): return self.named(node)\ndef src(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(text,path):\n tree=Strip(set(ALLOWED.get(path,[]))).visit(ast.parse(text,filename=path,type_comments=True))\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(text):\n lines=text.splitlines()\n chosen=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),chosen\nbad_ast=[];bad_protected=[]\nfor path in sys.argv[1:]:\n before=src(BASE,path);after=src(\"HEAD\",path)\n if norm(before,path)!=norm(after,path): bad_ast.append(path)\n if protected(before)!=protected(after): bad_protected.append(path)\nassert not bad_ast,f\"non-allowlisted-docstring or executable AST/runtime changes: {bad_ast}\"\nassert not bad_protected,f\"directive/shebang changes: {bad_protected}\"' tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"immutable-prose-only","dd_text":"Compare 0033662b5534531d84e39d4a14bf75c8e768e85e target blobs with the final commit; strip only allowlisted qualified-owner docstrings and preserve all other docstrings, executable AST/runtime strings, and exact directive/shebang lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nexpected=sorted(sys.argv[1:])\nassert actual==expected,f\"changed paths differ: actual={actual}, expected={expected}\"' tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"exact-leaf-paths","dd_text":"Require the leaf commit changed-path set to equal the declared file-impact set exactly."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Run the repository-supported narrow comment-hygiene signal."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"focused-contracts","dd_text":"Execute the hermetic contract tests that own the edited prose."},{"command":"rtk git diff --check HEAD^ HEAD -- tests/scripts/graph/_helpers.py tests/scripts/graph/conftest.py tests/scripts/graph/test_doctor_locks.py tests/scripts/graph/test_doctor.py tests/scripts/graph/test_graph_children_archive.py tests/scripts/graph/test_graph_cycles.py tests/scripts/graph/test_graph_hierarchy_adddep.py tests/scripts/graph/test_graph_hierarchy_resolve.py tests/scripts/graph/test_graph_links_push.py tests/scripts/graph/test_graph_perf.py tests/scripts/graph/test_graph_traversal.py tests/scripts/graph/test_graph_unresolved_blocker.py","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in every declared path."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"Run the complete local CI contract from the worktree virtualenv without a timeout."}]},"source_event_uuids":["310cb6cf-a7a7-4af7-81c0-0b0992af4e8d","10a3dacb-99e3-4018-a01d-3f6fc01c787e","e7f3fc17-c53e-4862-9957-3cda036d82bc","e6285304-028d-498f-9dbf-82ec5a3cca8e","6abc44b6-2aec-4b0a-8faf-24071bd4f0da","e59c837e-ad50-4a56-9ccb-a3e43d6d214e","1f82ef10-c48a-401b-879b-1684149366a8","7f51ab70-934e-4c50-98dc-f3f1fd60d128","58f147f6-d530-4754-ba8e-92aaad30396c","3c34a1dc-48d9-41bc-964c-7e8a88dcdae8","b6ef42d5-27e8-42bb-be6c-fe216d174908"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1789062150320808001,"uuid":"c1421b60-18f1-4815-8f62-3664f619c0ff"}