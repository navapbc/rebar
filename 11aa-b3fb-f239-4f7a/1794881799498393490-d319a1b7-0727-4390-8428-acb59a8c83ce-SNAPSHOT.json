cf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ca449a12b3b6a449717b647f589a677e16c8bcea097aa04fc1dd26cd659f423f","event_uuid":"762246d2-2d34-4530-a3f9-3788127a7b64","position":{"commit_sha":"c5a8b02170aab6ed0899cf665065e244c5e86a3b","position":"1794876955234727410-762246d2-2d34-4530-a3f9-3788127a7b64"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"60fd7e8c04e29c7717d483e926fa1f280ad21859a353693075d98b98a43a01ec","event_uuid":"42e6de5b-9dec-44fe-a838-e8b356f8f18f","position":{"commit_sha":"3bb4edc7b69c6a89a5d8ef54520f2e6cd6e3ae48","position":"1794877911737046853-42e6de5b-9dec-44fe-a838-e8b356f8f18f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a8da5e5bae826a8cdbe12548efbb1193a9c0d1e33f2e039a9d2e3c02ef176bb6","event_uuid":"c45e3129-afea-4b75-b564-970a96a86515","position":{"commit_sha":"f8ba8d83ba03a77bb13681d868410abd04f76301","position":"1794881799498393489-c45e3129-afea-4b75-b564-970a96a86515"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: plan review certified (after one BLOCK: the first draft wrote the checkpoint with SNAPSHOT overrides, read SHAs only at stream end, and diffed against the original first parent; revised to mark :1 checkpoint / :2 ledger anchor, get-mark over --cat-blob-fd mid-stream, and source_of-based diff base). Claimed. Implemented on branch s1-stream-collapse, commit 0f980b65fa0: new src/rebar/_commands/reclaim_collapse_stream.py (FastImportSession, ObjectReader), _StreamedRewrite in reclaim_collapse.py. In-stream parents are referenced by mark because fast-import cannot resolve its own not-yet-packed commits by SHA. Tests: the 10 existing collapse tests pass unchanged; new oracle test (side branch forked below and merged above the boundary, deletion, same-commit event+SNAPSHOT, retired SNAPSHOT) passes on BOTH this engine and the previous per-commit engine; cost test shows one fast-import and one cat-file --batch; failure test leaves the branch unchanged. lint, typecheck, C901 green. Real-scale timing probe running on a TMPDIR shadow fetched from origin/tickets T0 85e68dbabe4 (13,149 commits above a 30-day boundary a1f5c33f941, 897 merges).","timestamp":1794876955234727410},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Real-scale probe (dry-run, apply=False, on a TMPDIR shadow fetched from origin/tickets T0 85e68dbabe4; nothing published): boundary a1f5c33f941 (committed 2026-10-17 23:33 UTC), 13,149 commits replayed, 296,408 collapsed, 119,209 ledger entries rewritten, completed in 952.6 s (~16 min) with exit 0. The previous per-commit engine was estimated at ~2.9 billion subprocesses for the same range.","timestamp":1794877911737046853},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"make verify on 0f980b65fa0: default tier 21335 passed, integration tier 218 passed, exit 0. Pushed as Gerrit change 3410 (hashtag rebar-session-3d705fec).","timestamp":1794881799498393489}],"created_at":1794874461213203870,"creation_channel":"mcp","deps":[{"link_uuid":"27f9737a-7de4-4211-ba75-d3c07ff24b85","relation":"discovered_from","target_id":"8dc4-1541-92a7-4351"}],"description":"## Context / Problem\n\nThe S3 dry run (`democratic-untiring-saiga`) must measure the reclaim on a shadow clone of the real store, and the S1 engine cannot finish at that size. `collapse_shadow_tracker` (`src/rebar/_commands/reclaim_collapse.py:63`) calls `_fast_import_tree_commit` (`:375`) once per written commit. Each call starts a new `git fast-import` process, issues `deleteall`, runs a full `ls-tree -r` (`_tree_entries`, `:363`), and runs one `git cat-file blob` subprocess per blob (`_blob_bytes_for_oid`, `:425`) to find SNAPSHOT events by content. Measured read-only on 2026-11-16, `origin/tickets` has 309,527 commits, 13,119 of them in the last 30 days, and 220,989 files in the tip tree. Replaying the commits above a 30-day horizon therefore costs about 13,119 × 220,989 ≈ 2.9 billion subprocess calls, so the epic's predicted shrink can never be measured.\n\n## Approach\n\nThe engine's outputs stay the same: the same commit graph shape, commit metadata, trees, refs, `old_to_new` map and `CollapseResult` fields. The only change is how commits are written.\n\n1. **One long-lived fast-import.** `git fast-import --quiet --date-format=raw --cat-blob-fd=<pipe>` runs as a single `Popen`. Every written commit carries a mark. Right after each commit, the engine sends `get-mark :N` and reads the 40-hex SHA back from the pipe. So `old_to_new` holds real SHAs while the stream is still being built, which is what the SNAPSHOT ledger rewrites need. A throwaway probe on 2026-11-16 confirmed that `get-mark` returns each commit's SHA mid-stream and that the commits land on the target ref.\n2. **Same first two commits.**\n   - Mark `:1`, the parentless checkpoint, is `M 040000 <boundary^{tree}> \"\"` with no overrides. That matches today's `old_to_new={}` checkpoint, and the probe confirmed the imported tree id equals the boundary tree.\n   - Mark `:2`, the ledger anchor (`from :1`, message `rebar reclaim: reconcile authorship ledger`), is the boundary tree plus inline overrides for every SNAPSHOT whose ledger re-resolves against `{boundary: checkpoint}`. That matches today's ledger-anchor commit.\n3. **Replayed commits diff against their source.** The engine keeps a `source_of` map from each written commit to the original commit whose tree it reproduces, before SNAPSHOT rewrites: boundary for `:1` and `:2`, and `c` for each replayed `c`. Parents are chosen by the unchanged `_rewritten_parents`. For each `c` in `boundary..tip`:\n   - `from` is that rewritten first parent and `merge` lines name the others.\n   - The changed paths come from `git diff-tree -r -z --raw --no-renames <source_of[from]> <c>`, emitted as `M <mode> <oid>` and `D` lines. Diffing against the source of `from`, rather than against `c`'s original first parent, keeps a parent that `_rewritten_parents` remaps (a side branch forked below the boundary, for example) on the correct base.\n4. **SNAPSHOT re-resolution matches today.** The engine tracks the SNAPSHOT paths in the current tree. A candidate is any path whose basename contains `-SNAPSHOT.json`, with or without `.retired`, confirmed by the existing `event_type == \"SNAPSHOT\"` content check. For each SNAPSHOT blob id it records which old commit SHAs its ledger positions reference, and for each written commit it records how many commits were mapped at the time it was written. Commit `c` gets an inline override for every SNAPSHOT path that its diff changed, and for every inherited SNAPSHOT that references a commit mapped after `from` was written. That covers the case where the event and its SNAPSHOT arrive in the same commit. The rewrite uses today's `_rewrite_snapshot_blob`, so the bytes are identical.\n5. **Batched blob reads.** One `git cat-file --batch` process reads SNAPSHOT candidates only, caching by blob id.\n\n`CollapseResult.ledger_entries_rewritten` becomes the number of ledger entries rewritten in the blobs that were written. It no longer counts the same SNAPSHOT again in every full-tree commit, and its docstring and the CLI output text say so.\n\n## Scope\n\n- `src/rebar/_commands/reclaim_collapse.py`: the streamed writer, the `source_of` and SNAPSHOT tracking, and the result docstring.\n- `src/rebar/_commands/reclaim_collapse_stream.py` (new): the fast-import session (start, commit, `get-mark`, close) and the batched blob reader. These are moved out so `reclaim_collapse.py` stays under the 800-line cap.\n- `tests/unit/test_reclaim_collapse.py`: the new tests. Existing tests keep their assertions, except a `ledger_entries_rewritten` value, which is updated to the new definition where needed.\n\n## Testing\n\nTDD, red first, on throwaway shadow repositories under `tmp_path`.\n\n- **Equivalence.** The fixture has a side branch forked below the boundary and merged above it, a file deletion, an event and its SNAPSHOT added in the same commit above the boundary, and a retired SNAPSHOT. The test computes the expected commits by running today's per-commit writer, kept as a test-local helper. The streamed engine must produce identical trees and identical author, committer, message and parent structure for every rewritten commit.\n- **Cost bound.** On a fixture with 200 files and 50 replayed commits, a counting wrapper on the engine's git seam shows exactly one `fast-import` process and one `cat-file --batch` process, and no per-blob `cat-file blob` calls.\n- **Failure path.** A stream that fast-import rejects still raises `ReclaimCollapseError` and leaves the shadow branch unchanged.\n\n## Acceptance Criteria\n\n- [ ] The tests in `tests/unit/test_reclaim_collapse.py` pass, with only the documented `ledger_entries_rewritten` value changes.\n- [ ] The equivalence test shows identical trees, metadata and parent structure against the per-commit writer, on the fixture with side-branch merges, deletions, same-commit SNAPSHOTs and retired SNAPSHOTs.\n- [ ] The cost test shows one `fast-import` and one `cat-file --batch` process per collapse.\n- [ ] `make verify` is run and any failure is fixed or shown environmental; the Gerrit change gets `Verified +1`; `python scripts/check_mechanism_delta.py --check` and `python scripts/check_complexity_baseline.py --check` exit 0.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_commands/reclaim_collapse.py","reason":"Streamed writer with get-mark SHAs, source_of diff base, SNAPSHOT dirty tracking; result docstring."},{"path":"src/rebar/_commands/reclaim_collapse_stream.py","reason":"New: fast-import session (commit, get-mark, close) and batched cat-file reader, kept out of reclaim_collapse.py for the 800-line cap."},{"path":"tests/unit/test_reclaim_collapse.py","reason":"Equivalence against the per-commit writer, cost bound, failure path."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["parent","536b-8930-b922-4063"]],"no_file_impact_reason":"","parent_id":"536b-8930-b922-4063","parent_status_uuid":"43983b3e-4902-4202-8416-630df24001b6","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"11aa-b3fb-f239-4f7a","ticket_type":"story","title":"S1 collapse engine: one fast-import stream over changed paths, so a real-size store can be rewritten","verify_commands":[]},"source_event_uuids":["2bb9ecbc-e82d-4157-b0a6-7a0ca616a242","27f9737a-7de4-4211-ba75-d3c07ff24b85","7975364b-1cfc-4c10-8e30-7b483482d3f9","cc1c2237-7608-4bb7-9e55-a9b600e1d56c","ba7328f6-b00c-43b9-bca8-d2bdfd639304","9782c6fb-770a-40f3-ac17-cae44a798b76","43983b3e-4902-4202-8416-630df24001b6","5f234a37-0576-4c53-931e-4f37d1714af2","762246d2-2d34-4530-a3f9-3788127a7b64","42e6de5b-9dec-44fe-a838-e8b356f8f18f","c45e3129-afea-4b75-b564-970a96a86515"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1794881799498393490,"uuid":"d319a1b7-0727-4390-8428-acb59a8c83ce"}