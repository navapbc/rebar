sh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788315160454796001,"creation_channel":"cli","deps":[{"link_uuid":"67f1c5cc-0a4c-492d-971b-6830e12b979d","relation":"depends_on","target_id":"a07a-5eeb-1223-491c"}],"description":"## Context / Problem\n\n`src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py:40-53::_fit_description` has no executable consumer; commit `e0eab05b0cceb` moved behavior to `OutboundFieldMapper(AdfCodec(...))`. `adapters/jira/acli_rest.py:115-126::_direct_rest_put` also has no production caller and applies a wrong universal envelope; live calls use `_direct_rest_put_raw`.\n\nThe shared link canonicalizer prerequisite is bacteroid-computable-vole [rebar:bacteroid-computable-vole].\n\n## Approach\n\nAfter the canonicalizer prerequisite, delete both unreachable helpers and stale mock/inventory/comment ownership. Retain mapper/codec sanitizer ordering and raw PUT body/auth/rate-limit/retry behavior.\n\n## Scope\n\n- Jira backend field helper and mapper ownership prose/tests\n- ACLI REST helper, mocks/inventories/comments, and raw-PUT contract tests\n\n## Testing\n\nRun mapper fit/normalization/sanitizer controls and raw PUT endpoint/body/auth/retry tests.\n\n## Acceptance Criteria\n\n- [ ] `_fit_description` is removed and maintained prose/tests name `OutboundFieldMapper` plus codec composition as owner.\n- [ ] `_direct_rest_put` is removed with unused mocks, inventories, and stale comments.\n- [ ] `_direct_rest_put_raw` retains exact body, authentication, rate-limit, and retry contracts.\n- [ ] Mapper fit/normalize/sanitizer ordering remains covered.\n- [ ] Focused Jira adapter and raw-PUT suites pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"remove dead description helper and correct ownership"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_rest.py","reason":"remove dead wrapped PUT helper and retain raw transport"},{"path":"src/rebar/_engine/rebar_reconciler/jira_family/outbound_mapper.py","reason":"canonical description/fit behavior owner"},{"path":"tests","reason":"migrate mocks/inventories and preserve mapper/raw-PUT contracts"},{"path":"docs","reason":"remove stale helper ownership prose"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","a07a-5eeb-1223-491c"],["parent","78f2-b104-e3c9-4b86"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["janitor","dead-code","jira","hardening","sdc4"],"ticket_id":"79fb-2c91-241c-4a9d","ticket_type":"task","title":"Remove dead Jira adapter description and PUT helpers","verify_commands":[]},"source_event_uuids":["9207e1a8-6def-4a96-91c4-89fa7567951a","3a319642-b3b9-431e-ba77-bdd3887bfbcf","67f1c5cc-0a4c-492d-971b-6830e12b979d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328064948637001,"uuid":"7af6a8b9-d43a-4586-90e0-3ccc33e5430c"}