19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787703483445883001,"creation_channel":"cli","deps":[{"link_uuid":"2e91312d-439e-48f3-b6cc-c6f9e2b9cd0f","relation":"discovered_from","target_id":"b03c-f8d4-ef82-4618"}],"description":"## Context / Problem\nThe shrink-only complexity gate prints only aggregate counts on failure. Gerrit CI run 32914110990 reported `active=41 new=2 increased=1 stale=7` but did not name the offending symbols or their scores. Diagnosis required a separate local no-cache Ruff census plus manual baseline comparison, which is especially poor in resource-constrained CI-only workflows.\n\n## Plan\n- Preserve the existing compact counter summary.\n- Emit one deterministic detail line for every `new` symbol with its current score and the configured threshold.\n- Emit one deterministic detail line for every `increased` symbol with its current score and recorded ceiling.\n- Keep passing/stale-only output compact and keep the scanner/gate runtime unchanged apart from formatting already-computed data.\n- Add focused unit coverage for ordering, values, and no-detail passing output.\n\n## Acceptance Criteria\n- [ ] A failing `--check` names every new symbol and reports its current score plus allowed threshold.\n- [ ] A failing `--check` names every increased symbol and reports its current score plus baseline ceiling.\n- [ ] Detail lines are stable-sorted and appear with the existing summary.\n- [ ] A passing or stale-only check retains compact output without violation lines.\n- [ ] Focused tests and project CI gates pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"scripts/check_complexity_baseline.py","reason":"Render deterministic per-symbol new and increased violation details."},{"path":"tests/unit/test_complexity_baseline.py","reason":"Cover violation detail values, ordering, and compact passing output."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["ci","complexity","diagnostics"],"ticket_id":"0ab0-6754-cc72-4d8c","ticket_type":"bug","title":"Report symbol-level complexity baseline violations in CI","verify_commands":[]},"source_event_uuids":["f819eb42-5532-4aaa-8ee8-0abde5de859a","ca579952-5281-4ea1-b1ed-c0f0014391e6","2e91312d-439e-48f3-b6cc-c6f9e2b9cd0f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787713790234965001,"uuid":"6bbf1603-d392-4ee5-978e-62542f6c42ad"}