9 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787173350884885001,"creation_channel":"cli","deps":[{"link_uuid":"fe0665cf-8bcd-47b6-b2a4-ad9116218487","relation":"discovered_from","target_id":"638a-3746-e58a-4929"}],"description":"## Problem\n`reconcile_helpers._commit_binding_store_snapshot` is the last reconciler write that composes `git_adapter.add` + `git_adapter.commit` against the tickets tracker OUTSIDE the atomic locked commit+push transaction. Ticket 6454-d06e-7361-4e3d attempted the conversion and reverted it: the only offered seam, `rebar._store.push.commit_and_push_tickets_branch`, stages with `git add -A`, which sweeps in `.bridge_state/last-pass.json` — a per-pass timestamp the deliberate selective 5-file staging excludes. The tickets HEAD then advances on every idempotent pass and `tests/integration/rebar_reconciler/test_reconcile_idempotency.py::test_unchanged_second_pass_preserves_binding_store_bytes_and_head` goes RED (reproduced in CI on Gerrit 1821 ps1 and locally).\n\nTicket 638a-3746-e58a-4929's R3 composition gate therefore lands with a durable reasoned `# raw-git-ok:` marker on that site. This ticket removes the marker by removing the reason for it.\n\n## Approach (one of)\n1. Add an optional pathspec parameter to `commit_and_push_tickets_branch` so a caller can stage a subset under the shared write lock, keeping the exact 5-file set and the bug-1e08 per-file idempotency check.\n2. Or a small write_lock-wrapped selective-commit path in the store seam (no push, matching today's no-push behavior).\n\n## Acceptance criteria\n- [ ] `_commit_binding_store_snapshot` no longer calls `git_adapter.add`/`git_adapter.commit`; it goes through the shared locked seam.\n- [ ] The committed file set is unchanged (the same 5 `.bridge_state` files, never `-A`).\n- [ ] `test_unchanged_second_pass_preserves_binding_store_bytes_and_head` stays green.\n- [ ] The `raw-git-ok` marker on `reconcile_helpers.py` is deleted and `scripts/check_raw_git_writes.py` still passes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"route the binding-store snapshot through the locked seam"},{"path":"src/rebar/_store/push.py","reason":"optional pathspec on commit_and_push_tickets_branch"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"11a9-b11b-e93d-4832","ticket_type":"task","title":"Give the tickets-branch commit seam a pathspec so the binding-store snapshot can leave raw git","verify_commands":[]},"source_event_uuids":["be572452-6fff-4732-8706-a55c7cf82483","fe0665cf-8bcd-47b6-b2a4-ad9116218487","f41ae526-5573-46dc-b118-987989f00787"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787175668728808001,"uuid":"a2f93e94-2233-4ec3-bb0b-e942ecbbf87d"}