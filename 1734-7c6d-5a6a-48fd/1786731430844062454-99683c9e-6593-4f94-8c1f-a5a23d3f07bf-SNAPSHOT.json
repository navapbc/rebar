{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786731430844062454,"compiled_state":{"alias":"algebraic-illstarred-mollusk","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"2c2bf88cfa19b0eafd3532e4b89480c59e604058","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 1734-7c6d-5a6a-48fd","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.11.0 (2c2bf88cfa)","material: 5c3c209f1ee60135","verified-at-sha:2c2bf88cfa19b0eafd3532e4b89480c59e604058"],"material_fingerprint":"5c3c209f1ee60135","merged_log_commit":"2c2bf88cfa19b0eafd3532e4b89480c59e604058","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786729159949879000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"56b978b09aeec390f5aae00d01f26ac775c322f6","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1734-7c6d-5a6a-48fd","material: 5c3c209f1ee60135","material-part: children 647ea2107ca5072f 0","material-part: description aff3c59032284691 6317","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 68444134069ce14b 5","material-part: ticket_id 6186dd428907d9f5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","rev