: execution","priority-floor: 0.80","rebar-version: 0.11.0 (7773959395-dirty)","regver: 4f90349cd81c4911","verified-at-sha:267637fd324c631bd04eedcec2064607255dda52","plan-material-pin: prerequisite a011-491c-f7e5-4dd9 49db7ce52300f1d7","dep 5d351a48c67a2afe7466a1f7b735c3ad21c82809496092648a29a5a6c900bb3a src/rebar/_cli/_bridge_commands.py","dep a479ad3f7d75fb1d709d6a9307a80ebc03cfa2f332eb39fcdff593e756d29ee4 src/rebar/_engine_support/bridge_fsck.py","dep 84fda9b82903588fafab516c2d1d831e6ca724c24dcd426021bc17af10e4b3a6 src/rebar/_engine_support/bridge_fsck_visibility.py","dep bd4302943d1307709f8ecf2dd0a00ff88495f232ad2c25f3ea4a767d7ec9b363 tests/scripts/bridge/test_bridge_fsck.py","read-set: 5","read-path: src/rebar/_commands/doctor.py","read-path: src/rebar/_engine/rebar_reconciler/access_check.py","read-path: src/rebar/_engine_support/bridge_fsck.py","read-path: src/rebar/_engine_support/bridge_fsck_visibility.py","read-path: tests/interfaces/contracts/test_schema_outputs.py","currency-basis: file_impact"],"material_fingerprint":"e80c2c74d5f06b23","merged_log_commit":"267637fd324c631bd04eedcec2064607255dda52","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786825370076050000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"e09814418fc394d2c090bc63809584471a11924dd765dba8b20f5f37be1670d1","event_uuid":"59c2b506-bd07-4794-b5d7-e098f394a65d","position":{"commit_sha":"a4db1056985d7a0b320822343fe68d4f01722f06","position":"1786821614465275001-59c2b506-bd07-4794-b5d7-e098f394a65d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"877be088667