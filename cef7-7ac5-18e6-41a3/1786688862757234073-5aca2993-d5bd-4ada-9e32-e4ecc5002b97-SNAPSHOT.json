{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786688862757234073,"compiled_state":{"alias":"buried-genial-gyrfalcon","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"5276dec1b8968d4679afe6de0cd3365df69f0520","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: cef7-7ac5-18e6-41a3","material: 03d2b2ba424cc877","material-part: children 647ea2107ca5072f 0","material-part: description 274114b815639663 7101","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact d5e3dbcf0ba0ad07 7","material-part: ticket_id 3efd7a83ddebd9bf 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.11.0 (5276dec1b8)","regver: 4f90349cd81c4911","verified-at-sha:c1b6244b745bd438d47331c9c45ba84b818336a9","plan-material-pin: prerequisite 4631-5598-7127-4a56 ed63681f667be64a","plan-material-pin: prerequisite c927-0a68-4465-42a2 ac4bc0e71a6cd316","plan-material-pin: prerequisite ce02-47ed-6505-4925 3c6d7183acd46d82","dep bdf78aab4619d13bd6c3f269c433e6917a4d96c87d9965cf00b25a83aabe2a96 src/rebar/_commands/composer.py","dep 9a72a096f079181adf5678ab9dccf8f939f9d4bd665c96b3ccb0b36e001b38bf src/rebar/_lib_writes.py","dep 0e96ea2cfb79aab85e6cf477f63063ac8d00ce2f86ba9bcceddef655856b1f82 src/rebar/_mcp_writes.py","dep 0a508b368a8a82c7bccafc0479d5f4272cf5e256544cc13ae8a707dba1df977d src/rebar/reducer/_processors.py","dep 25f61f7b89c00c1b8cddea81cd5aebba4e911ca508e9568a5c89f643de35a02a src/rebar/reducer/_state.py","dep 7083c0334f86b47510bff3e7f07179a6eee54464