application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8c3e4c8a7fd02b025fe0044727f38b6682087935734640fe4972cd37008dbd4a","event_uuid":"96cbfa55-c2d8-42a2-a273-6e1dd62eae39","position":{"commit_sha":"9299d36621501b0a543e6a4edec3f10970126de4","position":"1784927208571944001-96cbfa55-c2d8-42a2-a273-6e1dd62eae39"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"23d05a1f6990c454a1dc93e825c5de729c0b95a084b48b146fdbee099943f8e3","event_uuid":"5a3c94a9-c154-465b-a1d8-4c7bc7c52353","position":{"commit_sha":"a05cbd1d1e5eab07337cf9dca51e9aceb8385b55","position":"1784927390049606816-5a3c94a9-c154-465b-a1d8-4c7bc7c52353"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1784670010764082001,"creation_channel":"cli","deps":[{"link_uuid":"65a4b30b-37b0-4840-9d7c-1ef1d8b7074b","relation":"depends_on","target_id":"761e-5af2-ed57-408a"}],"description":"## Context / Problem\n\nThe deterministic Pass 3 of code-review ignores project routing. `code_review_decide` passes\n`registry.threshold_for` as a bare callable and calls `registry.nit_suppressed_criteria()` with no\narguments (`src/rebar/llm/code_review/workflow_ops.py:419,427`), so both read the **packaged**\nrouting map and a project overlay's threshold / blocking / nit-suppression re-tunes are dropped —\neven though those resolvers already accept an optional routing map\n(`src/rebar/llm/code_review/registry.py:309-343`) and `registry.effective_routing(repo_root)`\nalready exists on `origin/main` (`registry.py:171-176`). Third of five seams (root cause on\nsuperseded bug 8a4b).\n\n## Approach\n\nPure wiring — thread the repository-effective routing map into the two Pass-3 resolvers:\n\n- In `code_review_decide`, compute `routing = registry.effective_routing(ctx.repo_root)`\n  (`ctx.repo_root` is already used in this function at `workflow_ops.py:414`).\n- Bind that map into the `threshold_for` callable handed to `pass3_over_findings` (e.g.\n  `functools.partial(registry.threshold_for, routing_map=routing)`), and pass it to\n  `registry.nit_suppressed_criteria(routing)`.\n\nNo `registry.py` change is needed — the optional `routing_map` parameters landed with story 5065,\nand `effective_routing` is on `origin/main` today (cited above).\n\n**Rejected alternative.** Re-implementing routing resolution inside `workflow_ops` — the shared\nresolvers already exist and are the single source of truth; duplicating them would diverge from\nplan-review's routing semantics.\n\n## Scope\n\n- `src/rebar/llm/code_review/workflow_ops.py` — thread `effective_routing(ctx.repo_root)` into the\n  Pass-3 `threshold_for` binding and `nit_suppressed_criteria` call.\n- `tests/unit/test_code_review_project_criteria.py` — extend this shared test file (a new file\n  first created earlier in the stack; this ticket appends its Pass-3 routing cases). This ticket\n  **depends on** child 2 `[rebar:761e-5af2-ed57-408a]`, which will introduce both the synthetic-repo\n  fixture and the logical `project.<name>` attribution on code-review findings; the Pass-3 tests\n  here consume a finding carrying that logical id.\n\n## Testing\n\n- Happy path (routing): a synthetic repo re-tunes `project.foo` (lower block threshold + blocking,\n  and separately `nit_suppressed`); assert Pass 3 blocks / demotes the project finding per the\n  **project** routing, not the packaged default. The routed finding carries the logical\n  `project.foo` id that child 2 `[rebar:761e-5af2-ed57-408a]` will attribute.\n- Parity: with no overlay, Pass-3 dispositions are byte-identical to today (packaged-default path).\n\nTier: unit; feeds deterministic findings (carrying logical `project.foo`) through\n`code_review_decide` with a synthetic effective routing — no LLM.\n\n## Acceptance Criteria\n\n- [ ] Project routing (threshold / blocking / nit-suppression) governs the deterministic Pass 3\n      for a project finding; verified by\n      `rtk .venv/bin/pytest -q tests/unit/test_code_review_project_criteria.py -k routing`.\n- [ ] With no overlay, Pass-3 dispositions are unchanged (parity); verified by the same `-k routing`\n      selector asserting the packaged-default path.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/code_review/workflow_ops.py","reason":"Thread effective_routing(ctx.repo_root) into Pass-3 threshold_for + nit_suppressed_criteria"},{"path":"tests/unit/test_code_review_project_criteria.py","reason":"Pass-3 routing + parity tests"}],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","761e-5af2-ed57-408a"],["parent","119f-63e3-34b7-4f96"]],"parent_id":"119f-63e3-34b7-4f96","parent_status_uuid":"be71b06a-eeb2-47f4-9767-2dfa84c58013","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["review-architecture","project-criteria","integration"],"ticket_id":"58ef-91fa-20c1-4f29","ticket_type":"story","title":"Thread repository-effective routing into code-review Pass 3","verify_commands":[]},"source_event_uuids":["889c04d2-f34e-4c72-8dc5-fb7913dd7858","876df7a8-1933-4713-b2b3-9c035708bc0e","4ef0