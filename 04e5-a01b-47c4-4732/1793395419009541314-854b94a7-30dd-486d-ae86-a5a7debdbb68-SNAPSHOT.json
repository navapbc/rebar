086 # v1.14.3 at the uses: line and in the evidence-shapin echo, so both state the same SHA and version.\n2. Run make lint locally (includes zizmor and actionlint) and the workflow parity tests.\n3. Push, land at LLM-Review +1 and Verified +1.\n\n## Acceptance criteria\n- [ ] release.yml pins pypa/gh-action-pypi-publish at 7245906fb61fa33a13554f9d5fb856fe61758086 in both places, both labelled v1.14.3; verified by grep showing no remaining dc37677b reference.\n- [ ] make lint passes locally with zizmor reporting no known-vulnerable-actions finding.\n- [ ] The Gerrit change is Verified +1 (CI lint + type-check job green).","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":".github/workflows/release.yml","reason":"pin pypi-publish to v1.14.3 in uses and evidence fragment"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","9350-b05e-58f8-4da7"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"c4593457-49e1-4399-ab40-65815b75e751","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"04e5-a01b-47c4-4732","ticket_type":"bug","title":"Bump pypi-publish past GHSA-5xjx-3w67-w9x9; every change fails lint","verify_commands":[]},"source_event_uuids":["932a0b63-3640-46f0-ad64-99f469ab3bc9","73326659-cc93-4062-af09-65ffe1e86d69","c112a521-89ca-40a4-a908-4b8434f153c8","7795b05d-5166-43f1-8302-d4e2a43aada6","c4593457-49e1-4399-ab40-65815b75e751","41aff226-a4f0-4aae-886c-06b9faf8f99d","5a26b26b-aad1-42e0-b3f9-258f31be4210"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793395419009541314,"uuid":"854b94a7-30dd-486d-ae86-a5a7debdbb68"}