application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"95406cf3fbb825d60dce53d8a1118d8edfcdc806fd8a29e3e8077703090c6c79","event_uuid":"c148c765-d4f6-477e-81ea-bb14c11b9b8a","position":{"commit_sha":"7f66621e42586f68129bcfbe881613301d1da330","position":"1786147249532073001-c148c765-d4f6-477e-81ea-bb14c11b9b8a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"20ca3ec62ae7f47f13196939e7ee50cb0a7811d7ff308bcdb1a2c0c8ff651617","event_uuid":"796c6eb3-4cc3-4a42-86eb-0df57bb16095","position":{"commit_sha":"f060723ca073f4333c6ff3e7ecbdbcd930584541","position":"1786147412401780001-796c6eb3-4cc3-4a42-86eb-0df57bb16095"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"07e8675aaca1908afd69c98f618033ffdfcac138d49ec29d25e2b24f229d1e47","event_uuid":"1645013d-7cfa-41a2-9827-848b5c0c76a1","position":{"commit_sha":"bf2f64d7491305f5a06fc1893e397d5fe5d20f36","position":"1786147430753703001-1645013d-7cfa-41a2-9827-848b5c0c76a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"03f40b243a4af1a63f487577fb622b6995d7a58c21516d4fb9ce71de7c35b68f","event_uuid":"f08abd98-4ece-42b9-9a44-d3c9c07e8318","position":{"commit_sha":"ba64aa2b1ac3678c4815390af46e3529e6672281","position":"1786147578626247001-f08abd98-4ece-42b9-9a44-d3c9c07e8318"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1557b3a5932b627e594d63cff48e5daafbdc91320af47aed6cefd4ef6cf7fb3a","event_uuid":"d1cc3d73-e393-46df-b997-922d132a7966","position":{"commit_sha":"965f85393b419e26c1c3ab676318807d78b21911","position":"1786147586791690001-d1cc3d73-e393-46df-b997-922d132a7966"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"661827109d83106211668524bc1886037bd1e90811acc6a9606365d0350fcb46","event_uuid":"2a1b1a1a-d638-4390-a697-44dddf9f2ed1","position":{"commit_sha":"d05e5ee002bbdbddf35e6bdf3c47e717924b9c70","position":"1786147834659726001-2a1b1a1a-d638-4390-a697-44dddf9f2ed1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bd19089bf35d227ca9edfabec5258d329d6fb5f5d8e7e13e3e5eb586201aad3f","event_uuid":"b3a16c3f-74c0-490d-ad17-a0bbc4680ec1","position":{"commit_sha":"680d92e8121dd4bbb2be91e9e7fedf8e78b36b3c","position":"1786147885584356001-b3a16c3f-74c0-490d-ad17-a0bbc4680ec1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1bbd4baa1d75d8775d82c08f5d6a09e466d52ae84409ff8d82fcfabf45692281","event_uuid":"991d0428-46cf-4c12-acea-efe1d1cb8462","position":{"commit_sha":"4065e8ecd2a34ad3ce4da5b932aaf19722a48bed","position":"1786147901141556001-991d0428-46cf-4c12-acea-efe1d1cb8462"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7ba1e3b6b117d942d8b685e5e8f05330c317acf44593d53e53dcaaba33f6f319","event_uuid":"20074e19-77e2-4629-b284-6ea9c1ca4bb5","position":{"commit_sha":"2fe00100b16b553af8b0bf8f3a5346c10121a3da","position":"1786148585790309001-20074e19-77e2-4629-b284-6ea9c1ca4bb5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"674b9e9d2236cdc2eca112d5f5b23b722614afb5f8ecc22eae0fcc35e05fafb1","event_uuid":"98449745-785f-4036-8a62-cc8e8917372f","position":{"commit_sha":"e9df11f90ab9d9cfaa90c888fb5e645cfab0ad21","position":"1786148669669120001-98449745-785f-4036-8a62-cc8e8917372f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"503706bf3eec167bd29d29fd57eafca27a87cf7260eada879ef043854db60315","event_uuid":"b36acfaa-c8e4-4ce2-b3d7-9e72e92c9384","position":{"commit_sha":"e9df11f90ab9d9cfaa90c888fb5e645cfab0ad21","position":"1786148670270033001-b36acfaa-c8e4-4ce2-b3d7-9e72e92c9384"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fresh plan review found one blocking child-coverage gap: parent AC7's complete legacy caller inventory had no explicit child-owned parametrized proof. Remediated in prerequisite 953a by adding the full event-append/batch/import/transition/delete/compact/claim compatibility matrix. 953a will be re-reviewed first; then this parent review will be rerun dependency-first.","timestamp":1786146587292409001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-certification coherence remediation: clarified that `final-push-rejected` is a scenario through the single shared retries-exhausted terminal branch after five clean merges, not a second branch or redundant test. The AC now requires one test per actual control-flow branch plus the five-clean-merge terminal scenario, preserving the exactly-one-final-push invariant.","timestamp":1786147130775232001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-certification AC consolidation: removed duplicate smoke-test criteria. The plan now names one re-homed in-process contention oracle and the SAME exactly two workflow smoke tests (one per workflow) carrying all wiring assertions together: correct action, entrypoint invoked, strict=True, REBAR_SYNC_PUSH=always, persistent rejection nonzero, and no git-output pipe.","timestamp":1786147249532073001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-certification mechanism remediation: D3 now pins unconditional delegation after optional commit. Added dirty-tree, clean-but-locally-ahead success, and clean/ahead persistent-rejection strict oracles so the reconciler's precommitted binding-store state cannot be silently stranded.","timestamp":1786147430753703001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-certification compatibility rationale: documented why the shared 3→5 budget applies to existing best-effort callers too. They all contend on the same hot origin/tickets ref; extra cycles occur only after real non-fast-forward rejection, add no uncontended-path latency, use bounded idempotent no-sleep merges, preserve return/disposition, and avoid reintroducing strict-versus-best-effort retry drift.","timestamp":1786147586791690001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-certification completeness remediation: D5 now explicitly covers every early silent return omitted from the parent enumeration—malformed destination, missing remote, permanent policy decline, and transient transport failure—with the stable child-owned reasons and paired best-effort controls.","timestamp":1786147901141556001}],"created_at":1786047439840444001,"creation_channel":"cli","deps":[],"description":"`.github/workflows/reconcile-bridge.yml:272-377` is a 106-line CAS push loop that re-implements\n`src/rebar/_store/push.py:161-296`. Both carry the same rejection classifier, the same\nexplicit-refspec requirement with the same load-bearing paragraph pasted on each side, and the same\nmerge-not-rebase choice citing bug f193 / invariant I1.\n\n**They have diverged in both directions**, which is the argument for collapsing them:\n\n- YAML: 5 retries + a final push; **5 is the target budget preserved in core**; **4c4f defect 2 FIXED**; e161 SIGPIPE fix; disposition RED. The e161 guard was specific to the deleted shell pipeline (`git ... | tee` under `pipefail`); the Python core captures git output directly and creates no pipe, so the safeguard is subsumed rather than ported. A workflow smoke test proves the new direct module invocation has no output pipeline.\n- `push.py`: 3 retries, **no final push — 4c4f defect 2 STILL PRESENT** (at attempt 3 it merges\n  clean, `continue`s, and the loop exits without pushing); adds a write lock, a store-epoch guard,\n  and dirty-tree stash/merge/pop repair; disposition best-effort, never fails the caller.\n\nTicket 4c4f's own acceptance criteria has an UNCHECKED item: reconcile the budgets (it uses 3, the\nworkflow 5). The divergence is already filed and open.\n\nThis is the largest ticket in the epic, and it carries three standing decisions that must be\nexplicitly overturned rather than bypassed:\n\n1. `reconcile-bridge.yml:285` carries `# raw-git-ok: commit-back CAS push loop stays verbatim in\n   YAML per ticket 4c4f`, enforced by `scripts/check_raw_git_writes.py`.\n2. `scripts/canary_bridge.py:8-11` states the extraction module \"must never absorb\" this loop.\n3. `tests/scripts/test_reconcile_bridge_push_retry.py` extracts and executes the YAML verbatim, and\n   its docstring argues against this exact move — \"extracting the logic to a script would introduce\n   a drift seam where the workflow's invocation of it becomes untested glue.\"\n\nThe Humble Object answer is that a wrapper with no logic has no drift seam — but the epic owes a\nreplacement harness: re-point the contention test at `push.py` (a better test, in-process, no YAML\nparsing) plus one thin smoke test per workflow asserting the entrypoint is actually invoked.\n\n4c4f named the exact condition for flipping the disposition: \"Flip to non-red IF a PUSH_PENDING\nequivalent is added for the ephemeral context.\" Without a fail-loud mode, replacing the YAML loop\nwith best-effort `push.py` silently converts a red into a silent loss.\n\n\n## Decisions taken (resolved 2026-08-06 — review remediation, nothing deferred)\n\n**D1 — Strict mode's fail-loud channel is the process exit, NOT a BRIDGE_ALERT event.**\nThe original AC said \"files a bridge alert\", which would COLLIDE with sibling 030f decision 3:\nthat ticket DELETES the BRIDGE_ALERT emitter (`dispatch_one.py:353`), its reducer arm and\n`_engine_support/bridge.py`, on the evidence that 0 BRIDGE_ALERT events exist in the store's entire\nhistory. Strict mode therefore emits NO event. Concretely it:\n* exits non-zero, and\n* writes to stderr the git reason plus the escalating unpushed count\n  (`N unpushed commits on origin/tickets..HEAD`) — the surfacing that landed for bug 2a76 in\n  `bfdb68070a`, so this reuses a shipped mechanism rather than inventing one, and\n* leaves the backlog derivable by `PUSH_PENDING` (`fsck.py:365`), which stays on-demand.\nIn an ephemeral CI context the non-zero exit IS the alert: the job goes red and the canary escalates.\nThat is exactly the \"PUSH_PENDING equivalent for the ephemeral context\" 4c4f named as its condition\nfor flipping the disposition, without adding a durable artifact nobody reads.\n\n**D2 — BOTH YAML CAS loops collapse, not one.**\n`reconcile-bridge-canary.yml:208-246` holds a SECOND \"flush unpushed\" CAS push loop, governed by its\nown peer standing-decision block at `reconcile-bridge-canary.yml:14-19` (\"deliberately STAYS in YAML\n... do NOT migrate it into the module\", citing 4c4f). Collapsing only the reconciler loop would\npreserve the very duplication this ticket exists to remove. The reconciler is migrated to `commit-and-push --strict`; the canary flushes already-committed state and is migrated specifically to the push-only `push --strict` action. BOTH inline decision blocks are updated with the reversal — not just `canary_bridge.py`'s module docstring. Note `reconcile-bridge-canary.yml` is a TEMPLATE that client\nprojects copy verbatim (`docs/jira-sync-setup.md`). Existing copied fat loops remain functional because the\ncore keeps all old best-effort behavior and the workflow contract; adopters may continue using them unchanged.\nDocument in `docs/jira-sync-setup.md` how an existing client can opt into the thin template after upgrading\nrebar, and how to restore the prior inline loop as a no-cleanup rollback. The thinner version is what future\nclients inherit; call this compatibility and migration path out in the CHANGELOG.\nThe current canary loop explicitly uses five attempts (`for attempt in 1 2 3 4 5`) plus exponential backoff; the reconciler also uses five and already carries the evidence-based no-backoff decision. After a clean fetch+merge, local HEAD is a valid fast-forward and only a competing push can invalidate it, so sleeping cannot shed rate-limit load and only forfeits the CAS race; observed remote advances in run 30585738860 landed inside those sleeps. The shared core therefore preserves the canary's five-attempt budget and terminal nonzero disposition but intentionally adopts immediate re-push. `CHANGELOG.md` and `docs/jira-sync-setup.md` name this timing change and the rollback to the prior inline loop; contention tests pin convergence without wall-clock assertions.\n\n**D3 — The reconciler commit-back is preserved by a NEW core entrypoint, not by leaving raw git in YAML.**\n`reconcile-bridge.yml:290-293` runs `git add -A && git commit` for the reconciler's UNCOMMITTED\ninbound events BEFORE pushing. `push.py` never stages or commits — it begins at the push step, and\nits sibling `push_after_commit` (`push.py:299`) encodes that assumption in its name. Deleting the\nYAML block and calling `push_tickets_branch` would therefore PUSH NOTHING whenever the reconciler\nleft a dirty tree. Resolution: add `commit_and_push_tickets_branch(tracker, *, message, strict=False, author_name=None, author_email=None)`, which stages+commits only when the tracker is dirty and then ALWAYS delegates to `push_tickets_branch`. This unconditional delegation is load-bearing: the reconciler may already have made an unpushed binding-store commit, leaving a CLEAN worktree whose HEAD is ahead of `origin/tickets`; strict delivery must still push it or raise rather than report success. Expose the functions through the private, named module CLI `python -m rebar._store.push`: `commit-and-push --tracker ... --message ... [--strict] [--author-name ... --author-email ...]` calls `commit_and_push_tickets_branch`, and `push --tracker ... [--strict]` calls `push_tickets_branch`. The workflows use this testable adapter; `--strict` maps only to the explicit `strict=True` keyword and `REBAR_SYNC_PUSH=always` remains the separate synchronous-delivery override. `push_tickets_branch` stays pure (push-only), so no existing caller changes semantics, and NO raw git remains in the workflow — which also keeps `scripts/check_raw_git_writes.py` satisfied without an exemption.\n\nThe complete existing caller inventory, derived with semantic references plus string grep, is explicit: `event_append.write_and_push`, `event_append.batch_write_and_push`, `import_ndjson`, and `push_after_commit`; the latter is consumed by `transition_close`, both delete paths, both compact paths, and claim. Every site continues omitting `strict`, remains best-effort, and keeps the same arguments/return contract. Each inherits only the durability correction inside the shared core: five rejection merge/retry cycles and the one final push after a clean fifth merge. Five is deliberate for these callers too: they all push to the same hot shared `origin/tickets` ref and can contend with agents, importers, or the reconciler; the extra two cycles run only after an actual non-fast-forward rejection, add no delay to the uncontended one-push path, use the same idempotent merge with no sleep, and remain bounded. One shared budget also prevents a new strict-versus-best-effort drift seam while preserving every caller's best-effort return/disposition. The event-append/batch/import and transition/delete/compact/claim regression suites remain green, plus a parametrized caller-contract test proves every inventory site still uses the best-effort default.\nThe reconciler adapter must receive the existing message verbatim: `chore: sync events from rebar reconciler [run ${{ github.run_id }}]`; a workflow-block test proves the resulting commit subject is unchanged.\n\n**D4 — Strict is a property of the CALL SITE, and the two workflows differ deliberately.**\nStrict mode existing is not sufficient: if CI still invokes best-effort, every isolated strict-mode\ntest passes while production silently loses commits — the exact failure this ticket exists to remove,\nreproduced one level up at the wiring. So the disposition is pinned per caller:\n* the **reconciler** workflow (`reconcile-bridge.yml`) invokes the entrypoint in **STRICT** mode — its\n  commit-back carries inbound events that exist nowhere else, so a lost push is data loss and the job\n  MUST go red. This is what actually flips 4c4f's disposition.\n* the **canary** workflow (`reconcile-bridge-canary.yml`) also invokes the push core with **STRICT** delivery. Its current inline loop already exits nonzero on merge conflict, non-retriable decline, and retry exhaustion; preserving `strict=True` keeps that shipped red disposition rather than silently weakening the alerting path. The underlying `push_tickets_branch` default remains best effort for library/MCP callers.\n* Library/MCP callers keep today's best-effort default — strict is opt-in, so no existing caller\n  changes disposition silently.\n\nThe reconciler strict rollout is reversible only at its call site: switching that one invocation back to\nbest-effort restores the prior job disposition and requires no store cleanup or record rewrite. The canary also remains red on persistent failure, matching its current inline loop. Either workflow can be rolled back by restoring its prior inline block or switching only that Python call to the best-effort default; neither path needs store cleanup.\n\n**D5 — Strict mode fails loud on EVERY silent return, not only retries-exhausted.**\n`push_tickets_branch` has several best-effort exits that today return normally while the push stays\npending; strict mode must cover ALL of them or it closes one hole and leaves the rest. They are\nidentified by BRANCH, not by line number — `push.py` changed twice on 2026-08-06 (most recently\n`bfdb68070a`, the 2a76 rejection-surfacing fix, +78 lines), so line citations go stale fast. Line\nhints below are against `43ecfa8f27` and are hints only; the branch description is authoritative:\n\n* **malformed destination config** — resolving the destination raises `ConfigError` and currently returns best-effort; strict raises `invalid-destination`.\n* **missing configured remote** — `git remote get-url` cannot resolve the named remote and currently returns best-effort; strict raises `remote-not-found`.\n* **non-retriable push result** — the `_is_non_fast_forward()` false arm, `return # non-retriable class — best-effort` (~:243). Preserve the operational distinction already carried by `_POLICY_DECLINE_MARKERS`: permanent hook/GH013/branch-protection blocks raise `push-policy-declined`, while timeouts, network drops, and other transport failures raise `push-transport-failed`. The path `bfdb68070a` taught to print git's detail must additionally fail loud in strict mode.\n* **rebase/merge-recovery guard** — the `check_no_rebase_in_progress()` failure arm,\n  `return # best-effort` (~:275-281).\n* **store-epoch guard, both call sites** — each `compat.store_epoch_merge_target()` returning a\n  `problem`, then `return` (~:283-288 and ~:316-323).\n* **merge-clean then final-push rejected** — `continue # merged clean — retry push next iter` (~:299)\n  currently falls out of the retry loop without a final push. AC1 fixes that silent exit by adding\n  the final push exactly once. After AC1, the strict oracle for this path is the reachable outcome\n  where all five clean-merge cycles occur and that FINAL push is also rejected; it shares the\n  retries-exhausted terminal branch rather than adding a second final push or testing dead code.\n* **write-lock timeout** — `except _lock.LockTimeout: return` (~:353-360).\n\nIn strict mode each CORE branch raises a dedicated, catchable push-delivery exception carrying its\nown distinct reason and unpushed count; core never calls `sys.exit`. The private module CLI is the\nsole process boundary that catches this exception, writes its reason to stderr, and returns non-zero.\nThe merge-clean path uses the final-push-rejected terminal reason described above rather than a\nsecond branch. In best-effort mode every path keeps current behaviour byte-for-byte.\n\nChild ownership is dependency-ordered: 953a defines the reusable `PushDeliveryError`, all push-core raises, and the initial private module `push` action that alone translates it to stderr/nonzero. 2bc9 reuses that exact exception and extends the same adapter with `commit-and-push`; it does not define a second error vocabulary or translation path. Tests in 953a select semantic branches through injected seams, never source line numbers, and assert exactly one final push after the five merge cycles.\n\n\n**D6 — `sync.push = off` / `async` is a CONFIGURATION CONTRADICTION in strict mode, and fails loud.**\n`push_tickets_branch` resolves `_push_mode()` FIRST and returns before any D5 branch is reachable:\n`off` returns immediately, `async` detaches a child and returns. So a strict call under either config\nwould return normally having pushed nothing — the reconciler's commit-back carries inbound events\nthat exist nowhere else, so that is silent data loss, and it is the failure this whole ticket exists\nto remove. Resolution, in two layers:\n* **In core:** strict mode treats `off` and `async` as contradictions and raises the same dedicated,\n  catchable push-delivery exception immediately with a named reason; only the private module CLI\n  translates it to a non-zero process exit. Strict means \"confirm synchronously that these commits reached origin\";\n  `off` says never push and `async` says push in a detached child whose outcome the caller cannot\n  observe. Neither can satisfy the request, so strict must refuse rather than appear to succeed.\n* **At the call site:** both workflows pin `REBAR_SYNC_PUSH=always` so the contradiction\n  cannot arise in production even if a client config sets otherwise.\nBest-effort mode keeps today's `off`/`async` behaviour byte-for-byte — this changes nothing for\nexisting callers. Related: `e1ed-b700-c442-4d0c` covers the separate problem that on `async` the\nfailure is UNDELIVERABLE rather than merely unreported; D6 avoids that path for strict callers\ninstead of depending on `e1ed` landing first.\n\n\n**D7 — The commit-back's identity moves with it.**\n`reconcile-bridge.yml` sets `git config --global user.name/user.email` from `BRIDGE_BOT_NAME` /\n`BRIDGE_BOT_EMAIL` (repo variables, defaulting to `rebar-bridge[bot]` /\n`joeoakhart+bot@navapbc.com`) immediately before the commit-back. Moving `git add -A && git commit`\ninto the core entrypoint (D3) moves the commit away from that shell-level `git config`, so the\nidentity must be passed explicitly rather than inherited: the entrypoint accepts an author\nname/email and applies it per-commit (`-c user.name=... -c user.email=...`), falling back to the\nambient git identity when unset so local callers are unaffected. Without this the reconciler's\ncommits would silently be attributed to the runner's default identity — and the store's authorship\nrecords (`author_email`, `author_id`) are derived from it, so this is a data-correctness concern, not\ncosmetics.\n\n\n## Acceptance Criteria\n\n- [ ] 4c4f's final-push fix is ported into `push.py`; core performs five merge/retry cycles followed by the final push\n- [ ] `push.py` gains an explicit strict mode whose core raises a dedicated catchable delivery\n      exception carrying the git reason plus unpushed-commit count; the private module CLI alone\n      translates it to non-zero and stderr, with tests at both boundaries\n- [ ] Strict mode emits NO BRIDGE_ALERT event (D1), so this ticket does not resurrect the emitter 030f\n      deletes; a test asserts no event file is written on a strict-mode failure\n- [ ] A new core entrypoint stages+commits only when dirty and then ALWAYS delegates to push (D3). A DIRTY-tree test asserts events are committed and pushed; a CLEAN-but-locally-ahead test asserts the existing commit is pushed without an empty commit; and a paired strict persistent-rejection test asserts the clean/ahead commit remains reachable while core raises and the CLI returns nonzero rather than silently succeeding\n- [ ] The private `python -m rebar._store.push` adapter exposes named `commit-and-push` and `push` actions; executable subprocess tests prove flags reach the intended core function\n- [ ] The reconciler passes `chore: sync events from rebar reconciler [run ${{ github.run_id }}]` unchanged and a real commit-metadata assertion pins that subject\n- [ ] `push_tickets_branch` remains push-only; a semantic-plus-string caller inventory covers event append, batch append, NDJSON import, transition close, both delete paths, both compact paths, and claim, and tests pin every site to the unchanged best-effort default while the shared five-cycle/final-push durability correction is inherited\n- [ ] BOTH YAML CAS loops are deleted (`reconcile-bridge.yml`, `reconcile-bridge-canary.yml:208-246`);\n      each workflow calls one core entrypoint and contains NO raw git write\n- [ ] `reconcile-bridge.yml`'s SINGLE `raw-git-ok` marker is REMOVED rather than re-scoped, and\n      `scripts/check_raw_git_writes.py` passes without it. Scope note: that lint tracks only\n      `MUTATION_VERBS` = {add, commit, rm, mv, reset, update-ref, checkout, clean}\n      (`check_raw_git_writes.py:81-83`) — it does NOT track push/fetch/merge, so the canary carries no\n      marker (verified: 0 occurrences) and the lint passing does NOT by itself prove the CAS loops are\n      gone. Loop removal is proven by the separate AC that each workflow calls one core entrypoint\n- [ ] Both inline standing-decision blocks are updated with the reversal and its rationale:\n      `reconcile-bridge.yml:285` and `reconcile-bridge-canary.yml:14-19` — plus the\n      `canary_bridge.py:8-11` docstring and the push-retry test docstring\n- [ ] A comment on ticket 4c4f records the overturn and its rationale\n- [ ] The contention test is re-homed against `push.py` (in-process, no YAML extraction) and still\n      covers the same rejection→fetch→merge→re-push failure modes with a deterministic competing push\n- [ ] CHANGELOG notes that `reconcile-bridge-canary.yml` is a client-copied template whose shape changed;\n      `docs/jira-sync-setup.md` gives existing copied-loop clients an opt-in migration to the thin template, explicitly notes the immediate-re-push timing change, and gives a no-cleanup rollback to the prior inline loop\n- [ ] Strict mode fails loud on EVERY silent best-effort return in `push_tickets_branch`, identified\n      by BRANCH per D5 (malformed destination, missing configured remote, permanent policy decline, transient transport failure, rebase/merge-recovery guard, both store-epoch guard\n      sites, the shared retries-exhausted terminal branch reached when the final push is rejected after\n      five clean merges, and LockTimeout), with one core test per actual control-flow branch asserting\n      the named catchable exception. The five-clean-merge scenario asserts `final-push-rejected` through\n      that shared terminal branch; it is not a separate branch or redundant test. One CLI-boundary test\n      asserts non-zero plus stderr — no test may navigate by line number and no duplicate final push may\n      be added\n- [ ] A test asserts best-effort mode still returns normally on each of those same paths, pinning that\n      strict is opt-in and no existing caller's disposition changed\n- [ ] The SAME exactly two executable workflow smoke tests (one per workflow) carry the combined wiring contract: `reconcile-bridge.yml` invokes `commit-and-push --strict`; `reconcile-bridge-canary.yml` invokes push-only `push --strict`; each entrypoint is actually invoked, reaches `strict=True`, pins `REBAR_SYNC_PUSH=always`, keeps persistent rejection nonzero, and contains no git-output pipe into `tee` or another consumer, proving the e161 SIGPIPE guard is subsumed rather than lost\n- [ ] Strict mode exits non-zero with a named error when `sync.push` resolves to `off` or `async`,\n      rather than returning as a silent no-op (D6); one test per mode\n- [ ] Best-effort mode's `off`/`async` behaviour is unchanged, pinned by a test\n- [ ] The commit-back's author identity is passed explicitly into the core entrypoint and applied\n      per-commit (D7); a test asserts a commit made through it carries the supplied name/email, and\n      another asserts the ambient identity is used when none is supplied\n- [ ] The workflow still sources the identity from `BRIDGE_BOT_NAME`/`BRIDGE_BOT_EMAIL`, so the\n      shipped commits keep today's authorship","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_store/push.py","reason":"strict five-retry CAS semantics and locked commit-back entrypoint"},{"path":".github/workflows/reconcile-bridge.yml","reason":"replace inline CAS loop with strict core entrypoint while retaining behavior"},{"path":".github/workflows/reconcile-bridge-canary.yml","reason":"replace client-copied inline CAS loop with best-effort core entrypoint"},{"path":"scripts/check_raw_git_writes.py","reason":"verify workflow migration removes raw git writes without exemptions"},{"path":"scripts/canary_bridge.py","reason":"update standing decision after core extraction"},{"path":"tests/scripts/test_reconcile_bridge_push_retry.py","reason":"re-home contention contract and reverse obsolete extraction decision"},{"path":"tests/unit/test_push_strict.py","reason":"strict versus best-effort failure matrix"},{"path":"tests/interfaces/store/test_push_contention.py","reason":"real-git five-competitor convergence oracle"},{"path":"docs/concurrency.md","reason":"document strict opt-in and best-effort compatibility"},{"path":"docs/jira-sync-setup.md","reason":"document migration and rollback for existing copied workflows"},{"path":"CHANGELOG.md","reason":"announce client template shape and continuity path"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","2f79-2b32-28c5-4eb3"]],"no_file_impact_reason":"","parent_id":"2f79-2b32-28c5-4eb3","parent_status_uuid":"98449745-785f-4036-8a62-cc8e8917372f","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["bridge"],"ticket_id":"1c1b-1da2-7ff4-4770","ticket_type":"story","title":"Collapse the duplicated CAS push loop into core","verify_commands":[]},"source_event_uuids":["04430aa9-73ba-4f4a-95cd-f90cf276c500","c699c538-7d01-4273-96b2-4c6be1e735e0","032a7200-4574-43e7-867c-af6b6fd07dcc","64c57136-ede0-4f66-bab1-8d25baa2ef97","ee9bd1eb-8be6-4087-aaa8-0bc027affb91","808a7142-423a-45ba-8604-bf99a9643816","59d66901-1c32-4a84-a0ef-824aaf1dfd60","554c6d0d-94a6-452a-9b58-29c8adaeb6d3","743037df-d1c9-4008-921a-ab2a74216be9","a39e6443-5164-4956-a3eb-335cc9e12931","b6bc838e-4160-44d5-a5d9-c2bbada2161c","0153b6e2-b713-4450-bb65-26714b32ee01","cdd5b232-5107-43bf-9732-2e8a44ddcee0","9714e250-e9c9-4d91-8178-c71fbe2535c3","a4570b5a-3dc7-45a8-84f3-48d075ad8b51","9db59111-6702-4642-b721-96f3294ff3df","bc83bcd6-7058-4e3f-95c7-b01112e78b84","571dbc80-8cc0-4186-8767-8f1488c2046b","581fbc5d-b2dc-45d8-b61f-b1775b69c368","c1475a60-b584-496b-a788-84745cbc67e3","7326dc0a-1366-4319-ac04-e268f17cfa4d","f5d88556-53ec-4366-bd29-379ef704ee56","c148c765-d4f6-477e-81ea-bb14c11b9b8a","796c6eb3-4cc3-4a42-86eb-0df57bb16095","1645013d-7cfa-41a2-9827-848b5c0c76a1","f08abd98-4ece-42b9-9a44-d3c9c07e8318","d1cc3d73-e393-46df-b997-922d132a7966","2a1b1a1a-d638-4390-a697-44dddf9f2ed1","b3a16c3f-74c0-490d-ad17-a0bbc4680ec1","991d0428-46cf-4c12-acea-efe1d1cb8462","20074e19-77e2-4629-b284-6ea9c1ca4bb5","98449745-785f-4036-8a62-cc8e8917372f","b36acfaa-c8e4-4ce2-b3d7-9e72e92c9384"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786148670270033002,"uuid":"f786ab02-3fe5-4ec1-942d-2571c968da03"}