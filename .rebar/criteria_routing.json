{
  "plan_review": {
    "project.portability": {
      "exec": "1-TURN",
      "facet": "project-invariants",
      "applies_at": {
        "scope": [
          "container",
          "leaf"
        ]
      },
      "default_posture": "blocking",
      "block_threshold": 0.9,
      "checklist": []
    },
    "project.symbol-reference-completeness": {
      "exec": "AGENT",
      "facet": "project-invariants",
      "applies_at": {
        "scope": [
          "container",
          "leaf"
        ]
      },
      "default_posture": "advisory",
      "block_threshold": 0.9,
      "checklist": []
    },
    "project.engine-layer-enforcement": {
      "exec": "1-TURN",
      "facet": "project-invariants",
      "applies_at": {
        "scope": [
          "container",
          "leaf"
        ]
      },
      "default_posture": "advisory",
      "block_threshold": 0.9,
      "checklist": [],
      "trigger": [
        {
          "text_all": [
            "\\b(validat\\w*|guard\\w*|invariant\\w*|enforc\\w*|precondition\\w*|sanitiz\\w*|reject\\w*|refus\\w*|check\\w*)\\b"
          ]
        },
        {
          "text_all": [
            "src/rebar/(_commands|_cli|_lib_\\w+|mcp_server)"
          ],
          "file_impact_globs": [
            "src/rebar/_commands/*",
            "src/rebar/_cli/*",
            "src/rebar/mcp_server.py",
            "src/rebar/_lib_*.py"
          ]
        }
      ]
    },
    "project.measurement-provenance": {
      "exec": "AGENT",
      "facet": "codebase-grounding",
      "applies_at": {
        "scope": [
          "container",
          "leaf"
        ]
      },
      "default_posture": "advisory",
      "block_threshold": 0.9,
      "checklist": [],
      "trigger": [
        {
          "text_all": [
            "\\[operator-attested\\]"
          ]
        }
      ]
    }
  },
  "code_review": {
    "project.review-phase-boundaries": {
      "exec": "1-TURN",
      "default_posture": "advisory",
      "block_threshold": 0.9,
      "blocking_enabled": false,
      "applies_to": []
    },
    "project.ci-gate-compat": {
      "_comment": "Ticket unaroused-undead-ibisbill: project dogfood criterion. A new hard-fail pipeline gate must guard or grandfather branches created before it, or every in-flight branch breaks. GLOB-TRIGGERED through applies_to (the declarative, tech-agnostic seam) rather than a hard-coded CI path in Python, which project.portability forbids; adding a CI system is adding a glob here. applies_to_config_key lets a project REPLACE the glob set via [code_review] ci_config_globs instead of waiting for rebar to enumerate its layout. ADVISORY in v1 (blocking_enabled=false) pending calibration on real reviews.",
      "exec": "1-TURN",
      "applies_to": [
        "**/.github/workflows/**",
        "**/Jenkinsfile*",
        "**/.gitlab-ci.yml",
        "**/.circleci/**",
        "**/azure-pipelines*.y*ml",
        "**/.buildkite/**",
        "**/bitbucket-pipelines.yml",
        "**/.drone.yml"
      ],
      "applies_to_config_key": "code_review.ci_config_globs",
      "default_posture": "advisory",
      "block_threshold": 0.9,
      "blocking_enabled": false
    }
  },
  "activate": {
    "project.portability": [
      "plan_review"
    ],
    "project.symbol-reference-completeness": [
      "plan_review"
    ],
    "project.review-phase-boundaries": [
      "code_review"
    ],
    "project.engine-layer-enforcement": [
      "plan_review"
    ],
    "project.measurement-provenance": [
      "plan_review"
    ],
    "project.ci-gate-compat": [
      "code_review"
    ]
  }
}
