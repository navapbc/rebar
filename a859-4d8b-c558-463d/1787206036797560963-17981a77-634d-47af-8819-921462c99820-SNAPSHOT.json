6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"41c88296a0d72a14ec54e2da7f47237e25e7ca9a7598c89abe7a552e937aab58","event_uuid":"4b3b1855-3674-4bf8-8b75-6d1527bc165f","position":{"commit_sha":"f217c4990b67e37f902eb0e2f1875dbf53d9aef2","position":"1787198995741986001-4b3b1855-3674-4bf8-8b75-6d1527bc165f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f976bddb65957402ee16a06dd79bb258c704db410983b524fbf21add39be0a07","event_uuid":"d25b6d44-4c61-4651-a1cf-5a38f97f0d9b","position":{"commit_sha":"cbd48463a3e959e5f3dac6211748cc3162f669e4","position":"1787202288641740693-d25b6d44-4c61-4651-a1cf-5a38f97f0d9b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-236_agent","claim_remote_session":null,"claimed_session":"d76562af-5785-4ef5-899c-57d3a1e383f5","comments":[],"created_at":1787185959426553001,"creation_channel":"cli","deps":[{"link_uuid":"284cd4bc-7f36-47c8-b78a-8cca0fac9d0e","relation":"depends_on","target_id":"3726-a1b0-c9bb-4d83"},{"link_uuid":"d25b6d44-4c61-4651-a1cf-5a38f97f0d9b","relation":"relates_to","target_id":"20cf-6e44-7541-4df1"}],"description":"## What\n\nParametrize the existing detector and close-guard suites over both `[non-codebase]` and\n`[operator-attested]` so the alias has an explicit regression suite rather than relying on the\nold tests incidentally still passing.\n\n## Scope\n\nAdd a both-spellings case to: `tests/unit/test_det_attestation_launder.py`,\n`tests/unit/test_det_measurement_provenance{,_heldout}.py`,\n`tests/unit/test_attested_close_guard.py`,\n`tests/interfaces/lifecycle/test_attested_close_guard_e2e.py`,\n`tests/unit/test_a8e5_operator_attested_edge.py`.\n\nAlso cover the PLAN-TIME surfaces the parent AC names but the guard suites do not reach:\n`tests/unit/test_det_floor_operator_attested.py` (the `p6_ac_quality` advisory lint via\n`operator_evidence_ac_gaps`) and `tests/unit/test_plan_review.py` (the `decide_ops` Pass-3\n`enrich_operator_attested` path). Without these, the parent's five-surface parity claim is\nunproven for two of its five surfaces.\n\nDecide and pin the near-miss policy for the new tag: `[operator_attested]` is a DELIBERATE\nnon-match asserted in ~15 places (ADR-0043). `[non_codebase]` and `[noncodebase]` need the\nsame treatment.\n\n## Coverage ALREADY LANDED by S1 (do not duplicate)\n\nS1 landed `tests/unit/test_non_codebase_tag_edge.py`, which already parametrizes both spellings\nover the plan-time lint (`test_plan_time_lint_parity`, p6_ac_quality) and over Pass-3 enrichment\n(`test_enrichment_parity`, operator_attested_ac_texts), and already pins the near-miss non-match\npolicy for `[non_codebase]`, `[noncodebase]`, `[non codebase]`, `[operator_attested]` and\n`[codebase]` (`test_near_misses_fail_safe_to_codebase_verifiable`). The legacy underscore\nnear-miss is additionally pinned in `tests/unit/test_a8e5_operator_attested_edge.py:21-24,56-61`.\n\nThose two parity surfaces and the near-miss policy are therefore PROVEN, not outstanding. This\nstory does not re-assert them; it extends both-spellings coverage to the guard suites S1 did not\nreach.\n\n## Scope boundary with S6\n\n`tests/interfaces/lifecycle/test_ac_checkbox_precheck*.py` is OWNED BY S6, which changes the\nclose-guard message strings those tests assert on. This story does not touch it, so S3, S4 and\nS6 are file-disjoint and may be executed in parallel. Close-gate parity for the new tag already\nlanded with S1 in `tests/interfaces/lifecycle/test_non_codebase_close_exempt.py`, so nothing is\nlost by the exclusion.\n\n## Acceptance Criteria\n\n- [ ] Each listed suite exercises both spellings and asserts identical outcomes.\n- [ ] The laundering detector, the provenance guard, and the a8e5 edge suite each exercise both\n      spellings and assert identical outcomes.\n- [ ] `[non_codebase]` and `[noncodebase]` are asserted NOT to match, mirroring the existing\n      `[operator_attested]` contract.\n- [ ] No existing assertion was weakened to make the new cases pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_det_attestation_launder.py","reason":"parametrize laundering detector over both spellings"},{"path":"tests/unit/test_det_measurement_provenance.py","reason":"parametrize provenance guard over both spellings"},{"path":"tests/unit/test_det_measurement_provenance_heldout.py","reason":"parametrize held-out provenance edges over both spellings"},{"path":"tests/unit/test_a8e5_operator_attested_edge.py","reason":"near-miss policy for the new tag"},{"path":"tests/unit/test_det_floor_operator_attested.py","reason":"plan-time lint (p6_ac_quality) parity over both spellings"},{"path":"tests/unit/test_plan_review.py","reason":"decide_ops Pass-3 enrichment parity over both spellings"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","3726-a1b0-c9bb-4d83"],["parent","6f5a-4a49-7bbf-4a30"],["relates_to","20cf-6e44-7541-4df1"]],"no_file_impact_reason":"","parent_id":"6f5a-4a49-7bbf-4a30","parent_status_uuid":"c22b81c0-1ae8-4533-9ade-090ad559792b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"a859-4d8b-c558-463d","ticket_type":"story","title":"S3 — compatibility regression suite: both spellings behave identically","verify_commands":[]},"source_event_uuids":["42d77b4d-1f96-45ff-91d7-2daf8c05ae2f","3a087438-df6b-4418-8f07-f3fd0ec5e684","d4cf293f-93e5-49da-bba2-b45ce32d66ff","fb7b35b8-0fe3-4cd3-9d32-aac12702ff0c","ed2a7770-e648-4172-be1d-7aa4560af5cc","d9c0361a-cb64-42eb-a1f7-fa324ce62266","10729e96-4856-4a73-9c79-13262476952e","91aede73-f9b2-4929-9198-1b4d2f284575","c22b81c0-1ae8-4533-9ade-090ad559792b","4b3b1855-3674-4bf8-8b75-6d1527bc165f","d25b6d44-4c61-4651-a1cf-5a38f97f0d9b"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787206036797560963,"uuid":"17981a77-634d-47af-8819-921462c99820"}