f1fc8338e1","position":{"commit_sha":"baa99fcddb063ba9e92112fb35d3e4918dce6f22","position":"1785724455099779001-14423f17-467b-4370-b7b2-0af1fc8338e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d1fc2de9f63b610be6bfd4ee099603a74265b6506d4dfd24da17092a16525790","event_uuid":"c48f9adb-ceec-4b0d-9c19-485a0300875a","position":{"commit_sha":"e9d1bcf6307600c17a3c28803293c68c5bced319","position":"1785724515563702001-c48f9adb-ceec-4b0d-9c19-485a0300875a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"42588da5eb9af9bc100c108143784023cc18d5a4a013171870d5b2e2e683cb7b","event_uuid":"5df96532-9bcc-4b4d-9a61-a5d99a2cb3d3","position":{"commit_sha":"e9d1bcf6307600c17a3c28803293c68c5bced319","position":"1785724516186109001-5df96532-9bcc-4b4d-9a61-a5d99a2cb3d3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"e4ff696d-43b7-4303-8b3b-ae64d74a6873","comments":[],"created_at":1785718531221050001,"creation_channel":"cli","deps":[{"link_uuid":"157b8b9f-cc2f-4ea1-837f-f815793a53ba","relation":"discovered_from","target_id":"5200-e04e-246e-4aae"}],"description":"# Outbound clear-assignee cannot unassign on Jira Data Center\n\nFound while writing the row-9 outbound cell of the J11 mutation table\n(story 5200-e04e-246e-4aae). NOT fixed here — filed per that story's rule that a\ncell revealing a product defect stops and reports.\n\n## Mechanism (proven by code path, three links in a chain)\n\n1. The differ's desired value for an EMPTY local assignee is the EMPTY STRING, not\n   None: `outbound_differ._assignee_resolver` returns `(\"\", True, False)` when\n   `not assignee` (src/rebar/_engine/rebar_reconciler/outbound_differ.py:504-505).\n   `assignee` is in `_OUTBOUND_BATCH_ALLOWLIST`\n   (dispatch_apply_phases.py:46), so it reaches `client.update_issue(key,\n   assignee=\"\")`.\n\n2. The DC transport forwards that empty string VERBATIM to the vendor library.\n   `JiraDataCenterTransport.update_issue` pops `assignee` and calls\n   `self._assign(remote_id, assignee)` whenever the key is present — there is no\n   empty-value branch (adapters/jira_datacenter/transport.py:281-287, 290-303).\n   `_assign` calls `self._client.assign_issue(remote_id, \"\")`.\n\n3. pycontribs/jira treats ONLY None / -1 / \"-1\" as Unassigned. In jira 3.10.5,\n   `JIRA._get_user_id` starts `if user in (None, -1, \"-1\"): return user` and\n   otherwise runs `search_users(user=\"\", maxResults=20)`, raising\n   `JIRAError(\"No matching user found for: ''\")` when that returns nothing — and\n   when it returns something, it assigns THAT arbitrary user. So the empty string\n   is not an unassign instruction on this path at all.\n\n## Cloud already has the fix; DC never got its half\n\nThis is bug 85a1's defect class, unported. The Cloud transport routes an\nempty/None assignee through `unassign_issue` instead of passing it on, with the\nreason recorded inline: \"Bug 85a1 (Fix D7): assignee=None/empty is routed through\n`unassign_issue` (REST PUT /assignee with `{\"accountId\": null}`) rather than\npassed to ACLI as `--assignee \"\"`, which ACLI silently no-ops\"\n(adapters/jira/acli.py:342-345, guard at :357-359).\n\nThe shape is identical to bug d067 (the status-to-transition seam existed on Cloud\nand Data Center simply never got its half), which the DC `update_issue` docstring\nitself records at transport.py:265-275.\n\n## Expected failure\n\n`tests/external/live_jira_dc/test_dc_mutations.py::test_outbound_unassign_round_trips`\nasserts `fields.assignee` is null on the DC issue after a local assignee clear\nconverges. It should go RED on the harness until this is fixed.\n\n## Suggested fix\n\nGive the DC transport the same empty-assignee branch Cloud has: in `_assign`, map a\nfalsy assignee to `None` before calling `assign_issue` (pycontribs then PUTs\n`{\"name\": null}`, which is DC's unassign), rather than letting `\"\"` reach\n`_get_user_id`.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/transport.py","reason":"assign_issue must translate an empty/absent assignee to the Unassigned sentinel pycontribs accepts (None/-1), mirroring Cloud acli.py:342-345,357-359"},{"path":"tests/unit/rebar_reconciler/test_dc_unassign_751e.py","reason":"NEW: an empty local assignee must reach DC as an actual unassign, asserted on the resulting field being empty, not on absence of an exception"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","e369-a449-4773-48fb"]],"no_file_impact_reason":"","parent_id":"e369-a449-4773-48fb","parent_status_uuid":"c48f9adb-ceec-4b0d-9c19-485a0300875a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"751e-06f1-bb0b-464c","ticket_type":"bug","title":"DC outbound clear-assignee never unassigns (empty string reaches assign_issue)","verify_commands":[]},"source_event_uuids":["343dc6a0-b3e4-449f-8986-cd700fd151df","157b8b9f-cc2f-4ea1-837f-f815793a53ba","f8edc3fc-ee61-4fdd-9a82-f7f7deaecca3","68dd1b5c-8c4c-4bad-affb-eea31a61403f","14423f17-467b-4370-b7b2-0af1fc8338e1","c48f9adb-ceec-4b0d-9c19-485a0300875a","5df96532-9bcc-4b4d-9a61-a5d99a2cb3d3"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785724516186109002,"uuid":"f8a07c83-9f61-4e69-b9b7-4608496440b5"}