{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast,io,json,re,subprocess,tokenize\nfrom pathlib import Path\nB=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nM=json.loads(\"\"\"{\"tests/scripts/test_observability_container_layers.py\":{\"docs\":[\"module\",\"_share_bytes\",\"_df_rows\",\"test_the_writable_layer_size_and_the_exited_subset_are_both_published\",\"test_the_percentage_is_measured_against_the_share_the_reaper_holds\",\"test_a_share_overrun_publishes_its_true_ratio\",\"test_the_metrics_are_dimensionless_on_the_publishing_side\",\"test_an_unmeasurable_writable_footprint_publishes_nothing\",\"test_a_two_column_rendering_still_publishes_the_total\",\"test_the_reaper_heartbeat_publishes_on_every_tick_including_its_zero_path\",\"test_the_reaper_heartbeat_is_published_even_when_the_daemon_is_gone\",\"test_the_quota_reading_reports_the_regime_the_box_is_actually_in\",\"test_the_probe_never_reaps\"],\"spans\":[[1,31],[68,69],[93,98],[142,143],[153,155],[170,171],[184,185],[249,251],[257,258],[266,268],[278,282],[293,295],[309,311],[325,326],[334,335],[342,344],[351,354],[361,363],[373,376],[383,385]]},\"tests/scripts/test_observability_docker_storage.py\":{\"docs\":[\"module\",\"test_the_incident_shape_is_reported_as_unaccounted_bytes\",\"test_unaccounted_bytes_are_clamped_at_zero\",\"test_the_ledger_sums_every_row_docker_accounts_for\",\"test_a_build_cache_is_not_reported_as_unreachable_residue\",\"test_the_residue_survives_a_daemon_that_stores_layers_outside_overlay2\",\"test_an_unknown_ledger_row_does_not_take_the_metric_off_the_air\",\"test_the_docker_metrics_carry_no_dimensions\",\"test_a_failed_du_publishes_nothing_at_all\",\"test_an_unreadable_overlay2_suppresses_nothing_at_all\",\"test_a_budget_overrun_publishes_its_true_ratio\",\"test_a_missing_cap_script_still_publishes_the_raw_byte_readings\"],\"spans\":[[1,26],[107,108],[111,112],[186,188],[192,197],[207,207],[212,216],[228,233],[245,254],[268,277],[326,331],[338,340],[359,360],[365,369],[381,383],[387,391],[413,419],[437,445],[463,471]]},\"tests/scripts/test_observability_journal.py\":{\"docs\":[\"module\",\"test_the_percent_is_measured_over_the_tree_the_ceiling_governs\",\"test_a_ceiling_overrun_publishes_its_true_ratio\",\"test_an_unmeasurable_journal_publishes_nothing_rather_than_zero\",\"test_the_size_is_still_published_when_the_ceiling_is_unreadable\",\"test_the_heartbeat_is_zero_when_the_daemon_predates_the_dropin\",\"test_the_heartbeat_is_published_even_with_no_dropin_installed\",\"test_the_heartbeat_survives_an_unmeasurable_journal\"],\"spans\":[[1,24],[104,105],[119,120],[194,196],[207,213],[222,226],[233,235],[239,240],[248,249],[257,259],[271,276],[283,284],[291,292]]},\"tests/scripts/test_observability_pct_of_cap_b380.py\":{\"docs\":[\"module\",\"_function_source\",\"test_every_overrun_reports_its_own_magnitude\",\"test_the_helper_carries_no_clamp\"],\"spans\":[[1,32],[50,51],[57,63],[105,108],[126,128]]},\"tests/scripts/test_observability_var_tmp.py\":{\"docs\":[\"module\",\"test_the_percent_is_measured_over_the_tree_the_budget_governs\",\"test_a_budget_overrun_publishes_its_true_ratio\",\"test_an_unmeasurable_var_tmp_publishes_nothing_rather_than_zero\",\"test_the_size_is_still_published_when_the_budget_is_unreadable\",\"test_the_cleanup_heartbeat_is_published_on_every_tick_including_its_zero_path\",\"test_the_hard_quota_heartbeat_reports_the_regime_the_box_is_actually_in\",\"test_the_heartbeats_survive_a_var_tmp_that_cannot_be_measured\",\"test_the_var_tmp_walk_is_wall_clock_bounded\"],\"spans\":[[1,25],[122,123],[145,146],[208,210],[221,224],[233,236],[243,245],[249,251],[259,260],[268,270],[276,277],[290,292],[303,304],[312,314],[318,321]]}}\"\"\")\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nOWNERS=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef norm(raw,path):\n tree=ast.parse(raw,filename=path,type_comments=True); seen=[]\n def walk(node,parent=\"module\"):\n  q=parent\n  if isinstance(node,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)): q=node.name if parent==\"module\" else parent+\".\"+node.name\n  if isinstance(node,OWNERS) and q in M[path][\"docs\"] and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n   node.body[0].value.value=\"__ALLOWLISTED_PROSE__\"; seen.append(q)\n  for child in ast.iter_child_nodes(node): walk(child,q)\n walk(tree)\n assert sorted(seen)==sorted(M[path][\"docs\"]),(path,\"owner mismatch\",seen,M[path][\"docs\"])\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,include_attributes=False)\ndef protected(raw):\n lines=raw.splitlines()\n return [lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(raw).readline) if t.type==tokenize.COMMENT and (t.string.startswith(\"#!\") or PAT.search(t.string))]\ndef hunks(path):\n diff=subprocess.check_output([\"git\",\"diff\",\"--unified=0\",B,\"--\",path],text=True)\n for line in diff.splitlines():\n  if not line.startswith(\"@@\"): continue\n  m=re.match(r\"@@ -(\\d+)(?:,(\\d+))? \\+\\d+(?:,\\d+)? @@\",line); assert m,(path,line)\n  start=int(m.group(1)); count=1 if m.group(2) is None else int(m.group(2)); end=start+count-1\n  assert count>0 and any(start>=a and end<=b for a,b in M[path][\"spans\"]),(path,\"outside allowlist\",line)\nfor path in M:\n before=subprocess.check_output([\"git\",\"show\",f\"{B}:{path}\"],text=True)\n final=Path(path).read_text(encoding=\"utf-8\")\n assert norm(before,path)==norm(final,path),(path,\"AST/runtime drift\")\n assert protected(before)==protected(final),(path,\"directive/shebang drift\")\n hunks(path)'","dd_id":"immutable-prose-only","dd_text":"Only the 72 allowlisted base blocks may change; allowlisted owner docstrings are normalized while all other AST/runtime content, directives, shebangs, and hunk locations remain exact."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys; expected=sorted(sys.argv[1:]); actual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":expected,\"actual\":actual}' tests/scripts/test_observability_container_layers.py tests/scripts/test_observability_docker_storage.py tests/scripts/test_observability_journal.py tests/scripts/test_observability_pct_of_cap_b380.py tests/scripts/test_observability_var_tmp.py","dd_id":"exact-leaf-paths","dd_text":"The single leaf commit changes exactly the five declared file-impact paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/scripts/test_observability_container_layers.py tests/scripts/test_observability_docker_storage.py tests/scripts/test_observability_journal.py tests/scripts/test_observability_pct_of_cap_b380.py tests/scripts/test_observability_var_tmp.py","dd_id":"focused-contracts","dd_text":"All five observability regression modules pass."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The supported deterministic comment-hygiene policy passes."},{"command":"rtk git diff --check HEAD^..HEAD -- tests/scripts/test_observability_container_layers.py tests/scripts/test_observability_docker_storage.py tests/scripts/test_observability_journal.py tests/scripts/test_observability_pct_of_cap_b380.py tests/scripts/test_observability_var_tmp.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes from the worktree virtualenv without a timeout."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import json,re,subprocess\nstate=json.loads(subprocess.check_output([\"rebar\",\"show\",\"conscious-deductive-jaeger\",\"--output\",\"json\"],text=True))\ncols=[\"path\",\"stable_id\",\"before_citation\",\"final_citation\",\"retained_contract\",\"before_words\",\"final_words\",\"semantic_preservation\",\"bloat_removal\",\"reviewer_session\"]\nheader=\"\\t\".join(cols)\ncandidates=[]\nfor comment in state.get(\"comments\",[]):\n lines=comment.get(\"body\",\"\").splitlines()\n for i,line in enumerate(lines):\n  if line!=header: continue\n  rows=[]\n  for raw in lines[i+1:]:\n   values=raw.split(\"\\t\")\n   if len(values)!=len(cols): break\n   rows.append(dict(zip(cols,values)))\n  candidates.append(rows)\ndef valid(rows):\n if len(rows)!=72 or len({r[\"stable_id\"] for r in rows})!=72: return False\n for r in rows:\n  if not all(r[c] for c in cols): return False\n  if not r[\"before_citation\"].startswith(\"d6669496cae441fc8381b5ee6de21a3993defd84:\"): return False\n  if not re.fullmatch(r\"[0-9a-f]{40}:.+#.+\",r[\"final_citation\"]): return False\n  if r[\"semantic_preservation\"]!=\"PASS\" or r[\"bloat_removal\"]!=\"PASS\": return False\n  try:\n   if int(r[\"final_words\"])>=int(r[\"before_words\"]): return False\n  except ValueError: return False\n return True\nassert any(valid(rows) for rows in candidates),\"no complete 72-row reviewer TSV comment\"'","dd_id":"review-tsv","dd_text":"A ticket-linked non-author TSV contains exactly 72 unique rows; every row has immutable before/final citations, fewer final words, both PASS verdicts, and a reviewer session."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788665356818380001,"uuid":"0fa82024-695e-4cab-a26e-ea43d8244b4e"}