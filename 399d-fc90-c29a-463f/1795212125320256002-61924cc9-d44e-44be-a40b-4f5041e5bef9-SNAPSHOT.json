cf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan amended after implementation evidence: the 32 s push-shim run with only the publish fix still failed (A must hold a COMMENT orphan); A's reflog showed 'reset: moving to origin/tickets' just before COMPACT, i.e. the 60 s ensure_fresh read sync. Added pinning A's view with the existing REBAR_SYNC_PULL=off switch. Fast fail-push shim: before 2 failed in 27 s, after 2 passed in 49 s; no shim after: 2 passed in 17 s.","timestamp":1795210982955593001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation evidence (commit ffe726efe51, local): fail-push shim before 2 failed (27.30 s), after 2 passed (49.14 s); 32 s slow-push shim after both fixes 2 passed in 994.11 s with -o timeout=1800 (calls 476.69 s and 350.19 s); no shim 2 passed in 17.08 s.","timestamp":1795212125320256001}],"created_at":1795207498457918001,"creation_channel":"cli","deps":[{"link_uuid":"5ce99dfd-6dad-4cf3-8b7a-86d2812f8368","relation":"relates_to","target_id":"2977-df28-8e9f-4a50"}],"description":"## Context / Problem\n`tests/integration/test_fold_cross_clone_horizon.py` failed in 3 of the Nov 19-20 2026 local `make verify` runs on oversubscribed hosts and passes in CI: `test_snapshot_repair_on_stale_clone_keeps_concurrent_tag` with \"SETUP: the merge must land B's tag\" (verify-willet.log) and \"SETUP: A must hold a COMMENT orphan to repair\" (bug-create-replay make-verify.log), and `test_fold_on_stale_clone_keeps_concurrent_tag` (fix-ref-lock-test-bound). Both are setup assertions, not the behavior under test.\n\n## Root cause (verified): two load-sensitive setup assumptions\nEach test drives two clones through real `rebar` child processes and needs exact control over what each clone has seen. Two production behaviors, both correct and best-effort by design, break that control on a slow host:\n1. Delivery. A rebar write pushes best-effort: `push_tickets_branch` bounds each `git push` at 30 s, retries a timed-out push (3 attempts), and never fails the write (`src/rebar/_store/push.py`). When every attempt times out, the write exits 0 without reaching origin, and the other clone's next fetch misses it.\n2. Freshness. Every rebar read surface reconverges from origin when its 60 s freshness marker has expired (`ensure_fresh` in `src/rebar/_engine_support/reads.py`). `store compact --skip-sync` skips only the compact's own pre-fetch. When more than 60 s of wall time pass between B's write and A's fold, A's compact fast-forwards to origin first (A's reflog shows `reset: moving to origin/tickets` immediately before `COMPACT`), so A absorbs B's comment and there is no orphan: \"SETUP: A must hold a COMMENT orphan to repair\".\n\nDeterministic reproductions (Nov 20 2026, origin/main 8e1d15e664f):\n- A PATH `git` shim that fails rebar's own pushes fast (argv `push origin HEAD:tickets`, without `-q`) makes both tests fail at setup in about 8 s each (B cannot see A's ticket); without the shim they pass.\n- A shim that sleeps 32 s before every push makes the steps take minutes. With only fix 1 applied, `test_snapshot_repair_on_stale_clone_keeps_concurrent_tag` still fails with \"SETUP: A must hold a COMMENT orphan to repair\", and A's reflog shows the read-sync reset.\n\n## Approach\nMake both preconditions explicit and checked in the test module; no product code changes.\n- `_publish(tracker)`: a checked `git push -q origin HEAD:tickets` from a clone's tracker (a no-op when the best-effort push already landed), called after every write a later cross-clone fetch depends on: A's create and comment, B's comment, B's tag edit. `store compact ... --skip-sync` never pushes, so A's later writes are only read by A.\n- `_PINNED_VIEW = {\"REBAR_SYNC_PULL\": \"off\"}`, the existing documented switch that disables read reconvergence, passed to A's 3 steps that must not see B's newest write: the compact in each test and the `store fsck --repair-snapshots` run.\n\n## Scope\n- `tests/integration/test_fold_cross_clone_horizon.py`\n\n## Testing\n- Fast fail-push shim: both tests pass after the change (they fail before it), runs recorded here.\n- Reproduction harness: under the 32 s push shim each rebar write spends about 92 s in its retried push and each `_publish` about 32 s, so the shim runs pass `-o timeout=1800` on the pytest command line to lift the 300 s per-test budget for that run only; the module carries no new marker. Under the shim both tests pass after the change (they fail before it), runs recorded on this ticket.\n- Without the shim both tests still pass.\n- The module's existing assertions on SNAPSHOT placement, tag survival and fsck orphan rows are unchanged.\n\n## Acceptance Criteria\n- [ ] Both fold cross-clone tests pass under the fail-push shim, under the 32 s push shim (with `-o timeout=1800`), and without a shim (default budget), runs recorded here.\n- [ ] Clone A's fold and repair steps run with read reconvergence disabled.\n- [ ] Every cross-clone fetch in the module follows a checked publish of the write it depends on.\n- [ ] `make verify` passes on the change and Gerrit gives Verified +1.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"tests/integration/test_fold_cross_clone_horizon.py","reason":"checked publish of each write the next cross-clone fetch depends on"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","2977-df28-8e9f-4a50"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"7c91b265-4910-4f94-af08-b4e67b12c62b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"399d-fc90-c29a-463f","ticket_type":"bug","title":"Fold cross-clone tests assume best-effort pushes landed and no read-sync ran; a slow host breaks their setup","verify_commands":[]},"source_event_uuids":["27a9ab69-6e8a-400c-b1be-f7a65b4c3726","c0b23c7d-5cf4-470d-afc0-91ed0472b3fd","5ce99dfd-6dad-4cf3-8b7a-86d2812f8368","57ae62de-1370-48ab-a979-69622be8cc6b","f9e358d2-08a1-4387-a407-cd19ac913c3e","7c91b265-4910-4f94-af08-b4e67b12c62b","9a31c84a-b74d-4050-90ee-a2a583145545","a2edfb3b-42a7-4a09-9fb4-678e428adc67","4c0587f8-7192-4b30-9734-ddde5041925b","21e22745-b7f4-43c9-973a-3be5158ae4a2"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1795212125320256002,"uuid":"61924cc9-d44e-44be-a40b-4f5041e5bef9"}