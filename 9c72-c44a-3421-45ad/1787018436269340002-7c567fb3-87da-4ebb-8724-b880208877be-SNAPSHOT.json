519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3630d8e353e6f3da0425979c506d95435d04bcdc9515ed5b81447b510a50ac78","event_uuid":"f33c1e22-cdcf-4409-9d2c-1a967a8c5ce8","position":{"commit_sha":"752dbf5bc8081c7da8deac2188ed4c744320e42c","position":"1787018436269340001-f33c1e22-cdcf-4409-9d2c-1a967a8c5ce8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787018409098124001,"creation_channel":"cli","deps":[{"link_uuid":"d782d22b-c363-458f-adbd-28c73c0732b5","relation":"relates_to","target_id":"5701-5e57-2e94-4b17"},{"link_uuid":"de73492c-4df7-4a41-83e7-32d9333d1078","relation":"relates_to","target_id":"1d22-40ba-8e2b-4f67"},{"link_uuid":"f33c1e22-cdcf-4409-9d2c-1a967a8c5ce8","relation":"relates_to","target_id":"acf9-154e-ca76-4aac"}],"description":"## Purpose\nDurable register of parentless open bugs whose rebar-debug investigation reaches the not-a-bug or design-choice escalation bar. Keep unresolved decisions here so the operator can resolve them together without losing root-cause context. Each bug retains its detailed evidence and RCA on its own ticket.\n\n## Pending decisions\n- `stumpy-cinnabar-basenji` — choose the `run_in_worker` callable contract. Recommended: fork only in single-threaded hosts; spawn in multithreaded hosts; convert spawn/pickling failures to the existing fail-open result. Alternative: preserve arbitrary callable execution in multithreaded hosts, which requires a larger serialization/worker design. Background prior-art and rebar payload research is in progress.\n\n## Resolved during sweep\n- `dragonish-sylphic-sheep` — preserve Chat Completions with `openai-chat:`; future Responses migration tracked by `upbeat-illadvised-springtail`.\n- `novel-unwasteful-stonefly` — user authorized broad typed validation, including enum and non-enum coercion, for this bug.\n\n## Acceptance Criteria\n- [ ] Every unresolved not-a-bug or design-choice escalation from the sweep is listed with the exact decision required.\n- [ ] Each listed bug is linked with `relates_to` and holds its evidence on the source ticket.\n- [ ] Operator decisions move entries from Pending to Resolved with the chosen contract recorded.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[["relates_to","1d22-40ba-8e2b-4f67"],["relates_to","5701-5e57-2e94-4b17"],["relates_to","acf9-154e-ca76-4aac"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["debug-sweep","decision-register"],"ticket_id":"9c72-c44a-3421-45ad","ticket_type":"task","title":"Decision register for parentless bug debug sweep","verify_commands":[]},"source_event_uuids":["fb0a1380-d465-4346-8262-45b357a888d1","d782d22b-c363-458f-adbd-28c73c0732b5","de73492c-4df7-4a41-83e7-32d9333d1078","f33c1e22-cdcf-4409-9d2c-1a967a8c5ce8"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787018436269340002,"uuid":"7c567fb3-87da-4ebb-8724-b880208877be"}