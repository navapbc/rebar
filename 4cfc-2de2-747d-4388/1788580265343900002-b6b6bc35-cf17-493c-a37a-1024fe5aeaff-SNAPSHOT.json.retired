{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788580265343900002,"compiled_state":{"alias":"friendless-alabaster-cub","assignee":null,"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"e7e13add07244c2ac41438ea1d07861c6db4b56172736f9c5816a6feea62dcca","event_uuid":"79cab0aa-e058-4455-810d-c496744a55d6","position":{"commit_sha":"9dd8a12ffa5b4b9903bda5a2ff63dfcf3f243cf5","position":"1788571309227989965-79cab0aa-e058-4455-810d-c496744a55d6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"514bec078f8e7bb48af699de326db7596557dd08328bb60716a8a35331ec48fa","event_uuid":"05163d10-d93f-47db-8758-aa999789d773","position":{"commit_sha":"a7359da97c3706507bb39a693ce8788979851d4a","position":"1788571514950217972-05163d10-d93f-47db-8758-aa999789d773"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fdb5c30f4651440c487464e31be9e98aa507340b5a025b16e63810d4e3a3f21a","event_uuid":"d9d0ec05-a03a-493c-a36e-91393756add0","position":{"commit_sha":"e4c2aa6823e5694935b2f26f93770a2aea90d3c3","position":"1788571623491831926-d9d0ec05-a03a-493c-a36e-91393756add0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3734833fd603fc410821c9b5b63ea7596dc26f6653f3a6619c36f4c90208c133","event_uuid":"670415e8-65f5-4a33-b447-60e01597f2ae","position":{"commit_sha":"f8826a61759381a5bec31a0074d82d1388994f40","position":"178857165103403303