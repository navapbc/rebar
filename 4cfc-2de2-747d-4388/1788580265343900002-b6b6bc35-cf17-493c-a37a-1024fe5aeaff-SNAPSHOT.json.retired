tures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"db8d56f32d402865f830cd04f34ee6a9235613db0b978fc8cebcc8c9f5b4011a","event_uuid":"74c1b007-459a-44f8-a2b4-e1a3db05a124","position":{"commit_sha":"40844adbc0b155336befdf5dcca9c66beb30f606","position":"1788571784773548902-74c1b007-459a-44f8-a2b4-e1a3db05a124"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"947724cad716eeb072b96fd0a6cfd99c0e5b7563480f0a8258b95fdd44dfc64b","event_uuid":"e72929db-4254-40a4-9992-22df6e6d03da","position":{"commit_sha":"5e5d6b0648098b63fba61c4027498b15334cb0a3","position":"1788571830755636494-e72929db-4254-40a4-9992-22df6e6d03da"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"601cbc0400dc087874629eff6489c4066c10c4d34d30ed294f2f0352fdbf274a","event_uuid":"795262e9-d92f-465c-9697-20261fe11be4","position":{"commit_sha":"4a724ef54b78843615375de5485aecc0728a2edc","position":"1788571890679749217-795262e9-d92f-465c-9697-20261fe11be4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"49e952acfdc44e0acba0d71a0f2947bb2c282472e31a04dd0b06175b7789376d","event_uuid":"a3b0f417-ac5b-4b73-a453-67967c97b8cb","position":{"commit_sha":"2cefac320d3a5d54a76de5622b90f2cc024edd4a","position":"1788574247738444001-a3b0f417-ac5b-4b73-a453-67967c97b8cb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"faeb62be469ff83fb952aa6e5831c5e3e950f78cd8d5f5f1933390002611765d","event_uuid":"c377a01f-266a-4757-9c6c-0aa35d8106a0","position":{"commit_sha":"16ab69c4c8e56ed3f4f0a01b18341142de3db2b0","position":"1788575526385816001-c377a01f-266a-4757-9c6c-0aa35d8106a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"36faae7ea75a8c8cb87a232555d0459755b3a5369af41d6bd19ba0ca44403ff9","event_uuid":"df2b92a5-f4b3-4f9e-9ac2-72bf7a11072c","position":{"commit_sha":"f4af1413433a218e83851e557dd84219297b781d","position":"1788579662483522001-df2b92a5-f4b3-4f9e-9ac2-72bf7a11072c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"44abce84c6c61d39841b13b3afd4a473dd8f68550019e32059178273c7320f3e","event_uuid":"993d0cb0-56c7-4312-86f3-f4bbc66b77f4","position":{"commit_sha":"851738cece79dbbe220cf8dee61ba948a8cbe5fd","position":"1788580265343900001-993d0cb0-56c7-4312-86f3-f4bbc66b77f4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788571309227989965,"creation_channel":"mcp","deps":[{"link_uuid":"d9d0ec05-a03a-493c-a36e-91393756add0","relation":"blocks","target_id":"5888-7c53-cd64-49b5"},{"link_uuid":"670415e8-65f5-4a33-b447-60e01597f2ae","relation":"blocks","target_id":"9752-41a8-c188-4934"},{"link_uuid":"db28c7cc-5ec5-4cec-95c2-fc00744120e2","relation":"blocks","target_id":"96dd-789f-a25a-41ff"},{"link_uuid":"43a20274-da28-42c9-833b-45bf73f0ea79","relation":"blocks","target_id":"03f7-7b18-d3ce-4d77"},{"link_uuid":"d26c471c-1d8a-4c1a-8b7f-a960dbe91894","relation":"blocks","target_id":"dd6e-17c3-776e-479b"},{"link_uuid":"4a64d3c5-0337-4c45-9215-5eac5d3a0783","relation":"blocks","target_id":"fc16-8271-b85b-4b10"},{"link_uuid":"74c1b007-459a-44f8-a2b4-e1a3db05a124","relation":"blocks","target_id":"2b67-bebb-baf4-4b5f"},{"link_uuid":"e72929db-4254-40a4-9992-22df6e6d03da","relation":"blocks","target_id":"7daf-59a6-5f9a-4698"},{"link_uuid":"795262e9-d92f-465c-9697-20261fe11be4","relation":"blocks","target_id":"ed7e-2298-bee1-47d3"}],"description":"## Class\n\n`src/rebar/_store/lock.py` — **384 `AttributeError: 'NoneType' object has no attribute 'flock'` plus\n4 `ModuleNotFoundError: No module named 'fcntl'`** in job `100874330553`, roughly 74% of the 510\nfailures and the single largest class by an order of magnitude.\n\n`lock.py:72-75` guards the **import** (`try: import fcntl / except ImportError: fcntl = None`) but\nthere is no `is not None` check at either **use** site — `lock.py:207` in `_acquire_fcntl` and\n`lock.py:254` in `write_lock_is_busy`. Every store write reaches `_acquire_once` → `_acquire_fcntl`\n(`lock.py:491`), so on Windows every ticket write raises.\n\nTwo sibling modules DO gate their use sites with `if fcntl is not None:` — `_snapshot/git_fetch.py:79`\nand `_snapshot/janitor.py:430` — which makes `lock.py` an **outlier rather than a deliberate choice**.\n(`reducer/marker.py` is NOT such a sibling: it guards the import but calls `fcntl.flock` unguarded at\n:33/:37, so it shares this defect. That is tracked separately as bug `nitro-heavy-bluefish` and is\nexplicitly OUT of S1's scope — it is the per-ticket archive-marker lock, not the store write lock in\nthis story's file impact.)\n\n## THE OBVIOUS TWO-LINE FIX IS UNSAFE. DO NOT TAKE IT.\n\nSkipping the fcntl leg when `fcntl is None` looks like two lines. It silently breaks a documented,\nload-bearing invariant.\n\n`_acquire_mkdir` (`lock.py:325-362`) passes `fcntl_held=True` into stale-lock reclamation, and its\nown docstring states the precondition verbatim:\n\n> **Precondition (load bearing, hence `fcntl_held=True` below):** this is only ever reached from\n> `acquire` AFTER the exclusive `fcntl.flock(LOCK_EX)` leg on the same tracker's\n> `.ticket-write.lock` has been taken … if that owner were still alive it would still hold this\n> fcntl lock and we could not be here.\n\nDegrade to mkdir-only and `fcntl_held=True` becomes **a lie**. rebar would reclaim a write lock held\nby a **live** process: silent store corruption under concurrency, strictly worse than not supporting\nWindows at all, because the failure is invisible instead of loud.\n\n## What a correct fix requires\n\n1. **A real alternative exclusive leg** on Windows — `msvcrt.locking(fd, LK_NBLCK, n)` (or\n   `LockFileEx` via `ctypes`) — with the same *kernel-mediated, dies-with-the-process* exclusivity\n   `flock` provides. A userspace substitute that does not die with its holder does NOT satisfy the\n   precondition.\n2. **Both use sites route through the same selector**, not just `acquire`. `write_lock_is_busy`\n   (`lock.py:254`) is a SECOND unguarded `fcntl.flock` on a DIFFERENT path: an advisory,\n   zero-deadline probe that fails OPEN and never touches `fcntl_held`. Fixing only `acquire` leaves\n   it raising `AttributeError` on Windows (reached from the compact-on-close stand-aside), so it is\n   in scope and gets its own AC and test.\n3. **A reworked staleness proof.** The current proof leans on `flock` being kernel-mediated on the\n   inode. The Windows leg's proof must be stated explicitly in the docstring and be its own\n   argument. If the Windows leg cannot support `fcntl_held=True`, reclamation must be narrowed on\n   Windows rather than the flag falsified. Note `lock_owner._pid_alive` uses `os.kill(pid, 0)`,\n   which on Windows is documented to **TerminateProcess** the target rather than probe it — so the\n   liveness probe must be narrowed on Windows too, or reclamation would kill a live holder.\n4. **A test that fails if the invariant is degraded** — the epic's AC5 and `f850`'s AC5, carried\n   forward unchanged.\n5. **The Windows primitive's capability must be VERIFIED, not asserted.** The whole design rests on\n   two properties of `msvcrt.locking`: the lock is visible ACROSS PROCESSES, and the kernel releases\n   it when the holding process dies. A POSIX-host simulation exercises rebar's Windows *branch* but\n   cannot confirm those properties. They are therefore proved by a `windows-latest`-only test\n   (`os.name == \"nt\"`, skipped elsewhere) that runs in the epic's `sweep (windows)` job: a child\n   process takes the leg and the parent must be refused; the child is then killed and the parent\n   must succeed. If that test fails, the design is wrong and the story reopens.\n\n## This story GATES the rest of the epic\n\nUntil store writes work on Windows the other classes cannot be measured — their tests fail during\nstore setup before reaching the semantics under test. The bug's \".EXE console-script invocation\"\nclass is downstream of S1: those `CalledProcessError`s carry this `flock` `AttributeError` as\nstderr. `S1 blocks` every other child of the epic.\n\n## Acceptance Criteria\n\n- [ ] `fcntl` is never dereferenced when it is `None`, in `_acquire_fcntl` AND in\n      `write_lock_is_busy`; a Windows run reaches the same exclusivity guarantee by a different\n      documented mechanism. Checked by `pytest tests/unit/store/test_windows_exclusive_leg.py -q`,\n      which drives the real `acquire()` and the real `write_lock_is_busy()` with the `fcntl`\n      primitive stubbed absent and a Windows-shaped primitive supplied.\n- [ ] `_acquire_mkdir`'s `fcntl_held=True` is still true under the Windows leg with its own proof\n      written out in the docstring, or is not passed and reclamation is narrowed; and\n      `lock_owner._pid_alive` never calls `os.kill` on a platform where that terminates the target.\n      Checked by `pytest tests/unit/store/test_windows_exclusive_leg.py -k \"precondition or pid\" -q`.\n- [ ] A test fails if the exclusivity precondition is degraded: with NO exclusive leg available,\n      `acquire()` raises and never creates `.ticket-write.lock.d`. Checked by\n      `pytest tests/unit/store/test_windows_exclusive_leg.py -k no_leg -q`.\n- [ ] The Windows primitive's cross-process exclusivity and release-on-process-death are proved\n      empirically on `windows-latest`, not asserted. Checked by\n      `pytest tests/unit/store/test_windows_exclusive_leg.py -k native -q` on `windows-latest`\n      (self-skipping on POSIX), which is executed by the epic's `sweep (windows)` job.\n- [ ] POSIX behaviour is unchanged. Checked by\n      `pytest tests/integration/test_concurrency_regression.py tests/integration/test_store_concurrency.py tests/interfaces/store/test_reads_under_sync_contention.py -q`\n      plus `make lint` and `make typecheck`.\n- [ ] No unguarded `fcntl` dereference remains on the store write-lock path, so the sweep's\n      `flock` `AttributeError` count is 0 by construction. Checked IN-SESSION by\n      `grep -nE '(^|[^_[:alnum:]])fcntl\\.' src/rebar/_store/lock.py src/rebar/_store/lock_owner.py`\n      returning NO matches (every surviving `fcntl` call lives in the leg selector behind its\n      `is not None` guard). Confirmed post-merge on the epic's artifact:\n      `gh run view <id> --log --job \"sweep (windows)\" | grep -cE \"NoneType.*flock|named 'fcntl'\"`\n      must print `0`.\n\n## Testing\n\n1. RED first: `pytest tests/unit/store/test_windows_exclusive_leg.py -q` must fail before the fix\n   (the `fcntl`-absent path raises `AttributeError`/`NoneType`).\n2. Platform-seam simulation on the POSIX dev host: the exclusive-leg selector is driven with the\n   `fcntl` primitive stubbed absent and a Windows-shaped primitive supplied, so the Windows branch\n   of the real `acquire()` / `write_lock_is_busy()` runs here rather than being asserted about.\n3. Native capability proof on `windows-latest` (item 5 above) — the only place the real primitive's\n   cross-process and release-on-death properties are established.\n4. Mutation check: deleting the no-leg guard, or negating the leg-selection branch, must turn at\n   least one test RED.\n5. POSIX no-regression: the three concurrency suites named in the Acceptance Criteria, run before\n   and after the change, plus `make lint` and `make typecheck`.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_store/lock.py","reason":"guards the fcntl import at :72-75 but not its use at :207 (_acquire_fcntl) and :254 (write_lock_is_busy); every store write reaches _acquire_once -> _acquire_fcntl at :491, so 384 of 510 Windows failures are 'NoneType' object has no attribute 'flock'. Needs a real Windows exclusive leg (msvcrt.locking / LockFileEx), not an fcntl-is-None skip"},{"path":"src/rebar/_store/lock_owner.py","reason":"_mkdir_lock_is_stale/_reclaim_mkdir_lock consume the fcntl_held=True flag _acquire_mkdir passes at lock.py:325-362; the staleness proof rests on flock being kernel-mediated and dying with its holder, so a Windows leg needs its own written proof here or a narrowed reclamation path"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["blocks","03f7-7b18-d3ce-4d77"],["blocks","2b67-bebb-baf4-4b5f"],["blocks","5888-7c53-cd64-49b5"],["blocks","7daf-59a6-5f9a-4698"],["blocks","96dd-789f-a25a-41ff"],["blocks","9752-41a8-c188-4934"],["blocks","dd6e-17c3-776e-479b"],["blocks","ed7e-2298-bee1-47d3"],["blocks","fc16-8271-b85b-4b10"],["parent","55da-cee1-e556-4735"]],"no_file_impact_reason":"","parent_id":"55da-cee1-e556-4735","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["windows","portability","store","locking","blocking"],"ticket_id":"4cfc-2de2-747d-4388","ticket_type":"story","title":"S1: give _store/lock.py a real Windows exclusive-lock leg and rework the staleness proof it carries","verify_commands":[]},"source_event_uuids":["79cab0aa-e058-4455-810d-c496744a55d6","05163d10-d93f-47db-8758-aa999789d773","d9d0ec05-a03a-493c-a36e-91393756add0","670415e8-65f5-4a33-b447-60e01597f2ae","db28c7cc-5ec5-4cec-95c2-fc00744120e2","43a20274-da28-42c9-833b-45bf73f0ea79","d26c471c-1d8a-4c1a-8b7f-a960dbe91894","4a64d3c5-0337-4c45-9215-5eac5d3a0783","74c1b007-459a-44f8-a2b4-e1a3db05a124","e72929db-4254-40a4-9992-22df6e6d03da","795262e9-d92f-465c-9697-20261fe11be4","a3b0f417-ac5b-4b73-a453-67967c97b8cb","c377a01f-266a-4757-9c6c-0aa35d8106a0","df2b92a5-f4b3-4f9e-9ac2-72bf7a11072c","993d0cb0-56c7-4312-86f3-f4bbc66b77f4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788580265343900002,"uuid":"b6b6bc35-cf17-493c-a37a-1024fe5aeaff"}