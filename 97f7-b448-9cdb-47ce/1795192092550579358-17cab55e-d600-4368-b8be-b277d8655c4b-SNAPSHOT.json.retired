{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795192092550579358,"compiled_state":{"alias":"promising-unwasteful-xantus","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"717c50f8b33c7784f4409bbe05a7e01b41235746","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 97f7-b448-9cdb-47ce","material: d6d0e8744e3025d7","material-part: children 647ea2107ca5072f 0","material-part: description 60e4c8113974d3cb 7358","material-part: description_boxes 38efaf2b16858416 0","material-part: file_impact bb2a9751050fa80b 8","material-part: ticket_id 22744ce8001f3a34 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 8","review-phase: planning","rebar-version: 0.16.0 (717c50f8b33)","regver: aa61189569d34126","verified-at-sha:717c50f8b33c7784f4409bbe05a7e01b41235746","dep a07d493d23608376551a42f733572696bb09385e3430ec867f74c44b8e149634 docs/env-vars.md","dep a374ffe31d550d8c1c963581534cf222ca7e9a497e1116428a5889da9299a3ef infra/compose/docker-compose.yml","dep ddbac74a0f4e66e983b4012699b37a7ab266396382d27bffc21f0c80ed11769f infra/runbooks/mcp-opcert-enforcement-flip.md","dep f5a6644856e68699ce942ea6d4246daab8b9683ece07c93ac5b6c9cabfe021ea infra/scripts/autodeploy.sh","dep 2ceeb2447a50f5be6a912fa21ef2c48d9114d4d1443803245fcd3a7dc8343f8d src/rebar/mcp_server.py","dep d5ab77df7c25ee1a31c6155f469d8042396515e3dbfebc113fbf57b21a481ae0 tests/scripts/test_autodeploy_mcp_bluegreen.py","dep 9c2a90021d1327841743580633e98d83ce6648cac48dc060efcbc0ad4af633a6 tests/unit/test_mcp_opcert_signing_goose.py","dep 38ad11c9831886ec191