\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fbf0e55c66f3285ef15332966417606dd3a5d1f4b441d3cfdf64a71719c2e0dd","event_uuid":"305a3f1e-392f-4bbd-a08d-2c50d25b40b0","position":{"commit_sha":"e8c938ef266d70f356cde284b22c175a23d7d1b1","position":"1787337391584023001-305a3f1e-392f-4bbd-a08d-2c50d25b40b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"296eac878b4a83b1855c120008f55ba0718c4ae57d50017f4f1b35b28aad5d70","event_uuid":"cefeac84-a3c5-45e5-b1b0-4c355e4c7a6a","position":{"commit_sha":"ed1bfec738acfeeb9b91c770b1db16723c1ba263","position":"1787337886084924001-cefeac84-a3c5-45e5-b1b0-4c355e4c7a6a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"40a403999783165fdd6461d20d781b433ff268e00f0f073363ac62008d9ea499","event_uuid":"38c29e0e-9aa9-4816-87f2-a3b4ea03c2f5","position":{"commit_sha":"30af16f0705d263a5a7a71160559adb251c0d6c8","position":"1787337905868243001-38c29e0e-9aa9-4816-87f2-a3b4ea03c2f5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"17530aa6bcd72cbf05fc3c32175b37f75c104ec8648296f1335f6f645f80ad57","event_uuid":"a3355974-c3ac-4e39-a694-62531ff06e86","position":{"commit_sha":"d1cd918df57481ab76605defc2bac28cea5c36af","position":"1787338206256723001-a3355974-c3ac-4e39-a694-62531ff06e86"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b97d6e8111ff14bbc8573fa683d92a1d0f09387ba56140e39cad92a75fa403a9","event_uuid":"c19e6bfe-b526-4c4f-b2a6-41ec89db352d","position":{"commit_sha":"ab6f01020981c7d0955d9f5f194b2d6b35d49ac5","position":"1787338945074343001-c19e6bfe-b526-4c4f-b2a6-41ec89db352d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"befd00908c772fc8937a26eec7007e31c96a2c7b84650dbf20d14c5991f76201","event_uuid":"1d7d9cb9-fd35-4f06-a5a3-14a27dc9cb2f","position":{"commit_sha":"ab6f01020981c7d0955d9f5f194b2d6b35d49ac5","position":"1787338946412271001-1d7d9cb9-fd35-4f06-a5a3-14a27dc9cb2f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"First plan review returned BLOCK because the plan did not name the separate test_contributing_points_at_the_generated_artifacts_table assertion that pins the old anchor. The revised plan names that test, requires the new docs/generated-artifacts.md pointer, and splits the bundled acceptance criteria into independently verifiable outcomes. No project file has changed.","timestamp":1787337391584023001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Second plan review returned BLOCK because test_readme_rows_name_the_regenerate_command reads the moved table directly and is not a caller of _readme_rows. The plan now inventories every table consumer, renames the README-specific helper and tests, updates the module documentation, and assigns the lossless relocation in the parent epic. F05 mechanical generation remains deferred. No project file has changed.","timestamp":1787337905868243001}],"created_at":1787336330162225001,"creation_channel":"cli","deps":[{"link_uuid":"4acb9437-c066-476d-96ab-2addb025b7b4","relation":"blocks","target_id":"513d-67cd-5329-4220"}],"description":"## Context\n\nThe project has audience guidance distributed across AGENTS.md, CONTRIBUTING.md, docs/README.md, and individual documents. It lacks one current-state policy that distinguishes durable records, maintained documentation, shipped help, comments, generated artifacts, and protected evidence. The audit ticket minimum-rainy-fawn approved F01 and rejected broad prose cleanup and general prose validation. The parent epic washedup-cattish-mealworm assigns the lossless catalog relocation to F01 so F06 can remain a one-file navigation rewrite.\n\n## Current enforcement and history\n\nTicket forworn-zanyish-narwhale added generated markers, two contributor tables in docs/README.md, and tests/unit/test_generated_surface_markers.py after repeated changes edited derived outputs instead of their sources. The test owns the GENERATED and GATED_HAND_AUTHORED collections. It has three table consumers. _readme_rows supports test_readme_table_matches_registry and test_readme_lists_the_hand_authored_gated_surfaces. test_readme_rows_name_the_regenerate_command reads docs/README.md directly. test_contributing_points_at_the_generated_artifacts_table asserts the old docs/README.md anchor. The module text and section comments also name docs/README.md as the inventory. This change preserves both collections, every catalog row, and all marker checks.\n\n## Plan\n\nAdd docs/documentation-policy.md as the current policy for tickets, ADRs, internal documentation, external documentation, shipped help, comments, generated artifacts, and protected evidence. Define the audience, purpose, lifecycle, canonical source, use of citations, correction method, exclusions, and examples for each category. Copy the approved punctuation, paragraph-shape, diction, and formal-voice rules from the Audit standards section of minimum-rainy-fawn. State that ticket events remain append-only. State that ADR decision substance is preserved through annotations, errata, supersession, or replacement ADRs.\n\nAdd docs/generated-artifacts.md as the contributor inventory. Move the existing generated and parity-gated tables from docs/README.md without changing their rows. Rename _readme_rows to _catalog_rows. Repoint test_readme_table_matches_registry, test_readme_lists_the_hand_authored_gated_surfaces, and test_readme_rows_name_the_regenerate_command to docs/generated-artifacts.md. Rename those tests so their names describe the catalog. Update the module text and section comments so they name docs/generated-artifacts.md. Update test_contributing_points_at_the_generated_artifacts_table so it requires the docs/generated-artifacts.md pointer instead of docs/README.md#generated-artifacts. Rename that test to describe the catalog pointer. Preserve the GENERATED and GATED_HAND_AUTHORED values. Replace the old CONTRIBUTING.md anchor. Add concise policy pointers in AGENTS.md, CONTRIBUTING.md, and docs/README.md.\n\n## Exclusions\n\n- No edits to generated outputs, ADR decision substance, ticket events, historical evidence, protected evidence, or commit history.\n- No repository-wide prose rewrite.\n- No prose or comment validator.\n- No F05 ownership descriptor, generated catalog generator, or new ADR.\n\n## Acceptance Criteria\n\n- [ ] The policy role table covers exactly eight roles listed in the Plan.\n- [ ] Every policy role entry provides all fields listed in the Plan.\n- [ ] The policy states every approved punctuation rule from minimum-rainy-fawn.\n- [ ] The policy states the approved paragraph-shape rule from minimum-rainy-fawn.\n- [ ] The policy states every approved diction rule from minimum-rainy-fawn.\n- [ ] The policy requires a formal voice for new or edited maintained text.\n- [ ] The policy requires ticket corrections through new append-only events.\n- [ ] The policy requires ADR corrections through annotations, errata, supersession, or replacement ADRs without erasing decision substance.\n- [ ] docs/generated-artifacts.md contains the same generated table rows that docs/README.md contained before this change.\n- [ ] docs/generated-artifacts.md contains the same parity-gated table rows that docs/README.md contained before this change.\n- [ ] The GENERATED value in tests/unit/test_generated_surface_markers.py is unchanged.\n- [ ] The GATED_HAND_AUTHORED value in tests/unit/test_generated_surface_markers.py is unchanged.\n- [ ] Every inventory consumer in tests/unit/test_generated_surface_markers.py reads docs/generated-artifacts.md.\n- [ ] No inventory documentation in tests/unit/test_generated_surface_markers.py identifies docs/README.md as the catalog.\n- [ ] The CONTRIBUTING pointer test requires docs/generated-artifacts.md.\n- [ ] AGENTS.md links to docs/documentation-policy.md.\n- [ ] CONTRIBUTING.md links to docs/documentation-policy.md.\n- [ ] docs/README.md links to documentation-policy.md.\n- [ ] CONTRIBUTING.md links to docs/generated-artifacts.md.\n- [ ] No maintained file references docs/README.md#generated-artifacts after the move.\n- [ ] The targeted marker test passes.\n- [ ] make lint passes.\n- [ ] make typecheck passes.\n- [ ] The project test gate passes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/documentation-policy.md","reason":"Add the documentation ownership and writing policy."},{"path":"docs/generated-artifacts.md","reason":"Relocate the existing generated and parity-gated inventories."},{"path":"docs/README.md","reason":"Replace embedded policy and inventory content with navigation pointers."},{"path":"CONTRIBUTING.md","reason":"Point contributors to the policy and relocated generated-artifact inventory."},{"path":"AGENTS.md","reason":"Add one concise pointer to the canonical documentation policy."},{"path":"tests/unit/test_generated_surface_markers.py","reason":"Read the relocated inventory while preserving the existing registries and marker checks."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["blocks","513d-67cd-5329-4220"],["parent","b4ec-b899-bb50-4970"]],"no_file_impact_reason":"","parent_id":"b4ec-b899-bb50-4970","parent_status_uuid":"c19e6bfe-b526-4c4f-b2a6-41ec89db352d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["documentation","policy"],"ticket_id":"fe47-c480-3036-45fe","ticket_type":"story","title":"F01 Define documentation ownership policy","verify_commands":[]},"source_event_uuids":["aa3e5623-cb3e-42c9-a698-69e841e03da1","caccaeb1-6f04-4230-93ac-70ca23131694","4acb9437-c066-476d-96ab-2addb025b7b4","d2ea3909-bfc9-4ae2-a158-7602dbf0b673","305a3f1e-392f-4bbd-a08d-2c50d25b40b0","cefeac84-a3c5-45e5-b1b0-4c355e4c7a6a","38c29e0e-9aa9-4816-87f2-a3b4ea03c2f5","a3355974-c3ac-4e39-a694-62531ff06e86","c19e6bfe-b526-4c4f-b2a6-41ec89db352d","1d7d9cb9-fd35-4f06-a5a3-14a27dc9cb2f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787341658728970001,"uuid":"17089a6c-96ae-4dc5-917c-377edd3df65c"}