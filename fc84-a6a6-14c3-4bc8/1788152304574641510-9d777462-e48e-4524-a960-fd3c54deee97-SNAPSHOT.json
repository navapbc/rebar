dType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"af5d62ba4b7ddca284d69001bf3adba17fdabcd0dce318f898d92481a66bca57","event_uuid":"e87c2ded-9881-4550-9e19-07e627afe836","position":{"commit_sha":"ae0a8aec0a6b17bee2f209fedaac9b73dadb605d","position":"1788145867053194040-e87c2ded-9881-4550-9e19-07e627afe836"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8c03256bc09b1e6af781b8a3ecbd74a1fed36eedb2298541abde34948ca88f82","event_uuid":"5739eaff-4cd9-4bdf-b9b5-42892fc5e8f3","position":{"commit_sha":"7090975e3fbd90a00a0b7ab624f3fc72c6ed8877","position":"1788146252326250001-5739eaff-4cd9-4bdf-b9b5-42892fc5e8f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"29a0d537e416e1a6240b7446d5d4dd6d6be7d7528eafbab06751891efc03e9a7","event_uuid":"036de233-264d-411e-b188-60d03a6e7b98","position":{"commit_sha":"2e6553b79f60fb4a742a572083d45a6626ae4b72","position":"1788146546921627001-036de233-264d-411e-b188-60d03a6e7b98"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e4112c680e0eafdb6607ab1648d0d249d0fe0a046c328081202173bfe46229e9","event_uuid":"ed8b76c7-cf51-471b-9044-7422812b3790","position":{"commit_sha":"f18247b629a3bf31c10607f891422c5d6989a59f","position":"1788146556042507001-ed8b76c7-cf51-471b-9044-7422812b3790"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788112416761629942,"creation_channel":"mcp","deps":[{"link_uuid":"2e9fdfe3-fa4a-40fb-9125-9dd50ea6cb30","relation":"depends_on","target_id":"96f9-e324-c22f-49a2"},{"link_uuid":"8f2a6b14-c51b-4acc-9042-b1eeb54bdd21","relation":"relates_to","target_id":"d581-5fb4-b8fb-45dd"},{"link_uuid":"5d813566-f97b-4e9f-b8fc-f98eacdf93d4","relation":"relates_to","target_id":"a7c7-4c3e-086f-43c8"}],"description":"## Problem\n`workflow/steps.py::GATE_POLICIES` (`default`/`strict`/`advisory`) fails a workflow step by\nexact string membership of `finding[\"severity\"]` in a fixed list. Research confirmed this\n`gate` step is NOT wired into any of the three real production gate workflows (plan-review,\ncode-review, completion-verification each use their own bespoke `_decide`/`_reconcile` ops\ninstead) -- `steps.gate` is exercised only by a retained sample workflow\n(`workflow/examples/review_skeleton.yaml`) and a schema-round-trip test fixture\n(`tests/e2e/fixtures/roundtrip-demo.yaml`), both of which feed it plain, severity-only\nfindings (a generic finder+verify pass, not `pass3_decide` output) with no `priority`/\n`decision` field at all. Migrating `fail_on_severity` to a priority-only check would silently\nmake the demo/fixture gate never fail (every finding would default to `priority: 0.0`), losing\nits illustrative value with no live behavior actually fixed (nothing real depends on this\ngate's severity check today).\n\n## Approach\nADD priority-threshold support to `GATE_POLICIES` ALONGSIDE the existing `fail_on_severity`\n(expand, not a replacement) so the gate step works correctly for both today's severity-only\ninputs (the demo/fixture) and any future caller that supplies `pass3_decide`-shaped findings\ncarrying `priority`: each policy gains a `priority_threshold: float | None` key\n(`None` = never fails on priority, matching `advisory`'s empty `fail_on_severity: []`).\nConcrete values: `default: 0.95` (`review_kernel.decide.DEFAULT_BLOCK_THRESHOLD` -- the same\nsource of truth `pass3_decide` uses for its own BLOCK decision, imported not duplicated as a\nliteral); `strict: 0.5` (a concrete, lower-than-default value -- `strict` is meant to catch\nmore than `default`); `advisory: None` (never fails on priority, matching its existing empty\n`fail_on_severity: []`). The `gate` step (`steps.py:215-239`) fails a finding if EITHER its\n`severity` is in the policy's `fail_on_severity` list (unchanged behavior) OR its `priority`\n(when present and numeric) is `>= priority_threshold`.\n\n## Acceptance Criteria\n- [x] Each policy in `GATE_POLICIES` gains a `priority_threshold` key: `default: 0.95` (import\n  of `review_kernel.decide.DEFAULT_BLOCK_THRESHOLD`, not a duplicated literal), `strict: 0.5`,\n  `advisory: None`. `fail_on_severity` is NOT removed from any policy.\n- [x] `pytest tests/unit/workflow/test_steps.py` passes unchanged for every existing\n  severity-only test case (`test_gate_fails_on_high_severity`,\n  `test_gate_strict_fails_on_any_finding`, `test_gate_advisory_never_fails`,\n  `test_gate_unknown_policy_falls_back_to_default`) -- proving this is additive, not a\n  behavior change for findings that only carry `severity`.\n- [x] A new test proves the additive priority path using the `default` policy at two priority\n  values (NOT `strict`, whose `max_findings: 0` already fails any non-empty finding set\n  regardless of priority and so cannot isolate the priority-threshold effect): a finding with\n  no `severity` key and `priority: 0.99` fails `default`; the same shape with `priority: 0.5`\n  does not.\n- [x] A new test confirms `strict` still fails on a priority-only finding purely via its\n  existing `max_findings: 0` clause (a consistency check that the additive `priority_threshold`\n  field does not interfere with `strict`'s pre-existing behavior).\n- [x] `pytest tests/unit/workflow/test_review_skeleton.py` passes unchanged (the demo workflow\n  that actually exercises `steps.gate` end-to-end keeps working exactly as before, since its\n  severity-only findings never trigger the new priority path).\n\n## Testing\nTier: in-process unit test against the real `gate` workflow step function. Oracle: the\nstep's returned pass/fail verdict for a finding carrying `severity` only, `priority` only, or\nneither, under each named policy. Contrast case (test-design.md sec.6, config-effect): run a\nseverity-less, priority-only finding through `default` at `priority=0.99` (fails, `>=0.95`)\nand at `priority=0.5` (passes, `<0.95`) -- the two outcomes differing proves the `priority_threshold`\nread path is real, not merely parsed. Regression check: the existing severity-only test suite\nand the `review_skeleton.yaml` end-to-end test both stay green, proving additive-not-breaking.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/workflow/steps.py","reason":"add priority_threshold alongside fail_on_severity in GATE_POLICIES and the gate step"},{"path":"tests/unit/workflow/test_steps.py","reason":"add priority-path tests, confirm severity-only tests unchanged"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","96f9-e324-c22f-49a2"],["parent","c4c8-317a-85ca-4b08"],["relates_to","a7c7-4c3e-086f-43c8"],["relates_to","d581-5fb4-b8fb-45dd"]],"no_file_impact_reason":"","parent_id":"c4c8-317a-85ca-4b08","parent_status_uuid":"036de233-264d-411e-b188-60d03a6e7b98","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"closed","tags":[],"ticket_id":"fc84-a6a6-14c3-4bc8","ticket_type":"task","title":"Migrate fail_on_severity workflow gate to a priority threshold","verify_commands":[]},"source_event_uuids":["d11e8663-b770-4546-ada6-f6e251fd491e","a3ee9bb8-ab02-4228-9d17-7f0dac7a4a1b","6433d7ea-e818-409e-ac6b-674557dd4805","bd20830f-6748-43dc-a4f0-8c6389e639f9","9c53f9b9-fc2a-43ea-b134-995e42e6dbed","181dc31a-b21b-4d17-861f-1ec357e89d1c","558b2f4c-d2c0-4f53-80c9-280d1c9297e8","8f2a6b14-c51b-4acc-9042-b1eeb54bdd21","5d813566-f97b-4e9f-b8fc-f98eacdf93d4","1a39cf4a-ea9c-4861-b88d-2c83b41fc3d6","e87c2ded-9881-4550-9e19-07e627afe836","5739eaff-4cd9-4bdf-b9b5-42892fc5e8f3","036de233-264d-411e-b188-60d03a6e7b98","ed8b76c7-cf51-471b-9044-7422812b3790"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1788152304574641510,"uuid":"9d777462-e48e-4524-a960-fd3c54deee97"}