{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788994496445775001,"compiled_state":{"alias":"enrapt-capitalist-jackrabbit","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"1fd67de980a12d3969e2e1549992c2bb0d8f64c7","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 073f-b86f-42c6-456f","material: 60127ea3a925ea0e","material-part: children 647ea2107ca5072f 0","material-part: description 1f789cded6eea7b7 4563","material-part: description_boxes 38efaf2b16858416 0","material-part: file_impact 764dc80cf14faf71 6","material-part: ticket_id ad2ce9d56ec4bbaf 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1 (1fd67de980a12)","regver: aa61189569d34126","verified-at-sha:6f334a067513f2d3543ff5f81dcabe812ebc4f75","dep 4560da265d2d1cf3aafd56187d60d0af75c638bb6efaee8ffab186f3284b96f9 infra/runbooks/review-bot-ops.md","dep 7e2373411cd8132bb07ccded3493450ff8ddc8e98a1b43ce613121a343d266bb infra/scripts/observability.sh","dep f4dac4c8271e801735c79f17b7e35ce1d7ddb9d75989768e46097d4961dde3f6 infra/terraform/monitoring_autodeploy.tf","dep 4aa9d58c5396b5f7d56717452cd6ac6c22d342d768f177ecad691be1a5b37311 src/rebar/review_bot/app.py","dep 5245fd7bae6fb35b206f26213c8c04d0b6433482032dcf0d6623f91bfab68681 tests/scripts/test_observability_timeout_9313.py","dep 913e480545ec70f9af59f2d3261014c654466f9b15a0fd71ed7523cedb5bf64c tests/unit/test_review_bot.py","read-set: 11","read-path: docs/adr/0014-inbound-webhook-auth.md","read-path: docs/gerrit-a