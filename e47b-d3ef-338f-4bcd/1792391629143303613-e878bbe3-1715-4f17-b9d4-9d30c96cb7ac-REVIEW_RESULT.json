n never pass even when the moved research corpus is correctly absent.","group_criteria":null,"group_id":null,"id":"f7d1e9e64c0f7441e","impact":1.0,"is_primary":null,"location":"Acceptance Criteria, criterion 2 (corpus-move packaging check)","norm_id":"n84f54604d17d793a","priority":0.8,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer moves the corpus, runs python -m build, runs the two grep -c commands, and both print a non-zero count because the shipped src/rebar/llm/evals/ package matches"],"severity":null,"suggested_fix":"Replace the grep targets with the corpus marker that is unique to the research tree rather than the generic 'evals/' substring — e.g. `grep -c 'plan-review-gate/'` over both artefacts (expect 0), since 'plan-review-gate' does not appear in the src/rebar/llm/evals package. Alternatively anchor to the archive's top-level directory entry so src/rebar/llm/evals/ cannot match.","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"broken_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Reconcile th