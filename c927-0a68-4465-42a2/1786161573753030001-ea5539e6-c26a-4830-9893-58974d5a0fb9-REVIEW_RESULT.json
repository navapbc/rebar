` as the sole bridge MCP surface, but the MCP layer is split into `_mcp_reads.py` (tools annotated `_ANN[\"READ_ONLY\"]`) and `_mcp_writes.py` (`register_write_tools`, mutating tools). The `projects` verb group includes write verbs (`set`, `remove`); registering them in `_mcp_reads.py` mis-annotates mutations as read-only and leaves `_mcp_writes.py` — the actual home for mutating MCP tools — unenumerated in Scope.","group_criteria":null,"group_id":null,"id":"fe2da8e30a21fcd2f","impact":0.0,"is_primary":null,"location":"Approach (\"the bridge MCP surface is src/rebar/_mcp_reads.py\") and Scope (`src/rebar/_mcp_reads.py`)","norm_id":"nfd93df0b6f5dacd6","priority":0.0,"reason":"veto:cited-reference-inaccurate","scenarios":[],"severity":"none","suggested_fix":"Split the MCP surface in Approach/Scope: `list` -> _mcp_reads.py (read-only), `set`/`remove` -> _mcp_writes.py (register_write_tools), mirroring the existing reads/writes MCP division.","tier":"LLM","validity":0.1667,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"no","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"na","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["G6"],"decision":"dropped","drop_reason":null,"evidence":[],"finding":"Th