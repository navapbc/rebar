ary":null,"location":"Approach section","norm_id":"nc285fe19669d0c97","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["A future maintainer needs to understand why plan review compiles to DiscoveryStagePlan units and how the checkpoint key is composed, but finds no recorded decision"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.5714,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify the RETIRE/cleanup path for the review journal and superseded checkpoint envelopes (e.g. pruning on namespace-version bump or a bounded retention policy) so ignored/stale entries do not accumulate indefinitely.","cohort":["E3","E5","F4","G5","T12","T6","T9","necessity","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":-0.95,"drop_reason":null,"evidence":["Plan quote: 'Legacy checkpoints are ignored rather than translated; failed, cancelled, skipped, and budget-shed work remains missing.'","ABSENCE: no statement of how obsolete/legacy/key-mismatched envelopes or journal bytes are retired, garbage-collected, or bounded in size — only that they are ignored on read.","T9 checklist: 'There is a RETIRE/cleanup path — it doesn't leak/accumulate.'"],"finding":"The plan defines create/consume/staleness for the review journal and checkpoint envelopes but does not specify a RETIRE/cleanup path — legacy entries are 'ignored rather than translated' (consume-side tolerance), and key-mismatch entries are never reused, yet neither the journal bytes nor superseded checkpoint envelopes are ever pruned, so the store accumulates indefinitely across reruns and namespace-version bumps.","group_criteria":null,"group_id":null,"id":"f3ead847ab5f2a573","impact":0.0,"is_primary":null,"location":"Approach para 2 — 'persists the versioned safe discovery trace and new digest-complete success-only checkpoint envelopes in its reducer-ignored review journal. ... Legacy checkpoints are ignored rather than translated'","norm_id":"n3ef5529d06e6edba","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["Long-running gate re-runs many times as plan material, prompts, or namespace version change: each run writes fresh keyed envelopes while stale ones are never removed, so the journal grows without bound."],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","i