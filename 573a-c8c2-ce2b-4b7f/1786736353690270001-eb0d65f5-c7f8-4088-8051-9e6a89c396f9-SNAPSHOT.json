79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cd232cb7205ccf04a2680ab76e64c2353c7897a24f404a6045b27f9f08c400c1","event_uuid":"53f71bdf-714b-4aa6-892d-4e6b70141c5e","position":{"commit_sha":"2b88a5a5fdc1d3cc9cd3b7d11a54f2619c6cbc29","position":"1786733778483425001-53f71bdf-714b-4aa6-892d-4e6b70141c5e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c2086a711e0849a07591904197046799e453b4f0d35b8eeeb55f1fb3d629b6a0","event_uuid":"1c2c8c7c-a7e6-407e-9ab0-0f291e758557","position":{"commit_sha":"f866379e176ff4305cf9748ad04826150d095fda","position":"1786733782128010001-1c2c8c7c-a7e6-407e-9ab0-0f291e758557"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation pushed for review: Gerrit change 1772 (https://rebar.solutions.navateam.com/c/rebar/+/1772), commit a520ba68d52.\n\nScope as certified: src/rebar/_store/push_recovery.py (+ a pure extraction in _store/sync.py) and new tests/unit/test_push_recovery_untracked.py. _recover_dirty_merge now runs _retry_untracked_overwrite between the failed post-stash merge and the abort net: parse abort-named paths with the shared sync parser (_untracked_overwrite_paths, pure), quarantine-move the named UNTRACKED paths, retry ONCE; anything else keeps today's behavior byte-for-byte. Stash ordering preserved — quarantine+retry sit between the failed merge and _restore_stash, and the stash commit is restored exactly once on every exit path (pinned by call-count tests).\n\nReuse boundary implemented as planned: the parser is imported from sync; the quarantine PATH arithmetic was extracted into a new pure sync._quarantine_dir_under(common, tracker) (sync._quarantine_dir now delegates to it) so push_recovery shares the dir shape (<git-common-dir>/reconverge-quarantine/<utc-ts>/) while its MOVER (_quarantine_untracked_paths) runs every git call through the late-bound core._git seam — sync's mover is never called across the seam, so the ~25 push._git monkeypatch sites keep working. The mover fences ALL named paths on git status --porcelain -uall '??' before moving anything (a mis-parse must never relocate tracked data) and refuses on an unresolvable common dir or a vanished path.\n\nDiscovery — _merge_remote_under_lock sibling seam needs NO code change: _DIRTY_WD (push_classify) matches 'would be overwritten by merge', so the untracked abort already routes into _recover_dirty_merge (stash create returns '' on a tree whose only change is untracked); a routing test (test_merge_remote_under_lock_routes_untracked_collision_to_recovery) pins that end-to-end.\n\nTDD: RED proof against pre-fix HEAD — the wedge test fails with _recover_dirty_merge returning False (merge aborted, origin not merged); 5 of 6 initial tests RED, the genuine-conflict guard green by design. GREEN: 8/8. Mutation pass: 13 mutants (never retry, invert detection, skip abort-before-move, skip move, invert '??' fence, ignore common-dir failure, DELETE instead of move, retry twice, drop/double stash restore, skip exists-check) — 11 killed by the fixture tests, 2 initial survivors (empty common dir ignored; exists-check skipped) killed by added fake-git degenerate-branch tests. All 13 killed.\n\nValidation: make lint clean, make typecheck clean (539 files), complexity ratchet active=53 new=0 increased=0, push_recovery.py 437 LOC / sync.py 406 LOC (cap 800). Full unit suite: 10272 passed; the 9 fails + 9 errors are the identical environmental set already reproduced on CLEAN HEAD during the wolverine session (ref_lock roundtrip, dirty_tracker delivery, sync_remote_config e2e pushes, bridge_provider matrix, push_pending_marker hooksPath) — none introduced. Awaiting LLM-Review +1 / Verified +1; ticket close deferred to the parent session per policy.","timestamp":1786695850775446001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"[operator-attested] Work landed: Gerrit change 1772 MERGED as 9a7a1cad4a (LLM-Review +1, Verified +1). Evidence per AC: (1) untracked-overwrite abort recovery — quarantine named paths + single retry, RED-to-GREEN in tests/unit/test_push_recovery_untracked.py; (2) stash restored on all exit paths (stash-safety tests); (3) genuine conflicts/unnamed paths unchanged (guard tests); (4) reuses shared sync parser/quarantine helpers (diff review — no duplicated mechanism); (5) lint+typecheck clean, landed via Gerrit gates. file_impact extended to include src/rebar/_store/sync.py (wiring), matching the merged commit's 3-file diff.","timestamp":1786732810999311001}],"created_at":1786675017009494001,"creation_channel":"cli","deps":[{"link_uuid":"923076bc-a5fd-4bd6-8575-60993ae7d8fe","relation":"discovered_from","target_id":"6ccc-0577-198c-44fa"},{"link_uuid":"7f38438e-42be-49f4-8134-c04e1c65ee43","relation":"relates_to","target_id":"3ca8-2fe7-1221-47bc"}],"description":"## Context / Problem\nParity sibling of the reconverge merge-abort recoveries (loris/1757 variant (a), wolverine/1767 variant (b)): the push non-fast-forward recovery path has the SAME untracked-overwrite wedge. `rebar._store.push_recovery._recover_dirty_merge` sets a dirty tree aside with a stash COMMIT OBJECT (`_stash_create`, never refs/stash), clears TRACKED changes via `git reset --hard` (untracked files are deliberately left alone, matching `stash push` semantics), then merges the remote ref. When an UNTRACKED local file collides with a file the merge wants to create — exactly the compaction-leftover class (`*-SNAPSHOT.json`, `*.retired`) that wedged reconverge — the merge aborts (\"untracked working tree files would be overwritten by merge\"), and today's code gives up: `merge --abort`, restore stash, warn/strict-raise. Every push retry then re-fails the same way: the push path cannot self-heal the store class we already heal in reconverge.\n\n## Approach\nExtend `_recover_dirty_merge` (and its `_merge_remote_under_lock` sibling seam if the abort surfaces there) with the SAME recovery shape sync.py's reconverge uses: on merge failure, parse the paths git names with the parser in `rebar._store.sync` — today `_untracked_overwrite_paths` (sync.py:226), being generalized by prerequisite Gerrit change 1767 (ticket dozing-trophied-wolverine) into a shared `_merge_abort_named_paths`; use whichever name is on main at implementation time — move the named UNTRACKED colliding paths into the shared quarantine directory (`<git-common-dir>/reconverge-quarantine/<utc-ts>/`, the dir `_quarantine_untracked`/sync.py:248 established — move, never delete), retry the merge ONCE; any other failure keeps today's behavior exactly (abort, restore stash, warn or strict-raise). Reuse boundary, respecting each module's git seam: the pure PARSER is imported from sync (no subprocess in it), but the MOVER is not — sync's `_quarantine_untracked` shells through sync's module-level `_git`, whereas every push_recovery function deliberately late-binds `core._git` so push's ~25-site test monkeypatch keeps working (push_recovery.py:10-27). So implement the quarantine move locally in push_recovery through `core._git`/os.rename against the same quarantine directory path (share the dir-path helper if 1767 exposes one), rather than calling sync's mover across the seam. The stash restore ordering is preserved: quarantine + retry happen between the failed merge and any `_restore_stash`, so the stash commit object is restored exactly once on every exit path.\n\nSequencing: depends on change 1767 (wolverine) being merged — it lands the shared parser/quarantine helpers this reuses.\n\n## Scope\n- src/rebar/_store/push_recovery.py — untracked-overwrite recovery (quarantine + single retry) in the dirty-merge and locked-merge recovery paths; reuse sync's shared helpers.\n- tests/unit/test_push_recovery_untracked.py (new; or extend the existing push_recovery test module if one covers `_recover_dirty_merge`) — RED-first coverage.\n\n## Testing\n- RED first: fixture store where the worktree holds an untracked file that the remote ref's merge wants to create; assert today's `_recover_dirty_merge` fails (merge aborted, stash restored, no merge commit).\n- GREEN: same fixture after the fix — the colliding untracked file is moved into the quarantine dir (bytes preserved, byte-for-byte), the retried merge completes with both parents, and the stash-recorded tracked edits are restored.\n- Guard: a genuine content conflict still aborts, restores the stash, and warns/strict-raises (unchanged behavior); paths git does not name are untouched; the quarantine dir is only created when something is moved.\n- Stash-safety: the stash commit object is restored exactly once on both the retry-success and retry-failure paths (no lost tracked edits).\n- Mutation check: skipping the quarantine move or the retry returns the RED assertion; retrying more than once is killed by a call-count assertion.\n\n## Acceptance Criteria\n- [x] A push recovery whose merge aborts ONLY on untracked-overwrite collisions completes after quarantining the named paths and retrying once, with no event bytes lost (quarantine holds the moved files); checked by the RED-to-GREEN test.\n- [x] Tracked edits set aside in the stash are restored on every exit path (success, retry-failure, non-recoverable abort); checked by the stash-safety tests.\n- [x] Genuine conflicts and unnamed paths keep today's behavior exactly; checked by the guard test.\n- [x] The recovery reuses the shared sync parser/quarantine helpers (no duplicated recovery mechanism); checked by review of the diff.\n- [x] `make lint` and `make typecheck` clean; lands via Gerrit (LLM-Review +1 AND Verified +1) before close.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_store/push_recovery.py","reason":"untracked-overwrite recovery: parse abort, quarantine, single retry"},{"path":"src/rebar/_store/sync.py","reason":"wire recovery into push retry path"},{"path":"tests/unit/test_push_recovery_untracked.py","reason":"RED-first recovery, stash-safety, guard tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","fb8a-7363-e406-4e36"],["relates_to","3ca8-2fe7-1221-47bc"]],"no_file_impact_reason":"","parent_id":"fb8a-7363-e406-4e36","parent_status_uuid":"53f71bdf-714b-4aa6-892d-4e6b70141c5e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"573a-c8c2-ce2b-4b7f","ticket_type":"bug","title":"Parity sibling: push non-fast-forward recovery (_store/push_recovery.py) has the same untracked-overwrite wedge as reconverge — resets tracked-only, leaves colliding untracked leftovers","verify_commands":[]},"source_event_uuids":["13feddc0-cfcb-4981-8886-ca571e47272e","3d21262d-ce25-4b5f-a7fc-6399cab2cd68","b64f8e7c-f2b0-4f57-bf48-110e81a6e4de","4d2fa06e-969c-49c5-a6ab-b749bc8d1817","a0c07d36-25d5-4b83-9133-c2f91cb9ddb0","0a2ed4d3-d5c1-470f-a491-ea8762f536e4","f0f278fb-7bcb-4be8-99da-a9ca8072fcd4","7f38438e-42be-49f4-8134-c04e1c65ee43","a7a0e81e-b121-4106-a371-178db41af1c9","3fec5cc8-d279-44ed-a279-c9534755663c","663abc45-fba2-4e1e-ae7d-a11b81a2fc7