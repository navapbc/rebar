:9279,"output_tokens":1792,"requests":1}},{"kind":"success","lineage":{"dependencies":[],"digest":"f8282709ea85ddd12a1826da47d40eed6e8f405833dbd3646c19f435f7167da4"},"namespace_version":1,"reason":null,"unit_id":"agent:E4","usage":{"input_tokens":60570,"output_tokens":1775,"requests":4}},{"kind":"success","lineage":{"dependencies":[],"digest":"42a90d661cc36ca767fd617dc50260955677b6414845cb103fb79a78af5e22dd"},"namespace_version":1,"reason":null,"unit_id":"agent:T11","usage":{"input_tokens":4519,"output_tokens":407,"requests":1}},{"kind":"success","lineage":{"dependencies":[],"digest":"0bdc39680f32804afa168621924f23468391f635153466be2c9079bea67f6494"},"namespace_version":1,"reason":null,"unit_id":"agent:T1","usage":{"input_tokens":14556,"output_tokens":1012,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"7b868755382288012045d33e880b957ec539ee3547b2e2cdec6b385e492856ed"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":4223,"output_tokens":582,"requests":1}},{"kind":"success","lineage":{"dependencies":[],"digest":"47112d96d205fcea572ad2c96f627dd7222753c4921d7c3e82850ccde15adf99"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":11255,"output_tokens":481,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"e7a508fedcdba5b00e64f23303e5f95ae943f24d8d42c9ad9989d51a1b09193c"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":10665,"output_tokens":924,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"c9432b14a5f81d18ffe3a7a921cb2ee35d18b5043c82b257c852dbb117afdc50"},"namespace_version":1,"reason":null,"unit_id":"agent:T5c","usage":{"input_tokens":13183,"output_tokens":774,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"21edd11edecebb268e570cbfc9854c6a9a28f041c45f9cc1fa6d4bae11730cc9"},"namespace_version":1,"reason":null,"unit_id":"agent:G6","usage":{"input_tokens":39164,"output_tokens":3559,"requests":4}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Decide whether `_git` should turn a UTF-8 decode failure into a ConfigError so a badly encoded committed config keeps the module's 'fails closed with ConfigError' contract, or state that this edge case is out of scope.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.4089,"drop_reason":null,"evidence":["Plan Cause: \"a non-ASCII byte in that file would fail or mis-decode\". After the fix, invalid UTF-8 still fails, just with a different exception type.","Module docstring: \"fails closed with :class:`~rebar.config.ConfigError` ... so does any failure to read the committed file\"","`_git` only catches `(OSError, subprocess.SubprocessError)`. UnicodeDecodeError is neither."],"finding":"After the fix, `_git` decodes strictly as UTF-8, so bytes that are not valid UTF-8 in the committed rebar.toml/pyproject.toml, or in git's stderr, raise UnicodeDecodeError (a ValueError) from `subprocess.run`. The `except (OSError, subprocess.SubprocessError)` in `_git` does not catch it. The error therefore escapes as a raw exception, not the ConfigError the module promises for 'any failure to read the committed file'. Callers that catch ConfigError to print the fail-closed message will show a traceback instead.","group_criteria":null,"group_id":null,"id":"f981aa7febf0df665","impact":0.44,"is_primary":null,"location":"Fix section; src/rebar/_opcert_gate_config.py `_git` (lines 58-70)","norm_id":"n4edab86e20510d07","priority":0.3911,"reason":"default-advisory","recalled":false,"scenarios":["On Windows, a base-branch rebar.toml with a stray cp1252 byte (such as an em-dash typed in an editor using that code page) used to decode silently under cp1252. Now it raises UnicodeDecodeError out of `rebar verify-opcert`, not a ConfigError diagnostic.","git writes a non-UTF-8 message to stderr on a failed `ls-tree`/`show`, and the decode fails before the returncode check runs."],"severity":null,"suggested_fix":"Widen the except in `_git` to `(OSError, subprocess.SubprocessError, UnicodeDecodeError)` so it raises the same `ConfigError(f\"op-cert gate: git {args[0]} failed in {root}: {exc}\")`. Or leave it alone and say in Scope that this edge case existed before and is out of scope.","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Tag the Gerrit-merge AC `[non-codebase]` and record its attestation (Change-Id, LLM-Review/Verified votes, merge timestamp) on the ticket.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5d","T5e"],"criteria":["F1","E6"],"decision":"dropped","decision_margin":-0.6743,"drop_reason":null,"evidence":["\"- [x] The Gerrit change merges with `LLM-Review +1` and `Verified +1`.\"","No `[non-codebase]` tag and no Change-Id or merge timestamp anywhere in the plan."],"finding":"The criterion 'The Gerrit change merges with `LLM-Review +1` and `Verified +1`' depends on evidence outside the codebase. It is not tagged `[non-codebase]` and no concrete attestation is recorded (Change-Id, vote outcome, timestamp), yet it is already checked [x].","group_criteria":null,"group_id":null,"id":"f86bff5080056540a","impact":0.44,"is_primary":null,"location":"Acceptance criteria, line 4","norm_id":"n00ad2da94cb9ed1f","priority":0.1257,"reason":"low-validity","recalled":false,"scenarios":["A reviewer cannot confirm the checked box from the ticket alone, because no Change-Id or vote record is linked."],"severity":null,"suggested_fix":"Rewrite as: `- [x] [non-codebase] The Gerrit change <Change-Id> merges with LLM-Review +1 and Verified +1 (merged <timestamp>).`","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"f8fb54e2039e0414","material_parts":{"children":["647ea2107ca5072f",0],"description":["68ef1884927a1e4a",1326],"description_boxes":["2481a63c85a62cf8",4],"file_impact":["486096e563a07542",1],"ticket_id":["d3f5d969311159da",19]},"metrics":{"cache_read_tokens":132030,"cache_write_tokens":97923,"claim_path":"no-llm/no-network (structura