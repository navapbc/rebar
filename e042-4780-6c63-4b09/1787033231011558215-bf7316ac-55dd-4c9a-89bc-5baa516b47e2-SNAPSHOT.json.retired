b31e86","position":{"commit_sha":"87934e2f53cccbdde1450e2ead2762076a9c2c55","position":"1787026334969476815-fba249c0-4e03-40f4-9697-8a6157b31e86"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"996374d5c69c2da93c643eebc963acdff649764f55466a89b7572301ec1850a2","event_uuid":"ec9b8b14-f311-4a02-986e-ac06b2f69635","position":{"commit_sha":"ec2b80b7cb088112b2cd271b21c23e5f730a4c54","position":"1787029326053124285-ec9b8b14-f311-4a02-986e-ac06b2f69635"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"821427091cd4214d447f0137a072125436025f34b45c99539bf4a8fa224c8b12","event_uuid":"ca72fc7c-50f2-4ecf-8e21-38d203167e90","position":{"commit_sha":"c0dca57677362b7a9275647fab2be50fb7940d0d","position":"1787031100031642177-ca72fc7c-50f2-4ecf-8e21-38d203167e90"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786995161367646001,"creation_channel":"cli","deps":[{"link_uuid":"a28cf847-53a9-42eb-96f2-750e2e7787e1","relation":"depends_on","target_id":"a377-7fcd-4af0-4d11"},{"link_uuid":"d039c5e2-5f71-4308-972a-d7aad1de3284","relation":"relates_to","target_id":"f5ac-6373-5e33-4374"},{"link_uuid":"27633327-3b16-4d04-bd8e-8c07cfe54e39","relation":"relates_to","target_id":"f828-6f5e-3b15-41f5"},{"link_uuid":"04c5f298-0844-4ee3-b1a5-513eeb64ffd3","relation":"relates_to","target_id":"77c0-9fe4-e0eb-4073"},{"link_uuid":"ed3aeb35-0bb4-49af-986e-ccb9a76815fb","relation":"relates_to","target_id":"6905-f12c-f00c-476f"},{"link_uuid":"00cee706-af56-4e8f-ab59-58bc38569eb6","relation":"relates_to","target_id":"6c19-d368-276d-46e4"},{"link_uuid":"fba249c0-4e03-40f4-9697-8a6157b31e86","relation":"relates_to","target_id":"cf1c-3507-0500-4358"},{"link_uuid":"ec9b8b14-f311-4a02-986e-ac06b2f69635","relation":"relates_to","target_id":"034f-44c9-dcb0-4468"},{"link_uuid":"ca72fc7c-50f2-4ecf-8e21-38d203167e90","relation":"relates_to","target_id":"be8b-4d09-c51f-4d30"}],"description":"## Context / Problem\nThe S1 snapshot exists in shadow mode, but reconciler read/check paths still call `load_config()`, inspect environment/cwd, hard-code tracker layout, and build Jira backends whose properties can reload ambient settings. This can change read scope during one run or discard the supplied registry config.\n\n## Outcome\nCut `reconcile-check` and dry-run fetch/diff/preflight paths over to focused immutable `ReconcilerSettings`, `GitRuntime`, and selected `BridgeRuntime` projections. Construct exactly one selected Jira Cloud or Jira Data Center backend from those bindings; its project/query scope, TLS, timeout/limits, tracker layout, and auth capability remain stable for the operation.\n\n## Plan\n1. Add `src/rebar/_engine/rebar_reconciler/runtime.py` for the focused reconciler/Git/bridge projection and provider-specific Jira static-auth carriers, composed from the S1 snapshot seam. Static fields use non-serializable Pydantic `SecretStr`/`SecretBytes`, are excluded from repr/equality/hash/cache/fingerprint, and unwrap only in the selected Jira sending adapter.\n2. Change `src/rebar/_engine/rebar_reconciler/_backend_registry.py` and Jira Cloud/DC factories/settings to consume the supplied projection/binding. Do not construct the unselected backend. Preserve official Jira client/ACLI TLS, timeout, retry, error, and close behavior.\n3. Thread the same backend/runtime through preflight, access check, fetch, paging, inbound/outbound diff, mapper/sanitizer/property access, tracker/binding reads, and Git ref/layout owners. Remove ambient reloads from those read/check call paths.\n4. Apply approved deltas explicitly: supplied Python config remains authoritative; custom tracker directory/branch/remote reaches every read owner; empty Cloud read scope fails closed; malformed config/auth fails before provider request. No write/apply path is cut over here.\n\n## Testing (RED -> GREEN)\n- Component tests construct a backend, monkeypatch every ambient resolver to raise, then exercise project/query properties, access check, paged fetch, inbound/outbound diff, mapper, sanitizer, binding lookup, and custom tracker ref reads.\n- Interface tests run Cloud and DC `reconcile-check`/dry-run through CLI, Python, MCP, and direct-module paths against verified fake transports. The oracle is provider request parameters plus provider-neutral result, not private implementation shape.\n- Failure tests use missing/conflicting auth, empty project/query scope, malformed TLS/URL/config, and the unselected provider's poison constructor; assert zero Jira model request/local write and typed/redacted errors.\n- Secret canaries cover carriers, backend repr, exceptions, logs, provenance, request URL/query, cache/fingerprint, and the unselected adapter.\n- Existing Jira auth/TLS/retry/output fixtures and ticket-sourced regressions are a required baseline; any deliberate difference is named in the ticket comment before implementation changes it.\n\n## Compatibility / rollback\nKeep a read-only compatibility facade that can delegate the read/check call to legacy composition while S2 parity/deltas are measured. No stored format changes. Rollback selects that facade before S3 write cutover; secrets are never logged for comparison.\n\n## Acceptance Criteria\n- [ ] Cloud and DC read/check interface tests complete with all ambient resolvers poisoned after composition, proving one backend/settings authority for the operation.\n- [ ] Supplied config and custom tracker directory/branch/remote determine every observed read/ref/query owner; ambient root-B mutations cannot alter a root-A operation.\n- [ ] Backend project/query/TLS/timeout/limit properties remain unchanged after environment/file mutation and the next operation observes the new composition.\n- [ ] Exactly the selected Jira integration is constructed; missing/conflicting auth or decision-bearing scope fails before a Jira model request or local write with no anonymous/cross-provider/principal fallback.\n- [ ] Secret canaries are absent from every named carrier/backend/diagnostic/wire boundary, while the selected sending adapter can authenticate the verified fake request.\n- [ ] Existing read/check provider-neutral outputs stay equal except the approved explicit-input, fail-fast, and stable-property deltas; disabling the read facade restores legacy behavior.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/runtime.py","reason":"New focused ReconcilerSettings, GitRuntime, BridgeRuntime, and static Jira carrier projections."},{"path":"src/rebar/_engine/rebar_reconciler/_backend_registry.py","reason":"Construct one selected backend from supplied operation bindings."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/","reason":"Cloud read/check settings, auth boundary, transport, mapper, and stable properties."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/","reason":"Data Center read/check settings, auth boundary, transport, and stable properties."},{"path":"src/rebar/_engine/rebar_reconciler/fetcher.py","reason":"Use injected backend/runtime for fetch and query scope."},{"path":"src/rebar/_engine/rebar_reconciler/inbound_differ.py","reason":"Use injected backend mapper without ambient reload."},{"path":"src/rebar/_engine/rebar_reconciler/_preflight.py","reason":"Fail decision-bearing config/auth before provider request."},{"path":"src/rebar/_engine/rebar_reconciler/access_check.py","reason":"Use the selected stable backend/auth binding."},{"path":"tests/unit/rebar_reconciler/","reason":"Cloud/DC stable-property, poisoned-ambient, failure, and secret-carrier oracles."},{"path":"tests/interfaces/store/test_reconciler_operation_bindings.py","reason":"Provider-neutral read/check interface coverage across surfaces."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","a377-7fcd-4af0-4d11"],["parent","e215-ab23-ed6a-4791"],["relates_to","034f-44c9-dcb0-4468"],["relates_to","6905-f12c-f00c-476f"],["relates_to","6c19-d368-276d-46e4"],["relates_to","77c0-9fe4-e0eb-4073"],["relates_to","be8b-4d09-c51f-4d30"],["relates_to","cf1c-3507-0500-4358"],["relates_to","f5ac-6373-5e33-4374"],["relates_to","f828-6f5e-3b15-41f5"]],"no_file_impact_reason":"","parent_id":"e215-ab23-ed6a-4791","parent_status_uuid":"c30182e2-b03a-4026-a104-75f776298ba1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["rp04","config","reconciler","jira"],"ticket_id":"e042-4780-6c63-4b09","ticket_type":"story","title":"RP-04 S2 — Cut reconciler read/check paths to operation runtimes","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/test_operation_bindings.py","dd_id":"AC1-AC5","dd_text":"Stable selected backend/runtime, poisoned ambient, failure, and secret carrier behavior"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/interfaces/store/test_reconciler_operation_bindings.py","dd_id":"AC1-AC6","dd_text":"Provider-neutral read/check behavior through supported surfaces"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/test_cloud_config_validation.py tests/unit/rebar_reconciler/test_jira_dc_config_settings.py tests/unit/rebar_reconciler/state/test_config_jira_wiring.py","dd_id":"REGRESSION","dd_text":"Existing Cloud/DC configuration, TLS, and settings lessons"}]},"source_event_uuids":["a907b707-4533-4e24-81b0-5071a4d5ac8c","c30182e2-b03a-4026-a104-75f776298ba1","9cb202cc-d6de-45ad-9fdc-d4d6fd4c3f1a","d039c5e2-5f71-4308-972a-d7aad1de3284","27633327-3b16-4d04-bd8e-8c07cfe54e39","04c5f298-0844-4ee3-b1a5-513eeb64ffd3","ed3aeb35-0bb4-49af-986e-ccb9a76815fb","00cee706-af56-4e8f-ab59-58bc38569eb6","fba249c0-4e03-40f4-9697-8a6157b31e86","ec9b8b14-f311-4a02-986e-ac06b2f69635","ca72fc7c-50f2-4ecf-8e21-38d203167e90"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787033231011558215,"uuid":"bf7316ac-55dd-4c9a-89bc-5baa516b47e2"}