639a01b628ad4de09442d0f1","position":"1789904372712296939-b5692096-e812-4085-ac4a-8bda84e5cb88"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9cd3b5f470c9a23b4bd7fa4509c26d70f30a70a7ecf976aa7a3b35a1363fbc63","event_uuid":"e6dcf85a-5c13-473d-9c2a-75f0364c12b7","position":{"commit_sha":"3fe349848d79564ea50319ea4255260d361a4abe","position":"1789904378145392399-e6dcf85a-5c13-473d-9c2a-75f0364c12b7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ac639939aaa5fa88f0eb730c5c6acdc1cbe88619263d9f7f5401b69a4b1ac6ec","event_uuid":"75f671f1-1614-47b0-b086-60a21faad91f","position":{"commit_sha":"264482057f92b596b6e367fd5a71eb3f78ec5b2b","position":"1789904385851747962-75f671f1-1614-47b0-b086-60a21faad91f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"plan_defect","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Second independent occurrence confirms the root cause, and rules out a narrow submit-race reading.\n\nRun `35492165781`:\n\n- Run created `2026-09-20T05:37:56Z`; `actions/checkout` therefore ran at about `05:38:0x`.\n- Gerrit change **2994** (`Stop the cap handler lying about a dry-run`) was submitted at **`05:38:16`** — a few seconds AFTER that checkout.\n- The merged-reachability check failed at **`05:43:21`**, five minutes later, with the same\n  `Gerrit/GitHub main diverged or Gerrit MERGED revisions are not reachable from main.`\n- The next scheduled run passed with no intervention.\n\nThe five-minute gap is the decisive detail. A pure replication-lag race would have cleared\nlong before `05:43:21`; GitHub `main` had certainly received 2994 by then. What had NOT\nchanged is the job's own `HEAD`, frozen at checkout time `05:38:0x` — before 2994 landed.\n\nSo the failing comparison is not \"Gerrit ahead of GitHub\". It is \"Gerrit ahead of a GitHub\nsnapshot this job took minutes ago\". That isolates defect 2 in the description — the stale\n`destination_ref=\"HEAD\"` baseline — as the dominant cause, with the missing re-sample\n(defect 1) removing the only mechanism that could have absorbed it.\n\nBoth observed failures fit: run `35497408797` had a 10-second gap (2997 at `07:41:48`,\nerror at `07:41:58`), run `35492165781` had a five-minute gap. A fix that only added\nre-sampling without re-fetching the GitHub tip would still fail the second case, because\nre-sampling a frozen `HEAD` returns the same answer every time.","timestamp":1789896063869627973},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Completion evidence for merged fix:\n\n- Gerrit change 3007 revision `f4b72dc1f75a6740154c6f52e6367bf2c56cc1fe` earned both `LLM-Review +1` and `Verified +1`; revision-scoped submit returned MERGED.\n- Merged commit on `origin/main`: `e84e4c5e9439bcfd27875d152de36eb40eb4f46b` (`Refresh mirror reachability main tip`).\n- Live Mirror Guard evidence: GitHub Actions run `35507233659`, `headSha=e84e4c5e9439bcfd27875d152de36eb40eb4f46b`, `status=completed`, `conclusion=success`; observed after waiting 917 seconds for a qualifying post-merge scheduled run.\n- Targeted merged-tree pytest evidence from archived tree with pinned `PYTHONPATH`: `38 passed in 1.34s` for `tests/unit/test_mirror_guard.py -q`.\n- Ratchet evidence from the archived merged tree: complexity check printed `active=32 new=0 increased=0 stale=17`; mechanism check exited 0 and printed `active=682 new=26 increased=0 stale=0`, with the same admitted entries as the parent, so this change introduced no unadmitted mechanism entries.\n- Full local `make verify` was intentionally not run on this macOS arm64 host: `pypandoc-binary==1.17`'s arm64 wheel ships an x86_64 pandoc, causing 17 unrelated pandoc tests to fail. Prior combined-stack local evidence on a worktree cherry-picking this fix onto `origin/main` plus 2 unrelated commits returned exactly the known host baseline: `17 failed, 20262 passed, 126 skipped, 21 warnings in 1701.85s`.","timestamp":1789903141364753719}],"completion_expectation":"required","created_at":1789895721703072627,"creation_channel":"mcp","deps":[{"link_uuid":"eb8ba581-a03e-4517-8db2-0a5e3f67d8b5","relation":"relates_to","target_id":"d705-b052-f8c9-4dcb"}],"description":"## Problem\n\n`Mirror Guard` fails spuriously whenever a Gerrit change is submitted while a guard\nrun is in flight. The run reports the invariant failure\n\n```\nGerrit/GitHub main diverged or Gerrit MERGED revisions are not reachable from main.\n```\n\neven though replication is healthy and self-corrects within seconds.\n\n## Evidence\n\nRun `35497408797` (2026-09-20):\n\n- Run started `07:38`, error logged `2026-09-20T07:41:58.1712866Z`.\n- Gerrit change **2997** (`Preserve partial metered Bedrock spend`, revision\n  `1f338f2c57e`) was submitted at **07:41:48** — **10 seconds before** the error.\n- The next scheduled run at `07:49` passed with no intervention, as did `08:21`,\n  `08:41` and `08:50`.\n\nThe first hypothesis — that changes 2998/2999 caused it — is refuted: both were\nsubmitted at `08:08:53`, 27 minutes *after* the failure.\n\n## Root cause\n\nTwo compounding defects in `src/rebar/mirror_guard.py`, both in how\n`merged_reachability_check` differs from the replication check beside it.\n\n**1. No lag tolerance.** `_replication_check_with_lag_tolerance`\n(`src/rebar/mirror_guard.py:305`) re-samples up to 3 times, 45s apart, explicitly to\nabsorb replication lag. `merged_reachability_check` (`src/rebar/mirror_guard.py:253`)\nis called once from `run()` (`src/rebar/mirror_guard.py:378-379`) with no re-sample and\nno tolerance of any kind. The workflow header in\n`.github/workflows/mirror-guard.yml` advertises the ~45s window as if it covered the\nwhole job; it covers only the replication half.\n\n**2. The comparison baseline is a stale snapshot.** `merged_reachability_check` proves\neach merged revision is an ancestor of `destination_ref`, which defaults to `\"HEAD\"`.\nIn the workflow, `HEAD` is the `actions/checkout` of GitHub `main` taken at job start.\nSo the guard compares Gerrit's *live* MERGED list against a GitHub `main` snapshot\ncaptured minutes earlier. The race window is therefore the job's own runtime — about\n3 minutes in run `35497408797` — not the ~15s replication lag the design anticipated.\n\nAny submit landing inside that window is guaranteed to appear unreachable.\n\n## Why it matters\n\nMirror Guard exists to detect a genuinely broken mirror lock. It runs every 15\nminutes. A false positive on every merge that races a run destroys exactly the signal\nthe guard is for, and trains readers to ignore it — the same failure mode as the\nalarm-quality bugs already tracked in this store.\n\n## Acceptance criteria\n\n- [x] `merged_reachability_check` re-fetches the GitHub `main` tip rather than comparing against the checkout-time `HEAD`.\n- [x] A merged revision that is unreachable on the first sample is re-sampled before the run fails.\n- [x] A revision that becomes reachable during the re-sample window yields a healthy verdict.\n- [x] A revision that stays unreachable across the whole window still yields an unhealthy verdict.\n- [x] The healthy-after-re-sample verdict states in its `reason` that it converged, matching the replication check's existing wording.\n- [x] The re-sample count and delay are shared with the replication check rather than duplicated as separate literals.\n- [x] The `.github/workflows/mirror-guard.yml` header no longer implies the re-sample window covers a check that does not re-sample.\n- [x] A unit test reproduces run `35497408797`: a revision submitted after checkout, unreachable on sample 1, reachable on sample 2, producing a healthy verdict.\n- [x] `python scripts/check_complexity_baseline.py --check` reports no new or increased entries.\n- [x] `python scripts/check_mechanism_delta.py --check` reports no new entries.\n\n## Verification\n\n```\npytest tests/unit/test_mirror_guard.py -v\n```\n\nmust exit zero with every test passing; each behavioural criterion above has a named\ntest there. Repository gates are proven by `make lint` and `make typecheck`, each\nexiting zero.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/mirror_guard.py","reason":"merged_reachability_check gains a re-fetched GitHub main baseline and shares the replication check's re-sample window"},{"path":"tests/unit/test_mirror_guard.py","reason":"adds the regression test reproducing run 35497408797 and the re-sample convergence cases"},{"path":".github/workflows/mirror-guard.yml","reason":"header comment currently implies the re-sample window covers merged-reachability, which it does not"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","d705-b052-f8c9-4dcb"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e6dcf85a-5c13-473d-9c2a-75f0364c12b7","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["ci","mirror-guard","false-positive","signal-quality"],"ticket_id":"974f-a1c8-da40-43a0","ticket_type":"bug","title":"Mirror Guard's merged-reachability check has no lag tolerance, so any merge during a run reds it","verify_commands":[]},"source_event_uuids":["f24113ff-8112-42c5-98cc-a6e52a5470aa","a4c56f08-3320-48a2-8a36-733454b1c441","9ad4b3bf-0612-4120-b4c8-cd39075b6897","133e5452-e0b9-47dd-9c17-82be157c5d2e","f51a6baa-9d13-4278-8995-b14cc74d39a0","51dbc225-b498-42bf-a9f3-8f10ff9de5b9","3aca2691-3de6-4045-a7e6-a634e6d05f4d","eb8ba581-a03e-4517-8db2-0a5e3f67d8b5","b54e460c-cb43-4ce9-bc4d-47346553b62c","f0e6e2bc-1c34-47eb-b6ae-baea650164f3","b5692096-e812-4085-ac4a-8bda84e5cb88","e6dcf85a-5c13-473d-9c2a-75f0364c12b7","75f671f1-1614-47b0-b086-60a21faad91f"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793221743842129001,"uuid":"2008eefa-0054-4cac-8bf4-339a0a718324"}