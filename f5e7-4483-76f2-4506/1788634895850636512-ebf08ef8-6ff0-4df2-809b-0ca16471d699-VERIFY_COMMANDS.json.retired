omments\":[]},\"tests/unit/test_jira_dc_capability_map_workflow.py\":{\"docs\":[\"<module>\",\"_run_map_script\",\"test_committed_map_records_the_digest_it_was_measured_against\",\"test_map_script_is_executable_and_fails_cleanly_offline\",\"test_script_adds_no_pre_create_field_wait\"],\"comments\":[{\"scope\":\"<module>\",\"before\":\"def _run_map_script\"},{\"scope\":\"<module>\",\"before\":\"_PROBE_WORKFLOW =\"},{\"scope\":\"<module>\",\"before\":\"_SYSTEM_ONLY_FIELDS = [\"}]},\"tests/unit/test_jira_onboard.py\":{\"docs\":[\"<module>\",\"test_write_rejects_non_https_url_fail_closed\"],\"comments\":[]},\"tests/unit/test_jira_snapshot_entry_schema.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_json_or_narrowing.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_kind_wire_value_cutover_edge.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_last_pass_backoff_jitter_paediatric.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_legacy_material_grandfather_96d1.py\":{\"docs\":[\"<module>\"],\"comments\":[]},\"tests/unit/test_legacy_signature_mirror_drop.py\":{\"docs\":[],\"comments\":[{\"scope\":\"<module>\",\"before\":\"def test_strip_keys_always_drop_mirror\"}]}}'\"'\"')\nWORD=re.compile(r\"[A-Za-z0-9_]+(?:['\"'\"'’-][A-Za-z0-9_]+)*\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"rtk\",\"proxy\",\"git\",\"show\",ref+\":\"+path],text=True)\ndef docs(tree):\n    out={}\n    def visit(node,owner):\n        if isinstance(node,SCOPES) and node.body:\n            first=node.body[0]\n            if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n                out[owner]=first.value.value\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    return out\ndef scopes(tree,lines):\n    out=[(\"<module>\",1,len(lines))]\n    def visit(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                out.append((name,child.lineno,child.end_lineno or child.lineno)); visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\"); return out\ndef comments(raw,tree):\n    lines=raw.splitlines(); owners=scopes(tree,lines); full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT: continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left: inline.append((tok.string,left.strip()))\n        else: full[row]=tok.string\n    regions=[]; i=1\n    while i<=len(lines):\n        if i not in full: i+=1; continue\n        entries=[]; start=i\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full: entries.append((i,full[i]))\n            i+=1\n        owner=min((s for s in owners if s[1]<=entries[0][0]<=s[2]),key=lambda s:s[2]-s[1])[0]\n        nxt=i\n        while nxt<=len(lines) and lines[nxt-1].lstrip().startswith(\"@\"): nxt+=1\n        before=\"<EOF>\" if nxt>len(lines) else lines[nxt-1].strip()\n        prev=start-1; after=\"<BOF>\"\n        while prev>=1:\n            stripped=lines[prev-1].strip()\n            if stripped and not stripped.startswith(\"#\"): after=stripped; break\n            prev-=1\n        regions.append((owner,before,after,\"\\n\".join(text for _,text in entries)))\n    return regions,inline\ndef select(regions,rule,path):\n    hits=[r for r in regions if r[0]==rule[\"scope\"] and r[1].startswith(rule[\"before\"]) and (\"after\" not in rule or r[2].startswith(rule[\"after\"]))]\n    if len(hits)!=1: raise SystemExit(\"comment selector mismatch: \"+path+\" \"+repr(rule)+\" hits=\"+str(len(hits)))\n    return hits[0]\ndef normalize(raw,path):\n    tree=ast.parse(raw,type_comments=True); wanted=set(ALLOWED[path][\"docs\"]); seen=set()\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore): node.lineno=0\n        if isinstance(node,SCOPES) and owner in wanted and node.body:\n            first=node.body[0]\n            if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n                node.body=node.body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else: visit(child,owner)\n    visit(tree,\"<module>\")\n    if seen!=wanted: raise SystemExit(\"docstring allowlist mismatch: \"+path+\" missing=\"+repr(sorted(wanted-seen)))\n    return ast.dump(tree,include_attributes=False)\nfor path in sys.argv[1:]:\n    base=source(BASE,path); current=source(CURRENT,path); final=source(\"HEAD\",path)\n    bt=ast.parse(base,type_comments=True); ct=ast.parse(current,type_comments=True); ft=ast.parse(final,type_comments=True)\n    bd,cd,fd=docs(bt),docs(ct),docs(ft)\n    br,bi=comments(base,bt); cr,ci=comments(current,ct); fr,fi=comments(final,ft)\n    rules=ALLOWED[path]\n    base_text=[]; current_text=[]; final_text=[]\n    for owner in rules[\"docs\"]:\n        if owner not in bd or owner not in cd or owner not in fd: raise SystemExit(\"selected docstring missing: \"+path+\"#\"+owner)\n        base_text.append(bd[owner]); current_text.append(cd[owner]); final_text.append(fd[owner])\n    for rule in rules[\"comments\"]:\n        base_text.append(select(br,rule,path)[3]); current_text.append(select(cr,rule,path)[3]); final_text.append(select(fr,rule,path)[3])\n    if base_text!=current_text: raise SystemExit(\"frozen prose differs at current code basis: \"+path)\n    for before,after in zip(base_text,final_text):\n        bw=len(WORD.findall(before)); aw=len(WORD.findall(after))\n        if not 0<aw<bw: raise SystemExit(\"selected block is not nonempty and shorter: \"+path+\" \"+str((bw,aw)))\n    if normalize(current,path)!=normalize(final,path): raise SystemExit(\"normalized runtime AST changed: \"+path)\n    def protected(regions):\n        return [r for r in regions if not any(r is select(regions,rule,path) for rule in rules[\"comments\"])]\n    if ci!=fi: raise SystemExit(\"inline comment changed: \"+path)\n    if protected(cr)!=protected(fr): raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)\n' tests/unit/test_identity_ts2_09f9_heldout.py tests/unit/test_identity_ts2_09f9.py tests/unit/test_identity_ts3_117b_heldout.py tests/unit/test_identity_ts3_117b.py tests/unit/test_identity_txn_signing_heldout.py tests/unit/test_impact_code.py tests/unit/test_impact_model_versioning.py tests/unit/test_impact_plan.py tests/unit/test_init_ensures_seam.py tests/unit/test_interpret_failure_seam.py tests/unit/test_jira_dc_capability_map_workflow.py tests/unit/test_jira_onboard.py tests/unit/test_jira_snapshot_entry_schema.py tests/unit/test_json_or_narrowing.py tests/unit/test_kind_wire_value_cutover_edge.py tests/unit/test_last_pass_backoff_jitter_paediatric.py tests/unit/test_legacy_material_grandfather_96d1.py tests/unit/test_legacy_signature_mirror_drop.py","dd_id":"semantic","dd_text":"Frozen/current prose identity, per-block shortening, normalized runtime AST equality, and exact protected-comment preservation."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nCURRENT='\"'\"'6e3c3571dd5b4f82a0faf55ac4b3f3a44401b708'\"'\"'\nPATTERN=re.compile(r\"#\\s*(?:!|-\\*-|coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path): return subprocess.check_output([\"rtk\",\"proxy\",\"git\",\"show\",ref+\":\"+path],text=True)\ndef signatures(raw):\n    lines=raw.splitlines(); found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string): continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left: anchor=(\"inline\",left.strip())\n        else:\n            anchor=(\"next\",\"<EOF>\")\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"): anchor=(\"next\",stripped); break\n        found.append((tok.string,anchor))\n    return found\ndef shebang(raw): return raw.splitlines()[0] if raw.startswith(\"#!\") else None\nfor path in sys.argv[1:]:\n    before=source(CURRENT,path); after=source(\"HEAD\",path)\n    if signatures(before)!=signatures(after): raise SystemExit(\"directive text or attachment changed: \"+path)\n    if shebang(before)!=shebang(after): raise SystemExit(\"shebang changed: \"+path)\n' tests/unit/test_identity_ts2_09f9_heldout.py tests/unit/test_identity_ts2_09f9.py tests/unit/test_identity_ts3_117b_heldout.py tests/unit/test_identity_ts3_117b.py tests/unit/test_identity_txn_signing_heldout.py tests/unit/test_impact_code.py tests/unit/test_impact_model_versioning.py tests/unit/test_impact_plan.py tests/unit/test_init_ensures_seam.py tests/unit/test_interpret_failure_seam.py tests/unit/test_jira_dc_capability_map_workflow.py tests/unit/test_jira_onboard.py tests/unit/test_jira_snapshot_entry_schema.py tests/unit/test_json_or_narrowing.py tests/unit/test_kind_wire_value_cutover_edge.py tests/unit/test_last_pass_backoff_jitter_paediatric.py tests/unit/test_legacy_material_grandfather_96d1.py tests/unit/test_legacy_signature_mirr