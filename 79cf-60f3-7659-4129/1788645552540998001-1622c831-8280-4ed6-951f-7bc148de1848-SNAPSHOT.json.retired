2473baaeef85fbf20478ea72ebb57357d25665ffb7f3a7d8dc56d3b41","event_uuid":"4769a452-3f24-43b0-9e17-baafb3b109dc","position":{"commit_sha":"5648ba19472a0c6338187ad0789079d75a6b83ce","position":"1788630840574454777-4769a452-3f24-43b0-9e17-baafb3b109dc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"7f225a1cf8b96b6be20179e0f3324293c4959a4f4dbb6a941727a7c4ba4e2b64","event_uuid":"7082151d-0b06-4a52-a914-082fb763b2de","position":{"commit_sha":"dfbd34c03ae769a3ed60b981c8f317fb9006f9e6","position":"1788630860990806095-7082151d-0b06-4a52-a914-082fb763b2de"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"296c6becd3ab04ba6ab01e96a4ca04d1ad43a16804783df198454865e0bd9ce2","event_uuid":"ba2bddd2-c349-488b-80d8-b2a8ff093479","position":{"commit_sha":"49d30ffd264b7911c584f785ad120aafcefe003e","position":"1788630884738715479-ba2bddd2-c349-488b-80d8-b2a8ff093479"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e5998e2074f3f7331668028a9f3a6db303f5c6b6f93c72932b23836e1d9475c7","event_uuid":"6b3a23b2-25ca-4f43-99ef-1587290ec041","position":{"commit_sha":"52112d5df59208b3032af6b273cb5f639be386e5","position":"1788630922729465489-6b3a23b2-25ca-4f43-99ef-1587290ec041"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"761ef85feddd3dccec28b43c5833524f83da8671092d50afb92403c476ed85ed","event_uuid":"f41b4a59-9c6b-4f45-b219-3591d835bd97","position":{"commit_sha":"b78628143d135e99ec15052f286874f01690e5d0","position":"1788636888715385001-f41b4a59-9c6b-4f45-b219-3591d835bd97"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788630840574454777,"creation_channel":"mcp","deps":[{"link_uuid":"6b3a23b2-25ca-4f43-99ef-1587290ec041","relation":"discovered_from","target_id":"61c7-401f-9fd5-406f"}],"description":"## Context / immutable audit base\n`tests/unit/test_engine_root_convention.py` was introduced by the `d6669496..88c90f8b5abf4a80be3b1289d7719d6e03e29684` delta and has no recorded file-impact owner. At `origin/main@88c90f8b5abf4a80be3b1289d7719d6e03e29684` it contains exactly four editable blocks: three true leading docstrings and one full-line comment region, 461 before-words. Counts use `(?u)\\b[^\\W_]\\w*(?:[-'][^\\W_]\\w*)*\\b`.\n\n## Exact prose allowlist\n- `D:<module>@1-32[316]` — retain the two-root hazard and why static plus dynamic enforcement are both required; remove chronology, lane history, uppercase narration, and duplication.\n- `C:<module>:before:_ALLOWED@52-55[49]` — retain why the production-resolver test is the sole safe exception.\n- `D:test_no_test_module_resolves_the_installed_engine_root@80-85[44]` — retain checkout-root and AST false-positive behavior.\n- `D:split_engine@138-143[52]` — retain the install-mode-independent split fixture contract.\n\n## Consumers and protected prose\nThe module is a direct pytest input and pins `tests/_engine_path.py` plus the root-conftest guard. Preserve the static scanner, allowlist anti-drift assertion, manufactured foreign-root topology, canonical/shadow controls, and all runtime strings/assertions.\n\nAll unlisted prose is protected as concise or load-bearing: lines 48-49; `_installed_root_sites`, `test_the_conftest_guard_is_wired_to_the_detector`, the foreign-`__path__` test, and the canonical-shadow test docstrings; the line-146 `__pycache__` comment; and every other one-line helper/test docstring.\n\n## Preservation and review contract\nCompare immutable `88c90f8b5abf4a80be3b1289d7719d6e03e29684:<path>` blobs with the final commit. Parse Python with `ast.parse(..., type_comments=True)`; remove only the allowlisted leading owner docstrings; normalize only `ast.TypeIgnore.lineno`; require the remaining AST to match. Reject changes to inline or non-allowlisted comments. Preserve runtime strings, assertions, decorators, test data, shebangs, and every directive-bearing physical line exactly. Only adjacent blank-line normalization is allowed.\n\nA reviewer who did not author the leaf must post exactly 4 leaf-linked TSV rows:\n`stable_block_id<TAB>before_citation<TAB>final_citation<TAB>preserved_contract_or_consumer<TAB>directives_exact<TAB>before_words<TAB>after_words<TAB>semantic-preservation<TAB>bloat-removal<TAB>reviewer_session`.\nBefore citations use `88c90f8b5abf4a80be3b1289d7719d6e03e29684:<path>#<stable-id>`; final citations use `<full-final-sha>:<path>#<stable-id>`. Every row must have `after_words < before_words` and all three verdict fields PASS.\n\n## Acceptance Criteria\n- [ ] The one-commit changed-path set is exactly the 1-path file-impact set.\n- [ ] Only the 4 declared prose blocks and adjacent blank lines change.\n- [ ] The normalized non-docstring AST is identical on every impacted path.\n- [ ] Runtime strings and non-allowlisted comments remain byte-identical.\n- [ ] Directive and shebang physical lines remain byte-identical and attached.\n- [ ] The independent TSV has exactly 4 passing rows.\n- [ ] Every recorded DD command passes, including the no-timeout worktree-venv `make verify`.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"tests/unit/test_engine_root_convention.py","reason":"Condense four audited engine-root convention blocks while preserving the static/dynamic enforcement contract."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","ae4d-df34-480d-4c88"]],"no_file_impact_reason":"","parent_id":"ae4d-df34-480d-4c88","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"79cf-60f3-7659-4129","ticket_type":"task","title":"Condense comments in tests/unit — engine-root convention delta","verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, difflib, io, json, os, re, subprocess, tokenize\nBASE=\"88c90f8b5abf4a80be3b1289d7719d6e03e29684\"\nAFTER=os.environ.get(\"REBAR_AFTER_REF\",\"HEAD\")\nSPEC=json.loads(\"\"\"{\"tests/unit/test_engine_root_convention.py\":{\"docs\":[\"<module>\",\"test_no_test_module_resolves_the_installed_engine_root\",\"split_engine\"],\"spans\":[[1,32],[52,55],[80,85],[138,143]]}}\"\"\")\nOWNERS=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\nPAT=re.compile(r\"#\\\\s*(?:noqa\\\\b|type:\\\\s*ignore\\\\b|pragma:\\\\s*no cover\\\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\\\s*(?:on|off|skip)\\\\b|nosec\\\\b|coding[:=]|[A-Za-z][\\\\w-]*-ok:)\",re.I)\ndef src(ref,path):\n return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef strip_docs(tree,allowed,required):\n seen=set()\n def visit(node,prefix):\n  if isinstance(node,ast.Module):\n   name=\"<module>\"; child_prefix=prefix\n  elif isinstance(node,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n   name=\".\".join((*prefix,node.name)); child_prefix=(*prefix,node.name)\n  else:\n   for child in ast.iter_child_nodes(node): visit(child,prefix)\n   return\n  if name in allowed and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n   node.body.pop(0); seen.add(name)\n  for child in ast.iter_child_nodes(node): visit(child,child_prefix)\n visit(tree,())\n if required: assert seen==set(allowed),f\"missing allowlisted docstrings: {sorted(set(allowed)-seen)}\"\n return tree\ndef norm(text,path,allowed,required):\n tree=strip_docs(ast.parse(text,filename=path,type_comments=True),allowed,required)\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef directives(text):\n lines=text.splitlines()\n picked=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),picked\ndef admitted(line,lines,spans):\n return any(s<=line<=e for s,e in spans) or (1<=line<=len(lines) and not lines[line-1].strip() and any(s-1<=line<=e+1 for s,e in spans))\nfor path,rule in SPEC.items():\n before=src(BASE,path); after=src(AFTER,path)\n assert norm(before,path,rule[\"docs\"],True)==norm(after,path,rule[\"docs\"],False),f\"runtime AST changed: {path}\"\n assert directives(before)==directives(after),f\"directive/shebang changed: {path}\"\n a=before.splitlines(); b=after.splitlines()\n for tag,i1,i2,j1,j2 in difflib.SequenceMatcher(a=a,b=b,autojunk=False).get_opcodes():\n  if tag==\"equal\": continue\n  if i1==i2:\n   assert any(s-1<=i1<=e for s,e in rule[\"spans\"]),f\"insertion outside allowlist: {path}:{i1+1}\"\n  else:\n   bad=[line for line in range(i1+1,i2+1) if not admitted(line,a,rule[\"spans\"])]\n   assert not bad,f\"changed base lines outside allowlist: {path}:{bad}\"\nprint(f\"immutable prose oracle PASS: {len(SPEC)} paths at {BASE} -> {AFTER}\")'","dd_id":"immutable-prose-only","dd_text":"Immutable-base AST, allowlisted-span, and directive/shebang oracle passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import json, subprocess\nexpected=set(json.loads(\"\"\"[\"tests/unit/test_engine_root_convention.py\"]\"\"\"))\nactual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nassert actual==expected,f\"changed paths differ: missing={sorted(expected-actual)} extra={sorted(actual-expected)}\"'","dd_id":"exact-leaf-paths","dd_text":"The one-commit changed-path set exactly equals file impact."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Repository comment-history hygiene passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_engine_root_convention.py","dd_id":"focused-contracts","dd_text":"Focused direct consumers of the edited prose paths pass."},{"command":"rtk git diff --check HEAD^ HEAD -- tests/unit/test_engine_root_convention.py","dd_id":"diff-integrity","dd_text":"Owned-path patch has no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete locally checkable CI contract passes before push."}]},"source_event_uuids":["4769a452-3f24-43b0-9e17-baafb3b109dc","7082151d-0b06-4a52-a914-082fb763b2de","ba2bddd2-c349-488b-80d8-b2a8ff093479","6b3a23b2-25ca-4f43-99ef-1587290ec041","f41b4a59-9c6b-4f45-b219-3591d835bd97"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788645552540998001,"uuid":"1622c831-8280-4ed6-951f-7bc148de1848"}