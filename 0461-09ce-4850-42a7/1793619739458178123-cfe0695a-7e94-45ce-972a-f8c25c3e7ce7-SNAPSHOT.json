11976-0383d679-ecac-4276-95e1-4208f6e932d8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1253a35789a6f16a00b65bf8404cc7e9fa6a2e1c2efca0d78739baf2887c636e","event_uuid":"4878193e-14ca-4f95-8579-0fc4ff69661f","position":{"commit_sha":"1c995e68ee3bd837bf7abc48c21f98b4854cc12e","position":"1793619609161460238-4878193e-14ca-4f95-8579-0fc4ff69661f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ece3db4bacb2b76fdb87a44b535171246624781160350e2f9acfedbcb5d7dc0f","event_uuid":"5dfe8b9a-bebc-4cdc-8f01-55714b0fdab8","position":{"commit_sha":"dff0f407687b25a7bfe3d9746a02940c02f9853c","position":"1793619628992839209-5dfe8b9a-bebc-4cdc-8f01-55714b0fdab8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8e776abb0b2f2d27eef4666fee5ff0c396b53e907370fb23bf25adafa447b243","event_uuid":"a686655d-72ad-4421-bbd3-3420cb0cbacb","position":{"commit_sha":"778f35753cfd826aabfb1716158a06fee855bac9","position":"1793619714321234192-a686655d-72ad-4421-bbd3-3420cb0cbacb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5842b2984437956eb51dcfa66401008fb00a754fab3aafa1cc0c2f6c26d0799f","event_uuid":"ab1c2773-f746-4b71-84b0-d2de5d640606","position":{"commit_sha":"5ebf59b815f6c9aa73d2aacb1eea5aba18da0149","position":"1793619739458178122-ab1c2773-f746-4b71-84b0-d2de5d640606"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1793617539093759035,"creation_channel":"mcp","deps":[{"link_uuid":"e52fdea5-da24-408e-a4ae-6b57dfea8b7a","relation":"discovered_from","target_id":"2041-75d6-2a2f-4be9"}],"description":"## Context / Problem\n\n[rebar:2041-75d6-2a2f-4be9] adds an opt-in embedding retrieval tier whose vector build is an explicit `build_vectors(tracker)` in `src/rebar/similar/embedding.py`. That design is deliberate: `find_similar` calls `catch_up` inline (`src/rebar/similar/__init__.py:62`) and the create advisory calls `find_similar` (`src/rebar/_commands/recent_creates.py:196`), so anything catch-up does runs inside a user's `rebar create`. A digest-and-embed pass there would put one LLM call plus one embed per ticket on the create path.\n\nThe consequence is that nothing invokes `build_vectors` today. Until an operator calls it from Python, every live entry is unvectored, coverage is never full, and the tier permanently degrades to lexical. The capability ships unreachable from any supported surface.\n\nThere is no existing seam to hang it on: `src/rebar/_cli/_registry.py` registers no `similar` subcommand, `src/rebar/_commands/` has no similar module, and the only \"janitor\" in the tree is the snapshot-cache concept, not a general-purpose sweep.\n\n## Constraints\n\n- The build must stay off the create path. Whatever surface is added, `catch_up` still performs no digest or embedding work.\n- rebar supports diverse providers and installs with no provider at all, so the surface must exit cleanly and leave the lexical tier working when `[llm] embedding_model` is unset or the provider is absent.\n- The surface must not be reachable only through one CI system: a command or library entry point is portable, a CI-only trigger is not.\n\n## Open question for the executor\n\nWhich surface: a `rebar similar build` subcommand registered in `_registry.py` with a module under `_commands/`, a periodic sweep hung off an existing maintenance path, or both. Decide and record the choice before implementing.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[["depends_on","4e89-30b9-1666-4e53"],["depends_on","62dc-535b-5d05-421d"],["parent","4e89-30b9-1666-4e53"],["parent","62dc-535b-5d05-421d"]],"no_file_impact_reason":"","parent_id":"4e89-30b9-1666-4e53","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["complexity-reduction","discovered"],"ticket_id":"0461-09ce-4850-42a7","ticket_type":"task","title":"Expose the similar-ticket vector build on a supported surface","verify_commands":[]},"source_event_uuids":["ca2608ca-997e-4657-9a6e-2433b1e939f5","e52fdea5-da24-408e-a4ae-6b57dfea8b7a","0b89bd27-0603-4a9e-acb4-5e8c12962907","0383d679-ecac-4276-95e1-4208f6e932d8","1f4bf1d2-acf3-457e-9d6d-3bfc4ce59547","4878193e-14ca-4f95-8579-0fc4ff69661f","5dfe8b9a-bebc-4cdc-8f01-55714b0fdab8","52ee7b81-771a-4385-bd27-2a9956ff2d35","a686655d-72ad-4421-bbd3-3420cb0cbacb","ab1c2773-f746-4b71-84b0-d2de5d640606"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1793619739458178123,"uuid":"cfe0695a-7e94-45ce-972a-f8c25c3e7ce7"}