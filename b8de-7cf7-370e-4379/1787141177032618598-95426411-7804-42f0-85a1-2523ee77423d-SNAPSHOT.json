{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787141177032618598,"compiled_state":{"alias":"chartreuse-interested-viper","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"d7d759430583793033a070d36d13b5b8e657e7a3","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: b8de-7cf7-370e-4379","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (d7d7594305)","material: 5db6418fd2ee2f45","verified-at-sha:d7d759430583793033a070d36d13b5b8e657e7a3"],"material_fingerprint":"5db6418fd2ee2f45","merged_log_commit":"d7d759430583793033a070d36d13b5b8e657e7a3","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787133581829776000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"a019eba7223dc466046e17dd7eb3f454ee422242c37a6a18cd2b6a5fd4ffb582","event_uuid":"fc2fab61-7d2a-486e-8e96-61f395589b52","position":{"commit_sha":"d5043bb22caedad301d44f0b51855928077a1cbd","position":"1787123990907176001-fc2fab61-7d2a-486e-8e96-61f395589b52"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ed477808b671e84c237c5bc67438a359feafbc8fa39196ec8a4671b78a9b1c1e","event_uuid":"94f373