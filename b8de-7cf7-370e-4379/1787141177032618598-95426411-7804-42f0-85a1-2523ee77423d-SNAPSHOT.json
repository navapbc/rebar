oadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f42883c10e5268d095d404ea23dec88fe08beded646079385eb677eeee55de1e","event_uuid":"3d64fa07-63e9-4b79-ae8b-e2c70cb0e97a","position":{"commit_sha":"07708b2cf08e76f60948d5452a8a35c25a32acf9","position":"1787133620296207001-3d64fa07-63e9-4b79-ae8b-e2c70cb0e97a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented fix: dispatcher now recognizes --help/-h in any position before a -- terminator (new _wants_help scan in src/rebar/_cli/__init__.py), so 'create task --help' prints usage and writes nothing. Added regression test tests/interfaces/contracts/test_create_help_no_write_b8de.py (6 cases: repro, position parity for -h/help-after-title/edit --help, ordinary-create-still-writes). make lint + typecheck + complexity baseline all clean. Pushed Gerrit change 1897 (commit bf0afa4d16, trailer b8de-7cf7-370e-4379). Awaiting LLM-Review +1 and Verified +1.","timestamp":1787124401651248001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Patchset 2 CI caught a regression: the any-position help scan wrongly intercepted 'bridge preview --help' (nested-dispatch family owns its children's help) and broke 'bridge --help' == 'help bridge' parity. Fixed with a family-aware _help_requested(sub, rest): bridge* honor only a LEADING --help (child flags reach bridge_cli), all other commands scan any position before a -- terminator. Added unit coverage (_wants_help + _help_requested param tests). Verified locally: full tests/interfaces/facades+contracts help/dispatch set 362 passed, test_cli_argparse parity + bridge heldout green, lint/typecheck/complexity clean. Pushed patchset 3 to Gerrit 1897.","timestamp":1787131013438324001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Closed (preexisting). Landed via Gerrit change 1897 patchset 3 -> merged as d7d7594305 on origin/main (LLM-Review +1 AND Verified +1, submitted). Fix: _cli.main now serves --help/-h in any position before a -- terminator for leaf commands (fixing the create task --help placeholder write), with a family-aware _help_requested wrapper that preserves the bridge group's nested help (bridge --help == help bridge; bridge preview --help -> preview usage). Regression + unit tests added. Two CI-caught regressions (bridge nested help + sub-help/help-sub parity) were fixed before landing.","timestamp":1787133620296207001}],"created_at":1787115283063139001,"creation_channel":"cli","deps":[{"link_uuid":"df651811-617d-4e89-bdd1-6d0f1905447c","relation":"relates_to","target_id":"fd48-7a80-33e9-4400"},{"link_uuid":"66ed08c7-cb19-4541-9be2-11c8c52e474c","relation":"relates_to","target_id":"c311-6f5e-9227-41a1"},{"link_uuid":"960fdd14-5981-4e0d-bfd2-236deb40186f","relation":"relates_to","target_id":"5bea-deb3-3fc9-4b7e"},{"link_uuid":"67412d0c-35d9-465b-8295-0c8fe01fff96","relation":"relates_to","target_id":"270a-e486-5f12-47cf"}],"description":"## Report (from a rebar client)\nA Rebar CLI quirk treated `create task --help` as a literal task and created an accidental placeholder ticket.\n\n## Observed\nRunning `rebar create task --help` (an attempt to view help for the create-task command) does NOT print help — instead the parser consumes `--help` as the positional title argument, so a ticket titled `--help` (a placeholder) is actually CREATED.\n\n## Expected\n`create task --help` (and `--help`/`-h` on any create subcommand) should print the command's usage/help and create NOTHING. Help must never be interpreted as ticket content.\n\n## Impact\nAccidental placeholder tickets pollute the store and require cleanup; the write side-effect on a help request is surprising and violates least-astonishment.\n\n## Notes / possible cause\nThe create command path likely reads the first positional as the title before any --help interception. Compare with the argparse standardization landed for the write commands (claim/transition, ticket fd48-7a80-33e9-4400): --help there is served byte-exact by the top-level dispatcher and never reaches the handler. The create path may bypass that dispatcher help interception, or accept a bare positional that swallows `--help`. Needs repro + root-cause.\n\n## Repro\n1. `rebar create task --help`\n2. Observe: no help text; a new ticket titled `--help` is created (verify via `rebar list`).\n\n## Confirmed root cause\n`rebar._cli.main` only treats `--help`/`-h` as a help request when it is the FIRST\ntoken after the subcommand (`rest[0]`): the guard is\n`if rest and rest[0] in (\"--help\", \"-h\") and sub not in _HIDDEN_ALIASES:`. For\n`create task --help`, `rest == [\"task\", \"--help\"]`, so `rest[0] == \"task\"` and the guard\nis skipped; dispatch falls through to `composer.create_cli`, whose hand-rolled parser\nreads `rest[0]` as the ticket type and `rest[1]` (`--help`) as the title, then performs\nthe CREATE write. The commands that \"own\" their `--help` (review-plan, workflow, audit, …)\nare intercepted earlier and are unaffected; the bug hits the fall-through write commands.\n\n## Fix\nIn `rebar._cli.main`, recognise `--help`/`-h` appearing ANYWHERE in `rest` before a `--`\nterminator (not only at `rest[0]`) as a help request for a routable subcommand, matching\nargparse semantics (help short-circuits regardless of position). A `_wants_help(rest)`\nhelper scans `rest`, stopping at `--`. A `_help_requested(sub, rest)` wrapper makes this\nfamily-aware: nested-dispatch families (the `bridge` group) own their children's help, so\nthey honour only a LEADING `--help`/`-h` (a later flag belongs to a child such as\n`bridge preview --help`, served by `bridge_cli`) — keeping `bridge --help` identical to\n`help bridge`. Every other command uses the any-position scan. `_HIDDEN_ALIASES` stays\nexcluded and the earlier own-their-help intercepts are untouched. Help serves the\nbyte-exact pinned usage via the existing `_emit_subcommand_help(sub)` and performs NO write.\n\n## Testing\n- Regression: `main([\"create\", \"task\", \"--help\"])` returns 0, prints the create usage to\n  stdout, and creates NO ticket (store unchanged).\n- Position parity: `-h` in a later position and `--help` after a title are also honoured.\n- `_wants_help`/`_help_requested` unit contracts: any-position scan for leaf commands,\n  leading-only for the `bridge` family, `--` terminator respected.\n- Unchanged: `rebar create task \"real title\"` still creates; `bridge --help` == `help\n  bridge`; `bridge preview --help` shows preview usage; unknown subcommand still errors.\n\n## Acceptance Criteria\n- [x] `rebar create task --help` prints the create usage (exit 0) and creates NO ticket.\n- [x] `--help`/`-h` anywhere before a `--` terminator triggers subcommand help for routable\n      write commands (create/edit/comment/link/…), not just at `rest[0]`.\n- [x] The `bridge` nested-dispatch family keeps its own help: `bridge --help` equals\n      `help bridge` and `bridge preview --help` shows preview usage.\n- [x] Commands that own their own `--help` and unknown-subcommand handling are unchanged.\n- [x] A regression test (tests/interfaces/contracts/test_create_help_no_write_b8de.py)\n      covers the no-write help behavior and the `_wants_help`/`_help_requested` contracts;\n      bridge parity is covered by tests/interfaces/facades/test_cli_argparse.py and\n      test_bridge_cli_heldout.py.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/__init__.py","reason":"recognise --help/-h anywhere before -- as a help request in main()"},{"path":"tests/interfaces/contracts/test_create_help_no_write_b8de.py","reason":"regression test: create task --help shows usage and writes nothing"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","270a-e486-5f12-47cf"],["relates_to","5bea-deb3-3fc9-4b7e"],["relates_to","c311-6f5e-9227-41a1"],["relates_to","fd48-7a80-33e9-4400"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"975d62ef-8786-4da7-85df-11a58afe9137","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"b8de-7cf7-370e-4379","ticket_type":"bug","title":"create task --help treated as a literal task title, creating an accidental placeholder ticket","verify_commands":[]},"source_event_uuids":["fc2fab61-7d2a-486e-8e96-61f395589b52","94f373af-ab2e-4951-99cd-91b59899e5e5","f571ebe9-c99b-4533-bebb-9a8fe94a0bb2","41a8238b-b854-4e5a-9758-f9f49f9c6e4f","ce7522da-d1ee-4198-9cd6-2d7bff37e452","66ed08c7-cb19-4541-9be2-11c8c52e474c","960fdd14-5981-4e0d-bfd2-236deb40186f","4f6ed45b-1297-4308-9c19-deb96f50d40c","67412d0c-35d9-465b-8295-0c8fe01fff96","cbb7ccaa-9adb-469e-99fe-1d3d741916d0","975d62ef-8786-4da7-85df-11a58afe9137","6d3792e5-9f47-409e-8154-08799b1e1bbe","3d64fa07-63e9-4b79-ae8b-e2c70cb0e97a"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787141177032618598,"uuid":"95426411-7804-42f0-85a1-2523ee77423d"}