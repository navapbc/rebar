{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"1b1f945f7a46e377d1b461a21d00dbd8cc55e5dd54391ea8e943b3e7d2dfb1fd","digest":{"component_or_area":"LLM structured output parser","key_entities":["_candidate_dicts","_select_and_validate","_all_json_objects","parse_structured","rebar.llm.structured","src/rebar/llm/structured.py","tests/unit/test_structured.py","tests/unit/test_pai_output.py"],"problem_keywords":["structured output","duplicate candidates","false ambiguity warning","JSON parsing","Pydantic validation"],"propositions":["A single exact JSON object is decoded twice into _candidate_dicts — once from _all_json_objects and once from whole-text json.loads — causing parser-generated duplication.","Identity checks on separately constructed but semantically equal Pydantic instances incorrectly trigger multiple-candidate validation warnings for ordinary native structured replies.","Deduplication of equal decoded dicts in discovery order before validation eliminates false ambiguity warnings while preserving last-valid-wins behavior for genuinely distinct candidates.","The fix reduces false identical warnings without affecting valid repair, sentinel, schema filtering, or adapter integration."]},"digest_hash_version":1,"model":"claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1787348131891955915,"uuid":"394e7606-aef0-43f0-bd08-f4ca239d57e7"}