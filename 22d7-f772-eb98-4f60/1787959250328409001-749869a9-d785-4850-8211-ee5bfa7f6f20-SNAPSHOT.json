yid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6ebe41c014d2abb6536526b748edf6f5d1a8b16108434be0f98b558e15df4be0","event_uuid":"74e4a749-4f1e-4496-89a3-b4b1badae255","position":{"commit_sha":"9156468713bb93cda92d38d5082ad1f573fea9a2","position":"1787951230047193415-74e4a749-4f1e-4496-89a3-b4b1badae255"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"95d06dd26b967bd0ce6870156a22a9e2eccf711eb5fe49adb0b1f21fd00ef8bb","event_uuid":"e19cbd71-0bf5-4967-a5d4-7650df4d8e9f","position":{"commit_sha":"8ac5599e77db231dbd8d38e08f3032ca939dcf91","position":"1787951312614588843-e19cbd71-0bf5-4967-a5d4-7650df4d8e9f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"01317a57c6b3b5ee62df1944ffb9cbdd85fae89df83c8d77224a5eb87f584566","event_uuid":"1b71e239-5d79-4bd0-8061-c3ec2b33065e","position":{"commit_sha":"ff57441af12fc0e2505bbf771f1245b5499546ed","position":"1787951384505630440-1b71e239-5d79-4bd0-8061-c3ec2b33065e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e962a274068df1e9d54d6cf61d20e745b4c9fdee2bdfcd533b1ba837bfc58a2c","event_uuid":"920a9086-c1e5-4902-b6a9-149dc20fd311","position":{"commit_sha":"eb5d20195a0e7691d09e9f364302a19793225513","position":"1787951546789688666-920a9086-c1e5-4902-b6a9-149dc20fd311"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"36467bab985a4362ef5cde5e98494de0c58d6357a17955ba536411d