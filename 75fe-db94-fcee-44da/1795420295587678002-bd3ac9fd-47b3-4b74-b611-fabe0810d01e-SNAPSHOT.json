g","rebar-version: 0.16.0 (c924c0ea2e8)","regver: aa61189569d34126","verified-at-sha:c924c0ea2e8239df79527cc2cbf54135674f5aed","dep 1bffc460b4b67e91d8391219e7bb39cc284c41737486dabf1dcec2348fbf578d src/rebar/_cli/_init.py","dep b232de495c27493af134affb5ba3289df0d639d4cafb642056d3f90077caae6d src/rebar/_commands/init.py","dep b1d5c137158648d5af5d97a813d8567340ee0b4de3b7fcb9149f1e247e9f88d3 tests/unit/test_ensure_git_timeout.py","dep absent tests/unit/test_init_bootstrap_timeout.py","read-set: 17","read-path: .github/mechanism-baseline.json","read-path: scripts/check_raw_git_writes.py","read-path: src/rebar/_cli/_init.py","read-path: src/rebar/_commands/_init_ensures.py","read-path: src/rebar/_commands/_init_probe.py","read-path: src/rebar/_commands/init.py","read-path: src/rebar/_lib_writes.py","read-path: src/rebar/_store/ensures.py","read-path: src/rebar/_store/env_identity.py","read-path: src/rebar/_store/git_outcome.py","read-path: src/rebar/_store/gitutil.py","read-path: tests/integration/test_init_fail_closed.py","read-path: tests/integration/test_s3_preflight.py","read-path: tests/unit/test_ensure_git_timeout.py","read-path: tests/unit/test_git_timeout_bounds_983f.py","read-path: tests/unit/test_init_attach_predicate.py","read-path: tests/unit/test_sync_remote_config.py","currency-basis: file_impact"],"material_fingerprint":"61857c1c8b863130","merged_log_commit":"c924c0ea2e8239df79527cc2cbf54135674f5aed","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1795414019888757000}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":0},"authorship_ledger":[{"content_hash":"a4e01420e63d927df4771313859a5ea08b518653b96d688cb0b24c122ec8a20b","event_uuid":"67e1e11e-c5ff-4b55-99d5-9a9447a805be","position":{"commit_sha":"6c7f7f0d17b66ebe39b9393d670ff502bc662029","position":"1795413179079488001-67e1e11e-c5ff-4b55-99d5-9a9447a805be"},"signature":"{\"payload\":