d-34e7-4030-9453-4240980429d6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f52397f866e8959fe162a5012bde2f300f509e006cbaf27e482ab823244b8e08","event_uuid":"0af15913-71ea-441c-81b4-df490b7119b8","position":{"commit_sha":"dbf374dea812015bed668748859c041ec3121b45","position":"1788802385325472001-0af15913-71ea-441c-81b4-df490b7119b8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"76bdeea3abc980196db48aecd5e9f9f3f73bccbdce534fbda28a1050c8b6463b","event_uuid":"582f5c75-9073-4721-aa8b-209dc0f0fdb1","position":{"commit_sha":"bc2e1bb77a52d96f01681660d8e367966beb9a23","position":"1788802752366633001-582f5c75-9073-4721-aa8b-209dc0f0fdb1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"baf1f4c913e169356cdb0db334d0e249ae0aaee23acd0c901106e8e3f544ebbd","event_uuid":"4451696f-1701-4698-b524-fa5233b3bbf5","position":{"commit_sha":"e1ed98496a79447f8d026dd8c78832763712c475","position":"1788802763448217001-4451696f-1701-4698-b524-fa5233b3bbf5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"The full metric-vs-alarm sweep this ticket's last AC asks for — done, so the fix does not have to\nstart by re-deriving it. Measured live against CloudWatch.\n\n**41 `rebar/host` metrics; 21 alarmed; 20 unalarmed.** The 20 are not equally interesting, and\nlumping them together would overstate the problem. Dispositions:\n\n## Genuinely missing — health/liveness booleans with no alarm (the subject of this ticket)\n\n- `gerrit_healthy` — as filed.\n- `reviewbot_healthy` — as filed.\n- `mem_probe_ok` — a probe-SUCCESS boolean. Same shape as the two above: if the memory probe\n  stops working, nothing pages, and the memory gauges beside it simply stop arriving.\n- `container_stats_ok` — same shape, for the container-stats collector.\n\nThese four are one class: a boolean whose whole purpose is to say \"the measurement happened\", with\nnothing watching it. A dead probe is indistinguishable from a healthy quiet period.\n\n## Worth a deliberate decision, not obviously wrong\n\n- `disk_pressure_persists` — reads as a CONDITION (pressure did not clear after pruning) rather\n  than a probe heartbeat. If that is right it is a candidate for its own alarm; if it is an\n  activity counter, it belongs in the group below. Decide explicitly.\n- `mem_used_percent` / `mem_available_percent` — there is currently **no alarm on memory\n  utilisation at all** on this host. `mcp_mem_abort` IS alarmed, so the consequence of exhaustion\n  is watched while the approach to it is not. That may be deliberate (abort is the actionable\n  event); record the reasoning either way.\n\n## Reasonably unalarmed — raw gauges whose derived sibling IS alarmed\n\n`docker_buildkit_cache_bytes`, `docker_storage_bytes`, `journal_bytes` — each has a\n`*_used_percent` sibling carrying the alarm. Alarming both would double-page.\n\n## Reasonably unalarmed — cost/activity telemetry, not health\n\n`review_bot_llm_{input,output,total,cache_read,cache_write}_tokens`, `container_memory_rss_bytes`,\n`container_stats_unparsed_rows`, `deploy_deferrals`, `disk_pressure_prunes`, `review_interrupts`\n(its `review_interrupts_bound_exceeded` sibling is alarmed).\n\n## A warning for whoever implements this\n\nDo NOT land a guard test asserting \"every liveness metric has an alarm\" BEFORE or separately from\nthe alarms themselves. Such a test fails immediately against current `main` — four metrics are\nunalarmed right now — and a red gate on `main` blocks every concurrent session. The test and the\nterraform must land together, or the test must start scoped to what is already true and be widened\nin the same change that widens the alarms.","timestamp":1788585505579837001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator decision 2026-09-06: alarm work APPROVED — mirror existing alarm best practices in this environment; every alarm must provide meaningful health signal, not noise.","timestamp":1788761574945837001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: plan review passed. Operator ruling already recorded. Proceeding to isolated worktree implementation for gerrit_healthy/reviewbot_healthy alarm coverage; advisory P6/P9 noted and will be addressed in implementation evidence/file impact.","timestamp":1788793069668946001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: RED-first guard added for liveness heartbeats; initial run failed because gerrit_healthy, reviewbot_healthy, mem_probe_ok, and container_stats_ok had no alarms. Implemented Profile A 6-of-6/30min alarms with breaching missing-data and shared SNS wiring; targeted alarm guard/window tests now pass.","timestamp":1788793314563241001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress: pushed Gerrit change 2790 (Add host liveness alarms). Local evidence: RED guard failed on missing liveness alarms, then targeted alarm guard/window tests passed; terraform fmt/validate passed; terraform plan envelope creates the four expected alarms and also shows a pre-existing aws_instance.gerrit user_data drift item that will not be applied with this change unless traced.","timestamp":1788795520934348001}],"completion_expectation":"required","created_at":1788578545805311001,"creation_channel":"cli","deps":[{"link_uuid":"0d200d7d-34e7-4030-9453-4240980429d6","relation":"relates_to","target_id":"1f2b-2303-bbcb-44e9"}],"description":"## The gap\n\n`rebar/host` publishes three liveness heartbeats — `gerrit_healthy`, `reviewbot_healthy`,\n`mcp_healthy` — and **`gerrit_healthy` and `reviewbot_healthy` have NO CloudWatch alarm at all.**\n\nVerified directly:\n\n```\naws cloudwatch describe-alarms \\\n  --query 'MetricAlarms[?MetricName==`gerrit_healthy`||MetricName==`reviewbot_healthy`]'\n-> (empty)\n```\n\nTwenty-two `rebar/host` alarms exist, covering disk, docker storage, journal, memory-abort,\nbuildkit cache, gate scratch, bridge failures, voter errors, replication and mirror sync. The two\nsignals that answer \"is the review system alive at all\" are published, look reassuring on a\ndashboard, and are watched by nobody.\n\n## Observed cost, 2026-09-05\n\nDuring a real Gerrit degradation that failed the checkout step of THREE changes with HTTP 504\n(`ergophobic-harassed-peacock`, `1e24-bfc0-5f70-4ea4`), `gerrit_healthy` published **nothing for\nover 30 minutes** while `mem_used_percent` from the same probe tick published normally. So the\nprobe was alive and its Gerrit health check specifically could not complete — exactly the\ncondition worth paging on — and nothing fired.\n\nThe degradation was found by a human reading CI failure logs and correlating them by hand. The\nmetric that would have named it directly sat unwatched.\n\n## Why silence here is the dangerous direction\n\nThese are heartbeats: `1` means healthy, and the interesting state is ABSENCE. An unalarmed\nheartbeat is strictly worse than no heartbeat, because it creates the appearance of coverage. It is\nthe same shape this project has already fixed elsewhere — `bff5-9163` established that every\n`rebar/host` alarm must treat missing data as `breaching` precisely so a dead publisher pages\ninstead of reading as healthy. That work fixed the alarms that EXIST. It could not fix a metric\nthat has no alarm at all, and this is the residue.\n\nNote the asymmetry with `mcp_healthy`: also unalarmed here, but the MCP has adjacent coverage\n(`mcp_retire_cap`, `mcp_mem_abort`). Gerrit and the review bot have no such proxy — if they stop,\nthe only signal is that changes stop moving, which is indistinguishable from a quiet night.\n\n## Acceptance criteria\n\n- [x] `gerrit_healthy` and `reviewbot_healthy` each have an alarm that fires on missing data\n      (`treat_missing_data = \"breaching\"`) and on an unhealthy value, SNS-wired like the others.\n- [x] The windows are wide enough not to flap on a single missed probe tick, and that is proven by\n      replaying each metric's own recorded series against the proposed configuration — the method\n      `bff5-9163` AC2 established, not by waiting a day to see.\n- [x] The guard test in `tests/unit/test_alarm_actions_terraform.py` is extended so that a\n      `rebar/host` metric which is a LIVENESS HEARTBEAT cannot exist without an alarm. Today's\n      guard checks that alarms which exist are correct; it cannot notice a metric nobody watches.\n      Proven by deliberately adding a heartbeat metric with no alarm and seeing the test fail.\n- [x] The full `rebar/host` metric list is swept once against the alarm list, and every unalarmed\n      metric is either given an alarm or recorded with a reason. Enumerate the result — do not fix\n      only the two named here.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/terraform/monitoring_4b6e.tf","reason":"Adds CloudWatch alarms for the liveness heartbeats approved by the ticket."},{"path":"tests/unit/test_alarm_actions_terraform.py","reason":"Pins that liveness heartbeats published by observability.sh have SNS-wired breaching alarms."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","1f2b-2303-bbcb-44e9"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"582f5c75-9073-4721-aa8b-209dc0f0fdb1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"4b6e-1090-f339-48f8","ticket_type":"bug","title":"gerrit_healthy and reviewbot_healthy have NO alarm at all: gerrit_healthy went dark for 30+ minutes during a real degradation that blocked every landing, and nothing fired","verify_commands":[]},"source_event_uuids":["91d68ba7-b11a-46e0-8e1f-35986c219578","67961977-32d8-40af-b43e-a3722f3ce258","c6b2e1db-0e99-405f-9582-3b950a65b0cd","78a52292-b45d-4a45-9496-3fd82a0caaa3","cb121f88-8a06-48fc-8979-2aecb61d71c9","1671e60d-5cf5-4fc1-94b9-d590a8d64cb1","ac046186-ba7e-47f1-beca-61dbe7342fbe","2a7d0702-204e-4d17-8fe5-c93efe1b5d5f","9829af3c-709f-4374-b511-f66da0f209b7","0d200d7d-34e7-4030-9453-4240980429d6","0af15913-71ea-441c-81b4-df490b7119b8","582f5c75-9073-4721-aa8b-209dc0f0fdb1","4451696f-1701-4698-b524-fa5233b3bbf5"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788804994109143666,"uuid":"8797d72d-f030-404c-b2d1-330c61231ebb"}