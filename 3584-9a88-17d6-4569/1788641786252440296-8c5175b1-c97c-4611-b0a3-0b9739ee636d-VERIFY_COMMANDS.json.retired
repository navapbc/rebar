osition<0:\n            continue\n        comment=line[position:]\n        if not PATTERN.match(comment):\n            continue\n        left=line[:position].rstrip()\n        anchor=(\"inline\",left.strip()) if left else (\"next\",next_anchor(lines,row))\n        found.append((comment,anchor))\n    return found\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    check=python_signatures if path.endswith(\".py\") else text_signatures\n    if check(source(base,path))!=check(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \"+path)' 'src/rebar/_engine/rebar_reconciler/adapters/jira_family/wiki_render.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/acli_graph.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/acli_subprocess.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/adf.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/comment_limits.py' 'src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py' 'src/rebar/_engine/rebar_reconciler/applier.py' 'src/rebar/_engine/rebar_reconciler/apply_handlers.py' 'src/rebar/_engine/rebar_reconciler/apply_inbound_events.py' 'src/rebar/_engine/rebar_reconciler/apply_inbound_records.py' 'src/rebar/_engine/rebar_reconciler/apply_inbound.py' 'src/rebar/_engine/rebar_reconciler/apply_planning.py' 'src/rebar/_engine/rebar_reconciler/batch_dispatch.py' 'src/rebar/_engine/rebar_reconciler/binding_lifecycle.py' 'src/rebar/_engine/rebar_reconciler/binding_recovery.py' 'src/rebar/_engine/rebar_reconciler/binding_repository.py'","dd_id":"directives","dd_text":"Directive text and attachment remain exact on every owned path."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\