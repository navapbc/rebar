{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, pathlib, subprocess, sys\nB=\"7840899ea7ac0609bf3e0dec5e26effdbda1ec6c\"\ndef norm(source):\n t=ast.parse(source,type_comments=True)\n for n in ast.walk(t):\n  if isinstance(n,(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)) and n.body:\n   first=n.body[0]\n   if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n    first.value.value=\"\"\n for n in t.type_ignores: n.lineno=0\n return ast.dump(t,include_attributes=False)\nfor p in sys.argv[1:]:\n old=subprocess.check_output([\"git\",\"show\",f\"{B}:{p}\"],text=True)\n assert norm(old)==norm(pathlib.Path(p).read_text()),p\nprint(\"runtime AST unchanged\",len(sys.argv)-1)' 'src/rebar/reconciler/adapters/jira_family/wiki_render.py' 'src/rebar/reconciler/adapters/jira/acli_cli_ops.py' 'src/rebar/reconciler/adapters/jira/acli_graph.py' 'src/rebar/reconciler/adapters/jira/acli_subprocess.py' 'src/rebar/reconciler/adapters/jira/acli.py' 'src/rebar/reconciler/adapters/jira/adf.py' 'src/rebar/reconciler/adapters/jira/comment_limits.py' 'src/rebar/reconciler/adapters/jira/outbound_fields.py' 'src/rebar/reconciler/applier.py' 'src/rebar/reconciler/apply_handlers.py' 'src/rebar/reconciler/apply_inbound_events.py' 'src/rebar/reconciler/apply_inbound_records.py' 'src/rebar/reconciler/apply_inbound.py' 'src/rebar/reconciler/apply_planning.py' 'src/rebar/reconciler/batch_dispatch.py' 'src/rebar/reconciler/binding_lifecycle.py' 'src/rebar/reconciler/binding_recovery.py' 'src/rebar/reconciler/binding_repository.py'","dd_id":"semantic","dd_text":"Runtime AST matches the current edit base after removing docstrings; per-block review checks the prose allowlist."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, pathlib, re, subprocess, sys, tokenize\nB=\"7840899ea7ac0609bf3e0dec5e26effdbda1ec6c\"\ndef directives(source):\n lines=source.splitlines()\n out=[]\n for t in tokenize.generate_tokens(io.StringIO(source).readline):\n  if t.type!=tokenize.COMMENT: continue\n  if not re.search(r\"^#!|noqa|type:\\s*ignore|fmt:|ruff:|pragma:|nosec|pyright:\",t.string): continue\n  following=next((s.strip() for s in lines[t.start[0]:] if s.strip() and not s.lstrip().startswith(\"#\")),\"\")\n  out.append((t.string,following))\n return out\nfor p in sys.argv[1:]:\n old=subprocess.check_output([\"git\",\"show\",f\"{B}:{p}\"],text=True)\n assert directives(old)==directives(pathlib.Path(p).read_text()),p\nprint(\"directives and following code unchanged\",len(sys.argv)-1)' 'src/rebar/reconciler/adapters/jira_family/wiki_render.py' 'src/rebar/reconciler/adapters/jira/acli_cli_ops.py' 'src/rebar/reconciler/adapters/jira/acli_graph.py' 'src/rebar/reconciler/adapters/jira/acli_subprocess.py' 'src/rebar/reconciler/adapters/jira/acli.py' 'src/rebar/reconciler/adapters/jira/adf.py' 'src/rebar/reconciler/adapters/jira/comment_limits.py' 'src/rebar/reconciler/adapters/jira/outbound_fields.py' 'src/rebar/reconciler/applier.py' 'src/rebar/reconciler/apply_handlers.py' 'src/rebar/reconciler/apply_inbound_events.py' 'src/rebar/reconciler/apply_inbound_records.py' 'src/rebar/reconciler/apply_inbound.py' 'src/rebar/reconciler/apply_planning.py' 'src/rebar/reconciler/batch_dispatch.py' 'src/rebar/reconciler/binding_lifecycle.py' 'src/rebar/reconciler/binding_recovery.py' 'src/rebar/reconciler/binding_repository.py'","dd_id":"directives","dd_text":"Protected directives and their following code remain exact against the current edit base."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess,sys\nB=\"7840899ea7ac0609bf3e0dec5e26effdbda