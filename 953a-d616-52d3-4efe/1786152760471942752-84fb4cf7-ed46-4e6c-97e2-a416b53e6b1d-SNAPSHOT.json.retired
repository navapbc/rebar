{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786152760471942752,"compiled_state":{"alias":"meagre-grassgreen-waterdogs","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"0f0a05134f87b17c48c401cc684ff696d0520bcc","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 953a-d616-52d3-4efe","material: 47b392979e15c20b","material-part: children 647ea2107ca5072f 0","material-part: description c042a088e659df25 7907","material-part: file_impact 0f440c2a06f253cf 8","material-part: ticket_id 7afb3235ecbc9383 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (0f0a05134f)","regver: 368938c5729d4170","verified-at-sha:4c89592d88c7158d7ba327be2baf81583c3e4adb","dep eb26532f6f69c6cf4d843e83dffce037954ceb02cdd281ad8fe7b51339d42baf docs/concurrency.md","dep ce1449572592553d465065611fe17e008fac36d59388244328f806fb0e49685a src/rebar/_store/push.py","dep e7fdd58ec254719c0282e22a5d856010c1733d105946131f4c3f50bc384c8f2d tests/integration/test_epoch_guard_reconciliation.py","dep absent tests/interfaces/store/test_push_contention.py","dep 18a5bdf32b0f2f38cbbbd72f395c8ef449942f0999ea1d5467cbebf378ab0e86 tests/unit/test_epoch_guard_matrix.py","dep 40f3f156611aa04ddd639e7478d1b7b0bf3fab4d5bc77b33ac63ed3912953c16 tests/unit/test_push_rejection_surfacing.py","dep 7155852a897bb1afe1373d16e50c2ffb8cf247aa27e4c9563cea0377a2a1f6b0 tests/unit/test_push_retry_stash_pop.py","dep absent tests/unit/test_push_strict.py"],"material_fingerprint":"47b392979e15c20b","merged_log_commit":"4c89592d88c7158d7ba327be2baf81583c3e4adb","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1786147038073070000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":18,"unsigned":2},"authorship_ledger":[{"content_hash":"5cb2b98a8105dad1100a306d9bda0abd51070cf7bb87f19af9931ac29239fe49","event_uuid":"af0f8c7b-350d-4514-a59a-1ae989f87029","position":{"commit_sha":"6abf76026b05d7df68515ad8e82c18c7c1bd4753","position":"1786142401705629001-af0f8c7b-350d-4514-a59a-1ae989f87029"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dcae7472dbcac6a027907b9437f4e9b240038a8eefbd66d5de283d7a0b407c14","event_uuid":"058a19af-56b2-439b-8cbd-8d6125905554","position":{"commit_sha":"0916095fa479d3733c45b1d72a7b8e2417d014ef","position":"1786142445041609001-058a19af-56b2-439b-8cbd-8d6125905554"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3b0251a04e0c8e92f7a6f8b08a8fde309d42a8835f96a0c7b18ec548cf9d4568","event_uuid":"4a9db383-4aa4-43e6-a063-73062398138d","position":{"commit_sha":"13b6ddf1ce3337bf292cd09162de1ba9c5d29b1e","position":"1786142716832225001-4a9db383-4aa4-43e6-a063-73062398138d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhI