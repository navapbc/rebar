{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"cd9fba59b6ee1db3adebb3cdfacd4415b94500f63036fd81387e534e1f6e1c2f","digest":{"component_or_area":"LLM failure resolution messaging","key_entities":["message_for","CHANGE_INPUT","RESOLUTION_MESSAGES","finish_reason","content_filter","src/rebar/llm/failure.py","src/rebar/_cli/_llm_commands.py","src/rebar/_commands/close_precheck.py","ResolutionClass","CONTENT_FILTER_MESSAGE"],"problem_keywords":["content filter","guardrail","misleading message","operator message","resolution message"],"propositions":["When an LLM call is blocked by a content policy (Bedrock Guardrail or Anthropic refusal), the operator message incorrectly reports 'too large / malformed' instead of naming the actual content policy block.","The message_for() function must be refactored to accept an optional finish_reason parameter and return a distinct message when resolution_class is CHANGE_INPUT and finish_reason is 'content_filter'.","Non-content-filter CHANGE_INPUT cases (e.g., HTTP 413 payload-too-large) must continue to return the generic size/malformed message.","The resolution_class, retryable flag, and exit-code mapping must remain unchanged; only the operator-facing message text is refined."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787496575937978001,"uuid":"d94caeca-0f98-4f01-bfde-24be985636b3"}