{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"cd9fba59b6ee1db3adebb3cdfacd4415b94500f63036fd81387e534e1f6e1c2f","digest":{"component_or_area":"LLM failure reporting and messaging","key_entities":["message_for","CHANGE_INPUT","ResolutionClass","finish_reason","content_filter","RESOLUTION_MESSAGES","CONTENT_FILTER_MESSAGE","src/rebar/llm/failure.py","src/rebar/_cli/_llm_commands.py","src/rebar/_commands/close_precheck.py","LLMOutcome.diagnostic"],"problem_keywords":["content filter","guardrail","misleading message","operator message","finish reason"],"propositions":["When an LLM call is blocked by a content policy (Bedrock Guardrail or model refusal), the operator message incorrectly says 'too large / malformed' instead of naming the actual cause.","The message_for() function should accept an optional finish_reason parameter and return a content-filter-specific message when resolution_class is CHANGE_INPUT and finish_reason is 'content_filter'.","Non-content-filter CHANGE_INPUT cases (e.g., HTTP 413) must continue to display the existing generic message.","The finish_reason value is available on LLMOutcome.diagnostic and persisted coverage diagnostic and must be threaded through all render sites."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787525670041252001,"uuid":"281e2e02-a05a-45d3-9d99-bac897d28203"}