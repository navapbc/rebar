6265-2a7973af-b2e7-43c5-8cc6-d2bb7e0225a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4fd1c3d531e4c80825c3bc099f0b53298546aef67c9cec46ab6298f2ef2babb3","event_uuid":"afa460f0-ea55-4566-98f2-ddbde3e0246d","position":{"commit_sha":"977aea61285927c4cb79fd98c21e3ed29a07fc29","position":"1788604674576526791-afa460f0-ea55-4566-98f2-ddbde3e0246d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"969b3aadeabf1cead2e22c037b7b2ec76b6bd43a3531feaf9f8e1f81518ccfda","event_uuid":"a1b141f6-4315-44d3-9292-30a2483c44b1","position":{"commit_sha":"43a83462e9e3b5068edc674f32cfae15d2a26297","position":"1788604937141930001-a1b141f6-4315-44d3-9292-30a2483c44b1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ee9eaf0d2465271a1c7f729a81780ca8781e2e119fad655ea7204dd15240e19f","event_uuid":"280afd6b-67b1-4e80-89c2-5e051e7d0da3","position":{"commit_sha":"9365dd08f60630d9d6ef7044a9a92ad65ab32026","position":"1788604959263820001-280afd6b-67b1-4e80-89c2-5e051e7d0da3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented with `paradoxal-unquenched-snowmonkey` (ad8d-4274-ef43-4f44) as one change, since both\nland in `infra/terraform/user_data.sh`. Rebased onto `origin/main` after change 2649 (bug d614,\n`e6b4ff07da5d`) hardened `resolve_ebs_device` in the same file; that work is intact and its tests\nstill pass.\n\n**How the asymmetry was closed.** The assertion did not get COPIED to the `/var/gerrit` call site —\nit moved INTO `mount_ebs_volume`, as a new `require_mounted`. That is deliberate: the defect was\nthat a guard living at one call site is absent from the other by default, so a third volume added\nlater would have inherited the same hole. Now every caller gets it and a call site cannot opt out.\nThe standalone `mountpoint -q` block after the gate-scratch call is gone as redundant;\n`test_gate_scratch_volume_aa40.py`'s `\"mountpoint -q\" in script` assertion still holds, because the\nstring moved rather than disappeared.\n\n- **AC1** — `require_mounted` runs after `mount -a` for both volumes and returns non-zero.\n- **AC3** — the two failures are now distinguishable by BOTH message and exit code: a genuine\n  `mount -a` error is \"mount -a reported an ERROR while mounting <mp>\" and returns 3; a silent\n  `nofail` skip is \"<mp> is NOT a mount point after a CLEAN mount -a -- its nofail fstab entry was\n  skipped silently\" and returns 4. Previously every failure printed \"could not resolve NVMe device\",\n  which was actively misleading for a mount that resolved fine and then did not take.\n- **AC2** — the oracle in `tests/unit/test_user_data_device_resolution_d614.py` (reused, not\n  duplicated) now models all three `mount -a` outcomes rather than always succeeding, `MOUNT_SKIPS=1`\n  being the real nofail-skip mode. Deleting the `ASSERT-MOUNT-TOOK` line makes the skipped mount\n  report SUCCESS again, which is the reported defect. Against `origin/main`'s script, 9 of the new\n  tests are RED.\n- **AC4** — `infra/scripts/check-mounts.sh`, invokable as `sudo infra/scripts/check-mounts.sh`.\n  Portable by construction: plain shell plus util-linux with a `/proc/mounts` fallback, no AWS API\n  calls (so it works with no credentials, mid-incident, on a host whose IMDS is unhappy) and no CI\n  provider. It distinguishes \"the directory does not exist\" from the DANGEROUS state — the\n  directory exists, so every consumer looks healthy, on root. `provision-restore.md` step 4b now\n  covers both volumes and points at it, and says plainly not to treat \"Gerrit responds\" as evidence.\n\nWhy the separate script is not redundant with the in-script assertion: `user_data.sh` runs at FIRST\nBOOT only. Every later boot re-runs `mount -a` from `/etc/fstab` with no witness at all, which is\nexactly the pending stop/start case this ticket flagged.\n\n**Live-host note, unchanged by this ticket and NOT acted on:** `nvme2n1` (`vol06780b8557d1416b7`) is\nattached raw — no filesystem, unmounted — and `/etc/fstab` has no gate-scratch line, so gate scratch\nhas been running on root. That is `renowned-corked-hapuku` (`dcc3-75ee-26ce-4840`) and is the\noperator's call. No action was taken on the running host.","timestamp":1788585053402220001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Independent AC verification against merged `0033662b5534` (\"Assert every EBS mount actually took\"),\nin a fresh worktree off `origin/main` (`git merge-base --is-ancestor 0033662b5534 HEAD` OK,\n`rebar verify-commit-ticket --rev 0033662b5534` resolves this ticket). All four boxes ticked on\nevidence; nothing was weakened to make a box tickable.\n\n- **AC1 — HOLDS.** `require_mounted` (`infra/terraform/user_data.sh`) runs `mountpoint -q \"$1\"`\n  and returns non-zero with a stderr message on failure. It is called from inside\n  `mount_ebs_volume` after `mount -a` (`# ASSERT-MOUNT-TOOK`, `return 4`), so BOTH call sites get\n  it — `/var/gerrit` and gate scratch — and the `/var/gerrit` branch now FATALs with \"volume … is\n  not in service at /var/gerrit -- refusing to run Gerrit on the ROOT filesystem\". The asymmetry\n  the ticket reported is closed by construction rather than by copying the guard.\n- **AC2 — HOLDS, and the seed is genuine.**\n  `test_a_silently_skipped_nofail_mount_is_refused` runs the shipped shell with `mount` stubbed to\n  exit 0 without mounting (`mount_mode=\"skips\"`) and asserts non-zero.\n  `test_removing_the_mount_assertion_restores_the_silent_success` drops the `ASSERT-MOUNT-TOOK`\n  line and asserts the SAME scenario returns 0 — so the guard is provably load-bearing, not\n  incidental. `test_the_gerrit_data_volume_gets_the_same_assertion_as_gate_scratch` runs the skip\n  scenario for both mount points.\n- **AC3 — HOLDS.** `test_a_genuine_mount_error_is_distinguishable_from_a_silent_skip` asserts the\n  two failures differ in BOTH exit code (3 vs 4) and stderr text (\"mount -a reported an ERROR\n  while mounting …\" vs \"… is NOT a mount point after a CLEAN mount -a -- its nofail fstab entry\n  was skipped silently\"), and that the skip wording does not leak into the error case.\n- **AC4 — HOLDS.** `infra/scripts/check-mounts.sh` exists, mode 755, defaults to\n  `/var/gerrit /var/lib/rebar/gate-scratch`. Portable by inspection: plain shell + util-linux with\n  a `/proc/mounts` fallback, no AWS API call, no CI-provider trigger — the only occurrence of\n  \"IMDS\"/\"CI\" in the file is the comment explaining that it depends on neither. It reports three\n  states (mounted / not mounted / cannot determine) and distinguishes an absent directory from the\n  dangerous present-directory-on-root case. Covered by\n  `test_the_running_host_check_{exists_and_is_executable,names_both_volumes_by_default,fails_on_a_plain_directory,passes_when_the_volume_is_mounted}`\n  plus the fallback tests. `infra/runbooks/provision-restore.md` step 4b now points at it, covers\n  both volumes, and says plainly not to treat \"Gerrit responds\" as evidence.\n\nVerification run in this worktree: `pytest tests/unit/test_user_data_device_resolution_d614.py\ntests/unit/test_gate_scratch_volume_aa40.py` → **49 passed**. Shell gates clean:\n`scripts/check_shellcheck.py` rc=0, `scripts/check_templatefile_escapes.py` rc=0. No production\nhost was touched and no terraform was applied.","timestamp":1788604674576526791}],"completion_expectation":"required","created_at":1788550863426099001,"creation_channel":"cli","deps":[{"link_uuid":"71acb4e7-eda5-4deb-9b4c-773e28eebb8e","relation":"relates_to","target_id":"ea66-45ea-6f7c-4c73"},{"link_uuid":"c468d00a-913d-4f55-b676-7d188974487d","relation":"relates_to","target_id":"aa4d-fdec-de0b-415d"},{"link_uuid":"63fa6fe7-3a29-4798-87e3-0ec177fee90d","relation":"relates_to","target_id":"4587-b37e-11ee-4fcc"}],"description":"## The defect\n\n`infra/terraform/user_data.sh` asserts the mount for the GATE-SCRATCH volume but not for the\nGERRIT DATA volume:\n\n(Line numbers below are as of `25d1d683e55a`, the pre-fix `origin/main`, so they can be\nchecked rather than trusted.)\n\n- gate-scratch: `mountpoint -q` at `:161`, FATALing at `:162` with \"refusing to leave gate\n  scratch on the ROOT filesystem\" — the block is `:161-164`.\n- `/var/gerrit` (the `mount_ebs_volume ... /var/gerrit` call site, `:135-138`): **no assertion\n  at all.** It FATALs only on an unresolvable device, never on a mount that did not take.\n\nBoth fstab entries use `nofail`. And `mount -a` returning 0 does NOT mean the mount happened —\n`nofail` skips quietly. That was PROVEN by execution in a sandbox: stubbing `mount` to return 0\nwithout mounting is exactly the documented nofail-skip mode, and the gate-scratch path caught it\nwhile nothing would catch it for `/var/gerrit`.\n\nSo a `/var/gerrit` mount that silently does not take leaves **Gerrit running on the root\nfilesystem**, with nothing raising and nothing asserting.\n\n## Why this is the more serious instance of the class\n\nThis is the same silent-fallback-to-root failure that ADR 0112 exists to prevent — but on the\nMORE valuable volume. Consequences of Gerrit running on root:\n\n- The Gerrit repository data goes to a 60 GiB root volume rather than its dedicated 50 GiB one.\n- Root disk pressure returns. Root has already hit **97%** once (2026-09-02), which took Gerrit\n  fully offline for five hours.\n- Backups silently cover the wrong thing: the DLM policy snapshots the DATA volume. If Gerrit is\n  actually writing to root, the daily snapshots contain nothing of value, and root is not on a\n  schedule at all.\n\nThe asymmetry between the two mounts looks unintentional rather than considered — the gate-scratch\nassertion was added by ADR 0112's work, and the older `/var/gerrit` path simply never got one.\n\n## IMMEDIATE RELEVANCE: a Gerrit stop/start is pending\n\nAn approved `terraform apply` will update `aws_instance.gerrit`'s `user_data` and, per provider\nv5.100.0 defaults, STOP/START the instance. On restart, `mount -a` runs against the real fstab. If\n`/var/gerrit` silently fails to mount, **Gerrit comes back up on the root filesystem and nothing\nsays so.**\n\nMitigation until this is fixed: after any instance stop/start, explicitly verify\n`mountpoint -q /var/gerrit` (and `findmnt -no SOURCE /var/gerrit`) BEFORE declaring the host\nhealthy. Do not rely on Gerrit responding as evidence that its data volume is mounted — it will\nrespond either way.\n\n## Acceptance criteria\n\n- [x] AC1 - `user_data.sh` asserts `mountpoint -q /var/gerrit` after `mount -a`, and FAILS LOUDLY\n      when the mount did not take, in the same shape as the gate-scratch assertion at\n      `:161-164`.\n- [x] AC2 - Defect-seeded: with `mount` stubbed to return 0 WITHOUT mounting (the real nofail-skip\n      mode), the sequence aborts. Removing the assertion must make that test RED.\n- [x] AC3 - The failure is distinguishable from a genuine mount error: a reader can tell \"the\n      volume did not mount\" from \"mount reported an error\", since nofail makes the former silent.\n- [x] AC4 - A running-host check exists that an operator can invoke after a stop/start to confirm\n      both volumes are mounted where expected, without reading the script. Portable: no dependence\n      on a specific CI provider or on AWS APIs.\n\n## Non-goals\n\nNot removing `nofail` from either fstab entry — `nofail` is deliberate, so a missing volume does\nnot wedge boot. The fix is to ASSERT after mounting, not to make boot fragile.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/terraform/user_data.sh","reason":"assert mountpoint after mount -a for BOTH volumes (single-sourced inside mount_ebs_volume); distinguish a mount -a error from a silently-skipped nofail entry"},{"path":"tests/unit/test_user_data_device_resolution_d614.py","reason":"extend the existing verbatim-shell oracle with mount-assertion tests plus defect seeding"},{"path":"infra/scripts/check-mounts.sh","reason":"new operator-invokable running-host check that both volumes are mounted where expected (AC4)"},{"path":"infra/runbooks/provision-restore.md","reason":"point the post-stop/start verification step at the new check"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","4587-b37e-11ee-4fcc"],["relates_to","aa4d-fdec-de0b-415d"],["relates_to","ea66-45ea-6f7c-4c73"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"a1b141f6-4315-44d3-9292-30a2483c44b1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"9c93-754e-b641-48d1","ticket_type":"bug","title":"user_data.sh asserts the gate-scratch mount but NOT /var/gerrit, so a silently-skipped nofail mount leaves Gerrit running on the root filesystem undetected","verify_commands":[]},"source_event_uuids":["373c1850-c956-4905-95ea-2a070b94bb29","e68d52b8-a20f-444e-aab4-765709edb3fd","d55519c9-3669-4d5d-8760-4ca67371cb58","3a7eacd5-5369-4695-8e67-be2a25bad9a0","c468d00a-913d-4f55-b676-7d188974487d","296ad3e3-fe67-403b-985f-2f26dc824862","ceccea3d-cdd5-4658-9cbf-092ed629c6aa","63fa6fe7-3a29-4798-87e3-0ec177fee90d","2a7973af-b2e7-43c5-8cc6-d2bb7e0225a1","afa460f0-ea55-4566-98f2-ddbde3e0246d","a1b141f6-4315-44d3-9292-30a2483c44b1","280afd6b-67b1-4e80-89c2-5e051e7d0da3"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788610758938298637,"uuid":"85e90975-f663-41d8-9ebd-50ee64f8be7c"}