{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788610758938298637,"compiled_state":{"alias":"unamused-cloudy-junebug","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"0033662b5534531d84e39d4a14bf75c8e768e85e","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 9c93-754e-b641-48d1","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.13.1 (0033662b5534)","material: 4b840fcb50b0cbbc","verified-at-sha:0033662b5534531d84e39d4a14bf75c8e768e85e"],"material_fingerprint":"4b840fcb50b0cbbc","merged_log_commit":"0033662b5534531d84e39d4a14bf75c8e768e85e","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788604959261901000},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 9c93-754e-b641-48d1","material: 4b840fcb50b0cbbc","material-part: children 647ea2107ca5072f 0","material-part: description 562d9245f07316d1 3599","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 010c918ec865a4a8 4","material-part: ticket_id a1480de7355bc2a3 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-ph