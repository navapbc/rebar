b2824c78cc1f","event_uuid":"76da2f72-3dc8-4ee1-a4a8-03b481ab72b2","position":{"commit_sha":"358252649f59cf1ae0abde3b9111713fefe984b3","position":"1788578537839547001-76da2f72-3dc8-4ee1-a4a8-03b481ab72b2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"796a7329787fb20c4d4c1625124ced2ef9c30b734a82d1be1f68259306fed0a1","event_uuid":"f3615b5b-9a50-485d-82ac-8babbcbb8eb9","position":{"commit_sha":"358252649f59cf1ae0abde3b9111713fefe984b3","position":"1788578538192762001-f3615b5b-9a50-485d-82ac-8babbcbb8eb9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788570612177512418,"creation_channel":"mcp","deps":[{"link_uuid":"6cf8ab10-7b6e-4850-8eb3-2868c49c74f6","relation":"supersedes","target_id":"cbd6-ff88-def3-4da7"},{"link_uuid":"be0fa330-2e76-4d8a-9ce7-15d321881b77","relation":"supersedes","target_id":"fbe6-b600-30aa-4adc"},{"link_uuid":"7cb2bb82-ecbd-4cc5-b162-d432f3179a7f","relation":"supersedes","target_id":"7ebe-c6f8-31ec-4fea"},{"link_uuid":"e897113e-b496-4eb0-810b-b20adf0baf1e","relation":"supersedes","target_id":"0748-e112-19d1-4f6a"},{"link_uuid":"94b8396b-1b21-485e-9eae-346e24b4aa76","relation":"supersedes","target_id":"77e2-9a8c-76e2-4807"},{"link_uuid":"b3f7cd2d-c09f-4e37-9e77-613efde915de","relation":"supersedes","target_id":"db95-1c41-c252-4ddd"},{"link_uuid":"047d2757-db78-4756-956a-51bfd4f76182","relation":"supersedes","target_id":"d25f-2fcd-c488-4a50"},{"link_uuid":"21458205-2d67-4dc5-bd5b-23d0d85940d7","relation":"supersedes","target_id":"8a62-61db-a13e-4317"},{"link_uuid":"76da2f72-3dc8-4ee1-a4a8-03b481ab72b2","relation":"supersedes","target_id":"d029-0a9a-0ef3-42bd"},{"link_uuid":"f3615b5b-9a50-485d-82ac-8babbcbb8eb9","relation":"supersedes","target_id":"5dc4-1ccc-51fc-4a73"}],"description":"## Context / Problem\nThe scripts cohort contains audited comments or docstrings that obscure current behavior with repetition, obvious narration, duplicated explanation, or historical detail. The audit is pinned to `9e65567b79ffe872534c3c656ade7b34340d8192`.\n\n## Approach\nEdit explanatory text only in this directory/subsystem cohort. Condense it to current, non-obvious rationale and constraints; retain every file-specific preserve item and consumer contract below. Grouping adjacent files from one subsystem keeps the change reviewable in one session and permits one coherent verification pass without changing executable behavior.\n\n## Scope\n- `scripts/jira_dc_epic_link_clear_probe.py:1–28, 41–46, 110–125, 132–136, 155–163, 180–185, 281–285` — Preserve two questions/output, project-before-fields ordering, bounded poll, shared readiness, evidence on failure. Consumer: none found.\n- `scripts/jira_dc_field_readiness.py:1–73, 91–118, 128–138, 167–177, 194–207, 235–254, 287–326` — Preserve post-project precondition, concise measurement citation, inventory discriminator, bounded/fail-closed semantics, success/failure evidence. Consumer: none found.\n- `scripts/main_health_report.py:2–25` — Preserve scheduled-main purpose, green/red fields, fail-soft last-green lookup. Consumer: none found.\n- `scripts/mutation_gate.py:26–30, 587–595, 664–668` — Preserve invocation-independent import, every shard-code execution sandboxed, basetemp existence, venv read-only. Consumer: affected prose is source-only.\n- `scripts/mutation_sandbox.py:2–32, 68–101, 250–255` — Preserve OS mechanisms, functional enforcement probes, explicit waiver/fail-closed policy, two-signal Seatbelt proof, external caution citation. Consumer: none found.\n- `scripts/probe_rebar.py:555–570` — Preserve exact expected symmetric difference and conditional signature-field intersection. Consumer: none found.\n- `scripts/rebar_duration_probe.py:2–22` — Preserve read-only inputs/linkage, defaults, malformed-record behavior, reproducibility pointer. Consumer: full argparse `--help`.\n- `scripts/release_guards.py:2–23, 75–82` — Preserve version/manifest, ancestry, environment protection, and publisher-description contracts. Consumer: full argparse `--help`.\n- `scripts/retarget_jira_project.py:2–30` — Preserve stale bindings/snapshot behavior, dry-run/apply, backups/tag stripping, post-preview safety. Consumer: full argparse `--help`.\n- `scripts/summarize_ci_failures.py:2–30` — Preserve inputs/output, timeout-annotation distinction, comment-only/no-vote behavior. Consumer: none found.\n\n## Acceptance Criteria\n- [ ] Every listed location contains only current, non-obvious rationale or constraints after remediation; verified by reviewing the final diff against every Scope row.\n- [ ] Every preserve item and consumer contract in Scope remains explicit and accurate; verified by a row-by-row completion comment and the commands under Verification.\n- [ ] No executable behavior or test assertion changes; verified by the commands under Verification exiting 0.\n\n## Verification\n- `env PATH=\"$PWD/.venv/bin:$PATH\" make lint`\n- `env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py`\n\nThe row-by-row diff review is authoritative for prose quality; the hygiene guard detects only its narrow deterministic history-token rule.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"scripts/jira_dc_epic_link_clear_probe.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/jira_dc_field_readiness.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/main_health_report.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/mutation_gate.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/mutation_sandbox.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/probe_rebar.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/rebar_duration_probe.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/release_guards.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/retarget_jira_project.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/summarize_ci_failures.py","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","3de8-31a0-25ef-456d"]],"no_file_impact_reason":"","parent_id":"3de8-31a0-25ef-456d","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"40d7-eca8-8726-4b14","ticket_type":"task","title":"Condense comments in scripts — cohort 04: jira_dc_epic_link_clear_probe–summarize_ci_failures","verify_commands":[]},"source_event_uuids":["4e895c82-4329-481a-9e8a-d3c327519292","e0070e27-58ce-473a-b5cd-a64ffe531b26","6cf8ab10-7b6e-4850-8eb3-2868c49c74f6","be0fa330-2e76-4d8a-9ce7-15d321881b77","7cb2bb82-ecbd-4cc5-b162-d432f3179a7f","e897113e-b496-4eb0-810b-b20adf0baf1e","94b8396b-1b21-485e-9eae-346e24b4aa76","b3f7cd2d-c09f-4e37-9e77-613efde915de","047d2757-db78-4756-956a-51bfd4f76182","21458205-2d67-4dc5-bd5b-