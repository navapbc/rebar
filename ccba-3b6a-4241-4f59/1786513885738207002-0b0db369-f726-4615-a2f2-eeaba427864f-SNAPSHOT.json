4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"db6c5aa2066d4df2d5f0b78ef43f94bceaeaa0d3a4b307949cace0ccf517dcf8","event_uuid":"b03ad32f-706c-4ba9-9bae-c8e00cb01e6e","position":{"commit_sha":"de8e9fe4593467e080fc60a3465d4b0abdc55f54","position":"1786511146507324001-b03ad32f-706c-4ba9-9bae-c8e00cb01e6e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2de0373fc8c21e0bc816369e7376ff2e0ccc70da2962022cd315bf2707a543bf","event_uuid":"bdec163c-601b-4602-8e40-75d3c115f7c2","position":{"commit_sha":"de8e9fe4593467e080fc60a3465d4b0abdc55f54","position":"1786511147595421001-bdec163c-601b-4602-8e40-75d3c115f7c2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d25a08ca369242f4b84bc0c80826837d10ac59184abb6eda751d7c32debd5e5f","event_uuid":"74fce5e6-0761-43ed-8851-61e73eabfd4d","position":{"commit_sha":"919074578e37c846350a6c3b7d5202371639088a","position":"1786513885738207001-74fce5e6-0761-43ed-8851-61e73eabfd4d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Premise CONFIRMED in code, with a nuance worth recording.\n\nThe wasted-spend gap is NARROWER than 'plan unchanged since a BLOCK': reuse.verdict_reuse already short-circuits the wholly-unchanged case at zero LLM cost, but it requires the ENTIRE material fingerprint AND the review code SHA to hold still. Touch a file_impact row or land an unrelated commit and it correctly declines, so the ticket pays a full multi-pass review even though the plan prose the blocking findings quoted was never edited. That residue is what this pre-check warns on.\n\nBoth inputs the plan assumed exist and are persisted: the v2 sidecar records each finding's Pass-1 'evidence' grounding quotes (story 4e19, lossless) and the per-component 'material_parts' (bug 94a3). No cited-anchor/unchanged-plan pre-check existed.\n\nImplementation: new module src/rebar/llm/plan_review/cited_anchor.py holds all logic, because the hook point (_run_plan_review in plan_review/__init__.py) was at 786/800 LOC against the module-size gate. Wiring there is 4 lines (now 793/800). The warning fires only when (1) the latest sidecar verdict is BLOCK with blocking findings, (2) the recorded 'description' component digest equals the current one, and (3) at least one cited anchor is still present verbatim. Condition 2 is what makes condition 3 sound: the sidecar stores the description's fingerprint, not its bytes, so reasoning about 'the text the finding quoted' is valid precisely because that text has not moved.\n\nWARN-ONLY contract honored: logger.warning only, placed after verdict_reuse and BEFORE drift_refresh so it precedes any billable call; returns a metrics record, never a verdict; no new flag, no decline, no exit-code change. metrics.precheck.cited_anchor_warning is stamped on EVERY review (False is a measurement, not an absence) so precision is computable offline per ADR 0054.\n\nGates green locally: 17 new tests pass; 898 passed / 4 skipped across plan_review+sidecar+reuse (no verdict-shape regression); make lint and make typecheck clean.\n\nPushed as Gerrit change 1631.","timestamp":1786513885738207001}],"created_at":1786495906792338001,"creation_channel":"cli","deps":[{"link_uuid":"1ff1c441-c735-40a6-aaa9-c0f548208488","relation":"discovered_from","target_id":"b902-18af-14ed-4da1"}],"description":"## Context\n\nHistorical audit (analysis ticket b902-18af-14ed-4da1): of 894 BLOCK→re-review transitions, 13-14% re-blocked ONLY on the same persisting criteria — the author re-submitted without addressing the outstanding findings, paying a full review (~$3-7) to learn nothing new. A staged-LLM re-review was modeled and rejected (net negative: 45% of re-reviews PASS and would pay an extra serial call). The approved compromise is a zero-LLM deterministic pre-check, WARN-ONLY (operator decision 2026-08-11): it must never hard-block, because ~8% of BLOCK→PASS flips occur with no material change at all (verdict flap) and a hard decline would freeze those recoveries. This mirrors the escape-hatch posture of the shipped BLOCK-verdict-reuse (`plan_review/reuse.py`).\n\n## Plan\n\n1. When `review-plan` runs on a ticket whose LATEST attested verdict is BLOCK with recorded blocking findings, extract each blocking finding's cited evidence anchors (the finding's `evidence` strings and quoted plan fragments recorded in the sidecar).\n2. DET check (no LLM): compare the current plan material against the material fingerprinted at the blocking review. If the plan text containing every cited anchor is UNCHANGED (all anchors still present verbatim and description component fingerprint unchanged per `material_parts`), print a WARNING before the review runs: the outstanding blocking findings cite text the revision did not touch, naming the findings and their criteria, and noting the review will likely re-block. Then RUN THE REVIEW ANYWAY (warn-only; no new flag, no decline, no exit-code change).\n3. Anchors that cannot be matched verbatim (paraphrased evidence, structural findings with no quote) are treated as unmatchable and NEVER trigger the warning on their own — the warning fires only when at least one anchor matched the old text AND all matched anchors are untouched.\n4. Record `precheck.cited_anchor_warning: true|false` in the review's sidecar metrics so the warning's hit rate and predictive value are measurable offline (per ADR 0054).\n\n## Acceptance Criteria\n\n- [ ] Re-reviewing a ticket whose plan is unchanged since a BLOCK (same description component fingerprint) prints the warning naming the persisting findings' criteria, and the review still runs to a verdict. Verify: `env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest tests/unit -k \"cited_anchor\" -x` passes with a test pinning warning text + review execution.\n- [ ] Re-reviewing after an edit that changed cited text does NOT warn. Verify: covered in the same test module.\n- [ ] Findings with no verbatim-matchable anchors never trigger the warning alone. Verify: covered in the same test module.\n- [ ] The sidecar metrics block records the warning flag on every plan review. Verify: unit test pins the field.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/plan_review/orchestrator.py","reason":"pre-review warning hook"},{"path":"src/rebar/llm/plan_review/sidecar.py","reason":"warning flag in metrics"},{"path":"tests/unit/test_plan_review_cited_anchor_precheck.py","reason":"AC coverage"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"b03ad32f-706c-4ba9-9bae-c8e00cb01e6e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"ccba-3b6a-4241-4f59","ticket_type":"task","title":"Warn-only DET cited-anchor pre-check before re-reviewing an unaddressed BLOCK","verify_commands":[]},"source_event_uuids":["1f3dc3cd-8e65-4226-af5a-606b271e5ee0","55031f53-849f-41e7-bfe9-70c4a9870451","1ff1c441-c735-40a6-aaa9-c0f548208488","4a53bc1e-b708-4578-8b7e-c6cc8650384c","b03ad32f-706c-4ba9-9bae-c8e00cb01e6e","bdec163c-601b-4602-8e40-75d3c115f7c2","74fce5e6-0761-43ed-8851-61e73eabfd4d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786513885738207002,"uuid":"0b0db369-f726-4615-a2f2-eeaba427864f"}