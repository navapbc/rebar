{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787797843097119002,"compiled_state":{"alias":"drafty-actuarial-noddy","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"9499312eb7b05dc3d75d39c23ab74a5b4afc26b5","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1d21-887e-a923-470e","material: 387e6e38bbf8ce77","material-part: children 647ea2107ca5072f 0","material-part: description 6d7e6d1a9a354b51 7996","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 216bc99be460504c 7","material-part: ticket_id b4b39ba2a98609cc 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (9499312eb7b0)","regver: aa61189569d34126","verified-at-sha:9499312eb7b05dc3d75d39c23ab74a5b4afc26b5","dep c86a01dab6fec2c780e4b2dd57e289cde99493a1cbfd7285f902f208aecb47db .github/workflows/external-integration.yml","dep ad39c6a238c4dd7ddf1465ff7a793bd2329c1a5e9ca00841833231cb51610e3a src/rebar/_engine/rebar_reconciler/access_check.py","dep absent tests/external/live_jira_cloud_mutation/conftest.py","dep absent tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py","dep cb929c36f60227228e24d4023a69616c888acbe0a67ea7b3016fe253d4980373 tests/external/live_jira_cloud_s3/README.md","dep c794b16b6a823317e66e2f30b95375dbb76dbe49a2923596ff90480f7a7f31b2 tests/scripts/bridge/test_jira_capability_probe.py","dep absent tests/unit/test_external_integration_cloud_mutation_workflow.py","read-set: 13","read-path: .github/workflows/external-integration.yml","read-path: docs/adr/0084-acli-429-rate-limit-backoff.md","read-path: src/rebar/_engine/rebar_reconciler/access_check.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","read-path: src/rebar/_engine/rebar_reconciler/batch_dispatch.py","read-path: src/rebar/_engine/rebar_reconciler/create_coordinator.py","read-path: src/rebar/_engine/rebar_reconciler/create_route.py","read-path: src/rebar/_engine/rebar_reconciler/pass_fuse.py","read-path: src/rebar/_engine/rebar_reconciler/request.py","read-path: tests/external/live_jira_cloud_s3/README.md","read-path: tests/scripts/bridge/test_jira_capability_probe.py","read-path: tests/unit/rebar_reconciler/test_access_check_client_seam.py","read-path: tests/unit/test_jira_dc_capability_map_workflow.py","currency-basis: file_impact"],"material_fingerprint":"387e6e38bbf8ce77","merged_log_commit":"9499312eb7b05dc3d75d39c23ab74a5b4afc26b5","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787770654610472000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":23,"unsigned":0},"authorship_ledger":[{"content_hash":"89860d9602a649847e719cb14a384f38c8837f68507f11c5dda6faf6663d79a9","event_uuid":"841dc51e-5e05-4e78-a352-6e5a0119e9b9","position":{"commit_sha":"76ec3c5a5e8dbd4269287c79de1c2f2e7d679919","position":"1787767549979694001-841dc51e-5e05-4e78-a352-6e5a0119e9b9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9cb7097725774f3054280155ad6c8e3f56d4c02c73ba49b79d62a0ae38258464","event_uuid":"b46ed2ea-f8c9-42f4-a245-f8461f82e1e3","position":{"commit_sha":"eb558d0f214c349e4f57ac23fd253494c99e1b82","position":"1787768996447678001-b46ed2ea-f8c9-42f4-a245-f8461f82e1e3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"376ff19a13547b41480f5ddc908893159d9f10d8c221eaa1b7bb410dac60f312","event_uuid":"045f7727-ad27-4a88-aba8-7551c1e76d3b","position":{"commit_sha":"f84957cfc4856776ba9d5ca326ec0f592c347d44","position":"1787770196249662001-045f7727-ad27-4a88-aba8-7551c1e76d3b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"84f3ab914a3406272f898e7c8eebd17849c8ffd635e84482dcffc7badf8095bc","event_uuid":"c9c22b70-bde4-4553-86f8-b7da8107e57c","position":{"commit_sha":"b07a8101eac7d7bf5ba6b8e451b4588b29c29422","position":"1787770654631788001-c9c22b70-bde4-4553-86f8-b7da8107e57c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"20d59fec54d1b7357b0aeecf701d09cd1a8915e19a986c8aacf4de0351b33782","event_uuid":"e77feccf-8953-4476-9d7b-03ece5d45c31","position":{"commit_sha":"9d9133e418dd21920805675a78920dc022dd4981","position":"1787771045091706001-e77feccf-8953-4476-9d7b-03ece5d45c31"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c7c7593d6adb76254368cb3c9164ab1395ecaae7ba04d49233c8f85ca10f42bc","event_uuid":"c73c38a7-fec9-49f1-add9-29b499dc76e3","position":{"commit_sha":"9d9133e418dd21920805675a78920dc022dd4981","position":"1787771047023496001-c73c38a7-fec9-49f1-add9-29b499dc76e3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"39bfb408f3742c69d656b860dd2ade6f9c2349f8706213f78b5ac1a11627048e","event_uuid":"c49524a0-9df8-4dac-8369-3b1a7bb58b7e","position":{"commit_sha":"a499534001e11544a7899b701b726fb519e9851f","position":"1787771062948933001-c49524a0-9df8-4dac-8369-3b1a7bb58b7e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2eff18da5930c5896ccd680377b1349df77c3be729b2b2ce2e6888b8c2043f91","event_uuid":"13f1f829-93ff-4d9f-9085-464385f007bd","position":{"commit_sha":"8a04dcb56b0afd47f0467dfec7e7bd6298fe308c","position":"1787772519234386001-13f1f829-93ff-4d9f-9085-464385f007bd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4413fdfc7e8e707671514e5a92dd96ffb93dae17d04232ef6df4b322c5277f75","event_uuid":"db3c2690-6fcc-4fd6-8c2c-70a083ee0611","position":{"commit_sha":"baca67221197fda4e78a95bb7453350f05f7ce9a","position":"1787795411187493001-db3c2690-6fcc-4fd6-8c2c-70a083ee0611"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"21d4ab59b0a1a55892d2d2768551ce04c125f72f9c931ea5fd5217555e6f5bed","event_uuid":"a5e13a69-42b9-4684-af38-5d56b5bd1a24","position":{"commit_sha":"89bf6339fb64bd1a6e3a6d2cbf13a4b0ca899109","position":"1787796016760700356-a5e13a69-42b9-4684-af38-5d56b5bd1a24"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8fcbc29ed1fe6d3095e94e972dcdfeea5055422bbe7f9cd1a13c1154b4498ffb","event_uuid":"44bcdebc-1e76-4e8f-b5a4-d32f106cfc45","position":{"commit_sha":"58097802bad1418ea323312ce000bda530c1413b","position":"1787797843097119001-44bcdebc-1e76-4e8f-b5a4-d32f106cfc45"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Investigation trail: (1) 'rebar bridge check-access' vs live REB passed CREATE/LABEL/PROPERTY_WRITE/PROPERTY_READ/DELETE (self-cleaning finally-delete); only STEP_JQL_SEARCH failed with no_results_after_retry due to Cloud Lucene-index eventual-consistency lag exceeding the fixed 6x5s budget. (2) The DC harness (tests/external/live_jira_dc) drives the coordinator via bridge subprocess with --filter-local-ids over a scrubbed-copy store; but --filter-local-ids is legacy-route-only (request.py:95) and this epic removes that path, and a scrubbed-copy still enumerates ~2700 tickets — unsafe against shared-prod REB. Hence the direct coordinate_and_fuse([one_plan]) design: structural single-ticket bounding, no enumeration, no legacy flag. (3) Coordinator seams mapped: coordinate_and_fuse batch_dispatch.py:314; coordinate_create/_resolve_ambiguous create_coordinator.py:214; PassFuse pass_fuse.py; BindingLifecycle.bind_confirm. Design accepted by plan-review; final blocker was only the 8000-char description limit (narration moved here).","timestamp":1787764361582971001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review PASSED (run 10, 0 blocking / 1 advisory ac-quality). Claimed. IMPLEMENTATION NOTE: the repo ALREADY has live Jira Cloud creds provisioned as GH secret JIRA_API_TOKEN + vars JIRA_URL/JIRA_USER/JIRA_PROJECT (verified via gh). The new jira-cloud-mutation-probe lane will wire THOSE existing names (not the JIRA_CLOUD_* placeholders in the plan text), so the GREEN-run prerequisite is already satisfied and the lane will run, not skip.","timestamp":1787771062948933001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation landed for review as Gerrit change 2249 (https://rebar.solutions.navateam.com/c/rebar/+/2249). Held-out TDD: backoff schedule tests RED-first then GREEN (cap-removal mutation -> 4 red); workflow-structure test pins the jira-cloud-mutation-probe lane shape. Live-validated against the REB project locally: bridge check-access all 6 steps PASS, both live-Cloud coordinator tests (create/bind lifecycle + fuse pass) PASS, zero leaked issues. Pre-flight: make lint + typecheck + affected units all green. Awaiting LLM-Review +1 and Verified +1 before close.","timestamp":1787772519234386001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Patchset 2 of Gerrit change 2249 (Change-Id I8a946e9): CI Verified -1 on the prior patchset was NOT a flake but a real regression. The two '# read-via:' markers I placed on access_check.py to suppress the config-ownership gate are forbidden by the already-landed RP-04 C3a-JIRA held-out test tests/scripts/test_reconciler_jira_seam_clean_heldout.py::test_read_via_markers_are_bounded_and_confined, which caps read-via markers at exactly ONE (outbound_fields.py) across the 6 owned reconciler-jira files. access_check.py is a credential boundary that owns credential reads only, not generic operator-knob env reads. FIX: moved the three JQL-backoff knob reads (JIRA_PROBE_JQL_RETRIES/SLEEP/SLEEP_MAX) into the owned config.py composition root as config.resolve_jql_backoff(env); access_check._resolve_jql_backoff now delegates and carries zero markers. Local validation: config-ownership gate rc=0; seam-clean+backoff+config tests 26/26; make lint + make typecheck clean; broad xdist regression 3626 passed 0 collection-errors. Re-pushed; stale Verified -1 auto-removed.","timestamp":1787795411187493001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Restacked: change 2249 patchset 3 now sits ABOVE new change 2252 (b900 conftest fix). Also made the access_check config import LAZY (inside _resolve_jql_backoff) so importing the credential-boundary module no longer eager-imports the engine config package (that top-level import had escalated the classify flake to all-legs). make lint rc=0, make typecheck clean, 35 affected tests + 4747-test xdist slice green.","timestamp":1787797843097119001}],"created_at":1787760571181660001,"creation_channel":"cli","deps":[{"link_uuid":"a5e13a69-42b9-4684-af38-5d56b5bd1a24","relation":"relates_to","target_id":"1e07-013a-7d96-4139"}],"description":"# Bounded self-cleaning live-Jira-Cloud coordinator lifecycle lane + search-index-lag hardening\n\n## Problem\nThe epic's Live-External AC requires the RP-03 create-coordinator's create / binding-lifecycle /\ncommit-unknown / fuse exercised against **live Jira Cloud**. The only Cloud lane today is read-only AND\ngated off (`vars.AWS_S3_REHEARSAL_ROLE_ARN` unset) — SKIPPED even in green runs — so **no run has exercised\nlive-Cloud mutation**. Separately, `bridge check-access`'s `STEP_JQL_SEARCH` flakes on live REB: its wait\nis a FIXED 6x5s (no backoff), shorter than Jira Cloud's Lucene-index lag — the write lands (the by-key read\nright after passes), only SEARCH visibility lags.\n\n## §1 — Harden the search-index wait (`access_check.py`)\nReplace the fixed 6x5s loop with an env-tunable exponential-backoff budget:\n- `JIRA_PROBE_JQL_RETRIES` (default 10; was 6), `JIRA_PROBE_JQL_SLEEP` base (default 3; was 5),\n  `JIRA_PROBE_JQL_SLEEP_MAX` cap (default 30).- Sleep before retry k (k over 0..RETRIES-2) is `min(base*2**k, cap)` → defaults `[3,6,12,24,30,30,30,30,30]`\n  = 195s worst case (old ~25s budget timed out). Follows the capped-exponential shape used by the acli retry\n  floor (`_errors.MAX_BACKOFF_S`) but as a positive-result visibility poll. The `sleep_fn` seam is kept\n  (unit-testable without real sleeping); this poll helper is reused by §2's commit-unknown wait.\n\n## §2 — Live-Cloud coordinator lifecycle module (bounded, self-cleaning)\nNEW `tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py` (+ `conftest.py`). Against\nlive REB it drives the epic's CREATE route `coordinate_full_create` (create_route.py:171) — composing\n`coordinate_create` (create_coordinator.py:235; create+commit-unknown) with `contain_created`\n(label/property/confirm binding) — for a plan of EXACTLY ONE throwaway ticket, then exercises the fuse via a\nbounded follow-up mutation (below):\n- **Write-bounding (shared-prod safety).** No full `bridge sync`; no legacy-route `--filter-local-ids`\n  (request.py:95 rejects it here). It acts only on the ONE plan handed to it (one create per plan) — NO\n  enumeration, NO write-back — so the only Jira mutations possible are the throwaway issue's create, its\n  containment label/property, and its delete.\n- **create + binding-lifecycle.** `create_execute` issues the physical create via the live Cloud client;\n  `record_key`/`attach_label`/`set_property`/`confirm` bind+contain it; asserts a confirmed containment\n  (`dependents_released`) with `jira` channel + `jira-` local-id provenance.\n- **commit-unknown recovery.** A second call injects an AMBIGUOUS create signal (simulated timeout) so\n  `_resolve_ambiguous` (create_coordinator.py:211) re-observes ONCE and ADOPTS the existing issue instead of\n  duplicating. Its `observe` FIRST waits until the dedup label search reflects the created issue (reusing\n  §1's helper), so adoption is attributable to the dedup path, not lag.\n- **fuse.** After the create, a bounded NON-create mutation plan (one label/summary op on the bound\n  throwaway key) is driven through `batch_dispatch.coordinate_and_fuse([mutation_plan], execute=...)`\n  (batch_dispatch.py:314) — the correct fuse API (runs non-create `coordinator.coordinate` then folds\n  outcomes through `PassFuse`, pass_fuse.py:96). Asserts the returned `CutoverReport` (tallies +\n  fuse_decisions + degraded) reflects that op.\n- **teardown (always) + one label scheme.** ONE env label `${REBAR_PROBE_RUN_LABEL}` (workflow:\n  `rebar-id:cloudprobe-<github.run_id>`; local: `rebar-id:cloudprobe-<uuid>`) is STAMPED on the created\n  issue by `attach_label`. The module deletes the issue by key in a `finally` (mirrors\n  access_check.py:217-224), then sweeps any issue carrying THAT label — the value §3's sweep keys on, so\n  the two cannot diverge; scoped to this run, not the shared `rebar-id:` prefix.\n- Gated by `_live_jira_ready()` + `REBAR_RUN_EXTERNAL=1` + Cloud creds, enrolling in the all-skip canary\n  (`tests/external/conftest.py`) like the DC modules.\n## §3 — Workflow lane\nAdd `jira-cloud-mutation-probe` to `.github/workflows/external-integration.yml` (`workflow_dispatch` +\nweekly cron): export `REBAR_PROBE_RUN_LABEL=rebar-id:cloudprobe-${{ github.run_id }}` + REB Cloud env from\nsecrets, run `bridge check-access` (preflight) THEN the module, and on BOTH failure AND cancel run an\nalways-run teardown sweeping `${REBAR_PROBE_RUN_LABEL}` via acli (`acli jira workitem search --jql\n\"labels = ...\" --json` then `acli jira workitem delete --key <KEY> --yes` per hit; `--yes` REQUIRED per\nacli.py bug-3256 so the non-TTY sweep does not block on stdin). Same label the module stamps, scoping the\nsweep to the run.\n\n## §4 — Workflow-structure unit test\n`tests/unit/test_external_integration_cloud_mutation_workflow.py` (modelled on\n`test_jira_dc_capability_map_workflow.py`) proves the lane exists, exports `REBAR_PROBE_RUN_LABEL` from the\nrun id, runs check-access + the module, and has an always-run teardown with `--yes` keyed on that label.\n## §5 — Docs\nUpdate `tests/external/live_jira_cloud_s3/README.md`: the read-only rule is that suite's choice; the new\nlane is bounded, self-cleaning, prod-safe.\n\n## Prerequisites (operational)\nThe Cloud lane needs live REB Cloud secrets (`JIRA_CLOUD_URL`/`JIRA_CLOUD_USER`/`JIRA_CLOUD_API_TOKEN`) as\nrepo secrets — the operator provisions/confirms them BEFORE the GREEN-run AC is evaluated. Missing creds\ncannot masquerade as success: the module enrols in the all-skip canary, so a skipped Cloud lane FAILS.\n\n## Consumers to update (enumerated)\n- `tests/scripts/bridge/test_jira_capability_probe.py` (asserts `call_count == 6`, `delays == [5,5,5,5,5]`)\n  updated in the SAME change to the new 10-attempt `delays == [3,6,12,24,30,30,30,30,30]` plus an\n  env-override case recomputing from overridden base/cap/retries.\n\n## Surface-parity census\n- CLI (`bridge check-access`): in scope — JQL backoff exercised through it.\n- library (`run_access_check`; `coordinate_full_create`+`PassFuse`): in scope — unit tests drive the\n  backoff; the live module drives the create route + fuse.\n- automated caller (lane / live module): in scope — E2E oracle is the live run.\n- MCP/API: out of scope (no MCP tool). dual-direction: outbound create only in a one-plan call, no mirror.\n\n## Acceptance Criteria\n- [ ] `access_check.py` JQL wait is env-tunable exponential backoff (defaults 10 / 3 / 30 → sleeps\n  `[3,6,12,24,30,...]`); `sleep_fn` seam preserved; write-landing still confirmed by the by-key read.\n  Evidenced by new unit tests asserting the schedule and env-override recomputation.\n- [ ] `tests/scripts/bridge/test_jira_capability_probe.py` updated to the new schedule/defaults and passes.\n- [ ] The live-Cloud module drives `coordinate_full_create` for ONE throwaway plan (create/binding +\n  commit-unknown-after-visibility-wait + fuse), asserts known_key is the throwaway key and no other, and\n  ALWAYS deletes (finally + `${REBAR_PROBE_RUN_LABEL}` sweep). Enrols in the all-skip canary.\n- [ ] The `jira-cloud-mutation-probe` lane exports `REBAR_PROBE_RUN_LABEL`, runs check-access + module, and\n  has an always-run `acli jira workitem delete --key <KEY> --yes` teardown keyed on that label. Per §4.\n- [ ] With Cloud secrets provisioned (see Prerequisites), a dispatched Live External Integration run shows\n  the new Cloud-mutation lane GREEN and the DC lane GREEN. Evidenced by the run URL commented on the epic.\n- [ ] `tests/external/live_jira_cloud_s3/README.md` documents the read-only rule as suite-scoped and the\n  new bounded self-cleaning mutating lane.\n- [ ] `make lint && make typecheck && make test` green.\n\n## Verify commands\n- `make test PYTEST_ARGS=\"tests/scripts/bridge/test_jira_capability_probe.py tests/unit/test_external_integration_cloud_mutation_workflow.py\"` and `make lint`\n\n## Portability\nCI-agnostic: backoff is library behavior; the lane surfaces an op-linked probe (check-access + a\npytest module) that runs locally with the same env — nothing gated on one CI system.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/access_check.py","reason":"Replace fixed 6x5s JQL wait with env-tunable exponential backoff (JIRA_PROBE_JQL_RETRIES/SLEEP/SLEEP_MAX); preserve sleep_fn seam."},{"path":"tests/scripts/bridge/test_jira_capability_probe.py","reason":"Update the retry-budget pinning assertions (call_count/delays) to the new backoff schedule + defaults."},{"path":"tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py","reason":"NEW self-cleaning live-Cloud coordinator lifecycle test: scoped create/bind/commit-unknown/fuse via --filter-local-ids, always-delete + run-label sweep."},{"path":"tests/external/live_jira_cloud_mutation/conftest.py","reason":"NEW Cloud-lifecycle readiness/marker plumbing (_live_jira_ready sentinel, creds gating) for the all-skip canary."},{"path":".github/workflows/external-integration.yml","reason":"Add jira-cloud-mutation-probe lane: check-access preflight + live-Cloud lifecycle module + always-run run-label teardown sweep."},{"path":"tests/unit/test_external_integration_cloud_mutation_workflow.py","reason":"NEW workflow-structure unit test proving the lane's steps and always-run teardown."},{"path":"tests/external/live_jira_cloud_s3/README.md","reason":"Document that the read-only cardinal rule is suite-scoped, and the new bounded self-cleaning mutating Cloud lane."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","4217-d1d6-370b-4e98"],["relates_to","1e07-013a-7d96-4139"]],"no_file_impact_reason":"","parent_id":"4217-d1d6-370b-4e98","parent_status_uuid":"e77feccf-8953-4476-9d7b-03ece5d45c31","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"1d21-887e-a923-470e","ticket_type":"task","title":"RP-03: self-cleaning mutating live-Cloud integration lane (robust JQL probe + workflow job)","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/test_access_check_client_seam.py","dd_id":"AC1-AC2","dd_text":"JQL backoff + env budget + always-delete invariant"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_external_integration_cloud_mutation_workflow.py","dd_id":"AC3-AC4","dd_text":"Cloud-mutation workflow lane structure + docs"}]},"source_event_uuids":["841dc51e-5e05-4e78-a352-6e5a0119e9b9","b46ed2ea-f8c9-42f4-a245-f8461f82e1e3","045f7727-ad27-4a88-aba8-7551c1e76d3b","c9c22b70-bde4-4553-86f8-b7da8107e57c","e77feccf-8953-4476-9d7b-03ece5d45c31","c73c38a7-fec9-49f1-add9-29b499dc76e3","c49524a0-9df8-4dac-8369-3b1a7bb58b7e","13f1f829-93ff-4d9f-9085-464385f007bd","db3c2690-6fcc-4fd6-8c2c-70a083ee0611","a5e13a69-42b9-4684-af38-5d56b5bd1a24","44bcdebc-1e76-4e8f-b5a4-d32f106cfc45"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787797843097119002,"uuid":"106284fb-0d0f-4ee8-aff1-f7deda3da953"}