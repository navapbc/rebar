{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788623462010111002,"compiled_state":{"alias":"autositic-scarlet-clam","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"0033662b5534531d84e39d4a14bf75c8e768e85e","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 0165-f432-0580-4117","material: e13f7db00c361b8a","material-part: children 647ea2107ca5072f 0","material-part: description 9d9e25559148bd09 5861","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact 1a30bf46faade444 12","material-part: ticket_id 6f8d47035e30637a 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.13.1 (0033662b5534)","regver: aa61189569d34126","verified-at-sha:0033662b5534531d84e39d4a14bf75c8e768e85e","dep 00884a65c51e6fd7b4868f56e6b5a3de62080fd8a6ef70d5c30ed5f62e31b9f6 infra/scripts/autodeploy.sh","dep d98684876b51004f81d4738e3bf7b85e82a2589234428330ad0f3c1346377118 infra/scripts/bootstrap-gerrit-admin.sh","dep b4d621acccc5586a5b5b6839829050f125d77bed0ab06be25c507059ed5a2652 infra/scripts/compose-up.sh","dep fb9d18d727f080bc4ae35bc5b9ea69a560d226f123bc4232e91f79db623c0c75 infra/scripts/config-check.sh","dep 1800d7c9f5a051c3ce0d3f34fcd649d94c81848ad0940c806b8262ee0d37d441 infra/scripts/fetch-secrets.sh","dep 5df01229ecca840b7a855da37528bfc74d366d2b4de033221bb6dd228b9c5ae7 infra/scripts/install-autodeploy.sh","dep b97438502408dc1513975e254eef98245c58c6fae0168be8f3878747e65e8d88 infra/scripts/install-certbot-timer.sh","dep c257f9b0ee96791e4e7771950e8049daab44acb4