99-84ea-7d339c89072b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"27461d0a0eb5a0b34248a2b7a428c38c5d352a24baadb03d18ae88400ce026f0","event_uuid":"d71f8dd3-790c-477d-9df5-6ed905e1018a","position":{"commit_sha":"a6cecd18a87338789c9cbe05490e15f1923012a5","position":"1788487087396732001-d71f8dd3-790c-477d-9df5-6ed905e1018a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ee63eb5dda7c5b3f5ecb2945d18072a5c2694f1ca1f5197dcd59be34b2907a12","event_uuid":"2f488147-617f-4f55-b4dd-a6844aca4bc0","position":{"commit_sha":"1ff0c322e44e4d713b0f261694fddae7caf64d8e","position":"1788488396667214001-2f488147-617f-4f55-b4dd-a6844aca4bc0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788318424233088646,"creation_channel":"mcp","deps":[{"link_uuid":"a9f0f6ea-99cc-4028-98eb-e8f00aa297c9","relation":"blocks","target_id":"5169-ab69-9c23-4f8b"},{"link_uuid":"db6de28e-f4df-4ef6-949e-f36528e34d83","relation":"blocks","target_id":"1cef-7fbc-e402-467c"},{"link_uuid":"de56dbcd-814c-4b46-bae2-de27383aab41","relation":"relates_to","target_id":"08f0-98eb-1176-4a82"},{"link_uuid":"5cb2e271-d193-4764-b55f-468ddcd2b7c0","relation":"relates_to","target_id":"e7ab-7711-2839-474a"},{"link_uuid":"de60375c-5fd5-4e9c-a03f-a8cd5f004fb4","relation":"relates_to","target_id":"055a-c4e4-6fa5-44ac"},{"link_uuid":"f8072611-710f-44fb-a543-944b8eedb289","relation":"relates_to","target_id":"6a50-7441-2c42-417f"},{"link_uuid":"e9c38d8a-ae22-4a16-bd61-a672019e6803","relation":"relates_to","target_id":"968e-3515-e8f2-4567"},{"link_uuid":"6f14388a-2a34-4329-a53b-54df45692513","relation":"relates_to","target_id":"79c4-d7dd-29df-44df"},{"link_uuid":"7e287bb4-14aa-4311-801a-e7f8e3585346","relation":"relates_to","target_id":"ae25-6687-79cc-4977"}],"description":"## Context\n\nSibling-emitted candidate fixture specs assert a criterion should fire or stay silent for a real\nplan — from history, not current code. A wrong must-fire case admitted unverified encodes a false\npositive. One run cannot settle it — byte-identical material flipped verdict in\n208 of 551 pairs, so shipped specs use `epochs: 3`/`gate: at_least(2)`.\n\n## Approach\n\n**Rehydrate, then run.** The selector manifest lists candidates per criterion, each carrying\n`direction` (fire/no_fire) and a `review_event_uuid` — the join key to the review sidecar (`fixture_selection.py` schema, shared with the emitter prerequisite). A candidate's emitter `input` is a model-free\nprovenance descriptor, NOT plan text, so the runner does NOT run the finder on it. It loads the\nsidecar corpus the selector used (`corpus.build_corpus`, persisting verified rows\ncarrying the at-review material — `description`, `children` — keyed by `review_event_uuid`;\n`corpus.py:_build_sidecar_row`), and REHYDRATES each case's finder input from the matched row:\n`description` as plan text, and — for a container criterion — the row's `children` (persisted as bare ticket-id strings) NORMALIZED into the `{ticket_id, title, description}` records the container finder requires before dispatch. A candidate resolving to no verified row is withheld to drift as\nunrecoverable material (no finder call). It runs the criterion's current Pass-1 finder via\n`eval_solver.run_case(prompt_id, case, runner=live, repo_root=repo_root)` (`eval_solver.py:322`)\nwith `case[\"input\"]` the rehydrated material — not `calibrate_criterion`. Each case runs three times; `_fired(verdict)` (a finding present) is the observed verdict; a case matching its\n`expect` (`finding`/`pass`) in ≥2 of 3 runs REPRODUCES (current code still agrees with history).\n\n**Disposition.** A reproducing case is kept; a non-reproducing one is withheld to a drift report at\n`docs/experiments/plan-review-gate/fixtures/drift-report.md` (criterion, case id, predicted vs\nobserved, originating review `(ticket_id, review_event_uuid)`). To write a spec the runner reuses\nthe emitter's strict-only skeleton — `prompt`, `model`, `epochs`, `gate`, `coverage_threshold`,\n`scorers` (the deterministic gating scorer) — UNCHANGED, and rebuilds `dataset` + `gold_set` (1:1)\nfrom only the reproducing cases, each case's\n`input` being the runnable rehydrated material. The spec is written to\n`.rebar/evals/<prompt-id>.eval.yaml` via a temp file + atomic `os.replace` only when the filtered\ndataset is balanced (both sides non-empty), `gold_set` non-empty, and\n`validate_eval_spec(spec, strict=True)` returns zero errors; else withheld. The runner\nreturns an in-memory summary (admitted/withheld ids, drift entries, spend); the drift report and\nadmitted specs are the only files written.\n\n**No-shadowing guard.** A user `.rebar/evals/<id>.eval.yaml` WINS over a packaged built-in at load, so the runner SKIPS any criterion that is a\npackaged built-in in `src/rebar/llm/eval_specs/`.\n\n**Budget enforcement.** Before each criterion the run pre-flights\n`ledger.reserve(estimate_usd, ledger_path=<epic ledger>, cap_usd=250.0, reserve_usd=0.0)` against\nthis epic's `docs/experiments/plan-review-gate/fixtures/ledger.jsonl` (reserve_usd=0 ⇒ ceiling $250), then `finalize()`s priced ACTUAL usage. Because `finalize` prices real tokens that\ncan exceed the estimate, after EACH `finalize` the run re-reads cumulative spend and halts FATALLY\nbefore any further criterion if it meets/exceeds `cap_usd` — so $250 bounds actual finalized spend. The estimate tier follows the criterion's `exec` routing\n(`criteria.effective_routing`, ADR 0033): AGENT→`criteria-eval-agent`, else `criteria-eval-cheap`\n(the ledger's only two registered estimate keys); `exec: DET` is out of scope. Model parity pinned\nto production Pass-1 per ADR 0109.\n\n**Failure disposition.** Per criterion the two writes are STRICTLY ORDERED — atomic spec\n`os.replace` FIRST, ledger `finalize()` SECOND — with the ledger the sole resume oracle: a criterion\nis done iff its stable `run_id = f\"admission-{prompt_id}\"` is in the ledger. Crash between the two ⇒\nno ledger row ⇒ resume re-derives and the atomic write overwrites the orphan spec; crash after `finalize` ⇒ the\nspec already exists. A transient model/transport error is\nRETRYABLE (3×, exp backoff 1s/2s/4s); on exhaustion the criterion is left incomplete (no ledger\nrow; run continues). Both a `reserve` `BudgetExceeded` and the post-`finalize` cap breach are\nFATAL, stopping with finalized criteria admitted; `reconcile` recharges no recorded `run_id`.\n\n## Scope\n\nThe admission runner, its rehydration/disposition logic, the drift-report writer, and the\n`.rebar/evals/` specs.\n\n## Non-goals\n\nRepairing drift (each entry becomes a ticket linked `discovered_from` the epic); editing\n`src/rebar/llm/reviewers/`; scheduling re-runs (the self-healing loop owns it).\n\n## Testing\n\nUnit tests drive disposition with a scripted stub solver and stub sidecar index (no model); the\nlive run covers the real path.\n\n## Acceptance Criteria\n\n- [x] A must-fire case whose `review_event_uuid` resolves to a sidecar row runs the finder on that\n      row's rehydrated `description`, not the descriptor; scripted (fire, fire, silent) it is admitted\n      with that material as its `input` (`pytest`).\n- [x] A must-fire case scripted (fire, silent, silent) is withheld with a drift entry\n      (its originating review `(ticket_id, review_event_uuid)`); a case whose `review_event_uuid`\n      matches no verified row is likewise withheld as unrecoverable material, no finder call\n      (`pytest`).\n- [x] With the ledger at the ceiling, the first `reserve` raises `BudgetExceeded` and a\n      call-counting stub reports `0` model calls (`pytest`).\n- [x] When a finalized criterion's ACTUAL spend reaches/passes `cap_usd`, the run halts before the\n      next criterion (the breaching one stays admitted); `pytest` prices rows above the estimate.\n- [x] Every written spec passes the real `validate_eval_spec(spec, strict=True)` over each file\n      (`pytest`).\n- [x] A criterion matching a packaged built-in in `src/rebar/llm/eval_specs/` is skipped while a\n      same-id `.rebar/evals/` prior artifact is NOT; `pytest` asserts written and packaged basenames are\n      disjoint and the seeded id was processed.\n- [x] A criterion writes no `.eval.yaml` when its reproducing cases leave one side empty (drifting\n      its cases) or when a case raises before all finish (no partial file) (`pytest`).\n- [x] Resume is crash-consistent (`pytest`): a re-run recharges no finalized criterion (`reconcile`\n      returns the existing row, zero new calls); a spec file with no ledger row (crash between\n      writes) is re-derived to one ledger row.\n- [x] On a transient model/transport error the finder is retried 3×, then the criterion is left\n      incomplete (no `.eval.yaml`, no ledger row) and the run continues (`pytest`, a stub raising\n      transient errors).\n- [x] [non-codebase] A live admission run has completed over the full candidate set with the Pass-1\n      model pinned to its production class, and this epic's ledger records total spend >0 and ≤250.0\n      with a per-pass model id on every row.\n      provenance: environment=dev workstation, production Bedrock chain (bedrock:us.anthropic.claude-opus-4-8); principal=RebarBotNava <joeoakhart+bot@navapbc.com>; privilege_posture=production-equivalent; instrument=live-call — production Pass-1 at parity; ledger $37.65, 17 rows.\n- [x] [non-codebase] Each drift-report entry has a ticket linked `discovered_from` the parent epic.\n      provenance: environment=production rebar tickets store; principal=RebarBotNava <joeoakhart+bot@navapbc.com>; privilege_posture=production-equivalent; instrument=live-call — 71 tickets linked discovered_from the epic via the rebar library.\n\n## Definition of Done\n\n`make lint`/`make typecheck`/`make test` pass; live run completed; drift report and admitted specs\ncommitted; ledger spend ≤ $250.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/evals/fixture_admission.py","reason":"The reproduce-to-admit admission runner, its disposition logic, the drift-report writer and the budget pre-flight. Flat sibling of fixture_selection.py/fixture_emit.py (the evals/ package has no fixture_mining/ subpackage; a split would create <100-LOC files banned by module policy)."},{"path":".rebar/evals/","reason":"The admitted per-criterion fixture specs this run writes, for criteria that have no existing packaged spec."},{"path":"docs/experiments/plan-review-gate/fixtures/drift-report.md","reason":"The committed record of candidates that failed to reproduce, with historical and observed behavior."},{"path":"docs/experiments/plan-review-gate/fixtures/ledger.jsonl","reason":"This epic's own append-only budget ledger, separate from the plan-replay ledger."},{"path":"tests/unit/test_fixture_admission.py","reason":"Unit tests for the admit/withhold boundary under a stubbed solver, the budget refusal, strict spec validity and the no-shadowing invariant."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[[