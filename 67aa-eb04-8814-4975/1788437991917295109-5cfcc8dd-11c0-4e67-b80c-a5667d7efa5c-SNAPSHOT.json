{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788437991917295109,"compiled_state":{"alias":"managing-famed-junco","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"317dc94f96192e67820f40aed129c60b3aafdab5","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 67aa-eb04-8814-4975","material: 956a1e0df3201633","material-part: children 647ea2107ca5072f 0","material-part: description f276c25d69ca932d 7957","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact b6f57b21b6f013db 5","material-part: ticket_id 9322f7dbb87ae5ac 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: planning","rebar-version: 0.13.1 (317dc94f9619)","regver: aa61189569d34126","verified-at-sha:e40139de3f75ed23380ec59d03f2c1ce365ee920","plan-material-pin: prerequisite 092c-a664-2477-4d83 6aa839c8141cb75b","plan-material-pin: prerequisite fb55-04d6-4beb-4025 e12ed4ffaaa46b53","dep absent .rebar/evals/","dep absent docs/experiments/plan-review-gate/fixtures/drift-report.md","dep absent docs/experiments/plan-review-gate/fixtures/ledger.jsonl","dep absent src/rebar/llm/evals/fixture_admission.py","dep absent tests/unit/test_fixture_admission.py","read-set: 10","read-path: infra/terraform/main.tf","read-path: infra/terraform/versions.tf","read-path: src/rebar/llm/criteria/overlay.py","read-path: src/rebar/llm/evals/eval.py","read-path: src/rebar/llm/evals/eval_solver.py","read-path: src/rebar/llm/evals/fixture_emit.py","read-path: src/rebar/llm/evals/fixture_selection.py","read-path: