\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"6206b2d8da295743f8500d5ec30a7828f67aee71207658e5bb166abedd4a0b25","event_uuid":"3f08baef-001d-462b-a913-d90a2b79a332","position":{"commit_sha":"1bba58c13f205661d5ea9bbe0763de303f85941a","position":"1795277408238010001-3f08baef-001d-462b-a913-d90a2b79a332"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"2b570cfc1f0440470f6a5638796ec7a751b923c03e63f24791a2a1b2e4c3f15f","event_uuid":"982f7239-2656-4d6e-84aa-3cf35b57317a","position":{"commit_sha":"7ebcc08978c80890e0803f709dadb0f5782e365a","position":"1795277411615610001-982f7239-2656-4d6e-84aa-3cf35b57317a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"768c4f750650d6c3212ad39f5842d369306e2363b1bd66ebe1719e3079d1224f","event_uuid":"f754fd11-392f-4769-b47e-80eaf70bae91","position":{"commit_sha":"68cbee0a6a9657915bc1e306fdfc79a49f548347","position":"1795277428363459001-f754fd11-392f-4769-b47e-80eaf70bae91"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Patch set 2 changes the skip rule after LLM-Review -1 on 3500: the reducer resolves forked STATUS chains by smallest UUID, so 'latest STATUS' in collection order can disagree with it. A raising ticket is now skipped only when every event parsed and no STATUS event ever set closed; any close in the history (including closed-then-reopened) means it is judged. A reopened ticket that cannot be reduced therefore fails an enforcing gate; that is the intended fail-closed trade-off. New tests: test_unreadable_ticket_with_any_close_in_history_is_judged, test_one_compacted_event_makes_an_unreadable_ticket_judged (pins the compaction short-circuit).","timestamp":1795260855444466001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed as Gerrit 3500 patch set 2, merged 8469f0a5ede (LLM-Review +1, Verified +1). Checked on merged main: tests/unit/test_opcert_gate_config.py + test_verify_opcert*.py 33 passed; the closed-ticket tests failed against the old except/continue during development; complexity ratchet new=0 increased=0; mechanism ratchet exits 0. make verify green locally (21659 + 226 passed). Review advisories (non-dict data/fields crashes inside the handler; untested parse/non-object/empty-dir branches) filed as semidivine-proud-fieldmouse.","timestamp":1795276886923822001}],"completion_expectation":"required","created_at":1795245099520109001,"creation_channel":"cli","deps":[{"link_uuid":"56d562e1-9279-4603-93de-dcb18afb5d90","relation":"discovered_from","target_id":"eca7-e5b5-7640-403f"},{"link_uuid":"60a7a397-f686-4d34-8b3a-12acb289ddc7","relation":"relates_to","target_id":"7692-eb82-4b25-4869"},{"link_uuid":"3da18dba-e256-486f-afbd-939adffd0d6b","relation":"relates_to","target_id":"a979-17a6-b59e-4cfb"},{"link_uuid":"f754fd11-392f-4769-b47e-80eaf70bae91","provenance":"derived","relation":"caused_by","target_id":"eca7-e5b5-7640-403f"}],"description":"## Context / Problem\n\n`rebar verify-opcert` is the op-cert merge gate. In `_gate` (`src/rebar/_commands/verify_opcert.py`), a ticket whose `rebar.show_ticket(...)` raised was skipped with `except Exception: continue`. A closed ticket whose state could not be reduced then dropped out of scope, so with `verify.require_environment` set the gate could print OK and exit 0 while that ticket had no valid certificate. A security gate must fail closed on data it cannot read. Found while fixing golden-busied-nag.\n\nTwo more ways a ticket escapes, found in review: tickets are enumerated only from the merged-log walk (`_collect_all`, `src/rebar/_commands/verify_authorship.py`), and a SNAPSHOT that folded unsigned events adds nothing to that walk (`_build_authorship_ledger` in `src/rebar/_commands/compact_txn.py` keeps signed events only); and a ticket can become closed through a CREATE (`data.status`, `process_create`) or an EDIT (`data.fields.status`), not only a STATUS event.\n\n## Approach\n\n1. When `show_ticket` raises, decide from the ticket's raw event files, read straight from its directory with `_active_event_files`. New helper `_may_be_closed(ticket_dir)` returns true when there is no event file, any file does not parse, any file is a SNAPSHOT (compacted history of unknown content), or any event can set `closed` (`_sets_closed`: STATUS `data.status`, CREATE `data.status`, EDIT `data.fields.status`). Only when it is false (every event parsed, no SNAPSHOT, nothing ever closed) is the ticket out of scope. The gate does not re-derive which branch of a forked STATUS chain the reducer keeps (smallest UUID, `process_status` in `src/rebar/reducer/_processors_status.py`), since that reduce is what failed: a closed-then-reopened ticket that cannot be reduced is judged.\n2. A ticket that may be closed stays in scope with reason `unreadable ticket state (<ExceptionType>: <message>)` and is judged like any unsatisfied ticket: `_is_enforced` on the close anchor from `_close_anchor_event` (a missing anchor is enforced), failing the gate (exit 1) only when a required environment is set; advisory mode reports it and exits 0.\n3. New helper `_gate_ticket_ids(events, tracker)` enumerates the walk's tickets plus every ticket directory in the store, keeping the walk's exclusions (`_is_gate_exempt_ticket`, `_is_archived_ticket`), so a ticket the walk never yields is still considered.\n4. `_scoped_state` holds the try/except, so `_gate` does not grow in complexity.\n\nNo config key, env var or flag is added.\n\n## Scope\n\n- `src/rebar/_commands/verify_opcert.py`\n- `tests/unit/test_opcert_gate_config.py`\n\n## Testing\n\nIn `tests/unit/test_opcert_gate_config.py`, with the remote-backed fixture, `rebar.show_ticket` monkeypatched to raise `RuntimeError` for one ticket, and `verify_opcert.cli` run in-process:\n- closed ticket with `--require-environment`: exit 1, reason `unreadable ticket state (RuntimeError: ...)`; advisory: exit 0, reported; `--since` after its close: `[grandfathered]`, exit 0;\n- closed then reopened ticket: judged, exit 1;\n- in-progress ticket plus a raw SNAPSHOT, an EDIT writing `status: closed`, or a CREATE born closed (parametrized): judged, exit 1;\n- a ticket directory holding only a SNAPSHOT (absent from the walk): enumerated and judged, exit 1;\n- in-progress ticket with STATUS events only, and a ticket with only an open CREATE: out of scope.\nThe closed, SNAPSHOT, EDIT, CREATE and walk-absent cases fail against the previous code. Then `make verify`.\n\n## Acceptance Criteria\n\n- [x] With a required environment set, a closed ticket whose `show_ticket` raises makes `rebar verify-opcert` exit 1 and report `unreadable ticket state`: shown by a test that fails against `except Exception: continue`.\n- [x] In advisory mode such a ticket is reported with exit 0; under `--since` past its close it is reported `[grandfathered]` with exit 0.\n- [x] A raising ticket whose raw events include a SNAPSHOT, an EDIT or CREATE that sets `closed`, or any close in its history is judged; one whose parsed events never set `closed` and include no SNAPSHOT stays out of scope: shown by tests.\n- [x] A ticket directory the merged-log walk does not yield is still enumerated: shown by `test_ticket_absent_from_the_walk_is_still_enumerated`.\n- [x] `python scripts/check_complexity_baseline.py --check` reports `new=0 increased=0`, and `python scripts/check_mechanism_delta.py --check` exits 0.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_commands/verify_opcert.py","reason":"count unreadable closed tickets in scope"},{"path":"tests/unit/test_opcert_gate_config.py","reason":"prove the gate fails closed on an unreadable ticket"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","7692-eb82-4b25-4869"],["relates_to","a979-17a6-b59e-4cfb"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"3f08baef-001d-462b-a913-d90a2b79a332","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"995a-152d-fbbd-4624","ticket_type":"bug","title":"verify-opcert drops unreadable closed tickets from scope (fails open)","verify_commands":[]},"source_event_uuids":["60a7a397-f686-4d34-8b3a-12acb289ddc7","f909041e-82d2-4017-91c9-a9b8c47dda64","5154afac-414b-46db-9ad7-bc34f2467a96","dcaf39c4-0138-42dc-a572-71d945971a73","29c6087e-5096-40a0-8235-9843e5434811","3da18dba-e256-486f-afbd-939adffd0d6b","1e9c71c4-2114-467f-962d-eaa1c18ca48b","8bc56d1d-670b-4af9-8324-95deadf02ec6","3f08baef-001d-462b-a913-d90a2b79a332","982f7239-2656-4d6e-84aa-3cf35b57317a","f754fd11-392f-4769-b47e-80eaf70bae91"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795277428363459002,"uuid":"69faa879-aabd-4c00-8716-1e1933590048"}