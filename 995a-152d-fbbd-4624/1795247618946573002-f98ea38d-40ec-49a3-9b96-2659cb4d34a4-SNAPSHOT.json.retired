94c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"549e7136cc2c1d9e1249bd4d3b72440c0853b81d68889ac2aaf910cf87713055","event_uuid":"5b7a4514-f845-4742-9a41-8b1a9b4ec1a7","position":{"commit_sha":"fafd1dae0c02b3bb554e81b263a7dff4419ad929","position":"1795246665200237001-5b7a4514-f845-4742-9a41-8b1a9b4ec1a7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"a631be9d5ae5fbc072ce84e61e9cf0f1812706c32646849e3bc7d62aef528d24","event_uuid":"ac1f6b61-de18-49ff-951d-ffe1dba3065e","position":{"commit_sha":"20e898fabe8377d729cda431b14beb7bc208c729","position":"1795247500580371001-ac1f6b61-de18-49ff-951d-ffe1dba3065e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"78a05d0bdc0e5603ee8133bcd8fc8d2b822f90426ba1f37d01e422328f379d4f","event_uuid":"69dfb804-dd74-4926-b379-b7762b40a8eb","position":{"commit_sha":"cc941cc65b230706ec211acc5d80fc655e257572","position":"1795247601055178001-69dfb804-dd74-4926-b379-b7762b40a8eb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"0c128f42b4536c1ab291add447c3dfb7152abd4049d7f60d411724a106e73b8d","event_uuid":"3f1a1331-138c-4a8b-bf6c-fa2446cd0af9","position":{"commit_sha":"cc941cc65b230706ec211acc5d80fc655e257572","position":"1795247618946573001-3f1a1331-138c-4a8b-bf6c-fa2446cd0af9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[],"created_at":1795245099520109001,"creation_channel":"cli","deps":[{"link_uuid":"56d562e1-9279-4603-93de-dcb18afb5d90","relation":"discovered_from","target_id":"eca7-e5b5-7640-403f"}],"description":"## Context / Problem\n\n`rebar verify-opcert` is the op-cert merge gate. In `_gate` (`src/rebar/_commands/verify_opcert.py`, the per-ticket loop after `ticket_ids = sorted(...)`), a ticket whose `rebar.show_ticket(...)` raises is skipped with `except Exception: continue` (\"an unreadable ticket is treated as out of scope\"). A closed ticket whose state cannot be reduced therefore drops out of scope: it is neither satisfied nor a problem, and with `verify.require_environment` set the gate can print OK and exit 0 while that ticket has no valid certificate. A security gate must fail closed on data it cannot read. Found while fixing golden-busied-nag, whose plan review showed a raising config read inside `show_ticket` led to \"0 closed ticket(s) in scope\" and exit 0.\n\n## Approach\n\nWhen `show_ticket` raises, skip the ticket only when the raw merged log PROVES it is not closed now; otherwise judge it. New helper `_provably_not_closed(events, ticket_id)` in `verify_opcert.py` returns true only when every one of the ticket's `_ScopedEvent`s parsed (no compacted SNAPSHOT ledger entry, which `_collect_all` in `src/rebar/_commands/verify_authorship.py` yields with `event=None`) and the latest STATUS event's status is not `closed`. So:\n- latest STATUS non-closed (open, in_progress, reopened after a close): out of scope, unchanged;\n- latest STATUS `closed`, a SNAPSHOT entry present (compacted), or no STATUS event at all: in scope with reason `unreadable ticket state (<ExceptionType>: <message>)`. It is then judged like any unsatisfied ticket: `_is_enforced` on the close anchor from `_close_anchor_event` (a missing anchor is enforced, fail closed), failing the gate (exit 1) only when a required environment is set; advisory mode reports it and exits 0.\nA second helper `_scoped_state` holds the try/except so `_gate` does not grow in complexity. Event files `_event_from_file` cannot parse are dropped before this point; that is unchanged and out of scope.\n\nNo config key, env var or flag is added.\n\n## Scope\n\n- `src/rebar/_commands/verify_opcert.py`\n- `tests/unit/test_opcert_gate_config.py` (the gate's fixture helpers live here)\n\n## Testing\n\nIn `tests/unit/test_opcert_gate_config.py`, with the remote-backed fixture and `rebar.show_ticket` monkeypatched to raise `RuntimeError` for one ticket, run `verify_opcert.cli` in-process:\n- closed ticket, `--require-environment`: exit 1, reason `unreadable ticket state (RuntimeError: ...)`;\n- closed ticket, advisory: exit 0, ticket reported;\n- closed ticket, `--since` after its close: `[grandfathered]`, exit 0;\n- compacted closed ticket (its events seen with `event=None`): exit 1;\n- closed then reopened ticket: out of scope, exit 0;\n- ticket whose latest STATUS is `in_progress`: out of scope;\n- ticket with no STATUS event: judged, exit 1.\nThe 3 closed-ticket cases fail against the current `except Exception: continue`. Then `make verify`.\n\n## Acceptance Criteria\n\n- [ ] With a required environment set, a closed ticket whose `show_ticket` raises makes `rebar verify-opcert` exit 1 and report `unreadable ticket state`, including when the ticket is compacted: shown by tests in `tests/unit/test_opcert_gate_config.py` that fail against the current `except Exception: continue`.\n- [ ] In advisory mode such a ticket is reported and the exit code is 0; under `--since` past its close it is reported `[grandfathered]` with exit 0.\n- [ ] A raising ticket whose latest STATUS is not `closed` (including a reopened one) stays out of scope; one with no STATUS event is judged.\n- [ ] `python scripts/check_complexity_baseline.py --check` reports `new=0 increased=0`, and `python scripts/check_mechanism_delta.py --check` exits 0.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_commands/verify_opcert.py","reason":"count unreadable closed tickets in scope"},{"path":"tests/unit/test_opcert_gate_config.py","reason":"prove the gate fails closed on an unreadable ticket"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"69dfb804-dd74-4926-b379-b7762b40a8eb","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"995a-152d-fbbd-4624","ticket_type":"bug","title":"verify-opcert drops unreadable closed tickets from scope (fails open)","verify_commands":[]},"source_event_uuids":["60cce3f9-70ef-4af1-b56c-5e53af2756eb","56d562e1-9279-4603-93de-dcb18afb5d90","097292d5-ba87-4f9f-a005-4357cb371418","5b7a4514-f845-4742-9a41-8b1a9b4ec1a7","ac1f6b61-de18-49ff-951d-ffe1dba3065e","69dfb804-dd74-4926-b379-b7762b40a8eb","3f1a1331-138c-4a8b-bf6c-fa2446cd0af9"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1795247618946573002,"uuid":"f98ea38d-40ec-49a3-9b96-2659cb4d34a4"}