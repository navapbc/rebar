{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795275206935208002,"compiled_state":{"alias":"neglectful-acceptable-gerbil","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"2806e12d6a1e5787fc0f9618574b85d0f339eee0","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 51c6-9f1d-595b-411f","material: e384bee08db843de","material-part: children 647ea2107ca5072f 0","material-part: description b5632ce7195ba897 6080","material-part: description_boxes 6c179f21e6f62b62 0","material-part: file_impact 3d21a580adbee5a4 10","material-part: ticket_id 3446df5aa696888e 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 7","review-phase: planning","rebar-version: 0.16.0 (2806e12d6a1)","regver: aa61189569d34126","verified-at-sha:2806e12d6a1e5787fc0f9618574b85d0f339eee0","plan-material-pin: prerequisite e062-1686-1a27-41a4 fb1477d77178b369","dep 9c3db821648bdffd42de0aa8478b52307bcdfc9806e3646f1eeef2d844ddd596 .gitattributes","dep 66cf06ae1bfb91d6fed0746744b3c0ad724f4061d4260efcf6c12cb400376cb6 .github/windows-sweep-deselect/crlf.args","dep 69cf1c0965567f4a2f5d7532262008fae2b68210b6127414821be47bfe70a575 .github/workflows/test.yml","dep ead56d395983ab0606953a5c4368964a7860e5bf9ad3b1aee18a1601100d105b src/rebar/_store/gitutil.py","dep 753f6f6d8648039fcf357a2e5c55bffa1c51b55fd49723b6b7e7aba373102a33 src/rebar/llm/evals/plan_replay/tier2.py","dep 3f2d078e95786696c0ff33a52af6b730eae3564e241da481cb68a5ac83ca5376 tests/external/live_jira_dc/_dc_fixtures.py","dep dabbe5031e6ce14d9196c29a5da5a5b1dd71eab3b9a015ed97aac90b7a30d9ad tests/integration/test_reclaim_bridge_history.py","dep 7aebbf3221d1ddd16ddf0f34c85e1cf4840f0570c6529797290a816f850c530c tests/unit/evals/test_plan_replay_tier2.py","dep ccbce31055e9d52bad204ea41f077554c375e031918a39553e9f50f96f8d3c9d tests/unit/test_mcp_publisher_pin.py","dep absent tests/unit/test_run_git_stdin_bytes.py","read-set: 18","read-path: .gitattributes","read-path: .github/windows-sweep-deselect/crlf.args","read-path: .github/workflows/test.yml","read-path: src/rebar/_commands/_init_ensures.py","read-path: src/rebar/_commands/reclaim_collapse.py","read-path: src/rebar/_snapshot/delta_tree.py","read-path: src/rebar/_store/gitutil.py","read-path: src/rebar/llm/evals/plan_replay/tier2.py","read-path: src/rebar/llm/workflow/snapshot.py","read-path: src/rebar/reconciler/_ref_lock.py","read-path: tests/conftest.py","read-path: tests/external/live_jira_dc/_dc_fixtures.py","read-path: tests/integration/test_reclaim_bridge_history.py","read-path: tests/interfaces/store/test_txn_transient_retry.py","read-path: tests/unit/test_git_ssh_output_encoding.py","read-path: tests/unit/test_mcp_publisher_pin.py","read-path: tests/unit/test_run_git_wrapper.py","read-path: tests/unit/test_windows_sweep_deselect.py","currency-basis: file_impact"],"material_fingerprint":"e384bee08db843de","merged_log_commit":"2806e12d6a1e5787fc0f9618574b85d0f339eee0","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1795275071246318000}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":0},"authorship_ledger":[{"content_hash":"5ccd284f86314c044114f50ef48ef496b37b2ed6f584c6c761cbfbdfe00710b4","event_uuid":"464d5fe3-771b-43ea-8b2b-296c90afa216","position":{"commit_sha":"92b26f2d7fd4d9f35b005dc50eb4213adc74aad4","position":"1795261965856911001-464d5fe3-771b-43ea-8b2b-296c90afa216"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"a18956fc7290c24f0456144556735c06d8257c9118bbecdba786f08dd9c1bde7","event_uuid":"8f893a03-3f14-476c-9f38-029d9a0a60e8","position":{"commit_sha":"97305781abb4388c8658d21ca81f9a15dae34b62","position":"1795261989624841001-8f893a03-3f14-476c-9f38-029d9a0a60e8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"b61a7624794d7eb95faeea0a0017a4821450f4c1310ade664c5e956b04ae44e8","event_uuid":"245d8bcf-e220-4f3a-a048-fd36a540c268","position":{"commit_sha":"e11b0965c43088e76c97a9cece4071cb63da7cae","position":"1795272548169545001-245d8bcf-e220-4f3a-a048-fd36a540c268"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"4aca8cefbdd13725fdecf88ebcd96e282205f00a889cbc38be02874d093ad0c1","event_uuid":"99976b82-fa30-4d85-b8e3-9d91b3867987","position":{"commit_sha":"bff4be2ec6c09603fc424d50083ce80ea6774159","position":"1795272709842890001-99976b82-fa30-4d85-b8e3-9d91b3867987"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"c