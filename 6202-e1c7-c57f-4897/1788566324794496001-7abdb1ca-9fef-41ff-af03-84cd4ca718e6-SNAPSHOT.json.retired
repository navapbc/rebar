{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788566324794496001,"compiled_state":{"alias":"endowed-upset-scaup","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"ebbcd7a030d6029216127c83fb43c415117af366","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6202-e1c7-c57f-4897","material: 391a3cd0be23b771","material-part: children c2e944f86b37670f 6","material-part: description bc4f6d7b37ae5f42 5374","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 5121f1ed25fbfcb6 12","material-part: ticket_id 4fcf2e77f4a32c0b 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 8","review-phase: planning","rebar-version: 0.13.1 (ebbcd7a030d6)","regver: aa61189569d34126","verified-at-sha:ebbcd7a030d6029216127c83fb43c415117af366","plan-material-pin: child 2ba3-bf77-1303-4b2d a03dc931a1d5a8f3","plan-material-pin: child 7dfa-18ca-9c04-4691 d9957499d3dee65d","plan-material-pin: child 910b-2d43-4482-4c64 d56f60de42202368","plan-material-pin: child 9183-aaae-667d-45e6 2b88aad330e8c379","plan-material-pin: child aa40-cbda-ee38-481c a29a80c8b59c3476","plan-material-pin: child e956-b1c3-45b9-4016 cd03d66a056b30f9","dep 7aaf5db2d6df53b62d58fb69c722e773d1ba2b6357b911d6671bef6cb4d22f8c docs/adr/.numbers/0110","dep absent docs/adr/0110-gerrit-disk-ceiling-architecture.md","dep 22ce9cb28a2a897ec61da30d6b9034d3a823c6fb3a5b7db7735a9db22ccd06cb docs/adr/README.md","dep fb7f1ba20bd98119a17b6577aa1e083bd59f03a8305b60cf9c4b5c621e635f2b infra/compose/docker-compose.yml","dep c34247ab725b8e0531a3058233295130226a70bd75f630de62f61d2f06ddd535 infra/runbooks/provision-restore.md","dep f8f856afe4a74e5a069ef60b4efe002228460fc37dc9a8c8856cc2c5c4a2936d infra/runbooks/review-bot-ops.md","dep f826f8f87722e07f60c8141d04500ea5d1a672ef6f40fe3233b090aff5433fd4 infra/scripts/autodeploy.sh","dep 9fa321e7055acd4c3ef980455c21aae832bab26857af74ed9309d91d6c167370 infra/scripts/compose-up.sh","dep absent infra/scripts/install-disk-ceilings.sh","dep 4d0a97c44d16fc56bd9a989bb8322cec3c629473ae92fe632177234a102b7431 infra/scripts/observability.sh","dep 478a87b14beeba1211b9efd4b0c2bc0e7d9ef1bbd8b58700bc1d7f8314b334a1 infra/terraform/main.tf","dep 742a22231214c65a462de6e46a57da4229d2c277b4ad25e740252ab7a2595d28 infra/terraform/monitoring_autodeploy.tf","dep 917b825738bcd0a1835b4cb44585a0d115047acaec4b4101afd414d19f0dc5fa infra/terraform/user_data.sh","dep 2d4e3e19c8c746360043255f70ed807f3b657d4c700317fb5d4d1fa5f6648207 infra/terraform/variables.tf","dep e834d418d0bc63b81cac0fa905320fe747ec0e8f01708a86948e1b5589689f1c tests/scripts/test_autodeploy_disk_pressure.py","dep 0d0037abb77d917231d7f38bdf7f5ffb227fc68c4ee1c6ecc060835d3391ba04 tests/scripts/test_autodeploy_materialize_probe.py","dep 2a983d2db79e5fa27845c14c61fa54dbfa76c834ce4ac8b56e0f8112cacdc185 tests/scripts/test_observability_disk_pressure.py","dep fc0c7581ac8515f0add196dc8df40fdc2cc409d47f36cd76221274cec0e9e7ed tests/unit/test_alarm_actions_terraform.py","dep de87a27e9d927d32865066e280da6a2de00e0584bca1c38c01f58b0b5152e4a2 tests/unit/test_autodeploy_prune.py","currency-basis: file_impact"],"material_fingerprint":"391a3cd0be23b771","merged_log_commit":"ebbcd7a030d6029216127c83fb43c415117af366","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788477612190264000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":19,"unsigned":0},"authorship_ledger":[{"content_hash":"f8fc70a861f2683e938a3895560d9a7790c9703faccac145db3460b6fbeb8ff2","event_uuid":"c7f0d655-5783-4e01-9ef8-2ef341317ff3","position":{"commit_sha":"36a81edc54a73e032b3f0605a9ca2f94af63e980","position":"1788477049323282001-c7f0d655-5783-4e01-9ef8-2ef341317ff3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"06d5f06bba6465685e4e67ae95dfffe13cd1af3b3f23a5c1901259dce21953e0","event_uuid":"92bfb06b-d766-410d-b1d8-0b5974102450","position":{"commit_sha":"140fd3c9ecef1467022fe424cfe8aa4696656461","position":"1788477612194062001-92bfb06b-d766-410d-b1d8-0b5974102450"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a05f43a1c0a05ac9b1e947eaac41331f7b0ee9b5f1017df062ee0e68505076b5","event_uuid":"d9be75b7-f4a8-4b7a-ad32-34622bf0e5ba","position":{"commit_sha":"5df714bd03a3eb9c092ffdbb89221ef1c8f0b675","position":"1788477659202260001-d9be75b7-f4a8-4b7a-ad32-34622bf0e5ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"52bc54fbc00cce03593c8028dbe899ab8a8b65b2a4107bd50f2fb082e2c355af","event_uuid":"2bde4b9d-1ad0-4ef8-9788-685f2c70adbc","position":{"commit_sha":"5df714bd03a3eb9c092ffdbb89221ef1c8f0b675","position":"1788477661454083001-2bde4b9d-1ad0-4ef8-9788-685f2c70adbc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"dbdc0cca1b1a649a056cac1a23f7e7abb5769dfc6bcfbdfe95d3dd4d622baa69","event_uuid":"a91999e1-85a2-40f9-9494-fa409edd9914","position":{"commit_sha":"147c9a12db9454ce985bd888c342ebf301ba21d3","position":"1788478767177420001-a91999e1-85a2-40f9-9494-fa409edd9914"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c924714ba5777c57f957eb01af359598a4f21ca27315fd3238fd11129d997a69","event_uuid":"531af0d3-d3cb-42d0-9021-2844e4a0f3a3","position":{"commit_sha":"1da61752831f662fd948797da5cb8e71c418bb4e","position":"1788480271525422001-531af0d3-d3cb-42d0-9021-2844e4a0f3a3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1dd8d1a918fd460e9fe1fb9053fec8aa9ac7b63bf3606749f47d18c183695eeb","event_uuid":"dff0f846-9db0-4bc1-a8cd-a145b2fe24a2","position":{"commit_sha":"91ebe1e6766b384033a25f0e50365dcb551d5f45","position":"1788480308181519001-dff0f846-9db0-4bc1-a8cd-a145b2fe24a2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c612bc5e688f662627e37ba2c1c6b300c7d4fd1c60a11046ee440bc7deff83bb","event_uuid":"af18c477-3274-46a3-a631-0d3e6065a4ad","position":{"commit_sha":"4a8be18aeecc4ca2f25cdff2f119d2d8f4857dbc","position":"1788480878226263001-af18c477-3274-46a3-a631-0d3e6065a4ad"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fe900460fca581179fa479612494575b15da26f41ec14cf4a56644c994930167","event_uuid":"c2a2cc3c-cf52-4af2-bada-0fcad9b2ce11","position":{"commit_sha":"d18638f6327345a16404b6e79ef0e152b0348260","position":"1788481767603639001-c2a2cc3c-cf52-4af2-bada-0fcad9b2ce11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"24de57fb700940e956b21890e5a15ba143743abb17fa60a31c63074ab699ad2a","event_uuid":"467c31f6-f36b-453a-8ee6-0e0182152445","position":{"commit_sha":"a6e46eca33087a564b70ab01f568a7f3716e5554","position":"1788528848565356001-467c31f6-f36b-453a-8ee6-0e0182152445"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5d4817f5181e679f17f059f99fb148927e594509b041bf26159a9e5139621f34","event_uuid":"b0b5f001-8b1c-45e3-ab2a-ebc6341c17a4","position":{"commit_sha":"a571d5f1e7dcfd66b69a394939eaf87bb1216b33","position":"1788560523868178001-b0b5f001-8b1c-45e3-ab2a-ebc6341c17a4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-259_agent","claim_remote_session":null,"claimed_session":"72e08d92-bab9-41e6-a77e-0524c3443c0b","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"EPIC CLAIMED and extended with a seventh story (2026-09-03). Recording the operator decisions on the ticket itself so they do not live only in the session log (crystal-parodistic-boar / ba7f-f1c0-20e7-4dbc).\n\n## New story: S6 grusome-ecumenical-polarbear (09da-343c-1ee9-480c)\n\n\"Fast-fail gate admission above a configurable concurrency cap.\" Added on operator input that ~10 plan reviews run in parallel routinely, plus code reviews and autodeploy contending for the same volume.\n\nWHY IT IS LOAD-BEARING, not additive: Option A caps each accumulator via a high-water-mark GC, and such a GC assumes evictable data exists. src/rebar/_snapshot/janitor.py documents that it relies on POSIX delete-on-last-close plus touch-on-read mtime recency and deliberately takes NO per-reader lease — a PID+heartbeat lease was spiked and REJECTED as unsound (N readers per entry, PID reuse, crash-stale leases), following Gitaly/Sourcegraph/Bazel/ccache — and it skips entries inside a grace window. So the janitor may UNLINK an in-flight snapshot, but the blocks are not returned until the last reader closes.\n\nUnder ~10 concurrent reviews the held bytes are therefore LIVE, not garbage. A cap set below peak concurrent hold cannot be honoured: the GC runs, finds nothing evictable, and the volume fills anyway. That is the same shape as the failure this epic exists to fix — bug 3276 measured prune's reclaimable ceiling at ~1.06 GB against a 29 GB problem.\n\nWithout S6, S2-S5's caps are aspirational under exactly the load that causes the incident. S6 therefore BLOCKS S2, S3, S4 and S5 (edges added), and is itself blocked by S0.\n\nDESIGN (operator-specified): one configurable limit shared by plan-review AND completion-verifier, since both create a copy of the repo at a ref and contend for the same disk. At capacity the call FAST-FAILS with a clear \"try again later\" congestion message rather than queueing, so clients can modulate their own load. Fast-fail over queueing is deliberate — a queued gate still holds its thread and ~739 MB of resident memory while waiting, so a queue converts disk pressure into memory pressure. The rejection must be distinguishable from a gate verdict so an agent does not read congestion as INDETERMINATE or as a failed review.\n\n## Cap values (operator decision)\n\nDerive each cap from measurement as a sensible DEFAULT, and make it settable via a config value — not a hardcoded constant. Grounding available: root working set at the outage was 28G — /var/lib/docker 17G (overlay2 16G across 67 layer dirs), /var/tmp 3.6G, /var/log 1.8G (journal 1.7G) — with ~6.5 GB of that orphaned overlay2 invisible to prune. Note each new config key trips the shrink-only mechanism ratchet and needs an in-tree justification marker naming its ticket, never a baseline edit.\n\n## Tree shape — this lands as ONE STACK\n\nS2-S5 are NOT file-disjoint: all four touch infra/scripts/observability.sh, infra/scripts/compose-up.sh and infra/scripts/install-disk-ceilings.sh. Parallel worktrees are only licensed for genuinely disjoint leaves, so the seven stories land as a single ordered Gerrit stack. The plan-review gate independently reached the same conclusion (advisory P5: \"sibling tickets touch the same file(s) with no ordering edge\").\n\n## Three gate advisories the implementation must honour\n\n1. Epic AC4 (\"existing root/data disk alarms remain present; the cyclopean missing-data fix is not regressed\") is covered by NO child story's acceptance criteria. It needs an explicit check in whichever leaf lands last, or its own criterion.\n2. S2 and S5 overlap: writable container layers live IN overlay2, so their caps interact and must be designed as one budget rather than two independent ones.\n3. S4's /var/tmp cap conflicts with sibling task 3e92 (scowlful-bovine-dragonfly), which documents /var/tmp/rebar-evidence/<ticket>-<stamp>/ as the trap-cleaned evidence location. Capping /var/tmp must not evict evidence mid-investigation.\n\n## Attestation note\n\nThe epic's plan-review needed two runs: the first returned INDETERMINATE with zero blocking findings, cause llm-degrade NEEDS_INVESTIGATION (LLM infrastructure, not a plan defect — prior tickets exist for the same condition on completion-verify). The retry PASSED and signed at head_sha ebbcd7a030d6029216127c83fb43c415117af366.","timestamp":1788478767177420001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"ADR number and slug reconciled to 0112 across AC1, the 'ADR draft location' note and all 12 file_impact paths. The epic had been stale since the FIRST renumber (0110 -> 0111), not just the second, and the plan-review gate on S0 caught it as a parent/child divergence rather than S0 catching it itself.\n\nS0 (7dfa / livid-blondish-shearwater) is claimed and pushed as Gerrit change 2598. Next is S6 (bounded gate concurrency), which is the precondition for S2-S5: the snapshot janitor reclaims by high-water mark and relies on POSIX delete-on-last-close, so bytes held by an in-flight gate are live rather than garbage, and a cap below peak concurrent hold cannot be honoured by reclamation alone.\n\nDesign note carried forward from research: a fast-fail admission seam already exists (review_bot/low_disk.py plus janitor.py's ensure_min_free_space / SnapshotLowDiskError / DEFAULT_MIN_FREE_GIB, which already refuse BEFORE cloning on a free-space floor). S6 should add a concurrency term to that existing seam rather than build a parallel mechanism -- which also keeps it clear of the mechanism-delta ratchet. Separately, REBAR_GATE_TMPDIR already parameterises the snapshot store's base dir, so the dedicated-scratch-volume option is largely config rather than new code.","timestamp":1788480878226263001}],"created_at":1788374862839289515,"creation_channel":"mcp","deps":[{"link_uuid":"4f0d1cee-2bf2-4a98-af81-ff3106f4ebc0","relation":"discovered_from","target_id":"3276-2f81-8c75-4ddd"},{"link_uuid":"cb427de5-c909-4271-a40e-f7a6d3056882","relation":"relates_to","target_id":"3e92-b7f4-dede-4c17"},{"link_uuid":"c7f0d655-5783-4e01-9ef8-2ef341317ff3","relation":"relates_to","target_id":"ba7f-f1c0-20e7-4dbc"},{"link_uuid":"c2a2cc3c-cf52-4af2-bada-0fcad9b2ce11","relation":"relates_to","target_id":"ae97-a37b-9fa3-413a"},{"link_uuid":"467c31f6-f36b-453a-8ee6-0e0182152445","relation":"relates_to","target_id":"1ef8-c849-5801-4eee"},{"link_uuid":"b0b5f001-8b1c-45e3-ab2a-ebc6341c17a4","relation":"relates_to","target_id":"1205-63b2-2c01-4e7f"}],"description":"# Bounded disk-ceiling architecture for the Gerrit host\n\n## Context\nDiscovered from `cyclopean-bloodshot-hoatzin` (`3276-2f81-8c75-4ddd`), the 2026-09-02 root-volume outage that took Gerrit offline for ~5h. Defect 2 from that incident (disk alarms self-cleared when metrics stopped because `treat_missing_data=notBreaching`) stays on that bug and was fixed/landed/applied live. This epic is Defect 1: root-volume consumers grow without a bounded ceiling.\n\nOperator-approved design — firm standing intent, do not re-litigate:\n\n1. **Option A: per-accumulator HARD SIZE CAPS via native GC/retention.** Each disk consumer gets a hard upper bound enforced by its own native garbage-collection or retention mechanism. Consumers to cap: Docker overlay2/image layers + build cache (BuildKit/Docker GC policy with `maxUsedSpace` / `--keep-storage` style limits), `/var/tmp` (tmpfiles cleanup plus a real size/quota mechanism where required), journald (`SystemMaxUse`), and writable container layers (runtime storage quota where supportable, or bounded periodic reaping of exited containers). **Hard operator constraint:** every capped generator must have its own CloudWatch alarm at/near its cap, so capacity visibility names the saturated generator rather than only saying \"root disk high\".\n2. **Option C: separate EBS volume for code-review scratch.** Gate scratch/clones/snapshots currently share root via system temp (e.g. `/tmp/rebar-gate-snapshots`). Move this workload to a dedicated, independently sized/quota'd gp3 EBS volume mounted at a documented path, and configure gate temp/snapshot code so review work can never fill the OS/root disk.\n3. **Sibling carried from cyclopean AC5:** fold in `scowlful-bovine-dragonfly` (`3e92-b7f4-dede-4c17`), the `/var/gerrit` data-volume prevention/runbook task, by linking it into this epic rather than duplicating it.\n\nThe root volume was grown 30→60 GiB during recovery and should stay 60 GiB, but that is headroom only, not the fix: an unbounded generator can fill 60 GiB as readily as 30 GiB.\n\n## Scope\nThis epic scaffolds and later implements the approved architecture only. Defect 2 alarm-missing-data remediation remains on `cyclopean-bloodshot-hoatzin`. The full ADR draft is captured in child S0 to keep this epic below the 8,000-character plan-review admission cap; no ADR file is created by this scaffold-only work.\n\n## Research grounding\n- Current Terraform owns a single EC2 host plus `/var/gerrit` data EBS volume: `infra/terraform/main.tf:27-35`, `:42-64`, `:83-87`; size variables are in `infra/terraform/variables.tf:13-23`.\n- `infra/terraform/user_data.sh:20-70` is the existing attach/mount pattern: resolve Nitro NVMe device by EBS volume id, format idempotently, mount by UUID in `/etc/fstab`.\n- `infra/scripts/compose-up.sh:21-31` and `:82-99` create Docker bind volumes under `/var/gerrit/site`; current review-bot compose has no tmp/scratch mount and notes `REBAR_GATE_TMPDIR` is unset (`infra/compose/docker-compose.yml:233-245`).\n- Snapshot store and clone locations: `src/rebar/_snapshot/repo_snapshot.py:149-163` uses `REBAR_GATE_TMPDIR` else `tempfile.gettempdir()` and creates `rebar-gate-snapshots`; `src/rebar/review_bot/voter.py:381` clones into `tempfile.TemporaryDirectory(prefix=\"reviewbot-\")`; `src/rebar/review_bot/low_disk.py:69` checks free space on `tempfile.gettempdir()`.\n- Observability/alarm seams: `infra/scripts/observability.sh:72-90` publishes current data/root disk metrics; root alarm is `infra/terraform/monitoring_autodeploy.tf:207-239`; data alarm is `infra/terraform/monitoring.tf:217-244`.\n- Existing reactive reclaimers are in `infra/scripts/autodeploy.sh:132-140`, `:367-384`, and `:410-445`; runbook coverage is `infra/runbooks/review-bot-ops.md:494-606` and provisioning order is `infra/runbooks/provision-restore.md:98-138`.\n- Prior incident tickets found: `resting-feudalist-screamer` (`2731`), `masonic-abeyant-stagbeetle` (`3a52`), `besotted-witty-murrelet` (`e4f3`), `preodorous-temporary-piglet` (`3cef`), current `cyclopean-bloodshot-hoatzin` (`3276`), plus data-volume sibling `wakeful-ordinary-chicken` (`5a05`).\n\n## ADR draft location\nS0 `livid-blondish-shearwater` contains the full ADR draft to land later as `docs/adr/0112-on-box-disk-ceiling-architecture.md` plus `docs/adr/.numbers/0112`, matching `docs/adr/README.md` and recent ADR format. Related accepted ADRs to cite: ADR 0005, ADR 0012, ADR 0069/0077, and ADR 0104.\n\n## Acceptance Criteria\n- [ ] ADR 0112 is finalized and landed in `docs/adr/` with number marker and index update if required by repo convention.\n- [ ] Dedicated gate-scratch EBS volume exists, is mounted at a documented path, is used by gate snapshots and review clone tempdirs, and has its own disk alarm.\n- [ ] Each named root accumulator has an enforced cap and its own CloudWatch alarm at/near cap.\n- [ ] Existing root/data disk alarms remain present; the cyclopean missing-data fix is not regressed.\n- [ ] `scowlful-bovine-dragonfly` is linked as the carried-over `/var/gerrit` sibling and is resolved or explicitly dispositioned before epic close.\n- [ ] Runbooks document steady-state ceilings, per-generator alarms, and emergency remediation.\n- [ ] Portability criterion: implementation is Terraform + host Docker/systemd config + host metrics, with local/scripted validation; it does not depend on any single CI provider trigger.\n\n## ADR number/slug corrected 0110 -> 0112 (2026-09-03)\n\nThis epic's AC1, its \"ADR draft location\" note and its `file_impact` originally named\n`docs/adr/0110-gerrit-disk-ceiling-architecture.md` / `.numbers/0110`. That number and slug are\nboth superseded; the deliverable is `docs/adr/0112-on-box-disk-ceiling-architecture.md` /\n`.numbers/0112`. Parent and child now name the same deliverable.\n\n**Why the number moved twice.** The original plan asserted \"the highest current number is 0109\"\nand selected 0110 — that research was already stale: `docs/adr/0110-change-shape-advisory-not-blocking.md`\nand its marker had landed in commit 8f19115cf2fb. S0 was renumbered to 0111, and then 0111 was\ntaken too, by in-flight Gerrit change 2592 (`docs/adr/0111-no-internal-only-compatibility-shims.md`\nplus `.numbers/0111`), which was further along. 0112 is the next free number: `.numbers/` on\n`origin/main` holds 0091-0110, change 2592 holds 0111, and no other in-flight change (2593-2597)\ntouches `docs/adr/` at all.\n\n**Why this keeps happening.** `scripts/check_adr_numbers.py` asserts a bijection between\n`.numbers/` markers and ADR files, so a collision is caught — but only at gate time, and the\nreservation marker is only created when the ADR is *authored*. Two agents drafting concurrently\nwill therefore keep colliding, and a plan that reads the highest number at planning time is stale\nby the time it lands. Worth a mechanism ticket if it recurs a third time.\n\n**The slug also changed, and the wording is load-bearing.** `docs/adr/README.md` is GENERATED by\n`scripts/gen_adr_index.py` (it carries a do-not-edit-by-hand marker) and that script buckets ADRs\ninto sections by keyword-matching the slug. `on-box` files it under **Infra & deploy**, alongside\n0012, 0079 and 0104 — the ADRs it cites. A slug containing `gerrit` mis-files it, and the\n\"Reconciler & Jira sync\" group claims the keyword `bound`, so `bounded-disk-ceiling-...` would\nmis-file too. Regenerate README; never hand-edit it.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"docs/adr/0112-on-box-disk-ceiling-architecture.md","reason":"ADR to record the approved disk-ceiling architecture. [Number/slug corrected 0110 -> 0112: 0110 and 0111 were both taken by other changes. Slug must keep \"on-box\" so gen_adr_index.py files it under Infra & deploy.]"},{"path":"docs/adr/.numbers/0112","reason":"ADR number marker required by docs/adr convention. [Corrected 0110 -> 0112.]"},{"path":"docs/adr/README.md","reason":"ADR index/category entry if repository convention requires regeneration."},{"path":"infra/terraform/main.tf","reason":"Epic implementation will add a gate-scratch EBS volume and attachments."},{"path":"infra/terraform/variables.tf","reason":"Epic implementation will add size/cap/mount variables."},{"path":"infra/terraform/user_data.sh","reason":"Epic implementation will mount new scratch volume and install host ceiling config."},{"path":"infra/terraform/monitoring_autodeploy.tf","reason":"Epic implementation will add per-generator CloudWatch alarms near current root-disk alarm area."},{"path":"infra/scripts/observability.sh","reason":"Epic implementation will publish per-generator disk saturation metrics."},{"path":"infra/scripts/autodeploy.sh","reason":"Epic implementation will replace/tighten Docker reactive pruning with cap-aware behavior."},{"path":"infra/compose/docker-compose.yml","reason":"Epic implementation will point review-bot gate temp/snapshot paths at scratch volume."},{"path":"infra/runbooks/review-bot-ops.md","reason":"Epic implementation will update disk ceiling/recovery runbook."},{"path":"infra/runbooks/provision-restore.md","reason":"Epic implementation will update fresh-provision/restore steps for scratch volume."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","1205-63b2-2c01-4e7f"],["relates_to","1ef8-c849-5801-4eee"],["relates_to","3e92-b7f4-dede-4c17"],["relates_to","ae97-a37b-9fa3-413a"],["relates_to","ba7f-f1c0-20e7-4dbc"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"d9be75b7-f4a8-4b7a-ad32-34622bf0e5ba","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":["infra","gerrit","disk-ceiling","operator-approved"],"ticket_id":"6202-e1c7-c57f-4897","ticket_type":"epic","title":"Bounded disk-ceiling architecture for the Gerrit host","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_adr_numbers.py && env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/gen_adr_index.py --check","dd_id":"AC1","dd_text":"ADR and ticket hierarchy are complete before epic close."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_alarm_actions_terraform.py tests/unit/test_autodeploy_prune.py tests/scripts/test_autodeploy_disk_pressure.py tests/scripts/test_observability_disk_pressure.py","dd_id":"AC2","dd_text":"Infra tests for alarms/observability/prune behavior pass across the epic changes."},{"command":"terraform -chdir=infra/terraform validate","dd_id":"AC3","dd_text":"Terraform syntax remains valid."}]},"source_event_uuids":["c7f0d655-5783-4e01-9ef8-2ef341317ff3","92bfb06b-d766-410d-b1d8-0b5974102450","d9be75b7-f4a8-4b7a-ad32-34622bf0e5ba","2bde4b9d-1ad0-4ef8-9788-685f2c70adbc","a91999e1-85a2-40f9-9494-fa409edd9914","531af0d3-d3cb-42d0-9021-2844e4a0f3a3","dff0f846-9db0-4bc1-a8cd-a145b2fe24a2","af18c477-3274-46a3-a631-0d3e6065a4ad","c2a2cc3c-cf52-4af2-bada-0fcad9b2ce11","467c31f6-f36b-453a-8ee6-0e0182152445","b0b5f001-8b1c-45e3-ab2a-ebc6341c17a4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788566324794496001,"uuid":"7abdb1ca-9fef-41ff-af03-84cd4ca718e6"}