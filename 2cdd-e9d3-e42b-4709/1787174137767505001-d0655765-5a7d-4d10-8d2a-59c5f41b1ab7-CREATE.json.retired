mypy tier-1 typing ratchet (293 untyped defs, ~165 explicit Any)"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"CREATE","timestamp":1787174137767505001,"uuid":"d0655765-5a7d-4d10-8d2a-59c5f41b1ab7"}