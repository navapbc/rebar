5,1138],[1146,1167],[1206,1227],[1240,1246],[1287,1309],[1380,1400],[1426,1430],[1491,1498],[1527,1536],[1564,1580],[1608,1651],[1700,1703],[1733,1759],[1868,1911],[1972,1977],[2002,2049],[2111,2120],[2148,2176],[2179,2183],[2231,2258],[2297,2339],[2423,2430],[2447,2462],[2483,2493],[2538,2546],[2549,2555],[2587,2602],[2610,2615]]},\"tests/external/live_jira_dc/test_dc_rich_text_live.py\":{\"docs\":[\"<module>\",\"_rich_markdown\",\"_push_and_converge\",\"test_live_rich_text_direct_wire_probe\",\"test_live_rich_text_renders_and_echo_is_safe\",\"test_live_rich_text_both_sides_conflict_keeps_local\"],\"spans\":[[1,32],[48,51],[61,71],[75,80],[109,120],[138,152],[183,186],[219,232],[236,244],[295,309]]},\"tests/external/live_jira_dc/test_dc_richtext_agentic_probe.py\":{\"docs\":[\"<module>\"],\"spans\":[[1,28],[409,412]]},\"tests/external/live_jira_dc/test_harness_smoke.py\":{\"docs\":[\"<module>\"],\"spans\":[[1,27]]},\"tests/external/live_jira_dc/test_multi_project_rehearsal.py\":{\"docs\":[\"<module>\",\"_planned_projects\",\"_assert_scope\",\"_wait_label_count\",\"_make_outbound_ticket\",\"_set_legacy_default\",\"run_label\",\"store_copy\",\"test_contamination_guard_refuses_out_of_scope_target\",\"test_unknown_project_skips_and_continues\",\"test_cleanup_runs_despite_mid_scenario_failure\"],\"spans\":[[1,39],[89,95],[110,116],[155,164],[183,191],[213,218],[232,237],[251,271],[344,352],[466,469],[525,532],[578,590],[638,641],[668,676],[712,721],[748,750]]},\"tests/external/live_jira_dc/test_reconcile_pass.py\":{\"docs\":[\"<module>\",\"dc_rebar_repo\",\"_assert_converged_writing_pass\",\"_assert_wrote_nothing\",\"test_a_dc_created_ticket_carries_the_shared_jira_provenance\"],\"spans\":[[1,36],[116,127],[162,172],[178,186],[257,261],[295,305]]},\"tests/external/live_jira_dc/test_store_copy_isolation.py\":{\"docs\":[\"<module>\",\"test_the_inbound_create_is_PLANNED_for_a_new_dc_issue\",\"test_the_scrubbed_copy_plans_no_deletions_or_outbound_updates\",\"test_a_local_edit_reaches_the_dc_issue_outbound\"],\"spans\":[[1,32],[53,58],[88,92],[98,101],[147,160],[197,204],[220,226],[240,248]]},\"tests/external/live_jira_dc/test_transport.py\":{\"docs\":[\"<module>\",\"test_name_identity_user_search_resolves_a_real_user_authoritatively\",\"test_assigning_an_unknown_user_raises_backend_assignee_not_found\",\"test_add_label_and_the_links_surface_against_a_real_instance\",\"test_a_rekeyed_issue_resolves_by_id_and_records_what_the_stale_key_returns\",\"test_whether_a_non_admin_pat_can_read_application_properties\",\"test_the_instance_label_ceiling_measured_at_254_and_255\"],\"spans\":[[1,29],[79,86],[206,214],[242,255],[295,310],[358,375],[470,490],[496,500],[592,620],[739,763],[802,811]]},\"tests/external/live_jira_dc/test_user_guide_commands.py\":{\"docs\":[\"<module>\",\"_documented_toml_block\",\"documented_repo\",\"test_the_documented_config_and_preview_work_against_a_real_dc_instance\",\"test_the_documented_setup_refuses_to_read_the_pat_from_config\"],\"spans\":[[1,23],[90,95],[108,115],[130,146],[161,167],[218,226]]}}\"\"\")\nassert sum(len(rule[\"spans\"]) for rule in SPEC.values())==164,\"allowlist must contain exactly 164 blocks\"\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nPARSER_DIRECTIVE=re.compile(br\"#\\s*(?:syntax|escape)\\s*=\",re.I)\ndef blob(ref,path):\n return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"])\ndef src(ref,path):\n return blob(ref,path).decode(\"utf-8\")\ndef strip_docs(tree,allowed,required):\n seen=set()\n def visit(node,prefix):\n  if isinstance(node,ast.Module):\n   name=\"<module>\";child_prefix=prefix\n  elif isinstance(node,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n   name=\".\".join((*prefix,node.name));child_prefix=(*prefix,node.name)\n  else:\n   for child in ast.iter_child_nodes(node): visit(child,prefix)\n   return\n  if name in allowed and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n   node.body.pop(0);seen.add(name)\n  for child in ast.iter_child_nodes(node): visit(child,child_prefix)\n visit(tree,())\n if required: assert seen==set(allowed),f\"missing allowlisted docstrings: {sorted(set(allowed)-seen)}\"\n return tree\ndef norm(text,path,allowed,required):\n tree=strip_docs(ast.parse(text,filename=path,type_comments=True),allowed,required)\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef code_anchor(lines,start,step):\n i=start\n while 0<=i<len(lines):\n  stripped=lines[i].strip()\n  if stripped and not stripped.startswith(\"#\"): return lines[i]\n  i+=step\n return \"\"\ndef comment_state(text):\n lines=text.splitlines();protected=[];inline=[]\n shebang=lines[0] if lines and lines[0].startswith(\"#!\") else \"\"\n for tok in tokenize.generate_tokens(io.StringIO(text).readline):\n  if tok.type!=tokenize.COMMENT: continue\n  row=tok.start[0];line=lines[row-1];is_inline=bool(line[:tok.start[1]].strip())\n  if is_inline: inline.append(line)\n  if PAT.search(tok.string):\n   if is_inline: protected.append((\"inline\",line))\n   elif re.search(r\"coding[:=]\",tok.string,re.I): protected.append((\"coding\",row,line))\n   else: protected.append((\"full\",line,code_anchor(lines,row-2,-1),code_anchor(lines,row,1)))\n return shebang,protected,inline\ndef admitted(line,lines,spans):\n return any(s<=line<=e for s,e in spans) or (1<=line<=len(lines) and not lines[line-1].strip() and any(s-1<=line<=e+1 for s,e in spans))\ndef changed_chunks(before,after):\n a=before.splitlines(keepends=True);b=after.splitlines(keepends=True)\n return a,b,[op for op in difflib.SequenceMatcher(a=a,b=b,autojunk=False).get_opcodes() if op[0]!=\"equal\"]\ndef assert_locations(path,a,chunks,spans):\n for tag,i1,i2,j1,j2 in chunks:\n  if i1==i2:\n   assert any(s-1<=i1<=e for s,e in spans),f\"insertion outside allowlist: {path}:{i1+1}\"\n  else:\n   bad=[line for line in range(i1+1,i2+1) if not admitted(line,a,spans)]\n   assert not bad,f\"changed base lines outside allowlist: {path}:{bad}\"\ndef ordinary_docker_prose(line):\n stripped=line.strip()\n return not stripped or (stripped.startswith(b\"#\") and not PARSER_DIRECTIVE.match(stripped))\nfor path,rule in SPEC.items():\n if path.endswith(\"Dockerfile\"):\n  before=blob(BASE,path);after=blob(AFTER,path);a,b,chunks=changed_chunks(before,after)\n  assert_locations(path,a,chunks,rule[\"spans\"])\n  for tag,i1,i2,j1,j2 in chunks:\n   changed=a[i1:i2]+b[j1:j2]\n   assert all(ordinary_docker_prose(line) for line in changed),f\"Docker instruction or parser directive changed: {path}\"\n  continue\n before=src(BASE,path);after=src(AFTER,path)\n assert norm(before,path,rule[\"docs\"],True)==norm(after,path,rule[\"docs\"],False),f\"runtime AST changed: {path}\"\n assert comment_state(before)==comment_state(after),f\"inline comment, directive, or shebang changed: {path}\"\n a,b,chunks=changed_chunks(before,after);assert_locations(path,a,chunks,rule[\"spans\"])\nprint(f\"immutable prose oracle PASS: {len(SPEC)} paths, 164 blocks at {BASE} -> {AFTER}\")'","dd_id":"immutable-prose-only","dd_text":"Immutable-base Python AST, corrected 164-block allowlist, inline-comment/directive/shebang, and Docker ordinary-prose oracle passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import json, subprocess\nexpected=set(json.loads(\"\"\"[\"tests/external/live_jira_dc/_bridge_output.py\",\"tests/external/live_jira_dc/_dc_fixtures.py\",\"tests/external/live_jira_dc/_dc_support.py\",\"tests/external/live_jira_dc/conftest.py\",\"tests/external/live_jira_dc/Dockerfile\",\"tests/external/live_jira_dc/test_dc_mutations.py\",\"tests/external/live_jira_dc/test_dc_rich_text_live.py\",\"tests/external/live_jira_dc/test_dc_richtext_agentic_probe.py\",\"tests/external/live_jira_dc/test_harness_smoke.py\",\"tests/external/live_jira_dc/test_multi_project_rehearsal.py\",\"tests/external/live_jira_dc/test_reconcile_pass.py\",\"tests/external/live_jira_dc/test_store_copy_isolation.py\",\"tests/external/live_jira_dc/test_transport.py\",\"tests/external/live_jira_dc/test_user_guide_commands.py\"]\"\"\"))\nactual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nassert actual==expected,f\"changed paths differ: missing={sorted(expected-actual)} extra={sorted(actual-expected)}\"'","dd_id":"exact-leaf-paths","dd_text":"The one-commit changed-path set exactly equals file impact."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Repository comment-history hygiene passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -m pytest -q tests/unit/test_bridge_output_parsing.py tests/unit/test_dc_store_copy_fetch_diagnostics.py tests/unit/rebar_reconciler/test_dc_force_reindex.py tests/unit/rebar_reconciler/test_dc_live_oracles_discriminate_5200.py tests/unit/rebar_reconciler/test_inbound_assignee_oracle_discriminates_5200.py tests/unit/test_live_jira_dc_conftest.py tests/unit/test_live_jira_dc_provisioning.py tests/unit/rebar_reconciler/test_jira_dc_harness_shape.py tests/unit/test_jira_dc_capability_map_workflow.py::test_boots_the_same_digest_pinned_harness_dockerfile tests/unit/test_live_dc_isolation_controls_59b2.py::test_the_fixture_and_the_assertion_share_one_definition tests/unit/test_live_dc_isolation_controls_59b2.py::test_every_empty_plan_idempotence_verdict_is_preceded_by_a_positive_control tests/unit/test_live_dc_isolation_controls_59b2.py::test_the_row14_cell_establishes_filter_reach_before_deleting_the_issue tests/unit/test_live_dc_isolation_controls_59b2.py::test_out_status_refuses_a_prestate_it_did_not_create tests/unit/tes