d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e3c287a60d4013ea50cf17ce998cd8299c08b0c26ce6e0dfa767f8ae56daaf1c","event_uuid":"ff004129-c6ca-4efa-82fd-75bcd16be01c","position":{"commit_sha":"9bb1631f1f3a90efdddf73ab45b2e1a7b8c4fd9b","position":"1787027469129626001-ff004129-c6ca-4efa-82fd-75bcd16be01c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027432772056001,"creation_channel":"cli","deps":[{"link_uuid":"ff004129-c6ca-4efa-82fd-75bcd16be01c","relation":"depends_on","target_id":"2c81-7119-fb6b-44b1"}],"description":"## Context\nThe repository from T1 is not useful until the public `BindingStore` facade delegates persistence without changing its mature caller contract.\n\n## Outcome\nRoute binding load/save and unit-of-work persistence through `BindingRepository` while preserving every public import, constructor, method signature, shared inner dictionary, and caller-visible exception.\n\n## Plan\n1. Add facade-focused failing tests for import and signature compatibility, pending/confirmed/reverse lookup, shallow `all_bindings()`, and save/reload bytes.\n2. Inject or construct the repository behind the existing facade; keep the facade authoritative and do not expose a writable repository to callers.\n3. Preserve existing `peer_state.py` and `get_rotation.py` ownership, rotation-before-live ordering, retired-first move ordering, and best-effort alert semantics.\n4. Remove only persistence code made dead by delegation; retain legacy format and exception behavior.\n\n## Testing\nRun repository and facade suites together plus the held-out GET-rotation and retired-commit regressions.\n\n## Acceptance Criteria\n- [ ] Existing imports, construction, loader, and public signatures remain unchanged.\n- [ ] Pending, confirmed, reverse lookup, and shallow `all_bindings()` behavior match the pre-extraction facade.\n- [ ] Facade save/reload produces the same bytes and exception surface as the direct repository contract.\n- [ ] Existing peer-state and GET-rotation delegates remain independent owners.\n- [ ] No caller receives direct writable repository access.\n\n## Out of scope\nLifecycle-policy extraction, rich-emission operations, recovery, and tickets publication changes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_repository.py","reason":"Expose the repository unit-of-work used by the facade."},{"path":"src/rebar/_engine/rebar_reconciler/binding_store.py","reason":"Delegate persistence behind the unchanged public facade."},{"path":"tests/unit/rebar_reconciler/state/test_binding_store.py","reason":"Facade compatibility and save/reload regression coverage."},{"path":"tests/unit/rebar_reconciler/state/test_get_rotation_heldout.py","reason":"Rotation-before-live and inline-floor regression coverage."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","2c81-7119-fb6b-44b1"],["parent","5142-4dbf-9469-4672"]],"no_file_impact_reason":"","parent_id":"5142-4dbf-9469-4672","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp02","binding-store","tdd"],"ticket_id":"34f2-8d32-029c-400b","ticket_type":"task","title":"RP-02 S1 T2 — Delegate the BindingStore facade to the repository","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_binding_repository.py tests/unit/rebar_reconciler/state/test_binding_store.py tests/unit/rebar_reconciler/state/test_get_rotation_heldout.py","dd_id":"AC1-AC5","dd_text":"Facade API, shared-state, byte/exception, delegate ownership, and encapsulation compatibility"}]},"source_event_uuids":["2ca4670d-b8ac-4ec1-967c-3adb9e609180","f83dade6-efa9-4dff-b9ae-8175b914af59","b2e704ae-c5f8-4a64-96a8-5bbac1912b1c","ff004129-c6ca-4efa-82fd-75bcd16be01c"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029930889762001,"uuid":"10fe38fb-9013-44ef-9072-fe830bbbcc71"}