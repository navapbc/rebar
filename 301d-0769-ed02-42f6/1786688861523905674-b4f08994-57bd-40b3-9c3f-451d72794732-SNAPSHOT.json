{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786688861523905674,"compiled_state":{"alias":"camerashy-erectable-frog","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"b9ea56ce60f9e061c6356d467bdef4e843a87b1c","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 301d-0769-ed02-42f6","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.11.0 (b9ea56ce60)","material: 686ec87afbd0fc89","verified-at-sha:b9ea56ce60f9e061c6356d467bdef4e843a87b1c"],"material_fingerprint":"686ec87afbd0fc89","merged_log_commit":"b9ea56ce60f9e061c6356d467bdef4e843a87b1c","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786680688125374000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4c4225c3dd4f045bfb85eccbba2519f3eeef8b31","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 301d-0769-ed02-42f6","material: f49ed7012094c7d2","material-part: children 647ea2107ca5072f 0","material-part: description 9fc56cda56e63e1a 7406","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact 39bcae4feec597ba 5","material-part: ticket_id 69b07a1c99138b89 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.11.0 (4c4225c3dd-dirty)","regver: 4f90349cd81c4911","verified-at-sha:4c4225c3dd4f045bfb85eccbba2519f3eeef8b31","dep 6575bf9f88bcc2b40d7a9d919d1587c49387bb5b5c2f656fec3f0970175e8b95 src/rebar/_commands/compact.py","dep abc171c722dd4fe4a3edb2bfa32ff6d680e45c6fd6d0f8a3c5b54a83982eafbf src/rebar/_commands/compact_trigger.py","dep 1b58639433bd018efee1b8236accc430a06199db06bf077adc9dbd94b6fd14b8 src/rebar/_store/lock.py","dep 9260673bf95b3ab40bf6e3b036511b27b408d49b309a6efdf0b1b0d2b7fcb933 src/rebar/_store/lock_owner.py","dep absent tests/unit/test_lock_holder_labelling.py","read-set: 7","read-path: src/rebar/_commands/compact.py","read-path: src/rebar/_commands/compact_trigger.py","read-path: src/rebar/_commands/compact_txn.py","read-path: src/rebar/_store/lock.py","read-path: src/rebar/_store/lock_owner.py","read-path: tests/scripts/graph/test_doctor_locks.py","read-path: tests/unit/test_lock_stale_reclaim.py","currency-basis: file_impact"],"material_fingerprint":"f49ed7012094c7d2","merged_log_commit":"4c4225c3dd4f045bfb85eccbba2519f3eeef8b31","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786676882903120000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"f9050281b485a7bddaa41cf76019e8a6a2c87648b4fac7b6ab9b9339d0acf7a1","event_uuid":"856f4819-a4a0-4e39-a686-bbdf27c218fe","position":{"commit_sha":"49d7ffa03dca9192e7af96a7cab36020e42bcfd1","position":"1786663804659611001-856f4819-a4a0-4e39-a686-bbdf27c218fe"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"80410883787cfb187e429689882464599a5ec98becb9ddeb