uests":1},"T5e":{"cache_read_tokens":0.0,"cache_write_tokens":228.25,"input_tokens":959.6666666666666,"llm_calls":1,"output_tokens":173.58333333333334,"requests":1},"T6":{"cache_read_tokens":0.0,"cache_write_tokens":456.5,"input_tokens":1733.6666666666667,"llm_calls":1,"output_tokens":163.5,"requests":1},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":228.25,"input_tokens":959.6666666666666,"llm_calls":1,"output_tokens":173.58333333333334,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":456.5,"input_tokens":1733.6666666666667,"llm_calls":1,"output_tokens":163.5,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":456.5,"input_tokens":1733.6666666666667,"llm_calls":1,"output_tokens":163.5,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":3916.0,"cache_write_tokens":2618.0,"input_tokens":6536.0,"llm_calls":1,"output_tokens":324.0,"requests":1}}}},"findings":[{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","drop_reason":null,"evidence":["2 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] State explicitly that current.new is created on the SAME filesystem as current and that the switch uses an atomic rename(2)/`mv -T` (never `ln -sf`), so the all-old/all-new crash-probe guarantee is grounded in the resolved rename-atomicity capability.","cohort":["T1"],"criteria":["T1"],"decision":"dropped","drop_reason":null,"evidence":["Plan quote: 'Publication stages `current.new` and atomically renames that one symlink to `current`; the two executables and checkpoint therefore switch at one filesystem commit point.'","Prior art: rename(oldpath,newpath) can change a pathname atomically 'provided oldpath and newpath are on the same filesystem' and these operations are 'best left to local filesystems' (crying foul on NFS).","Prior art: 'ln -sf' 'sounds atomic but is not' — under the hood it does unlink(current) followed by symlink(target,current), reintroducing the exact race the all-old/all-new AC forbids.","The plan stages current.new under the same updater-managed state dir as current, so it likely satisfies the same-filesystem constraint, but neither the same-filesystem requirement nor the rename(2)-not-ln-sf mechanism is stated."],"finding":"The plan's atomic-switch guarantee ('atomically renames that one symlink to current'; 'switch at one filesystem commit point') relies on the unstated capability that rename(2) is atomic only when source and destination are on the same filesystem, and that the rename must use rename(2)/`mv -T` rather than a non-atomic `ln -sf` (which does unlink+symlink). The plan asserts atomicity but does not resolve the capability constraint it depends on.","group_criteria":null,"group_id":null,"id":"fdecb30efb9fcad0f","impact":0.33,"is_primary":null,"location":"Approach bullet 5 ('Publication stages current.new and atomically renames that one symlink to current; the two executables and checkpoint therefore switch at one filesystem commit point') and AC line 'Crash probes immediately before and after the current rename observe either all-old or all-new resolution ... never a mixed tuple'","norm_id":"n889789db5e3bf149","priority":0.0825,"reason":"veto:absence-refuted","scenarios":["The updater-managed state dir spans a mount boundary (e.g. current.new created under a temp path on a different filesystem), making the rename cross-device and non-atomic — the all-old/all-new AC would be silently violated.","An implementer satisfies 'renames that one symlink' with `ln -sf`, reintroducing the unlink+symlink race the crash-probe AC is meant to exclude."],"severity":"minor","suggested_fix":"Add to Approach: 'current.new is created inside the same updater-managed state directory as current (same filesystem) and swapped via a single rename(2) (e.g. `mv -T`/`os.replace`), never `ln -sf` (unlink+symlink is non-atomic).' Optionally add a code-verifiable AC asserting the publish step uses an atomic rename primitive and stages current.new in the current directory.","tier":"LLM","validity":0.25,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["G6"],"decision":"dropped","drop_reason":null,"evidence":[],"finding":"The plan publishes two host shims (rebar, rebar-mcp) plus the last-good.sha checkpoint as a group, and the failure ACs require all of them to stay byte-identical on rejection while the no-op AC keys off last-good.sha — but the plan never specifies how this multi-artifact publish is made atomic or in what order, leaving a mid-publish interruption able to produce a half-published runtime (shims swapped but checkpoint stale, or one shim updated and not the other) that defeats the 'no change (already on <installed-sha>)' detection.","group_criteria":null,"group_id":null,"id":"f6e36f91b2e56ae19","impact":0.0,"is_primary":null,"location":"Approach — 'only then publish both host shims and checkpoint SHA'; ACs for injected sync/smoke failures and the immediately-following no-op","norm_id":"n9ba72d0bdeaafbba","priority":0.0,"reason":"veto:absence-refuted","scenarios":[],"severity":"none","suggested_fix":"Publish through a single atomic pointer swap: assemble the fully-synced release under a temp release dir, point both shims at it via one atomically-renamed release symlink, then write last-good.sha as the final step; on any interruption the previous release symlink and checkpoint remain the live, consistent state.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"","cohort":null,"criteria":["T5b"],"decision":"dropped","drop_reason":null,"evidence":[],"finding":"The publish step swaps two host shims plus the checkpoint SHA but does not specify atomicity or ordering for that multi-artifact commit; an interruption mid-publish (e.g. after the first shim is written but before the checkpoint) could leave the two shims and checkpoint inconsistent.","group_criteria":null,"group_id":null,"id":"f9c710a00f9f86874","impact":0.0,"is_primary":null,"location":"Approach: 'only then publish both host shims and checkpoint SHA'","norm_id":"n64a8c8180d0de427","priority":0.0,"reason":"veto:absence-refuted","scenarios":[],"severity":"none","suggested_fix":"Stage the new shims and updated last-good.sha, then commit via atomic rename with the checkpoint written last, so a crash before completion leaves the previously published runtime fully intact.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an acceptance criterion asserting the one-time migration establishes the three stable links and all three resolve through `current` before the first scheduled publication.","cohort":["COH","E1","E2","E6","F1","T12","T2","T4","T5b","T5d","T5e","T9"],"criteria":["E1"],"decision":"advisory","drop_reason":"novelty","evidence":["Approach describes a one-time migration step with a verification, but the Acceptance Criteria list has no dedicated criterion for the migration step; the operator ACs verify post-publication resolution, not the pre-publication migration establishment."],"finding":"The one-time migration that establishes the stable links and verifies all three resolve through `current` is described in the Approach but has no covering acceptance criterion proving the migration itself completed before scheduled publication.","group_criteria":null,"group_id":null,"id":"f00d991e6198609c2","impact":0.44,"is_primary":null,"location":"Approach: 'One-time migration establishes the stable links before scheduled publication and verifies all three resolve through current.'","norm_id":"n5fe1af42d199d31c","priority":0.22,"reason":"default-advisory","scenarios":["The migration runs but leaves one of rebar / rebar-mcp / last-good.sha not resolving through current; with no covering AC, the gap is not proven before the first scheduled publication."],"severity":"minor","suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_rev