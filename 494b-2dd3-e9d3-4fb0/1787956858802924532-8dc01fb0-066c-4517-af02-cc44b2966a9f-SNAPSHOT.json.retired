{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787956858802924532,"compiled_state":{"alias":"daughterly-agitative-ocelot","assignee":"joeoakhart@navapbc.com","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"dc0b4b091f12c4768db6410a0948d4d7f7898ecbb7cec6b36137f3232e670796","event_uuid":"e548d250-40b4-4436-940f-73b99c7e6947","position":{"commit_sha":"86dea2dd9b82f09a67203e9d33505437ef1ea8d9","position":"1787946636559264677-e548d250-40b4-4436-940f-73b99c7e6947"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fc538a6c41a159e9566e0f24ba5a6388bce63b049036c9903b63731fea1493eb","event_uuid":"be5f0a25-a28e-4198-b7c2-2d47cb39827c","position":{"commit_sha":"86dea2dd9b82f09a67203e9d33505437ef1ea8d9","position":"1787946636576467668-be5f0a25-a28e-4198-b7c2-2d47cb39827c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"34efdbb8b8cddc88403f562b95f05ac0e42cd4a2788095b1edda3d9054d67952","event_uuid":"2be0351e-8b9f-47c8-9c5f-d7e2753224ff","position":{"commit_sha":"dbc1ae8f2fa662ecfe0308445601dd12b3698417","position":"1787946666352468402-2be0351e-8b9f-47c8-9c5f-d7e2753224ff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4c371e18baa7f6630d14af5427cc4c8036412b004dd7f4ebe0caae67c5b86ec1","event_uuid":"86ac59c8-c27b-456e-b814-7f72b14d9ab6","position":{"commit_sha":"69732c15132c19bdf0e61312d3fa89672c1a54fe","position":"1787947849372405645-86ac59c8-c27b-456e-b814-7f72b14d9ab6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"97617704074b8eeae532eb983e1131fe3404ee0aef4e0a9c850c57524e6d6dcd","event_uuid":"1110a03b-a18b-4b11-947e-806779255f02","position":{"commit_sha":"478401b9367ab429d101940cf6c8289101f96c5e","position":"1787948463256980086-1110a03b-a18b-4b11-947e-806779255f02"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"952518c7ed1f6f4b867f935e2e8837f42111ff7fba871db070fae73b0fce9938","event_uuid":"664deeb7-c55d-4e47-a191-af215eb6af12","position":{"commit_sha":"1f41731f1909a624579b73ddfcf5d971866f39c1","position":"1787949089260113711-664deeb7-c55d-4e47-a191-af215eb6af12"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fc44ba8e20712a0ad32e548033f56f8eea24b726a59bb0d0c1c89221e76acc77","event_uuid":"83bc1939-b2d3-45ac-97f6-3fa69b325351","position":{"commit_sha":"599a6db7c0020579ed56cb5749bcf41a19c67dff","position":"1787951225046466060-83bc1939-b2d3-45ac-97f6-3fa69b325351"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ae55c388d530134f95bf8ecf2f37924ca56c9e464513e88306ce8d5ca221389b","event_uuid":"431657a3-c2a0-4664-bc30-47c9ad0caf69","position":{"commit_sha":"1954a63deac04ea4b72c8daba62e7313f5504fef","position":"1787951319181371650-431657a3-c2a0-4664-bc30-47c9ad0caf69"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f00d1e00597324d0c9b0f3ddb33d72c6dc563005b7cee446c109f9cc73beb464","event_uuid":"9cb6e180-30f3-4417-824e-83decbc89870","position":{"commit_sha":"9ca109d1a68e54ec6269bb3bcbaec5cc81927e56","position":"1787951959802377001-9cb6e180-30f3-4417-824e-83decbc89870"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9b7a1dd023675aa40804d9d3e7cee949e11280df4697323a953855d453ebf86d","event_uuid":"12c1527e-0708-4374-a17d-8b662a471b45","position":{"commit_sha":"bf1df6aba59f034fcbc6b31ed93be79314f76c9f","position":"1787952771509288001-12c1527e-0708-4374-a17d-8b662a471b45"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3dd50c7fda53151e93679b5b84380601c69794bbe20ab9aa4ca8240041adeba6","event_uuid":"0d33bc39-0893-418e-9329-78e59c303d16","position":{"commit_sha":"8992a6530c132cc85abb14302946a5395fd4009e","position":"1787953510118238001-0d33bc39-0893-418e-9329-78e59c303d16"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"909d06a785c71ac513636ca9d95778496949981a960a7b626b8456b8ebeb5322","event_uuid":"2770d763-bf0c-4bc9-a233-30fb84d2c670","position":{"commit_sha":"d3c5d2bfba900c41ae018223dcb0a90bd2b7a72f","position":"1787954181669811001-2770d763-bf0c-4bc9-a233-30fb84d2c670"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9c4ef7fb9ecf0c1348775811ee5ff067ba918557167259c1a9f218a187df2d57","event_uuid":"d4b1de39-4251-40dd-b9c0-099f28af7c05","position":{"commit_sha":"48dc930620294c9d1e31199114313c43eb370233","position":"1787954227709798001-d4b1de39-4251-40dd-b9c0-099f28af7c05"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1c77b4045065bdc0b3603796e0d56397899600c8b189f7bd57ddb7e32945d7a6","event_uuid":"ccad8b22-3448-49a9-b310-ad0b4a915f11","position":{"commit_sha":"76ac212328450ef7b5ba572e8aca2ef1329f63d9","position":"1787955324939779001-ccad8b22-3448-49a9-b310-ad0b4a915f11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6233cce1be21155d98a932e61d4d35e1d21233cb2c7c2196c5662da99671ab82","event_uuid":"0e38454f-e345-41dd-ba0a-0df94d0a5836","position":{"commit_sha":"5980f28ee8e90e632b1c795a20e217b7ab761c77","position":"1787956858802924531-0e38454f-e345-41dd-ba0a-0df94d0a5836"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 1 — PROVEN root cause (rebar-debug)\n\n### Step 0 sweep\n- `Step 0(a): duplicates none.` The only near-match is `unreal-milky-sloth` /\n  `6fe7-956f-4901-45cf` (BigInt serialization), named in this ticket as candidate 2 — it is\n  CLOSED and is a different mechanism (see rejection below). No sibling to resume.\n- Reported-against floor: `created_at` 1787858559072112001 ns → main at/before 2026-08-25.\n  Behaviour reproduced on today's `origin/main` (afe01efaa8b2), so the floor is not material.\n\n### Discriminating experiment — the deployed endpoint, today\n\nUnfiltered `tools/call list_tickets {}` against `https://rebar.solutions.navateam.com/mcp`\n(Streamable HTTP, bearer auth):\n\n    http=200  size=94541551  time=177.286450\n\n**The server did not fail.** It returned a well-formed JSON-RPC result of\n**94,541,551 bytes (94.5 MB) over 177 seconds**, in one SSE `event: message` frame.\n\nThat single observation separates all three candidate causes:\n\n1. **Response size — CONFIRMED.** 94.5 MB in one response, 177 s wall.\n2. **BigInt serialization — REJECTED.** The call completed and the payload parses; the\n   js-safe guard (`src/rebar/_mcp_errors.py:152` `js_safe_result`) is doing its job.\n3. **Deploy cutover — REJECTED.** Reproducible on demand three days after the 18:54:29Z\n   cutover, from a session that was never orphaned.\n\nSo the transport close is the **client** abandoning a 94.5 MB / 177 s single response, and it\nis client-dependent: Copilot CLI reports `Transport closed`; this Claude Code session's own\nconfig carries a 30 s connect budget (`claude mcp get rebar` → \"connection timed out after\n30000ms\"); a third client succeeded but had to spill 219,815 chars to disk. The server offers\nno bound and no structured signal, so none of them can distinguish \"too big\" from \"server died\".\n\n### The changeable artifact\n\n**The MCP read surface has exactly one payload bound and `list_tickets` is not wired to it.**\n\n- `src/rebar/mcp_server.py:449-494` — `_WORKFLOW_TOKEN_BUDGET_BYTES = 90_000` and\n  `_cap_workflow_payload()`, whose own comment states the contract: *\"Keep MCP … payloads\n  under the client's ~25K-token budget (WS-ffc4).\"*\n- It is applied to **two** tools only: `src/rebar/_mcp_reads.py:539` (`get_workflow_status`)\n  and `:553` (`get_workflow_result`).\n- `list_tickets` (`src/rebar/_mcp_reads.py:278-326`) returns\n  `[TicketStateOut.model_validate(t) for t in rebar.list_tickets(...)]` with **no size check\n  at all**. Same for `ready_tickets`, `search`, `next_batch`.\n\n### Why \"lean by default\" does not save it (question 3)\n\n`list_tickets`' docstring claims *\"lean by default — the bulky `description` and `comments`\nfields are omitted so a broad list stays small\"*. The claim is **literally true and materially\nfalse**. `src/rebar/_engine_support/reads.py:494-496` is the whole lean path:\n\n    if not include_body:\n        ps.pop(\"description\", None)\n        ps.pop(\"comments\", None)\n\nMeasured against the real store (2,855 tickets), lean vs full is 44.4 MB vs 73.0 MB — a 39%\nsaving that leaves the actual bulk untouched. Aggregate field weights of the **lean** payload:\n\n| field | bytes | share of lean |\n|---|---:|---:|\n| `authorship_ledger` | 26,241,422 | 59% |\n| `attestations` | 10,370,251 | 23% |\n| `signature` | 2,639,114 | 6% |\n| everything else | 5,141,280 | 12% |\n\n**88% of the \"lean\" payload is base64 DSSE signature material** that a list caller never asked\nfor. Per row: 15,548 bytes lean; 1,726 bytes with those four fields (incl. `keyring`) dropped —\na 9x difference. The reported 10-row filtered call reproduces exactly: `tag=mcp, status=open,\ntype=bug` → 52,854 bytes lean, 11,178 bytes slim.\n\nThe mirror lean path in `src/rebar/_snapshot/ticket_view.py:383` has the same two-field drop.\n\n### Legitimacy\n\nThis is a defect, not a misunderstanding: the behaviour diverges from two in-repo authoritative\nstatements — the `list_tickets` docstring's \"stays small\", and `_cap_workflow_payload`'s stated\n\"under the client's ~25K-token budget\" contract that the rest of the read surface ignores.\n","timestamp":1787946666352468402},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 2 — fix pushed for review: Gerrit change 2336\n\n`https://rebar.solutions.navateam.com/c/rebar/+/2336` — \"Bound the MCP list read surface\".\nNOT submitted; `LLM-Review +1` and `Verified +1` still pending.\n\n### What changed\n\n**1. The list surface is now BOUNDED, and refuses rather than truncates.**\n`src/rebar/_mcp_budget.py` (new) holds the payload-budget cluster lifted out of\n`mcp_server.py` — a real call-graph seam: both bounds measure through `_payload_bytes`,\nand `mcp_server.py` had reached the 800-LOC hard cap. Alongside the existing\n`_cap_workflow_payload` it adds `_bound_list_payload`, which reuses the SAME\n`_WORKFLOW_TOKEN_BUDGET_BYTES` (90,000) and, when a list exceeds it, raises a `RebarError`\ncarrying the new `error_code=\"response_too_large\"`. The already-installed\n`install_error_guard` converts that into the standard rebar MCP envelope, so the caller\ngets:\n\n    {\"error\": \"response_too_large\", \"message\": \"list_tickets matched 4000 tickets and\n     would return 518902 bytes, over the 90000-byte MCP response budget. No partial list\n     is returned (a short list cannot be told from a complete one). Narrow the query with\n     one of status, ticket_type, priority, parent, has_tag, without_tag -- or read a\n     single ticket with show_ticket.\", \"exit_code\": 1}\n\nDeliberately NOT the truncate-and-flag treatment a workflow payload gets: a shortened list\nis indistinguishable from a complete one, which is the vacuous-result mode this project\nrefuses. Wired into `list_tickets` AND `ready_tickets` (both named in the AC).\n\n**2. \"Lean\" is now actually lean.** `LEAN_OMITTED_FIELDS` + `lean_projection` in\n`src/rebar/_engine_support/reads.py` extend the `include_body=False` drop set from\n`description`/`comments` to also drop `authorship_ledger`, `attestations`, `signature`,\n`keyring`. The snapshot backend (`_snapshot/ticket_view.py`) calls the same function, so\nthe two read backends cannot drift.\n\n### Why both halves were needed\n\n| query | before | after |\n|---|---:|---:|\n| unfiltered (2,855) | 44,392,067 | 4,928,872 |\n| per row | 15,548 | 1,726 |\n| `status=open` (51) | 224,610 | 58,867 |\n| `in_progress` (15) | 182,426 | 24,392 |\n| `tag=mcp,status=open,type=bug` (10) | 52,854 | 11,178 |\n| `ready` (61) | 693,556 | 76,878 |\n\nWithout the projection the 90 KB bound would refuse even `list_tickets(status=\"open\")`.\nWith it, every ordinary query fits and only a genuinely unbounded one is refused.\n\n### RED-first, mutation-checked\n\n`tests/interfaces/facades/test_mcp_list_payload_budget.py` (7 tests) was written and seen\nRED before any fix, driving the REGISTERED `CallToolRequest` handler a real client\nreaches — not just `call_tool` — so a guard applied only to the post-`build_server()`\ninstance cannot pass it.\n\nMutation check, each half reverted independently:\n\n- shrink `LEAN_OMITTED_FIELDS` back to the two body fields → **3 RED**\n  (`lean=24072 full=24156: lean is not materially smaller`)\n- neuter the budget comparison in `_bound_list_payload` → **3 RED**\n  (`an over-budget list must not come back as a result`; `DID NOT RAISE ToolError`)\n- restored → **7 GREEN**\n\n### Gates\n\n`make lint` (ruff check + format + complexity ratchet `active=39 new=0 increased=0`),\n`make typecheck` (684 files clean), `pytest tests/unit/test_module_size_contract.py`\n(the extraction is what keeps `mcp_server.py` under the cap: 837 → 754),\n`tests/unit` + `tests/interfaces` — 16,375 passed after fixing the four ctx fixtures and\nregenerating `api_surface_baseline.json` for the new error code.\n\n### Still open\n\nThe **LIVE VALIDATION** criterion is NOT met and this ticket must stay open until it is:\nthe change is on Gerrit, not merged and not deployed. Evidence must be re-taken against\n`https://rebar.solutions.navateam.com/mcp` after the mcp container redeploys.\n","timestamp":1787948463256980086},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 3 — remediating Gerrit 2336 (LLM-Review -1, Verified -1)\n\n### CI root cause — NOT packaging, and not a flake\n\n`golden-path (clean install)` failed in 52 s on the **end-to-end CLI probe**, one assertion:\n\n    FAIL: show adds exactly comments+description+digest_freshness+inbound_deps+plan_review_health\n      over lean list (got [... 'keyring', ... 'signature'], want [...])\n\n`scripts/probe_rebar.py:552` asserts the EXACT symmetric difference between `rebar show`\nand `rebar list` key sets, in both directions, as a drift detector. Widening\n`LEAN_OMITTED_FIELDS` changed the **CLI `rebar list`** shape too — not just MCP — because\n`list_states(include_body=False)` shares `lean_projection`. So the probe was correct and\nthe change was under-declared: a **third** surface narrowed. Reproduced locally\n(141 passed / 1 failed), fixed, now 142 passed / 0 failed.\n\nThe probe's expectation is now derived rather than hardcoded — the show-only computed\nfields plus the lean-dropped set INTERSECTED with what `show` actually emits — because\n`authorship_ledger`/`attestations` materialise only once a ticket has signature material,\nso an empty tracker's `show` carries neither. Mutation-checked: shrinking\n`LEAN_OMITTED_FIELDS` back to the two body fields still fails the probe.\n\n### Findings 1+2 — `ready_tickets` contract: **option (b)**, lean-by-default, documented\n\nChosen over (a) preserve-full-default and (c) bound-only. The deciding fact is that both\nalternatives make the DEFAULT call **fail** on this store: 61 ready tickets weigh 693,556\nbytes unprojected against a 90,000-byte budget. Turning a working-but-oversized call into\na hard refusal is a *larger* break than returning less, and (b) keeps the two discovery\nsurfaces agreeing on their default shape instead of disagreeing. `full=True` returns\nexactly the previous bytes; `show_ticket` is untouched. Recorded as BREAKING (pre-1.0) in\n`docs/release-notes.md` + `CHANGELOG.md`, with the CLI `list` narrowing declared alongside.\n\n### Finding 4 — the budget measured the wrong bytes. Confirmed, and worse than reported.\n\nThe reviewer named one axis (`js_safe_result` quoting 19-digit ints). Measured at this\nstore's 2,855 rows, there are **two**, and the larger one was unnamed:\n\n| stage | bytes | delta |\n|---|---:|---:|\n| raw reducer dicts (what the bound measured) | 552,772 | — |\n| after `TicketStateOut.model_validate` | 1,526,327 | **+973,555** |\n| after `js_safe_result` | 1,537,747 | +11,420 |\n\n`TicketStateOut` DECLARES defaults, so `model_validate` **re-adds every field the lean\nprojection just dropped** as an explicit `null`/`[]`/`\"\"`. Total under-estimate: **178%** —\nthe 90,000-byte budget was in truth passing ~250,000-byte payloads.\n\nFixed by measuring the post-validation, post-`js_safe_result` rows (new `_wire_bytes`);\ncall sites now bound AFTER `model_validate`. Two tests, both mutation-killed by a faithful\npre-fix revert: an exactness assertion (measured == what the client receives) and the\nregression window — 250 plain rows measure 49,652 bytes raw (under budget) but reach the\nclient as 135,902 (51% over), so the pre-fix bound returned them.\n\n### Finding 5 — snapshot projection now tested\n\nTwo tests in `tests/unit/test_pinned_ticket_view.py` against a REAL pinned view over a real\ntracker: same query through both backends, identical key sets (kills \"stops projecting\"),\nand `include_body=True` still carries the bodies on both (kills \"projects unconditionally\").\nThe \"cannot drift\" claim is now enforced rather than asserted.\n\n### Finding 3\n\nNo plan-review attestation on this ticket; `review-plan` run to earn one. No `--force`.\n","timestamp":1787951225046466060},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 3 — remediating Gerrit 2336 (LLM-Review -1, Verified -1)\n\n### CI root cause — NOT packaging, and not a flake\n\n`golden-path (clean install)` failed in 52 s on the **end-to-end CLI probe**, one assertion:\n\n    FAIL: show adds exactly comments+description+digest_freshness+inbound_deps+plan_review_health\n      over lean list (got [... 'keyring', ... 'signature'], want [...])\n\n`scripts/probe_rebar.py:552` asserts the EXACT symmetric difference between `rebar show` and\n`rebar list` key sets, in both directions, as a drift detector. Widening `LEAN_OMITTED_FIELDS`\nchanged the **CLI `rebar list`** shape too — not just MCP — because `list_states(include_body=False)`\nshares `lean_projection`. So the probe was right and the change was under-declared: a **third**\nsurface narrowed. Reproduced locally (141 passed / 1 failed), fixed, now 142 / 0.\n\nThe probe's expectation is now derived rather than hardcoded — the show-only computed fields plus\nthe lean-dropped set INTERSECTED with what `show` actually emits — because\n`authorship_ledger`/`attestations` materialise only once a ticket has signature material, so an\nempty tracker's `show` carries neither. Mutation-checked: shrinking `LEAN_OMITTED_FIELDS` back to\nthe two body fields still fails the probe.\n\n### Findings 1+2 — `ready_tickets` contract: **option (b)**, lean-by-default, documented\n\nChosen over (a) preserve-full-default and (c) bound-only. The deciding fact is that both\nalternatives make the DEFAULT call **fail** on this store: 61 ready tickets weigh 693,556 bytes\nunprojected against a 90,000-byte budget. Turning a working-but-oversized call into a hard refusal\nis a *larger* break than returning less, and (b) keeps the two discovery surfaces agreeing on their\ndefault shape instead of disagreeing. `full=True` returns exactly the previous bytes; `show_ticket`\nis untouched. Recorded as BREAKING (pre-1.0) in `docs/release-notes.md` + `CHANGELOG.md`, with the\nCLI `list` narrowing declared alongside.\n\n### Finding 4 — the budget measured the wrong bytes. Confirmed, and worse than reported.\n\nThe reviewer named one axis (`js_safe_result` quoting 19-digit ints). Measured at this store's\n2,855 rows there are **two**, and the larger was unnamed:\n\n| stage | bytes | delta |\n|---|---:|---:|\n| raw reducer dicts (what the bound measured) | 552,772 | — |\n| after `TicketStateOut.model_validate` | 1,526,327 | **+973,555** |\n| after `js_safe_result` | 1,537,747 | +11,420 |\n\n`TicketStateOut` DECLARES defaults, so `model_validate` **re-adds every field the lean projection\njust dropped** as an explicit `null`/`[]`/`\"\"`. Total under-estimate **178%** — the 90,000-byte\nbudget was in truth passing ~250,000-byte payloads.\n\nFixed by measuring the post-validation, post-`js_safe_result` rows (new `_wire_bytes`); call sites\nnow bound AFTER `model_validate`. Two tests, both killed by a faithful pre-fix revert: an exactness\nassertion (measured == what the client receives) and the regression window — 250 plain rows measure\n49,652 bytes raw (under budget) but reach the client as 135,902 (51% over), so the pre-fix bound\nreturned them.\n\n### Finding 5 — snapshot projection now tested\n\nTwo tests in `tests/unit/test_pinned_ticket_view.py` against a REAL pinned view over a real tracker:\nsame query through both backends, identical key sets (kills \"stops projecting\"), and\n`include_body=True` still carries the bodies on both (kills \"projects unconditionally\"). The\n\"cannot drift\" claim is now enforced rather than asserted.\n\n### Finding 3\n\nNo plan-review attestation on this ticket; `review-plan` run to earn one. No `--force`.\n\n### Gates\n\n`make lint`, `make typecheck` (684 files), `pytest tests/unit/test_module_size_contract.py`,\ncomplexity ratchet `active=39 new=0 increased=0`, and the golden-path probe 142/0.\n","timestamp":1787951319181371650},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 4 — supporting detail moved out of the description (P4 admission limit)\n\nThe description exceeded the 8,000-char plan-review admission cap. Per `P4`'s own remedy —\nkeep the problem, constraints and ACs in the description; move investigation narration into\ncomments — the measurement detail lives here.\n\n### Why the \"lean\" default was not lean (the 88% figure)\n\nMeasured on this store, 2,855 tickets. Lean vs full: 44.4 MB vs 73.0 MB — a 39% saving that\nleaves the bulk untouched. Aggregate field weights of the **lean** payload:\n\n| field | bytes | share of lean |\n|---|---:|---:|\n| `authorship_ledger` | 26,241,422 | 59% |\n| `attestations` | 10,370,251 | 23% |\n| `signature` | 2,639,114 | 6% |\n| everything else | 5,141,280 | 12% |\n\nPer row: 15,548 bytes lean; 1,726 with those four (incl. `keyring`) dropped — 9x.\n\n### Why the budget had to measure the wire payload, not the reducer rows\n\nSizing raw dicts under-estimates on two axes. At 2,855 rows:\n\n| stage | bytes | delta |\n|---|---:|---:|\n| raw reducer dicts | 552,772 | — |\n| after `TicketStateOut.model_validate` | 1,526,327 | +973,555 |\n| after `js_safe_result` | 1,537,747 | +11,420 |\n\nA 178% under-estimate: the 90,000-byte budget was in truth passing ~250,000-byte payloads.\nThe dominant axis is the model's DECLARED defaults being re-added after the lean projection\ndropped them, not the 19-digit-int quoting.\n\n### `ready_tickets` headroom, and why the budget was not inflated\n\nAfter projection: 58-59 rows, 87,893-88,480 wire bytes against 90,000 — ~1.7% headroom,\n~1,499 B/row, so roughly one more ready ticket makes the default call refuse. The budget is\ndeliberately not raised: it is the client's real constraint, and raising it moves the failure\nback into the client where there is no structured signal. Instead the refusal is made useful.\n`ready_tickets` takes only `sort` and `full` — no filter arguments — so a shared \"narrow with\nhas_tag\" message would name parameters it rejects; its refusal points at `next_batch(epic_id)`.\n\nFollow-up filed: `lucky-egoistic-akitainu` (`0c99-8f2b-0de7-48f2`), linked `discovered_from`,\ncarrying the discovery-shaped-projection options (234 B/row via a new closed output model =\n~384 rows; 801 B/row via further field narrowing within `TicketStateOut` = ~112 rows).\n\n### Surfaces measured for the breaking-change note\n\nCLI `rebar list --status closed`, 2,696 rows, same ticket in each run: 39 keys -> 35 (losing\nexactly `authorship_ledger`, `attestations`, `signature`, `keyring`), 43,661,976 -> 4,747,485\nbytes, 9.2x. `--full` restores all four plus the bodies (41 keys, 71,707,799 bytes).","timestamp":1787954181669811001}],"created_at":1787858559072112001,"creation_channel":"cli","deps":[{"link_uuid":"664deeb7-c55d-4e47-a191-af215eb6af12","relation":"relates_to","target_id":"654e-3c36-c3bc-4d77"},{"link_uuid":"0e38454f-e345-41dd-ba0a-0df94d0a5836","relation":"depends_on","target_id":"98b8-5f08-1569-45cc"}],"description":"## Summary\n\n`list_tickets` against this store can terminate with `MCP request failed: Transport closed`\nand no structured error payload — the caller cannot tell whether the query was invalid, the\nserver failed, or the response was simply too large.\n\n## Proven root cause\n\nUnfiltered `tools/call list_tickets {}` against the deployed endpoint returned `http=200`,\n**94,541,551 bytes over 177.29 seconds**, in one well-formed SSE frame. **The server does not\nfail.** The client abandons a 94.5 MB / 177 s response, and how it abandons is client-specific\n(Copilot CLI: `Transport closed`; a 30 s-budget client: timeout; a third: 219,815 chars spilled\nto disk). None can distinguish \"too big\" from \"server died\", because the server offers no bound\nand no structured signal.\n\n## Reconciliation with `unreal-milky-sloth` (`6fe7-956f-4901-45cf`) — read before fixing\n\nThat sibling **REFUTED the response-size hypothesis and was right to on its evidence**: its\nfailing call was 50,532 bytes while another client succeeded at ~219,000 (\"size does not\ndiscriminate\"), its symptom was `TypeError: Do not know how to serialize a BigInt` — a type\nerror, not a size or timeout error — and post-fix it live-validated `ready_tickets` returning\n939,719 characters successfully.\n\nBoth findings stand, because they are **different failures**. That ticket: the server emitted\nbare 19-digit ints and a JS client threw while parsing; fixed, and `js_safe_result` now quotes\nthem. This ticket: measured **after** that fix shipped, the payload parses cleanly and is\n94.5 MB — not a serialization defect, an unbounded payload.\n\nSo the **219,815-character datum is NOT evidence for this ticket's cause and is not used as\nsuch**; at 4.3x a failing call it discriminates nothing, exactly as the sibling argued. The\ndiscriminating evidence is the post-fix 94.5 MB / 177 s measurement, which BigInt cannot\nexplain. The other original candidates are closed: BigInt **REJECTED** (the call completes and\nparses); deploy cutover **REJECTED** (reproducible three days after the 18:54:29Z replacement,\nfrom a session never orphaned).\n\n## The guard that already exists, and why it is not enough\n\nNot greenfield. `list_tickets` is already lean-by-default (`full: bool = False`), dropping\n`description`/`comments` — but that saves only 39% on this store, because **88% of the lean\npayload is base64 DSSE signature material** (`authorship_ledger` 59%, `attestations` 23%,\n`signature` 6%) that no list caller consumes: 15,548 bytes per row, 1,726 without it.\n`ready_tickets` has **no lean mode and no limit at all** (61 rows, 693,556 bytes). The one\npayload bound that exists — `_cap_workflow_payload`, 90,000 bytes, \"under the client's ~25K-token\nbudget\" — is wired only to `get_workflow_status`/`get_workflow_result`. Full measurement tables\nare in the Phase 4 comment.\n\n## Acceptance Criteria\n\n- [x] Cause identified and explicitly reconciled with both sibling tickets (above).\n\n- [ ] **One shared lean projection.** A single `lean_projection` over `LEAN_OMITTED_FIELDS`\n      (`_engine_support/reads.py`) is the only spelling of the lean row, dropping\n      `authorship_ledger`/`attestations`/`signature`/`keyring` as well as the two bodies, called\n      by BOTH backends: `list_states` and `_snapshot/ticket_view.py::TicketView.list_by_query`.\n      The LIBRARY is left alone: `rebar.ready(*, sort, repo_root)` -> `ready_states(tracker, *,\n      epic, sort)` -> `public_state` has no `include_body`/`full` plumbing and this plan\n      deliberately adds none. The projection happens one layer up, in the MCP tool\n      (`_mcp_reads._discovery_rows`), through that same shared function. Separately, the MCP\n      tool `ready_tickets` gains a `full: bool = False` parameter it does not have on\n      `origin/main` (`def ready_tickets(sort)`), so `full=True` restores the previous bytes\n      exactly.\n\n- [ ] **Bounded, measured at a named seam.** Both list tools bound at the same 90,000-byte\n      `_WORKFLOW_TOKEN_BUDGET_BYTES`. Raw reducer rows under-estimate the real payload, so the\n      bound runs INSIDE the tool body after `TicketStateOut.model_validate` and CALLS\n      `js_safe_result` on those rows itself, rather than waiting for the error guard, which\n      applies that transform only after the body returns. Same pure function, same rows — so\n      measured bytes equal emitted bytes while the raise point stays where a structured error\n      is still deliverable.\n\n- [ ] **Structured refusal, right exception TYPE, closed vocabulary.** Raises a\n      `rebar._errors.RebarError` — the type matters, not just the attribute: `_envelope_error`\n      only envelopes a known rebar exception type, so a plain `Exception` carrying `.error_code`\n      is dropped and the caller gets an unstructured failure. Carries\n      `error_code=\"response_too_large\"`, naming match count, byte size, budget and a remedy.\n      Never a partial list; never a bare transport close. The value is added to\n      `rebar.KNOWN_ERROR_CODES` and `tests/unit/api_surface_baseline.json`. `error_code_for`\n      needs no change (step 5 returns a non-empty `exc.error_code`); no schema change\n      (`error_envelope.error` is an open string, not an enum).\n\n- [ ] **The remedy must be one the REFUSED TOOL can execute.** `list_tickets` accepts six\n      filters. **`ready_tickets` accepts NO filter argument**: on `origin/main` it takes only\n      `sort`, and the `full` this change adds switches SHAPE, not which tickets come back — so\n      neither narrows the result, and a shared \"narrow with has_tag\" message would name\n      arguments the tool rejects. `ready_tickets`' refusal points at `next_batch(epic_id)`\n      instead. Its measured headroom is ~1.7% (see comment), so refusing is a near-term state\n      and the remedy has to work.\n\n- [ ] **Any surface whose DEFAULT output narrows** is recorded as a pre-1.0 breaking change in\n      `docs/release-notes.md` and `CHANGELOG.md`, with measured before/after and the opt-out.\n\n- [ ] **Regression coverage asserts the error's CONTENTS**, not merely that a refusal occurred.\n      The envelope is `{error, input, message, exit_code}`, so `error` is asserted as its own\n      key while match count, byte size, budget and remedy are asserted as substrings WITHIN\n      `message`. Asserted for BOTH tools, with the per-tool remedy checked separately\n      (`list_tickets` names its filters; `ready_tickets` names `next_batch` and must NOT name\n      filters it lacks). Plus an under-budget list returned whole, and the regression window —\n      rows whose RAW size is under budget while the wire payload is over must still be refused.\n\n- [ ] **Rollout.** Both halves reach all deployed traffic at once. That is accepted because the\n      refusal is ADDITIVE (a previously-unbounded call gains a structured failure it never had)\n      and the narrowing is reversible per-call via `full=True`; the live-validation criterion\n      below is what confirms the deployed behaviour rather than assuming it.\n\n- [ ] **LIVE VALIDATION — REQUIRED TO CLOSE.** `list_tickets` and `ready_tickets` through the\n      deployed endpoint return results (or a structured limit error) with no transport close.\n      **Auth precondition:** the endpoint is behind the OAuth gate, so the client MUST present a\n      valid bearer token; a `401`/`403` is a FAILED validation, not an environment excuse.\n      Evidence must be OBSERVED against the deployed server and recorded in a comment naming the\n      tools, arguments and actual response. A passing local test does NOT satisfy this, and\n      neither does a merged change: the container must have redeployed and served the call.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_mcp_budget.py","reason":"New: the MCP response-payload budget cluster, extracted from mcp_server.py (800-LOC cap) and extended with the list bound."},{"path":"src/rebar/mcp_server.py","reason":"Budget cluster moved out; re-exports the two bounds and hands bound_list_payload to the tool context."},{"path":"src/rebar/_mcp_reads.py","reason":"list_tickets and ready_tickets are now lean-projected and bounded; new _discovery_rows helper."},{"path":"src/rebar/_engine_support/reads.py","reason":"LEAN_OMITTED_FIELDS + lean_projection: the lean list row now drops the signature bulk, not just the bodies."},{"path":"src/rebar/_snapshot/ticket_view.py","reason":"Snapshot read backend uses the same lean_projection so the two backends cannot drift."},{"path":"src/rebar/_errors.py","reason":"Adds the response_too_large error code to KNOWN_ERROR_CODES."},{"path":"tests/interfaces/facades/test_mcp_list_payload_budget.py","reason":"New RED-first regression coverage for both defects."},{"path":"tests/unit/api_surface_baseline.json","reason":"Records the added error code."},{"path":"scripts/gen_mcp_reference.py","reason":"Tool-context fixture gains bound_list_payload."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["depends_on","98b8-5f08-1569-45cc"],["relates_to","654e-3c36-c3bc-4d77"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e548d250-40b4-4436-940f-73b99c7e6947","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["mcp","transport","scale"],"ticket_id":"494b-2dd3-e9d3-4fb0","ticket_type":"bug","title":"MCP list_tickets can close the transport on a large store, with no structured error","verify_commands":[]},"source_event_uuids":["e548d250-40b4-4436-940f-73b99c7e6947","be5f0a25-a28e-4198-b7c2-2d47cb39827c","2be0351e-8b9f-47c8-9c5f-d7e2753224ff","86ac59c8-c27b-456e-b814-7f72b14d9ab6","1110a03b-a18b-4b11-947e-806779255f02","664deeb7-c55d-4e47-a191-af215eb6af12","83bc1939-b2d3-45ac-97f6-3fa69b325351","431657a3-c2a0-4664-bc30-47c9ad0caf69","9cb6e180-30f3-4417-824e-83decbc89870","12c1527e-0708-4374-a17d-8b662a471b45","0d33bc39-0893-418e-9329-78e59c303d16","2770d763-bf0c-4bc9-a233-30fb84d2c670","d4b1de39-4251-40dd-b9c0-099f28af7c05","ccad8b22-3448-49a9-b310-ad0b4a915f11","0e38454f-e345-41dd-ba0a-0df94d0a5836"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787956858802924532,"uuid":"8dc01fb0-066c-4517-af02-cc44b2966a9f"}