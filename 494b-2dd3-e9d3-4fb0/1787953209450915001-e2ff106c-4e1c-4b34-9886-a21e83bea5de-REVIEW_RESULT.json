":447795,"output_tokens":6586,"requests":11}},{"kind":"success","lineage":{"dependencies":[],"digest":"053258d4f9853006280ed4f2d0811a1b7c410e19bc4d1e492ae3fe48742a7f4b"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":68397,"output_tokens":3224,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"d19131399dde85cbf53c3a3858bf20c609ce04bee110ab67b3c4a6d9fb3a61ae"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":235729,"output_tokens":3144,"requests":8}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Confirm ready_tickets fits under 90,000 bytes after projection (or provide narrowing filters / a ready_tickets-specific limit) so the default ready_tickets call returns results rather than always raising response_too_large, and confirm the 'filters to narrow with' guidance is actionable for a surface that may accept no filters.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["E6","COH"],"decision":"block","decision_margin":0.0,"drop_reason":null,"evidence":["Plan: 'ready_tickets has no lean mode and no limit at all (61 rows, 693,556 bytes)'","Plan: 'Per row: 15,548 bytes lean vs 1,726 with those four (plus keyring) dropped' -> 61 * 1,726 = 105,286 bytes > 90,000","AC: error names 'the filters to narrow with' but plan states ready_tickets reaches lean only at the tool layer and never mentions ready_tickets accepting filters"],"finding":"The 90,000-byte budget applied to ready_tickets may make the default (unfiltered) ready_tickets call ALWAYS refuse: the plan's own per-row figures (lean row 15,548 bytes; with the four heavy fields dropped 1,726 bytes) times ready_tickets' current 61 rows yields ~105,286 bytes, which exceeds 90,000 even after full projection. The plan does not state whether ready_tickets accepts narrowing filters, so the structured error naming 'the filters to narrow with' may be unactionable for that surface, leaving the default ready_tickets call permanently broken rather than fixed.","group_criteria":null,"group_id":null,"id":"fefba680d150ab1bd","impact":0.8,"is_primary":null,"location":"AC 'Bounded, and measured at a named seam' + AC 'Structured refusal'","norm_id":"n41586ef170d2da28","priority":0.8,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A caller invokes ready_tickets with no arguments against this store and receives response_too_large every time, unable to narrow because ready_tickets exposes no filter parameters"],"severity":"critical","suggested_fix":"Either verify 61 fully-projected ready_tickets rows fit under budget with the measured seam, or add a row-limit/pagination or narrowing parameters to ready_tickets and make the structured error name the specific ready_tickets-applicable narrowing levers; state the expected post-fix byte size for the default ready_tickets call in the AC.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"high","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Name the exception TYPE the budget check raises and require it to be a RebarError (or CommandError) subclass that sets `error_code=\"response_too_large\"`, so _envelope_error's isinstance gate admits it and error_code_for step 5 emits the structured envelope.","cohort":["T8"],"criteria":["T8"],"decision":"block","decision_margin":0.1,"drop_reason":null,"evidence":["Plan: 'Exceeding the budget raises an error carrying error_code=\"response_too_large\", delivered through the existing install_error_guard envelope seam' and 'error_code_for needs no change (its precedence step 5 already returns a non-empty exc.error_code)'","src/rebar/_mcp_errors.py:74 `_envelope_error`: `if isinstance(exc, (RebarError, CommandError, ConfigError, mismatch_type, llm_error_type)):` — only these types produce an McpEnvelopeError; otherwise it returns None and the original exception re-raises","src/rebar/_errors.py:132-135 step 5 reads `exc.error_code` but is only reached after error_code_for is CALLED, which _envelope_error does only inside the isinstance gate","The plan defines the enum VALUE (added to KNOWN_ERROR_CODES) but not the emission protocol (which exception subclass carries it) — the decision rule is not co-located with the schema the executor needs"],"finding":"The structured-refusal error's exception TYPE is unspecified; for error_code_for's step-5 `exc.error_code` branch and the install_error_guard envelope to fire, the raised exception must be an instance of RebarError/CommandError/ConfigError/ConcurrencyMismatch/LLMError — a plain exception carrying an .error_code attribute is dropped by _envelope_error's isinstance gate and re-raised unguarded.","group_criteria":null,"group_id":null,"id":"f25d690dda423d11d","impact":1.0,"is_primary":null,"location":"AC 'Structured refusal, in the closed vocabulary'","norm_id":"na8b6acc895997703","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["An executor implements the budget check by raising a bespoke or bare exception with an error_code attribute set to 'response_too_large'; because it is not a RebarError/CommandError subclass, _envelope_error returns None and the client sees an unstructured error instead of the promised envelope."],"severity":"critical","suggested_fix":"State that the refusal raises a RebarError subclass (e.g. a new ResponseTooLargeError(RebarError) or reuse of CommandError) with `error_code=\"response_too_large\"` set, so it passes the isinstance gate in `_mcp_errors._envelope_error` and error_code_for's step-5 branch returns the code.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"high","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Specify how `_mcp_reads` obtains the 90,000-byte budget without a circular import (thread it via `ctx` like `cap_workflow_payload`, or relocate `_WORKFLOW_TOKEN_BUDGET_BYTES` to a shared leaf module both `mcp_server` and `_mcp_reads` import), since `mcp_server` already imports `_mcp_reads`.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"advisory","decision_margin":-0.0444,"drop_reason":null,"evidence":["`src/rebar/mcp_server.py:451: _WORKFLOW_TOKEN_BUDGET_BYTES = 90_000` — defined module-local, alongside `_payload_bytes` and `_cap_workflow_payload`","`src/rebar/mcp_server.py:60: from rebar._mcp_reads import register_read_tools` — mcp_server depends on _mcp_reads, so the reverse module-level import would be circular","The existing `_cap_workflow_payload` is threaded into `_mcp_reads` via `ctx.cap_workflow_payload` (`_mcp_reads.py:226`), NOT imported — establishing that this budget is deliberately passed through the ctx namespace, a path the plan does not adopt for the new bound"],"finding":"The plan reuses `_WORKFLOW_TOKEN_BUDGET_BYTES` inside the `_mcp_reads` tool body, but that constant (and its `_payload_bytes` helper) is module-private to `src/rebar/mcp_server.py` (line 451), and `mcp_server.py` imports FROM `_mcp_reads` (line 60), so importing the symbol back would introduce a circular import; the plan does not name how `_mcp_reads` acquires the budget value.","group_criteria":null,"group_id":null,"id":"f28803dbb40b98fca","impact":0.85,"is_primary":null,"location":"AC 'Bounded, and measured at a named seam' — `_mcp_reads` tool body reusing `_WORKFLOW_TOKEN_BUDGET_BYTES`","norm_id":"n85d38012018719cb","priority":0.7556,"reason":"default-advisory","recalled":false,"scenarios":["Implementing the list_tickets/ready_tickets bound and needing the 90,000-byte constant inside _mcp_reads"],"severity":"critical","suggested_fix":"Move `_WORKFLOW_TOKEN_BUDGET_BYTES` (and a shared byte-measuring helper) into a small shared module — or thread the budget through `ctx` exactly as `_cap_workflow_payload` is threaded via `ctx.cap_workflow_payload` — so `_mcp_reads` references one budget without importing `mcp_server`.","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the rollback/adjustment path for the 90KB bound (revert or configurable budget) and give ready_tickets an opt-out (or explicitly justify why an unretrievable-by-design ready_tickets over 90KB is acceptable), rather than a hard 100%-traffic refusal with no escape hatch.","cohort":["E3","E5","F4","G5","T12","T6","T9","necessity","project.engine-layer-enforcement","project.portability"],"criteria":["T12"],"decision":"advisory","decision_margin":-0.682,"drop_reason":null,"evidence":["'list_tickets AND ready_tickets are bounded at the same 90,000-byte _WORKFLOW_TOKEN_BUDGET_BYTES'","'this plan deliberately does NOT add that plumbing to ready_states' — so ready_tickets has no full=True opt-out","'ready_tickets has no lean mode and no limit at all (61 rows, 693,556 bytes)' — today it returns whole; after the change it is bounded with no opt-out","LIVE VALIDATION criterion mentions redeploy but no rollback/canary/staged-rollout path is described"],"finding":"The plan changes runtime behavior of the deployed MCP server (a new 90,000-byte hard refusal plus a narrowed default projection) but specifies no staged rollout, canary, or explicit rollback path; and while list_tickets gets a `full=True` opt-out, ready_tickets is explicitly given no lean mode and no full/opt-out plumbing, so its default output narrows AND it becomes refusable at 90KB with no escape hatch for a caller who legitimately needs the whole set.","group_criteria":null,"group_id":null,"id":"f8f42d5d35a3e5173","impact":0.536,"is_primary":null,"location":"AC: 'Bounded, and measured at a named seam' and 'One shared lean projection' (ready_tickets has no full plumbing)","norm_id":"n39f2d4cccf1a67bb","priority":0.268,"reason":"default-advisory","recalled":false,"scenarios":["A future store where ready_tickets legitimately exceeds 90KB (its current 693KB already does) is refused with response_too_large and, unlike list_tickets, the caller has no full=True to obtain the data at all.","If the 90KB bound proves too tight in production, there is no flag to widen it and no stated rollback other than a code revert + redeploy."],"severity":"major","suggested_fix":"Add an AC noting the bound is a code-revertable change and either (a) add full/limit plumbing so ready_tickets callers can opt out, or (b) document why ready_tickets over 90KB should always refuse and how a caller then narrows.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"medium","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State that the list_tickets/ready_tickets byte bound reuses the existing `_payload_bytes` helper (mcp_server.py:454) rather than introducing a second byte-measurement spelling for the shared `_WORKFLOW_TOKEN_BUDGET_BYTES`.","cohort":["A1"],"criteria":["A1"],"decision":"dropped","decision_margin":-0.8263,"drop_reason":null,"evidence":["`_payload_bytes` already exists at src/rebar/mcp_server.py:454 and is the sole measurement used by `_cap_workflow_payload` against `_WORKFLOW_TOKEN_BUDGET_BYTES`","The plan reuses the same 90,000-byte `_WORKFLOW_TOKEN_BUDGET_BYTES` but its measurement clause only says the bound 'is taken on the validated rows' and 'CALLS js_safe_result on those rows', without naming the size function","Absence rationale: since the budget constant is deliberately shared, using a different byte-counter than the workflow cap's would let the two surfaces disagree on what '90,000 bytes' means"],"finding":"The plan specifies measuring the payload byte size on validated rows but does not state whether it reuses the existing `_payload_bytes` helper (mcp_server.py:454, `len(json.dumps(payload, default=str))`) that the workflow cap already uses for the same 90,000-byte budget, risking a second byte-measurement spelling for the same budget.","group_criteria":null,"group_id":null,"id":"fec19d31fcf12f6d9","impact":0.33,"is_primary":null,"location":"AC: 'Bounded, and measured at a named seam.'","norm_id":"n0dfdcfd86d4a69f4","priority":0.1237,"reason":"low-validity","recalled":false,"scenarios":["A list payload measured by a new ad-hoc len(str(...)) diverges from the workflow cap's json.dumps measurement, so equal-sized payloads are treated inconsistently across the two bounded surfaces"],"severity":"minor","suggested_fix":"In the 'Bounded, and measured at a named seam' AC, name `_payload_bytes` as the measurement function applied to the `js_safe_result`-transformed rows, so both the workflow cap and the new list/ready bound share one size definition against the shared 90,000-byte budget.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Weigh the chosen refuse-with-`response_too_large` hard cap against the prior-art baseline (MCP-native cursor pagination and the in-repo `_iter_cursor_pages` precedent) and record why refusal-over-pagination is the right choice for list_tickets/ready_tickets (e.g., MCP tool-call RESULT content vs protocol-level list pagination, caller ergonomics, store scale).","cohort":["T1"],"criteria":["T1"],"decision":"dropped","decision_margin":-0.7175,"drop_reason":null,"evidence":["Plan bounds `list_tickets` AND `ready_tickets` at 'the same 90,000-byte `_WORKFLOW_TOKEN_BUDGET_BYTES` the workflow cap already enforces' and 'Exceeding the budget raises an error carrying error_code=response_too_large ... Never a partial list'.","Retrieved MCP spec (modelcontextprotocol.io/specification/.../server/utilities/pagination): MCP 'supports paginating list operations that may return large result sets ... especially important when connecting to external services over the internet ... to avoid performance issues with large data sets' via opaque cursor tokens.","In-repo prior art: `_iter_cursor_pages` opaque-cursor page walk at src/rebar/_engine/rebar_reconciler/adapters/jira/acli_graph.py:53 ('THE one cursor loop'), plus pagination ADR-0062.","The cited internal precedent (`_cap_workflow_payload`, mcp_server.py:460-490) TRUNCATES to a schema-valid smaller payload; this plan instead RAISES and returns nothing, making a large-but-legitimate list unreachable through the tool — a materially different design, not a behavioural reuse.","Plan contains no comparison of refuse-with-error vs pagination and no rationale for the choice."],"finding":"The plan adopts a refuse-with-`response_too_large` hard byte cap to bound large MCP list results without considering the established prior-art baseline for this exact problem — MCP-native cursor-based pagination (opaque `nextCursor`) and the in-repo `_iter_cursor_pages` cursored-fetch precedent — nor justifying refusal over pagination.","group_criteria":null,"group_id":null,"id":"ffaa92b8b92dc8ec5","impact":0.33,"is_primary":null,"location":"Acceptance Criteria — 'Bounded, and measured at a named seam' and 'Structured refusal, in the closed vocabulary'","norm_id":"n3ba1d7c2342dbcdf","priority":0.0825,"reason":"low-validity","recalled":false,"scenarios":["A store with >2,855 tickets where a legitimate, correctly-filtered `list_tickets`/`ready_tickets` result exceeds 90,000 bytes: the caller receives a refusal and cannot retrieve the data through the tool at all, whereas a paginated design would return it in bounded chunks.","A reviewer or future maintainer asks why rebar did not use MCP's standard list pagination and finds no recorded rationale."],"severity":"minor","suggested_fix":"Add a short 'Prior art / design choice' note to the plan: cite MCP's cursor-pagination utility and the repo's `_iter_cursor_pages`, note that MCP's `nextCursor` envelope applies to protocol-level list methods rather than `tools/call` result content, and justify why a refuse-with-structured-error bound (plus `full=`/narrowing filters) is preferred here over adding a cursor/limit parameter that returns bounded pages.","tier":"LLM","validity":0.25,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"low","likelihood":"low","prod_impact":"low","reversibility":"moderate","silent_vs_self_revealing":""