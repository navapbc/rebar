721-4593-8a4e-c2405936a6f2","position":{"commit_sha":"f73ae773f07a60efbca5e912f61ed27df4a66500","position":"1787386134233116001-8a4f3e8a-1721-4593-8a4e-c2405936a6f2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"771ccf453de6850bd761a479592e17df9103c94a0fea8272122db7210963cb0f","event_uuid":"93a2cc6c-7d2e-449b-b919-555aa3a8f5a0","position":{"commit_sha":"929a9e677fbbc640ccad02da11bab8da765bfc5d","position":"1787386383714493001-93a2cc6c-7d2e-449b-b919-555aa3a8f5a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"22aa8ff4fbdfb66706e76f218f9320142d75e394583976a6b657f0cdad57fab2","event_uuid":"7db687f6-8276-4db7-b199-20501b7dafba","position":{"commit_sha":"929a9e677fbbc640ccad02da11bab8da765bfc5d","position":"1787386387222001001-7db687f6-8276-4db7-b199-20501b7dafba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-239_agent","claim_remote_session":null,"claimed_session":"e50ec61e-3a77-4eb8-b56b-c1d0f90ff9bc","comments":[],"created_at":1787384535891300001,"creation_channel":"cli","deps":[{"link_uuid":"5a2b630e-8a9f-4249-8863-3f4803d9fc6b","relation":"discovered_from","target_id":"4cee-8734-7816-4e4c"}],"description":"## Context / Problem\nStory `freakish-verminous-agouti` (4cee-8734-7816-4e4c) consolidated the outbound-comment\nfit/dedup-key derivation into `fit_for_send(...) -> FittedComment(landed_text, wire_body)` in\n`src/rebar/_engine/rebar_reconciler/outbound_comments.py`, and closed with all seven of its own\nacceptance criteria verified and mutation-checked. Those criteria are behavioural, and none of\nthem claims a construct-uniqueness guard — so the ticket closed honestly.\n\nThe gap is against the PARENT EPIC's AC1, not against 4cee's own plan. Epic\n`airborne-wellloved-kingfisher` (2ddd-b523-06da-4b4a) requires: \"Every duplicated computation\ninventoried in the review has exactly one implementation on `main`, each delivered by one\nconsolidation child; checked by that child's construct-uniqueness test passing in the default\n`Verified` tier.\" An audit of the merged consolidation children found scanning guards for 6f18\n(`tests/unit/store/test_store_paths.py`), 1cf6 (`tests/unit/store/test_stamped_lock.py`), 7931\n(`tests/unit/test_single_definition_helpers.py`), 25b4\n(`tests/unit/test_nested_pytest_uniqueness.py`) and 7e0d\n(`tests/unit/test_predates_gate_guard_parity.py`), and guards in flight for 4329 and 111a\n(Gerrit 2083 and 2082). `tests/unit/rebar_reconciler/test_fit_for_send.py` has no scan of\n`src/rebar` at all — its only `read_text` is loading a JSON corpus payload.\n\nThis matters because the comment key/send fit was one of the WORST offenders in the defect\nreview that motivated the epic: five copies, arriving as repeated instalments. The\nconsolidation is real but currently undefended — a sixth copy can merge with nothing failing.\n\n## Approach\nAdd a construct-uniqueness guard for the fit/dedup-key derivation, built to the epic's rule:\n1. Scan every file under `src/rebar` EXCEPT the owner `outbound_comments.py`.\n2. Match the CONJUNCTION of atoms that constitute the construct — the fit call together with\n   the marker-stripped decode that produces the dedup key — never a single common token such\n   as `to_wire(` or `body`, which appear all over the reconciler and would make the guard fire\n   on innocent code.\n3. Provide a `# comment-fit-ok: <reason>` escape marker whose reason is MANDATORY.\n4. Prove teeth by mutation, three ways: an unmarked second derivation FAILS, the same with a\n   reasoned marker PASSES, the same with a bare reasonless marker FAILS again.\n\nDerive the exact atom conjunction by reading the landed `fit_for_send` and the two enactment\nconsumers (`dispatch_one.py`, `dispatch_apply_phases.py`) before writing the matcher.\n\n## Scope\n`tests/unit/rebar_reconciler/test_fit_for_send.py` (or a sibling guard module). No production\nchange is expected; if the guard finds a genuine second copy, that copy is rewired and the\nfinding recorded here.\n\n## Testing\nThe guard itself plus the mutation evidence above. `tests/unit/rebar_reconciler/` passes\nunchanged.\n\n## Acceptance Criteria\n- [ ] A test scans every file under `src/rebar` except `outbound_comments.py` and asserts no\n      second fit/dedup-key derivation exists; checked by running it.\n- [ ] The matcher uses a conjunction of atoms, not a single common token; checked by reading\n      the test and by confirming it does not fire on the existing reconciler modules.\n- [ ] A reasonless `# comment-fit-ok:` marker is rejected; checked by a negative case.\n- [ ] Mutation evidence is recorded: unmarked copy FAILS, reasoned marker PASSES, bare marker\n      FAILS; checked by a comment on this ticket quoting the three runs.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/rebar_reconciler/test_fit_for_send.py","reason":"construct-uniqueness guard for the fit/dedup-key derivation"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","2ddd-b523-06da-4b4a"]],"no_file_impact_reason":"","parent_id":"2ddd-b523-06da-4b4a","parent_status_uuid":"93a2cc6c-7d2e-449b-b919-555aa3a8f5a0","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"a73e-ca14-59d1-4e9b","ticket_type":"story","title":"Guard the outbound comment fit against a sixth copy","verify_commands":[]},"source_event_uuids":["2205f073-690a-45a5-84c5-7e9b76d411d3","db579c0d-7c98-4016-9ab9-4d8d306c86c0","5a2b630e-8a9f-4249-8863-3f4803d9fc6b","8a4f3e8a-1721-4593-8a4e-c2405936a6f2","93a2cc6c-7d2e-449b-b919-555aa3a8f5a0","7db687f6-8276-4db7-b199-20501b7dafba"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787386387222001002,"uuid":"f169d122-4dca-4a12-9876-d2d3dfc2d722"}