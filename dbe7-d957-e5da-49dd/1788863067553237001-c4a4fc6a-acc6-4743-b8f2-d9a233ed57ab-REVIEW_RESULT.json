d _mcp_writes.py:182')","norm_id":"n6cd7cba2548e8869","priority":0.22,"reason":"default-advisory","recalled":false,"scenarios":["Implementer follows the cited locations to 'reuse the rule', finds only a passthrough and a TypedDict, and re-invents the normalization instead of importing recent_creates.normalize_title — the exact second-definition drift AC-1 warns against"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Clarify that the duplicate-title metric reuses recent_creates.normalize_title() as the shared predicate (grouping durable CREATE-event titles over the rolling-hour window), NOT the 600s config-gated journal probe, so 'the same rule' is unambiguous and the metric cannot be disabled by verify.suggest_duplicate_tickets.","cohort":["G6"],"criteria":["G6"],"decision":"dropped","decision_margin":-0.5394,"drop_reason":null,"evidence":["AC#1: 'derived from the SAME rule duplicate_warning uses — reuse it, do not invent a second definition that can disagree.'","recent