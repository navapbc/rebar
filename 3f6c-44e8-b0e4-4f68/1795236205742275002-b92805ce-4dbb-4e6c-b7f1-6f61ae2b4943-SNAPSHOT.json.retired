{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795236205742275002,"compiled_state":{"alias":"smiling-ancient-finwhale","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"9d10232dd899dfedf5a4d8a2453036266cd5f110","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3f6c-44e8-b0e4-4f68","material: cbfbbdf17ef533cb","material-part: children 647ea2107ca5072f 0","material-part: description 485dfdb626c708c3 6398","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact f582dae6f9533264 4","material-part: ticket_id 15f1e3cb1f558eef 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 15","review-phase: planning","rebar-version: 0.16.0 (9d10232dd89)","regver: aa61189569d34126","verified-at-sha:9d10232dd899dfedf5a4d8a2453036266cd5f110","dep 15291db47ebff91333129262636894bbe77a33a27480368cf7a8cd0c2d14b17f src/rebar/_commands/_seam.py","dep 5b9d83907393e032889f73b9f17a78c923333f20fa83a7a352cc9ba6b557cd76 src/rebar/_commands/txn.py","dep 6bbf86e707d796f80b13d2d42609af6afe8a925fede15f8f795c6778f4a8879b src/rebar/_store/freshness.py","dep absent tests/interfaces/store/test_write_after_reclaim.py","read-set: 21","read-path: src/rebar/_cli/_init.py","read-path: src/rebar/_commands/_seam.py","read-path: src/rebar/_commands/completion_bundle.py","read-path: src/rebar/_commands/completion_delivery.py","read-path: src/rebar/_commands/cross_session.py","read-path: src/rebar/_commands/transition.py","read-path: src/rebar/_commands/transition_close.py","read-path: src/rebar/_commands/txn.py","read-path: src/rebar/_engine_support/reads.py","read-path: src/rebar/_io/import_ndjson.py","read-path: src/rebar/_lib_warn.py","read-path: src/rebar/_lib_writes.py","read-path: src/rebar/_store/compat.py","read-path: src/rebar/_store/event_append.py","read-path: src/rebar/_store/freshness.py","read-path: src/rebar/_store/hlc.py","read-path: src/rebar/_store/lock.py","read-path: src/rebar/_store/push_recovery.py","read-path: src/rebar/_store/stale_override.py","read-path: src/rebar/_store/sync.py","read-path: tests/unit/test_gate_store_freshness.py","currency-basis: file_impact"],"material_fingerprint":"cbfbbdf17ef533cb","merged_log_commit":"9d10232dd899dfedf5a4d8a2453036266cd5f110","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1795235690429146000}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":13,"unsigned":0},"authorship_ledger":[{"content_hash":"abaf320b946a6400142fec7ce14d60432dd74b5c4d8669a28056349503786c58","event_uuid":"fae4fd5f-b8cf-49ee-b8b7-a856b748283d","position":{"commit_sha":"25cf52cee78b457cf8835d84430625ab61ed93a4","position":"1795229114016447001-fae4fd5f-b8cf-49ee-b8b7-a856b748283d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"1394b343beb2846585133c2424b0262d1e81ed4c8469259f3a1dc9223aae8f53","event_uuid":"8150312d-4f4e-44a9-bbf6-c56ae8e97058","position":{"commit_sha":"f94bd1756a6a7c8fef71d10eb85a387a309fa226","position":"1795229227695173001-8150312d-4f4e-44a9-bbf6-c56ae8e97058"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"b2a858b132920982321d43735cb24ce98ebcff45dc7921e0b32c49155a32f87b","event_uuid":"d4867d55-5417-4ad4-af41-19bfbe1fe627","position":{"commit_sha":"4231b3e0e9ab0012ba26fbe97adc10fa9666ffb4","position":"1795233499300529001-d4867d55-5417-4ad4-af41-19bfbe1fe627"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"fe4739aca6d9c79973fac1abf9e129d17504db5375ad1e24c881a8cf6c45414b","event_uuid":"085ddb68-98b4-42e5-9b4d-275988e92ee5","position":{"commit_sha":"44a68e4f6d2f4fcb9a081cfd8c0e3bedd0b5e606","position":"1795233528237729001-085ddb68-98b4-42e5-9b4d-275988e92ee5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"3ca20f156e6f5274842cbe41f1e24b6ab05f584ac96d3733c716b15e821f9894","event_uuid":"827ec5fc-8373-4b53-822a-5fb1d0b7a547","position":{"commit_sha":"4670b3592d6fb8e4642785d02e22d5a27c7efc97","position":"1795233579374003001-827ec5fc-8373-4b53-822a-5fb1d0b7a547"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"304d71274c102a5993e998acac52c43253cd0104ec27