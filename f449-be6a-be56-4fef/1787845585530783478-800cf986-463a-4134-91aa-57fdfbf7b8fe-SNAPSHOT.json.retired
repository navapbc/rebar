\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bed956c19793da954aa266f3f5c513c7c4b8467b5ef91bc12d363b72c10db035","event_uuid":"8c1edae6-d8a6-4506-bb8c-0a329b633be3","position":{"commit_sha":"ee80bca5379c431c65674ec72451f12531704a03","position":"1787825517169037001-8c1edae6-d8a6-4506-bb8c-0a329b633be3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2ef0dcbe7fc26bb3af5ca3cd1611a57e729f9bfe1b037e97b5e50a46919652ae","event_uuid":"17c43dca-c655-4fa8-a79f-081737f90196","position":{"commit_sha":"0e350a3dba1ba3e83e40e57b78311da38bd4e722","position":"1787825529073790001-17c43dca-c655-4fa8-a79f-081737f90196"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cda680af9fc2cd6887a21b7db6058eb63092d5e7bd6efacbc6bc8e8a96714f44","event_uuid":"0797ef7d-e3ee-43b5-9a9e-0edd914b4b1a","position":{"commit_sha":"3f32b0a3fc67adfefda1668a4ca85722c2de4c57","position":"1787825676287108001-0797ef7d-e3ee-43b5-9a9e-0edd914b4b1a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2de6228fd81b484adfe639f9527f8ea0890da46dc59a8fd90ffbb25c792fd236","event_uuid":"84fcd16d-a50d-4d9a-9483-690c4d7f9b29","position":{"commit_sha":"b90597781d786b6d48ce5ebda46132252770cb6c","position":"1787827649930053001-84fcd16d-a50d-4d9a-9483-690c4d7f9b29"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a1ffe8b00f0029581b0fbe36169d5e848b57b95400b7f6ee73b0be4cd283bc56","event_uuid":"25ebc854-c767-4643-a43b-27413554aa8d","position":{"commit_sha":"ca44350271e2e615b956bf086ab8017190b7d144","position":"1787828832270959001-25ebc854-c767-4643-a43b-27413554aa8d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a11522c78de5416e8761ce9465cf46cc3b4f4534310d2ace8ce33e60819f02ff","event_uuid":"30de26b4-4a5c-4864-a8b9-c8dc6634133d","position":{"commit_sha":"01b3c6412f375d05c5f63f05e71853e9b1d95d7d","position":"1787829482496412174-30de26b4-4a5c-4864-a8b9-c8dc6634133d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"64bcda9df8860f51285c6d5c274676a52d882f7123e40b6cb56c238585b4f00a","event_uuid":"3c6bad34-a556-4b13-ac4e-3bf8fa512189","position":{"commit_sha":"db42f21d66a111000c7e711b08a881f76bfa6387","position":"1787830744754330478-3c6bad34-a556-4b13-ac4e-3bf8fa512189"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"CONFIRMED mechanism (outbound_mutation_builders.py:_compute_outbound_update_mutation, ~L203): for a jira_key PRESENT in the fetcher's JQL-search snapshot, jira_fields = jira_snapshot[jira_key] (STALE); the bounded direct GET (_safe_get_issue) is taken ONLY for bound-but-ABSENT keys (bug 1e08 membership-not-value seam). So a just-pushed description re-diffs vs the stale snapshot -> churn until the DC Lucene index catches up (unbounded on the ephemeral harness) -> the test's echo-safety search-wait times out. Investigating 3 resolutions (product confirm-before-push / harness sync-indexing / test relaxation) with history + product-path + harness agents before choosing.","timestamp":1787825676287108001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"ROOT CAUSE CORRECTED (supersedes the outbound-churn framing). Traced the full seam:\n\nOUTBOUND is NOT the exposed direction. diff_canonical_fields->_suppressed_by_inbound (outbound_field_diff.py:330) suppresses a mirrored field whenever local==baseline. After our own push the baseline advances to NEW (e6e9 merge_baseline overlay via synced_fields), so local(NEW)==baseline(NEW) -> outbound emits NOTHING for description regardless of the stale snapshot. Outbound cannot churn here.\n\nThe EXPOSED direction is INBOUND, LEVEL-triggered with NO baseline. Bound-field inbound goes through inbound_differ.compute_inbound_mutations -> _diff_jira_vs_local(jira_fields, local) (inbound_differ.py:97), returning any mirrored field where the CURRENT snapshot != local, consulting neither baseline nor prev_snapshot. run_differs._run_differs_inbound feeds it curr_snapshot (the JQL search snapshot) plus only an absent-key GET overlay -- no prev gating. The only protection is same-pass bidirectional suppression (3bf8), which fires only when OUTBOUND emits for the field. Since outbound is baseline-suppressed here, inbound is unguarded.\n\nConsequence (narrow but real data-loss window): in the echo pass with a STALE post-write snapshot (description=OLD/None) while local=NEW and baseline=NEW, inbound sees jira(OLD)!=local(NEW) -> emits an inbound update -> CLOBBERS local back to OLD. The live test's _wait_until_search_reflects is a DEFENSIVE wait blocking the echo pass until the search index reflects the write (so jira==local, nothing mirrors). On the starved ephemeral DC the background reindex is unbounded -> the wait never completes -> observed 'index never reflected the pushed body within 240s' timeout. A remote!=baseline guard would NOT fix it (baseline=NEW while stale search=OLD, so OLD!=NEW still fires); the only robust fix is a lag-free read.\n\nRESOLUTION (refined #1, correct layer): a SCOPED-pass snapshot overlay. Between bind_operation_runtime and run_differs in reconcile.reconcile_once, for each scoped local_id whose bound jira_key is present in curr_snapshot, direct-GET fresh fields via the classified seam (outbound_differ._safe_get_issue / get_issue_by_rest, immediately consistent) and MERGE the 5 mirrored scalar keys (summary/description/priority/status/assignee) into curr_snapshot[jira_key], preserving enrichment (parent/comment/issuelinks). This one overlay feeds BOTH differs AND _advance_baselines (all read ctx.curr_snapshot), so the echo pass sees jira==local -> no inbound clobber, outbound stays suppressed, baseline stays NEW. Scoped-only bounds GET volume; TRANSPORT_ERROR/DELETED leave the entry untouched (defer/existing path). Unscoped production passes get a follow-up (ambiguous-key generalization). With this, BOTH live DC tests drop _wait_until_search_reflects and the reindex entirely and read lag-free. Proven offline by a held-out oracle: stale search + fresh GET -> zero inbound clobber + baseline stays NEW (RED without the overlay: inbound emits description=OLD).","timestamp":1787827649930053001}],"created_at":1787825480195665001,"creation_channel":"cli","deps":[{"link_uuid":"5b92d865-4d33-457e-9263-6149ed037334","relation":"discovered_from","target_id":"1d21-887e-a923-470e"},{"link_uuid":"17c43dca-c655-4fa8-a79f-081737f90196","relation":"supersedes","target_id":"2c60-c6d5-30bf-41bb"},{"link_uuid":"30de26b4-4a5c-4864-a8b9-c8dc6634133d","relation":"relates_to","target_id":"a07a-7652-d632-4571"},{"link_uuid":"3c6bad34-a556-4b13-ac4e-3bf8fa512189","relation":"relates_to","target_id":"b940-d791-19d5-46f2"}],"description":"# Live DC rich-text lane: outbound echo re-diffs against stale JQL search snapshot\n\n## Observed failure\n`tests/external/live_jira_dc/test_dc_rich_text_live.py::test_live_rich_text_renders_and_echo_is_safe`\nand `::test_live_rich_text_both_sides_conflict_keeps_local` fail on the dispatched Live External\nIntegration run (33052311279, DC lane), both with:\n`AssertionError: the index never reflected the pushed body ... within 240s (120 attempts)`.\nThe indexed doc shows `description: None` and `updated` stuck at the binding step.\n\n## Corrected root cause (supersedes the \"index lag / widen the wait\" framing of bug 2c60)\nThe test's `_push_and_converge` blocks on `_wait_until_search_reflects` — waiting for the JQL\nSEARCH index to reflect the pushed `description`. That guards a REAL dependency: the outbound\nFIELD differ (`compute_outbound_mutations`, outbound_differ.py) diffs local tickets against the\nFETCHER'S JQL-SEARCH SNAPSHOT (`fetcher.fetch_snapshot` -> `search_issues`). For a key PRESENT in\nthe snapshot (ours is — its key is indexed for existence via `wait_until_searchable`), the differ\ncompares local `description` against the SNAPSHOT's `description`, which is STALE (`None`) until\nthe background Lucene reindex catches up. Direct GET (`_safe_get_issue` / `get_issue_by_rest`,\nimmediately consistent) is used ONLY for bound-but-ABSENT keys, not bound-and-present ones. So on\nthe ephemeral DC — whose background reindex is UNBOUNDED (ADR 0037 s3) and, on a starved instance,\nnever reflects the write within any fixed budget — the echo pass re-diffs the just-pushed field as\nchanged and would churn, and the wait times out.\n\nTwo prior fixes (2c60: widen to 240s; then force a per-issue reindex) both targeted search\nVISIBILITY. Widening cannot bound an unbounded wait, and the forced-reindex helper had NO effect\n(and no observability — it no-ops silently), likely because `/rest/api/2/reindex/issue` is not an\neffective synchronous foreground reindex on DC 8.17. The fix must remove the dependence on\nunbounded search visibility, not chase it.\n\n## Candidate resolutions (to be decided by investigation + history)\n1. PRODUCT: outbound differ confirms a snapshot-detected field change via a bounded direct GET\n   before emitting the mutation, so a stale-snapshot false-positive cannot cause churn (extends\n   the existing bound-but-absent direct-GET seam to bound-and-present keys). Robust for ANY\n   eventually-consistent remote.\n2. HARNESS: configure the ephemeral Jira DC for synchronous/fast indexing at boot.\n3. TEST: verify the landed body via a direct GET (immediately consistent) and re-express echo-\n   safety so it does not depend on unbounded search visibility.\n\n## Acceptance criteria\n- [ ] Root cause confirmed (which of 1/2/3, with history/ADR support).\n- [ ] Fix removes the unbounded-search-visibility dependency; a held-out test proves it with teeth.\n- [ ] A dispatched Live External Integration run shows the DC lane GREEN (both rich-text tests pass)\n      AND the Cloud mutation lane GREEN. Run URL commented here and on the epic.\n- [ ] `make lint && make typecheck && make test` green.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/snapshot_lagfree_refresh.py","reason":"new: lag-free scoped snapshot overlay (overlay_lagfree_scalars + refresh_scoped_snapshot)"},{"path":"src/rebar/_engine/rebar_reconciler/run_differs.py","reason":"call refresh_scoped_snapshot at the top of the diff phase"},{"path":"tests/unit/rebar_reconciler/state/test_scoped_snapshot_overlay_f449.py","reason":"held-out oracle: overlay merge/enrichment/fallback + no-inbound-clobber teeth"},{"path":"tests/unit/rebar_reconciler/orchestrate/test_reconcile_filter.py","reason":"thread a hermetic transport through the applier _load_acli seam for the scoped GET"},{"path":"tests/external/live_jira_dc/test_dc_rich_text_live.py","reason":"drop the search-index wait/reindex; rely on the overlay"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","a07a-7652-d632-4571"],["relates_to","b940-d791-19d5-46f2"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"cf66e03d-f73f-45db-be4e-71d6293a4f01","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"f449-be6a-be56-4fef","ticket_type":"bug","title":"Live DC rich-text echo re-diffs against stale JQL search snapshot","verify_commands":[]},"source_event_uuids":["3879857b-53af-41f5-b1be-6704b9420a7f","5b92d865-4d33-457e-9263-6149ed037334","cf66e03d-f73f-45db-be4e-71d6293a4f01","8c1edae6-d8a6-4506-bb8c-0a329b633be3","17c43dca-c655-4fa8-a79f-081737f90196","0797ef7d-e3ee-43b5-9a9e-0edd914b4b1a","84fcd16d-a50d-4d9a-9483-690c4d7f9b29","25ebc854-c767-4643-a43b-27413554aa8d","30de26b4-4a5c-4864-a8b9-c8dc6634133d","3c6bad34-a556-4b13-ac4e-3bf8fa512189"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787845585530783478,"uuid":"800cf986-463a-4134-91aa-57fdfbf7b8fe"}