G3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"99b9d49fecb46b807405aa045ab5868f02d4b57dadedace86c86d2277db7893a","event_uuid":"aac3dd3c-76a2-405d-9f80-c6a05b3191b0","position":{"commit_sha":"374cd140706102e7ebf0adfd2accf0faee76791f","position":"1785825795577828001-aac3dd3c-76a2-405d-9f80-c6a05b3191b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"474d2a2fd02068d1278215c6f18842fb51d831d58e7be6c683c5f5790b0b46e8","event_uuid":"cb42e058-9be1-4d68-872d-cd585a21ef50","position":{"commit_sha":"5e98a9eaa1b00c72fbfaddf8ee721f8f829cdc86","position":"1785826342203082001-cb42e058-9be1-4d68-872d-cd585a21ef50"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f63c1f41aef3fdb95b99bb321ae1b12f620eeeebb3ac13c28c6a2527335e8e5d","event_uuid":"dbd3ee19-d80e-4273-af05-83932e5ec2b7","position":{"commit_sha":"fa2d7518048277f97a41e8c1646a30359216af86","position":"1786582740167871001-dbd3ee19-d80e-4273-af05-83932e5ec2b7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785800303802040001,"creation_channel":"cli","deps":[{"link_uuid":"b165dedc-2d3c-42c4-a729-f96d5aed19ef","relation":"depends_on","target_id":"3388-96e8-e14e-4221"}],"description":"# Comment sync (append-only) with persistent Jira-comment-ID map + rich rendering\n\n## Context / Problem\nComment sync identifies comments by **body equality** (normalized-text key in\n`outbound_comments._diff_comments`), so same-text comments collide and an edited body\nlooks new. Semantics are settled as **append-only**: mirror comment *creation* both\nways, never sync edits or deletes.\n\nThis story ALSO **owns the DC comment-diff dedup-key migration `3388` deferred here**:\n`3388` moves `WikiTextCodec.normalize_outbound` from identity to the rendering form for\ndescriptions but leaves the comment-diff path on the identity normalizer (a32a\n`_resolve_codec` seam, default `_IdentityCodec`), so that cutover does not shift the\ncomment dedup key. Flipping the comment path to the real codec, and keeping comment-diff\nconvergent when it renders rich, is this story's job.\n\n## Approach\n**1. Identity = local comment key + returned Jira ID, not body.** Local key = the\nCOMMENT event's **HLC `timestamp`** (unique, monotonic; already on the compiled entry,\n`reducer/_processors.py:349`, with `author`). Persist a\n**`local_comment_key (HLC) → Jira comment ID`** map in binding state: outbound, an\nunmapped key is created in Jira and its returned ID recorded; inbound, mirror Jira\ncomments whose IDs are not map values (entries carry `jira_comment_id`, bug 85a1,\n`_processors.py:354-356`). **Append-only**: no rebar edit/delete pushed to Jira, no Jira\nedit/delete applied to rebar; a mapped key/ID is never re-synced. The map is\nchange-gated, one fixed-shape entry per comment (epic `0303`).\n\n**1a. Capture the returned ID at both enactment sites**, which discard it today. It is\nonly on `SupportsComments.add_comment`'s returned `{\"id\": …}` dict\n(`_backend.py:491`; Cloud `adapters/jira/backend.py:265`, DC\n`adapters/jira_datacenter/backend.py:433`). So (i) the local key rides ON the mutation\nentry as `\"local_comment_key\": <HLC>`; (ii) `binding_store` reaches both loops:\n`create_one` has it; `handle_update` passes `ctx.binding_store`\n(`BatchApplyContext.binding_store`) into a new optional `binding_store` param on\n`update_one` → `_update_one_dispatch_comments` (BATCH path, `applier._apply_batch`);\n`_apply_outbound_update` is threaded from `_apply_typed` for parity. Failures stay\nnon-fatal (`comment_errors` unchanged). **Crash-durability**: `record_comment_id`\n`save()`s immediately on the successful `add_comment` return (write-ahead, per\n`binding_store.py:6-28` / `record_pending_key … save()`), closing the DIG-5301 class.\n\n**1b. Two identity stores, one authoritative per DIRECTION, never consulted across\ndirections.** `jira_comment_id` (bug 85a1) is authoritative for INBOUND-origin comments,\nthe map for OUTBOUND-origin. **Outbound**: skip when EITHER the HLC key is mapped OR the\ncomment carries a `jira_comment_id` (inbound-origin, never pushed back); the\nnormalized-body test (`outbound_comments.py:143`) is DEMOTED, not removed, to a\nsecondary skip against a lost map write. ID identity is the PRIMARY outbound guard; the\n`RECONCILER_MARKER` exclusion (`:72/177-184`) stands.\n**Inbound**: `_diff_comments_inbound` (`inbound_differ.py:280`) is UNCHANGED and never\nreceives the map; its loop-breakers stand — `RECONCILER_MARKER` bodies\n(`outbound_comments.py:178`; `inbound_differ.py:337`) and ids matching a local\n`jira_comment_id` (`:299,319-321`).\n\n**2. Render bodies through the codec; migrate the dedup key.** Outbound bodies render\nthrough the `RichTextCodec.to_wire` seam descriptions use\n(`adapters/jira_family/rich_text.py`: `AdfCodec.to_wire` Cloud, the now-rendering\n`WikiTextCodec.to_wire` DC after `3388`; Cloud `markdown_to_adf` / `adf_to_markdown` /\n`fit_markdown_to_adf_limit` already exist in `adapters/jira/adf.py` from `e59d`). The Cloud\ncomment path lacks an encode step: descriptions serialize ADF at `acli.py:205`\n(`json.dumps(_text_to_adf(...))`), but `acli_cli_ops.add_comment` sends `--body <str>`\nunencoded — add `--body json.dumps(to_wire(body))` (DC's str `to_wire` unchanged). Then\n**flip the a32a codec injection** (`_diff_comments`'s `_resolve_codec` argument) from\n`_IdentityCodec` to the real `RichTextCodec` so the local key matches the wire.\n\nDepends on `e59d`/`271c`/`3388` shipping first.\n\n## Scope\nEngine paths under `src/rebar/_engine/rebar_reconciler/`:\n- `binding_store.py` — map + `record_comment_id(...)` write-ahead writer.\n- `outbound_comments.py` — skip logic above; `_map_comments_for_create` (`:148`) and the\n  `_diff_comments` append (`:147`) add `\"local_comment_key\"`; `to_wire` render in\n  `_map_comments_for_create`/`_decorate_outbound_comment`; flip `_resolve_codec`.\n- `outbound_differ.py` — `compute_outbound_mutations` threads `binding_store` +\n  `RichTextCodec` into `_diff_comments` (`:741-743`); `:624` unchanged.\n- `dispatch_one.py` — `:418` records the id (`binding_store` at `:154`); `update_one`\n  (`:448`) gains the optional param.\n- `dispatch_apply_phases.py` `:165` → `_update_one_dispatch_comments` (`:147`).\n- `apply_handlers.py` `handle_update` (`:201`) passes `ctx.binding_store` (`:81`);\n  `apply_outbound.py` `_apply_outbound_update` (def `:126`, call `:159`) forwards it\n  from `_apply_typed` (`applier.py:447`).\n- `adapters/jira/acli_cli_ops.py` `add_comment` (`:469`) — Cloud body encode.\n- `reducer/_processors.py` — HLC key (`:349`); `jira_comment_id` (`:354-356`) unchanged.\n- `inbound_differ._diff_comments_inbound` (`:280`) — **UNCHANGED, not in the edit set**.\n\n## Acceptance Criteria\n- [ ] Identity is the persistent COMMENT-HLC → Jira-comment-ID map, not the\n  normalized-body key; verified by `test_comment_duplicate_bodies_distinct_ids` (two\n  identical-text comments → two IDs).\n- [ ] The returned `add_comment` `{\"id\": …}` is captured at both enactment sites and\n  persisted against the originating local key: the entry carries `local_comment_key`;\n  `binding_store` reaches both loops (`create_one`; threaded via `update_one` and\n  callers `handle_update` / `_apply_outbound_update` into\n  `_update_one_dispatch_comments`); `record_comment_id` writes `local_key → id` on Cloud\n  (acli) and DC; verified by `test_comment_id_captured_and_persisted`.\n- [ ] Inbound-origin `jira_comment_id` (bug 85a1) and the outbound map are each\n  authoritative for their own direction and never compete: the inbound differ is\n  unchanged, consulting ONLY `RECONCILER_MARKER` / `jira_comment_id`; the outbound\n  differ skips when EITHER the key is mapped OR a `jira_comment_id` is present; verified\n  by `test_comment_bidirectional_identity_no_double_sync`.\n- [ ] Comment sync is append-only both directions — new comments mirror once,\n  edits/deletes are not synced; verified by `test_comment_append_only`.\n- [ ] Outbound bodies render through `RichTextCodec.to_wire`, with the Cloud comment ADF\n  encode on the real create surface (`--body json.dumps(to_wire(body))`) and the\n  `_diff_comments` a32a injection\n  migrated from `_IdentityCodec` to the real codec so the dedup key matches the landed\n  wire; verified by `test_comment_rendered_through_codec` and\n  `test_comment_dedup_key_uses_real_codec`.\n- [ ] After the migration, DC comment-diff converges with zero duplicate re-post\n  (counterpart to `3388`'s `test_dc_comment_diff_unchanged_by_cutover`); verified by\n  `test_dc_comment_diff_converges_after_migration`.\n- [ ] A repeat reconcile pass creates no duplicate comments; verified by\n  `test_comment_sync_idempotent`.\n- [ ] Crash-durability: `record_comment_id` `save()`s immediately on the successful\n  `add_comment` return and the demoted body-equality test stays a secondary skip, so a\n  lost map write does not re-post; verified by\n  `test_comment_crash_between_add_and_map_save_no_duplicate`.\n- [ ] The comment-ID map is change-gated and adds no per-pass churn; verified by the\n  git-delta cost harness on a no-new-comment pass.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_store.py","reason":"persistent comment-ID map local_comment_key->jira_id + record_comment_id writer that save()s immediately on successful add_comment (write-ahead, change-gated, append-only)"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_comments.py","reason":"outbound differ: ID map + inbound-origin jira_comment_id PRIMARY identity; body-equality (:143) RETAINED as belt-and-suspenders secondary skip; add local_comment_key to entries; render via RichTextCodec.to_wire; flip _diff_comments a32a codec injection to real codec; preserve RECONCILER_MARKER"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"sole caller of comment builders: thread binding_store (map) + resolved RichTextCodec into _diff_comments (:741-743); _map_comments_for_create (:624) needs no new caller arg"},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_one.py","reason":"create_one (:147) create path (:418) capture add_comment {id} + record_comment_id (binding_store threaded :154); update_one (:448) gains optional binding_store param forwarded to _update_one_dispatch_comments"},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_apply_phases.py","reason":"update path (:165): capture/record returned id in _update_one_dispatch_comments (:147) via threaded binding_store"},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"handle_update (:201) passes ctx.binding_store into update_one (production outbound-update batch path)"},{"path":"src/rebar/_engine/rebar_reconciler/apply_outbound.py","reason":"_apply_outbound_update (:126/:159) gains optional binding_store param forwarded from _apply_typed and passed to update_one (typed-leaf parity)"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","reason":"add Cloud comment-body ADF encode step in add_comment (:469): --body json.dumps(to_wire(body)) mirroring acli.py:205"},{"path":"src/rebar/reducer/_processors.py","reason":"surface COMMENT event HLC as stable local comment key; leave existing inbound jira_comment_id field as-is"},{"path":"tests/","reason":"comment identity, id-capture data-path, append-only, Cloud/DC rendering, bidirectional-identity, crash-durability, and dedup-key-migration convergence tests"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","3388-96e8-e14e-4221"],["parent","708d-0767-1a51-4928"]],"no_file_impact_reason":"","parent_id":"708d-0767-1a51-4928","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"open","tags":["rich-text"],"ticket_id":"789c-1251-fc21-4cf6","ticket_type":"story","title":"Comment sync (append-only) with persistent Jira-comment-ID map","verify_commands":[]},"source_event_uuids":["48a90ae3-3fbc-4d5b-b71c-a3133f3baa9d","7baf6dc4-2e7b-419e-854a-9bcdd455b74e","b165dedc-2d3c-42c4-a729-f96d5aed19ef","7a5608dc-f26c-4100-9321-315485fd3891","2bd92a3a-ae53-4902-821a-d7bcbc8b055a","3cb51b10-2c2c-48dd-a967-45a8490ac6b3","434c2e1c-ab13-4c9b-8226-213f528beaa0","b6f94f68-c938-43f0-89bc-3526cba548f5","a4391374-1a47-4a5b-a917-c44dbb2b5cad","ed4c32ba-a915-448b-bab8-b0cdf0965a68","2a3b0db1-af87-4518-815d-2dcf541ce6f3","08e13b2b-033e-4927-9fe3-ab3735c45be6","72cfe695-0a19-45ae-88ba-ac236dbbf8ef","aac3dd3c-76a2-405d-9f80-c6a05b3191b0","cb42e058-9be1-4d68-872d-cd585a21ef50","dbd3ee19-d80e-4273-af05-83932e5ec2b7"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659622968580001,"uuid":"ded6670c-5b97-4e05-9efb-9d880069f83b"}