src/rebar/_engine/rebar_reconciler/outbound_differ.py","dep e2d81f15677d61cb1178063735aacc3c4e3fc6c3bcfc4c79e1ee373fe386fddb src/rebar/reducer/_processors.py","dep absent tests/"],"material_fingerprint":"25b31efa54424e7f","merged_log_commit":"1a0985fe0d38b62b14dcad0af6b41f134767c840","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1785826342200683000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"1199b52f36da8fd4a561e77d67d9715b1bf3a05cb45ac536588fd1909143379b","event_uuid":"48a90ae3-3fbc-4d5b-b71c-a3133f3baa9d","position":{"commit_sha":"b744f5d4b72ad6e40688e50989afcea272f2eaec","position":"1785800303802040001-48a90ae3-3fbc-4d5b-b71c-a3133f3baa9d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"018b05d920e903ac0fa9fed7b057284c9950cab686b7fe797a245e2f2bc5a2f6","event_uuid":"7baf6dc4-2e7b-419e-854a-9bcdd455b74e","position":{"commit_sha":"4da80283021ddb27eae2d858549544248aa371d3","position":"1785800375812118001-7baf6dc4-2e7b-419e-854a-9bcdd455b74e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c17ccf2ec343cbab7f259acf94cd902e0ae051b2c827f02146bdf2224f9f6422","event_uuid":"b165dedc-2d3c-42c4-a729-f96d5aed19ef","position":{"commit_sha":"71a7af38fd9a2e92b0c656b36836bccd8241d90a","position":"1785800429639853001-b165dedc-2d3c-42c4-a729-f96d5aed19ef"},"signature":"{\"pa