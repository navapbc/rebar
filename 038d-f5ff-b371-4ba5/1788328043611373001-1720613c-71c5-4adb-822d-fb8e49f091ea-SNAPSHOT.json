a6a9-c455a1e152d7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2111b49827b2c85666a89605142ee7e980acb460297df242c6ad0c40d6fbe402","event_uuid":"a329adfb-bbd4-407f-9138-b5dff14ec8b0","position":{"commit_sha":"4b715c4aecdac7242e6f54964a3513b5eb8abedf","position":"1788325258421554001-a329adfb-bbd4-407f-9138-b5dff14ec8b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6c408817fbf06ca1f6b6698b1effa5b9dc0b1204a2e10ac6d9b83180b94ae533","event_uuid":"25f76d58-8528-4572-96d7-afcb09a1fc2f","position":{"commit_sha":"8cf78b5143cb6006d0c0ad327e92832c29cf3842","position":"1788325702047984001-25f76d58-8528-4572-96d7-afcb09a1fc2f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788314245426145001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n\n`src/rebar/_deprecations.py:75-91` currently marks eight environment/config aliases as `_permanent(...)` ergonomic renames: `REBAR_NO_SYNC`, `COMPACT_THRESHOLD`, `SCRATCH_BASE_DIR`, `REBAR_ACLI_TIMEOUT`, `RECONCILER_ABSENT_GET_BUDGET`, `REBAR_ID_GUARD_MODE`, `REBAR_VERIFY_OVERLAP_ENABLED`, and `verify.overlap_enabled`.\n\nThe Janitor approval record explicitly authorizes removal of every configuration alias. This ticket therefore intentionally reverses that prior permanent-alias classification as a pre-1.0 breaking change; it is not a claim that the existing scheduled-removal policy already applies. Because `REBAR_NO_SYNC` changes pull semantics and `REBAR_ID_GUARD_MODE` controls an unsafe bypass, silent fallback is unsafe.\n\n## Approach\n\nFirst record an ADR that supersedes permanent treatment for these eight aliases, cites the Janitor approval, names every canonical replacement, and chooses fail-loud migration rather than continued alias support. Replace each `_permanent` row with an `_tomb` entry at `error` behavior and a canonical replacement message; tombstones are deliberate removed-input detection, not a supported alias. Remove the matching active resolution/warning paths from `_config_sources.py`; remove `verify.overlap_enabled` from `_config_sections._ALIASES` (also surfaced through `_config_schema`) in the same change. Migrate every functional test consumer to canonical spelling, including `REBAR_NO_SYNC` consumers in `test_store_concurrency.py`, `test_next_batch_compute.py`, and `test_bridge_preview_under_sync_contention_heldout.py`, and `REBAR_ID_GUARD_MODE` consumers in `test_conflict_resolver_no_rebar_id_writes.py` and `test_rebar_id_label_writers.py`. Preserve canonical typed behavior and transformed semantics.\n\n## Scope\n\n- `docs/adr/` — new ADR recording the operator-approved permanent-to-removed reclassification and tombstone rationale.\n- `src/rebar/_deprecations.py` — replace eight permanent alias declarations with error tombstones and canonical migration messages.\n- `src/rebar/_config_sources.py` — delete active legacy env parsing/conversion/warning entries.\n- `src/rebar/_config_sections.py` and its `_config_schema` consumer — remove `verify.overlap_enabled` alias enrollment.\n- `tests/unit/test_config_surface_golden.py`, config tests, and the five named functional test consumers — migrate to canonical inputs and test tombstone failure.\n- `docs/env-vars.md`, `docs/config.md`, `docs/config-reference.md`, `docs/bash-migration.md`, `docs/concurrency.md`, `docs/api-stability.md`, source docstrings, `CHANGELOG.md`, and release notes — replace live guidance with canonical names; retain only clearly dated historical records.\n\n## Testing\n\nFor each of the eight removed spellings, prove config loading fails loudly with its canonical replacement in the error message; prove the canonical spelling parses to the same typed result. Cover the transformed `REBAR_NO_SYNC` inverse-pull and `REBAR_ID_GUARD_MODE=warn` unsafe-bypass boundaries through canonical fields. Run a complete-population search for all eight tokens and classify every residual occurrence as exactly one of: a tombstone row/error test, the new ADR, or a clearly dated historical record; any live parser, warning, example, documentation, or functional-test consumer is a failure.\n\n## Acceptance Criteria\n\n- [ ] A new ADR records the explicit Janitor approval, the permanent-to-removed reclassification, all eight canonical replacements, and the fail-loud tombstone rationale.\n- [ ] Each old env/config spelling is removed from active parsing and warning paths and is represented only by an `error` tombstone with a canonical migration message.\n- [ ] `verify.overlap_enabled` is absent from both the deprecation registry and `_config_sections._ALIASES`/`_config_schema` enrollment.\n- [ ] Every functional test consumer of the eight old spellings uses the canonical input instead.\n- [ ] Tests prove each tombstone fails loudly and each canonical replacement retains its prior typed behavior, including the two transformed-value boundaries.\n- [ ] The complete-population search finds no unclassified live alias reference; documentation and examples use only canonical spellings.\n- [ ] Changelog/release documentation names every removal and canonical replacement.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_deprecations.py","reason":"remove all eight alias declarations"},{"path":"src/rebar/_config_sources.py","reason":"remove legacy environment parsing/conversion"},{"path":"src/rebar/_config_sections.py","reason":"retain canonical typed config fields only"},{"path":"docs/env-vars.md","reason":"remove aliases from generated environment reference"},{"path":"docs/config.md","reason":"document canonical replacements"},{"path":"CHANGELOG.md","reason":"record breaking config removals"},{"path":"tests/unit/test_config_surface_golden.py","reason":"prove canonical enrollment after alias removal"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","78f2-b104-e3c9-4b86"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["janitor","config","breaking-change","compatibility"],"ticket_id":"038d-f5ff-b371-4ba5","ticket_type":"story","title":"Remove all approved environment and configuration aliases","verify_commands":[]},"source_event_uuids":["fce5c7fc-db6e-4f4b-9356-10d76ef873e4","bb25e8b0-60e8-466c-a6a9-c455a1e152d7","a329adfb-bbd4-407f-9138-b5dff14ec8b0","25f76d58-8528-4572-96d7-afcb09a1fc2f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328043611373001,"uuid":"1720613c-71c5-4adb-822d-fb8e49f091ea"}