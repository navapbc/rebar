hip.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fb480ee96ad79ac12c60f2936a983a815be2a88767aab6bdfab405876f09cafc","event_uuid":"4ee0c760-911f-45c2-ba04-1a3101443833","position":{"commit_sha":"5848befd239530afdb495e0c4ac289f8fa0af3ef","position":"1788065150306588001-4ee0c760-911f-45c2-ba04-1a3101443833"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e52a3e4e458b12ae1dc8357e6faa78847bb67764c27179cb621df7bf33033f9c","event_uuid":"e88b3ea8-82ec-4851-b2d4-1fc8eb48658e","position":{"commit_sha":"28f9a6c6f8d7fece0ca67dfbbe4e0ad818c0eea5","position":"1788065447142885575-e88b3ea8-82ec-4851-b2d4-1fc8eb48658e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-251_agent","claim_remote_session":null,"claimed_session":"89fa88e3-0f2a-4b9e-a9c7-44d4eda91a08","comments":[],"created_at":1788029178453660801,"creation_channel":"mcp","deps":[{"link_uuid":"64bac862-902f-4b39-822b-0b8d08bda248","relation":"depends_on","target_id":"860f-8886-a17b-48f1"},{"link_uuid":"2d5d7c78-6a9d-4bd6-8e88-6d830057ebe1","relation":"relates_to","target_id":"99ce-5c4c-fa54-4243"},{"link_uuid":"8e589f94-621f-4566-9f42-263d62d4410d","relation":"relates_to","target_id":"9fe4-5d4f-30a1-4ffa"}],"description":"## Context / Problem\n\nNothing in rebar tracks eval spend in dollars. `usage_log.record()` (`src/rebar/llm/usage_log.py`) writes per-call token rows to `.rebar/usage.jsonl` only inside a gate session, `usage_report._price_row` can price rows via the optional `genai-prices` extra, the `rebar metrics` gate-economics lens counts calls not dollars, and there is no aggregate cap anywhere. This epic must stay under $200 on Bedrock, so the cap has to be enforced by the harness, not remembered by people.\n\n## Approach\n\nBuild `src/rebar/llm/evals/plan_replay/ledger.py`:\n\n- A committed ledger `docs/experiments/plan-review-gate/replay/ledger.jsonl`: one row per eval run (`run_id, tier, candidate, sample_n, started, finished, per-pass model ids, input/output/cache tokens, usd, price_table_version`) plus per-call rows in a git-ignored detail file. `cap_usd` and `reserve_usd` are constants in the module (200 / 30), read from ONE place (`LEDGER_CAP_USD` / `LEDGER_RESERVE_USD` module constants).\n- **Pre-flight estimate (fixed, historically-measured — NOT derived from stored corpus token counts, which the corpus does not record)**: `PER_SAMPLE_ESTIMATE_USD = {\"tier1\": 0.5, \"tier2\": 3.4}` — flat per-sample dollar estimates lifted directly from the epic's own measured cost analysis (median full review $4.82 uncached; Tier-1/verifier-agentic ~$0.53; Tier-2/finders ~$3.44 per the epic's own comment breakdown), NOT a live token-count-based prediction (the replay corpus stores reconstructed material and verification data, no per-row token counts, and eval runs are multi-call agentic loops whose output-token cost is not knowable pre-run in any case — a flat measured-historical estimate is the correct instrument here, not a fictional token-count lookup). `estimate(tier, sample_n) = PER_SAMPLE_ESTIMATE_USD[tier] * sample_n`. `ledger.reserve(estimate)` refuses (raises, with a clear message naming the remaining allocation) when `spent + estimate > cap_usd - reserve_usd`.\n- **Pricing failure is LOUD, never silent-$0**: when finalizing a run's actual spend, `ledger.py` calls `genai_prices.calc_price` (via the existing `usage_report`-style adapter) for each pinned Bedrock model id; if pricing cannot resolve a model id (the documented `LookupError`-then-`None` \"unpriced\" path, bug 2ca9), `ledger.py` RAISES rather than recording `usd=0` for that run — a silently-zero-priced run would always pass the cap check and defeat the refusal guarantee. The pre-flight `estimate()` above never calls `genai-prices` at all (it's a fixed constant), so this loud-failure requirement applies only to the finalization/actual-spend path, not pre-flight.\n- **Single-writer assumption (explicit non-goal, not silently assumed)**: `reserve()` is a plain read-then-compare-then-append against the JSONL ledger file, NOT safe against two concurrent eval runs racing between the pre-flight check and finalization. This epic's tiers are run serially by a single operator (no concurrent eval launches are described anywhere in this epic), so this is an accepted, explicitly-documented simplification — not a bug to silently ship. A future concurrent-eval-runner ticket would need a real reservation/lock; out of scope here.\n- **Metering**: every eval run opens a usage-log session with `REBAR_USAGE_LOG` pointed at a per-run file; on completion the rows are priced (loud-fail per above) and the ledger row finalised with actual spend; a run that dies mid-way is finalised from whatever rows exist on the next `ledger.reconcile()` call.\n- `ledger.print_summary()` returns spent/remaining/per-tier totals as a string. This ticket does NOT add a `python -m rebar.llm.evals.plan_replay` CLI entry point — `__main__.py` is built by the Tier-0 ticket (`bouncy-peacockish-titmouse`), which wires `ledger.print_summary()` (and other subcommands) into the module's dispatch; that wiring is that ticket's scope, not this one's.\n\n`genai-prices` Bedrock ids are the price source for the finalization path; the ledger records the price-table version so later re-pricing is possible.\n\n**Out of scope, tracked at the epic level, not here**: this ticket ships the mechanism only. \"Every Tier-1/Tier-2 run appears in the ledger\" and \"the epic's total spend never exceeds $200\" are outcomes over runs that don't exist yet (Tier-1/Tier-2 harnesses are later epic children) — they belong to the EPIC's own completion criteria, checked once those tiers actually run, not to this ticket's AC list.\n\n## Scope\n\n- `src/rebar/llm/evals/plan_replay/ledger.py` (new)\n- `docs/experiments/plan-review-gate/replay/ledger.jsonl` (new, committed, empty/near-empty until real eval runs happen)\n- `pyproject.toml` (the `pricing` extra becomes a dependency of the eval package's entry point)\n- `tests/unit/evals/test_plan_replay_ledger.py` (new)\n\n## Testing\n\nUnit: `reserve()` succeeds under the cap and refuses (raises, remaining amount in the message) over it; a finalised run's `usd` equals priced tokens for a resolvable model id; finalizing with an UNRESOLVABLE model id raises rather than recording `usd=0`; a crashed run (partial per-call rows, no finalized ledger row) is reconciled from partial rows via `reconcile()`; the cap and reserve are read from the single `LEDGER_CAP_USD`/`LEDGER_RESERVE_USD` constants. No live calls needed — `genai_prices.calc_price` is exercised against its real pricing table (offline, no network) the same way existing `usage_report` tests do.\n\n## Acceptance Criteria\n\n- [x] `reserve()` refuses (raises, naming the remaining allocation) an estimate that would exceed cap minus reserve. Evidence: `tests/unit/evals/test_plan_replay_ledger.py::test_reserve_refuses_over_cap_naming_remaining_amount`, `::test_reserve_reads_spent_from_existing_ledger_rows`, `::test_reserve_derives_cap_math_from_module_constants` (an artificially-low-cap dry-run via monkeypatched constants).\n- [x] Finalizing a run with a model id `genai-prices` cannot resolve raises rather than silently recording zero spend. Evidence: `::test_finalize_raises_on_unresolvable_model_never_records_zero` (asserts the ledger file is untouched on failure).\n- [x] `ledger.print_summary()` reports spent/remaining and a per-tier breakdown. Evidence: `::test_print_summary_reports_spent_and_remaining`, `::test_print_summary_breaks_down_by_tier`.\n- [x] `reconcile()` finalizes a crashed run from partial rows, and is idempotent when a run is already finalized. Evidence: `::test_reconcile_finalizes_a_crashed_run_from_partial_rows`, `::test_reconcile_is_idempotent_when_run_already_finalized`.\n- [x] Unit tests pass in `make test`. Evidence: `tests/unit/evals/test_plan_replay_ledger.py` 13/13 passed (4 happy-path implemented against by a held-out-TDD subagent, unmodified afterward against 9 held-out edge/E2E tests it never saw). Merged to main at commit b9dd6e3ab058 (Gerrit change 2406, `Verified+1`, `LLM-Review+1`).\n- [x] No LLM calls. Evidence: all tests use a stubbed/monkeypatched `genai_prices` module; CI ran the suite with no provider credentials configured.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/evals/plan_replay/ledger.py","reason":"budget ledger + pre-flight"},{"path":"docs/experiments/plan-review-gate/replay/ledger.jsonl","reason":"committed ledger"},{"path":"pyproject.toml","reason":"pricing extra for the eval entry point"},{"path":"tests/unit/evals/test_plan_replay_ledger.py","reason":"unit tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","860f-8886-a17b-48f1"],["parent","759e-7dc1-675c-4877"],["relates_to","99ce-5c4c-fa54-4243"],["relates_to","9fe4-5d4f-30a1-4ffa"]],"no_file_impact_reason":"","parent_id":"759e-7dc1-675c-4877","parent_status_uuid":"b1df3e67-3b21-4115-9072-b07af18771f4","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["plan-review","evals","budget","bedrock"],"ticket_id":"4c80-edd3-20f1-4dff","ticket_type":"story","title":"Eval budget ledger: price every eval call, pre-flight estimates, refuse runs that would exceed the $200 cap","verify_commands":[]},"source_event_uuids":["b4e3e247-ead0-483b-8c8e-1a649c7c644f","9ce87f47-a142-4c02-8cd3-48573ada39fa","73ff293d-9156-425a-af8e-a3d7f547258e","b1df3e67-3b21-4115-9072-b07af18771f4","3be3fcdd-0b78-4ecb-853d-98fff9d87e6c","2d5d7c78-6a9d-4bd6-8e88-6d830057ebe1","8e589f94-621f-4566-9f42-263d62d4410d","a510c73b-ffda-4e03-8d1b-b512d1f84e99","aec23336-7653-49e9-9a38-b9f4a9085492","002a65f5-8aae-4e34-8b09-f9e12b8a62cf","4ee0c760-911f-45c2-ba04-1a3101443833","e88b3ea8-82ec-4851-b2d4-1fc8eb48658e"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788065447142885576,"uuid":"b74d9295-8b46-4762-acd3-d0b1f246d743"}