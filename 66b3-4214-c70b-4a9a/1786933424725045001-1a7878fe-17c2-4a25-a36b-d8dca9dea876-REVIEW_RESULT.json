ct formula (`iteration_limit = 2 x B` because `req_limit = ceil(eff_max_iter/2)`) to size successor request budgets, and is used by completion_recovery.py:318 and completion_banking.py:334.","group_criteria":null,"group_id":null,"id":"f03e26ab64fca8d99","impact":1.0,"is_primary":null,"location":"Plan 'Cross-directory consumers of req_limit' paragraph; verified against src/rebar/llm/workflow/completion_banking.py:279-286, src/rebar/llm/workflow/completion_recovery.py:318","norm_id":"n13859b9fd2997053","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A completion-recovery successor granted budget B now receives base(B) + output-retry allowance model requests once the output allowance is folded into the operation-wide request_limit, so iteration_limit_for's `2 x B` inversion no longer yields the intended request ceiling.","The promised census test asserts 'no other consumer reads the bare formula' but iteration_limit_for reads it as documented arithmetic, so the test may pass while this consumer's assumption silently drifts."],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibi