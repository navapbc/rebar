mations.py\":[[1,45],[86,92],[155,171],[210,234],[273,296],[327,337]],\"src/rebar/_engine/rebar_reconciler/peer_state.py\":[[1,28],[50,56],[67,74],[87,112],[151,160],[166,184],[198,211],[217,225],[234,244],[255,262],[127,137]],\"src/rebar/_engine/rebar_reconciler/persist_phase.py\":[[2,23],[58,75],[96,108],[192,200],[114,118],[126,131],[141,147],[149,156],[178,182],[221,237],[245,249],[282,284]],\"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py\":[[2,20],[53,59],[124,181],[202,209],[220,228],[248,254],[262,267],[280,296],[316,332],[365,376],[111,114]],\"src/rebar/_engine/rebar_reconciler/reconcile.py\":[[37,43],[71,78],[148,178],[251,257],[262,269],[54,63],[128,132],[206,220]],\"src/rebar/_engine/rebar_reconciler/run_differs.py\":[[2,36],[78,85],[95,100],[135,140],[168,176],[184,193],[233,254],[66,73],[255,258],[294,300],[303,306],[309,315],[355,365],[379,385],[398,416],[465,476],[515,524],[557,563],[606,611]],\"src/rebar/_engine/rebar_reconciler/runtime.py\":[[1,30],[55,61],[121,127],[187,193],[236,243],[253,262],[311,319],[344,360],[404,415],[168,172],[176,179],[222,225]],\"src/rebar/_engine/rebar_reconciler/snapshot_lagfree_refresh.py\":[[2,40],[68,78],[100,108],[50,53]]}\nPFX = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in DOCS[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                visit(child, f\"{prefix}.{child.name}\" if prefix else child.name)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    out = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type == tokenize.COMMENT:\n            body = tok.string[1:].lstrip().lower()\n            if tok.string.startswith(\"#!\") or any(body.startswith(p) for p in PFX):\n                out.append(lines[tok.start[0] - 1])\n    return out\nfor path in DOCS:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\ndiff = subprocess.check_output([\"git\", \"diff\", \"--unified=0\", B, \"--\", *SPANS], text=True)\ncurrent = None\nfor line in diff.splitlines():\n    if line.startswith(\"+++ b/\"):\n        current = line[6:]\n    match = re.match(r\"^@@ -(\\d+)(?:,(\\d+))? \\+\\d+(?:,\\d+)? @@\", line)\n    if match:\n        start = int(match.group(1))\n        count = int(match.group(2) or \"1\")\n        allowed = SPANS[current]\n        if count:\n            assert all(any(lo <= n <= hi for lo, hi in allowed) for n in range(start, start + count)), (\"hunk outside allowlist\", current, start, count)\n        else:\n            assert any(lo <= start <= hi or lo <= start + 1 <= hi for lo, hi in allowed), (\"insertion outside allowlist\", current, start)\n'","dd_id":"immutable-prose-only","dd_text":"Only exact allowlisted prose changes: immutable-base runtime/non-comment structure and protected directives remain exact, and zero-context hunks stay inside base spans."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess\nexpected = set([\"src/rebar/_engine/rebar_reconciler/mutation_payloads.py\",\"src/rebar/_engine/rebar_reconciler/outbound_comments.py\",\"src/rebar/_engine/rebar_reconciler/outbound_differ.py\",\"src/rebar/_engine/rebar_reconciler/outbound_effective_maps.py\",\"src/rebar/_engine/rebar_reconciler/outbound_field_diff.py\",\"src/rebar/_engine/rebar_reconciler/outbound_links.py\",\"src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py\",\"src/rebar/_engine/rebar_reconciler/outbound_pass.py\",\"src/rebar/_engine/rebar_reconciler/pass_support.py\",\"src/rebar/_engine/rebar_reconciler/peer_confirmations.py\",\"src/rebar/_engine/rebar_reconciler/peer_state.py\",\"src/rebar/_engine/rebar_reconciler/persist_phase.py\",\"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py\",\"src/rebar/_engine/rebar_reconciler/reconcile.py\",\"src/rebar/_engine/rebar_reconciler/run_differs.py\",\"src/rebar/_engine/rebar_reconciler/runtime.py\",\"src/rebar/_engine/rebar_reconciler/snapshot_lagfree_refresh.py\"])\nactual = set(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\"], text=True).splitlines())\nassert actual == expected, {\"expected\": sorted(expected), \"actual\": sorted(actual)}\n'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/unit/rebar_reconciler","dd_id":"focused-contracts","dd_text":"Focused tests and build checks for every preserved subsystem consumer pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_engine/rebar_reconciler/mutation_payloads.py src/rebar/_engine/rebar_reconciler/outbound_comments.py src/rebar/_engine/rebar_reconciler/outbound_differ.py src/rebar/_engine/rebar_reconciler/outbound_effective_maps.py src/rebar/_engine/rebar_reconciler/outbound_field_diff.py src/rebar/_engine/rebar_reconciler/outbound_links.py src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py src/rebar/_engine/rebar_reconciler/outbound_pass.py src/rebar/_engine/rebar_reconciler/pass_support.py src/rebar/_engine/rebar_reconciler/peer_confirmations.py src/rebar/_engine/rebar_reconciler/peer_state.py src/rebar/_engine/rebar_reconciler/persist_phase.py src/rebar/_engine/rebar_reconciler/reconcile_helpers.py src/rebar/_engine/rebar_reconciler/reconcile.py src/rebar/_engine/rebar_reconciler/run_differs.py src/rebar/_engine/rebar_reconciler/runtime.py src/rebar/_engine/rebar_reconciler/snapshot_lagfree_refresh.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"VERIFY_COMMANDS","timestamp":1788627230391189438,"uuid":"7b916c1e-3b6c-4e33-8838-b489f91fe786"}