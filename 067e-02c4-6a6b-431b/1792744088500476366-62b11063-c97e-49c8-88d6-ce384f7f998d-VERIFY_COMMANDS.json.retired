{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, pathlib, subprocess, sys\nB=\"7840899ea7ac0609bf3e0dec5e26effdbda1ec6c\"\ndef norm(source):\n t=ast.parse(source,type_comments=True)\n for n in ast.walk(t):\n  if isinstance(n,(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)) and n.body:\n   first=n.body[0]\n   if isinstance(first,ast.Expr) and isinstance(first.value,ast.Constant) and isinstance(first.value.value,str):\n    first.value.value=\"\"\n for n in t.type_ignores: n.lineno=0\n return ast.dump(t,include_attributes=False)\nfor p in sys.argv[1:]:\n old=subprocess.check_output([\"git\",\"show\",f\"{B}:{p}\"],text=True)\n assert norm(old)==norm(pathlib.Path(p).read_text()),p\nprint(\"runtime AST unchanged\",len(sys.argv)-1)' 'src/rebar/reconciler/mutation_payloads.py' 'src/rebar/reconciler/outbound_comments.py' 'src/rebar/reconciler/outbound_differ.py' 'src/rebar/reconciler/outbound_effective_maps.py' 'src/rebar/reconciler/outbound_field_diff.py' 'src/rebar/reconciler/outbound_links.py' 'src/rebar/reconciler/outbound_mutation_builders.py' 'src/rebar/reconciler/outbound_pass.py' 'src/rebar/reconciler/pass_support.py' 'src/rebar/reconciler/peer_confirmations.py' 'src/rebar/reconciler/peer_state.py' 'src/rebar/reconciler/persist_phase.py' 'src/rebar/reconciler/reconcile_helpers.py' 'src/rebar/reconciler/reconcile.py' 'src/rebar/reconciler/run_differs.py' 'src/rebar/reconciler/runtime.py' 'src/rebar/reconciler/snapshot_lagfree_refresh.py'","dd_id":"immutable-prose-only","dd_text":"Runtime AST matches the current edit base after removing docstrings; the leaf-linked prose receipts and zero-context diff review enforce the allowlist."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess,sys\nB=\"7840899ea7ac0609bf3e0dec5e26effdbda1ec6c\"\nwant=set(sys.argv[1:])\ngot=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",B,\"HEAD\",\"--\",*want],text=True).splitlines())\nassert got==want,(sorted(want-got),sorted(got-want))\nprint(\"owned paths changed\",len(got))' 'src/rebar/reconciler/mutation_payloads.py' 'src/rebar/reconciler/outbound_comments.py' 'src/rebar/reconciler/outbound_differ.py' 'src/rebar/reconciler/outbound_effective_maps.py' 'src/rebar/reconciler/outbound_field_diff.py' 'src/rebar/reconciler/outbound_links.py' 'src/rebar/reconciler/outbound_mutation_builders.py' 'src/rebar/reconciler/outbound_pass.py' 'src/rebar/reconciler/pass_support.py' 'src/rebar/reconciler/peer_confirmations.py' 'src/rebar/reconciler/peer_state.py' 'src/rebar/reconciler/persist_phase.py' 'src/rebar/reconciler/reconcile_helpers.py' 'src/rebar/reconciler/reconcile.py' 'src/rebar/reconciler/run_differs.py' 'src/rebar/reconciler/runtime.py' 'src/rebar/reconciler/snapshot_lagfree_refresh.py'","dd_id":"exact-leaf-paths","dd_text":"Every declared owned path changes in the grouped commit; the sibling leaf checks its own path set."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Repository comment hygiene passes."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -m pytest -q tests/unit/reconciler","dd_id":"focused-contracts","dd_text":"Reconciler unit contracts pass against the moved source package."},{"command":"git diff --check 7840899ea7ac0609bf3e0dec5e26effdbda1ec6c HEAD -- 'src/rebar/reconciler/mutation_payloads.py' 'src/rebar/reconciler/outbound_comments.py' 'src/rebar/reconciler/outbound_differ.py' 'src/rebar/reconciler/outbound_effective_maps.py' 'src/rebar/reconciler/outbound_field_diff.py' 'src/rebar/reconciler/outbound_links.py' 'src/rebar/reconciler/outbound_mutation_bui