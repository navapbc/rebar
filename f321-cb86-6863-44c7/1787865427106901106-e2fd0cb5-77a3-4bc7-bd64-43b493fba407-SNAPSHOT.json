pplication/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e786539be97e2dac931a600c810c80c09b8100f6cb9ec60cadf5a6fd04d96a37","event_uuid":"fe0998a6-5b3b-4c1d-9b7c-56d6471a3a84","position":{"commit_sha":"403f112f90c0a3c820db89f85f42ea01f5621d33","position":"1787853767210150001-fe0998a6-5b3b-4c1d-9b7c-56d6471a3a84"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d2b6cb502fcc36d59eb55be8f45fa5cbd6df91e9f69bee7df3777130638f83b1","event_uuid":"e40878b4-2eec-4082-b23e-744a4032ed60","position":{"commit_sha":"03385ea649840f918f35ac36a448a4fe34852330","position":"1787854259306882001-e40878b4-2eec-4082-b23e-744a4032ed60"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-247_agent","claim_remote_session":null,"claimed_session":"2a634c43-3190-4ea8-af29-37e3371d4223","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented on branch `f321-skill-sandbox-rule`; pushed as Gerrit change 2270 (commit fb3c4ccf96ba). Not closing — awaiting LLM-Review +1 / Verified +1.\n\nBoth `rebar-debug` (Step 5 mutation check) and `rebar-implement` (4e give-the-tests-teeth) now carry an identical inline \"Sandbox the mutation run — the seeded defect is arbitrary code\" block: hostile-code framing citing the 2026-08-26 `rm -rf /*` outcome, the complete macOS `sandbox-exec` snippet with its self-written heredoc profile, the complete Linux `bwrap --ro-bind / / --dev /dev --proc /proc --bind \"$PWD\" \"$PWD\"` argv, the `bwrap --ro-bind / / -- /bin/true` capability probe with both observed AppArmor failure strings, and the no-sandbox injected-seam fallback (\"do not proceed unsandboxed\"). Each mutation bullet gained a one-line pointer marking it mandatory. Nothing weakened — the block closes by restating that RED-first, held-out oracle and mutation teeth are unchanged.\n\nNew `tests/scripts/test_skill_mutation_sandbox_rule.py` (15 tests, parametrized over both skills) asserts every literal group. RED proof: reverting `rebar-debug/SKILL.md` alone → 7 failed / 8 passed; reverting `rebar-implement/SKILL.md` alone → 6 failed / 9 passed; both restored → 15 passed.\n\nGates green: `make lint` 0, `make typecheck` 0 (676 files), `check_skill_frontmatter.py` 0 (4 skills valid), `check_import_walk.py` 0, and 96 passed across every full test module that reads the skills.","timestamp":1787849590572153025}],"completion_expectation":"required","created_at":1787806123557597001,"creation_channel":"cli","deps":[{"link_uuid":"3d2b6ae2-6d0c-4ac3-8b22-43772683899a","relation":"relates_to","target_id":"e668-b496-e264-4283"},{"link_uuid":"55b76efd-b011-46e9-bc02-594552bfa168","relation":"relates_to","target_id":"dfd0-88a6-d7b2-49d2"},{"link_uuid":"b67a2f5a-6607-48cc-a7d8-2ab61bae0fc8","relation":"relates_to","target_id":"8dd5-7132-ca7c-4448"},{"link_uuid":"e40878b4-2eec-4082-b23e-744a4032ed60","relation":"relates_to","target_id":"962c-892b-aaa4-47e2"}],"description":"## Summary\n\nThe 2026-08-26 `rm -rf /*` incident came from an **ad-hoc, agent-authored mutation\nscript** (`/tmp/mut.py`: `EP.write_text(orig.replace(old, new, 1))` then\n`subprocess.run([... pytest ...])`). It never touched `scripts/mutation_gate.py`.\n\n`e668-b496-e264-4283` sandboxes the CI mutation gate. That is worth having, but it\n**does not cover the path the incident took**. The path the incident took is the\ndefect-seeded mutation check that `rebar-debug` and `rebar-implement` instruct agents\nto perform as a routine part of TDD — and neither skill requires any sandbox.\n\n## Evidence\n\n- `examples/agent-skills/rebar-debug/SKILL.md:786` — *\"perturb the fix with a\n  **defect-seeded mutation** … confirm the held-out test returns to **RED**, then\n  restore the fix.\"*\n- `examples/agent-skills/rebar-implement/SKILL.md:291` — *\"perturb the implementation\n  … A test that stays green under mutation is a tautology.\"*\n- `grep -rilE \"sandbox-exec|bwrap|bubblewrap\" examples/agent-skills/` returns\n  **nothing**. No skill mentions an OS sandbox anywhere.\n\nThese skills are symlinked into `~/.claude/skills/`, so the rule ships to every\noperator who installs them.\n\n## Why an inline invocation, not a dependency on the wrapper\n\nThe rule must not wait on `e668`'s `scripts/mutation_sandbox.py` landing: the skills\nare the live instruction agents follow today, and the exposure is present on every\nrun until the rule exists. The skills therefore carry the sandbox invocation inline.\nA follow-on ticket adds a reusable CLI wrapper and can simplify the skill text later.\n\n## The invocations, in full\n\nBoth were measured today, not composed from memory.\n\n**macOS** — the profile is written by the snippet itself, so nothing external is\nreferenced. Verified on macOS 26.5.2: a write outside `$SBX` was denied\n(`Operation not permitted`, file absent), a write inside succeeded, and\n`rm -rf <protected>/*` was denied with the target surviving.\n\n```sh\nSBX=\"$(mktemp -d)\"\ncat > \"$SBX/p.sb\" <<EOF\n(version 1)\n(allow default)\n(deny file-write*)\n(allow file-write*\n  (subpath \"$PWD\")\n  (subpath \"$SBX\")\n  (literal \"/dev/null\") (literal \"/dev/stdout\") (literal \"/dev/stderr\"))\nEOF\nsandbox-exec -f \"$SBX/p.sb\" <your mutation test command>\n```\n\n**Linux** — verified in an `ubuntu:24.04` container: the write inside the bind\nsucceeded and a write outside failed with `Read-only file system`.\n\n```sh\nbwrap --ro-bind / / --dev /dev --proc /proc --bind \"$PWD\" \"$PWD\" -- <your mutation test command>\n```\n\n`bwrap` presence on PATH is NOT capability: Ubuntu 23.10+ restricts unprivileged\nuser namespaces via AppArmor, so an installed `bwrap` can fail with \"Creating new\nnamespace failed\". Confirm it works first:\n\n```sh\nbwrap --ro-bind / / -- /bin/true || echo \"bwrap cannot namespace here\"\n```\n\n## When no sandbox is available\n\nNeither mechanism present, or `bwrap` present but unable to namespace: **do not run\nthe mutation step against code that performs real filesystem deletion, and do not\nproceed unsandboxed.** Assert on an injected seam instead — point the deletion at a\nstub that records its argv and assert on what *would* have been deleted. That is a\nstrictly better oracle than observing a wiped directory, and it needs no sandbox.\n\n## Acceptance Criteria\n\n- [x] Both `rebar-debug` and `rebar-implement` require any step that perturbs code and\n      then executes tests to run inside an OS sandbox denying writes outside the\n      worktree and a scratch dir. Verified by\n      `pytest tests/scripts/test_skill_mutation_sandbox_rule.py`.\n- [x] Each skill carries the **complete, self-contained** macOS snippet above,\n      including the heredoc that writes the profile — no reference to a profile file\n      whose provenance or content is unstated. Verified by the test asserting the\n      `(deny file-write*)` and `sandbox-exec -f` literals are present in both files.\n- [x] Each skill carries the **complete** Linux `bwrap` invocation above, including\n      `--ro-bind / /`, `--dev`, `--proc` and the `--bind \"$PWD\" \"$PWD\"` pair — not an\n      abbreviated fragment. Verified by the same test.\n- [x] Each skill states that `bwrap` on PATH is not capability, and gives the\n      `bwrap --ro-bind / / -- /bin/true` capability probe. Verified by the same test.\n- [x] Each skill specifies the **no-sandbox fallback**: assert on an injected seam,\n      never proceed unsandboxed. Verified by the same test.\n- [x] Each skill states that a seeded defect is arbitrary code, so the run executes\n      hostile code — with the 2026-08-26 outcome as the reason. Verified by the test.\n- [x] A regression test fails if either skill loses the requirement. Verified by\n      removing it from one skill and observing RED.\n- [x] No existing guidance is weakened: RED-first, held-out-oracle and mutation-teeth\n      discipline unchanged; the sandbox is added around them. Verified by diff review.\n\n## Testing\n\n- `pytest tests/scripts/test_skill_mutation_sandbox_rule.py` — both skills carry the\n  requirement, both platform invocations, and the hostile-code framing; the test goes\n  RED when the rule is removed from either file.\n- `make lint` and `make typecheck` — green.\n- `python scripts/check_skill_frontmatter.py` — the skills still parse (Copilot CLI\n  silently drops a skill whose frontmatter fails).\n\n## Definition of Done\n\n- Every acceptance criterion above is checked by the command it names.\n- The regression test is proven RED by removing the rule, then restored.\n\n## Notes\n\nFiled after the operator asked whether the skills needed updating — they did, and\nthis is the gap `e668` left open. Sibling: `e668-b496-e264-4283` (CI gate sandbox).\nFollow-on: a reusable `scripts/mutation_sandbox.py` CLI wrapper, which stacks on\n`e668` and can then replace the inline invocation in the skill text.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"examples/agent-skills/rebar-debug/SKILL.md","reason":"require an OS sandbox around the defect-seeded mutation check (Step 5)"},{"path":"examples/agent-skills/rebar-implement/SKILL.md","reason":"same requirement on the give-the-tests-teeth step"},{"path":"tests/scripts/test_skill_mutation_sandbox_rule.py","reason":"NEW: regression test so the rule cannot be silently dropped from either skill"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","8dd5-7132-ca7c-4448"],["relates_to","962c-892b-aaa4-47e2"],["relates_to","dfd0-88a6-d7b2-49d2"],["relates_to","e668-b496-e264-4283"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e70a9ea5-8f29-4e6f-8bf5-54bca5a3b7cf","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"f321-cb86-6863-44c7","ticket_type":"task","title":"Require an OS sandbox for defect-seeded mutation runs in the TDD skills","verify_commands":[]},"source_event_uuids":["4a5b9c35-6036-4cee-bcc6-61887fa513d8","c106c0bf-c6a7-494e-9d84-d6be2f846d87","ad2f8a6a-2879-40e3-8fbc-1fc39757f153","a493718c-3ed1-45fb-b0bc-a571f6955049","dc8c1699-4ef0-49af-afff-7e1e60a54c5f","55b76efd-b011-46e9-bc02-594552bfa168","b67a2f5a-6607-48cc-a7d8-2ab61bae0fc8","0b0311c1-7c79-43ea-8e69-1a653c1415ee","e70a9ea5-8f29-4e6f-8bf5-54bca5a3b7cf","fe0998a6-5b3b-4c1d-9b7c-56d6471a3a84","e40878b4-2eec-4082-b23e-744a4032ed60"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787865427106901106,"uuid":"e2fd0cb5-77a3-4bc7-bd64-43b493fba407"}