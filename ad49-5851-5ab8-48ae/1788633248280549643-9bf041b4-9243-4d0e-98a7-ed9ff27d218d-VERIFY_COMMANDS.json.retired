{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, re, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nALLOWED=json.loads(\"{\\\"tests/unit/test_fixture_selection_corpus.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_corpus_enrichment_loads_real_ticket_state_for_escaped_defect\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_fixture_selection_escape_index.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_fixture_selection_heldout.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_fixture_selection.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_flaky_test_guidance.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_no_unqualified_recheck_for_a_merely_flaky_looking_failure\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_fold_orphan_laundering.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_threshold_crossing_fold_does_not_launder_orphan\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_g5_decomp_det.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_gate_admission_09da.py\\\":{\\\"docs\\\":[],\\\"comments\\\":[[\\\"test_the_refusal_returns_immediately_rather_than_waiting_for_a_holder\\\",\\\"assert elapsed < 5.0, f\\\\\\\"admission blocked for {elapsed:.2f}s instead of fast-failing\\\\\\\"\\\",1,\\\"C:test_the_refusal_returns_immediately_rather_than_waiting_for_a_holder:before:elapsed-assert\\\"]]},\\\"tests/unit/test_gate_context_seam.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_the_audited_override_warning_names_the_module_that_holds_the_code\\\",\\\"test_the_seam_headroom_bounds_are_p