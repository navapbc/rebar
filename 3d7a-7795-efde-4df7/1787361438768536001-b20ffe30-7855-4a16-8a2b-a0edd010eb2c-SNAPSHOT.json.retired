,"read-path: docs/adr/0098-operation-scoped-config-and-provider-composition.md","read-path: docs/plan-review-gate.md","read-path: docs/user-guide.md","read-path: scripts/jira_dc_capability_map.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/value_maps.py","read-path: src/rebar/_engine/rebar_reconciler/config.py","read-path: src/rebar/_engine/rebar_reconciler/dispatch_one.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_fields.py","read-path: src/rebar/_store/event_prepare.py","read-path: src/rebar/reducer/_processors.py","read-path: src/rebar/reducer/_processors_status.py","read-path: src/rebar/reducer/_version.py","read-path: tests/unit/rebar_reconciler/mutate/test_inbound_apply_bound_target.py","currency-basis: file_impact"],"material_fingerprint":"0e4dbfc43f706a44","merged_log_commit":"44053f84b5ac5868da4504ab69c00f384f4c6e25","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787326771877687000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"77002bbf9570dbe767b626d708e6e428082830cbb55e5680b47e5c92b6df6998","event_uuid":"f950e6e4-fe0a-40b8-ac26-8f55af02b1d6","position":{"commit_sha":"1064b8c7252a92f433a04e3e93a8df31b30418ce","position":"1787287199003189001-f950e6e4-fe0a-40b8-ac26-8f55af02b1d6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e9e805e703915b6961a96a79971abd4145e7a1829bdd8f50a4a0787ef194b440","event_uuid":"3b7f2339-9191-4c88-9d21-2d2c80a2a77b","position":{"commit_sha":"fdbf7f497e495db4e37c68ca699c9458445f36c3","positi