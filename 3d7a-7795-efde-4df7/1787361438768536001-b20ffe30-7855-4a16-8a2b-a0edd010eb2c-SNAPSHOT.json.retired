a":"f79b25d2dd8f6b8cd972f4dd0694184f74c755eb","position":"1787355656457285001-a47b6769-eba1-46d4-a135-2eef839562ac"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"35fabbef4c704a1206de397301041381fa1026b0588b22a026852b5511a92158","event_uuid":"f5ed89f3-4b82-4fc0-9877-2168f5355683","position":{"commit_sha":"4f39695d7b42729c6b8667e883d016091ef044d2","position":"1787355676565530001-f5ed89f3-4b82-4fc0-9877-2168f5355683"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2829cd102513edce5b029ee270676c80beea45c7eed7a8ff50d25ee1585802cd","event_uuid":"c65aac09-ba01-4019-949b-c940de17fccb","position":{"commit_sha":"196b69e2f59ff7ccaf9590f71d845fdbfa37eabc","position":"1787355697141834001-c65aac09-ba01-4019-949b-c940de17fccb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f278167195b3ea8c4ad718e50f6a67466d756eddc03566e3e50802f2ec6658b9","event_uuid":"d418b461-96d3-4ef3-9b25-62c2b2b610e8","position":{"commit_sha":"ef6bddf2567fd57710a1429af2e9c26042e57564","position":"1787355710091611001-d418b461-96d3-4ef3-9b25-62c2b2b610e8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f1f541c50749e6940fb8d3fbb3105f656a3b6af597d8d0f5a86b58500c4dfb56","event_uuid":"fa27e1c6-e8be-40f3-a984-78081cac685a","position":{"commit_sha":"5e338c4c49a865226655873633876cf88b41c6db","position":"1787355725349007001-fa27e1c6-e8be-40f3-a984-78081cac685a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787159605255412001,"creation_channel":"cli","deps":[{"link_uuid":"825018e3-f495-4394-af8f-c1403de28afb","relation":"relates_to","target_id":"82a9-f38d-2122-4abc"}],"description":"# Generic, config-driven mapping seam for per-project tracker workflow variance\n\n## Context / Problem\n\nrebar's reconciler hardcodes how its model maps onto a target Jira project's model,\nso a project whose workflow lacks an analogous concept cannot be supported without a\ncore edit — the anti-pattern this epic exists to remove (core rebar must stay\nproject-agnostic; a single project's states/types must never be named in shipped\ncode). The mappings live in\n`src/rebar/_engine/rebar_reconciler/adapters/jira_family/value_maps.py`\n(`LOCAL_STATUS_TO_JIRA`, `LOCAL_TYPE_TO_JIRA`, `LOCAL_PRIORITY_TO_JIRA`,\n`RELATION_TO_JIRA_LINK`, `UNSYNCED_RELATIONS`) and are duplicated in\n`src/rebar/_engine/rebar_reconciler/config.py` (`local_to_jira_status`,\n`jira_to_local_status`, `EXCLUDED_SYNC_TYPES`) and\n`src/rebar/_engine/rebar_reconciler/inbound_fields.py` (`_JIRA_TO_LOCAL_STATUS`,\n`_REBAR_STATUS_LABEL_TO_LOCAL`). A live probe of the REB project (Jira Cloud) confirms\nthe variance is real: REB has a `Blocked` status and an `Initiative` issue type at\n`hierarchyLevel` 2 above `Epic` at 1, and no `Supersedes` link type.\n\nThe felt need spans four target axes — **status, ticket type, permissible transitions,\nand permissible parent relationships** — plus two sibling value axes already hardcoded\n(**link relations, priority**) and the **required-create-fields** gotcha that hard-fails\n`create` when a project marks a custom field mandatory.\n\n## Approach\n\nIntroduce a **provider-neutral, config-driven mapping seam** read from hand-editable\n`rebar.toml`/`[tool.rebar]` config (rebar's config surface per `docs/config.md`), with\nthe current hardcoded maps preserved as the **built-in default** (lowest precedence).\nConfig is layered: built-in default → config `default` block → per-project overlay\n(`projects.<JIRA_KEY>`), deep-merged per key so an override changes only the keys it\nnames. The seam is factored onto rebar's existing vendor-adapter boundary\n(`docs/adr/0083-reconciler-vendor-adapter-seam.md`, amended by\n`docs/adr/0055-jira-family-sub-seam.md` — cite the filename, as a bare \"ADR 0035\" is\nambiguous across three files,\n`src/rebar/_engine/rebar_reconciler/_backend.py` `select_backend` /\n`OutboundMapper`/`InboundMapper`): a **provider-neutral core** owns the schema, the\nlayered merge, fail-closed validation, the mapping-application semantics, and a\n**capability descriptor** (which axes a target even has); a **Jira adapter** supplies\nthe built-in defaults, the live probe, and the capability values. No other provider is\nbuilt or tested here — neutrality is structural only, so a future Linear/GitLab/GitHub\nadapter reuses the core untouched.\n\nFor target concepts with no analogue, the seam offers four provider-neutral answers,\neach building on rebar primitives that already exist (the `rebar-status:` annotation\nlabels managed by `outbound_differ`, `EXCLUDED_SYNC_TYPES`, and the per-hop\n`transition_issue_by_name` call), while S6's replay algorithm itself is new code: **map**\nto a chosen value; **collapse** (non-injective, e.g. `epic→Initiative` or `epic→Task`)\nmade round-trip-safe by a `rebar-type:` annotation label symmetric with today's\n`rebar-status:` labels; **skip** (type-granular whole-ticket exclusion, extending\n`EXCLUDED_SYNC_TYPES`); or **drift** with a warning (statuses/transitions/parents that\ncannot be represented are left to diverge and recorded, never silently forced). Non-allowed\n**transitions** additionally attempt **replay**: because the reconciler today has no\nhop-recording machinery and `acli.transition_issue_by_name` makes only a single direct\nattempt, S6 adds **new** dispatcher logic that derives the intended local hop sequence from\nthe ticket's **core STATUS event log** (rebar's per-ticket sequence of status-change events,\nalready persisted by the core — the reconciler does not store its own hop history), anchors\non Jira's current status, and re-attempts each intermediate hop through that existing\nsingle-hop primitive, bounded give-up→drift before drifting. Non-representable **parents**\nadditionally leave an echo-safe **breadcrumb comment** naming the nearest represented\nancestor's Jira key. rebar's own transitions and hierarchy are never restricted by a\ntarget's rules.\n\n## Acceptance Criteria\n\n- [ ] A project whose config declares no overrides syncs **byte-for-identical** to\n  today's behavior — verified by the existing reconciler suite passing unchanged and a\n  test asserting the composed default map equals the current hardcoded constants.\n- [ ] A per-project overlay changes only the keys it names, layering over the `default`\n  block which layers over the built-in default — verified by a config-effect contrast\n  test (default vs. overlaid value produce different observable outbound mappings).\n- [ ] Every mapping axis (status, type, link relation, priority) is driven by the\n  config seam rather than a hardcoded literal, with the built-in default as fallback —\n  verified by tests that a non-default config value reaches the outbound/inbound differ.\n- [ ] A rebar type with no target analogue can be **collapsed** (round-trip-safe via a\n  `rebar-type:` label) or **skipped** (whole-ticket), and an unmapped-non-skipped type\n  **fails closed at config load** — verified per child.\n- [ ] A non-allowed **transition** is attempted by **replay** of rebar's recorded hops\n  and, failing that, **drifts** with a warning — never restricting rebar's local\n  transitions — verified per child.\n- [ ] A non-representable **parent** drifts and leaves an **echo-safe breadcrumb**\n  naming the nearest represented ancestor's Jira key (noting any skipped ancestors) —\n  verified per child.\n- [ ] Required-custom-field create failures are prevented by a per-project\n  `create_defaults` block — verified per child.\n- [ ] A `rebar bridge probe` command interrogates a live target and emits suggested\n  config for every offline-discoverable axis, flagging transitions as best-effort —\n  verified per child.\n- [ ] `rebar doctor` detects Jira-compat config problems (offline validation failures\n  and live-drift against the target) — verified per child.\n- [ ] The mapping core is **provider-neutral**: the schema, layered merge, validation,\n  application semantics, and capability descriptor contain no Jira-specific literal;\n  Jira specifics live only in the adapter — verified by a test that the core modules do\n  not import the Jira adapter and carry no Jira value literals.\n\n## Child decomposition (each criterion maps to ≥1 child; responsibilities do not overlap)\n\n- **S1 — Config schema + layered-merge core + capability descriptor** delivers the\n  provider-neutral foundation, layering, fail-closed validation framework, and the\n  neutrality guarantee.\n- **S2 — Status mapping via the seam** retires the three hardcoded status copies to the\n  seam, default-preserving.\n- **S3 — Type mapping: collapse + `rebar-type:` label + operator skip** delivers the\n  no-analogue-type answers and load-time fail-closed on undecided types.\n- **S4 — Link-relation mapping** retires\n  `RELATION_TO_JIRA_LINK`/`UNSYNCED_RELATIONS` (skip-not-approximate preserved).\n- **S5 — Priority mapping + `create_defaults` injection** retires\n  `LOCAL_PRIORITY_TO_JIRA` to the seam (map-or-drift soft field) and injects\n  per-project create_defaults to prevent required-custom-field create failures.\n- **S6 — Transition replay** adds a **new** direct→replay→drift fallback to the dispatcher,\n  deriving the hop sequence from the core per-ticket STATUS event log and re-attempting\n  each hop via the existing single-hop `transition_issue_by_name` primitive.\n- **S7 — Parent breadcrumb comment** adds the echo-safe nearest-represented-ancestor\n  breadcrumb on parent drift.\n- **S8 — `rebar bridge probe` command** interrogates a live target and emits suggested\n  config.\n- **S9 — Docs + `project.portability`** documents the seam and its portability guard.\n- **S10 — Jira-compat config diagnostics in `doctor`** detects offline-invalid config\n  and live-drift.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","82a9-f38d-2122-4abc"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"cd4dbce3-2808-4acd-8303-e555690cbaf0","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["reconciler","config","portability","status-mapping","future-work","mapping-seam","provider-neutral"],"ticket_id":"3d7a-7795-efde-4df7","ticket_type":"epic","title":"Generic, config-driven mapping seam for per-project tracker workflow variance (Jira first)","verify_commands":[]},"source_event_uuids":["f950e6e4-fe0a-40b8-ac26-8f55af02b1d6","3b7f2339-9191-4c88-9d21-2d2c80a2a77b","28a86a89-9017-4064-a02f-41b6608fb4b7","825018e3-f495-4394-af8f-c1403de28afb","297f79c6-8bd7-4e02-b394-4e0d21988e34","379f7c67-ea81-4522-8a3f-20fdbc2ac26c","cd4dbce3-2808-4acd-8303-e555690cbaf0","0e230fec-2693-4c26-9e14-f4e880b3e911","a47b6769-eba1-46d4-a135-2eef839562ac","f5ed89f3-4b82-4fc0-9877-2168f5355683","c65aac09-ba01-4019-949b-c940de17fccb","d418b461-96d3-4ef3-9b25-62c2b2b610e8","fa27e1c6-e8be-40f3-a984-78081cac685a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787361438768536001,"uuid":"b20ffe30-7855-4a16-8a2b-a0edd010eb2c"}