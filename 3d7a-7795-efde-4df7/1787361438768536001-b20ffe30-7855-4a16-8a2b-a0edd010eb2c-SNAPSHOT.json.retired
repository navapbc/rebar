{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787361438768536001,"compiled_state":{"alias":"ravenous-dirt-widgeon","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"1cb68ec230b1e50c10e3fdc0fdfebdaa9078fb66","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3d7a-7795-efde-4df7","material: 0e4dbfc43f706a44","material-part: children 781e2e84ad538f78 10","material-part: description f99ed46f772761ca 7942","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: ticket_id 4e45631078550132 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 5","review-phase: planning","rebar-version: 0.12.0 (1cb68ec230)","regver: 362a5dd2d2052826","verified-at-sha:44053f84b5ac5868da4504ab69c00f384f4c6e25","plan-material-pin: child 14f4-d616-70df-466d 0b75397b62e9e935","plan-material-pin: child 1515-bebc-0d91-476b 42e8b71284241d08","plan-material-pin: child 2c66-205d-92e1-4419 0e12857d17ae1344","plan-material-pin: child 438a-e1d9-29d3-4081 7ddb620fb8cb66af","plan-material-pin: child 52b0-6a6a-c66b-4c59 b5bdf82b81ad5ebd","plan-material-pin: child a881-2d9a-16bf-4acb 9453ca90604436e9","plan-material-pin: child a8ea-be28-2394-4f0c ca609e987b4e391f","plan-material-pin: child ad81-73ad-83bb-47c7 34c88a792ec25df6","plan-material-pin: child bfe7-0900-c3d1-4141 f9bd8d363d103808","plan-material-pin: child d458-bb1e-cc63-42a6 42062693b2234e93","dep 3890ab8c46a5d037fb82824602d243401082db412cb0f87b705ec7145c65b6a9 docs/README.md","dep 945bd7e701a788b937263cf9bf7e6e5