{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787548194738706001,"compiled_state":{"alias":"agrologic-oval-bobolink","assignee":null,"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"d5e2d877a24405a83de907eb9d1aac2a933c87a2a6f9334b893e771e59c20085","event_uuid":"dab54a35-5353-4758-ac5f-c7cfab67a309","position":{"commit_sha":"dcd4f60d01d2ab8f1f6ec3918d497204edfa1928","position":"1787520024014044001-dab54a35-5353-4758-ac5f-c7cfab67a309"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"13f280747baa4778e642d18341646dc63ac8b805d6059c595f1b62bcf11ab9bb","event_uuid":"69158018-945a-4940-a3c9-9ac4f34808ec","position":{"commit_sha":"8d97e6b401a7145670c3d0077ffdedf537925ab0","position":"1787520089123841001-69158018-945a-4940-a3c9-9ac4f34808ec"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c34d1cdf37c3f0542d38bd42eec2f64c2e31ebcb94d1a458f63eface3cb0d4bc","event_uuid":"80819c30-3abf-47e6-9080-24c35d7b4a51","position":{"commit_sha":"c569107b7ff78a0a642121bff067d3c48b7c594e","position":"1787520128487686001-80819c30-3abf-47e6-9080-24c35d7b4a51"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2628af402b3d36402372adb37af0bce9e6d394b250cedbfcd86512659e2dd1bd","event_uuid":"9d310900-e916-4243-9122-668e40c901cf","position":{"commit_sha":"806e4c80b089d486be6e532d3e884faaabcd4c18","position":"1787520155979238001-9d310900-e916-4243-9122-668e40c901cf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9760ace414cd82b1fe800275fafdfe53d8e080bdbc952d8539de273fd249eb11","event_uuid":"ea98791d-50ef-45da-afa4-d58b436f8915","position":{"commit_sha":"30e4ddeb5e68a900b59f8830cbf56c75fe4649e7","position":"1787520186193592001-ea98791d-50ef-45da-afa4-d58b436f8915"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b2aee2b0c9c2e6400819ea41b6c27401c1c42d6f02db6917014a2df0644dbaa4","event_uuid":"9b5f0283-28cd-44da-82b1-46ec5f7a4ccf","position":{"commit_sha":"0386c320ddf9f0c5c4318fa279e9b6da266d15ce","position":"1787520202647293001-9b5f0283-28cd-44da-82b1-46ec5f7a4ccf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4fcbda5ff1d8e1b39a142152afb755199c6ac0b842ea7ae9b3e5d7eae8e25c76","event_uuid":"91b01c4a-bbc0-4ce8-ad6d-6c087625c3f1","position":{"commit_sha":"4bd8b0d0a2fe6b98b67109f00916e1000d32714c","position":"1787520221177679001-91b01c4a-bbc0-4ce8-ad6d-6c087625c3f1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0d22536a514166e12e95840b8e93c5ef357e021281120c12b74ffaac82b1a550","event_uuid":"9dca9894-d21b-45e4-8bd0-a75d49bde961","position":{"commit_sha":"80527f1998ebb6cee94d50785243aa9e5bfc2317","position":"1787520249142944001-9dca9894-d21b-45e4-8bd0-a75d49bde961"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bb458ff06b8cb1509275aee789fa8f5fcf8565b0e9e3c49d6275758df0618e0a","event_uuid":"21016a11-2480-4048-bfad-d2a8e72972b3","position":{"commit_sha":"630b93ecc09e2d6a9f6e6242302fa4983535055b","position":"1787528528665943001-21016a11-2480-4048-bfad-d2a8e72972b3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6c8d934075f9236fdaa2d876f84d4eda13899fce47ae8a4e785b08f6ce6ac1f5","event_uuid":"627b978d-a55e-4ab8-b501-e2c12f0ccbb5","position":{"commit_sha":"312a0d786c66a66266dbf5b37f7565106cd000de","position":"1787528807207846001-627b978d-a55e-4ab8-b501-e2c12f0ccbb5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1e7b2a1a5cd14f33c8f6c751899e65f3bccf4b749ef9409d078c7067d412bce8","event_uuid":"6cf47982-5da1-49a9-b699-8c66afe9d621","position":{"commit_sha":"2952fcdac4c4ffb32d91e8b5fa86acd97d6b477f","position":"1787530176287733001-6cf47982-5da1-49a9-b699-8c66afe9d621"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"38c3bb70b446d6b149d32e96983bbfe5cb28f8f277787d90e43fa86ee8ebc41e","event_uuid":"09ba8db7-7dd9-4369-92e4-bd3da6085b28","position":{"commit_sha":"699695cdf55fe4050a1ff2796da5e5606e288c47","position":"1787531504315943001-09ba8db7-7dd9-4369-92e4-bd3da6085b28"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"767f20d018010df5302d1918bfb80e9321aaeeb7100f6a01538dd7f8ea57ce26","event_uuid":"a95ecaed-feb3-42e8-8802-b19183460653","position":{"commit_sha":"9235ad2a976b15c79fdb530cfa5f5bfb767308df","position":"1787534661014095001-a95ecaed-feb3-42e8-8802-b19183460653"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8aac284e8edfe67c8b10253a53ef60fca51d86ecb1fa27495e5a321875ef65b8","event_uuid":"5f2b65c5-33cc-4d57-9689-a330659d76a8","position":{"commit_sha":"79e1a7492f1c7c3b20a4dd1fa7dec0b175c4afa7","position":"1787536270720611001-5f2b65c5-33cc-4d57-9689-a330659d76a8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"58be07b78833341c5d273b3b7c0e8bfbddf43c601a5735fc5c0b4a735457c515","event_uuid":"e1489731-5f0c-4168-aba1-643c0f9689c3","position":{"commit_sha":"9f396ac5909b019cf17dd71fa1f977c9b8b7c5d5","position":"1787538896559601001-e1489731-5f0c-4168-aba1-643c0f9689c3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c8e91fdd37a04f8eba724e29fbea62465b86786b44cac5765041284e55521a89","event_uuid":"f5ec8179-ddb4-408b-8d32-bc19aac9aec4","position":{"commit_sha":"abb8019e8745ca449dd77aa431c3c1056709088a","position":"1787542622065464001-f5ec8179-ddb4-408b-8d32-bc19aac9aec4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Additional production occurrence\n\nAt `origin/main` commit `ae4030bd4a920762e27971f59a7aafdc4fcc0026`, `rebar review-plan immolated-holohedral-waterdogs` failed before model execution while other sessions were using the shared tracker.\n\n### Exact stderr\n\n```text\nError: git fetch from 'origin' failed (attested mode fails closed): error: cannot lock ref 'refs/remotes/origin/tickets': is at 85e049ab2715b3fd5aeac586658ac859a44b7224 but expected 65efa1967a9b0c54ee7c2182c1593954f3896ab2\n```\n\nA serialized `git fetch origin` followed by the same review command completed with a signed PASS. This result matches the parallel and serialized distinction established by this bug. No duplicate bug was created.","timestamp":1787528528665943001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"F31 reproduced the confirmed common-directory fetch race during plan review. The attested fetch failed closed with cannot lock ref refs/remotes/origin/tickets. It was at 0233b7fd28d0f5e9c55e76680324b983e69a4f25 but expected 0a0a219a2942c6412b02ca39c23da65d1c875d5b. A serialized git fetch origin then completed without error, and the next review completed with a signed PASS. The occurrence came from worktree docs-f31-event-schema at code base ae4030bd4a920762e27971f59a7aafdc4fcc0026.","timestamp":1787528807207846001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Additional production occurrence\n\nDuring parallel F17, F18, F29, and F31 documentation work at code base `ae4030bd4a920762e27971f59a7aafdc4fcc0026`, `rebar comment prosaic-radon-sardine` committed the F29 GREEN evidence locally but terminal push recovery failed. The remote rejected `HEAD -> tickets` because another session had advanced the ref. Rebar reported 17 unpushed local ticket commits and stated that the backlog grew. The command exited zero after adding the local comment, so the write was durable in the shared tracker clone but was not shared through `origin/tickets` as the concurrency contract requires.\n\nF31 recorded the matching stale-reference failure and a successful serialized control on this bug. The existing controlled proof also produced parallel failures and zero serialized failures. This occurrence therefore belongs to the confirmed common-directory coordination defect. No duplicate bug was created.","timestamp":1787530176287733001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Signed close publication failure\n\nThe F18 close command for `immolated-holohedral-waterdogs` returned exit 0 with a signed transition from `in_progress` to `closed` at commit `7fee4acbfa570b834b2bc917ce5febbc3e1b7862`. During the same command, tracker publication failed three times after automatic recovery because `origin/tickets` advanced. The reported local backlog grew from 45 commits to 57 commits and then to 70 commits.\n\nEach failure was a non-fast-forward rejection for `HEAD -> tickets`. The command stated that the events were committed locally and would publish on the next successful push. A serialized `git fetch origin` completed before this occurrence was appended. This occurrence shows that the transient ref race can affect a signed close after the gate passes, even when the command reports success.","timestamp":1787531504315943001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## F38 completion-verifier reproduction\n\nCompletion verification for childless-rhyolite-puma failed during its attested source fetch. The local origin/tickets ref was at 60ebd68cb09f4047ad5971247fbfe22dabc3e946 when the fetch expected a92a94108c58f9e81f7c374d0fcd0a76b964e17f. The verifier failed closed and exited without a completion verdict. This is another instance of the transient ref-update race tracked by this bug. The affected operation used merged code revision 781733f6d82e734c64e6b1550cd523e3a5637ee4.","timestamp":1787534661014095001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## F30A plan review occurrence\n\n`rebar review-plan herby-crude-rat` failed before model execution at code revision `e48142648445e6f947e46183a99097bfdbc45366` while concurrent sessions were using the shared tracker. Git reported `cannot lock ref refs/remotes/origin/tickets`. The ref was at `5af5cd45e715aaea8498224b75eb9c8118d73bcf` while the fetch expected `4d700f875bf1303bf6642fe0612d6d0013b77a00`.\n\n## Rebar-debug orientation\n\n- Step 0(a). An all-status symptom search and the open bug list identify this ticket as the existing report. No duplicate was created.\n- Step 0(b). The occurrence was reported against `e48142648445e6f947e46183a99097bfdbc45366`.\n- Step 0(c). A fresh debug worktree at `e48142648445e6f947e46183a99097bfdbc45366` matched `origin/main`.\n\n## Disposition\n\nThe current and expected ref pattern matches the dynamic mechanism and controlled parallel versus serialized proof already recorded on this ticket. This occurrence adds production evidence from F30A. It does not identify a different cause. The documentation epic will continue without treating a retry as a fix.","timestamp":1787536270720611001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Additional local gate occurrence while validating epidemic-chocolaty-imago at code revision e48142648445e6f947e46183a99097bfdbc45366. The documented macOS CI-equivalent default suite completed 16406 passed / 55 skipped but xdist killed two workers at the 300-second per-test limit while running test_code_review_gate_session.py::test_local_session_review_creates_reuses_artifact_with_session_and_deps and ::test_pass1_finder_receives_no_prior_findings. A serial reproduction of the same nodes also timed out; the thread dump proved the first node was blocked at rebar._snapshot.git_fetch.interprocess_lock -> fcntl.flock(LOCK_EX) from resolve_gate_handle/acquire/resolve_ref/fetch_origin, before the test behavior ran. After the external lock holder cleared (lsof reported no holder and no pytest/review process remained), the exact nodes passed independently in 9.69s and 5.26s. This parallel/blocked versus cleared/serialized control matches this bug’s confirmed cross-process fetch-lock mechanism. No duplicate bug or footprint-scope workaround was created.","timestamp":1787538896559601001}],"created_at":1787520024014044001,"creation_channel":"cli","deps":[{"link_uuid":"69158018-945a-4940-a3c9-9ac4f34808ec","relation":"discovered_from","target_id":"b8bf-a5aa-2f4d-44d4"},{"link_uuid":"80819c30-3abf-47e6-9080-24c35d7b4a51","relation":"relates_to","target_id":"9305-b42c-3262-4c58"},{"link_uuid":"9d310900-e916-4243-9122-668e40c901cf","relation":"relates_to","target_id":"5e40-0fe4-a966-425e"},{"link_uuid":"ea98791d-50ef-45da-afa4-d58b436f8915","relation":"relates_to","target_id":"3435-c833-4a43-42ae"},{"link_uuid":"9b5f0283-28cd-44da-82b1-46ec5f7a4ccf","relation":"relates_to","target_id":"d6e3-548c-37eb-4c45"},{"link_uuid":"91b01c4a-bbc0-4ce8-ad6d-6c087625c3f1","relation":"relates_to","target_id":"54b2-9e46-b4ba-486e"},{"link_uuid":"9dca9894-d21b-45e4-8bd0-a75d49bde961","relation":"relates_to","target_id":"5546-65da-f42a-4cce"},{"link_uuid":"f5ec8179-ddb4-408b-8d32-bc19aac9aec4","relation":"relates_to","target_id":"363c-618c-16b0-4c97"}],"description":"## Context\n\nParallel rebar operations can run Git fetches against one Git common directory without common coordination. Three concurrent plan reviews failed before verdict with `cannot lock ref refs/remotes/origin/tickets` and the comparison `is at <new> but expected <old>`. The failure is present on `origin/main` commit `3d41015574baa18a6ee6a25c7271be87fde1a3a5`. The authoritative concurrency contract in `docs/concurrency.md` lines 3 through 12 states that rebar is operated concurrently across interfaces and that every invariant gates every change.\n\n## Duplicate sweep\n\nSearches for the exact failure and for concurrent fetch coordination found no open or in-progress bug with this scope. `chordal-quasilegal-pipit` records the same failure during four concurrent reviews, but its accepted scope addressed plan-review verdict convergence. `icicled-unstable-urial` handles local Git contention on routed write calls. `honest-repulsive-blackfish` consolidates Git failure classification while preserving each caller action. `eclectic-spotted-barb` fixes an unlocked enrichment prune. None fixes this fetch race.\n\n## Confirmed mechanism\n\n`rebar._store.sync.reconverge` runs a forced-refspec fetch in `src/rebar/_store/sync.py` lines 281 through 295 before taking the store write lock at line 304. The snapshot fetch path serializes through a separate lock in the snapshot store. The store Git advisory lock introduced by `icicled-unstable-urial` covers routed index-mutating calls and explicitly leaves sync and push fetch legs outside its domain in `src/rebar/_store/gitutil.py` lines 300 through 307. Neither fetch path retries the stale-reference comparison failure.\n\nGit fetch updates remote-tracking refs with compare-and-swap semantics. When two uncoordinated fetches update the same ref, one process can observe the ref after its peer changed it and fail with `is at <new> but expected <old>`. The snapshot path raises `SnapshotFetchError`, which aborts an attested operation. The sync path treats the fetch as a failed best-effort call and skips that freshness round.\n\n## Proof\n\n- A controlled experiment drove the production `sync._git` seam against fresh local repositories. Parallel execution produced 82 exact stale-reference comparison failures in 128 attempts. Serialized execution produced zero failures in 128 attempts.\n- A second controlled experiment drove production snapshot fetches and production sync fetches against the same Git common directory. Nine of twelve snapshot fetches aborted with the exact comparison failure. Sync recorded 113 exact failures in 132 calls. The serialized control produced zero failures. This experiment proves that operation-specific locks do not coordinate paths that share refs. It does not assume that the standard code checkout and tracker clone share one object database.\n- Fresh local repositories removed network behavior, credentials, missing objects, and ticket-store state as alternative explanations.\n- Linked code worktrees share one Git common directory. Concurrent sessions also share the symlinked `.tickets-tracker` clone. Multiple operations can therefore update the same remote-tracking ref within either domain.\n\n## Historical boundaries\n\nCommit `c5d79b58b6e829b336684c46cfc482c17c111c7a` introduced tracker reconvergence with fetch deliberately outside the write lock. It predates the commit-trailer convention and has no recoverable ticket. Commit `57114212cf0112c43e571ded7cf8e16bc2a0e425` later ported that policy into `rebar._store` under `chilly-hyena-jet`. Commit `2a3abe6abde9` added the explicit destination refspec under `scorpioid-important-thylacine`. That refspec is required for narrow clones and must not be removed as a workaround.\n\n`icicled-unstable-urial` records the operator decision that transient local Git contention should recover automatically and that only exhausted bounded recovery should surface an actionable error. Its accepted implementation was narrower than ref-updating fetches. `honest-repulsive-blackfish` provides shared failure vocabulary, but its acceptance criteria preserved existing caller actions and did not add fetch recovery. No attempted and reverted fix for this mechanism was found.\n\n## Remediation constraints\n\n- Coordinate rebar fetches by canonical Git common-directory identity, or apply bounded retry that safely re-reads state after the exact stale-reference comparison failure. The design may combine both mechanisms.\n- Do not hold the ticket write lock across network I/O. Preserve the existing requirement that a slow fetch cannot block local ticket writers.\n- Preserve the explicit tickets refspec required by `scorpioid-important-thylacine`.\n- Preserve the context-specific Git outcomes established by `honest-repulsive-blackfish`. A local ref race, a remote policy rejection, and a ref CAS mismatch remain different outcomes.\n- Treat non-rebar Git processes as possible peers. An advisory lock alone cannot provide recovery when another Git client does not take it.\n\n## Acceptance criteria\n\n- [ ] Parallel tracker synchronization calls against one Git common directory complete without exposing or silently discarding the stale-reference comparison failure.\n- [ ] An attested snapshot fetch racing with another ref-updating fetch against the same Git common directory completes through bounded recovery or returns one actionable exhausted-recovery error.\n- [ ] Coordination identity follows symlinks and linked worktrees to the canonical Git common directory.\n- [ ] Network fetches do not hold the ticket write lock, and a blocked remote does not block local ticket writes.\n- [ ] The explicit tickets destination refspec remains in place and narrow-clone synchronization tests remain green.\n- [ ] Deterministic tests use local repositories, observe the failure before the fix, and exercise parallel and serialized controls at both affected entry points.\n- [ ] Current concurrency documentation names the ref-fetch coordination and recovery policy.\n- [ ] Focused tests, `make lint`, `make typecheck`, and the project test gate pass.\n\n## Attribution\n\nThe first introducing commit is `c5d79b58b6e829b336684c46cfc482c17c111c7a`. Searches by full SHA, exact policy text, `WS3`, and `REMEDIATION_PROPOSAL.md` found no originating ticket. The later Tier D story is a carrier. The explicit-refspec ticket is a required correctness fix rather than the origin. Attribution is therefore recorded as pre-ticket and no `caused_by` edge is asserted.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[["relates_to","3435-c833-4a43-42ae"],["relates_to","363c-618c-16b0-4c97"],["relates_to","54b2-9e46-b4ba-486e"],["relates_to","5546-65da-f42a-4cce"],["relates_to","5e40-0fe4-a966-425e"],["relates_to","9305-b42c-3262-4c58"],["relates_to","d6e3-548c-37eb-4c45"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["tracker","concurrency","git"],"ticket_id":"ccd2-528c-b4a9-4b90","ticket_type":"bug","title":"Concurrent ref-updating fetches are not coordinated by Git common directory","verify_commands":[]},"source_event_uuids":["dab54a35-5353-4758-ac5f-c7cfab67a309","69158018-945a-4940-a3c9-9ac4f34808ec","80819c30-3abf-47e6-9080-24c35d7b4a51","9d310900-e916-4243-9122-668e40c901cf","ea98791d-50ef-45da-afa4-d58b436f8915","9b5f0283-28cd-44da-82b1-46ec5f7a4ccf","91b01c4a-bbc0-4ce8-ad6d-6c087625c3f1","9dca9894-d21b-45e4-8bd0-a75d49bde961","21016a11-2480-4048-bfad-d2a8e72972b3","627b978d-a55e-4ab8-b501-e2c12f0ccbb5","6cf47982-5da1-49a9-b699-8c66afe9d621","09ba8db7-7dd9-4369-92e4-bd3da6085b28","a95ecaed-feb3-42e8-8802-b19183460653","5f2b65c5-33cc-4d57-9689-a330659d76a8","e1489731-5f0c-4168-aba1-643c0f9689c3","f5ec8179-ddb4-408b-8d32-bc19aac9aec4"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787548194738706001,"uuid":"1d5ce330-cb16-44ce-8b57-7a66fe354f74"}