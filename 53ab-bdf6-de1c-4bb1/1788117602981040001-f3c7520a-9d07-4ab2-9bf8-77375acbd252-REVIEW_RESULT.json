gin":-0.95,"drop_reason":null,"evidence":["`__main__.py`'s `tier1` subparser is added but only `docs/experiments/plan-review-gate/replay/tier1-current-ddc8fb442281.md` (an experiment output) and `ledger.jsonl` are listed as committed docs","The report is a commissioning run result, not a how-to-run / design doc for the new harness pattern"],"finding":"The plan introduces a new `tier1` CLI subcommand and a new eval concept (VerifierCandidate / tier1 replay harness) but commits only a generated experiment report; no usage/design doc or AGENTS.md/ADR update for the new subcommand and its invocation contract is mentioned.","group_criteria":null,"group_id":null,"id":"f7ab2ea807a7b5fe5","impact":0.0,"is_primary":null,"location":"Scope / Acceptance Criteria (docs artifacts)","norm_id":"ncf9552bd040099fe","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["A future maintainer wants to run tier1 for a new VerifierCandidate but has no doc describing the subparser flags, the sampling/stratification contract, or the ledger tier semantics"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["prerequisite-consistency"],"decision":"dropped","decision_margin":-0.4075,"drop_reason":null,"evidence":["Subject: `ledger.estimate(tier, sample_n)` returns `PER_SAMPLE_ESTIMATE_USD[tier] * sample_n`","Prerequisite: `PER_SAMPLE_ESTIMATE_USD = {\"tier1\": 0.5, \"tier2\": 3.4}`","Subject ledger.jsonl row omits input/output/cache token fields and price_table_version that the prerequisite ledger row schema requires (`input/output/cache tokens, usd, price_table_version`)"],"finding":"The subject plan's per-sample cost estimate for tier1 is inconsistent with the prerequisite's fixed historically-measured estimate. The ledger prerequisite defines `PER_SAMPLE_ESTIMATE_USD = {\"tier1\": 0.5, ...}`, so `estimate(\"tier1\", 60)` = 0.5 * 60 = $30.00, which would collide with the reserve floor. The subject's actual recorded spend is $6.72 for N=60 (~$0.112/sample), and the subject describes `ledger.estimate(tier, sample_n)` returning `PER_SAMPLE_ESTIMATE_USD[tier] * sample_n` — matching the formula but with a per-sample figure that, at the prerequisite's fixed 0.5, would reserve $30 for a run that actually costs $6.72, and would exceed the $30 reserve threshold (cap 200 - reserve 30 = 170 available; $30 is under that, so the run would proceed — this part is consistent).","group_criteria":null,"group_id":null,"id":"f37638fb80f164730","impact":0.44,"is_primary":null,"location":"Ledger — flat per-sample, not token-derived; Acceptance Criteria (ledger.jsonl row)","norm_id":"n8106205df4bc7909","priority":0.1925,"reason":"low-validity","recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"","tier":"LLM","validity":0.4375,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies