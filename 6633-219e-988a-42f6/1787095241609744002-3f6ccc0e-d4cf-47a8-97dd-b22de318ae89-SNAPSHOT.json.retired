_reconciler/request.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"src/rebar/_engine/rebar_reconciler/run_differs.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"src/rebar/_engine_support/bridge_fsck_visibility.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"src/rebar/_engine_support/gates.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"src/rebar/_engine_support/lookups.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"src/rebar/_engine_support/reads.py","reason":"Cut below-seam config/credential read to the approved seam."},{"path":"scripts/config_ownership_exceptions.py","reason":"Remove C3a LEGACY_EXCEPTIONS entries as reads are cut to seam."},{"path":"tests/scripts/test_reconciler_engine_seam_clean_heldout.py","reason":"Held-out proof: gate clean + zero legacy entries for these files."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","075b-1479-dcb7-40ab"]],"no_file_impact_reason":"","parent_id":"075b-1479-dcb7-40ab","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"6633-219e-988a-42f6","ticket_type":"task","title":"RP-04 S7.3.a — reconciler-engine cutover: route below-seam config reads through seams","verify_commands":[]},"source_event_uuids":["d525ecef-2525-4c3d-8103-409d641b9482","2e376995-dce8-47ca-9ef6-ab41147eb017","390d0b60-405f-4b4d-840b-3b15120b65e4"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787095241609744002,"uuid":"3f6ccc0e-d4cf-47a8-97dd-b22de318ae89"}