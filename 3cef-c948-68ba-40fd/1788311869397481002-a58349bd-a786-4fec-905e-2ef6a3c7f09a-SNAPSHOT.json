{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788311869397481002,"compiled_state":{"alias":"preodorous-temporary-piglet","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"5ff99170b5d0cf97f2f639f117f4b9337622ba33","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3cef-c948-68ba-40fd","material: 196298cb29733122","material-part: children 647ea2107ca5072f 0","material-part: description 41cbbb1f0dbbb5b3 6285","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 535edd57ea23e131 14","material-part: ticket_id e186a45879a05d25 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 6","review-phase: planning","rebar-version: 0.13.1 (5ff99170b5d0)","regver: aa61189569d34126","verified-at-sha:024a6a2278134128be0c76c8d7c60e41b4ba817d","dep ab7cf62f867336a0613362bb4856d9381d5b32b0614cae3d8605c026231f1512 docs/adr/0069-retryable-coverage-gap-bounded-deferral.md","dep 98a9483e21c1b95af36ead52b62a412a650e66da5b5edb62f57b4f2aa9191dda docs/adr/0077-code-review-voter-four-pass-rewire.md","dep f5d35b9d0278d581e51d2178cea7a413e938f578881e75e653cb756fc3a2a86a docs/review-policy.md","dep 3dd0242119415c78b6e480580bca1905ce28b3bb38862d863f447757b8a3ecd8 infra/scripts/autodeploy.sh","dep 954754834b6055f30bcc184534470c7083623f447623b126e4bcca260b563990 src/rebar/_guides/passing-code-review.md","dep 28ff59f853b497952dd5f7a7540a582f0a756cb8f0daabb06e73d8229d85bce6 src/rebar/_snapshot/janitor.py","dep cd23998a3cde75b7cf86517cf6cdc4f0da93a46c74b8584378866fdc2ada4f13 src/rebar/_snapshot/repo_snapshot.py","dep f547