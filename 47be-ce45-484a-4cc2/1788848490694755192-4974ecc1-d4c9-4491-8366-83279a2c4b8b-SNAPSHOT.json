79a098b921"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788570440889517032,"creation_channel":"mcp","deps":[{"link_uuid":"c8677556-9f1b-495b-9c90-de7461030256","relation":"supersedes","target_id":"9f16-feca-aa07-4eff"},{"link_uuid":"8864ff87-8878-474f-a660-74f9b3ed8608","relation":"supersedes","target_id":"cb96-702c-c69b-46dd"},{"link_uuid":"6b1f5191-357b-405f-aad0-679deb25bb55","relation":"supersedes","target_id":"f36e-034f-4dc6-4051"},{"link_uuid":"ef7a181e-9fc8-4884-94a0-306611019f8a","relation":"supersedes","target_id":"a13f-91b8-cc9f-4932"},{"link_uuid":"040befde-bf06-434b-9e65-1fd49e0fe9bc","relation":"supersedes","target_id":"1238-dd52-ea7d-453f"},{"link_uuid":"bde084dd-7958-451b-bdeb-1d31486e143e","relation":"relates_to","target_id":"59a7-cb88-f2f9-4148"},{"link_uuid":"7c5190b8-f4fc-4551-97bf-5579a098b921","relation":"relates_to","target_id":"1932-0f4e-0855-4e66"}],"description":"## Context / Problem\nFive mixed infrastructure files contain repeated, stale, or misleading comments identified by the audit and revalidated on current `origin/main`. User-facing shell help remains complete; the remediation targets only redundant internal explanation.\n\n## Approach\nEdit only standalone comments and blank lines in the declared files. Preserve Terraform, shell, and systemd behavior byte-for-byte. Leave user-facing help complete and correct.\n\n## Scope\n- `infra/bootstrap/main.tf` — Preserve local-state, one-time creation of remote-state prerequisites, `prevent_destroy`, and the requirement to migrate main Terraform state before removing the guard or destroying the bucket.\n- `infra/github/apply-mirror-lock.sh` — Preserve complete user-facing flags/defaults/authentication/destructive effects; main-and-tag locks, sole deploy-key bypass, preconditions, optional legacy removal, and recovery pointer.\n- `infra/github/rollback-mirror-lock.sh` — Preserve complete user-facing help and actual default behavior: delete both lock rulesets and recreate main protection; `--disable` is the non-deleting mode. Preserve snapshot dependency and explicit feature restoration.\n- `infra/systemd/rebar-autodeploy.service` — Preserve timer cadence, storm guard, environment overrides, health endpoint, fail-safe nonzero behavior, and `TimeoutStartSec=90` below the two-minute timer period so a hung clone cannot prevent rearming.\n- `infra/terraform-github/main.tf` — Preserve main-only lock, deploy-key bypass, no repository resource, bypass-key precondition, imported ownership, and intentional divergence from the shell fallback, which also locks tags. Out-of-scope stale parity prose is tracked by `wolfish-monarchist-maiasaura`.\n\nConsumers are Terraform/GitHub operators, shell users, and systemd.\n\n## Acceptance Criteria\n- [ ] The leaf commit changes only standalone comments or blank lines in the five declared files; user-facing help remains complete and accurate.\n- [ ] Every Scope constraint and consumer contract has a PASS row with concrete before/after citations in a leaf-linked session log authored by a reviewer who did not write the remediation.\n- [ ] Every edited comment block has an independent `bloat-removal` PASS row confirming that redundant, obvious, duplicated, historical, or stale prose was removed while current non-obvious rationale remained.\n- [ ] Focused mirror-lock/systemd tests, path-scoped `git diff --check`, and repository lint pass; no missing or FAIL semantic-preservation row remains.\n\n## Verification\nRun the recorded comment-only guard, focused infrastructure tests, path-scoped diff check, and worktree-venv lint.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/bootstrap/main.tf","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"infra/github/apply-mirror-lock.sh","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"infra/github/rollback-mirror-lock.sh","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"infra/systemd/rebar-autodeploy.service","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"infra/terraform-github/main.tf","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["parent","49ac-d7e5-f383-4d7f"],["relates_to","1932-0f4e-0855-4e66"],["relates_to","59a7-cb88-f2f9-4148"]],"no_file_impact_reason":"","parent_id":"49ac-d7e5-f383-4d7f","parent_status_uuid":"642b767b-657d-481f-af83-397bfdc58767","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"in_progress","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"47be-ce45-484a-4cc2","ticket_type":"task","title":"Condense comments in infra","verify_commands":[{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^([[:space:]]*#[^!].*|[[:space:]]*#[[:space:]]*|[[:space:]]*;.*|[[:space:]]*<!--.*|[[:space:]]*.*-->|[[:space:]]*)$\" HEAD^ HEAD -- infra/bootstrap/main.tf infra/github/apply-mirror-lock.sh infra/github/rollback-mirror-lock.sh infra/systemd/rebar-autodeploy.service infra/terraform-github/main.tf","dd_id":"preserve-infra-data","dd_text":"Prove the leaf commit changes only standalone comments or blank lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_mirror_lock_terraform.py tests/scripts/test_observability_journal_bounding_1205.py::test_autodeploy_service_start_timeout_is_below_its_timer_period","dd_id":"mirror-systemd-contracts","dd_text":"Exercise mirror-lock Terraform and autodeploy timer/timeout contracts."},{"command":"rtk git diff --check HEAD^ HEAD -- infra/bootstrap/main.tf infra/github/apply-mirror-lock.sh infra/github/rollback-mirror-lock.sh infra/systemd/rebar-autodeploy.service infra/terraform-github/main.tf","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"Run repository lint and policy gates."}]},"source_event_uuids":["3b5bbdfa-4e1a-441e-af17-3d02c90e49fa","d8c2e340-e0a5-4bd8-8e84-cea082e8184a","a27a1291-ab03-418b-a40c-ed00d5e693d6","290598e0-b56d-4177-92c7-20adb12886f6","f2a1c98c-201b-437b-8915-6c4e0cd26c7c","2477d3e6-a626-4729-bf96-de7d2d8dd3ab","642b767b-657d-481f-af83-397bfdc58767","45ab3da9-e023-4ae2-8ea7-e4bda0d0eb5a","e9cfaf67-2c9e-40b5-9c0c-96c7f811e672","bde084dd-7958-451b-bdeb-1d31486e143e","7c5190b8-f4fc-4551-97bf-5579a098b921"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788848490694755192,"uuid":"4974ecc1-d4c9-4491-8366-83279a2c4b8b"}