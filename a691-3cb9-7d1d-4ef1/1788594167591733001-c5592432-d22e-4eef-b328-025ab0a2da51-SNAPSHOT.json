AAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f52055c7d73ce39d56285eee8a0bdcc82127d896f71eafc5e4316c07bb1d4e66","event_uuid":"1d26bb37-0cd2-4739-9971-0615b445883e","position":{"commit_sha":"fd783c99ecb83cc41b68960683a51dfd233fb003","position":"1788590615596319001-1d26bb37-0cd2-4739-9971-0615b445883e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"STOPPED at plan-review guard. After revising the plan once, the second review remains BLOCK: it identifies required migration of shim consumers outside this leaf's approved file_impact (tests/integration/rebar_reconciler/test_baseline_normalization.py, tests/interfaces/store/test_reconciler_apply_bindings.py, tests/external/test_reconcile_live.py) and a reconcile seam decision involving tests that patch reconcile.<name>. Per leaf protocol and dispatch, I am not claiming or editing code until the orchestrator expands/splits scope.","timestamp":1788576640353700001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Decision recorded: reconcile.<name> monkeypatch targets are ADR-0111 internal compatibility shims, not public/wire/data contracts. I will migrate tests to canonical owners (pass_support/reconcile_helpers/runtime) or remaining reconcile-owned phase seams, then remove the shim bindings. Live-DC guardrail checked: tests/external/test_reconcile_live.py is external, default-Verified-excluded, skips without live Jira creds+acli, and does not monkeypatch reconcile.<name>; it only mirrors the plan-entry shape, so I will update it to cite the canonical owner while preserving the live non-destructive preview oracle.","timestamp":1788576872694868001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Claimed; beginning held-out TDD in worktree janitor-a691-shims.","timestamp":1788577653672870001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation complete locally: removed apply_inbound_records._inbound_update_write_edit_event shim, removed Mode.rank(), removed reconcile.py private helper/runtime compatibility bindings, migrated reconciler/unit + authorized integration/interface/external test consumers to canonical owners (apply_inbound_events/pass_support/reconcile_helpers/runtime), and retained only reconcile-owned phase seams. Held-out RED/GREEN oracle and mutation tooth passed; focused reconciler/authorized tests passed (3745 passed, 2 skipped); make lint and make typecheck passed. Full default local run was attempted with known macOS artifacts deselected, but parallel run was stopped before failure details flushed after unrelated non-reconciler progress; Verified in CI remains authoritative for the known host artifact class.","timestamp":1788587678519411001}],"completion_expectation":"required","created_at":1788314679548565001,"creation_channel":"cli","deps":[{"link_uuid":"a31ba902-75bf-40c8-ae5c-c7e805c286b6","relation":"depends_on","target_id":"8eff-87c1-d09a-4893"},{"link_uuid":"21933af7-e9d3-4b16-82d6-414dcd8dcecb","relation":"relates_to","target_id":"408d-20a9-1b04-4a70"}],"description":"## Context / Problem\n\nPrivate reconciler forwarding bindings retain a second owner after the ADR-0111 private-shim policy landed on main. On the current implementation base, the old private bindings in this leaf are:\n\n- `apply_inbound_records._inbound_update_write_edit_event`, which only forwards to the canonical event writer in `apply_inbound_events`.\n- `reconcile.py` module-level compatibility bindings for helpers now owned by `pass_support`, `reconcile_helpers`, or `runtime`: `StatusMappingError`, `preflight_status_mapping`, `_commit_binding_store_snapshot`, `_read_local_tickets`, `SelectionStaleError`, `ensure_selection_current`, `narrow_selection_inputs`, `_build_filter_target_set`, `_mutation_matches_filter`, `_build_plan_entries`, `_NoOpSyncLogger`, `_write_prev_snapshot_key_set`, `_accepts_synced_fields_out`, `_accepts_client`, `_accepts_ticket_plans`, `_advance_baselines`, `_advance_peer_parent`, `_write_facade_enabled`, `_resolve_pass_transport`, `bind_operation_runtime`, and `compose_reconciler_runtime`.\n- `Mode.rank()`, which remains only because the comparison dunders call it.\n\nThese are private internal names, so ADR 0111 requires exactly one canonical binding and atomic migration of source, test, string, dynamic import, and monkeypatch consumers.\n\n## Seam decision\n\n`reconcile.<name>` monkeypatch targets are internal compatibility shims under ADR 0111, not a public/operator/wire/data contract. This story will remove that seam and migrate consumers to the canonical owner (`pass_support`, `reconcile_helpers`, `runtime`, or a phase function that remains owned by `reconcile.py`).\n\nLive-DC guardrail: `tests/external/test_reconcile_live.py` is marked `external`, is excluded from default Verified (`-m \"not integration and not external\"`), and skips unless live Jira credentials plus `acli` are present. It does not monkeypatch `reconcile.<name>`; it only documents/asserts the preview plan shape that mirrors `_build_plan_entries`. Therefore removing the private `reconcile._build_plan_entries` attribute does not break a live-DC load-bearing seam. The test will be updated to cite the canonical plan-entry owner/contract while preserving the live non-destructive preview oracle.\n\n## Approach\n\n1. Recensus the current base with semantic reference lookup plus raw string scans for imports, `getattr`, dynamic-load, and monkeypatch target strings for each old private name.\n2. Add or strengthen held-out RED oracle coverage under the authorized test surface proving the old shim surfaces are gone while observable behavior remains: inbound update writes still persist edits through `apply_inbound_events`, the reconcile spine still observes monkeypatches installed on canonical helper/runtime owners or on phase functions still owned by `reconcile.py`, live preview remains non-destructive/well-formed, and `Mode` ordering keeps its current order without `rank`.\n3. Migrate every in-scope source/test/string/dynamic/monkeypatch consumer to the canonical owner before deleting the old bindings.\n4. For `reconcile.py`, do not merely delete passive re-exports. Rewrite the in-module call sites in `_load_snapshots`, `_save_and_commit_bindings`, `_persist_and_log`, and `reconcile_once` so they resolve the canonical owner at call time where the collaborator moved, while preserving the remaining `reconcile.py`-owned phase seams (`_load`, `_load_snapshots`, `_persist_and_log`) that are not compatibility re-exports.\n5. Rewrite `Mode` comparison dunders to compare against the existing ordering data directly, then remove `Mode.rank()`.\n\n## Scope\n\n- inbound event-write compatibility re-export in `apply_inbound_records.py`\n- canonical inbound writer in `apply_inbound_events.py`\n- reconciler pass-helper/runtime bindings and their call sites in `reconcile.py`\n- canonical helper/runtime owners in `reconcile_helpers.py`\n- `Mode.rank()` and comparison callers in `mode.py`\n- tests under `tests/unit/rebar_reconciler`\n- `tests/integration/rebar_reconciler/test_baseline_normalization.py`\n- `tests/interfaces/store/test_reconciler_apply_bindings.py`\n- `tests/external/test_reconcile_live.py`\n\n## Testing\n\n- Held-out RED/GREEN oracle in the authorized test surface for canonical owner behavior, absence of old shim bindings, and mode ordering without `rank`.\n- Mutation teeth: temporarily reintroduce one removed shim/bare-name alias/rank path and confirm the held-out oracle returns RED, then restore.\n- Raw scans over the approved file impact for old private names, `getattr`, dynamic import strings, and monkeypatch strings.\n- Focused reconciler unit/integration/interface/external collection tests covering inbound, orchestration/reconcile spine, live preview shape, and mode ordering; then `make lint`, `make typecheck`, and the ticket verify command set.\n\n## Acceptance Criteria\n\n- [x] Every old in-scope core/reconciler private name has no production, test, string, dynamic-load, or monkeypatch consumer through the old owner.\n- [x] The canonical owner is the only binding for each migrated operation in the authorized implementation paths.\n- [x] `reconcile.py` helper/runtime call sites are repointed to canonical owners at call time, and tests prove canonical-owner monkeypatches are observed by the running code path where the collaborator moved.\n- [x] The live-DC external preview harness still collects and, when live credentials plus `acli` are absent, skips for that reason; its well-formed plan contract cites the canonical plan-entry owner rather than `reconcile._build_plan_entries`.\n- [x] Mode ordering comparisons retain all current ordering semantics without `rank()`.\n- [x] Focused inbound/orchestration/mode tests, raw shim-consumer scans, lint, typecheck, and the ticket verify command set pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound_records.py","reason":"remove forwarding event-write shim"},{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","reason":"canonical inbound event-write owner"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile.py","reason":"remove pass-helper re-exports"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"canonical pass-helper owners"},{"path":"src/rebar/_engine/rebar_reconciler/mode.py","reason":"replace rank shim with direct Mode comparisons"},{"path":"tests/unit/rebar_reconciler","reason":"migrate static and monkeypatch consumers and prove behavior"},{"path":"tests/integration/rebar_reconciler/test_baseline_normalization.py","reason":"migrate reconcile._advance_baselines test consumer to canonical helper owner"},{"path":"tests/interfaces/store/test_reconciler_apply_bindings.py","reason":"migrate reconcile.compose_reconciler_runtime monkeypatch consumer to canonical runtime/helper owner"},{"path":"tests/external/test_reconcile_live.py","reason":"migrate external live-DC reconcile shim shape references and confirm live harness guard"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","8eff-87c1-d09a-4893"],["parent","6640-ac11-5c55-46b5"],["relates_to","408d-20a9-1b04-4a70"]],"no_file_impact_reason":"","parent_id":"6640-ac11-5c55-46b5","parent_status_uuid":"70f0887a-1b6e-429f-bcd0-15249b5eebae","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":["janitor","reconciler","internal-shims"],"ticket_id":"a691-3cb9-7d1d-4ef1","ticket_type":"story","title":"Migrate and remove core and reconciler internal shims","verify_commands":[]},"source_event_uuids":["ad5dcfdd-55e4-43bc-a73c-67b15e325677","e55cbe9d-65ce-4465-af37-21d3a804e7db","1b04f2f5-0064-43c9-b1ec-3d6008a969b0","d4777932-8733-490b-aa27-9aeeba3d8e2f","b39329b8-12df-4ad1-8d96-bd5854c9e777","5ba8b4d8-cdaf-4222-91fc-998e84dc39d8","35939e16-da4c-4e39-9927-1ec010b32d5a","d6310675-231c-49fb-92a2-8a362f27ae86","ba063e8c-7899-458c-9723-9a29208703a9","192e7273-9a57-43e2-a321-5d3841d37259","21933af7-e9d3-4b16-82d6-414dcd8dcecb","ed04cc4a-3826-42ac-9d18-771f1fcfc6b7","70f0887a-1b6e-429f-bcd0-15249b5eebae","1d26bb37-0cd2-4739-9971-0615b445883e"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788594167591733001,"uuid":"c5592432-d22e-4eef-b328-025ab0a2da51"}