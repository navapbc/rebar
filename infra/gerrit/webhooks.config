# ---------------------------------------------------------------------------
# webhooks.config — TEMPLATE for the Gerrit `webhooks` plugin remote config.
# Story S4a (review-bot identity + event plumbing).
#
# THIS IS A COMMITTED TEMPLATE — it carries NO real secret. `service-user.sh`
# pushes it to the rebar project's `refs/meta/config` ref. That ref is the ONLY
# place the `webhooks` plugin reads remote config from — it does NOT read this
# file from the working tree or the site dir.
#
# The `webhooks` plugin has NO HMAC request signing and the Gerrit 3.14 plugin does
# NOT read arbitrary `header =` keys from this config. The inbound control is that
# webhook delivery is INTERNAL: the URL targets the review-bot container DIRECTLY
# over the private docker compose network (`http://review-bot:8000/webhook`), and
# the plugin adds its built-in `X-Origin-Url` header. A webhook never traverses the
# public internet/nginx at all. The receiver's host port is loopback-bound
# (127.0.0.1:8000) and port 8000 is NOT open in the security group, so the receiver
# is unreachable from the internet except via nginx `/review/` (where public callers
# still require the token). See ADR-0014.
# ---------------------------------------------------------------------------
[remote "review-bot"]
	# Internal compose-network address (gerrit container -> review-bot container).
	# No `?token=` here: the receiver's uvicorn access log records the request line
	# (path + query), so a URL token would write the bot's Gerrit credential to
	# journald in clear text on every delivery. The deployed plugin also ignores
	# arbitrary `header =` keys, so the receiver accepts this internal Gerrit path
	# by the plugin's built-in `X-Origin-Url` header instead.
	url = http://review-bot:8000/webhook
	event = patchset-created
	# comment-added powers the contributor `rerun-llm-review` trigger (ticket bb9b):
	# the receiver routes it to retrigger.handle_comment_added, which decides
	# eligibility privileged-side and enqueues a forced re-review. NOTE: this
	# template only takes effect after an operator re-runs
	# infra/gerrit/service-user.sh to render + push it to refs/meta/config.
	event = comment-added
	connectionTimeout = 3000
	maxTries = 3
	retryInterval = 5000
	# Plain HTTP on the trusted private network; no TLS to verify on the internal hop.
	sslVerify = false
