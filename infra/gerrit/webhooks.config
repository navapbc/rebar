# Secret-free webhooks template. service-user.sh renders it into the project's
# refs/meta/config. The plugin reads that ref, not this worktree file.
# Gerrit 3.14 sends patchset/comment events to the review-bot container over
# the private compose network. The plugin supplies X-Origin-Url, not a custom
# token header or HMAC. Public /review/ requests use X-Rebar-Token through nginx.
# The loopback-bound receiver is not exposed directly to the internet.
[remote "review-bot"]
	# Internal URL: never put a token in the logged request path or query.
	url = http://review-bot:8000/webhook
	event = patchset-created
	# Comment events enable privileged rerun-llm-review handling. Re-run
	# service-user.sh to publish template changes to refs/meta/config.
	event = comment-added
	connectionTimeout = 3000
	maxTries = 3
	retryInterval = 5000
	# Plain HTTP on the trusted private network; no TLS to verify on the internal hop.
	sslVerify = false
