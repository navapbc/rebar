# Gerrit site replication.config, installed by setup-replication.sh. Push only
# project rebar to GitHub through the materialized SSH deploy key.
# Main, tags, and feature branches have non-force refspecs so divergence rejects
# a push. refs/changes/* alone is force-scoped to converge patchset metadata.
# refs/meta/* remains private because replicatePermissions=false.
# mirror=false prevents pruning GitHub refs. Finite timeout/retries expose
# persistent failures. eventsDirectory persists queued pushes across restart.
# autoReload handles subsequent config edits after the plugin has loaded.
[gerrit]
	autoReload = true
	replicateOnStartup = false
[remote "github"]
	url = git@github.com:navapbc/rebar.git
	projects = rebar
	push = refs/heads/main:refs/heads/main
	push = refs/tags/*:refs/tags/*
	# CI fetches exact patchset refs from GitHub. Force is confined to
	# refs/changes/* so a full sweep can converge metadata without rewriting
	# branch/tag history or exposing refs/meta/*.
	push = +refs/changes/*:refs/changes/*
	# g2p dispatches verify without branch filtering, but GitHub requires the
	# target feature ref on its mirror before workflow_dispatch can resolve it.
	# Mirror only feature/*. mirror=false leaves GitHub-side branch cleanup to
	# the merge-back flow and stale-branch inventory.
	push = refs/heads/feature/*:refs/heads/feature/*
	mirror = false
	replicatePermissions = false
	timeout = 60
	replicationMaxRetries = 3
[replication]
	eventsDirectory = data/replication
