# Gerrit-to-platform template. materialize-g2p-config.sh inserts the SSM GitHub
# PAT before Gerrit boots, writes mode 0600, and copies replication.config beside
# this file so dispatch can find the GitHub owner and repo. Keep the replacement
# marker out of comments. Materialization substitutes it globally.
#
# "recheck" redispatches gerrit-verify.yaml through the "verify" workflow filter.
# Patchset dispatch has no branch allowlist. g2p selects workflow filenames
# containing both "verify" and "gerrit". GitHub workflow_dispatch still requires
# the target branch ref on the mirror, so replicate a new feature branch before
# pushing its first change. Recheck can recover a dispatch lost to that race.
# CI checks out the patchset ref for both normal and merge changes. Feature-branch
# mirror pushes may trigger separate push workflows. Those runs cast no Verified.
[mapping "comment-added"]
	recheck = verify
[github.com]
	token = __GITHUB_PAT__
