# The timer runs this oneshot every two minutes to make the host reflect `main`.
# The script handles SHA-specific deploy backoff without disabling itself.
# StartLimit* is only an outer crash-storm guard. Repeated unit crashes mark it
# failed until `systemctl reset-failed`. Docker separately restarts the review-bot.
[Unit]
Description=rebar continuous auto-deploy (reflect main on the box)
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
# Script defaults are authoritative. Override them here or in /etc/rebar/autodeploy.env.
# /opt/rebar is the copied compose context. MIRROR_DIR is the separate Git clone.
Environment=DEPLOY_REPO=/opt/rebar
Environment=MIRROR_DIR=/var/lib/rebar/mirror
Environment=STATE_DIR=/var/lib/rebar
# Review-bot /health defaults to localhost:8000, not Gerrit 8080. Override
# HEALTH_URL when REVIEW_BOT_PORT changes.
Environment=HEALTH_URL=http://localhost:8000/health
ExecStart=/opt/rebar/infra/scripts/autodeploy.sh
# A failed deploy leaves last-known-good running. Nonzero marks this activation failed,
# then the timer and script backoff schedule another attempt.
# OnUnitActiveSec rearms only after the oneshot completes. The 90-second timeout is
# below the two-minute period so a hung clone cannot suppress later activations.
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
