{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/kernel",
            "matches": [{"_TRANSPORT": "kernel"}]
          },
          {
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/docker",
            "units": ["docker.service"]
          },
          {
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/rebar",
            "units": ["rebar-*"]
          },
          {
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/nginx",
            "units": ["nginx.service"]
          },
          {
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/systemd",
            "units": ["init.scope"]
          }
        ]
      },
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/rebar/gerrit-host",
            "log_stream_name": "{instance_id}/nginx-error",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
