# syntax=docker/dockerfile:1
# Trusted opcert service from a locked repository-root build.
# The build asserts OpenSSH 8.9 or later for SSHSIG signing.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# Git backs the store. OpenSSH signs opcerts. CA roots secure remotes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ver="$(ssh -V 2>&1 | sed -nE 's/.*OpenSSH_([0-9]+\.[0-9]+).*/\1/p')" \
    && echo "detected OpenSSH ${ver}" \
    && awk -v v="$ver" 'BEGIN { split(v, p, "."); if (p[1] < 8 || (p[1] == 8 && p[2] < 9)) exit 1 }' \
    || { echo "ERROR: OpenSSH >= 8.9 is required (op-cert SSHSIG signing)" >&2; exit 1; }

WORKDIR /app

# Lock agents, reviewbot, and Bedrock extras for the gate service.
# reviewbot currently brings boto3, but the explicit Bedrock extra keeps
# the provider dependency intentional. The signing key arrives through a
# mount. Keep the uv image tag at pyproject.toml's required version.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv
COPY . /app
RUN uv sync --locked --no-dev --extra agents --extra reviewbot --extra bedrock
ENV PATH="/app/.venv/bin:$PATH"

ENV REBAR_OPCERT_PORT=8080
EXPOSE 8080

# Run the ASGI app. Host 0.0.0.0 so the published container port is reachable; the port is
# fixed 8080 inside the container.
CMD ["uvicorn", "rebar.opcert_service.app:app", "--host", "0.0.0.0", "--port", "8080"]
