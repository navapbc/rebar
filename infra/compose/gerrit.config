# Gerrit site config lives on EBS at /var/gerrit/site/etc.
# The image seeds an empty site, then reads this file behind nginx TLS.
# Gerrit 3.x stores metadata in NoteDb.

[gerrit]
	# Match the public nginx origin and Compose canonical URL.
	canonicalWebUrl = https://rebar.solutions.navateam.com/
	# Set the repository path explicitly so reseeding cannot remove it.
	basePath = git
	# Keep serverId stable across container recreation for NoteDb refs.
	serverId = fc71b410-f5b3-4446-8e2c-e56c4676521b

[httpd]
	# Trust HTTPS proxy headers and publish HTTP on host loopback.
	listenUrl = proxy-https://*:8080/
	# Bound the HTTP thread pool for the small host.
	maxThreads = 8
	# Log HTTP requests to inspect encoded-slash proxy handling.
	requestLog = true

[sshd]
	# Gerrit SSH is separate from host administration through SSM.
	listenAddress = *:29418
	# Bound total and per-connection batch SSH workers for 8 GiB RAM.
	threads = 4
	batchThreads = 2

[container]
	# Leave RAM for the OS, mmap, and review-bot beside the 2 GiB heap.
	heapLimit = 2g
	# Pin JDK 21 home. Gerrit's old tools.jar discovery loop cannot
	# find that removed file and otherwise prevents JVM startup.
	javaHome = /usr/lib/jvm/jre-21-openjdk
	# Retain Gerrit's JDK 21 module-access flags on reseed.
	javaOptions = -Djava.security.egd=file:/dev/./urandom
	javaOptions = --add-opens java.base/java.net=ALL-UNNAMED
	javaOptions = --add-opens java.base/java.lang.invoke=ALL-UNNAMED

[core]
	# Limit packed-git mmap outside the JVM heap to 1 GiB.
	packedGitLimit = 1g

[auth]
	# Use GitHub OAuth for people and HTTP passwords for service users.
	# Install the OAuth plugin and SSM client credentials before startup.
	# See gerrit-auth-hardening.md for rollback.
	type = OAUTH
	# HTTP password still authenticates service users under OAuth.
	gitBasicAuthPolicy = HTTP

[plugin "gerrit-oauth-provider-github-oauth"]
	root-url = https://github.com/
	# compose-up.sh puts the SSM client ID here and secret in secure.config.
	client-id = __GITHUB_OAUTH_CLIENT_ID__

[index]
	# Lucene indexes NoteDb metadata on this host.
	type = lucene

[receive]
	# No push-cert keyring is provisioned.
	enableSignedPush = false

[change]
	# Submit topics atomically across open partner changes.
	# Use rebar-prefixed topics to avoid cross-repository collisions.
	submitWholeTopic = true

[sendemail]
	# Disable outbound mail to avoid refused localhost SMTP attempts.
	# Gerrit otherwise defaults to 127.0.0.1:25 without an MTA.
	# Restart Gerrit after changing this setting. See the outbound-mail
	# runbook for the lost notifications and re-enable procedure.
	enable = false
