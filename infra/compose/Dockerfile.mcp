# syntax=docker/dockerfile:1
# MCP serves Streamable HTTP from a locked repository-root build.
# The certified gates sign SSHSIG with OpenSSH 8.9 or later. The build
# asserts that floor.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# Git backs the ticket store. OpenSSH signs opcerts. CA roots secure
# the review and tickets remotes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ver="$(ssh -V 2>&1 | sed -nE 's/.*OpenSSH_([0-9]+\.[0-9]+).*/\1/p')" \
    && echo "detected OpenSSH ${ver}" \
    && awk -v v="$ver" 'BEGIN { split(v, p, "."); if (p[1] < 8 || (p[1] == 8 && p[2] < 9)) exit 1 }' \
    || { echo "ERROR: OpenSSH >= 8.9 is required (op-cert SSHSIG signing)" >&2; exit 1; }

# Pin ACLI and its architecture-specific checksum like CI. The Jira
# bridge shells out to acli for writes. Install arm64 on the AL2023 host
# and purge curl after download.
ARG ACLI_VERSION=1.3.19-stable
ARG ACLI_SHA256_AMD64=f29fa8b7f01710053c2f4e07723501ebfe448672b669d32d83e961686d383a6d
ARG ACLI_SHA256_ARM64=72972e74fa9036c5b40175570234a2e79559776c06a3aa29f632a39c7d3674da
ARG TARGETARCH
RUN case "${ACLI_VERSION}" in \
        ''|latest) echo "ERROR: ACLI_VERSION must be pinned, not '${ACLI_VERSION}'" >&2; exit 1 ;; \
    esac \
    && case "${TARGETARCH:-amd64}" in \
        amd64) acli_arch=amd64; acli_sha="${ACLI_SHA256_AMD64}" ;; \
        arm64) acli_arch=arm64; acli_sha="${ACLI_SHA256_ARM64}" ;; \
        *) echo "ERROR: unsupported TARGETARCH '${TARGETARCH}' for acli" >&2; exit 1 ;; \
    esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && curl -sSL "https://acli.atlassian.com/linux/${ACLI_VERSION}/acli_${ACLI_VERSION}_linux_${acli_arch}.tar.gz" -o /root/acli.tar.gz \
    && echo "${acli_sha}  /root/acli.tar.gz" | sha256sum -c --strict \
    && mkdir -p /root/acli-unpack \
    && tar xzf /root/acli.tar.gz -C /root/acli-unpack --strip-components=1 \
    && install -m 0755 /root/acli-unpack/acli /usr/local/bin/acli \
    && rm -rf /root/acli.tar.gz /root/acli-unpack \
    && acli --version \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install agents, MCP, and Bedrock from uv.lock. The separate Bedrock
# extra supplies the configured provider. Without it certified LLM gates
# cannot mint opcerts. Secrets and signing keys arrive through mounts.
# Bedrock uses the instance role, not an app-managed AWS key. Keep the uv
# image tag at pyproject.toml's required version. check_uv_pin enforces it.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv
COPY . /app
RUN uv sync --locked --no-dev --extra agents --extra mcp --extra bedrock
ENV PATH="/app/.venv/bin:$PATH"

# The HTTP transport posture is supplied by the compose service env (REBAR_MCP_*).
# Default the transport here too so a bare `docker run` of this image speaks HTTP.
ENV REBAR_MCP_TRANSPORT=http \
    REBAR_MCP_HTTP_HOST=0.0.0.0 \
    REBAR_MCP_HTTP_PORT=8091
EXPOSE 8091

# Probe unauthenticated loopback /health with the installed Python.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=4).status==200 else 1)"

# Entrypoint provisions a persistent writable tickets clone from the
# tickets branch. Its URL-scoped credential keeps the PAT off disk and out
# of remote URLs. The shared ensure script adds identity and store marker.
# A missing PAT or failed clone does not block server startup.
# It also creates a blobless main clone for attested gate refs because the
# image source copy has no Git object database.
ENV REBAR_TRACKER_DIR=/var/gerrit/site/mcp-tickets \
    MCP_CODE_DIR=/var/gerrit/site/mcp-code \
    REBAR_ROOT=/var/gerrit/site/mcp-code \
    MCP_TICKETS_URL=https://github.com/navapbc/rebar.git
# Install the tested entrypoint file on PATH, then start MCP over HTTP.
RUN install -m 0755 /app/infra/scripts/mcp-entrypoint.sh /usr/local/bin/mcp-entrypoint.sh

# Boot the MCP server. Transport is HTTP via the env above (main() -> run_mcp).
ENTRYPOINT ["/usr/local/bin/mcp-entrypoint.sh"]
CMD ["rebar-mcp"]
