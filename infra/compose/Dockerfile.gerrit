# Extend Gerrit with Python and g2p so the hooks plugin runs CI hooks
# inside the container. Host interpreter paths cannot run there.
# The SSM-materialized token and config arrive through a bind mount, not
# the image. Site hook symlinks remain in the baked image.
FROM gerritcodereview/gerrit:3.14.1

USER root

# AlmaLinux defaults to Python 3.9. Install 3.11 for g2p and assert
# the minimum at build time.
RUN set -eux; \
    dnf install -y python3.11 python3.11-pip git; \
    dnf clean all; \
    python3.11 -c 'import sys; assert sys.version_info >= (3, 11), f"g2p needs Python >= 3.11, got {sys.version}"'; \
    python3.11 -m venv /opt/g2p; \
    /opt/g2p/bin/pip install --no-cache-dir --upgrade pip; \
    /opt/g2p/bin/pip install --no-cache-dir \
      "gerrit-to-platform @ git+https://github.com/lfit/releng-gerrit_to_platform@44d5d46d4142e1063bffaecb548a2f3e2043697e"
# Pin g2p to a Git commit containing Gerrit 3.x compact change-ID
# support. The PyPI 0.3.1 release predates that fix. Git enables the VCS
# install above. Link all 3 installed hooks into the baked site.
RUN set -eux; \
    mkdir -p /var/gerrit/hooks; \
    for h in patchset-created comment-added change-merged; do \
      ln -sf "/opt/g2p/bin/$h" "/var/gerrit/hooks/$h"; \
    done; \
    chown -R 1000:1000 /var/gerrit/hooks

USER 1000
