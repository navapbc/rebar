# syntax=docker/dockerfile:1
# Review-bot webhook receiver built from the repository root.
# The root .dockerignore excludes Git, virtualenvs, tracker data, and
# SSM-sourced .env from the image context. The Python base supports arm64.
FROM python:3.12-slim

# Keep Python lean + predictable in a container.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Git backs the store. OpenSSH 8.9 or later signs event authorship.
# Without it, the review-bot could write unsigned events. CA roots
# secure the scanner installer's HTTPS download.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install the locked offline scanners for fail-closed code review.
# The deployment lane is linux/arm64.
WORKDIR /app
COPY scripts/install_review_scanners.py /app/scripts/install_review_scanners.py
COPY infra/compose/review-scanners.lock.json /app/infra/compose/review-scanners.lock.json
COPY infra/compose/review-scanners.linux-amd64.requirements.txt /app/infra/compose/review-scanners.linux-amd64.requirements.txt
COPY infra/compose/review-scanners.linux-arm64.requirements.txt /app/infra/compose/review-scanners.linux-arm64.requirements.txt
RUN python /app/scripts/install_review_scanners.py install --platform linux/arm64 --prefix /opt/review-scanners \
    && python /app/scripts/install_review_scanners.py check --platform linux/arm64 --prefix /opt/review-scanners
# semgrep runs OFFLINE inside the gate over rebar's local rules: no telemetry, no network
# version check (both would add latency / a phone-home the gate must not depend on).
ENV SEMGREP_SEND_METRICS=off \
    SEMGREP_ENABLE_VERSION_CHECK=0
ENV PATH="/opt/review-scanners/bin:/opt/review-scanners/semgrep-venv/bin:$PATH"

# Install agents, reviewbot, and Bedrock from uv.lock. The agents
# extra includes local web search for blocking plan reviews. The Bedrock
# provider currently imports through reviewbot's boto3 dependency, but
# declaring its own extra keeps the dependency locked if reviewbot changes.
# Keep the uv image tag at pyproject.toml's required version.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv
COPY . /app
RUN uv sync --locked --no-dev --extra agents --extra reviewbot --extra bedrock
ENV PATH="/app/.venv/bin:$PATH"

# Install the shared tickets-store ensure helper for boot convergence.
RUN install -m 0755 /app/infra/scripts/reviewbot-ensure-tickets.sh /usr/local/bin/reviewbot-ensure-tickets.sh

# The receiver port is single-sourced from the .env (REVIEW_BOT_PORT). The default
# matches src/rebar/review_bot/app.py DEFAULT_PORT and the uvicorn --port below.
ENV REVIEW_BOT_PORT=8000
EXPOSE 8000

# Data-capture entrypoint.
# The entrypoint clones a persistent tickets branch and configures a
# URL-scoped PAT helper so artifact events can auto-push. Without a PAT,
# reviews still boot while artifact push stays disabled.
ENV REVIEWBOT_TICKETS_DIR=/var/gerrit/site/reviewbot-tickets \
    REVIEWBOT_TICKETS_URL=https://github.com/navapbc/rebar.git
RUN set -eux; \
    { \
      echo '#!/bin/sh'; \
      echo 'set -e'; \
      echo 'if [ -n "${REVIEWBOT_TICKETS_PAT:-}" ]; then'; \
      echo '  git config --global "credential.${REVIEWBOT_TICKETS_URL}.helper" \'; \
      echo "    '!f() { echo username=x-access-token; echo \"password=\$REVIEWBOT_TICKETS_PAT\"; }; f'"; \
      echo '  git config --global "credential.${REVIEWBOT_TICKETS_URL}.useHttpPath" false'; \
      echo '  if [ ! -d "${REVIEWBOT_TICKETS_DIR}/.git" ]; then'; \
      echo '    git clone --single-branch --branch tickets "${REVIEWBOT_TICKETS_URL}" "${REVIEWBOT_TICKETS_DIR}" || \'; \
      echo '      echo "reviewbot: tickets worktree clone deferred (deploy canary)" >&2'; \
      echo '  fi'; \
      echo 'fi'; \
      echo '# Converge the (possibly freshly-cloned) tickets worktree into a writable'; \
      echo '# rebar store: repo-local git identity + the `.env-id` store marker. Idempotent'; \
      echo '# — a no-op when the clone is deferred or already converged; never blocks boot.'; \
      echo 'reviewbot-ensure-tickets.sh || \'; \
      echo '  echo "reviewbot: tickets store ensure deferred (see logs)" >&2'; \
      echo 'exec "$@"'; \
    } > /usr/local/bin/reviewbot-entrypoint.sh; \
    chmod +x /usr/local/bin/reviewbot-entrypoint.sh

# Run uvicorn on container 8000 behind nginx's published host port.
ENTRYPOINT ["/usr/local/bin/reviewbot-entrypoint.sh"]
CMD ["uvicorn", "rebar.review_bot.app:app", "--host", "0.0.0.0", "--port", "8000"]
