# nginx site template for rebar.solutions.navateam.com.
# Boot substitutes only `${REVIEW_BOT_PORT}`. The single-quoted `envsubst`
# variable list leaves nginx variables such as `$host` and `$remote_addr` literal.
# Host nginx lets certbot renew certificates and reload nginx. It proxies to loopback
# container ports 8080 for Gerrit, `${REVIEW_BOT_PORT}` for review-bot, and 8090
# for the op-cert gate.

# Op-cert origin guard. The SigV4-authenticated API Gateway supplies the secret
# `X-Opcert-Guard` header. `default 0` makes missing or unknown headers fail closed
# with 403 before proxying. Terraform rotates the SSM source secret and API Gateway
# header. `materialize-opcert-guard.sh` writes the current SSM value to the globbed
# include and reloads nginx. A zero-match glob keeps fresh boots valid with every
# request denied. The 128-byte bucket accommodates the 48-character guard token.
map_hash_bucket_size 128;
map $http_x_opcert_guard $opcert_guard_ok {
    default 0;
    include /etc/nginx/opcert-guard*.conf;
}

# Switchable MCP upstream. An upstream with no server fails `nginx -t`.
# `materialize-mcp-upstream.sh` installs the committed seed only when the installed
# file is absent. Blue-green deploys atomically rewrite that file and reload nginx.
upstream rebar_mcp {
    include /etc/nginx/mcp-upstream*.conf;
}

# --- Port 80: ACME challenge + redirect everything else to HTTPS -----------
server {
    listen 80;
    listen [::]:80;
    server_name rebar.solutions.navateam.com;

    # Serve the Let's Encrypt HTTP-01 challenge from the certbot webroot. certbot
    # writes tokens here; this must stay reachable on plain HTTP for issuance/renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else: permanent redirect to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Port 443: TLS terminator + reverse proxy -----------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rebar.solutions.navateam.com;

    ssl_certificate     /etc/letsencrypt/live/rebar.solutions.navateam.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rebar.solutions.navateam.com/privkey.pem;

    # Gerrit pushes/clones can be large; lift the body cap.
    client_max_body_size 0;

    # HSTS belongs at server scope so every route inherits it. `always` includes
    # errors such as MCP's unauthenticated 401, which prevents later plain HTTP
    # requests from exposing bearer credentials.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- review-bot: /review/ -> the FastAPI receiver --------------------
    # The trailing slash + trailing slash on proxy_pass STRIPS the /review/ prefix,
    # so an external GET /review/health reaches the app as GET /health.
    location /review/ {
        proxy_pass http://127.0.0.1:${REVIEW_BOT_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Keep `proxy_redirect default` first because explicit rules disable nginx's
        # implicit default. These per-location rules upgrade only `Location` and
        # `Refresh` response headers and do not rewrite request URIs.
        proxy_redirect default;
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://127.0.0.1:${REVIEW_BOT_PORT}/ https://$host/;
        # Restore `/review/` on same-host absolute redirects after `proxy_pass` strips
        # the prefix. Keep this rule last. It is safe only while the app's sole absolute
        # redirects are Starlette slash redirects to its own routes, as pinned by tests.
        proxy_redirect https://$host/ https://$host/review/;
    }

    # Op-cert gate. Reject invalid guard headers before proxying. The pathless
    # `proxy_pass` preserves `/opcert/` for the service's `/opcert/jobs` routes.
    location /opcert/ {
        if ($opcert_guard_ok = 0) {
            return 403;
        }
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Keep `proxy_redirect default` first because explicit rules disable nginx's
        # implicit default. These per-location rules upgrade only `Location` and
        # `Refresh` response headers and do not rewrite request URIs.
        proxy_redirect default;
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://127.0.0.1:8090/ https://$host/;
    }

    # MCP TLS terminates at nginx. The loopback service speaks HTTP through the
    # switchable `rebar_mcp` upstream. Forward the public host for DNS-rebinding checks.
    # Exact locations map both `/mcp` and `/mcp/` to app path `/mcp`. This prevents
    # Starlette's absolute slash redirect from downgrading HTTPS requests and bearer
    # credentials to HTTP. The prefix location preserves other `/mcp/...` URIs.
    # Each exact location repeats the forwarded headers and SSE settings because it
    # does not inherit them from the prefix location.
    location = /mcp/ {
        proxy_pass http://rebar_mcp/mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Upgrade upstream HTTP redirects. Keep these rules per location so they do not
        # replace the defaults derived by `/review/` and `/opcert/`.
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://rebar_mcp/ https://$host/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Same target for the no-slash external form, so `/mcp` and `/mcp/` are
    # indistinguishable to the app and neither can provoke a slash redirect.
    location = /mcp {
        proxy_pass http://rebar_mcp/mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://rebar_mcp/ https://$host/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # The PREFIX location stays for `/mcp/...` SUB-PATHS (nginx matches the exact-match
    # blocks above first, so it no longer sees the bare `/mcp` or `/mcp/`). NO path on
    # proxy_pass here so the URI is PRESERVED for those sub-paths.
    location /mcp {
        proxy_pass http://rebar_mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Same http->https Location upgrade as the exact-match blocks: a sub-path is just
        # as able to emit an absolute http:// redirect carrying the client's bearer.
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://rebar_mcp/ https://$host/;
        # Streamable-HTTP responses are SSE streams: force HTTP/1.1 upstream (nginx
        # defaults to HTTP/1.0, which has no chunked transfer and breaks SSE) and clear
        # the Connection header so keep-alive is negotiated, then disable buffering +
        # let the stream idle.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Route the exact RFC 9728 metadata URL advertised by MCP 401 responses to the
    # switchable MCP upstream. A pathless `proxy_pass` preserves the URI. Exact
    # matching does not widen `/.well-known/` or affect port 80 ACME handling.
    # Repeat the MCP headers because exact locations do not inherit them.
    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://rebar_mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://rebar_mcp/ https://$host/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Preserve encoded `%2F` in Gerrit request URIs. A pathless `proxy_pass` with no
    # rewrite prevents nginx from normalizing or decoding the URI.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Keep `proxy_redirect default` first because explicit rules disable nginx's
        # implicit default. These per-location rules upgrade only `Location` and
        # `Refresh` response headers and do not rewrite request URIs.
        proxy_redirect default;
        proxy_redirect http://$host/ https://$host/;
        proxy_redirect http://127.0.0.1:8080/ https://$host/;
        # Gerrit fetches exceeded nginx's 60-second read default while the upstream still
        # completed successfully. `proxy_read_timeout` bounds the gap between upstream
        # reads, not total request duration. The 600-second gap allows more than four times
        # the measured 143.9-second maximum while still exposing a wedged backend. Keep it
        # distinct from MCP's 3600-second streaming idle window.
        proxy_read_timeout 600s;
    }
}
