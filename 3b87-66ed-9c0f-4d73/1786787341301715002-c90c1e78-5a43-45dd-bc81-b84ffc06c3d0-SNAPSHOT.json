loadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7be8c67d55c6fab8510562e7d540e92e16232dc4840f479b24e119303c2841cf","event_uuid":"6e47c79d-ed17-4864-8758-936245564726","position":{"commit_sha":"276e2b0e31afb51720d885b487fc9d6e96218936","position":"1786787191362797001-6e47c79d-ed17-4864-8758-936245564726"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4ce5ed4d34045a808d5c9ee5e5c24791399fae1762430d1146598585ba0e5b48","event_uuid":"912a443a-0325-4f2c-acd4-7f4c847f57b0","position":{"commit_sha":"cbbbe976606b43a0a6771edb024a8577b1ea6bfb","position":"1786787341301715001-912a443a-0325-4f2c-acd4-7f4c847f57b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## rebar-debug report — resolve_project None sentinel (scenario 4)\n\n**Problem** — Live DC rehearsal scenario 4 (`test_absent_project_resolves_to_legacy_default`)\nfails at `assert 0 == 1`: a no-flag ticket never lands in the legacy project.\n\n**Proven root cause** — `resolve_project` (`projects_store.py`) treated the tri-state\n`bridge_project` field's present-but-null `None` (the reducer's seeded \"absent/legacy\"\nsentinel, cef7 `_state.py:53-58`) as never-sync by lumping it into `if not value: return None`,\nalongside the explicit `\"\"`. Because the reducer ALWAYS materializes `bridge_project=None` for a\nno-flag create, the old `\"bridge_project\" not in ticket` branch was dead, so `legacy_default`\nnever fired for the cohort it exists to serve → the outbound create gate (`outbound_differ.py:584`\n`if not target: return`) dropped the create.\n\n**Proof** — runtime-confirmed discriminating experiment:\n`resolve_project({\"bridge_project\": None}, ld=\"LEG\")` → `None` vs. explicit `\"LEG\"` → `\"LEG\"`\nand `\"\"` → `None`. `git blame a22e6f3642` confirms original defect, not a regression.\n\n**Legitimacy: `defect`** — violates the authoritative cef7 tri-state contract\n(`reducer/_state.py:53-58`): `None` = absent/legacy → must route to `legacy_default`.\n\n**Caller-dependency gate: CLEARED** — single production caller (`outbound_differ.py:584`) is the\nmalfunctioning site itself; no existing test pins `None`→None (all 15 projects-store /\nensure-mapping tests stay green). Outbound create is double-guarded (mapping seeded AND\n`legacy_default` set and a mapping key) — the only behavior change is the designed cef7 legacy\nmigration.\n\n**Test** — held-out RED unit test\n`test_resolve_project_null_sentinel_routes_to_legacy_default` in\n`tests/unit/rebar_reconciler/test_projects_store_heldout.py`, seen RED (`assert None == 'REB'`)\nbefore the fix, GREEN after; teeth proven by defect-seeded mutation (reintroducing\n`if not value` returns it to RED). Scenario 4 strengthened with a positive\n`legacy in _planned_projects(preview)` assertion (the old `_assert_scope` was vacuous on an\nempty plan).\n\n**Fix** — `resolve_project` rewritten to distinguish the three states explicitly:\n`None`/absent → `legacy_default`, `\"\"` → `None`, non-empty → verbatim (docstring updated).\n\n**Siblings** — construct sweep: the `if not value` truthiness-collapse of a tri-state is the\nclass; `resolve_project` was its only live instance (single caller, single resolution site).\nParity sweep: the rule \"the None absent/legacy sentinel routes to legacy_default\" is enforced at\nthe single shared resolution core both transports call — no parallel surface bypasses it. None\nfound.\n\n**Fix-safety** — restoration (not creation), no new dependency, no test weakened.\n\n**Landed** — Gerrit change 1810 (pushed; awaiting LLM-Review +1 + Verified +1).\n\n**Replication** — pending: a live `Live External Integration` DC rehearsal run must show\nscenario 4 green end-to-end (AC #4) before this closes.","timestamp":1786787191362797001}],"created_at":1786786310728726001,"creation_channel":"cli","deps":[{"link_uuid":"19a45438-1625-430e-b129-82fa67736830","relation":"discovered_from","target_id":"368f-f03e-a045-4377"},{"link_uuid":"912a443a-0325-4f2c-acd4-7f4c847f57b0","relation":"relates_to","target_id":"4062-babc-1cbb-4ce0"}],"description":"## Summary\n\n`resolve_project` (`src/rebar/_engine/rebar_reconciler/projects_store.py`) collapses the\ntri-state `bridge_project` field's **`None` \"absent/legacy\" sentinel** into the same branch as\nthe explicit `\"\"` \"never-sync\" value, so a legacy ticket (no `bridge_project` flag) is\n**suppressed from outbound create** instead of routing to `legacy_default`. This is the direct\ncause of live DC rehearsal scenario 4 (`test_absent_project_resolves_to_legacy_default`) failing\nwith `assert 0 == 1` — the legacy-default ticket never lands in the legacy project.\n\n## Proven root cause (rebar-debug Phase 1 complete)\n\n`create_ticket` with no `bridge_project` stores `bridge_project: None` (present-but-null, seeded\nby the reducer `_state.py:58`), NOT an absent key. `resolve_project`'s `if not value: return None`\nlumps that `None` absent/legacy sentinel with `\"\"` never-sync, and its\n`if \"bridge_project\" not in ticket` branch is dead because the reducer ALWAYS materializes the\nkey — so `legacy_default` never fires for the cohort it exists to serve.\n\nThe authoritative **cef7 tri-state contract** (`src/rebar/reducer/_state.py:53-58`) states\n`bridge_project` is seeded `None` as the deliberate \"absent/legacy\" sentinel; `\"\"` is explicit\nnever-sync; a non-empty string is the sync target. `None` must route to `legacy_default`.\nRuntime-confirmed: `resolve_project({\"bridge_project\": None}, ld=\"LEG\")` → `None`\n(vs. explicit `\"LEG\"` → `\"LEG\"`); the outbound create gate (`outbound_differ.py:584`)\n`if not target: return` then drops the create. Confirmed original (not regression) via\n`git blame a22e6f3642`.\n\n## Fix plan\n\nRewrite `resolve_project` to honor the tri-state explicitly (and update its docstring to\ndocument the present-but-null `None` sentinel):\n\n    value = ticket.get(\"bridge_project\")\n    if value is None:      # absent key OR the None absent/legacy sentinel\n        return mapping.legacy_default or None\n    if value == \"\":        # explicit never-sync\n        return None\n    return value\n\n## Blast radius / caller-dependency sweep (gate CLEARED)\n\nSingle production caller: `outbound_differ.py:584` — the malfunctioning create gate itself,\nwhich expects the contract-correct target. No existing test pins `None`->None; all existing\ntests (`{}`->legacy_default, `\"\"`->None, empty-legacy->None) stay green. The only behavior change\nis the previously-untested `{\"bridge_project\": None}` case, changing toward the cef7 contract.\nThe outbound create is double-guarded — it fires only when the mapping is seeded AND\n`legacy_default` is both set and a key in the mapping — i.e. exactly the designed cef7 legacy\nmigration. No behavioral dependency on the buggy path found; gate clears without escalation.\n\n## Testing\n\n- Held-out RED unit test added to `tests/unit/rebar_reconciler/test_projects_store_heldout.py`,\n  verified RED before the fix and GREEN after; teeth proven by a defect-seeded mutation that\n  returns it to RED. Proof command:\n  `pytest tests/unit/rebar_reconciler/test_projects_store_heldout.py -q`.\n- Full projects-store + ensure-mapping suites stay green:\n  `pytest tests/unit/rebar_reconciler/test_projects_store_happy.py tests/unit/rebar_reconciler/test_projects_store_heldout.py tests/integration/test_ensure_project_mapping.py -q`.\n- Live DC rehearsal proven end-to-end in CI via the `Live External Integration` workflow:\n  `pytest tests/external/live_jira_dc/test_multi_project_rehearsal.py` with `REBAR_RUN_EXTERNAL=1`.\n\n## Acceptance Criteria\n\n- [ ] Held-out RED unit test `resolve_project({\"bridge_project\": None}, ld=X) == X` seen RED\n      before the fix and GREEN after, teeth verified by defect-seeded mutation\n      (`pytest tests/unit/rebar_reconciler/test_projects_store_heldout.py -q`).\n- [ ] All existing `tests/unit/rebar_reconciler/test_projects_store_*.py` and\n      `tests/integration/test_ensure_project_mapping.py` stay green (command above).\n- [ ] Scenario 4 strengthened with a meaningful `{legacy} <= _planned_projects(preview)`\n      assertion, replacing the vacuous empty-plan `_assert_scope`.\n- [ ] A successful LIVE DC rehearsal run of `test_multi_project_rehearsal.py` (all scenarios\n      incl. scenario 4) passing in the CI `Live External Integration` workflow — proven\n      end-to-end, not merely built.\n- [ ] Landed through Gerrit at `LLM-Review +1` AND `Verified +1`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/projects_store.py","reason":"Fix resolve_project tri-state: None absent/legacy sentinel routes to legacy_default; keep \"\" as never-sync"},{"path":"tests/unit/rebar_reconciler/test_projects_store_heldout.py","reason":"Held-out RED unit test pinning None->legacy_default"},{"path":"tests/external/live_jira_dc/test_multi_project_rehearsal.py","reason":"Strengthen scenario 4 with meaningful planned-projects assertion"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","4062-babc-1cbb-4ce0"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"9c0fae87-3183-42bd-937b-e595dbfd2422","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"3b87-66ed-9c0f-4d73","ticket_type":"bug","title":"resolve_project collapses None absent/legacy sentinel into never-sync, suppressing legacy-default outbound create","verify_commands":[]},"source_event_uuids":["051f39b7-7577-45fa-8282-6e2b84639e40","19a45438-1625-430e-b129-82fa67736830","d3ca471d-b6da-4123-b5b6-64ff6b3e0427","d15d6188-5bf4-4b7d-bfa9-0c953bf2ce36","da4b0215-d52d-4827-b1bf-58c095a20a43","9c0fae87-3183-42bd-937b-e595dbfd2422","1c8a6a71-10d9-4798-aa42-07744a24472d","6e47c79d-ed17-4864-8758-936245564726","912a443a-0325-4f2c-acd4-7f4c847f57b0"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1786787341301715002,"uuid":"c90c1e78-5a43-45dd-bc81-b84ffc06c3d0"}