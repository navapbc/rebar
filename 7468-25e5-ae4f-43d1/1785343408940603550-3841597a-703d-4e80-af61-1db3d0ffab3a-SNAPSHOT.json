on/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5d91e9d9e54220adc526935d5af14172737bfc13295489185faf531ea7faa53d","event_uuid":"cc7354b3-ee7f-4ae5-a0f9-385ede55429a","position":{"commit_sha":"2b30b780b90fc4da45ee7eea1507c426c7d53cda","position":"1785343172692282001-cc7354b3-ee7f-4ae5-a0f9-385ede55429a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8f9cb3c4869013b61bbb653f533b2d243750cd8b8000be58e8454ee07c06d33d","event_uuid":"b4abdae3-f002-4f07-a1d1-857e618f8470","position":{"commit_sha":"2b30b780b90fc4da45ee7eea1507c426c7d53cda","position":"1785343173167438001-b4abdae3-f002-4f07-a1d1-857e618f8470"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a27faef5fbc6306cbd4b65b44418b0a7621324355eb2239495890d9cc5bd4ce5","event_uuid":"4aeda24e-41c9-40f0-a5be-13abba1179cf","position":{"commit_sha":"ac35ae92608b9f26af8bd8a8cd255a4dd8638d0d","position":"1785343408940603549-4aeda24e-41c9-40f0-a5be-13abba1179cf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"4ca991d2-5a60-4bb5-8fa2-54b7258425a8","comments":[],"created_at":1785008436071307001,"creation_channel":"cli","deps":[{"link_uuid":"7aa3b1c3-280a-4dac-b914-a6831b84738e","relation":"blocks","target_id":"f184-a5f1-f181-4700"},{"link_uuid":"95ef5311-177c-4cfc-86df-9814a0d0a347","relation":"blocks","target_id":"2932-8a98-6d70-4550"},{"link_uuid":"8457e24a-5449-4fac-b650-4f57e121eff4","relation":"blocks","target_id":"dc0d-886a-519c-4bf7"}],"description":"# S1 — One provider factory behind pydantic-ai's `infer_model(provider_factory=…)`\n\n## Context / Problem\n\nProvider construction is an inline special case. `src/rebar/llm/runner.py:268` reads\n`if self._model_override is None and resolved.startswith(\"anthropic\"):` and builds the retrying Anthropic\nclient in the middle of `run()`. Any second provider (Bedrock, an OpenAI-compatible endpoint) has to add\nanother branch in the same place, which is how PR #121 was written. There is no single place that answers\n\"how is a Provider constructed for provider X\".\n\n## Approach\n\nIntroduce `src/rebar/llm/providers.py` holding a **per-run `ProviderSession`**: an object constructed once per\n`run()` from the `LLMConfig`, exposing `provider_factory` — a callable matching pydantic-ai's\n`infer_model(model_str, provider_factory=…)` hook signature `(str) -> Provider` — plus a registry mapping\nprovider name to a builder. Upstream directs user-configurable-provider apps to exactly this hook\n(pydantic-ai#1343) rather than patching `infer_provider`, so rebar depends on a supported contract.\n\n**Client teardown is the reason this is a session object, not a bare function.** The hook's return type carries\na `Provider` only, with no channel for the retrying `httpx.AsyncClient` that\n`anthropic_model._build_retrying_anthropic_model` currently returns as the second element of a tuple\n(`runner.py:283`) and that `runner.py:446-452` closes in a `finally` block. `ProviderSession` owns that\nlifecycle instead: each builder that constructs an `httpx.AsyncClient` appends it to the session's private\n`_closeables` list, and `ProviderSession.close()` closes them all. `run()` wraps its body in the session as a\ncontext manager, so the existing `finally`-block teardown becomes the session's `__exit__` and the ad-hoc\n`_http_client` local disappears. One session per `run()` call, never shared across runs or threads, so the\nlist needs no locking.\n\nThe Anthropic construction moves verbatim into an `anthropic` builder that still calls\n`_build_retrying_anthropic_model`, keeping the tenacity transport, the `max_retries=0` guard, the\nloopback-proxy bypass (`anthropic_model.py:60`) and the per-request `httpx.Timeout` unchanged; the builder\nunpacks the existing `(model, client)` tuple, registers the client with the session, and returns the provider.\n`_build_retrying_anthropic_model`'s own signature is unchanged, so the two tests that import it directly\n(`tests/unit/test_llm_timeouts.py:33`, `tests/unit/test_transport_retry.py:28`) keep working — but they import\nit via `rebar.llm.runner`, so those two import sites move to `rebar.llm.anthropic_model` in this change.\n`_pai_model` (`anthropic_model.py:159`) remains the model-string resolver and is not touched.\n\nThis story is a **pure relocation with no behavior change** — it lands the seam before any new provider uses\nit, so the Bedrock and OpenAI-compatible stories are additive registrations rather than surgery on `run()`.\n\n**Alternative rejected:** a chain of `elif` branches in `run()` (PR #121's shape). It keeps provider knowledge\nsmeared across the runner, makes each new provider a diff to the hottest function in the module, and leaves no\nplace to attach the capability lookups S2 needs.\n\n**Alternative rejected:** a bare `build_model(resolved, cfg) -> (Model, Closeable | None)` helper that bypasses\n`infer_model` entirely. It solves teardown just as well but abandons the upstream hook, so rebar would own\nprovider-string resolution forever instead of inheriting it.\n\n**Alternative rejected:** passing a mutable out-parameter (e.g. a one-element list) into the factory closure to\nsmuggle the client back. It works but is an unnamed side channel with no ownership story, and it would have to\nbe repeated for every future closeable resource.\n\n## Scope\n\n- `src/rebar/llm/providers.py` (new) — `ProviderSession`, the builder registry, the `anthropic` builder.\n- `src/rebar/llm/runner.py` — replace the `:268` branch with the session's factory; the `:446-452` teardown\n  becomes the session context manager's exit.\n- `src/rebar/llm/anthropic_model.py` — unchanged behavior; imported by the new builder.\n- `tests/unit/test_llm_timeouts.py` (`:33`), `tests/unit/test_transport_retry.py` (`:28`) — update the import\n  site of `_build_retrying_anthropic_model` from `rebar.llm.runner` to `rebar.llm.anthropic_model`.\n- `tests/unit/test_llm_provider_factory.py` (new).\n\n## Testing\n\nContract test tier (producer/consumer through the real seam): the factory is the producer and `run()` the\nconsumer, so a unit test on the registry alone is insufficient — the assertion must be that `run()` obtains its\nprovider through the session and that the session closes what it opened.\n\n- happy path: with `REBAR_LLM_MODEL=anthropic:claude-opus-4-8`, the model `run()` builds is an `AnthropicModel`\n  whose httpx client carries an `AsyncTenacityTransport` and whose `AsyncAnthropic.max_retries == 0`.\n- resource oracle (the defect this design exists to prevent): after `run()` returns, every `httpx.AsyncClient`\n  the session constructed reports closed — asserted on the real client object, not on a call count. A second\n  assertion covers the exception path: `run()` raising still closes the client.\n- failure path: an unregistered provider name raises `LLMConfigError` naming the registered providers, not a\n  `KeyError`.\n- negative control: the `model_override` test path bypasses the factory entirely, constructs no client, and the\n  session closes nothing.\n\n## Acceptance Criteria\n\n- [ ] `grep -n 'startswith(\"anthropic\")' src/rebar/llm/runner.py` returns nothing\n- [ ] the full existing suite passes unchanged (`make test`), evidencing no behavior change\n- [ ] a test asserts `run()` sources its provider from `ProviderSession.provider_factory`, and that an unknown\n      provider raises `LLMConfigError` listing registered names\n- [ ] a test asserts every client the session opened is closed after `run()` returns **and** after `run()`\n      raises, checked on the real client object's closed state\n- [ ] a test asserts the `model_override` path builds no client and the session closes nothing (negative control)\n- [ ] `grep -rn '_build_retrying_anthropic_model' tests/` shows both import sites resolving to\n      `rebar.llm.anthropic_model`, and `make test` passes\n- [ ] `src/rebar/llm/providers.py` is under 300 LOC and imports nothing from `runner` (leaf module, matching the\n      `anthropic_model.py` convention)","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/providers.py","reason":"new: provider registry + provider_factory + anthropic builder"},{"path":"src/rebar/llm/runner.py","reason":"replace inline anthropic branch at :268 with factory call"},{"path":"src/rebar/llm/anthropic_model.py","reason":"builder imports _build_retrying_anthropic_model unchanged"},{"path":"tests/unit/test_llm_provider_factory.py","reason":"new: factory contract tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["blocks","2932-8a98-6d70-4550"],["blocks","dc0d-886a-519c-4bf7"],["blocks","f184-a5f1-f181-4700"],["parent","061c-ecd1-8967-4a76"]],"no_file_impact_reason":"","parent_id":"061c-ecd1-8967-4a76","parent_status_uuid":"cc7354b3-ee7f-4ae5-a0f9-385ede55429a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"7468-25e5-ae4f-43d1","ticket_type":"story","title":"S1 — one provider factory behind pydantic-ai infer_model(provider_factory=…)","verify_commands":[]},"source_event_uuids":["2cebbbc9-6733-428c-9b58-aa46460fbdcf","7aa3b1c3-280a-4dac-b914-a6831b84738e","95ef5311-177c-4cfc-86df-9814a0d0a347","8457e24a-5449-4fac-b650-4f57e121eff4","255d630b-cc33-43a7-b90d-2323ed21d9d6","52b20ffc-56ba-4356-b304-b314a791b55b","a8344d95-d06d-4739-b6cd-8116d5a0be9d","70e8b767-3ef5-4d05-b68e-c2ed26acf647","cc7354b3-ee7f-4ae5-a0f9-385ede55429a","b4abdae3-f002-4f07-a1d1-857e618f8470","4aeda24e-41c9-40f0-a5be-13abba1179cf"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785343408940603550,"uuid":"3841597a-703d-4e80-af61-1db3d0ffab3a"}