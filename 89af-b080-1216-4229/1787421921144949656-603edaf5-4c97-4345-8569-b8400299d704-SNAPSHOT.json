ey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787417206852198001,"creation_channel":"cli","deps":[],"description":"## Context\nMaintained guidance conflates generic HMAC manifest signatures with current plan-review and completion-verifier operation certificates. ADR 0044 defines the DSSE and SSHSIG substrate. ADR 0049 defines asymmetric, environment-attributed operation certificates and legacy compatibility.\n\n## Plan\n- Classify each maintained HMAC statement by its implemented consumer.\n- Describe plan-review and completion-verifier certificates as DSSE envelopes signed through SSHSIG with Ed25519 keys.\n- State that legacy HMAC records remain readable but do not certify these gated operations.\n- Preserve accurate generic HMAC API and manifest-signing guidance for other consumers.\n- Preserve historical migration statements.\n- Exclude `src/rebar/_cli/help/sign.txt` and `docs/llm-framework.md`, which are not stale surfaces.\n\n## Acceptance Criteria\n- [ ] Current gate guidance describes the asymmetric operation-certificate mechanism.\n- [ ] Generic HMAC utilities remain documented where they are implemented.\n- [ ] Legacy compatibility does not read as current gate certification.\n- [ ] ADR and migration history remains intact.\n- [ ] Signing-related documentation consistency tests and targeted documentation checks pass.\n- [ ] Excluded accurate surfaces remain unchanged.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"README.md","reason":"Correct operation-certificate summary claims."},{"path":"docs/manifest-signing.md","reason":"Separate generic HMAC manifest signing from current gate certificates."},{"path":"docs/event-schema.md","reason":"Describe current and legacy signature record roles."},{"path":"docs/reuse-surface.md","reason":"Correct reusable signing and gate-consumer guidance."},{"path":"docs/repo-snapshot-gates.md","reason":"Correct the current gate trust model."},{"path":"docs/plan-review-gate.md","reason":"Correct plan-review and completion certificate guidance."},{"path":"docs/sample-ticket-log.jsonl","reason":"Keep the maintained signature example aligned with its documented mechanism."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","f7e4-4d33-f231-4774"]],"no_file_impact_reason":"","parent_id":"f7e4-4d33-f231-4774","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f09","security"],"ticket_id":"89af-b080-1216-4229","ticket_type":"story","title":"F09 align operation-certificate guidance with asymmetric signing","verify_commands":[{"command":"python scripts/check_docs_index.py --check","dd_id":"D1","dd_text":"Documentation links and index remain valid"},{"command":"python -m pytest tests/unit/test_reuse_surface_doc.py -q","dd_id":"D2","dd_text":"Reusable signing API documentation matches source"},{"command":"python -m pytest tests/interfaces/lifecycle/test_signature.py -q","dd_id":"D3","dd_text":"Signing lifecycle contracts remain green"}]},"source_event_uuids":["24b22468-accb-43e3-8d0f-2d72e7ccd05c","393a20fe-dbea-4277-ad60-109c9b07dca9","214c8316-ef8a-4a41-a977-d027eb14c977"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787421921144949656,"uuid":"603edaf5-4c97-4345-8569-b8400299d704"}