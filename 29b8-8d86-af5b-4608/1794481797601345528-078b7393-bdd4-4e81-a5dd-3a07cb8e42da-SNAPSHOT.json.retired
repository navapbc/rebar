ommit_sha":"f9ff58f61d2cb277ca38d5ae610f5b088a660ccd","position":"1794479504674330001-2f2794be-058b-42c8-9ece-e773f206ebb7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"618633f5e27b1a99944dccf8378100256b87615be527ffa94d24efbb8777509d","event_uuid":"4c569431-3b17-4133-afa2-fd68ef7fead6","position":{"commit_sha":"9371c583150c0a7772285a1a68f4366d3278e2ff","position":"1794480088185248230-4c569431-3b17-4133-afa2-fd68ef7fead6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9536a9ff67d676aded71b2122238030683be4a128aa2197315c92de29496058b","event_uuid":"e574cdf7-e642-40e2-8555-22a5df9fe512","position":{"commit_sha":"a13a3b35a092a6f4aa5ba3516ef82bf6722695c5","position":"1794480537519029001-e574cdf7-e642-40e2-8555-22a5df9fe512"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"429354e47e0b479afeabcf6a2d9af3df2e9b32b33c4d27c179608bfe4550fcb7","event_uuid":"6c5463d6-1048-49a7-93d8-0b15272901d4","position":{"commit_sha":"def1e1d59d1f2aa6561ffe5014c1c612bd4a8e91","position":"1794480554252153001-6c5463d6-1048-49a7-93d8-0b15272901d4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"6614727e300ad0f8da8fd85507413bb3b67de3215b1d2e6e46ebad907ec47fc1","event_uuid":"3f9b33a8-2806-4d1c-8fd4-5311d05a08ce","position":{"commit_sha":"eea4fa9abf7f8f92df91a601e71a472c7aca5b63","position":"1794481421804015001-3f9b33a8-2806-4d1c-8fd4-5311d05a08ce"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"59aaa5667692ed5347e6aee22a6e1754345a6ca2bd5a129fa37fb81766c37522","event_uuid":"b80b9278-674a-4612-9e7e-783495415717","position":{"commit_sha":"01bb2a7de1c98d1e8d14b57ac5599015fe7e2f06","position":"1794481797601345527-b80b9278-674a-4612-9e7e-783495415717"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"3d705fec-b472-45ca-b9ca-e9472648a082","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"**Decision: how should the tickets store reclaim unreachable objects and reflog — on a write-locked cadence that pauses writes, or not at all?**\n\nMeasured on the production tickets clone (`/var/gerrit/site/mcp-tickets`, i-00880b2c7f13527c5, git 2.50.1, 2 vCPU) on 2026-11-11 ~22:45 PST, read-only:\n- `git prune -n --expire=2.weeks.ago` took 113.6 s; `--expire=now` took 107.1 s. Both report 28 unreachable objects. The store holds 1,070,683 packed objects and 50 loose objects. The cost is the reachability walk, not the deletion, so a real prune costs about the same.\n- The step's bound is 120 s (`_LOCAL_GIT_TIMEOUT`); a prune would hold the write lock for ~110 s, blocking every ticket write host-wide for that long, and would be reaped by the bound on any slower day.\n- `.git/logs/HEAD` is 4.69 MB / 25,933 entries. On the local 1.13M-object repo, `git reflog expire --dry-run --all` took 0.28 s, so reflog expiry is cheap enough for the existing write-locked step.\n- The description's \"about 1,800 unreachable loose objects\" no longer matches: today 28 objects are unreachable.\n- The 2 stale doc passages (`docs/concurrency.md` caveat, `docs/scale-envelope.md` §\"Git maintenance & gc\") need fixing in every branch.\n\nHow should unreachable-object and reflog growth be handled?\n(1) **Add reflog expiry to the write-locked maintenance step (cheap, every run that triggers), record unreachable-object growth as accepted at the measured rate with an operator-run prune via `rebar store maintenance` as the remedy, and fix both docs**\n(2) Add reflog expiry plus a write-locked prune at a fixed cadence (e.g. weekly), accepting a ~110 s global write pause each time, and fix both docs\n(3) Record both growths as accepted at the measured rate, change no code, and fix both docs\n\nWork moved on to the next queued bug pending this answer; the ticket stays open and unclaimed.\n","timestamp":1794466259853591001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"HANDOFF STATE 2026-11-12 01:35 PST (session 3d705fec): BLOCKED on the operator decision posted above (options 1-3, recommendation 1). Ticket left open and unclaimed; no code or doc change made. Production measurement was read-only (git prune -n, count-objects).","timestamp":1794476134938860001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Decision RESOLVED by the coordinator (2026-11-12): option (1).\n- Add reflog expiry to the existing write-locked maintenance step (measured ~0.3 s), with git's default expiry or a value fixed in code; no config key.\n- Unreachable-object pruning stays operator-run, documented in a runbook. The measured growth is 28 objects, which does not justify a ~110 s write-lock pause.\n- Fix docs/concurrency.md and docs/scale-envelope.md to describe the current maintenance posture.\n- Close when landed.","timestamp":1794476367427465001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan written into the description (option 1). Container git measured at 2.47.3, so the maintenance reflog-expire task (git >= 2.50) is not usable; the step calls git reflog expire --all directly. Prod dry run 0.01-0.06 s.","timestamp":1794477076138277001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan revised after review BLOCK: the 28/1,800 counts were loose-only. Re-measured across packs on prod 2026-11-12 ~02:05 PST: reachable 1,071,190 (same with --reflog) vs at most 1,071,347 stored, so at most 157 unreachable objects since the 2026-08-26 clone. Runbook now reclaims with repack --cruft --cruft-expiration=2.weeks.ago under the write lock.","timestamp":1794478128851771001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan AC2 reworded during implementation, with evidence. On git 2.56 a 60-day reflog entry whose commit is an ancestor of the tip was pruned under default settings, and with gc.reflogExpire=never alone a 45-day unreachable entry was kept, so a test cannot assert the 90-day/30-day split the docs describe. The step passes no expiry value, so the tests now prove: stale entries expire, recent ones stay, and the repository's own gc.reflogExpire* settings govern. Re-running the plan review on the revised description.","timestamp":1794479357870902001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan revised after review BLOCK (cruft repack leaves expired loose objects): runbook now uses git gc --cruft --prune=2.weeks.ago, verified locally on git 2.56 to remove both an old loose and an old packed unreachable object while keeping a fresh one. Also: a timed-out expiry now logs an ERROR listing ref/reflog lock files (rebar reclaims only index.lock); real expiry on a 26,000-entry reflog measured 0.02-0.03 s.","timestamp":1794480554252153001}],"created_at":1794436618751044517,"creation_channel":"mcp","deps":[{"link_uuid":"5e51df95-4288-4d0d-8fa6-00db5348f2d9","relation":"discovered_from","target_id":"51e0-5038-bf00-4653"}],"description":"## Problem\n\nAfter bug `nickelic-lazuline-gonolek` (Gerrit 3351), the tickets store no longer runs `git gc` on any path:\n- Every bounded git child runs with `maintenance.auto=false` and `gc.auto=0`.\n- The explicit write-locked step runs only `commit-graph`, `loose-objects` and `incremental-repack`.\n\nThat was deliberate. On the 1.07M-object production clone, `gc --auto` took 133.9 s and a full repack took 605.6 s, both past the step's 120 s bound. But it has two consequences:\n- Nothing ever prunes unreachable objects, such as the leftovers of failed writes, abandoned merges and compaction.\n- Nothing ever expires reflogs. The production `.git/logs/HEAD` was 4.5 MB on 2026-11-11.\n\nGrowth is slow (see Measurements; an earlier loose-only count of about 1,800 objects is superseded). Even so, the growth is unbounded.\n\nTwo docs still describe the old posture:\n- `docs/concurrency.md`, in the caveat paragraph: \"keeps auto-gc ENABLED\" and \"It reclaims loose/pack growth on its own\".\n- `docs/scale-envelope.md`: stock `git gc` runs in the foreground of the write command and handles packing.\n\n## Decision (recorded 2026-11-12, coordinator; option (1) of the 2026-11-11 Decision comment)\n\n- Reflog entries: expired inside the existing write-locked maintenance step, using git's own expiry defaults (`gc.reflogExpire` 90 days, `gc.reflogExpireUnreachable` 30 days). No config key, env var or flag.\n- Unreachable objects: growth is ACCEPTED at its measured rate, with an operator-run reclaim documented in a runbook.\n\n## Measurements (production tickets clone, read-only, via SSM)\n\nUnreachable objects, counted across loose AND packed storage (2026-11-12 ~02:05 PST):\n- Total objects: 1,071,252 in packs (35 packs) + 95 loose = 1,071,347. Packs can hold duplicate copies, so this total is an upper bound.\n- Reachable objects: `git rev-list --objects --all | wc -l` = 1,071,190, and the same 1,071,190 with `--reflog` added. So reflogs keep no extra objects alive today.\n- Unreachable objects are therefore at most 157 (about 0.015%), accumulated since the clone was made on 2026-08-26 PDT: an upper bound of about 157 objects in 2.5 months. Each reachability walk took 107-112 s.\n- Earlier loose-only counts (1,800; 28) are not a growth measure: `loose-objects` packs unreachable loose objects too.\n\nReflog expiry cost: `git reflog expire --dry-run --all` took 0.01-0.06 s over 3 runs (3 refs, HEAD reflog 4.69 MB / 25,933 entries).\n\nGit version: maintenance's `reflog-expire` task needs git 2.50; the production MCP container runs 2.47.3 (measured 2026-11-12), where an unknown task fails the whole `maintenance run`. So the step calls `git reflog expire --all` directly.\n\n## Approach\n\n1. `src/rebar/_store/event_commit_git.py::run_auto_maintenance`, still under the caller's write lock:\n   - After `maintenance run`, run `git reflog expire --all` through `run_git_reaped` with its own fixed 30 s timeout (a module constant), so the worst-case lock hold is the maintenance bound plus 30 s.\n   - Skip it when maintenance could not launch (`None`) or timed out (124), so a slow step never adds more.\n   - Any failure (non-zero exit including 128, or OSError) is logged as a warning and never raised. A 124 is logged as an ERROR that lists every `*.lock` under the common git dir's top level, `refs/` and `logs/`: rebar reclaims only index.lock, so a ref lock stranded by the kill blocks writes until removed. Measured cost of a real (non-dry) expiry on a 26,000-entry reflog: 0.02-0.03 s.\n   - The return value is unchanged (the maintenance result).\n2. `infra/runbooks/tickets-store-prune.md` (new), the operator-run reclaim:\n   - Measure first: unreachable upper bound = (in-pack + count) - `git rev-list --objects --all --reflog | wc -l`. Reclaim only when material.\n   - Reclaim with `git -c pack.threads=1 gc --cruft --prune=2.weeks.ago` (git's own tool; a cruft repack alone leaves expired LOOSE objects, gc also prunes them). Verified locally on git 2.56: a 30-day-old unreachable loose object and packed object were both removed, a fresh one kept. Full repack, 605.6 s measured (bug nickelic-lazuline-gonolek).\n   - Run inside the live MCP container under `rebar._store.lock.write_lock`; writes in that window fail with a lock timeout, so use a quiet window. Verify by re-measuring; no rollback needed.\n3. `docs/concurrency.md` caveat and `docs/scale-envelope.md` §\"Git maintenance & gc\" describe the current posture:\n   - No implicit gc or maintenance.\n   - The explicit locked step runs commit-graph, loose-objects, incremental-repack, then reflog expiry.\n   - Unreachable objects are reclaimed only by the operator runbook (for any store shape; the runbook's commands are written for the production MCP deployment).\n   - This replaces \"keeps auto-gc ENABLED\", \"reclaims loose/pack growth on its own\" and \"Foreground auto-gc handles packing\".\n\n## Scope\n\n- `src/rebar/_store/event_commit_git.py`\n- `src/rebar/_store/sync.py` (module docstring still described foreground auto-gc)\n- `tests/unit/test_store_reflog_expiry.py` (new)\n- `tests/unit/test_store_maintenance_gonolek.py` (its exact-calls test gains the reflog call)\n- `infra/runbooks/tickets-store-prune.md` (new)\n- `docs/concurrency.md`\n- `docs/scale-envelope.md`\n\n## Testing\n\n- RED then GREEN: a real git repo with isolated config has HEAD reflog entries dated (via `GIT_COMMITTER_DATE`) 120, 60, 45 (unreachable) and 1 day ago. After `run_auto_maintenance`, the 120-day and 45-day entries are gone and the 1-day entry remains. Fails on the pre-fix tree.\n- With `gc.reflogExpire=never` and `gc.reflogExpireUnreachable=never` set in the repo, every entry survives, proving the step passes no expiry value of its own.\n- Why the test does not assert git's 90/30-day split: see the 2026-11-12 implementation comment (measured on git 2.56).\n- Failure arms, with `run_git_reaped` faked: the reflog call raising OSError, returning 124, or returning 128 each logs a warning, raises nothing, and still returns the maintenance result.\n- When maintenance returns 124 or cannot launch, the reflog call is not made.\n- `test_explicit_step_runs_exactly_the_incremental_tasks` asserts the maintenance call followed by `reflog expire --all`.\n- Docs check before commit: `git grep -n` finds none of `keeps auto-gc`, `reclaims loose/pack growth on its own`, `Foreground auto-gc handles packing` (the first is matched alone because the original phrase wraps a line).\n- A 124 test plants `.git/HEAD.lock` and asserts the error names it.\n\n## Acceptance criteria\n\n- [ ] Unreachable objects and reflog entries on the tickets store are reclaimed on some bounded cadence that never runs outside the write lock, or a recorded decision accepts unbounded growth with its measured rate.\n- [ ] Reflog entries past git's expiry policy are expired by the write-locked maintenance step, shown by a test that fails on the pre-fix tree, and the repository's own `gc.reflogExpire*` settings govern (no value is hard-coded), shown by a test.\n- [ ] A failing, erroring or timed-out reflog expiry is logged and never raised, and it is skipped after a timed-out maintenance run, shown by tests.\n- [ ] The recorded decision states the measured unreachable-object rate counted across packs, and `infra/runbooks/tickets-store-prune.md` documents a reclaim that removes packed unreachable objects under the write lock.\n- [ ] `docs/concurrency.md` and `docs/scale-envelope.md` describe the current maintenance posture and no longer contain the 3 stale phrases.\n- [ ] [non-codebase] `env -u JIRA_URL -u JIRA_USER -u JIRA_API_TOKEN make verify` exits 0 on the commit pushed for review.\n  provenance: environment=macOS dev host, fix-xiphias worktree; principal=Rebar Bot Nava; privilege_posture=narrower; instrument=live-call — exit status and log live outside the repository\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_store/event_commit_git.py","reason":"reflog expiry in the locked maintenance step"},{"path":"src/rebar/_store/sync.py","reason":"module docstring described foreground auto-gc"},{"path":"src/rebar/_commands/_init_ensures.py","reason":"gc-config unit docstring described enabled auto-gc"},{"path":"tests/unit/test_store_reflog_expiry.py","reason":"regression tests for reflog expiry"},{"path":"tests/unit/test_store_maintenance_gonolek.py","reason":"exact-calls test gains the reflog call"},{"path":"infra/runbooks/tickets-store-prune.md","reason":"operator-run reclaim under the write lock"},{"path":"docs/concurrency.md","reason":"current maintenance posture"},{"path":"docs/scale-envelope.md","reason":"current maintenance posture"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"7ccde28b-dc4c-47b4-a7ef-67a573e6db1d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"29b8-8d86-af5b-4608","ticket_type":"bug","title":"Tickets store never prunes unreachable objects or expires reflogs after implicit gc was disabled; two docs still describe foreground auto-gc","verify_commands":[]},"source_event_uuids":["1a69e69c-e6f5-4b60-ad44-5de13e5c2446","e9d819c1-f5e8-4daa-aef0-c2bf6251191b","368da594-2bea-4580-985a-91447d38f1bb","d989b613-2fbf-46bb-9dfc-831def8f1b56","757839b5-81cd-4ff4-9628-af21a0c13393","dfe7cd8e-10fe-4a46-85a3-00cc4213a37a","cba62e87-dff4-49f3-8946-f20692bb4330","a067d90d-f08d-4198-9924-74e2feede0a8","cfc53341-f320-4f7d-a492-8920135723dc","491120ca-7ce7-4526-a6cf-3bd2b89c3714","fc19adff-cca0-40fc-aa19-805158bc9d5b","7ccde28b-dc4c-47b4-a7ef-67a573e6db1d","e092eaba-0531-4e7d-adbb-46128ab56465","e9e8cd69-b1a5-47a3-b895-66c5ac2b7d0d","219f221f-d508-4b93-87c7-cfd0c0143108","2f2794be-058b-42c8-9ece-e773f206ebb7","4c569431-3b17-4133-afa2-fd68ef7fead6","e574cdf7-e642-40e2-8555-22a5df9fe512","6c5463d6-1048-49a7-93d8-0b15272901d4","3f9b33a8-2806-4d1c-8fd4-5311d05a08ce","b80b9278-674a-4612-9e7e-783495415717"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794481797601345528,"uuid":"078b7393-bdd4-4e81-a5dd-3a07cb8e42da"}