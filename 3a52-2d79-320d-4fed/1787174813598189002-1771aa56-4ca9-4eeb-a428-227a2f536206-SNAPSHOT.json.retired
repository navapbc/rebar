{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787174813598189002,"compiled_state":{"alias":"masonic-abeyant-stagbeetle","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"0b851c81032aa1a2032296848b4e091d171abb34","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3a52-2d79-320d-4fed","material: 5e13622635226163","material-part: children 647ea2107ca5072f 0","material-part: description 29150987ae8eecf8 7983","material-part: description_boxes 82b5ffdeee404535 2","material-part: file_impact ed87e5d147d57774 7","material-part: ticket_id f875f13d81b828fd 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (0b851c8103-dirty)","regver: 1da3feeb7c09e17f","verified-at-sha:09947b1f5fff63b802e46bf68bf3408500cdb9a6","dep cecf5c25f5bb98dc3261e96dd5fc745e487b74c30b37e910118399fc3a7a303b docs/config.md","dep 67e0270567b4d73b14a9003581774fb1140e2975ba4166965c2510a646148110 docs/env-vars.md","dep fd4a8c91f645ac9d7c3a85bb4817fcd0d9f67aac95ae1c18993a896b16514b24 docs/repo-snapshot-gates.md","dep 4989d84f50b7ab273320aa17fcbe386338f8b1c316700342b459318656a982f6 infra/compose/docker-compose.yml","dep de4785214f68e5c54715ee3d71ace6b740c7fc77c4ec524f0cc8a8802a758e34 src/rebar/_config_sources.py","dep 91a9021a8f466b1a88fc7953371fde57d9a6461ec6267f412c7f2ce226b86bc1 src/rebar/_snapshot/janitor.py","dep ce555926351bbd66ed31ae7aa94ceeafc13d012b46ea44533b649e9ab393b2f3 tests/unit/test_snapshot_janitor.py","read-set: 11","read-path: docs/env-vars.md","read-path: infra/compose/docker-compose.yml","read-path: infra/scripts/autodeploy.sh","read-path: infra/terraform/monitoring_autodeploy.tf","read-path: src/rebar/_config_schema.py","read-path: src/rebar/_config_sources.py","read-path: src/rebar/_snapshot/janitor.py","read-path: src/rebar/_snapshot/repo_snapshot.py","read-path: src/rebar/llm/gate_source.py","read-path: src/rebar/review_bot/app.py","read-path: tests/unit/test_snapshot_docs.py","currency-basis: file_impact"],"material_fingerprint":"5e13622635226163","merged_log_commit":"09947b1f5fff63b802e46bf68bf3408500cdb9a6","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787174813579391000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"b8fd706342334ff9899909e5671b588ddd597a5a1cad864fdd735bdbffc656fd","event_uuid":"093aa58a-89a5-4863-90bc-9c5004af4424","position":{"commit_sha":"ec55c61da630edcdfe3df5ad14e88afa99e8ed9c","position":"1787171844613958001-093aa58a-89a5-4863-90bc-9c5004af4424"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5914f1bc6ac9ce05e34dbc12c5d1f4a3ec83360f66ef28c3fa55134f0c2115ff","event_uuid":"11391454-7014-40cc-83d7-017829afae77","position":{"commit_sha":"ec55c61da630edcdfe3df5ad14e88afa99e8ed9c","position":"1787171845648356001-11391454-7014-40cc-83d7-017829afae77"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7fe129463524e07151deb2e47eb10034df0504afccde455607aa7d550c13325e","event_uuid":"94e6ef2a-320c-460f-8e8f-bf9f8d8611e3","position":{"commit_sha":"873c1d7454b77d7417f447796cc90d0eab371cda","position":"1787172452151978001-94e6ef2a-320c-460f-8e8f-bf9f8d8611e3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2137245e8927a8c2f8b0d50a75b5b9aa7fb35a934de1749a40a947a89416bcc1","event_uuid":"45dda50b-46b0-425e-ab64-72fdf7249cd2","position":{"commit_sha":"dfe7ad3a166b4b443a82a3eed878e55c37927568","position":"1787172784687057001-45dda50b-46b0-425e-ab64-72fdf7249cd2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"518d7eab664957a97313d72bca07d2362cec427efbec2540df4bac169cee28cc","event_uuid":"1f17c534-34c0-4956-b99d-7cc0503e8448","position":{"commit_sha":"746b2264364f4b559e3db572488838b394788ef0","position":"1787173680040759001-1f17c534-34c0-4956-b99d-7cc0503e8448"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"54531bca953e8fa82c64e195081a7f5b5256d9b9a1c6ee17d57c3947134d7e73","event_uuid":"4f7f73ae-4190-48d3-b9a9-bd6721d1dac6","position":{"commit_sha":"fba34cb35d8e91595496535f8eb7c4a7492068f7","position":"1787173872294124001-4f7f73ae-4190-48d3-b9a9-bd6721d1dac6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ec58d7e9721adda2c62f31742727c77f5b71ee89a5e394ff882bce147b3b0f1e","event_uuid":"bcad0fc8-89d4-4d68-b25c-8254b123b1ff","position":{"commit_sha":"b5273445ee6144f606289dc1bdca9d96a9ee3415","position":"1787173899569810001-bcad0fc8-89d4-4d68-b25c-8254b123b1ff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"aef5204abb89b6ef358da0035f776cf837d67709868edd6319361bef987d4bb5","event_uuid":"ebc75b50-e068-4832-95ef-d0d8f279e0d1","position":{"commit_sha":"5dd4c00b244067b5089d562010a251a93823ff67","position":"1787174043770895001-ebc75b50-e068-4832-95ef-d0d8f279e0d1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5995b8e50e7f00e3773a14f287c59a8998d14caa0dd131c09b61be1feebfd18a","event_uuid":"dfccdacf-d716-4513-a1f8-87f767aefd7b","position":{"commit_sha":"529daed68ddd8a8fc7c55ff10ed07140845f2200","position":"1787174195229430001-dfccdacf-d716-4513-a1f8-87f767aefd7b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0fdc238f671800b25858f14afb983ff85d70703efddfcaabf0d241f31275a62a","event_uuid":"335088eb-764a-48e7-97f5-573d8420cd22","position":{"commit_sha":"861ac6cc7e300010aaeecd4fc7956a44eaeb6f00","position":"1787174542813273001-335088eb-764a-48e7-97f5-573d8420cd22"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"db0f6e0bb07889e75e451c5839b21334fb5dd1e0f821606fc6a6a5e1ea002040","event_uuid":"8ee9f14a-0a42-4748-aebe-6e848380d539","position":{"commit_sha":"984e1b5b8cfd34b96dd022c142125e41b2f35ea1","position":"1787174665054323001-8ee9f14a-0a42-4748-aebe-6e848380d539"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9baa1f1045f10dd818d712554bf4ee38774b607e702743d31e28258480272626","event_uuid":"cf32723a-5c6a-4848-9f7c-12b8de4dce9a","position":{"commit_sha":"e6aad71a3b32d2708175efeece894e3260731fde","position":"1787174684067657001-cf32723a-5c6a-4848-9f7c-12b8de4dce9a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"43d6a7b09b65bab055cf63a3010c87bd7f789a81dc1d6b7a87a6d6e7d7073494","event_uuid":"0d2bb5e9-842c-44b3-9fa7-5189cabc2cdf","position":{"commit_sha":"e78fdf5a72608972c2e1ba92416561099c1757df","position":"1787174813598189001-0d2bb5e9-842c-44b3-9fa7-5189cabc2cdf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-235_agent","claim_remote_session":null,"claimed_session":"eff19c3d-071a-47b5-bae6-8b48a3343a8c","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 1 evidence capture (AC1) — first-hand read-only CloudWatch + in-repo/runtime evidence\n\nDebug worktree `debug/3a52-root-disk-pressure` off `origin/main` (0b851c8103). All AWS calls\nbelow are read-only `cloudwatch:GetMetricStatistics` / `ListMetrics`. **No host access was\nused** — `ssm:SendCommand` is blocked in this session, so journald/`du` evidence is NOT part\nof this record (see \"What still needs a host operation\" at the end).\n\n### 1. The reclaim is not a prune — it is a return to a FIXED floor\n\n`rebar/host:root_disk_used_percent`, 5-min samples, 2026-08-15 → 2026-08-19: **23 drops of\n≥5 percentage points, and every one lands on 48%** (two on 49%/51%). Drop sizes range\n1.5 GiB → 12.6 GiB. The incident drop is `90% @22:00 → 48% @22:05` = 12.6 GiB.\n\nA `docker builder prune --keep-storage 5GB` + `docker image prune -f` leaves a *variable*\nresidue that depends on what was reclaimable at that moment. It cannot produce an identical\n48% floor across 23 independent events of wildly different sizes. A constant floor is the\nsignature of an **ephemeral working set being destroyed wholesale**, returning the disk to\nits baseline.\n\n### 2. Growth tracks REVIEW volume, not deploy volume\n\n`review_bot_llm_total_tokens` was sustained 0.8M–3.0M per 5 min from 20:35 straight through\n22:30 — reviews ran continuously *before, during and after* the drop. Root-disk growth rate\nwas ~4.4 GiB/h **before** the drop (69%→90% over 85 min) and ~4.3 GiB/h **after** it\n(48%→54% over 25 min). Same rate, same driver, uninterrupted by the reclaim.\n\n### 3. The deferral episode did not cover the growth window\n\n`deploy_deferrals`: **0** in every 5-min bucket from 20:30 through 21:50, then 2 / 3 / 1 at\n21:55 / 22:00 / 22:05. The disk crossed `DISK_PRESSURE_PCT` (80%) at **21:25** and the 85%\nalarm floor at **21:35** — 20–30 minutes *before* the first deferral. So the deferral path\ncannot be what suppressed reclaim during the climb, and `deploy_errors` = `voter_errors` =\n`review_interrupts` = **0** throughout (no backoff, no failed deploy, no ENOSPC).\n\n### 4. Both docker-prune hypotheses are therefore weakened, and the disk-consumer question moves\n\n`infra/scripts/docker-compose.yml`'s `review-bot` service mounts **only**\n`./rebar-bot-signing-key` (ro), `gerrit_reviewbot` → `/var/gerrit/site/reviewbot`, and\n`gerrit_reviewbot_tickets` → `/var/gerrit/site/reviewbot-tickets` — both bind-backed onto the\n**separate 50-GiB `/var/gerrit` EBS volume**. There is no `tmpfs` and no other mount, and\n`REBAR_GATE_TMPDIR` is not set in the compose environment. So everything else the bot writes\nat runtime lands on the **container writable layer**, i.e. `/var/lib/docker` on the 30-GiB\n**root** volume — and those bytes are neither buildkit cache nor a dangling image, so\n`prune_docker_caches` **cannot reclaim them at all** while the container is running.\n\n`src/rebar/_snapshot/repo_snapshot.py:113` `store_root()` =\n`config.resolve_gate_tmpdir() or tempfile.gettempdir()` + store dirname. Verified at runtime\nwith `REBAR_GATE_TMPDIR` unset: it resolves under `tempfile.gettempdir()`, i.e. `/tmp` inside\nthe container.\n\n### 5. RUNTIME EXPERIMENT (AC2 discriminator, part 1): the snapshot janitor cannot fire before the alarm\n\nDrove the **real** `rebar._snapshot.janitor.run_gc()` with injected free-space values for a\n30-GiB root (5 warm, out-of-grace, not-cold entries — the bot's steady state under continuous\nreview load):\n\n| root used | free injected | evicted | reclaimed |\n|---|---|---|---|\n| 71% (pre-incident) | 8.70 GiB | **0** | 0 |\n| 80% (`DISK_PRESSURE_PCT`) | 6.00 GiB | **0** | 0 |\n| **85% (CloudWatch ALARM floor)** | 4.50 GiB | **0** | 0 |\n| **90% (observed incident peak)** | 3.00 GiB | **0** | 0 |\n| 94% (past the watermark) | 1.80 GiB | 5 | 20480 |\n\n`src/rebar/_snapshot/janitor.py:53` `DEFAULT_FREE_WATERMARK_BYTES = 2 * 1024**3`. On a 30-GiB\nroot that watermark is only crossed at **93.3% used** — strictly *above* the 85% alarm floor\nand above the 90% peak actually reached. **The alarm necessarily fires before snapshot GC can\never engage.** This is hypothesis 1 of the ticket, now confirmed dynamically rather than by\nreading the constant.\n\n### 6. The health dip is the same event, caught by sampling luck\n\n`reviewbot_healthy` (dimension `InstanceId=i-00880b2c7f13527c5`) was 0 in exactly **two**\n5-min buckets across 2026-08-15→19; one of them is **2026-08-17 22:05** — the same bucket as\nthe 90%→48% drop. Only 1 of the 23 reclaim events shows a health dip because the host probe\npolls every 5 minutes and the recreation window is seconds long. No separate cause is needed\nfor the \"review-bot drops unhealthy\" symptom.\n\n### Working account (not yet fully proven)\n\nOne mechanism explains every symptom: the review-bot's **ephemeral per-review working set**\nlives on the container writable layer (30-GiB root) because no volume covers it; it is\ninvisible to `prune_docker_caches`; the snapshot janitor's 2-GiB-free watermark sits below the\nalarm floor so GC never engages; and the bytes are freed only when a deploy **recreates** the\ncontainer — hence the constant 48% floor and the coincident health dip.\n\n### What still needs a host operation (blocked here)\n\n`ssm:SendCommand` is denied in this session, so I could not run the bounded read-only host\nprobe that would name the **dominant** consumer directly. The exact command wanted is a\nread-only `AWS-RunShellScript` on `i-00880b2c7f13527c5`:\n`df -h /`; `docker system df -v`; `docker ps --size`; `du -xh --max-depth=2 /tmp` **inside the\nreview-bot container**; and\n`journalctl -u rebar-autodeploy.service --since \"2026-08-18 03:30\" --until \"2026-08-18 06:00\"`\nplus a count of `AUTODEPLOY_DISK_PRESSURE` markers (that marker is deliberately not published\nas a CloudWatch metric — story 28f9 scoped it out — so journald is its only reader).\n`docker ps --size` alone would settle it: it prints each running container's writable-layer\nsize.\n\nrebar-debug Phase 1, Stage 3 continues; no repair has been attempted.","timestamp":1787172452151978001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC2 discriminating experiment — the Docker-cache hypothesis is FALSIFIED\n\nTwo rival consumers were live. This experiment separates them on a prediction they\ndisagree about, using only read-only CloudWatch and local `git`.\n\n**Rival A** (ticket hypothesis 2, \"autodeploy prunes Docker caches too late\"): the bytes are\nbuildkit cache + image layers from review-bot rebuilds. Build artifacts can only be created\nby a **build**, and autodeploy only builds when `main` advances with a `BOT_PATHS`/\n`SECRETS_PATHS` change. → **Predicts: in a window with no such commit, the root disk is flat.**\n\n**Rival B**: the bytes are the review-bot's ephemeral per-review working set on the\ncontainer's writable layer. → **Predicts: the disk grows at the same rate in build-free\nwindows, as long as reviews are running.**\n\nMethod: cut the 5-min `root_disk_used_percent` series at every `origin/main` commit touching\n`BOT_PATHS`/`SECRETS_PATHS`, allow 15 min after each for autodeploy to notice + build +\nprune, and measure growth inside each maximal build-free interval ≥40 min. Intervals\ncontaining a reclaim were excluded so a drop cannot confound the rate. 1 pt = 0.30 GiB.\n\n| build-free interval (UTC) | mins | Δ% | GiB/h | LLM tokens |\n|---|---:|---:|---:|---:|\n| 08-16 23:46 → 08-17 17:18 | 1052 | +34 | **+0.59** | 23.2M |\n| 08-17 17:33 → 08-17 20:14 | 161 | +23 | **+2.67** | 8.7M |\n| 08-17 20:29 → 08-18 04:16 | 467 | +29 | **+1.12** | 20.8M |\n| 08-18 05:13 → 08-18 07:02 | 110 | +17 | **+2.91** | 14.1M |\n| 08-18 10:00 → 08-18 11:13 | 73 | +3 | +0.83 | 5.0M |\n| 08-18 11:28 → 08-18 13:07 | 100 | +5 | +0.95 | 1.3M |\n| 08-18 18:15 → 08-18 22:03 | 227 | +31 | **+2.54** | 11.2M |\n| 08-18 22:43 → 08-18 23:51 | 68 | +9 | **+2.49** | 7.8M |\n| 08-19 03:22 → 08-19 04:26 | 64 | +1 | +0.33 | 4.6M |\n| 08-19 06:39 → 08-19 07:36 | 57 | +12 | **+3.93** | 2.2M |\n| 08-19 10:39 → 08-19 12:15 | 96 | +3 | +0.57 | 3.4M |\n| 08-19 13:44 → 08-19 14:56 | 72 | +0 | **+0.00** | 0.6M |\n\nn=12; growth GiB/h min +0.00, median **+1.12**, max **+3.93**. **10 of 12 build-free\nintervals grew faster than 0.5 GiB/h**, and the single interval that did **not** grow at all\nis the one with almost no review activity (0.6M tokens).\n\n**Result: Rival A is rejected.** Buildkit cache and image layers cannot appear without a\nbuild, yet the disk climbs at up to 3.93 GiB/h across windows in which no rebuild was\npossible. The one flat interval is flat because *reviews* stopped, not because *builds*\nstopped. Rival B's prediction holds.\n\nCorroborating (E3): all **23** reclaim events over 2026-08-15→19 are preceded by a\n`BOT_PATHS` commit (22/23 within 60 min, 16/23 within 30 min); there is no reclaim in any\nbuild-free window. Reclamation is tied to the deploy, not to the pressure gate.\n\n### Where the growing bytes must be\n\n`infra/compose/docker-compose.yml:223-240` — the `review-bot` service's only mounts are\n`./rebar-bot-signing-key` (ro), `gerrit_reviewbot` → `/var/gerrit/site/reviewbot`, and\n`gerrit_reviewbot_tickets` → `/var/gerrit/site/reviewbot-tickets`; both named volumes are\nbind-backed onto the **separate 50-GiB `/var/gerrit` EBS volume**. No `tmpfs`, no other mount.\nSo every other runtime write lands on the container's writable layer = `/var/lib/docker` on\nthe **30-GiB root**.\n\n`REBAR_GATE_TMPDIR` is set **nowhere** — not in `docker-compose.yml`'s environment block, not\nin `infra/scripts/fetch-secrets.sh` (which generates the SSM-sourced `.env`), not in\n`infra/compose/Dockerfile.reviewbot`. So `store_root()`\n(`src/rebar/_snapshot/repo_snapshot.py:113`) provably falls through to\n`tempfile.gettempdir()` → **`/tmp/rebar-gate-snapshots` inside the container**, on the root\ndisk. That is the same path the alarm's own description already names as a root-disk reclaim\ntarget (`infra/terraform/monitoring_autodeploy.tf:213`).\n\nThose bytes belong to a **running** container's read-write layer: they are neither buildkit\ncache (`docker builder prune`) nor a dangling image (`docker image prune`), so\n`prune_docker_caches` cannot reclaim them **at all** — which is why the reclaim gate story\n28f9 added could not have prevented this breach no matter when it fired.","timestamp":1787172784687057001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"# Phase 1 EXIT — confirmed root cause (rebar-debug)\n\nTwo causes, and two are needed: one explains the **growth rate**, the other explains the\n**failure to reclaim**. Neither alone explains both symptoms.\n\n---\n\n## RC-A (why there was so much to reclaim) — every review writes a full ~620 MiB / ~70,000-file copy of the ticket store, keyed on a ref that advances every ~26 seconds, and nothing ever frees it\n\n`src/rebar/llm/gate_source.py:99` calls `materialize_tickets(...)` on every attested gate\nresolution. `materialize_tickets` (`src/rebar/_snapshot/repo_snapshot.py:675-703`)\ncontent-addresses the entry as `<store>/tickets-<sha>` and builds it via `_materialize_tree`\n(`:373-410`, `git read-tree` + `git checkout-index`) — every file written fresh, no\nhardlinking, no delta, no per-review release (`SnapshotHandle._cleanup` at `:199` is never\nassigned by any producer). `_pin_tickets_sha` (`:534-609`) pins the **live** tracker HEAD via\n`config.tracker_dir()`, and `tracker_dir_override()` (`src/rebar/_config_sources.py:65-79`)\nreturns the container's `REBAR_TRACKER_DIR` verbatim, so the key is the tickets branch tip.\n\nMeasured independently on this checkout:\n\n- tickets tree = **69,984 blobs** (≈620 MiB; ~800 MiB allocated). Code snapshot for comparison:\n  41.6 MiB / 3,131 files — **15× smaller**.\n- **1,374 commits** on `origin/tickets` in the 10-hour incident window — HEAD moves every ~26 s.\n- each of the last 5 consecutive tickets commits changed **exactly 1 file**.\n\nSo a ~1-file delta produces a fresh 620 MiB copy: ~10^5× write amplification, on a key with\neffectively **zero reuse**. At ~0.85 GiB per review (tickets + code entry) and the observed\nreview cadence this models **2.5-10 GiB/h**; measured growth was **4.4 GiB/h**. Match.\n\nThe review-bot's own `code_review` artifact write (`REBAR_SYNC_PUSH: always`,\n`docker-compose.yml:120`) guarantees the ref advances between reviews even if nothing else in\nthe fleet were writing.\n\n## RC-B (why nothing reclaimed it before the alarm) — both janitor eviction triggers are structurally unreachable in this deployment, and the third one the ADR promises was never implemented\n\n`_gc_pass` (`src/rebar/_snapshot/janitor.py:303-345`) has exactly two eviction predicates:\n\n- **`need_space = free < cfg.free_watermark_bytes`** (`janitor.py:318`), default **2 GiB**\n  (`janitor.py:53`). That is an **absolute** floor and it is disk-size-blind. On a 30-GiB root\n  it is crossed only at **93.3% used** — above the `rebar-root-disk-pressure` threshold of\n  **85%** (`infra/terraform/monitoring_autodeploy.tf:226`) and above the observed **90%** peak.\n- **`too_cold = mtime < now - max_age_seconds`**, default **7 days** (`janitor.py:55`). The\n  store lives on a writable layer destroyed on every redeploy — 23 reclaim events in 4 days,\n  i.e. a container lifetime of hours. **No entry can ever reach 7 days**; the cold-trim is dead\n  code here.\n- The third trigger, promised by `docs/adr/0005-snapshot-cache-architecture.md:72-73` and by\n  the module's own contract docstring (`janitor.py:13-15`) — \"backstopped by the\n  incrementally-maintained byte total\" — **does not exist**: `_gc_pass` reads only `free` and\n  `mtime`. The only reader of `byte_total` is `startup_sweep` (`janitor.py:251`), for\n  reconciliation. There is no store-size cap knob at all (`docs/config.md:474-484`).\n- Compounding it: `materialize_tickets` bypasses `cache.acquire` and so **never calls\n  `add_bytes`** — even if the ADR's backstop existed it would under-count the dominant consumer\n  to **zero**.\n\nThe janitor **is** started (`src/rebar/review_bot/app.py:134-136`) and ran every 300 s\nthroughout the incident. It correctly evicted nothing. \"GC never ran\" is falsified.\n\n---\n\n## Proof — discriminating experiments\n\n**E1 (runtime, decisive for RC-B).** Drove the real `rebar._snapshot.janitor.run_gc()` with\ninjected free-space values for a 30-GiB root against 5 warm, out-of-grace, not-cold entries:\n\n| root used | free injected | evicted |\n|---|---|---|\n| 80% (`DISK_PRESSURE_PCT`) | 6.00 GiB | **0** |\n| **85% (CloudWatch ALARM floor)** | 4.50 GiB | **0** |\n| **90% (observed incident peak)** | 3.00 GiB | **0** |\n| 94% (past the watermark) | 1.80 GiB | 5 |\n\nProvably inert across the entire range the incident occupied. A `dynamic` claim confirmed by\nexecution, not by reading the constant.\n\n**E5 (falsifies the Docker-cache rival).** Buildkit cache and image layers cannot exist without\na build, and autodeploy only builds when `main` advances with a `BOT_PATHS`/`SECRETS_PATHS`\nchange. Cutting the `root_disk_used_percent` series at every such commit (+15 min for\nbuild/prune, excluding intervals containing a reclaim) yields 12 maximal build-free intervals:\n**10 of 12 grew faster than 0.5 GiB/h; median +1.12, max +3.93 GiB/h — with no rebuild\npossible.** The single non-growing interval (+0.00) is the one where *review* activity nearly\nstopped (0.6M LLM tokens). Growth tracks reviews, not builds. **Ticket hypothesis 2 (Docker\nprune timing) is rejected.**\n\nThree further nails in that rival: (i) the largest reclaim, **12.6 GiB**, exceeds the entire\n5 GB buildkit ceiling plus any plausible dangling-image set; (ii) `--keep-storage` leaves a\n*variable* LRU residue, so 23 independent prunes cannot converge on an identical floor, whereas\ndestroying a container writable layer converges **by construction** — and 23 of 23 drops land\non **48%**; (iii) with `deploy_deferrals = 0` for every bucket 20:30-21:50, the `TARGET ==\nDEPLOYED` no-op branch *was* being taken, so from 21:25 (80%) a pressure prune fired roughly\nevery 10 min — and the disk climbed **80% → 90% straight through them**.\n\n**E3.** All 23 reclaim events over 2026-08-15→19 are preceded by a `BOT_PATHS` commit (22/23\nwithin 60 min); no reclaim occurs in any build-free window. Reclamation is tied to container\nrecreation, never to the pressure gate.\n\n**E4.** `deploy_deferrals` was 0 through 21:50; the disk crossed 80% at 21:25 and 85% at 21:35,\n**20-30 min before the first deferral**. The drain gate is a bystander that delayed the\nrecreation which would otherwise have reset the disk sooner — an aggravating factor, not the\ncause. `deploy_errors` = `voter_errors` = `review_interrupts` = 0 throughout.\n\n**E2.** With `REBAR_GATE_TMPDIR` unset, `store_root()` resolves under `tempfile.gettempdir()`.\n`REBAR_GATE_*` appears **nowhere** in `docker-compose.yml`, `Dockerfile.reviewbot`, or\n`fetch-secrets.sh`, and the `review-bot` service's only mounts are `/var/gerrit/site/reviewbot`\nand `/var/gerrit/site/reviewbot-tickets` (bind-backed onto the separate 50-GiB EBS volume) plus\na read-only key file — no `tmpfs`. So `/tmp/rebar-gate-snapshots` is on the container's\n**writable layer**, on the 30-GiB root.\n\n**Ruled out as the leak:** the per-change clone workdir\n(`src/rebar/review_bot/voter.py:572`, `tempfile.TemporaryDirectory` in a `with` block —\nreleased on every exit path); the LLM-workflow run snapshot (`llm/workflow/snapshot.py:70-74`,\nrooted at that temp clone and capped at 512 MiB, `:43`); journald (survives container\nrecreation, so it cannot produce a constant floor).\n\n---\n\n## Every symptom accounted for\n\n| symptom | cause |\n|---|---|\n| root disk 71% → 90% in ~1 h at 4.4 GiB/h | RC-A: ~0.85 GiB of fresh snapshot per review |\n| the alarm breached 85% and kept climbing | RC-B: the only bounding mechanism cannot engage until 93.3% |\n| abrupt 90% → **48%** at 22:05 | deploy recreated the container; the writable layer (store included) destroyed |\n| **all 23** drops land on the identical 48% | wholesale destruction of an ephemeral layer, not a variable-residue prune |\n| `reviewbot_healthy` = 0 in the 22:05 bucket only | the 5-min host probe sampled during that recreation; 1-of-23 is the expected hit rate for a seconds-long window |\n| `voter_errors` = 0 | never reached ENOSPC — recreation came before exhaustion |\n| `deploy_deferrals` 2/3/1 at 21:55-22:05 | the drain gate delayed the recreation, so this episode reached 90% instead of resetting earlier |\n| story 28f9's mitigation did not prevent it | `prune_docker_caches` cannot reclaim a **running** container's writable layer, whenever it fires |\n\nNo residual symptom is unexplained.\n\n---\n\n## Defect legitimacy\n\n**RC-B — `defect` / `incomplete-implementation`.** Cited authorities, all violated:\n\n- `infra/runbooks/review-bot-ops.md:500-508` — the documented defense ordering: the janitor\n  \"reclaims `/tmp/rebar-gate-snapshots` on a free-space watermark\", and the alarm pages \"so\n  exhaustion is caught **before** it silently fail-closes the gate.\" In practice the ordering is\n  inverted: the backstop fires and the primary never does.\n- `docs/adr/0005-snapshot-cache-architecture.md:72-73` and `janitor.py:13-15` — both specify a\n  byte-total backstop that `_gc_pass` does not implement (`incomplete-implementation`).\n- `infra/terraform/monitoring_autodeploy.tf:209-215, 226` — the alarm contract names 85% as the\n  actionable threshold and `/tmp/rebar-gate-snapshots` as a reclaim target for it.\n- Prior **closed** bug `7a41-95f4-c38c-4b5a` AC2 — \"a disk-headroom check … so exhaustion is\n  caught **before** it vetoes reviews.\" A previously-fixed behaviour class.\n- This ticket's own AC4.\n\nNot `environment-or-config`: an operator *can* set `REBAR_GATE_FREE_WATERMARK_BYTES`, but the\nshipped **default** is what is wrong, and an absolute byte floor is disk-size-blind by\nconstruction — no single absolute value is correct across hosts.\n\n**RC-A — `defect`.** `docs/adr/0005-snapshot-cache-architecture.md` D2 rests on \"an immutable\nSHA is a perfect cache key\", which holds only for keys with **reuse**. The tickets ref has\nnone — it advances every ~26 s — so the structure is not a cache but an append-only log of\n620-MiB full copies, contradicting the ADR's own claim that the store is bounded and\nreclaimable.\n\n---\n\n## What was NOT established\n\n`ssm:SendCommand` is blocked in this session, so there is **no** host `du` / `docker system df`\n/ journald evidence in this record. RC-A's dominance rests on measured artifact sizes, measured\nref churn, the code path, and the rate match — not on a direct measurement of the live\ndirectory. The one host operation still wanted, purely read-only:\n`docker ps --size` and `du -xh --max-depth=1 /tmp` inside `compose-review-bot-1`. It would\nconfirm the split rather than change the conclusion.\n\nPhase 1 complete. Siblings filed for the two causes that are out of this ticket's repair scope.","timestamp":1787173680040759001}],"created_at":1787064025053427001,"creation_channel":"cli","deps":[{"link_uuid":"439dd92f-7c34-4a8e-93ca-868a6f80fc73","relation":"discovered_from","target_id":"28f9-535c-ce9c-4583"},{"link_uuid":"202bc8ab-1019-4feb-906a-6fa722cfaa14","relation":"relates_to","target_id":"7a41-95f4-c38c-4b5a"}],"description":"## Context\n\n`rebar-root-disk-pressure` went ALARM 2026-08-17 21:51 PDT (OK 22:12) on `rebar-gerrit`\n(`i-00880b2c7f13527c5`, 30-GiB gp3 root). Root usage climbed 71% @20:55 → 90% @21:55/22:00,\nthen dropped to 48% @22:05; `reviewbot_healthy` dipped to 0 at 22:05.\n\n## Phase 1: COMPLETE — root cause proven\n\nFull evidence in the \"Phase 1 EXIT\" comment (experiments, CloudWatch series, citations).\nSummary:\n\n- **REJECTED — \"autodeploy prunes Docker caches too late.\"** Build artifacts cannot appear\n  without a build; 10 of 12 build-free intervals still grew (median +1.12, max +3.93 GiB/h).\n  The 12.6-GiB reclaim exceeds the whole 5 GB buildkit ceiling. `prune_docker_caches` cannot\n  reclaim a **running** container's writable layer at all.\n- **CONFIRMED (RC-B, this ticket) — the janitor's reclaim triggers are unreachable here.**\n  `src/rebar/_snapshot/janitor.py:53` `DEFAULT_FREE_WATERMARK_BYTES = 2 GiB` is an **absolute**,\n  disk-size-blind floor: on a 30-GiB root it is crossed only at **93.3% used**, above the 85%\n  alarm (`infra/terraform/monitoring_autodeploy.tf:226`) and above the 90% peak reached.\n  Driving the real `run_gc()` with injected free space gives **0 evictions at 85% and at 90%\n  used**; first eviction only past 93.3%. The 7-day cold-trim (`janitor.py:55`) exceeds the\n  container's lifetime (23 recreations in 4 days). The janitor *is* started\n  (`src/rebar/review_bot/app.py:134-136`) and correctly evicted nothing.\n- **CONFIRMED (RC-A, split to `smart-disloyal-naga`) — the growth source.** Every review\n  materializes a full ~620 MiB / 69,984-file copy of the ticket tree\n  (`src/rebar/llm/gate_source.py:99` → `_snapshot/repo_snapshot.py:675-703`), keyed on a tip\n  that advanced 1,374 times in the 10-hour window with consecutive commits differing by 1 file.\n\nThe store sits on the 30-GiB root because `REBAR_GATE_TMPDIR` is unset everywhere, so\n`store_root()` (`repo_snapshot.py:113`) falls through to `tempfile.gettempdir()` = the\ncontainer writable layer. The 48% floor and the 22:05 health dip are one event: the deploy\nrecreating the container and destroying that layer.\n\n## Scope of THIS ticket\n\nRC-B only — make reclaim engage **before** the alarm floor. RC-A is `smart-disloyal-naga`; the\nmissing byte-total backstop and `add_bytes` accounting are `itchy-arbored-peccary`.\n\n## Plan\n\nAdd a **volume-relative** headroom term to the janitor's free-space trigger so the watermark\ncannot sit above the alarm floor on a small volume, plus hysteresis so a pass reclaims past the\ntrigger instead of re-firing every 300 s. Both new values are **integers** so they survive the\nexisting int-only config seam (`_snapshot_int` coerces with `int()`, and `JanitorConfig`'s\nfields and `_default_tunables()` are `dict[str, int]`) — a float fraction would truncate to 0\nand silently disable the fix.\n\n1. `src/rebar/_snapshot/janitor.py` — add `DEFAULT_FREE_WATERMARK_PCT = 0` and\n   `free_watermark_pct: int` (whole percent of the volume; `0` = relative term off) to\n   `JanitorConfig` + `_default_tunables()`. Add a module-level\n   `RECLAIM_TARGET_MARGIN_PCT = 5` constant — a fixed internal margin, not an operator knob,\n   matching how `DEFAULT_GRACE_SECONDS` / `DEFAULT_INTERVAL_SECONDS` are handled. In\n   `_gc_pass`, take `total = shutil.disk_usage(root).total` and compute:\n   - `trigger = max(free_watermark_bytes, total * free_watermark_pct // 100)`\n   - `target  = max(free_watermark_bytes, total * (free_watermark_pct + RECLAIM_TARGET_MARGIN_PCT) // 100)`\n\n   Evict when `free < trigger`, and once triggered keep evicting until `free >= target`. The\n   grace window and `_is_entry`'s `tickets-` recognition are untouched.\n\n   Worked example, 30-GiB root, `free_watermark_pct = 20`: `trigger` = 6.0 GiB free (80% used),\n   `target` = 7.5 GiB free (75% used). Both sit below the 85% alarm floor (4.5 GiB free), which\n   is what AC4 requires. With `free_watermark_pct = 0` the arithmetic collapses to\n   `max(2 GiB, 0)` = today's behaviour exactly.\n\n2. `src/rebar/_config_sources.py` — resolve `free_watermark_pct` through the existing\n   `resolve_janitor_tunables` int path (`REBAR_GATE_FREE_WATERMARK_PCT` > `[snapshot]` table >\n   default `0`). No new float helper is needed.\n3. `infra/compose/docker-compose.yml` — set `REBAR_GATE_FREE_WATERMARK_PCT: \"20\"` on the\n   `review-bot` service, the pattern already used for `REBAR_TRACKER_DIR` and\n   `REBAR_USAGE_LOG`. 20 is `autodeploy.sh:110`'s `DISK_PRESSURE_PCT=80` expressed as headroom,\n   chosen there as below the 85% alarm for hysteresis.\n4. `docs/config.md`, `docs/repo-snapshot-gates.md`, `docs/env-vars.md` — document the one new\n   knob and the fixed margin.\n5. `tests/unit/test_snapshot_janitor.py` — the RED oracle.\n\n### Design decision for review: what should `free_watermark_pct` default to?\n\n- **Option A (this plan) — default `0` (off), set to `20` for the review-bot host in compose.**\n  No behaviour change for any existing rebar user; fixes this host. Cost: the defect stays\n  latent for other deployments on small volumes.\n- **Option B — default `20`.** Removes the defect for every deployment. Cost: on a large volume\n  that is >80% full for unrelated reasons, `_gc_pass` would evict the whole store every pass\n  without reaching the target. Bounding how much such a pass evicts needs the store's real\n  size — exactly the accounting `itchy-arbored-peccary` restores, so Option B should follow it.\n\n## Testing\n\nRun from the worktree venv (`env PATH=\"$PWD/.venv/bin:$PATH\" ...`).\n\n- **RED oracle** — `pytest tests/unit/test_snapshot_janitor.py -q`. New cases drive the real\n  `janitor.run_gc()` with `free_bytes` injected for a 30-GiB volume (`total` stubbed via\n  `shutil.disk_usage`): at 85% used (4.50 GiB free) and at 90% used (3.00 GiB free) the pass\n  MUST evict a non-grace entry. Against current code both evict 0 — the observed RED. A\n  hysteresis case asserts the pass continues to the 7.5-GiB-free target rather than stopping\n  at the 6.0-GiB trigger; a grace case asserts an entry touched inside `grace_seconds` is still\n  skipped. A `free_watermark_pct=0` case asserts today's behaviour is unchanged.\n- **Exact-defect mutation** — reset the compose/config `free_watermark_pct` to 0 (restoring\n  the absolute-only watermark) and re-run the module: the new cases MUST return to RED.\n- **Config seam** — `pytest tests/unit/test_snapshot_janitor.py -k tunable -q`, covering\n  `REBAR_GATE_FREE_WATERMARK_PCT=20` surviving int resolution (not truncating to 0).\n- **Docs pin** — `pytest tests/unit/test_snapshot_docs.py -q`.\n- **No regression** — `pytest tests/unit -q`; `make lint`; `make typecheck`; `make config-check`.\n- **Post-deploy (operator, read-only)** — `rebar/host:root_disk_used_percent` shows reclaim\n  events with peaks under 85%, where the pre-fix series peaked at 90% (2026-08-17) and 87%\n  (2026-08-18).\n\n## Acceptance Criteria\n\n- [x] A faithful local reproduction identifies the dominant disk consumer and the component\n      responsible for the 90%→48% reclaim.\n- [x] A discriminating runtime experiment proves the root cause and rules out the surviving\n      Docker-vs-snapshot alternative.\n- [ ] A test is observed RED on the proven mechanism, GREEN after repair, then RED again under\n      the exact-defect mutation — proved by `pytest tests/unit/test_snapshot_janitor.py -q`.\n- [ ] The repaired path reclaims before a 30-GiB root crosses the 85% alarm floor — proved by\n      the 4.50-GiB-free case evicting.\n- [ ] The repaired path reclaims with hysteresis — proved by the hysteresis case asserting\n      reclaim continues to the 7.5-GiB-free target, not stopping at the 6.0-GiB trigger.\n- [ ] Live/grace snapshot entries are preserved — proved by the grace-window case.\n- [ ] Existing fail-safe deploy/review semantics remain intact — proved by `pytest tests/unit -q`\n      green (`infra/scripts/autodeploy.sh` is absent from this ticket's file impact).\n- [ ] Documentation is updated — proved by `pytest tests/unit/test_snapshot_docs.py -q` green.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_snapshot/janitor.py","reason":"Add the volume-relative free-space term and the hysteresis reclaim target to JanitorConfig and _gc_pass; this is the defective line (DEFAULT_FREE_WATERMARK_BYTES absolute floor)."},{"path":"src/rebar/_config_sources.py","reason":"Resolve the two new janitor knobs through resolve_janitor_tunables (env > [snapshot] table > default), matching the existing knob shape."},{"path":"infra/compose/docker-compose.yml","reason":"Set REBAR_GATE_FREE_WATERMARK_PCT for the review-bot service so the 30-GiB root reclaims below the 85% alarm floor."},{"path":"docs/config.md","reason":"Document the new [snapshot] keys; pinned by tests/unit/test_snapshot_docs.py."},{"path":"docs/repo-snapshot-gates.md","reason":"Document the new tunables in the gate tunables table."},{"path":"docs/env-vars.md","reason":"Register the new REBAR_GATE_* env vars."},{"path":"tests/unit/test_snapshot_janitor.py","reason":"RED oracle: a 30-GiB volume at 85% and 90% used must evict, and must reclaim past the trigger (hysteresis)."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","7a41-95f4-c38c-4b5a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"093aa58a-89a5-4863-90bc-9c5004af4424","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["aws-alarm","root-disk-pressure","review-bot","awaiting-user-escalation"],"ticket_id":"3a52-2d79-320d-4fed","ticket_type":"bug","title":"[root-disk-pressure] Root disk reaches 90% and review-bot drops unhealthy after automated-reclaim mitigation","verify_commands":[]},"source_event_uuids":["093aa58a-89a5-4863-90bc-9c5004af4424","11391454-7014-40cc-83d7-017829afae77","94e6ef2a-320c-460f-8e8f-bf9f8d8611e3","45dda50b-46b0-425e-ab64-72fdf7249cd2","1f17c534-34c0-4956-b99d-7cc0503e8448","4f7f73ae-4190-48d3-b9a9-bd6721d1dac6","bcad0fc8-89d4-4d68-b25c-8254b123b1ff","ebc75b50-e068-4832-95ef-d0d8f279e0d1","dfccdacf-d716-4513-a1f8-87f767aefd7b","335088eb-764a-48e7-97f5-573d8420cd22","8ee9f14a-0a42-4748-aebe-6e848380d539","cf32723a-5c6a-4848-9f7c-12b8de4dce9a","0d2bb5e9-842c-44b3-9fa7-5189cabc2cdf"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787174813598189002,"uuid":"1771aa56-4ca9-4eeb-a428-227a2f536206"}