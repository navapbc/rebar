d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788598089947703001,"creation_channel":"cli","deps":[{"link_uuid":"d4da0dce-2650-451a-ac90-5ab2d2322f02","relation":"discovered_from","target_id":"ab07-c603-a94a-419e"}],"description":"## Context / Problem\nOn `origin/main` at `c019920390926d543a0813d4c0c8721543d98776`, the `review_interrupts_signal_unavailable` alarm description in `infra/terraform/monitoring_autodeploy.tf` says “1-datapoint latch,” but the resource is configured as a 2-of-4 evaluation window. The heredoc is an executable Terraform value, so correcting it is outside comment-only remediation.\n\n## Approach\nMake the alarm description state the configured evaluation rule and add a focused assertion that description and resource settings cannot drift.\n\n## Acceptance Criteria\n- [ ] The alarm description accurately states the configured 2-of-4 window.\n- [ ] A focused test fails if the prose and `datapoints_to_alarm`/`evaluation_periods` diverge.\n- [ ] Terraform format/validate, focused monitoring tests, lint, and typecheck pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/terraform/monitoring_autodeploy.tf","reason":"Align the review-interrupt signal alarm description with its configured 2-of-4 window."},{"path":"tests/unit/test_alarm_actions_terraform.py","reason":"Prevent alarm-description evaluation-window drift."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"open","tags":["terraform","monitoring","documentation","drift"],"ticket_id":"7680-85c7-af0d-416f","ticket_type":"bug","title":"Correct review-interrupt signal alarm description to its 2-of-4 evaluation window","verify_commands":[]},"source_event_uuids":["c2d12a05-36f8-4d89-ac3f-926ad6154283","ad5503be-5c5c-4733-ba80-461720ad0c36","d4da0dce-2650-451a-ac90-5ab2d2322f02"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788601345321321001,"uuid":"38260bb9-0fb7-43ee-a3db-d292720b1f57"}