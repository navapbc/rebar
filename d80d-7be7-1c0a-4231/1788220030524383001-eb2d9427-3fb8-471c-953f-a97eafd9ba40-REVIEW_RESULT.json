e":{"input_tokens":56880,"output_tokens":1664,"requests":4}},{"kind":"success","lineage":{"dependencies":[],"digest":"c7dc6e603082973af263d55d3d1703b6d702df8b4818573bcde1e1a858816777"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":37976,"output_tokens":1768,"requests":4}},{"kind":"success","lineage":{"dependencies":[],"digest":"2f2bc44f7f839afd96e6b4043dd1cf18c1471cd26205482c4ba0e7d79f8efb88"},"namespace_version":1,"reason":null,"unit_id":"agent:T1","usage":{"input_tokens":85252,"output_tokens":2617,"requests":6}},{"kind":"success","lineage":{"dependencies":[],"digest":"5e1423bf645bd3e1ba6dde5e96a9b9ada5d60be564f8eeb3fd058668e0bb757d"},"namespace_version":1,"reason":null,"unit_id":"single:E3,E5,G5,T12,T6,T9,necessity,project.engine-layer-enforcement,project.failure-disposition-contract,project.portability","usage":{"input_tokens":17238,"output_tokens":6430,"requests":1}},{"kind":"success","lineage":{"dependencies":[],"digest":"525862a7c1e553ffe866a11fc137dd4292797e8dd521e0d84232a70e90519f2c"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":157051,"output_tokens":2452,"requests":7}},{"kind":"success","lineage":{"dependencies":[],"digest":"27227407f3a21378547f747e63fe13a4d550c2c058a64d650ae7b75613f837df"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":62334,"output_tokens":2318,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"c02c07c618d9f1a8aa466ed92913c0efc6fad41f366352a6d0cb43e115f35b2b"},"namespace_version":1,"reason":null,"unit_id":"agent:T5c","usage":{"input_tokens":228761,"output_tokens":3787,"requests":7}}],"version":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add tests that assert a follower poll before its index record lands resolves to `attaching` (never `unknown`/missing), and that a dead-daemon-past-grace resolves to `stale-running` (safe re-*_start).","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["E5"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["Test list: 'async-start returns a handle <100ms and poll transitions running→passed/failed; a fresh registry (simulated new container) still resolves the durable verdict.'","AC #5: 'documents all six states ... so an agent never mis-treats the non-terminal attaching follower poll as a terminal/missing result'","No test named for the `attaching` follower state or the `stale-running` crashed-leader state"],"finding":"The test list exercises running/passed/failed and a fresh-registry durable-verdict resolve, but does not cover the two non-terminal / recovery states the plan itself calls load-bearing: `attaching` (follower whose index record has not yet landed — must NOT be read as `unknown`/missing, per AC #5) and `stale-running` (a crashed leader past the grace window resolving to safe re-`*_start`). AC #5 makes the attaching-vs-unknown split safety-critical for MCP-only agents, yet no test proves a follower poll resolves to `attaching` rather than `unknown`, nor that a dead daemon resolves to `stale-running`.","group_criteria":null,"group_id":null,"id":"f400885bfe657e59d","impact":1.0,"is_primary":null,"location":"Fix plan — Tests; Acceptance criteria AC #5","norm_id":"n77307e2c6ceb7da8","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["A follower *_start runs while the leader's index record has not yet landed; without a test, a regression could return `unknown` (missing) instead of `attaching`, and an MCP-only agent coded to the contract would wrongly re-run — the exact mis-treatment AC #5 forbids.","A blue-green flip kills the leader mid-run; without a stale-running test the crashed-leader recovery path (safe re-*_start) is unverified."],"severity":null,"suggested_fix":"Extend test_mcp_gate_async.py: (1) start a leader that blocks, issue a follower *_start, poll before the leader's index write and assert `attaching`; (2) simulate a leader whose daemon is gone past the grace window and assert `stale-running`.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] State a default (and whether it is env-configurable) for the stale-running grace window and the dedup max-age sweep, chosen relative to the ~15-20 min LLM-pass duration.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["E2","T5e"],"decision":"advisory","decision_margin":-0.2137,"drop_reason":null,"evidence":["'index reads running but no daemon past the grace window' — grace window value unstated","'Purge-on-completion + a defensive max-age sweep' — sweep age unstated","Only REBAR_MCP_DEDUP is named as configurable; these two thresholds are neither given a default nor declared configurable"],"finding":"Two thresholds the design depends on — the stale-running 'grace window' and the dedup registry's 'defensive max-age sweep' age — are asserted without a stated default value or derivation, deferring a real tuning decision to the executor.","group_criteria":null,"group_id":null,"id":"f18652d6d2b014c9a","impact":0.67,"is_primary":null,"location":"'Poll status contract' ('no daemon past the grace window') and Phase 1 ('a defensive max-age sweep')","norm_id":"ne274b2384b9ab226","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["Executor picks an arbitrary grace window; too short → healthy long LLM runs mis-declared stale-running and re-run (re-introducing the paid-re-run cost AC#2 fixes); too long → crashed leaders block dedup followers for excessive time"],"severity":null,"suggested_fix":"State the grace window as comfortably longer than the observed ~15-20 min four-pass (e.g. a stated default with an env override), and give the max-age sweep a concrete default; note the grace window must exceed max LLM-pass runtime so a live run is never mis-read as stale.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the failure handling for the verdict git-commit+push leg (retry/surface on push failure) so a blue-green flip cannot land a caller on a container that can't observe an already-completed verdict.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["T5b"],"decision":"advisory","decision_margin":-0.4611,"drop_reason":null,"evidence":["Plan asserts durability 'comes from the git-backed verdict (auto-committed+pushed), not in-process state'","A blue-green flip to a fresh container reads durable state from the pushed remote; if push fails after local commit, the fresh container cannot observe the verdict","No stated retry/error-surfacing for the push step of verdict persistence"],"finding":"The durability guarantee behind AC#4 (an MCP-only client observing completion across a blue-green flip via the git-backed store) does not specify behavior when the auto-commit+push of the verdict fails or partially completes (local commit succeeds, push to remote fails).","group_criteria":null,"group_id":null,"id":"ffd7f7299d0338bb5","impact":0.55,"is_primary":null,"location":"'Approved remediation' / 'Durability across a blue-green flip comes from the git-backed verdict (auto-committed+pushed)' and AC#4","norm_id":"n361d52574f09af8c","priority":0.4889,"reason":"default-advisory","recalled":false,"scenarios":["Verdict signed and committed locally, git push fails (network/auth), then a blue-green flip lands the caller on a fresh container that reads the remote and sees no verdict → caller re-runs a second billable LLM review, defeating AC#2 across the flip"],"severity":null,"suggested_fix":"Specify that verdict persistence retries the push (or surfaces a durable=false / push-pending status) and that the `durable` currency flag on `passed`/`failed` reflects push success, so a follower on a fresh container distinguishes 'committed-but-not-pushed' from 'observed'.","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] State the failure-disposition contract for the sync fallback arm: when the sync tool itself times out (-32001), name the disposition (retryable → poll via *_status vs fatal) and confirm the async in-flight/durable verdict remains the recoverable leg the caller should prefer.","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["project.failure-disposition-contract"],"decision":"advisory","decision_margin":-0.4812,"drop_reason":null,"evidence":["'Sync tools stay as a dedup-protected fallback.'","The sync body is the arm that produced the original 'McpError -32001: Request timed out'","No explicit retryable/transient-vs-fatal disposition word is attached to the fallback arm's own timeout"],"finding":"The plan keeps the synchronous tools as a fallback arm ('Sync tools stay as a dedup-protected fallback'), but never states the failure-disposition contract for that fallback: the sync path is precisely the arm that still hits the original `-32001` request timeout on a long LLM run. The plan does not say, using a disposition word (retryable/transient vs fatal/permanent), what the caller surfaces when the sync fallback itself times out, nor which disposition wins when both the async and the fallback arms are exercised.","group_criteria":null,"group_id":null,"id":"f992b04a924db3bd1","impact":0.67,"is_primary":null,"location":"Approved remediation — Phase 2, 'Sync tools stay as a dedup-protected fallback'","norm_id":"n22db6c88e41c7d33","priority":0.4188,"reason":"default-advisory","recalled":false,"scenarios":["An MCP-only client on an old build (or one that falls back to the sync tool) invokes review_plan sync, hits -32001 again after ~15-20 min; the plan does not state whether that surfaces as a retryable in-flight (poll via *_status) or a fatal error — so the caller may again re-invoke and double-bill despite dedup, or mistake a still-running server for a fatal failure."],"severity":null,"suggested_fix":"Add: 'a sync-fallback -32001 stays retryable — the server keeps running and the durable git-backed verdict is authoritative, so the caller polls *_status rather than re-invoking; the dedup key ensures the re-invoke attaches rather than starting a second run.'","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Reconcile the handle identifier name to a single term (run_id vs job_id) across root-cause, remediation, index path, and poll contract.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["E1"],"decision":"advisory","decision_margin":-0.548,"drop_reason":null,"evidence":["Root cause: 'a {run_id,status:running} handle returned in ms'","Remediation: 'return a {job_id,...,status:running} handle' and 'maps job_id->(ticket,gate,basis)'"],"finding":"The in-flight handle is named inconsistently: the root-cause section describes a `{run_id, status:'running'}` handle mirroring run_workflow, while the remediation and index describe a `{job_id, ..., status:'running'}` handle and `.rebar/gate_runs/<job_id>`.","group_criteria":null,"group_id":null,"id":"fd6baf5a86ec9472f","impact":0.536,"is_primary":null,"location":"'Root cause' ('a {run_id,status:running} handle') vs 'Approved remediation' Phase 2 ('return a {job_id,...,status:running} handle') / '.rebar/gate_runs/<job_id>'","norm_id":"na49ed8a9a556063b","priority":0.402,"reason":"default-advisory","recalled":false,"scenarios":["Implementer/tests reference run_id in one place and job_id in another, or the poll contract keys mismatch the handle keys"],"severity":null,"suggested_fix":"Standardize on `job_id` throughout (matching the `.rebar/gate_runs/<job_id>` index and poll states), noting it mirrors run_workflow's run_id role.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the atomic register-or-attach primitive (lock / CAS / single atomic dict op) guaranteeing exactly-once computation per dedup key with no check-then-act window, and add a test that races two truly-concurrent inserts.","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":-0.615,"drop_reason":"novelty","evidence":["'an in-process singleflight registry (a second concurrent caller for the same key awaits the SAME computation and shares its verdict)'","No lock/CAS/atomic-insert primitive is named for the register-or-attach transition"],"finding":"The Phase-1 singleflight registry is shared mutable in-process state whose register-or-attach step is a classic check-then-act: two truly-concurrent callers for the same dedup key must be guaranteed to result in exactly one computation. The plan describes the intended behavior ('a second concurrent caller for the same key awaits the SAME computation') but never names the atomicity mechanism (lock / CAS / atomic dict operation) that makes the register-or-join race-free — leaving a TOCTOU window where both callers observe 'no entry' and both start a billable run, defeating AC #2.","group_criteria":null,"group_id":null,"id":"fd35f7a00f429ef71","impact":0.67,"is_primary":null,"location":"Approved remediation — Phase 1; src/rebar/_mcp_inflight.py","norm_id":"n9413ab80efab18f9","priority":0.335,"reason":"default-advisory","recalled":false,"scenarios":["Two MCP callers issue review_plan for the same ticket+basis within the same millisecond; if the check (is-key-present) and the act (register-entry) are not atomic, both see absent, both register, both start a paid LLM run — the exact double-billing AC #2 is meant to prevent."],"severity":null,"suggested_fix":"Specify a per-key lock (or an atomic setdefault-style insert) so the loser of the race attaches to the winner's future rather than starting its own run; add a concurrency test that starts both callers before the fake begins.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify the retirement/cleanup path for `.rebar/gate_runs/<job_id>` index records (e.g. an age/completed-based sweep mirroring .rebar/workflow_runs/), or state explicitly why unbounded growth is acceptable.","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":-0.7437,"drop_reason":"novelty","evidence":["'A git-ignored .rebar/gate_runs/<job_id> index (mirroring .rebar/workflow_runs/) maps job_id→(ticket,gate,basis).'","Purge/sweep is stated only for the registry ('Purge-on-completion + a defensive max-age sweep'), not for the on-disk index"],"finding":"Phase 2 creates a persistent on-disk shared-state artifact — the git-ignored `.rebar/gate_runs/<job_id>` index mapping job_id→(ticket,gate,basis) — but the plan states no RETIRE/cleanup path for these index records. The in-process registry gets 'purge-on-completion + a defensive max-age sweep', yet the durable per-job index files have no stated pruning, so they accumulate one entry per gate run indefinitely.","group_criteria":null,"group_id":null,"id":"f41f67ba73ecf650d","impact":0.33,"is_primary":null,"location":"Approved remediation — Phase 2; '.rebar/gate_runs/<job_id> index'","norm_id":"nf07a1a2a35f5e9bf","priority":0.2063,"reason":"default-advisory","recalled":false,"scenarios":["A long-lived server or a busy repo accumulates thousands of .rebar/gate_runs/<job_id> files over time with no cleanup, leaking disk and slowing any directory scan."],"severity":null,"suggested_fix":"Mirror workflow_runs' cleanup policy: prune index entries once a durable verdict is confirmed persisted (or past a max-age), and document the sweep trigger as operation-linked (not CI-linked).","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternativ