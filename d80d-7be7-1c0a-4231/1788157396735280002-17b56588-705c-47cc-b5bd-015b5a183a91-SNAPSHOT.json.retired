{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788157396735280002,"compiled_state":{"alias":"jeanlike-hick-azurevase","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: d80d-7be7-1c0a-4231","material: b42b56a58d8b1e26","material-part: children 647ea2107ca5072f 0","material-part: description c8025f7b1ed97477 7195","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact cd004198f59f7602 8","material-part: ticket_id 3ed399c64be1d9fe 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 13","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:c543007d0a464ad5c6c271a26449038b1195a949","dep d9f21f3165fe5b37b9376df0b356f36d59fe1b6515ed70fe97c1a2d7d1a6f1e7 docs/mcp-reference.md","dep 65f1f94be9d1c55ee1b79ee77359305f706a5cf3a29f1e83ee45788e526f071d docs/plan-review-gate.md","dep absent src/rebar/_mcp_inflight.py","dep 28293f7f6e740619aea9d8ef27256773d0b7cb822808033bbd5b427f020854f0 src/rebar/_mcp_llm.py","dep d2a0b09cc9c5f0a070fe98de62a95afe060184275a6cafe1f07ab3ffeb1856cc src/rebar/_mcp_models.py","dep ee0e32b13ea6116337016ed25faba8a6f13188280df2da19d5faa27555fc1030 src/rebar/_mcp_reads.py","dep 56728b9c2937e0764f1f9431346e5a8b7fbd8d75f23b15d6cdd8b4b09da1b0e0 src/rebar/_mcp_writes.py","dep absent src/rebar/llm/gate_runs.py","read-set: 14","read-path: AGENTS.md","read-path: docs/mcp-reference.md","read-path: scripts/gen_mcp_reference.py","read-path: src/rebar/_config_schema.py","read-path: src/rebar/_mcp_health.py","read-path: src/rebar/_mcp_llm.py","read-path: src/rebar/_mcp_models.py","read-path: src/rebar/_mcp_reads.py","read-path: src/rebar/_mcp_writes.py","read-path: src/rebar/llm/completion.py","read-path: src/rebar/llm/plan_review/attest_gate.py","read-path: src/rebar/llm/workflow/runs.py","read-path: src/rebar/mcp_server.py","read-path: tests/unit/test_gen_mcp_reference.py","currency-basis: file_impact"],"material_fingerprint":"b42b56a58d8b1e26","merged_log_commit":"c543007d0a464ad5c6c271a26449038b1195a949","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1788147696666741208}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":18,"unsigned":0},"authorship_ledger":[{"content_hash":"40c527a524ae155b4adeb0b5604ad1b8cfd179dbb3b64194a3be7acc007cd144","event_uuid":"6fa19400-c3da-45d9-bb31-863bdee7b518","position":{"commit_sha":"d2b5f03ee9cc57a976f23109cdc074e0973d428d","position":"1788135191396268489-6fa19400-c3da-45d9-bb31-863bdee7b518"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a2f6d2a4dd02ddb4bcaa62162cdc243fba23314c8a5f63787bc6c96393df5576","event_uuid":"4e149a77-9711-43b8-ba89-fec4dc4c0726","position":{"commit_sha":"13c917815080f1e739642c2adaf868a3a7330992","position":"1788137390494360111-4e149a77-9711-43b8-ba89-fec4dc4c0726"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5d8ee1c42458234fab6e18c6a844e4c487d036fda1601f10e2b8ff92f8ac9fd0","event_uuid":"3f528afe-43b7-4276-8362-a1dce045fd46","position":{"commit_sha":"5e022c81933c680ffe7c8f549f6782e0f5314cab","position":"1788137564831106476-3f528afe-43b7-4276-8362-a1dce045fd46"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f3346c39d7e7c36285fa9fd4dafd1bd87d438f7bc3d399ee8de6d55162c1f6aa","event_uuid":"b1895f39-7d8e-4483-acbe-8a731c14efa8","position":{"commit_sha":"f4dba3698666b626d664f6dc2ea938a13694bcc7","position":"1788146868838617744-b1895f39-7d8e-4483-acbe-8a731c14efa8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f38196a65aa5fe403f7f86202f891cf366221aabe390049f8693b1f87ed63cef","event_uuid":"c8605043-55a3-406a-a886-2062fade0d8b","position":{"commit_sha":"d55e897fd29fe95354eb023f5083df9c44646a2d","position":"1788146941487979179-c8605043-55a3-406a-a886-2062fade0d8b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1984ef471dc416899e7ef19639c1b24fecdcb96674edae8f8284b21eda41dfe6","event_uuid":"a367677d-dd0d-4a57-b9cf-76e0a90725d2","position":{"commit_sha":"77ee7e09bb7870703a3a10bc9cead44c27a343d1","position":"1788146941761334270-a367677d-dd0d-4a57-b9cf-76e0a90725d2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"740d4c776738058f7da849ffc7aa63a4c06c46f53413ab44532dcc2afa3f6582","event_uuid":"5297d8c0-1a96-42ef-9af9-b0ca12bb513b","position":{"commit_sha":"b550fb8191e02b29b889be922e2797a5d6fd14f4","position":"1788147318290949180-5297d8c0-1a96-42ef-9af9-b0ca12bb513b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.autho