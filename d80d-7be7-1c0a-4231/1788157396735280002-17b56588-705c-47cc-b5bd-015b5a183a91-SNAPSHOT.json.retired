\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"309aa460d52d8c8798c2b2271493612d003a1f0e484823f9cb71044a770a2fa8","event_uuid":"68f7407f-38a8-4ab1-acf7-b1a546d92c1e","position":{"commit_sha":"085f51de8a03d069c9fcb842d8cb9856f9439fb0","position":"1788153122114636001-68f7407f-38a8-4ab1-acf7-b1a546d92c1e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"89555cfa14607cac8c76a69d7ea97bee9e7d1fe691f74a4def50dbf68a262ec0","event_uuid":"4835bafa-334d-4fdd-a5c8-0de5c49c254e","position":{"commit_sha":"63d99d4deb8cbeaf1949ff38ca2531b361897578","position":"1788153728861468628-4835bafa-334d-4fdd-a5c8-0de5c49c254e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"50e267344c8958ac7a44edd5ce06fc54f4e145e84027ea19ec7d79685a9dd4c1","event_uuid":"0e857160-8a6d-4176-b654-e06f9f85cae8","position":{"commit_sha":"634764e1811a9f4bf3101325bd9b0c3f74698be2","position":"1788154401420715937-0e857160-8a6d-4176-b654-e06f9f85cae8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1555a96713bbeb65c959f1ed607e78b5bd08f1eda47d6d8dcb4da0e7c2c64ba4","event_uuid":"5f3f15f4-0d08-449a-854d-c28377af6379","position":{"commit_sha":"0be33cd57903c470d45b92cc2a19cbc337eac021","position":"1788155627148184001-5f3f15f4-0d08-449a-854d-c28377af6379"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ba4c6679af0caa1723d563d541beda6da866ed008931db804a691820fa901ee9","event_uuid":"b9b28316-0088-426a-8364-15c1b7501a01","position":{"commit_sha":"e038fd6cc7b804ec722725a99394f5c55b838e81","position":"1788156228021695979-b9b28316-0088-426a-8364-15c1b7501a01"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"532cf75e3516b542000d77cba35b7807c5ff7e973264fe2c6a73fb76a559f1ad","event_uuid":"396896fa-c387-4e5a-b19e-d0f87d0a4b03","position":{"commit_sha":"87abd011aea082fe142c22eb544a54a0d4a9474a","position":"1788157396735280001-396896fa-c387-4e5a-b19e-d0f87d0a4b03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Prior-art research complete (OSS/spec survey; full briefing archived in session files). Findings:\n\nCONFIRMED MECHANISM (not yet a code root-cause proof, but strong): the `-32001 Request timed out` is raised by the MCP CLIENT SDK, not rebar's server. TS SDK default request timeout = 60s (`DEFAULT_REQUEST_TIMEOUT_MSEC = 60_000`, `resetTimeoutOnProgress` defaults FALSE). Python SDK (rebar's `mcp>=1.28.1,<2`) uses a single `anyio.fail_after(timeout)` window with NO progress-based reset in v1.x OR v2. rebar's server side is `anyio.fail_after(None)` = no deadline, so it keeps running + signs the op-cert after the client disconnects → the unknown-state + duplicate-paid-run symptoms.\n\nWHY OPTION (c) keepalive/progress is NOT viable for a 15-20 min op:\n- Python SDK has no `resetTimeoutOnProgress` (v1.x or v2); progress notifications do not extend the client deadline.\n- Spec (2026-07-28) guidance is only \"MAY reset timeout on progress, SHOULD cap anyway\" — optional client behavior, not reliable.\n- SSE resumability (`Last-Event-ID`) was REMOVED in 2026-07-28: any SSE break (nginx proxy_read_timeout, keepalive_timeout, blue-green flip) forces a re-issue with a NEW request id, which without dedup launches a 2nd billable run.\n- Closing the SSE stream IS cancellation per spec; a well-behaved client closes on timeout.\n\nRECOMMENDED (Option b) async job+poll via the official `io.modelcontextprotocol/tasks` extension: initial tools/call returns a taskId in ms (inside any client timeout); client polls `tasks/get`; `Mcp-Name: {taskId}` header enables nginx sticky routing to the process holding job state — the spec's own answer to rebar's nginx topology. Only active OSS reference impl found: mattzcarey/durable-mcp-server (Cloudflare DO, single-maintainer).\n\nIN-FLIGHT DEDUP (addresses the cost-amplification directly, spec is silent so it's app-level): singleflight-style registry keyed on `(ticket_id, gate_type, basis_ref)`. A 2nd call for the same key while a job runs attaches to the existing run instead of launching a 2nd paid LLM pass. Pure in-process — no CI dependency (portable), no client-capability dependency, no wire-protocol change. This is separable from and shippable before the full tasks migration.\n\nBLOCKERS/CAVEATS for the full (b): (1) rebar is on mcp v1.x (2025-03-26 wire protocol); tasks extension is v2-era — implementable manually in v1.x via the `add_response_router` seam or via a v2 migration. (2) Client capability unverified — must confirm Claude/Cursor declare `io.modelcontextprotocol/tasks` or the server must return `-32021` + need a sync fallback. (3) Blue-green durability needs an externalized task store (SQLite/Redis); the dedup registry itself can stay in-process.\n\nProposed phasing: Phase 1 = singleflight dedup (kills duplicate paid runs + gives a deterministic in-progress signal; document `review-plan --status` as the true-state recovery read). Phase 2 = full async job+poll (fixes the transport timeout at root), gated on verifying client tasks-capability. Escalating the phasing + scope decision to the operator.","timestamp":1788135191396268489},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Design spike: in-flight dedup (Phase 1) + async job/poll (Phase 2) — designed to land together\n\nFull design archived at session file `q1_mcp_timeout_design.md`. Grounded in the actual MCP server code + the installed `mcp 1.28.1` package + the prior-art briefing.\n\n### Decisive grounding finding\n**rebar ALREADY ships the async job+poll pattern we need**: `run_workflow` (`src/rebar/_mcp_writes.py:539`, an `async def` tool) returns `{run_id, status:'running'}` immediately, runs on a **background daemon thread** (\"survives client request timeouts\"), persists run-state to the ticket's git-backed event log, and is polled via `get_workflow_status`/`get_workflow_result` (`_mcp_reads.py:531/543`) — using **plain MCP tools, no tasks wire extension, no client capability**. Phase 2 mirrors it. Also: `plan_review_status` (`_mcp_reads.py:179`, no-LLM durable read) already IS the plan-review poll endpoint, and `REVIEW_RESULT`/`COMPLETION_VERDICT` sidecars already persist verdicts durably.\n\nThe two tools to change: `verify_completion` `_mcp_llm.py:151`, `review_plan` `_mcp_llm.py:205` (sync `def`s returning a dict).\n\n### Phase 1 — singleflight (no wire change)\n- **Semantics: golang singleflight (second concurrent caller awaits the SAME future, gets the SAME verdict)**, NOT Stripe 409-immediate — because under the current *synchronous* contract there is no handle to poll, so an \"already running\" return gives the agent nothing to attach to. Singleflight meets AC#2 the instant the 2nd caller is de-duped (zero extra LLM spend), even if that caller's SDK already 60s-timed-out.\n- **Key** = `sha256(gate_type · canonical_ticket_id · basis_ref · variant · readonly)` where `basis_ref` = the **resolved commit SHA** of the effective review ref (default origin/main), resolved the same way the gate binds `verified_at_sha` — NOT the symbolic ref, so a moved base = a new key = a legitimate re-review, never wrongly blocked. `force=True` bypasses dedup.\n- **Registry**: process-local `dict` + `asyncio.Lock`; tool bodies become `async def`, run the blocking gate via `anyio.to_thread.run_sync`. New leaf module `src/rebar/_mcp_inflight.py`.\n- **TTL = purge-on-completion** (key lives only for the in-flight window). No time TTL needed for correctness (changed ticket → different SHA → different key); a defensive ~40min max-age sweep reclaims a crashed run's key. Directly answers \"not blocked forever.\"\n\n### Phase 2 — async handle + poll; the three blockers RESOLVED\n- **(a) v1.x SDK vs `io.modelcontextprotocol/tasks`:** the experimental machinery IS installed (`enable_tasks`, `run_task`, `add_response_router`) but is **(i) deprecated + slated for REMOVAL in mcp 2.0** (`mcp/server/lowlevel/server.py:248`: \"tasks (SEP-1686) were removed\") and **(ii) NOT reachable through FastMCP** (`Context` has no `.experimental`; FastMCP wraps returns into `CallToolResult`, can't emit `CreateTaskResult`). → **Recommend the app-level `run_workflow`-style pattern** (plain MCP tools). Adopt the standard extension only as a future v2 migration (escalation).\n- **(b) client capability / fallback:** app-level = ordinary tools ⇒ **no `-32021`, no negotiation**. No static `.mcp.json` in-repo; clients are agents steered by AGENTS.md/docstrings. Fallback = keep the **synchronous tools as-is** (now Phase-1 dedup-protected so retry-after-`-32001` no longer double-charges); document `*_start`+poll as the long-op path. AC#4 (no checkout): the poll is an MCP tool reading the ticket event log, so an MCP-only hosted agent observes completion.\n- **(c) blue-green durability:** the **verdict is durable on the git-backed event log** (survives flips via replay) — no new dependency. The in-process registry + daemon thread do NOT survive a flip and (per the existing `stateless_http=True` design at `build_server`) must not be relied on to; a flip that kills an in-flight run costs **at most one re-run** (bounded). Keep the registry in-process; put the job index + verdict on the git store (reusing `.rebar/workflow_runs`-style local pointer + existing sidecars). Hard cross-flip dedup via a box-local WAL SQLite (à la `review_bot/dedup.py`) is flagged but **not** recommended now.\n\nNew tools: `review_plan_start` / `verify_completion_start` (return `{job_id, ticket_id, gate_type, basis_ref, status:'running'}`), poll via existing `plan_review_status` + new `verify_completion_status` (or one generic `gate_status`). Phase 2 attaches to the SAME registry, so async-start of an in-flight op returns the existing `job_id` (Stripe-style attach — now possible with a handle).\n\n### file_impact / sequencing\n`_mcp_inflight.py` (new, P1), `_mcp_llm.py` (wrap P1 + `_start` P2), `_mcp_reads.py` (`*_status` P2), `_mcp_models.py` (P2), optional `llm/gate_runs.py` (P2), `docs/mcp-reference.md` + `docs/plan-review-gate.md` (P2), `tests/unit/test_mcp_inflight.py` (new) + `test_mcp_llm.py`.\n**Two reviewable commits, Phase 1 first** (no wire change, immediate cost-stop, independently valuable) → Phase 2 stacked. Land as a stacked pair on a server-side feature branch if driver rights exist, else two changes through `refs/for/main` in dependency order.\n\n### Test (deterministic, zero tokens)\nMonkeypatch `rebar.llm.review_plan`/`verify_completion` with a fake that **blocks on a `threading.Event`** + counts calls. Two concurrent same-key invocations → assert fake called **exactly once**, both get the same verdict (AC#2 proof). Different `basis_ref` → two calls. Post-completion re-call → count increments (not-blocked-forever). Async: `_start` returns in <100ms while fake blocks; poll transitions running→terminal; `_start` for in-flight returns same `job_id`. Blue-green: fresh registry still resolves the durable verdict.\n\n### Rollback / portability\nAdditive + flag-guarded: dedup wrap default-on with kill-switch `REBAR_MCP_DEDUP=0`; rollback = config flip or revert (no schema/data migration; verdict events are reducer-ignored + self-pruning). **Portable:** pure in-process MCP logic over the git store, zero CI-provider coupling; poll reads the event log over MCP (satisfies `project.portability` + AC#4).\n\n### Operator escalations (go/no-go)\n1. Defer the standard `io.modelcontextprotocol/tasks` extension to a future v2 migration (installed v1.x machinery is removal-marked + FastMCP-unreachable).\n2. No new external dependency for cross-flip dedup (in-process registry + git-backed verdict; a flip costs ≤1 re-run). Flag if hard cross-flip dedup wanted (box-local SQLite).\n3. New tool surface naming (`*_start` + `*_status`/`gate_status`); separate `_start` tool vs async `mode=` param.\n4. Default-on dedup wrap (behavior change: a 2nd concurrent call attaches instead of launching) + kill-switch env name.\n5. Guidance change: steer agents (AGENTS.md/docstrings) to prefer `*_start`+poll for long gate ops.\n","timestamp":1788137390494360111},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"LIVE CORROBORATION (this session): a `transition_ticket` bug close (edeb → closed, close_class=duplicate) triggered the completion-verifier gate and the MCP call returned `-32001 Request timed out` — yet a follow-up `show_ticket` confirmed the ticket IS `closed`. The server completed and signed the close after the client gave up. Identical mechanism to the review_plan case.\n\nSCOPE EXPANSION for the fix: the timeout is NOT limited to the explicit `review_plan`/`verify_completion` MCP tools. Any MCP write that internally runs a long LLM gate hits it — notably `transition_ticket` when the completion-verifier close gate fires (bug close, or claim/close on a gated ticket). The Phase-1 dedup and Phase-2 async/poll design must cover the gate-bearing transition paths (`_mcp_writes.py` transition), not only the `_mcp_llm.py` gate tools. A duplicate/administrative bug close apparently still runs completion verification (~9-11 min), so even administrative closes are exposed.\n\nRecovery that worked here: a read-back (`show_ticket`, or local `rebar show`) confirms the true post-write state after a timed-out gate-bearing write — the same \"read the durable state\" recovery the async design formalizes.","timestamp":1788137564831106476},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## DESIGN RESOLVED — 2026-08-30 (operator-approved)\n\nThe Q1 design spike is complete and all five design decisions are approved. Remediation is a two-phase app-level fix that reuses rebar's existing `run_workflow` async-job pattern — **no** MCP `tasks` wire extension, **no** new dependency, **no** client-capability negotiation.\n\nApproved decisions (grounded in ticket history + OSS prior art):\n1. **Defer the standard `io.modelcontextprotocol/tasks` extension.** The installed SDK (`mcp 1.28.1`, `<2`) ships only the *deprecated/removal-marked* experimental tasks API, and FastMCP can't reach it. Use rebar's shipped app-level job+poll pattern (`run_workflow`→`get_workflow_status`) now; adopt the standard wire extension in a future v2 SDK migration. (OSS: no widely-maintained Python MCP server does async jobs yet; GitHub/Playwright MCP all run sync tools.)\n2. **No new external store for cross-flip dedup.** In-process singleflight registry + git-backed durable verdict. A blue-green flip costs at most ONE re-run (bounded, unavoidable), consistent with `stateless_http=True`. The SQLite path (`review_bot/dedup.py`) stays available if hard cross-flip dedup is ever wanted. (OSS: Go `singleflight` purges its key on completion, in-process by design.)\n3. **Separate `*_start` + `*_status` verbs**, mirroring `run_workflow`/`get_workflow_status`; reuse existing `plan_review_status`; add `verify_completion_status` (or generic `gate_status`). (OSS: MCP tasks, k8s `--watch`, GH Actions API all separate start from poll.)\n4. **In-flight dedup default-ON with kill-switch `REBAR_MCP_DEDUP=0`.** A concurrent duplicate call attaches to the in-flight run instead of launching a second billable LLM pass; `force=True` bypasses. Directly closes AC #2.\n5. **Guidance update** (AGENTS.md + tool docstrings) steering agents to `*_start`+poll for long gate ops; the sync tools remain as a now-dedup-protected fallback.\n\nSequencing: **Phase 1** (singleflight dedup wrap — the immediate cost-stop, no wire change) lands FIRST as its own commit; **Phase 2** (additive `*_start`/`*_status` tools) stacks on it. Both reference this ticket. Full design: session artifact `q1_mcp_timeout_design.md`.","timestamp":1788146868838617744},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit -1 round addressed; re-pushed both patchsets (Change-Ids preserved).\n\nChange 2457 (Phase 1) -> PS2 ba9e093b9c7c:\n- BLOCKING (Verified-1, docs drift): regenerated docs/mcp-reference.md on the Phase-1 tree. Took Option (a): STRIPPED the *_start steering from the sync review_plan/verify_completion docstrings so Phase 1 no longer references tools that don't exist until Phase 2; mcp-reference now matches Phase-1 code (gen --check clean, 0 *_start refs).\n- BLOCKING (LLM-Review-1, coverage): test_mcp_llm_dedup.py now parametrizes BOTH review_plan AND verify_completion (distinct variant key) through the tool-level singleflight. Also made the proof deterministic: release the leader only once a REAL follower attaches (spy on _await_follower) with a bounded fallback, since the first CallTool's cold pydantic warm-up blocks the loop and made the fixed-sleep window racy. Teeth: with REBAR_MCP_DEDUP=0 the test fails cleanly (calls==2) in ~6s, no hang.\n- Advisories: tightened the _mcp_inflight max-age comment (no longer over-claims 'nothing blocked forever'); steering ordering fixed by Option (a).\n\nChange 2459 (Phase 2) -> PS2 9b528c36c18b:\n- BLOCKING (LLM-Review-1, correctness): verify_completion_status now reads the LIST-shaped manifest via _authoritative_manifest/_authoritative_head (mirroring plan_review_status) instead of the dead isinstance(manifest, dict) guard, so verified_at_sha is populated. Added two tests (pinned verified-at-sha step; fallback to signed head). Teeth verified: both fail with the old dead branch.\n- Advisories fixed: (1) follower *_start (is_new=False) no longer re-records a 'running' handle -> can't clobber a leader's terminal record; (2) the async *_start bodies now offload _start_gate_job (basis-SHA git shell-out + index write) via anyio.to_thread so they don't block the event loop; (3) added _terminal_from_result branch tests (error->failed, PASS/BLOCK->passed) and a daemon-exception->failed test.\n\nmake lint + make typecheck green on BOTH trees; output-schema coverage green. Not submitting/closing (orchestrator's step once votes go green).","timestamp":1788153122114636001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Change 2459 (Phase 2) re-pushed as PS3 (5814d054022c). Fixed both blocking findings: (1) tri-state regression — verify_completion_start restored to 'graph: bool | None = None'; the None default now threads through the body AND the dedup variant key, so start/sync hash to identical variant 'graph=None;source=attested' (new test test_verify_completion_start_preserves_graph_tristate_and_variant_key; teeth confirmed: reverting to 'graph: bool = False' fails with '[False, None]' collapse). (2) ARG ratchet — removed unused 'repo_root' param from gate_runs._resolve_status; 'ruff check --select ARG src/rebar' now 25 residuals (<=25), arg-sweep heldout test green. Advisories done: removed dead module-level logger in _mcp_llm.py; record_gate_run now uses atomic_write (temp+os.replace). Also de-flaked test_review_plan_start_returns_a_handle_fast (fail_after(3) for teeth + <2s cold-start-tolerant bound; 3/3 green). make lint + make typecheck green (via pre-commit hook). Phase 1 (2457 PS2) untouched. Awaiting re-review.","timestamp":1788155627148184001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Change 2459 (Phase 2) re-pushed as PS4 (a8c47a6e6057), now rebased directly onto merged P1 (22d4d4fc) — unstacked. Fixed the blocking LLM-Review finding: verify_completion_status no longer reports 'certified' off a bare HMAC verify. It now loads ticket state (_reads.show_ticket) and routes the verdict/ok/reason through compute_validity(sig, state, 'completion-verifier'), structurally identical to how plan_review_status defers to claim_gate_check. A STALE/REOPENED completion attestation now reports its lifecycle verdict (stale-reopened / stale-material / not-closed) instead of a false 'certified'. This also fixes gate_status's 'durable' field, which reads through the same function. Teeth: new test test_verify_completion_status_reports_stale_for_a_reopened_attestation is RED against the bare-sig code (reads certified/ok) and GREEN after routing through compute_validity (verdict=stale-reopened, ok=False). Coverage advisories done: (1) test_gate_status_surfaces_the_durable_completion_verdict asserts durable present+certified for a completion job; (2) test_gate_status_within_grace_window_still_reads_running covers the in-grace branch of _resolve_status; (3) test_follower_start_does_not_reclobber_the_leaders_index_record directly asserts the is_new guard (leader records 'running' once; a follower during in-flight records nothing). Updated the two verified_at_sha tests to supply a closed ticket state. make lint + make typecheck green; complexity new=0 increased=0; ARG ratchet 25; module sizes 226/573<800; no docs/mcp-reference.md drift. 21 gate-async tests + dedup + schema-coverage suites green. Awaiting re-review.","timestamp":1788157396735280001}],"created_at":1788133986631408873,"creation_channel":"mcp","deps":[{"link_uuid":"46946bae-8c4c-4cb1-a4f5-6eb9f349db8b","relation":"relates_to","target_id":"e559-fe41-9edd-47c2"},{"link_uuid":"fb6f8c2c-f258-42e6-95c5-d9300ef732d9","relation":"relates_to","target_id":"7b04-2057-d5d4-4e60"},{"link_uuid":"4835bafa-334d-4fdd-a5c8-0de5c49c254e","relation":"relates_to","target_id":"0b2b-635d-e644-4fbb"},{"link_uuid":"0e857160-8a6d-4176-b654-e06f9f85cae8","relation":"relates_to","target_id":"29b3-6847-937d-4470"},{"link_uuid":"b9b28316-0088-426a-8364-15c1b7501a01","relation":"relates_to","target_id":"41e6-e080-e5c8-4a7e"}],"description":"## Summary\n\nCalling the long-running certified gate op `review_plan` (and, by the same mechanism, `verify_completion`) through the **rebar MCP server** — the path AGENTS.md *mandates* for tracker/gate ops — returns an opaque transport error (`McpError -32001: Request timed out`) whenever the operation runs long enough to reach its LLM passes. The server keeps running and eventually signs the attestation, but the **client is given no completion signal and no job handle**, so from the caller's side the ticket is left in an *unknown state*.\n\n## Why this is higher-severity than \"observability\"\n\n1. **Unknown ticket/gate state.** The caller cannot tell \"still running\" from \"failed\" from \"succeeded\". The verdict (PASS/BLOCK/attestation) is lost to the caller even though it exists server-side.\n2. **Paid-API waste from re-runs.** The natural agent response to `-32001` is to re-invoke `review_plan`. If the first run is still in flight, the re-invocation starts a SECOND billable multi-call LLM review (Bedrock/Anthropic). Nothing tells the agent the first is still running. This can multiply cost per ticket without bound under retry loops.\n3. **Mandated path.** Agents are directed to route gate ops through MCP; the local-CLI recovery (`review-plan --status`) is a carve-out, not something an MCP-only client (e.g. a hosted agent with no checkout) can reach.\n\n## Reproduce / actual / expected\n\nRepro (observed 2026-08-30, ticket 71b5-1ceb-131a-422d):\n1. `review_plan` over MCP on a plan that passes the deterministic P1–P11 floor (so it proceeds to the LLM four-pass, ~15–20 min per the gate-duration guidance).\n2. Actual: client receives `McpError -32001: Request timed out`. Server completes and signs. `rebar review-plan <id> --status` (local) later shows a signed op-cert (here `foreign_key` — signed by the MCP env `9f1c…`, distinct from the local CLI env `b8a3…`), confirming the review PASSED and no work was lost.\n3. Expected: the caller receives either the verdict, or a durable **job handle / in-progress token** it can poll — and a re-invocation while a review is in flight must NOT start a second billable run.\n\n## Root cause (proven — Q1 spike)\n\nThe `-32001` is a **client-side** SDK timeout (TS SDK `DEFAULT_REQUEST_TIMEOUT_MSEC=60000`, `resetTimeoutOnProgress=false`; Python SDK a single `anyio.fail_after` with no progress reset). rebar's server runs the gate under `anyio.fail_after(None)`, so it COMPLETES and signs after the client has already given up — hence keepalive/progress alone cannot be the primary fix, and the durable verdict already exists server-side. rebar already ships the correct app-level answer: `run_workflow` (`_mcp_writes.py`) returns a `{run_id,status:'running'}` handle in ms on a background daemon thread and persists to the git-backed event log, polled by `get_workflow_status`/`get_workflow_result`; `plan_review_status` (`_mcp_reads.py`) is already a no-LLM/no-network poll of durable attestation state.\n\n## Approved remediation — 2026-08-30 (design resolved; see DESIGN RESOLVED comment)\n\nTwo-phase app-level fix reusing the shipped `run_workflow` pattern. No MCP `tasks` wire extension, no new dependency, no client-capability negotiation.\n\n- **Phase 1 (own commit, lands FIRST — the immediate cost-stop, no wire change):** a new leaf module `src/rebar/_mcp_inflight.py` — an in-process singleflight registry (golang `singleflight` semantics: a second concurrent caller for the same key awaits the SAME computation and shares its verdict). Dedup key = `sha256(\"\\0\".join([gate_type, canonicalised ticket_id, resolved 40-hex basis SHA, variant, readonly]))`. `force=True` bypasses dedup. Purge-on-completion (correctness needs no TTL) + a defensive max-age sweep. Default-ON with kill-switch env `REBAR_MCP_DEDUP=0`. The sync `review_plan`/`verify_completion` bodies in `_mcp_llm.py` are wrapped by it (async def + `anyio.to_thread`).\n- **Phase 2 (stacks on Phase 1):** additive async surface — `review_plan_start` / `verify_completion_start` (return a `{job_id,…,status:'running'}` handle in ms; run on a background daemon thread exactly like `run_workflow`; verdict persists to the durable event log so it survives a blue-green flip). Poll via the existing `plan_review_status` plus a new `verify_completion_status` (or a single generic `gate_status`). A git-ignored `.rebar/gate_runs/<job_id>` index (mirroring `.rebar/workflow_runs/`) maps job_id→(ticket,gate,basis). The sync tools stay as a now-dedup-protected fallback. AGENTS.md + docstrings + docs/mcp-reference.md + docs/plan-review-gate.md steer agents to `*_start`+poll for long ops.\n\nDurability across a blue-green flip comes from the git-backed verdict (auto-committed+pushed), not from in-process state (`stateless_http=True` by design). A flip that kills an in-flight run costs at most one re-run; a `run_finished` marker in a `finally` + a `stale-running` status read bound the worst case.\n\n## Fix plan — file impact\n\nPhase 1: `src/rebar/_mcp_inflight.py` (new leaf), `src/rebar/_mcp_llm.py` (wrap sync bodies), `tests/unit/test_mcp_inflight.py` (new). Phase 2: `src/rebar/_mcp_llm.py`/`_mcp_writes.py` (`*_start`), `src/rebar/_mcp_reads.py` (`verify_completion_status`/`gate_status`), `src/rebar/_mcp_models.py` (output models), optional `src/rebar/llm/gate_runs.py`, `docs/mcp-reference.md`, `docs/plan-review-gate.md`. Respect module-size (200–500 target / 800 cap / ≥100 LOC new) + the complexity ratchet (extract along seams; never bump the baseline).\n\nTests are deterministic and token-free: monkeypatch `rebar.llm.review_plan`/`verify_completion` with a fake that blocks on a `threading.Event`; two concurrent same-key calls ⇒ fake called exactly once, both get the same verdict (AC #2 proof); different `basis_ref` ⇒ two calls; post-completion re-call re-invokes; async-start returns a handle <100ms and poll transitions running→passed/failed; a fresh registry (simulated new container) still resolves the durable verdict.\n\n## Acceptance criteria\n\n- [ ] `review_plan`/`verify_completion` over MCP no longer leaves the caller with an opaque transport timeout and no state: the caller receives either the verdict or a pollable in-progress signal/handle.\n- [ ] A re-invocation while a review for the same ticket+basis is in flight attaches to that run and does NOT start a second billable LLM review (idempotent / in-flight de-duplication), with a test proving no second run is launched.\n- [ ] The chosen contract (start+poll) is documented for MCP-only clients in docs/mcp-reference.md / docs/plan-review-gate.md.\n- [ ] Portable: the mechanism does not depend on the local checkout being present (an MCP-only client can observe completion). In-process MCP-server logic over the git-backed store — no CI-provider coupling; satisfies project.portability.\n\n## Attribution\n\nTo be recorded on close via `--caused-by`: the introducing change is whichever work exposed `review_plan`/`verify_completion` as synchronous MCP tools without an in-flight/progress contract (determine from `git log`/blame on `_mcp_llm.py`'s tool registration). Owner domain: MCP. Likely `--class=plan_defect` (the tool was shipped sync without an in-flight contract) — confirm during implementation.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_mcp_inflight.py","reason":"Phase 1: new in-process singleflight dedup registry (key derivation, singleflight wrapper, purge-on-complete + max-age sweep, kill-switch)"},{"path":"src/rebar/_mcp_llm.py","reason":"Phase 1: wrap review_plan/verify_completion sync bodies with singleflight. Phase 2: add review_plan_start/verify_completion_start"},{"path":"src/rebar/_mcp_reads.py","reason":"Phase 2: add verify_completion_status (or generic gate_status) poll tool; plan_review_status already exists"},{"path":"src/rebar/_mcp_writes.py","reason":"Phase 2: optional home for the *_start async job tools (mirrors run_workflow)"},{"path":"src/rebar/_mcp_models.py","reason":"Phase 2: output models for the start handle and status read"},{"path":"src/rebar/llm/gate_runs.py","reason":"Phase 2 (optional): .rebar/gate_runs/<job_id> index + run_started/run_finished recorder mirroring llm/workflow/runs.py"},{"path":"docs/mcp-reference.md","reason":"Phase 2: document *_start/*_status tools and the dedup contract (AC #3)"},{"path":"docs/plan-review-gate.md","reason":"Phase 2: document the async gate contract for MCP-only clients (AC #3)"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","0b2b-635d-e644-4fbb"],["relates_to","29b3-6847-937d-4470"],["relates_to","41e6-e080-e5c8-4a7e"],["relates_to","7b04-2057-d5d4-4e60"],["relates_to","e559-fe41-9edd-47c2"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5297d8c0-1a96-42ef-9af9-b0ca12bb513b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["mcp","plan-review","llm","cost"],"ticket_id":"d80d-7be7-1c0a-4231","ticket_type":"bug","title":"review_plan/verify_completion over MCP time out with no completion signal: unknown ticket state + duplicate paid LLM re-runs","verify_commands":[]},"source_event_uuids":["6fa19400-c3da-45d9-bb31-863bdee7b518","4e149a77-9711-43b8-ba89-fec4dc4c0726","3f528afe-43b7-4276-8362-a1dce045fd46","b1895f39-7d8e-4483-acbe-8a731c14efa8","c8605043-55a3-406a-a886-2062fade0d8b","a367677d-dd0d-4a57-b9cf-76e0a90725d2","5297d8c0-1a96-42ef-9af9-b0ca12bb513b","c01d8f33-dac2-4801-928e-123c32cd9112","522c5fef-1125-4a6e-810d-50f6af6ec46a","46946bae-8c4c-4cb1-a4f5-6eb9f349db8b","fb6f8c2c-f258-42e6-95c5-d9300ef732d9","68f7407f-38a8-4ab1-acf7-b1a546d92c1e","4835bafa-334d-4fdd-a5c8-0de5c49c254e","0e857160-8a6d-4176-b654-e06f9f85cae8","5f3f15f4-0d08-449a-854d-c28377af6379","b9b28316-0088-426a-8364-15c1b7501a01","396896fa-c387-4e5a-b19e-d0f87d0a4b03"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788157396735280002,"uuid":"17b56588-705c-47cc-b5bd-015b5a183a91"}