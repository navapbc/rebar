AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"21bb32bc009ec22cc13b418a081a621d0f7024acae37a3568df2df18d771b8bc","event_uuid":"253e00a9-cb1c-4ac9-af06-20b914a267a6","position":{"commit_sha":"b2801074d3900351b280b9e2859e135d4c76b18e","position":"1786808063202370001-253e00a9-cb1c-4ac9-af06-20b914a267a6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786807615238107001,"creation_channel":"cli","deps":[{"link_uuid":"63698b93-1a10-487f-b061-0457a6ea187e","relation":"discovered_from","target_id":"05b8-4efe-8d58-4c27"},{"link_uuid":"253e00a9-cb1c-4ac9-af06-20b914a267a6","relation":"depends_on","target_id":"a01d-b024-49dd-4254"}],"description":"## Problem\nThe reconciler active-set query hardcodes status != \"Done\" as the only Done-equivalent\n(fetcher.py jql_active / jql_done_recent). The code comment admits it: \"A project whose\nworkflow adds another closed-equivalent status would need this to move to\nstatusCategory != \\\"Done\\\"\". Against a live CLIENT Jira whose workflow uses Closed /\nResolved / Cancelled (common), issues in those statuses are NOT \"Done\", so:\n- jql_active pulls Closed/Resolved issues into the active working set -> the reconciler\n  treats resolved issues as active and may push outbound mutations at them.\n- jql_done_recent misses them, so they never populate the recent-Done snapshot.\nThis mis-scopes the entire active set for any non-DIG/REB workflow.\n\n## Approach\nSwitch the Done predicate from the literal status = \"Done\" to Jira's status CATEGORY:\nstatusCategory = Done / statusCategory != Done, which is workflow-agnostic (every Jira\nstatus maps to one of To Do / In Progress / Done categories, including custom Closed/\nResolved/Cancelled statuses which map to the Done category). Keep the JQL builders'\nper-project scoping and _validate_project_key unchanged. Verify ACLI/JQL supports\nstatusCategory (it does on both Cloud and DC).\n\n## Acceptance criteria\n1. jql_active excludes any status in the Done statusCategory (not just literal \"Done\").\n2. jql_done_recent selects the Done statusCategory, ORDER BY updated DESC, cap preserved.\n3. Single-project + multi-project fan-out unchanged otherwise; DIG/REB (To Do/In\n   Progress/Done only) behavior is identical.\n\n## Test plan\n- Update/extend the JQL-builder unit tests in tests/unit/rebar_reconciler/test_fetch_multi_project.py\n  (and any jql-string test) to assert the statusCategory predicate.\n- RED first: a test encoding a client workflow with a \"Resolved\" status shows the OLD\n  status != \"Done\" query would include Resolved in active (bug), and the NEW query excludes it.\n\n## Sequencing\nEdits fetcher.py jql builders AND tests/unit/rebar_reconciler/test_fetch_multi_project.py,\nwhich ticket A also edits — this ticket is SEQUENCED AFTER ticket A (a01d) to avoid a\nfile conflict. Rebase onto A's landed change before starting.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/fetcher.py","reason":"Switch jql_active/jql_done_recent to statusCategory predicate"},{"path":"tests/unit/rebar_reconciler/test_fetch_multi_project.py","reason":"Assert statusCategory predicate; client Resolved-status scenario"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","a01d-b024-49dd-4254"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"7332-a728-7108-4b55","ticket_type":"task","title":"Reconciler: scope active/done by statusCategory not literal status=Done (support Closed/Resolved client workflows)","verify_commands":[]},"source_event_uuids":["6409a03d-8326-4c4c-85ca-77823516bd13","b17a4670-4bcd-4a87-92e8-a4b49cf1f418","63698b93-1a10-487f-b061-0457a6ea187e","253e00a9-cb1c-4ac9-af06-20b914a267a6"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786808063202370002,"uuid":"8d201b79-02f7-483c-9707-33a7f522d102"}