{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"087d679e636e08063ee24ae523a193d831c5eb83530e7e4d4788bba6748c3e31","digest":{"component_or_area":"Reconciler JQL fetcher","key_entities":["fetcher.py","jql_active","jql_done_recent","statusCategory","status = Done","tests/unit/rebar_reconciler/test_fetch_multi_project.py","tests/unit/rebar_reconciler/test_fetch_paging_split.py"],"problem_keywords":["reconciler","active set scoping","jql query","status category","workflow","done equivalent","closed resolved cancelled"],"propositions":["jql_active query hardcodes status != 'Done' which incorrectly includes Closed/Resolved/Cancelled issues in the active working set for non-standard workflows","jql_done_recent misses Closed/Resolved/Cancelled issues because it queries literal status = 'Done' instead of statusCategory","switching Done predicate from literal status to statusCategory = Done makes scoping workflow-agnostic and includes all Jira-mapped Done-equivalent statuses","fetcher.py must use statusCategory != Done and statusCategory = Done predicates in jql_active and jql_done_recent builders respectively"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787880863565172001,"uuid":"2f3bf3eb-371d-415b-960a-b1891da078a4"}