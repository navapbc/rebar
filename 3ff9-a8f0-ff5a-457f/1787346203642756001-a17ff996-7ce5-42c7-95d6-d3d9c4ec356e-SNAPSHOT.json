{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787346203642756001,"compiled_state":{"alias":"squeamish-halfawake-fantail","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"8c71e91a54bd66c2aad96b74f65f2e750e827d64","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 3ff9-a8f0-ff5a-457f","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (8c71e91a54)","material: bcc451773c31b018","verified-at-sha:8c71e91a54bd66c2aad96b74f65f2e750e827d64"],"material_fingerprint":"bcc451773c31b018","merged_log_commit":"8c71e91a54bd66c2aad96b74f65f2e750e827d64","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787341618164753000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"8c71e91a54bd66c2aad96b74f65f2e750e827d64","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3ff9-a8f0-ff5a-457f","material: 6d817b7a031aafc9","material-part: children 647ea2107ca5072f 0","material-part: description f962b9d5934d5162 7727","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 3c490717f0fd53d3 4","material-part: ticket_id 186543f5b8998af3 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-ph