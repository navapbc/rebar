{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788896718705482870,"compiled_state":{"alias":"regretful-enormous-horsefly","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"64e460ca4b5ee838f16f6214ec5c9d0e64233568","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 81cc-bced-62f4-40b9","material: 37954d36a44fbf6e","material-part: children 647ea2107ca5072f 0","material-part: description 34b52dfe82ed5c60 3355","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 7050cee5e92ed734 4","material-part: ticket_id 958305bcc6e536d2 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (64e460ca4b5ee)","regver: aa61189569d34126","verified-at-sha:b249aca33f47751a125a22bf23c9295823d658b4","dep 8a179a25fc450733ed1652378efdc3056f9c2bd5848d398de0ec1b326deabaa3 infra/runbooks/review-bot-ops.md","dep 92422b77e381865d61c556ad7edce8d5c14710279ebffd285092a561f822db3b infra/scripts/observability.sh","dep 37736169943c7b0bf3f14c8e24631d005e1d9f3155d4c1d9f514c0dbf6e139df infra/terraform/monitoring_autodeploy.tf","dep c2df1779624618bc9acbf1d419e573b1dfcfbca133d47a98992bc044afa5f716 tests/scripts/test_observability_docker_storage.py","read-set: 6","read-path: infra/runbooks/review-bot-ops.md","read-path: infra/scripts/observability.sh","read-path: infra/terraform/monitoring_autodeploy.tf","read-path: tests/scripts/test_observability_docker_storage.py","read-path: tests/scripts/test_observability_timeout_9313.py","read-path: tests/unit/test_al