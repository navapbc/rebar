817001-416aabef-10c4-4850-9fb7-74d623019456"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a29a8c77d09806dee365ba9835355b57d7afe51926fd0191ab705bbd9fb1f957","event_uuid":"5420019a-1ba3-4a0c-bc7e-d66b6e0be563","position":{"commit_sha":"5a4518574396ae437058976e2d87bbcf911b4ffc","position":"1787762716823487001-5420019a-1ba3-4a0c-bc7e-d66b6e0be563"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"339ea18908758c219f7d53aa9bd6ce26505bb92b954050b193de8e52efb043d7","event_uuid":"38917243-b9c2-4380-ac78-021f1586dae5","position":{"commit_sha":"d7ea55f033531161c5e6d808414a3e5899e298e1","position":"1787764765544630904-38917243-b9c2-4380-ac78-021f1586dae5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5e3c25dd8bba4dc63951fa0118583cb191d941a65de5cd0e84a60c7c655d2e49","event_uuid":"77a83034-98fe-4298-abff-c029b154a853","position":{"commit_sha":"4214b5a9e8a7897b34ae6736b5893ce9f3c481cb","position":"1787765127425826001-77a83034-98fe-4298-abff-c029b154a853"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"21e0b651aa039f48f9aabc3c49ba605c73e6d35a1413d645e0e1b35951c8e0e9","event_uuid":"7388c13d-390f-4568-a3e4-7fd6df959a63","position":{"commit_sha":"5d4a8f3d1a7e246d4e4e47b1f683d576e4ef5cd8","position":"1787765659593713001-7388c13d-390f-4568-a3e4-7fd6df959a63"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-246_agent","claim_remote_session":null,"claimed_session":"06f3f99e-d9f9-40f8-a094-ac8d1c624cfd","comments":[],"created_at":1787705264100866001,"creation_channel":"cli","deps":[{"link_uuid":"bdb150f6-3326-4ac1-9b91-a196cc30c7d7","relation":"depends_on","target_id":"ee8a-6355-2e8f-4da3"},{"link_uuid":"2c584ce4-f4b4-4706-ad20-bde00a0f0aa5","relation":"depends_on","target_id":"6cd0-0786-4de8-415e"},{"link_uuid":"ea29f535-fc24-4b22-8542-baff68e63f61","relation":"relates_to","target_id":"b2a3-c8cb-cdda-4c70"},{"link_uuid":"38917243-b9c2-4380-ac78-021f1586dae5","relation":"relates_to","target_id":"66e8-6692-bc52-4b4d"}],"description":"## Context / Problem\n\nThe configuration surface (`ee8a`) and the per-run identity (`6cd0`) are both merged, but\nnothing reaches the wire: rebar still sends no request headers, so a gateway cannot attribute\nor group gate calls. Header values also sit adjacent to `provider_provenance`, written into\nverdicts and sidecars (`findings.py:122-123`, `completion_sidecar.py:339`), so delivery without\nredaction would put operator-supplied values into durable records.\n\n## Approach\n\nResolve `${run:...}` references and place the finished headers on the call through pydantic-ai's\n`ModelSettings.extra_headers`, by extending the dict returned from `build_model_settings`\n(`structured_run.py:338`), whose result flows to the model call at `runner.py:567`.\n\nThat seam rather than the transport: one insertion covers every provider supporting the field,\nwhereas patching transport needs edits at both `providers.py:295` and `anthropic_model.py:155`\nand still misses non-httpx providers. `build_model_settings` is already pure, with a purity test.\nHeaders are inert on Bedrock at the pin (`models/bedrock.py` references `extra_headers` zero\ntimes); the `base_url` gate excludes that path and the docs ticket records it.\n\n**Pass a fresh `dict(...)` per call, never the config-held mapping.** At the pin, the Chat\nCompletions path reads `model_settings.get('extra_headers', {})` with NO copy\n(`models/openai.py:1001`) then `.setdefault('User-Agent', ...)` (`:1002`), mutating the caller's\ndict — unlike the Responses path (`:2300`) and `models/anthropic.py:772`, which copy first.\nVerified live: a supplied `{\"x-corp-tag\": \"rebar\"}` came back carrying `User-Agent`. This is\nupstream issue 6866, fixed by PR 6868 after this pin, so the copy is the same remedy upstream\nlanded. Handing over the config's own dict would pollute it across calls and leak a pydantic-ai\nversion string into the recorded header-name set, making a signed verdict's provenance\nnon-deterministic. This is the exact path `base_url` selects.\n\nHeaders attach only when `cfg.base_url` is set — a configured intermediary is the only topology\nin which they mean anything (verified inert against `api.anthropic.com`), and gating stops an\noperator's internal values reaching a public provider.\n\n**An absent `${run:...}` substituend omits the whole header.** Only two scopes mint an identity\n(`gate_dispatch.py`'s two boundaries). `review-code` opens no `gate_config` scope and has no\nticket, so those values are absent there, as for any standalone op. Such a header is dropped\nrather than sent empty: an empty correlation header pollutes the gateway, and raising would\nbreak every standalone op merely because headers are configured globally — observability must\nnever break an operation, the rule `tracing.py` already follows. Deliberately asymmetric with\nthe unset-`${env:VAR}` hard error: an env var is knowable at config time, so its absence is an\noperator mistake, whereas a run value's absence is legitimate runtime context.\n\nValidation is re-applied after `${run:...}` substitution: those references resolve at call time,\nso a value that passed config validation is not yet proven safe. Re-running the same name/value\nchecks closes the validate-before-substitute gap on this second seam.\n\nRedaction: header names are recorded, values never. `provider_provenance` gains at most the\nsorted list of configured header names; every log and diagnostic path renders values as a fixed\nplaceholder. That record is assembled by `provenance_for` (`capabilities.py:554`), whose sole\nproduction caller is `runner.py:523` — so the consumer edit is in scope too: `provenance_for`\ngains a header-names parameter and that call passes `sorted(cfg.headers)`.\n\n`runner.py` is at exactly the 800-line cap, and the call site lists one keyword per line, so the\nadded argument must be paid for in the same file. Reclaim it by condensing the comment block\nimmediately above the call (`:516-522`), whose provenance rationale is already stated in\n`provenance_for`'s own docstring — the same restatement-at-the-call-site trim that brought this\nfile back under the cap in `6cd0`. Only if that is insufficient, extract along an existing\ncall-graph seam; never split mechanically to hit the number.\n\n## Scope\n\n- `src/rebar/llm/structured_run.py` — add `extra_headers` to the assembled model settings.\n- `src/rebar/llm/headers.py` — `${run:...}` resolution against the run identity.\n- `src/rebar/llm/capabilities.py` — `provenance_for` gains the header-names parameter.\n- `src/rebar/llm/runner.py` — pass `sorted(cfg.headers)` at the `provenance_for` call, staying\n  within the 800-line cap.\n- `tests/unit/test_header_delivery.py` (new) — the tests below.\n\n## Testing\n\nTier: a contract test driving the real assembly seam and capturing what it hands the boundary,\nplus in-process unit tests for resolution. The correlation assertion must capture headers from\nthe real call site — the dict `build_model_settings` actually returns — rather than recomposing\nthe resolution helpers, because a re-derived oracle stays green if the call site later stops\ncalling them, which is the only regression it exists to catch.\n\n- Happy path: with `base_url` and a `${run:trace_id}` header configured, the returned settings\n  carry the resolved value.\n- Edge: with no `base_url`, no `extra_headers` key; with no headers configured, the dict is\n  byte-identical to today's.\n- Failure: an unknown `${run:bogus}` raises naming the key; a value that only becomes unsafe\n  after substitution is rejected.\n- Omission: a header carrying `${run:...}` is absent outside a gate run while a sibling literal\n  header is still present.\n- Redaction: a sentinel value is absent from captured logs and from serialized\n  `provider_provenance`, while its header name is present.\n- Real-request paths: the non-mutation and merge-precedence criteria cannot be proven from\n  `build_model_settings`' return value — both drive a model call through the\n  `httpx.AsyncHTTPTransport` intercept the epic's spike already used, asserting on the headers\n  the transport observed.\n\n## Acceptance Criteria\n\n- [x] With `base_url` set and headers configured, the dict returned by `build_model_settings`\n      contains `extra_headers` with resolved values; checked by calling the real function inside\n      a gate-run scope and asserting on its return value, not on recomposed helpers.\n- [x] Every call in one gate run carries the same `${run:trace_id}` value and two runs differ.\n- [x] With `base_url` unset, no `extra_headers` key is present.\n- [x] With no headers configured, the returned dict equals the dict produced before this change.\n- [x] A header carrying `${run:...}` is omitted entirely outside a gate run rather than sent\n      empty, while a sibling literal header is still present.\n- [x] An unknown `${run:...}` key raises `LLMConfigError` naming the offending key.\n- [x] A header whose value only becomes unsafe after `${run:...}` substitution is rejected;\n      checked by forcing a run value containing CR, LF or NUL.\n- [x] The configured headers mapping is not mutated by a model call; checked against the\n      `httpx.AsyncHTTPTransport` intercept, which fails against the pinned upstream no-copy path\n      if the copy is dropped.\n- [x] A configured header overrides a same-named client default rather than being dropped;\n      checked on the intercepted request, pinning the merge precedence that is the\n      most-regressed behaviour in comparable projects.\n- [x] A sentinel header value appears in no log record and in no serialized\n      `provider_provenance`, while the header name does appear; checked on a record produced\n      through the real `provenance_for` call, not a hand-built one.\n- [x] `src/rebar/llm/runner.py` remains at or under 800 lines; checked by the module-size gate\n      in CI and by `wc -l` in pre-flight.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/structured_run.py","reason":"add extra_headers to the assembled model settings"},{"path":"src/rebar/llm/headers.py","reason":"resolve run-scoped references and re-validate the finished header"},{"path":"src/rebar/llm/capabilities.py","reason":"provenance_for gains the header-names parameter"},{"path":"src/rebar/llm/runner.py","reason":"pass sorted(cfg.headers) at the provenance_for call, within the 800-line cap"},{"path":"tests/unit/test_header_delivery.py","reason":"new contract tests capturing headers from the real seam and the transport intercept"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","6cd0-0786-4de8-415e"],["depends_on","ee8a-6355-2e8f-4da3"],["parent","7e9e-07f7-8fe1-4e38"],["relates_to","66e8-6692-bc52-4b4d"],["relates_to","b2a3-c8cb-cdda-4c70"]],"no_file_impact_reason":"","parent_id":"7e9e-07f7-8fe1-4e38","parent_status_uuid":"416aabef-10c4-4850-9fb7-74d623019456","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"26ae-041f-dcc4-4279","ticket_type":"story","title":"Deliver resolved headers via extra_headers with run interpolation and redaction","verify_commands":[]},"source_event_uuids":["726b4bbf-4b83-41b1-b2ec-f24b127cf633","92c44192-ba75-42c4-9481-bd1e66ff5352","dd11e834-73b7-419f-af69-bbc8428a69af","5ba02062-d5a3-4739-a76f-6e702b28b481","5e4fd6df-9f1f-4a0d-9589-5a6abe482edd","88a30cb7-832f-4e17-8279-ec84020f16d4","ea29f535-fc24-4b22-8542-baff68e63f61","8bc59b68-1b8b-483a-8966-9d449e9ba91f","58d1109c-7cb6-400b-88ec-3324cf400939","e197e819-f94b-4fef-8cc3-2b2560e75396","bf9d927f-3228-4ba1-ab69-f85ffd126e48","911994f2-4e39-4555-817e-2ebf66d9a517","416aabef-10c4-4850-9fb7-74d623019456","5420019a-1ba3-4a0c-bc7e-d66b6e0be563","38917243-b9c2-4380-ac78-021f1586dae5","77a83034-98fe-4298-abff-c029b154a853","7388c13d-390f-4568-a3e4-7fd6df959a63"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787765659593713002,"uuid":"db2de17e-cb5a-4cf7-a9db-a59764e755a2"}