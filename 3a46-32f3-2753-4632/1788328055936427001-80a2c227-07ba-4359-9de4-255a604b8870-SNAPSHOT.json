-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788314723811551001,"creation_channel":"cli","deps":[{"link_uuid":"f2bb6ac6-f8c3-403e-8701-ac857c2a8d95","relation":"depends_on","target_id":"8eff-87c1-d09a-4893"}],"description":"## Context / Problem\n\nPrivate compatibility aliases remain for CLI help routing, `run_security_detectors`, graph/reducer symbols, split reducer processors, and grounding `DIMENSIONS`. Their consumers are internal source or test/monkeypatch paths; no public wire or persisted-data contract requires them. The governing ADR is delivered by earthen-wheat-chick.\n\n## Approach\n\nAfter the ADR merges, migrate all consumers to `_help_route`, `run_detectors`, graph loader/reducer canonical owners, split reducer processor modules, and `grounding.oracle.DIMENSIONS`. Delete old aliases only when both semantic references and raw dynamic/string/monkeypatch census are empty.\n\n## Scope\n\n- CLI help aliases\n- code-review detector, graph/reducer, and grounding compatibility bindings\n- every source/test/patch/dynamic consumer\n\n## Testing\n\nRun targeted CLI/help, security-detector, graph/reducer, and grounding suites plus semantic and raw reference censuses.\n\n## Acceptance Criteria\n\n- [ ] Each listed old private name is absent after all consumers migrate to its named canonical owner.\n- [ ] Tests patch or import only canonical owners.\n- [ ] Public CLI behavior, security detector results, graph reduction, reducer events, and grounding dimensions remain unchanged.\n- [ ] Focused suites and complete semantic/raw reference scans pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/__init__.py","reason":"remove private help forwarding aliases"},{"path":"src/rebar/_cli/_help_route.py","reason":"canonical CLI help owner"},{"path":"src/rebar/llm/code_review/detectors.py","reason":"remove run_security_detectors shim"},{"path":"src/rebar/graph.py","reason":"remove graph reducer compatibility bindings"},{"path":"src/rebar/reducer","reason":"migrate processor compatibility exports to split canonical owners"},{"path":"src/rebar/grounding/detectors/registry.py","reason":"remove DIMENSIONS re-export"},{"path":"src/rebar/grounding/oracle.py","reason":"canonical DIMENSIONS owner"},{"path":"tests","reason":"migrate every test, string, and monkeypatch consumer"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","8eff-87c1-d09a-4893"],["parent","6640-ac11-5c55-46b5"]],"no_file_impact_reason":"","parent_id":"6640-ac11-5c55-46b5","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["janitor","internal-shims","cleanup"],"ticket_id":"3a46-32f3-2753-4632","ticket_type":"story","title":"Migrate and remove CLI, security, graph, reducer, and grounding internal shims","verify_commands":[]},"source_event_uuids":["be92e1b5-919d-4d2c-a232-579ce0705ead","4ab3b4f4-2e99-43a0-8d38-2dc459de7519","f2bb6ac6-f8c3-403e-8701-ac857c2a8d95"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328055936427001,"uuid":"80a2c227-07ba-4359-9de4-255a604b8870"}