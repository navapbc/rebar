sured: render, blank, render, blank...)', which is a structural assumption not established by the prerequisite's described lexer (phase 2 splits into blank-line blocks plus list items preserving separators, not a blank-unit-per-block emission).","group_criteria":null,"group_id":null,"id":"fdf2781652189cd8c","impact":0.85,"is_primary":null,"location":"Approach / batching; Prior art section","norm_id":"n7e7ec772798cd38a","priority":0.7556,"reason":"high-priority+criterion-opted-in","scenarios":[],"severity":"critical","suggested_fix":"","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"yes","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"high","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Name the concrete SBOM/notice file path the pandoc GPL entry is recorded in (or the generator that emits it) and classify it as a NEW artifact, so the 'notice-file test' has a defined target.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"advisory","decision_margin":-0.2812,"drop_reason":null,"evidence":["Scope line: 'SBOM/licensing notice — record the wheel-bundled pandoc GPL entry.'","AC3: 'its GPL license is re