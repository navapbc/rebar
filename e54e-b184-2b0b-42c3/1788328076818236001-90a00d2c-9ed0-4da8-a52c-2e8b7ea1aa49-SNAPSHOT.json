AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788314893452254001,"creation_channel":"cli","deps":[{"link_uuid":"e428acaf-0da6-45b9-9084-a4268a481deb","relation":"depends_on","target_id":"8eff-87c1-d09a-4893"}],"description":"## Context / Problem\n\n`src/rebar/mcp_server.py:20-42` re-exports 21 output model names solely for old private Python imports; MCP tool names, JSON Schema, outputSchema, and wire payloads are unaffected. Test-only `_is_transient_add_error` aliases in event append/commit modules forward to `gitutil._is_transient_object_write_error`; `_referencing_commit_exists` re-exports/wrapper forward to `_referencing_commits`.\n\nThe governing ADR is earthen-wheat-chick [rebar:earthen-wheat-chick].\n\n## Approach\n\nAfter the ADR merges, migrate every source/test/string/dynamic/monkeypatch consumer to `rebar._mcp_models`, `gitutil._is_transient_object_write_error`, and `_referencing_commits`. Delete the re-exports, wrappers, mock setup, inventories, and stale comments. Preserve MCP wire schemas and end-to-end retry, corruption, post-ref, descendant-credit, and absence-blocking controls.\n\n## Scope\n\n- `mcp_server` output-model imports/`__all__` and model consumers\n- event commit/append aliases and classification tests\n- close-precheck/transition-close wrappers and lifecycle tests\n\n## Testing\n\nVerify all MCP schemas/wire outputs remain unchanged; test transient object-write classification plus end-to-end retry/corruption/post-ref controls; test descendant credit and missing referencing-commit blocking.\n\n## Acceptance Criteria\n\n- [ ] All 21 `mcp_server` output-model re-exports and private-import consumers are removed/migrated to `_mcp_models`.\n- [ ] MCP tool names, JSON Schema, outputSchema, and wire payloads are unchanged.\n- [ ] Old transient-error aliases are absent while retry, corruption, and post-ref negative controls pass.\n- [ ] Old referencing-commit wrappers are absent while descendant-credit and absence-blocking close behavior pass.\n- [ ] Static, string, dynamic-import, and monkeypatch census proves each removed name/path has no consumer.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/mcp_server.py","reason":"remove private model re-exports and __all__ entries"},{"path":"src/rebar/_mcp_models.py","reason":"canonical output model owner"},{"path":"src/rebar/_store/event_commit_git.py","reason":"remove transient-error alias"},{"path":"src/rebar/_store/event_append.py","reason":"remove transient-error alias"},{"path":"src/rebar/gitutil.py","reason":"canonical transient object-write classifier"},{"path":"src/rebar/_commands/transition_close.py","reason":"remove referencing-commit re-export"},{"path":"src/rebar/_commands/close_precheck.py","reason":"remove boolean wrapper in favor of scanner"},{"path":"tests","reason":"migrate private imports/patches and preserve wire/store/close behavior"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","8eff-87c1-d09a-4893"],["parent","6640-ac11-5c55-46b5"]],"no_file_impact_reason":"","parent_id":"6640-ac11-5c55-46b5","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["janitor","mcp","store","internal-shims"],"ticket_id":"e54e-b184-2b0b-42c3","ticket_type":"story","title":"Migrate and remove MCP-model, store, and close-workflow internal shims","verify_commands":[]},"source_event_uuids":["504517c9-03b1-44a1-baba-190448aa8781","54cdf487-9d21-4c50-9b2d-f78822ba5faa","e428acaf-0da6-45b9-9084-a4268a481deb"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328076818236001,"uuid":"90a00d2c-9ed0-4da8-a52c-2e8b7ea1aa49"}