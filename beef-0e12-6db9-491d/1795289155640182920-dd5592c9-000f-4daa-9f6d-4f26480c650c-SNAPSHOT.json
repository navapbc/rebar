6401dd986"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"9420db5f5314a0592770f055d47f4063a71e9aeabcd9eec1bffdc8aca9705497","event_uuid":"3d22c494-6781-405a-827a-93490aac86dd","position":{"commit_sha":"d86e363e90693e9153c6de090ebf1213d11d4887","position":"1795289155640182919-3d22c494-6781-405a-827a-93490aac86dd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Verify-parity sweep evidence, Nov 20 2026. The same 5 s x 3 HEAD-probe TimeoutExpired errors (git -C <worktree> rev-parse HEAD timed out after 5 seconds, from the autouse _no_repo_commits guard) appear as ERRORs in all 5 sandboxed overnight make verify logs of Nov 19-20, which overlapped about 8 concurrent -n 4 suites. They appear in none of the 5 complete slot-capped unsandboxed runs of Nov 20 (load ~30). Probe latency measured today at load ~25: git rev-parse HEAD 15 ms inside and outside the sandbox. The observed trigger is host oversubscription beyond the 3-run verify-slot cap; not worked by the sweep.","timestamp":1795207277500224001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation note after plan review: the renamed real-guard test was listed by node id in .github/windows-sweep-deselect/unclassified.args, so that entry is replaced by the two tests that succeed it (same Windows status quo); the census comment in tests/unit/test_timeout_budget_headroom.py now says the floor is the fallback probe's bound. The regression test fails loudly if GIT_DIR/GIT_COMMON_DIR/GIT_WORK_TREE are set, since the reader then defers to git by design. Reproduction: before, 6 s rev-parse HEAD shim => '1 error in 15.75s' (TimeoutExpired after 5 seconds); after, same shim => '1 passed in 1.11s'. Guard tests: 35 passed.","timestamp":1795244529221554001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Slot make verify of 0375e28c8d9 failed 2 tests in tests/unit/test_repo_isolation_deadline.py: they call _run_real_guard_with_blocking_git and require it to return the nested CompletedProcess itself, which my first version had changed to a (result, state) tuple. Fixed by keeping the helper's return contract (the blocked-probe assertion stays inside it for 'status'); guard, deadline, census and deselect tests: 37 passed. Re-running make verify.","timestamp":1795249009947663001}],"created_at":1795152495719694001,"creation_channel":"cli","deps":[{"link_uuid":"6915d179-a76d-4184-b095-08ea67e97d2a","relation":"discovered_from","target_id":"7fcc-dac7-6f05-4ad1"},{"link_uuid":"049289e7-e5a6-400a-b6de-4e96401dd986","relation":"relates_to","target_id":"b3ee-5838-0cbb-4f98"},{"link_uuid":"3d22c494-6781-405a-827a-93490aac86dd","relation":"relates_to","target_id":"5188-d858-364e-40e4"}],"description":"## Observation\nOn 2026-11-19 at about 20:57 PST (load average 42.97/43.57/41.22 on the shared agent host), a targeted pytest run in worktree fix-test-git-maint-detach (73 tests, -n 4) reported 72 passed and 1 error: tests/unit/test_topology_template_upkeep_guard.py::test_a_partially_pinned_repository_is_still_refused errored in teardown with subprocess.TimeoutExpired from tests/_isolation.py head() (git -C <worktree> rev-parse HEAD, 5 s watchdog, re-sampled GIT_PROBE_ATTEMPTS times). The test body passed. The same error appears 11 times across the 5 sandboxed overnight make verify logs of Nov 19-20 (always `rev-parse HEAD`, never the session's `status --porcelain`).\n\nClosed bug dominating-removable-monkfish measured the same probe (p99 2.08 s, max 3.30 s under 18 processes x 100 probes).\n\n## Root cause (verified)\nThe autouse `_no_repo_commits` guard (tests/conftest.py) samples the checkout's HEAD by STARTING a `git rev-parse HEAD` process in setup and in teardown of every test (about 43,000 process starts per `make verify`). Each start is bounded at GIT_PROBE_TIMEOUT_SECONDS = 5 s with 3 attempts, and the last timeout is raised by design. On a host too loaded to start a process within 5 s three times, a passing test errors. CI runners under load can hit the same thing.\n\nDeterministic reproduction (Nov 20 2026, origin/main ebd2a68a451): a PATH `git` shim that sleeps 6 s before any `rev-parse HEAD` makes `pytest tests/unit/test_timeout_budget_headroom.py::test_the_budget_is_still_a_real_hang_guard` report `1 error` (TimeoutExpired after 5 seconds, 15.75 s) every run, although the test passes.\n\n## Approach\nRemove the process start from the per-test HEAD sample instead of widening a bound: read HEAD from the git files, which is what `git rev-parse HEAD` does, and keep git as the authority for anything unusual.\n- `tests/_isolation.py`: new `_read_head_from_files(root)`. It locates the git dir (`<root>/.git` directory, or the `gitdir:` file of a linked worktree plus its `commondir`), reads `HEAD`, follows `ref: <name>` up to 5 hops (per-worktree refs `refs/bisect/`, `refs/worktree/` and `refs/rewritten/` from the worktree git dir, all others from the common dir), and falls back to `packed-refs` for a packed ref. It returns an object id only when it has a 40- or 64-hex id; otherwise it returns `None`. It also returns `None` when `GIT_DIR`, `GIT_COMMON_DIR` or `GIT_WORK_TREE` is set, when the common dir has a `reftable` directory, or on any OSError. `head()` uses the reader first and the existing bounded, re-sampled git probe only on `None`, so unborn branches, non-repos and unknown layouts behave exactly as before, and a stuck probe there still fails loudly.\n- `porcelain()` (2 starts per session, never seen to time out) is unchanged.\n- No product code, config key, environment variable or flag changes.\n\n## Scope\n- `tests/_isolation.py`\n- `tests/unit/test_repo_isolation_guard.py`\n\n## Testing\nIn `tests/unit/test_repo_isolation_guard.py`:\n- The reader matches `git rev-parse HEAD` on a branch, after `git pack-refs --all` (no loose ref left), on a detached HEAD, and in a linked worktree with its own branch.\n- The reader returns `None` for an unborn branch (and `head()` then still returns `None` through git) and when `GIT_DIR` is set.\n- `test_commit_guard_fails_explicitly_when_head_times_out` (real conftest on this checkout with every `rev-parse HEAD` stalled) becomes `test_real_commit_guard_reads_head_without_starting_git`: the passing nested test now passes and the stalling shim is never invoked for HEAD. This is the regression test for this bug.\n- The loud-failure contract moves to `test_commit_guard_fails_explicitly_when_the_head_probe_times_out`, which forces the probe path (reader patched to `None`) and still requires `TimeoutExpired`. The two existing in-process probe tests (transient-stall re-sample, patched-sleep independence) also patch the reader to `None` so they keep testing the probe.\n- Reproduction after the change: the 6 s `rev-parse HEAD` shim run gives `1 passed`, recorded here.\n\n## Acceptance Criteria\n- [ ] Under the 6 s `rev-parse HEAD` shim the passing test errors before the change and passes after, runs recorded on this ticket.\n- [ ] The guard reads HEAD without starting git for a plain repository or linked worktree, with reader-versus-git equivalence tests for a branch, a packed ref, a detached HEAD and a linked worktree.\n- [ ] A stuck git probe on the fallback path still fails explicitly, covered by a test.\n- [ ] `make verify` passes on the change, and Gerrit gives Verified +1.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"tests/_isolation.py","reason":"read HEAD from the git files; git probe only as fallback"},{"path":"tests/unit/test_repo_isolation_guard.py","reason":"reader equivalence tests, regression test, loud fallback test"},{"path":"tests/unit/test_timeout_budget_headroom.py","reason":"comment: the census floor is the fallback probe bound"},{"path":".github/windows-sweep-deselect/unclassified.args","reason":"rename the deselected node id to the two tests that replace it"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","5188-d858-364e-40e4"],["relates_to","b3ee-5838-0cbb-4f98"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5111cd7c-ac5c-4230-a49a-073a6bc5a9f8","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"beef-0e12-6db9-491d","ticket_type":"bug","title":"Repo-isolation HEAD guard starts git twice per test, so a host too loaded to start a process errors a passing test","verify_commands":[]},"source_event_uuids":["fb97ad64-7ac8-4c6d-baa4-55c5bdaa5633","c1ca5556-57aa-445e-8ca6-746db338983f","c0725c10-5c39-4f71-827f-adc969d24e8a","943d04b6-7306-4d82-aa6f-899bfbd533a0","5111cd7c-ac5c-4230-a49a-073a6bc5a9f8","f312d97c-2503-4ad3-a517-c53b7be08f3a","bb4807af-e28b-45d7-ad1a-eb7e6e51150c","6d4665a2-1b56-498e-8c58-4502a847869d","1ef7d85d-d249-4c83-bed4-89a1e9cf7d21","049289e7-e5a6-400a-b6de-4e96401dd986","3d22c494-6781-405a-827a-93490aac86dd"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795289155640182920,"uuid":"dd5592c9-000f-4daa-9f6d-4f26480c650c"}