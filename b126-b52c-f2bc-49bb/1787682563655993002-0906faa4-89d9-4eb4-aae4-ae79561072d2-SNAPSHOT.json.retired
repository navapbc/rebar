 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"51bf0c42c9486f1fb325d02c08fa78da88da7130fb1641697cdd346135169bca","event_uuid":"224c9650-7d53-4382-a267-dca2dacb1485","position":{"commit_sha":"70a6409fbb0da20c256f07cc02d3b7321a8b5a53","position":"1787681423014663001-224c9650-7d53-4382-a267-dca2dacb1485"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d590d107b6554da95e35b8c67c443eb1b6ec48d4b025c7168a00e31ec8cd5c66","event_uuid":"defac10c-d4f3-4f91-a527-a78c526b13c3","position":{"commit_sha":"b920bf050cdbd84032153335adfa38d48176abb9","position":"1787681639044393001-defac10c-d4f3-4f91-a527-a78c526b13c3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9aa815edbb006875de53b65f3f518b8c7abb00c78817c36b48323387423e37f7","event_uuid":"46ae91dd-0d96-44c7-b3d5-3067610dbccf","position":{"commit_sha":"c43b33b252114e9cdc2f54f28bed9b6372004e5c","position":"1787681655074434001-46ae91dd-0d96-44c7-b3d5-3067610dbccf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"337c94e1612ef12821bea93b1fd735f46dd8e59bb17b2ef1daf85e6dbd1a1e56","event_uuid":"01f4cd35-4bc2-4b5d-b635-3fe68febd588","position":{"commit_sha":"6217f487e0dc7bb3fb38710bb3f72308fda37681","position":"1787682500530077001-01f4cd35-4bc2-4b5d-b635-3fe68febd588"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8bed4e017924e76fe1cd1bf4e80881ced1c1799bb5af272a2b3b17b0dbac46a9","event_uuid":"8933d1ac-eca0-4932-bbbc-d62ddeeaa8c6","position":{"commit_sha":"5856b00cb77b1a026e7442ff048855951281dedc","position":"1787682518717200001-8933d1ac-eca0-4932-bbbc-d62ddeeaa8c6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d82ea5bbe18c9f7b05a3e4958b1250717662c2250aaa5a9c2152f27397b40e84","event_uuid":"1da3cb9f-3274-4cb5-8dc6-fdce992bc045","position":{"commit_sha":"ca6156b750d1708292efb064a6e79db175b2f113","position":"1787682536266768001-1da3cb9f-3274-4cb5-8dc6-fdce992bc045"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bfef5543e0d95ce69fa79b1b268c6466927986d4c8e643ea3dcbea061deb2a7e","event_uuid":"e3368240-e09b-43ec-9876-9c4763852c1f","position":{"commit_sha":"5e98f73e712ca3f319ff15c59ad6691d6b7dc2f7","position":"1787682563655993001-e3368240-e09b-43ec-9876-9c4763852c1f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Initial plan review returned BLOCK on G1G2 because the narrative plan omitted the existing diff-only contract tests even though `tests/unit/test_code_review_nit_suppression.py` was present in file impact. Revised the plan to name both obsolete test functions, state their removal, preserve nit-suppression coverage, and assign the replacement contracts to a dedicated test file. Split the acceptance criteria into independently verifiable outcomes before re-review.","timestamp":1787680323637344001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Second plan review returned BLOCK on a valid index-catalog premise. `code-review-docs` is a `code-review-pass` overlay, so `reviewers/index.json` excludes it by design. Removed index regeneration from the plan, file impact, verification commands, and acceptance criteria. Added the protected-content exclusion as an explicit rubric deliverable. Split the remaining compound verification criterion into focused tests, offline eval validation, lint, and type checking.","timestamp":1787681039941815001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Applied the signed PASS advisory before claim. Added separate acceptance criteria that require removal of the diff-only rubric rule and removal of its two obsolete pinning tests. A fresh review signature is required because this changes plan material.","timestamp":1787681655074434001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fourth plan review returned BLOCK because inline diff-only eval cases cannot exercise the approved second-source repository rule. Expanded the plan by two files. `eval_solver.py` will reuse its existing disposable fixture repository for code-review cases that supply `files`, while preserving the current inline path for all other cases. `test_eval_solver.py` will pin rerooting. The documentation spec will carry repository-backed cases, registered deterministic scorers, a non-empty gold set, and an explicit repository-wide-no-owned-location no-fire case.","timestamp":1787682563655993001}],"created_at":1787679545739783001,"creation_channel":"cli","deps":[{"link_uuid":"3384b82d-9956-4ccf-a515-d8f5e82dac6d","relation":"discovered_from","target_id":"807d-3357-726e-4faa"}],"description":"## Context\n\nThe code-review documentation specialist declares `execution_mode: single_turn`, while its routing entry declares `exec: 1-TURN`. The runner therefore withholds repository tools. Its rubric also requires every contradiction to appear entirely inside the diff. This prevents grounded detection when a changed public contract requires an update to maintained documentation. The rubric does not apply the documentation roles and correction rules in `docs/documentation-policy.md`.\n\nThe approved design upgrades this specialist to the same agentic execution model used by other repository-grounded code-review criteria. It preserves advisory treatment and rejects stylistic enforcement.\n\nCode-review overlays use `category: code-review-pass`, so they are excluded from `src/rebar/llm/reviewers/index.json`. That generated reviewer-selection catalog is not part of this change. Agentic execution is established by the prompt execution mode plus the code-review routing entry.\n\n## Plan\n\n- Change `src/rebar/llm/reviewers/code-review-docs.md` to declare `execution_mode: agentic`. Change the `docs` entry in `src/rebar/llm/code_review/criteria_routing.json` to declare `exec: AGENT`.\n- Revise the documentation rubric to require read-only repository navigation before reporting missing updates or role violations.\n- Replace the diff-only contradiction rule with a two-source rule. Every finding must cite a changed `path:line` plus a second repository source that proves inaccuracy, required ownership, or a bounded omission.\n- Add a missing-update check for changed user, operator, API, CLI, configuration, or shipped-help contracts. Permit absence findings only when repository evidence establishes the canonical documentation location and a bounded search confirms the omission. A repository-wide search with no match is insufficient.\n- Add a documentation-role check based on `docs/documentation-policy.md` and `docs/generated-artifacts.md`. Apply it to changed maintained documentation, shipped help, comments, ADRs, or generated artifacts. Require policy citations. Require abstention when audience, role, or ownership is ambiguous.\n- State in the rubric that protected evidence, quotations, historical ticket events, and ADR decision substance are outside this criterion. Instruct the specialist not to report unrelated defects found in unchanged documentation.\n- Update `tests/unit/test_code_review_nit_suppression.py`. Remove its obsolete `test_docs_rubric_forbids_absence_speculation` and `test_docs_rubric_requires_both_sides_in_diff` assertions because they pin the diff-only rule being replaced. Preserve its nit-suppression behavior coverage.\n- Add `tests/unit/test_code_review_docs_overlay.py` to pin agentic execution, repository-backed evidence, bounded omission checks, documentation roles, exclusions, and unchanged routing posture.\n- Extend the code-review arm in `src/rebar/llm/evals/eval_solver.py`. When a case supplies `files`, create the existing disposable case repository, reroot the injected runner there, then execute the code-review prompt against the inline diff. Keep cases without `files` on their current inline path. Pin both paths in `tests/unit/test_eval_solver.py`.\n- Add `src/rebar/llm/eval_specs/code-review-docs.eval.yaml`. Each proven omission or role-violation fire case supplies a diff plus repository files that establish the second source. No-fire cases cover internal-only changes, ambiguous ownership, protected evidence, unrelated documentation, and a repository-wide search with no owned location. Include a registered deterministic scorer plus a non-empty `gold_set` so the packaged-spec glob in `tests/unit/test_eval_scorers.py` remains strict-clean. Add the specification to the standing offline validation set in `tests/unit/test_code_review_evals.py`.\n- Preserve the existing automatic file globs, advisory posture, blocking setting, impact-aware nit suppression, and independent Pass 2 verification. Do not add punctuation, character, vocabulary, diction, tone, wrapping, or subjective concision enforcement.\n\n## Acceptance Criteria\n\n- [ ] Prompt front matter plus routing declare agentic documentation review.\n- [ ] The rubric directs the specialist to use read-only repository navigation.\n- [ ] The diff-only requirement that both contradiction sides appear in the diff is removed.\n- [ ] The obsolete diff-only rubric tests are removed.\n- [ ] Every finding cites a changed-text anchor plus a second repository source.\n- [ ] Each missing-update finding cites a repository-proven obligation plus a bounded search.\n- [ ] A repository-wide search with no owned location produces no finding.\n- [ ] Documentation-role findings cite an explicit policy role or correction rule.\n- [ ] Generated-output findings cite ownership from `docs/generated-artifacts.md`.\n- [ ] Ambiguous audience, ownership, or role produces no finding.\n- [ ] Protected evidence, quotations, historical ticket events, or ADR decision substance remain excluded.\n- [ ] Unrelated defects in unchanged documentation produce no finding.\n- [ ] Punctuation, characters, vocabulary, diction, tone, wrapping, or subjective concision remain excluded.\n- [ ] Existing globs, advisory posture, nonblocking setting, nit suppression remain unchanged.\n- [ ] Independent Pass 2 verification remains unchanged.\n- [ ] Code-review eval cases with `files` run against a disposable fixture repository.\n- [ ] Code-review eval cases without `files` retain the inline execution path.\n- [ ] The documentation eval specification includes repository-backed fire cases plus bounded no-fire cases.\n- [ ] The documentation eval specification includes a registered deterministic scorer plus a non-empty `gold_set`.\n- [ ] Focused prompt, routing, eval-solver, eval-contract tests pass.\n- [ ] Repository lint passes.\n- [ ] Repository type checking passes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/reviewers/code-review-docs.md","reason":"Upgrade the documentation rubric to agentic repository-grounded evaluation."},{"path":"src/rebar/llm/code_review/criteria_routing.json","reason":"Declare AGENT execution while preserving routing posture and globs."},{"path":"src/rebar/llm/evals/eval_solver.py","reason":"Let code-review eval cases reroot agentic tools into existing disposable fixture repositories."},{"path":"src/rebar/llm/eval_specs/code-review-docs.eval.yaml","reason":"Add repository-backed prompt regression cases for omissions, roles, and abstention."},{"path":"tests/unit/test_code_review_docs_overlay.py","reason":"Pin agentic execution and the evidence and role contracts."},{"path":"tests/unit/test_code_review_nit_suppression.py","reason":"Retire the obsolete diff-only rubric assertions while preserving nit behavior tests."},{"path":"tests/unit/test_code_review_evals.py","reason":"Add the documentation specification to standing offline eval validation."},{"path":"tests/unit/test_eval_solver.py","reason":"Pin fixture rerooting for code-review cases with files and preserve the inline path."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["code-review","documentation","llm"],"ticket_id":"b126-b52c-f2bc-49bb","ticket_type":"task","title":"Make the code-review documentation overlay agentic","verify_commands":[{"command":".venv/bin/pytest -q tests/unit/test_code_review_docs_overlay.py tests/unit/test_code_review_ws2.py tests/unit/test_prompt_front_matter.py","dd_id":"DD1","dd_text":"Agentic prompt and routing behavior stay aligned."},{"command":".venv/bin/pytest -q tests/unit/test_eval_solver.py tests/unit/test_code_review_evals.py tests/unit/test_eval_scorers.py tests/unit/test_code_review_nit_suppression.py","dd_id":"DD2","dd_text":"Repository-backed code-review cases and strict eval contracts remain valid."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"DD3","dd_text":"Changed files satisfy repository lint."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck","dd_id":"DD4","dd_text":"Changed files satisfy repository type checking."}]},"source_event_uuids":["5fe28cf3-794c-4e8e-bcab-92b325942b39","58b4b1c1-1c58-4aba-a2b5-97e488a6ba24","04a90580-306e-402d-807a-eca252a504fb","90379104-9094-4b6d-98ee-f91218138c8a","26b9a780-43c2-4ee5-b5c4-efe58494d19d","d1bfd803-02b9-41c8-b1c3-f471be4bbb35","224c9650-7d53-4382-a267-dca2dacb1485","defac10c-d4f3-4f91-a527-a78c526b13c3","46ae91dd-0d96-44c7-b3d5-3067610dbccf","01f4cd35-4bc2-4b5d-b635-3fe68febd588","8933d1ac-eca0-4932-bbbc-d62ddeeaa8c6","1da3cb9f-3274-4cb5-8dc6-fdce992bc045","e3368240-e09b-43ec-9876-9c4763852c1f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787682563655993002,"uuid":"0906faa4-89d9-4eb4-aae4-ae79561072d2"}