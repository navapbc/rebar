{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787682563655993002,"compiled_state":{"alias":"soldierly-whacky-merlin","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"8b8fa7c0064557c6746afc948e3cb0a8786c83a1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b126-b52c-f2bc-49bb","material: 771de6501b184d8c","material-part: children 647ea2107ca5072f 0","material-part: description 47ab0b66f9ac1747 5146","material-part: description_boxes 37dd639a28ba4c52 0","material-part: file_impact ff15c23cf855305d 6","material-part: ticket_id fb16784f660bfd49 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (8b8fa7c00645)","regver: aa61189569d34126","verified-at-sha:8b8fa7c0064557c6746afc948e3cb0a8786c83a1","dep ab688df7fba8e92916aee4eef6e8ec38a1f846a15d800b7c0f9095c5bea77f40 src/rebar/llm/code_review/criteria_routing.json","dep absent src/rebar/llm/eval_specs/code-review-docs.eval.yaml","dep c1ea83efa043cd67f4178096ae49848fccd76b2740c8b72ac39abab0f68ddf7b src/rebar/llm/reviewers/code-review-docs.md","dep absent tests/unit/test_code_review_docs_overlay.py","dep 5d73e23d13918fade2ce5c82d63380f33e5a9ff96ba25319199036dde087a15c tests/unit/test_code_review_evals.py","dep 5d1b38422444526f5d081fc8026f7bf991869d93c2f06cd3e6762e71a0c5964e tests/unit/test_code_review_nit_suppression.py","read-set: 8","read-path: docs/documentation-policy.md","read-path: docs/generated-artifacts.md","read-path: src/rebar/llm/code_review/criteria_routing.json","read-path: src/rebar/llm/reviewers/code-review-docs.md","read-path: src/rebar/llm/reviewers/code-review-tests.md","read-path: src/rebar/llm/reviewers/index.json","read-path: tests/unit/test_code_review_evals.py","read-path: tests/unit/test_code_review_nit_suppression.py","currency-basis: file_impact"],"material_fingerprint":"771de6501b184d8c","merged_log_commit":"8b8fa7c0064557c6746afc948e3cb0a8786c83a1","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787681422988287000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"f0d85cbb1ca729c0b49822f59c4b55101c44cc164353ad7b5d9b9f89a1bc7a9e","event_uuid":"5fe28cf3-794c-4e8e-bcab-92b325942b39","position":{"commit_sha":"5fc6be8042e78fe4911568ac2f97751765c19939","position":"1787680308853283001-5fe28cf3-794c-4e8e-bcab-92b325942b39"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ceb1d29ce8d2257f2d8d3630c90c380b44ec05414d7527e09dff5674b40a329f","event_uuid":"58b4b1c1-1c58-4aba-a2b5-97e488a6ba24","position":{"commit_sha":"ecb749fc7f63c8c669937f9d9d14dc8f2c14d797","position":"1787680323637344001-58b4b1c1-1c58-4aba-a2b5-97e488a6ba24"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d0eaf49cfca9d2795aa0779369bea6fca145aeca84a7fdca9ed2c5a5d81f5cfa","event_uuid":"04a90580-306e-402d-807a-eca252a504fb","position":{"commit_sha":"3339ed12fc30040a98b6ea126882da52b4891486","pos