{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c '\nimport ast, io, subprocess, tokenize\nfrom pathlib import Path\nB = \"1c4a48a35aff998a2aa9a87001541bb0ea6e3176\"\nA = {\"src/rebar/_commands/transition.py\":[\"module\",\"_resolve_parent_in_status\",\"_parse_flags\",\"_reject_retired_force_close\",\"_extract_force\",\"transition_compute\",\"_force_note\",\"_cascade_parent_first\",\"_plain_reason_refused\",\"_emit_transition_result\",\"_emit_completion_signature_text\"],\"src/rebar/_commands/txn.py\":[\"module\",\"_stamp_session\",\"_acquire_write_lock\",\"_git\",\"_git_commit\",\"_unstage\",\"close_class_refusal\",\"_stamp_close_metadata\",\"transition_core\",\"claim_core\",\"ensure_attested_items_valid\"],\"src/rebar/_commands/verify_authorship.py\":[\"module\",\"_ScopedEvent\",\"_is_archived_ticket\",\"_verify_signed\",\"_resolve_commit\",\"_is_enforced\",\"cli._resolve_position\"],\"src/rebar/_commands/verify_opcert.py\":[\"module\",\"_close_anchor_event\",\"_opcert_anchor_event\"]}\nTOKENS = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in A[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                qualified = f\"{prefix}.{child.name}\" if prefix else child.name\n                visit(child, qualified)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    found = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type != tokenize.COMMENT:\n            continue\n        body = tok.string[1:].lstrip()\n        if tok.string.startswith(\"#!\") or any(body.startswith(prefix) for prefix in TOKENS):\n            found.append(lines[tok.start[0] - 1])\n    return found\nfor path in A:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\n'","dd_id":"immutable-prose-only","dd_text":"Only allowlisted prose may change; after stripping those owner docstrings, base and final AST/runtime trees match, with only TypeIgnore.lineno normalized, and directive/shebang physical lines are identical."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess; expected=set([\"src/rebar/_commands/transition.py\",\"src/rebar/_commands/txn.py\",\"src/rebar/_commands/verify_authorship.py\",\"src/rebar/_commands/verify_opcert.py\"]); actual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":sorted(expected),\"actual\":sorted(actual)}'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/interfaces/lifecycle/test_claim_transition_parent_cascade.py tests/interfaces/lifecycle/test_transition_pre_status_check.py tests/interfaces/lifecycle/test_transition_reason_honest_3803.py tests/interfaces/store/test_e3_txn_bytes.py tests/unit/test_transition_force_flag_24f7.py tests/unit/test_transition_close.py tests/unit/test_identity_3183.py tests/unit/test_identity_perf_1cc0.py tests/unit/test_verify_identity_a2c7_perf.py tests/unit/test_verify_opcert.py tests/unit/test_verify_opcert_heldout.py","dd_id":"focused-contracts","dd_text":"Focused tests for every preserved subsystem contract pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_commands/transition.py src/rebar/_commands/txn.py src/rebar/_commands/verify_authorship.py src/rebar/_commands/verify_opcert.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"The repository lint and documentation-policy gates pass in the worktree virtualenv; Gerrit CI supplies full-suite verification."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788922650326832001,"uuid":"7bee6497-036a-4efd-9a5c-d77780a54431"}