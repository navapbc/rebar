eae4a9eac","position":"1786236838633430001-1ffbac6a-9b3d-4e3c-a92c-715b8daf5342"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cd2431d894dcb35673f61e45f1d4654d91bb06d42fdfe995a35d6651cb12e527","event_uuid":"4caf712f-2c78-4452-a20c-b7801bd86334","position":{"commit_sha":"65742055fcf9b98cb862be20445218d9cbac6d9c","position":"1786237409082608001-4caf712f-2c78-4452-a20c-b7801bd86334"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f954e8bdec1c52c2ef4d19abba77da0f85c52c8caba2f317ece5e1c43f5a9062","event_uuid":"3c58e9ce-23a7-40c0-a0db-34b066c27686","position":{"commit_sha":"0487746e9642164da3eca12eabb80037cc52d291","position":"1786238830545323001-3c58e9ce-23a7-40c0-a0db-34b066c27686"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f7e21129562025a2498a1bdf51af2c51aacf4b67a0bb0a939e3fdd601ae866d3","event_uuid":"f2c2c36a-64fc-490f-892f-3d6c7b2a4401","position":{"commit_sha":"8ad2d05bd355a84a06f1ac4d0d9c59c0a7da787c","position":"1786239869535159001-f2c2c36a-64fc-490f-892f-3d6c7b2a4401"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"07c5f91bd55cb4b4fb2adc7f95eac3bb4eb81be789efc14b4dd32cc3ddaa801f","event_uuid":"d225de55-ecc0-4ee4-a8d8-372256ba37f1","position":{"commit_sha":"33406fe03d49e058901d8a7770aa5b7681ddb25b","position":"1786240116907200001-d225de55-ecc0-4ee4-a8d8-372256ba37f1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Corroboration: Gerrit 1541 (comment-only fixture rationale) hit this exact py3.11 gw3 crash in both CI runs 31244604695 and 31266912051, each after 11,435 passes. This is now reproducible across consecutive runs and continues to spuriously block unrelated changes.","timestamp":1786207480582582001}],"created_at":1786191971481095001,"creation_channel":"cli","deps":[{"link_uuid":"f71d1962-f43f-4b55-8a48-d31e80ab7b1a","relation":"discovered_from","target_id":"ad16-30a7-adb6-454a"},{"link_uuid":"20654528-ae66-4c75-995f-d801d781b292","relation":"relates_to","target_id":"ae1b-b2a0-a080-4b4e"},{"link_uuid":"26504c96-7197-4e23-814f-570547f34316","relation":"relates_to","target_id":"deeb-89c1-1080-4690"}],"description":"## Context\nOn the Gerrit `Verified` gate, `tests/unit/test_opcert_service_app.py` intermittently crashes its pytest-xdist\nworker (`worker gwN crashed`; `[gwN] node down: Not properly terminated`), failing the whole matrix job and\nproducing a spurious `Verified -1`. The failure is a hard worker-process death (not an assertion), lands on a\nRANDOM matrix shard per run (~1 of 4), and is timing/platform-dependent. Observed 4+ consecutive times on\n2026-08-08 blocking change 1545 (ticket ad16), whose diff is markdown/comment-only and cannot touch\n`opcert_service`. Reproduction is CI-only (never locally).\n\n## Root cause\nThe background worker offloads each job with `asyncio.to_thread(jobs.run_job, ...)`\n(`src/rebar/opcert_service/app.py` ~line 77), which runs on the **event loop's global default\n`ThreadPoolExecutor`**. The lifespan teardown (`app.py` ~55-59) cancels and awaits the worker *asyncio task*,\nbut `asyncio.to_thread` exposes no handle to the underlying OS thread, and that thread's disposal is tied to the\nloop's `shutdown_default_executor()`. When the `TestClient` anyio portal tears the fixture down under xdist, the\nloop/portal can close without deterministically disposing the default executor, so a leftover default-executor\nthread is still unwinding when the worker process exits -> `[gwN] node down: Not properly terminated`. The\npreviously-proposed \"make the `with TestClient(...) as c:` exit guaranteed\" change is a no-op (the fixture at\n:44-49 already uses a `with` block).\n\n## Constraint: this must stay consistent with ADR-0067\n`review_bot/app.py`, which this service mirrors, DELIBERATELY keeps `asyncio.to_thread` and accepts the\nun-force-cancellable orphan thread; ADR-0067 (\"review-bot bounded shutdown\") explicitly **rejects an unbounded\n`await`/join at teardown** because a genuinely hung `run_job` would hang shutdown forever. So the fix must NOT\nintroduce a blocking `executor.shutdown(wait=True)` join (that reopens ADR-0067's rejected alternative). The\nchange below is additive: it preserves the bounded/abandon-in-flight property and only makes the executor's\nper-loop disposal DETERMINISTIC.\n\n## Plan (app-owned executor, bounded disposal — `src/rebar/opcert_service/app.py`)\n- In `lifespan` startup, create an app-owned executor:\n  `app.state.executor = concurrent.futures.ThreadPoolExecutor(max_workers=WORKER_COUNT, thread_name_prefix=\"opcert-job\")`.\n- In `_worker`, replace `asyncio.to_thread(jobs.run_job, ...)` with\n  `loop.run_in_executor(app.state.executor, functools.partial(jobs.run_job, ...))` (same call, same\n  `asyncio.wait_for(..., job_timeout_seconds)` wrapper, same result/timeout semantics — no request/response\n  behavior change).\n- In the lifespan `finally`, AFTER the existing bounded task cancel/await, dispose the app-owned executor with a\n  BOUNDED, NON-blocking shutdown: `app.state.executor.shutdown(wait=False, cancel_futures=True)`. This cancels\n  queued futures and lets idle worker threads exit on the sentinel, WITHOUT blocking on an in-flight job\n  (ADR-0067-consistent: abandon in-flight, the process is exiting). Because the executor is owned by the app and\n  disposed INSIDE the lifespan shutdown (which `TestClient` runs before it closes the loop/portal), its threads\n  are handled deterministically at teardown instead of leaking onto the loop's global default executor.\n\nExplicitly REJECTED alternatives (documented so they are not re-litigated):\n- `@pytest.mark.xdist_group` co-location — INERT here: the default suite that runs this unit module uses\n  `--dist worksteal` (`.github/workflows/_build-and-test.yml:653-654`); `xdist_group` only groups under\n  `--dist loadgroup`, which CI uses ONLY for the `-m integration` tier (line 668). Switching the unit lane's\n  dist-mode edits contended CI config, which is out of this epic's non-overlapping scope.\n- `executor.shutdown(wait=True)` blocking join — reopens ADR-0067's rejected unbounded-shutdown alternative.\n\n## Testing\nDeterministic, in-session-evaluable checks (no probabilistic CI dependence, no undeclared tooling):\n- Teardown disposes the app-owned executor (the actual end-state that removes the orphan): a unit test enters the\n  `TestClient` context, exercises a job round-trip, exits the context, then asserts the app-owned executor is\n  shut down (`app_module.app.state.executor._shutdown is True`) and no thread whose name starts with\n  `opcert-job` remains alive\n  (`[t for t in threading.enumerate() if t.name.startswith(\"opcert-job\") and t.is_alive()] == []`).\n- The offload no longer uses the loop's global default executor:\n  `grep -n \"asyncio.to_thread\" src/rebar/opcert_service/app.py` returns `0` matches, and\n  `grep -n \"run_in_executor\\|ThreadPoolExecutor\\|executor.shutdown(wait=False, cancel_futures=True)\" src/rebar/opcert_service/app.py`\n  shows the app-owned executor, its use, and its bounded disposal.\n- Existing HTTP-plumbing tests still pass: `.venv/bin/python -m pytest tests/unit/test_opcert_service_app.py -q`.\n- CI corroboration (monitored, NOT the acceptance oracle since it is probabilistic): the `Verified` matrix shows\n  no `worker gwN crashed` / `node down` line for this module after the change.\n\n## Acceptance Criteria\n- [ ] `src/rebar/opcert_service/app.py` offloads `jobs.run_job` to an app-owned `ThreadPoolExecutor`\n      (`app.state.executor`, `thread_name_prefix=\"opcert-job\"`) via `run_in_executor`, not `asyncio.to_thread`\n      (`grep -n \"asyncio.to_thread\" src/rebar/opcert_service/app.py` returns 0 matches).\n- [ ] The lifespan `finally` disposes that executor with a BOUNDED, non-blocking shutdown consistent with\n      ADR-0067 (no `wait=True` join):\n      `grep -n \"executor.shutdown(wait=False, cancel_futures=True)\" src/rebar/opcert_service/app.py` returns a\n      match and `grep -n \"shutdown(wait=True\" src/rebar/opcert_service/app.py` returns 0 matches.\n- [ ] A deterministic teardown test in `tests/unit/test_opcert_service_app.py` proves the orphan is gone: after\n      the `TestClient` context exits, `app.state.executor._shutdown is True` and no live thread's name starts\n      with `opcert-job`.\n- [ ] `.venv/bin/python -m pytest tests/unit/test_opcert_service_app.py -q` passes (all existing HTTP-plumbing\n      tests plus the new teardown test).\n- [ ] The change is ADR-0067-consistent: it adds no unbounded join and removes no shutdown budget; applying the\n      same refinement to `review_bot/app.py` is explicitly out of scope (its own ticket).","env_id":"4d084713-8164-4b68-9afe-601bbda46966","file_impact":[{"path":"tests/unit/test_opcert_service_app.py","reason":"Harden the TestClient fixture teardown against xdist worker crash (or quarantine-serialize this test)"},{"path":"src/rebar/opcert_service/app.py","reason":"Harden app lifespan/worker-task teardown implicated in the CI-only worker crash"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","2fe0-ce8b-4715-4e07"],["relates_to","ae1b-b2a0-a080-4b4e"],["relates_to","deeb-89c1-1080-4690"]],"no_file_impact_reason":"","parent_id":"2fe0-ce8b-4715-4e07","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"open","tags":[],"ticket_id":"fade-ea90-7564-4715","ticket_type":"bug","title":"Flaky CI: pytest-xdist worker crash on test_opcert_service_app::test_matching_guard_is_accepted","verify_commands":[]},"source_event_uuids":["80cbbf71-9959-4820-9868-4c3c42c3d697","f71d1962-f43f-4b55-8a48-d31e80ab7b1a","e1925144-f3d6-40d9-8539-c565e72d308f","20654528-ae66-4c75-995f-d801d781b292","744b0c91-d93d-451d-b368-d25f231c9454","26504c96-7197-4e23-814f-570547f34316","fc4a77c1-5ad4-43c3-a16b-09c012cb9bfd","1ffbac6a-9b3d-4e3c-a92c-715b8daf5342","4caf712f-2c78-4452-a20c-b7801bd86334","3c58e9ce-23a7-40c0-a0db-34b066c27686","f2c2c36a-64fc-490f-892f-3d6c7b2a4401","d225de55-ecc0-4ee4-a8d8-372256ba37f1"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786240116907200002,"uuid":"9506a67e-c735-49ff-b5c7-feaeff3658de"}