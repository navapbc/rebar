{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787346204334041001,"compiled_state":{"alias":"undamaged-epidermic-kakarikis","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"a3da2f4ccef2599d8858202c49507b9f010e3744","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 58a3-0756-e470-4b40","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (a3da2f4cce)","material: faa96e8806071c4f","verified-at-sha:a3da2f4ccef2599d8858202c49507b9f010e3744"],"material_fingerprint":"faa96e8806071c4f","merged_log_commit":"a3da2f4ccef2599d8858202c49507b9f010e3744","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787342850777524000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"1ab859777a95b6d5573bb96aff863a73e97d6098","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 58a3-0756-e470-4b40","material: faa96e8806071c4f","material-part: children 647ea2107ca5072f 0","material-part: description 0ec3a8da46eefc36 7506","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 1be5a59e91e920a4 6","material-part: ticket_id 65d57c586a54a6d5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (1ab859777a-dirty)","regver: 362a5dd2d2052826","verified-at-sha:13f78e3165b9f9c56626328b91aa4fc242acad24","dep 7a14321d44c335b2a8e24d5d6d81712018bbb217bc4c2846ad9969ddf101e683 docs/adr/0005-snapshot-cache-architecture.md","dep 16b88f0ebaf635820d388fb80a58b0325988b0c98b29832f47676faf6a0be6d2 docs/repo-snapshot-gates.md","dep 4cb744eacd106e469d25af6af59c6dcc49db68c858fe8f90fa83c9d2b39a1e74 src/rebar/_snapshot/__init__.py","dep absent src/rebar/_snapshot/gc_trigger.py","dep acc088a7a0a1946a725018047f2a234c4f9ea1ebb2fa09e247380b1d037c6333 src/rebar/llm/gate_source.py","dep absent tests/unit/test_snapshot_gc_trigger.py","read-set: 10","read-path: docs/concurrency.md","read-path: docs/config.md","read-path: docs/plan-review-gate.md","read-path: src/rebar/_commands/compact_trigger.py","read-path: src/rebar/_proc.py","read-path: src/rebar/_snapshot/__init__.py","read-path: src/rebar/_snapshot/janitor.py","read-path: src/rebar/_snapshot/repo_snapshot.py","read-path: src/rebar/llm/gate_source.py","read-path: src/rebar/review_bot/app.py","currency-basis: file_impact"],"material_fingerprint":"faa96e8806071c4f","merged_log_commit":"13f78e3165b9f9c56626328b91aa4fc242acad24","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787336349462204000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"eac14786e57da0354c0b8b5a7c893b014687772bc64a88930e70d9b4d4739980","event_uuid":"cf04ab1b-64b7-43b1-83d7-80cc6262f7c5","position":{"commit_sha":"38031490e8e0afe0b7948eeefc87d067b53892f7","position":"1787335368477430001-cf04ab1b-64b7-43b1-83d7-80cc6262f7c5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"358d9149b2ef1b0fc86541b9c5aaaeab729