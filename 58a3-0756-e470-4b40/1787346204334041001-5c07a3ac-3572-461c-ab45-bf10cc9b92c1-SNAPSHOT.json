d.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"791870deabfc94383fa796e311a8a6214d9bed83a8d133a3ff65db66e73d32a3","event_uuid":"1254fae9-a49f-4334-8111-3bde2b4d42ac","position":{"commit_sha":"99e2677323aaeea13c0111a0b4b781aaa56cec0e","position":"1787342248075273001-1254fae9-a49f-4334-8111-3bde2b4d42ac"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"bc65ac98497eacf1b7414cbf9fbbcc4442bfb240f0e6429eee7156ca5a570292","event_uuid":"5001981c-c3fc-4f82-b1b6-1980178e4c17","position":{"commit_sha":"4491fb028cfc8797d07a0129334f28ef710e3d92","position":"1787342847328263001-5001981c-c3fc-4f82-b1b6-1980178e4c17"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3db7087496846bf122c745556dc9e4450dbb42b7bdb50971c8567d4d8f95a2e6","event_uuid":"abb0ec1a-bd2d-4eea-8542-6b408ffd8de2","position":{"commit_sha":"45e60cbea2b55f83853bc2747359eaf8bcee0552","position":"1787342850791213001-abb0ec1a-bd2d-4eea-8542-6b408ffd8de2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OPERATOR RULING (recorded verbatim on the operator's behalf, before design work): \"An operation-linked GC trigger is a reasonable approach, BUT we have encountered issues with long locks blocking the ticket store on local operations — the design must avoid that pitfall, likely using the same pattern we used to fix that issue.\"\n\nThe prior art the ruling points at: closed bug 0d15-59a4-* (\"Sweep walks full git history per ticket under the store lock\") and the compaction trigger's fix pattern in src/rebar/_commands/compact_trigger.py — a near-free in-process check on the tail of the operation, then the heavy work in a DETACHED child outside the calling operation and outside any store lock, with stamp/lock sidecars keyed on the canonical store (dae7f62696) and a durable child cwd (_proc.detached_child_cwd, d575600381), plus the O(1) marker fast-path discipline from a02eedbb6e. The design for this ticket must mirror that pattern: the trigger check itself must hold NO ticket-store lock and must not scale with store size; the GC pass runs detached under the snapshot store's own gc flock.","timestamp":1787335368477430001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented per the operator-ruled design and pushed: Gerrit change 2014 (commit 7ea68f0a12) — https://rebar.solutions.navateam.com/c/rebar/+/2014\n\nDesign as landed: new rebar._snapshot.gc_trigger mirrors compact_trigger applied to janitor.run_gc. resolve_gate_handle's attested tail calls maybe_gc — one stat of <store>/gc/last-pass.stamp against the janitor interval_seconds (0 disables), no ticket-store lock in any branch, never raises. When due, a detached child (cwd = the per-host store root) runs the existing run_gc policy under a stamped <store>/gc/worker.lock sidecar (shared stamped_file_is_stale adjudication) plus run_gc's own gc flock; a stand-aside (skipped=\"locked\") does not reset the stamp. Sidecars live in the snapshot store itself — per-host and already canonical, so all worktrees share one clock/lock. Review-bot resident janitor untouched; overlap harmless by construction.\n\nRED→GREEN: tests/unit/test_snapshot_gc_trigger.py (15 tests) — trigger fires on due/missing stamp, gate-resolution wiring (attested fires, local does not), O(1) quiet path (no store enumeration, ticket-store lock patched to fail loudly), single-flight (live lock respected, stale lock reclaimed, run_gc overlap stands aside AND keeps the clock), headline AC end-to-end reclamation on a simulated non-review-bot host, detach argv/cwd/stdio contract, dead-repo-root survival. All RED at collection before the module existed, GREEN after.\n\nVerification: make lint clean, mypy 620 files clean, complexity ratchet new=0 increased=0, targeted suites (snapshot janitor/cache/docs + gate seam tests) pass. One test batch showed a non-reproducing setup ERROR in test_gate_context_seam — traced to my own concurrent 'make typecheck' in the same worktree (mypy running over src while pytest scanned it); 2/2 serial re-runs clean, not a repo bug.\n\nDocs: repo-snapshot-gates.md now documents both GC drivers + the operator force path; ADR 0005 D5 amended (one marker stat in-line; the pass itself stays off every hot path).\n\nNext: wait for LLM-Review +1 AND Verified +1 on 2014, Submit, then close.","timestamp":1787337087056651001}],"created_at":1787266164422457001,"creation_channel":"cli","deps":[{"link_uuid":"33e7513d-66e0-4c1a-82e3-8b078ebb8c96","relation":"discovered_from","target_id":"3907-0110-7688-43bd"},{"link_uuid":"860d7831-33d7-44b2-bc90-31eb5dedc1a0","relation":"relates_to","target_id":"532f-45f6-0d51-48f0"},{"link_uuid":"7c8d60be-38fe-4304-a2f6-65d15c4044aa","relation":"relates_to","target_id":"dcdd-a35b-d052-4f3e"},{"link_uuid":"907429a5-50ba-4072-b94b-ba6a9cc96216","relation":"relates_to","target_id":"69c5-8811-8b70-47c2"}],"description":"## Discovered from\n\nrebar-debug on bug `itchy-arbored-peccary` (3907-0110-7688-43bd), while verifying a handed-in\nclaim that the janitor had no caller. It has one — but exactly one.\n\n## Context / Problem\n\n`start_background_janitor` has a single production invocation: the review-bot's FastAPI\nlifespan (`src/rebar/review_bot/app.py:134-136`). So the janitor — the ONLY thing that\nreclaims `$REBAR_GATE_TMPDIR/rebar-gate-snapshots` — runs only inside the long-lived\nreview-bot server process. Every other host that resolves an attested gate (a developer\nlaptop running `rebar review-plan` / `review-code` / `verify-completion`, a CI runner, any\nlibrary embedding that is not the review-bot app) populates the snapshot store and never\nreclaims it. Measured on one developer host: 64,021 entries, 47.24 GiB, nothing ever\nreclaimed. Bug 3907 fixed the *policy* (the `max_bytes` byte-total cap); this ticket is the\n*cadence* — on a non-review-bot host there is no pass to apply the policy.\n\n## Operator ruling (design constraint)\n\nRecorded verbatim in the comment below: an operation-linked GC trigger is acceptable, BUT it\nmust avoid the long-lock pitfall we hit before (bug `0d15-59a4` — a sweep holding the ticket\nstore lock for minutes), by using the same pattern that fixed it: a near-free in-process\ncheck on the tail of the operation, heavy work in a DETACHED child, stamp/lock sidecars for\ncadence and single-flight.\n\n## Approach\n\nMirror `src/rebar/_commands/compact_trigger.py` — the compaction sweep's operation-linked\ntrigger, the pattern that fixed 0d15-59a4 — applied to the EXISTING snapshot-GC policy\n(`janitor.run_gc`: hysteretic watermark, grace window, cold-trim, `max_bytes` backstop).\n\nNew module `src/rebar/_snapshot/gc_trigger.py`:\n\n- **Sidecars keyed on the snapshot store root** (`<store>/gc/last-pass.stamp` and\n  `<store>/gc/worker.lock`), not on any repo/worktree path — the store is per-host and\n  already canonical, so two worktrees of one repo share one clock and one lock (the\n  dae7f62696 discipline, applied where this store actually lives).\n- **`maybe_gc(repo_root)` — the operation-linked trigger.** Called on the tail of gate\n  resolution (`gate_source.resolve_gate_handle`, the single choke point every attested gate\n  op flows through — review-plan, verify-completion, review-code, scan-spec, workflows), for\n  attested handles only. Its decision is O(1): one `stat` of the stamp (a02eedbb6e's marker\n  fast-path discipline — no store enumeration, nothing that grows with entry count) against\n  the janitor's existing `interval_seconds` cadence knob (`<= 0` disables the trigger). It\n  takes NO ticket-store lock — it never imports or touches `rebar._store.lock` — and never\n  raises (never fails the gate that triggered it).\n- **Detached child** (`_spawn_detached_gc`, mirroring `_spawn_detached_sweep`): PYTHONPATH\n  bootstrap, stdio to a log under `<store>/gc/`, durable cwd anchored at the snapshot store\n  root (the d575600381 concern: never inherit an ephemeral worktree cwd), POSIX-only v1\n  (win32 no-op, exactly like compact_trigger and enrich_drain).\n- **Single-flight**: the trigger probes `worker.lock` (an `O_EXCL` file carrying the v2\n  owner stamp, adjudicated by `lock_owner.stamped_file_is_stale` — pid-recycle\n  qualification and stale reclamation inherited, not re-invented) before spawning, and the\n  child re-acquires it for real. `run_gc` additionally holds its own non-blocking `flock` on\n  `<store>/gc/lock`, so overlap with the review-bot's resident janitor is harmless by\n  construction (the loser returns `skipped=\"locked\"`).\n- **The stamp records only an actual pass** (the `run_sweep` lesson: a stand-aside must not\n  reset the clock): the child stamps `last-pass.stamp` only when `run_gc` ran\n  (`skipped is None`). The review-bot's resident janitor is untouched and keeps running;\n  because its passes go through the same `run_gc`, hosts where it runs simply see fresh\n  passes and the op-linked trigger stays quiet.\n\nADR 0005 D5 (\"never invoked from populate/read\") holds in spirit and is amended with a note:\nthe trigger check on the gate-resolution tail is one stat, and the pass itself runs in a\ndetached child off every hot path.\n\nPortability (`project.portability`): the trigger is operation-linked and in-process — it\nrequires no CI provider, no cron, no daemon; the review-bot's resident thread remains a\nsupplementary cadence, not the floor.\n\n## Scope\n\n- `src/rebar/_snapshot/gc_trigger.py` (new): stamp/lock sidecar helpers, `maybe_gc`,\n  `_spawn_detached_gc`, `run_detached` (the child entry point).\n- `src/rebar/_snapshot/__init__.py`: export `maybe_gc`.\n- `src/rebar/llm/gate_source.py`: call `maybe_gc` on the tail of `resolve_gate_handle`\n  (attested handles only, never-raise).\n- `tests/unit/test_snapshot_gc_trigger.py` (new).\n- `docs/repo-snapshot-gates.md`: document when a pass runs on a non-review-bot host and how\n  an operator forces one (run the trigger's child entry point / set the interval).\n- `docs/adr/0005-snapshot-cache-architecture.md`: D5 amendment note.\n\n## Testing\n\nRED-first (tests written and failing before the implementation), mirroring\n`tests/unit/test_compact_trigger.py`'s style (monkeypatched spawn capture; fake-`Popen`\nargv capture for the detach contract):\n\n- **Trigger fires**: with a stale/missing stamp, `maybe_gc` spawns the detached GC; a\n  gate-resolution wiring test asserts `resolve_gate_handle` invokes the trigger for an\n  attested handle and not for a local one.\n- **Near-free + lock-free on the quiet path**: with a fresh stamp, `maybe_gc` performs no\n  directory enumeration of the store (does not scale with entry count) and touches no\n  ticket-store lock (the store-lock acquire is patched to fail loudly).\n- **Single-flight under contention**: a held `worker.lock` suppresses the spawn; a live\n  lock is respected, a provably-stale one is reclaimed; overlap with a concurrent `run_gc`\n  degrades to `skipped=\"locked\"`.\n- **Reclamation on a simulated non-review-bot host (the headline AC)**: a store with a cold\n  entry and no resident janitor, spawn patched to run the child entry point inline →\n  the entry is evicted and the stamp records the pass; a second immediate trigger stays\n  quiet (failure/empty path: fresh stamp → no spawn, nothing evicted).\n- **Detach contract**: fake `Popen` captures argv/kwargs — the child is handed the resolved\n  store root, cwd is the durable store root, stdio is detached.\n\n## Acceptance Criteria\n\n- [x] A host that runs attested gates WITHOUT the review-bot server reclaims its snapshot\n      store: a gate resolution on a due stamp spawns a detached `run_gc` pass.\n- [x] The trigger check is O(1) on the quiet path — no store enumeration, no ticket-store\n      lock, never raises into the gate — and the GC pass itself runs in a detached child\n      off the gate's critical path (ADR 0005 D5 amended with the reasoning).\n- [x] The trigger is operation-linked and in-process — not dependent on any CI provider,\n      cron, or daemon (`project.portability`).\n- [x] Single-flight across simultaneous hosts/worktrees: stamped worker-lock sidecar +\n      `run_gc`'s existing gc flock; double-running with the review-bot's resident janitor\n      is harmless (`skipped=\"locked\"`), and the resident janitor is not regressed.\n- [x] A test observes reclamation happening on a simulated non-review-bot host — RED before\n      the change, GREEN after.\n- [x] `docs/repo-snapshot-gates.md` documents when a pass runs and how an operator forces\n      one.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_snapshot/gc_trigger.py","reason":"new: operation-linked GC trigger (stamp/lock sidecars, maybe_gc, detached child)"},{"path":"src/rebar/_snapshot/__init__.py","reason":"export maybe_gc"},{"path":"src/rebar/llm/gate_source.py","reason":"call maybe_gc on the tail of resolve_gate_handle"},{"path":"tests/unit/test_snapshot_gc_trigger.py","reason":"new: RED-first trigger/single-flight/reclamation tests"},{"path":"docs/repo-snapshot-gates.md","reason":"document the op-linked GC pass + operator force path"},{"path":"docs/adr/0005-snapshot-cache-architecture.md","reason":"D5 amendment note"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","532f-45f6-0d51-48f0"],["relates_to","69c5-8811-8b70-47c2"],["relates_to","dcdd-a35b-d052-4f3e"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5001981c-c3fc-4f82-b1b6-1980178e4c17","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"58a3-0756-e470-4b40","ticket_type":"bug","title":"Snapshot janitor runs only in the review-bot process; every other host's store is append-only","verify_commands":[]},"source_event_uuids":["cf04ab1b-64b7-43b1-83d7-80cc6262f7c5","0ed9833e-192a-46d2-b8a7-6f45cc1a66d1","76a47997-5a4c-4318-83ef-147546c22da4","95a5c8af-5d0a-4f19-8503-7ce1e3c368e9","1de66cff-49de-4627-a2ce-fea324eead74","983610ba-a7cd-4aac-900d-36241997f8bd","b24d4afc-4f0a-44c6-bf4b-681d4a7c5eb4","860d7831-33d7-44b2-bc90-31eb5dedc1a0","7c8d60be-38fe-4304-a2f6-65d15c4044aa","907429a5-50ba-4072-b94b-ba6a9cc96216","1254fae9-a49f-4334-8111-3bde2b4d42ac","5001981c-c3fc-4f82-b1b6-1980178e4c17","abb0ec1a-bd2d-4eea-8542-6b408ffd8de2"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787346204334041001,"uuid":"5c07a3ac-3572-461c-ab45-bf10cc9b92c1"}