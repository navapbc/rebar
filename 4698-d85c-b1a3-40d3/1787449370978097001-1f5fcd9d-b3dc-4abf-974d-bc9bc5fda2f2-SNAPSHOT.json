b74b05","position":{"commit_sha":"a470b7866fd0548123f92d133eccbf68848a68ca","position":"1787438337861453001-c1e50978-b6c1-4605-a78f-60582bb74b05"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5270992f3958d60f2719ae7fac25d51a0b541875a7174e63ffade58b9b8a8398","event_uuid":"877ef64a-fb05-41b0-a84c-5caa77f78591","position":{"commit_sha":"bd55d8e1af510862dfa5937bc72f9a2681ca27ee","position":"1787441828191180001-877ef64a-fb05-41b0-a84c-5caa77f78591"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d7e6bbac417c6faf129b66cc0d4ad3746cefc4bcb9b007c2ae8eb3048518e4fc","event_uuid":"53b28085-de27-4758-8771-9f7c9fb2516d","position":{"commit_sha":"f0530935f43f683b351ef984c072d0576d57ddcf","position":"1787441865170279001-53b28085-de27-4758-8771-9f7c9fb2516d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator decision (2026-08-19): APPROVED on both sub-questions.\n\n(1) build_backend symmetry — YES, _build_datacenter SHOULD assert non-secret scope readiness (url/project) at build, while keeping PAT and network validation lazy in _LazyDataCenterClient. Asserting only the non-secret half preserves the property that composing a DC backend needs neither the [agents] extra nor a JIRA_PAT, so the design intent behind the lazy client is not lost while the asymmetry with _build_cloud is removed.\n\n(2) assert_cloud_scope_ready strictness — KEEP STRICTER, and document it as an intended tightening rather than relaxing to match the legacy ambient assert_env_ready. These checks catch real misconfigurations: an email is genuinely required for Cloud Basic auth, and an empty query_project would query every project on the instance. Real Cloud deployments already satisfy both. Relaxing to match legacy would trade a working guard for consistency with the weaker of the two paths — the wrong direction. The path-dependent difference should be closed by documenting the stricter behavior as canonical, not by weakening it.","timestamp":1787173844280937001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed via Gerrit change 2124 (Change-Id I1112a0230443d8b90d25410e8db1d27a2aba35c8), MERGED to main as 4e2b4dfb3cf with LLM-Review +1 and Verified +1, 0 unresolved comments. Evidence: assert_datacenter_nonsecret_scope_ready added to runtime.py and called at the top of _build_datacenter (before the injected-transport early return); PAT/network validation stays lazy in _LazyDataCenterClient; assert_cloud_scope_ready + JiraBackend.assert_env_ready docstrings document the intended stricter-than-legacy tightening. Verified in worktree fix-rp04-pair: tests/unit/rebar_reconciler/test_operation_bindings_runtime.py 8 passed 3 skipped; make lint PASS; make typecheck PASS (mypy 638 files clean); complexity ratchet clean via make lint. All four acceptance criteria ticked.","timestamp":1787438337861453001}],"completion_expectation":"required","created_at":1787026925175141001,"creation_channel":"cli","deps":[{"link_uuid":"3948d4b4-be8c-4c0f-b8a9-f4f249d39d8d","relation":"discovered_from","target_id":"e042-4780-6c63-4b09"},{"link_uuid":"f371dad1-693b-46bc-84c3-e245595da0e5","relation":"relates_to","target_id":"758d-0551-704a-4ba8"}],"description":"## Context / Problem\nFrom Gerrit 1843 PS3 LLM-Review advisories on the RP-04 S2 runtime (e042). Two fail-closed nuances in src/rebar/_engine/rebar_reconciler/runtime.py, both decided by the operator on 2026-08-19 (see approval comment): (1) build_backend is asymmetric — _build_cloud calls assert_cloud_scope_ready at build, but _build_datacenter defers ALL validation to the lazy _LazyDataCenterClient; (2) assert_cloud_scope_ready is deliberately stricter than the legacy ambient assert_env_ready (JIRA_USER-must-be-email, non-empty project), and that tightening is undocumented.\n\n## Approach\nImplement the operator's two approved decisions exactly:\n\n1. **DC build-time non-secret scope assert.** Add `assert_datacenter_nonsecret_scope_ready(scope)` to runtime.py that raises the typed BackendEnvError when the DC base url (`reconciler.base_url`) is empty or the read/write project scope (`jira.project`) is empty — mirroring assert_cloud_scope_ready's project checks. Call it at the top of `_build_datacenter` (same placement as Cloud's assert in `_build_cloud`, before the injected-transport early return). PAT presence and network validation stay lazy in _LazyDataCenterClient / build_client_from_settings, so composing a DC backend still needs neither the [agents]/jira extra nor a JIRA_PAT. The existing full `assert_datacenter_scope_ready` (url + JIRA_PAT, used by JiraDataCenterBackend.assert_env_ready) keeps its behavior and its every-missing-essential-in-one-message property.\n\n2. **Document the stricter Cloud checks as intended.** Extend the assert_cloud_scope_ready docstring (and JiraBackend.assert_env_ready's scope-path note in adapters/jira/backend.py) to state the captured-scope path is DELIBERATELY stricter than the legacy ambient assert_env_ready — the email-format check (Cloud Basic auth requires the account email) and the non-empty-project check (an empty project would query every project) are canonical, an intended tightening, not accidental drift; the legacy ambient path is the compatibility floor.\n\nDefault assumed from the approval: the non-secret assert checks base_url + project/query_project only (never auth_present); it runs even when a test transport is injected, matching Cloud's placement.\n\n## Scope\n- src/rebar/_engine/rebar_reconciler/runtime.py — new assert_datacenter_nonsecret_scope_ready; _build_datacenter calls it; assert_cloud_scope_ready docstring documents the intended tightening.\n- src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py — assert_env_ready docstring: scope path is intentionally stricter (docstring-only).\n- tests/unit/rebar_reconciler/test_operation_bindings_runtime.py — new fail-closed/lazy-preserved DC build tests.\n\n## Testing\nUnit tests in tests/unit/rebar_reconciler/test_operation_bindings_runtime.py:\n- happy/lazy path: a DC compose+build with base_url + project set but NO JIRA_PAT still constructs the backend (PAT stays lazy) — run with `pytest tests/unit/rebar_reconciler/test_operation_bindings_runtime.py`.\n- failure path: DC build with empty base_url raises BackendEnvError naming url before any client/transport work; DC build with empty jira.project raises BackendEnvError naming the project scope.\nExisting suites (test_operation_bindings_runtime.py, tests/interfaces/store/test_reconciler_operation_bindings.py, DC backend tests) keep passing unchanged.\n\n## Acceptance Criteria\n- [x] `_build_datacenter` asserts non-secret DC scope readiness (base_url + project) at build via a typed BackendEnvError, verified by the new unit tests failing-closed on empty url/project.\n- [x] A DC backend still composes and builds WITHOUT JIRA_PAT and without the jira extra import at build time, verified by the new lazy-preserved unit test passing with JIRA_PAT unset.\n- [x] assert_cloud_scope_ready's stricter-than-legacy checks (email-format JIRA_USER, non-empty project) are documented in its docstring as an intended, canonical tightening, verified by reading the docstring in the diff.\n- [x] make lint, make typecheck, targeted reconciler tests, and scripts/check_complexity_baseline.py --check (new=0 increased=0) all pass, verified by running them in the worktree.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/runtime.py","reason":"add assert_datacenter_nonsecret_scope_ready, call it from _build_datacenter, document the intended Cloud tightening in assert_cloud_scope_ready"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"docstring-only: note the scope-path assert_env_ready is intentionally stricter than the legacy ambient path"},{"path":"tests/unit/rebar_reconciler/test_operation_bindings_runtime.py","reason":"new fail-closed and lazy-preserved DC build tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","758d-0551-704a-4ba8"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"877ef64a-fb05-41b0-a84c-5caa77f78591","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"4698-d85c-b1a3-40d3","ticket_type":"task","title":"RP-04 follow-up: align reconciler Cloud/DC fail-closed symmetry and scope-vs-ambient readiness parity","verify_commands":[]},"source_event_uuids":["ebfba6bb-e754-4516-8966-c76476d4f501","8ca7a28c-d8de-49be-ad92-8d5b7d3481f0","d0d14d74-aa13-4cf2-be1a-3cc169a32149","7b2e3f50-5ad0-42a6-b567-fbf548eb40bd","6e88f374-e972-437b-8cdf-32bdb7c4ad86","55410b60-27c7-45e9-a161-1762d9997d28","f371dad1-693b-46bc-84c3-e245595da0e5","1974b673-0272-4986-aeda-f6780d45c242","c1e50978-b6c1-4605-a78f-60582bb74b05","877ef64a-fb05-41b0-a84c-5caa77f78591","53b28085-de27-4758-8771-9f7c9fb2516d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787449370978097001,"uuid":"1f5fcd9d-b3dc-4abf-974d-bc9bc5fda2f2"}