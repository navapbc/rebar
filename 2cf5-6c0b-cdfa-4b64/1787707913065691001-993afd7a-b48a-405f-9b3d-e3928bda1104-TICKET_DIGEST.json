{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b06b4bb56cb35ae6c8ccf3dd2adb925da712d6c84371ff823d13c56a992c8290","digest":{"component_or_area":"gitignore / build artifact exclusion","key_entities":[".gitignore",".provision.log","com.navapbc.rebar-worktree-gc",".venv","__pycache__",".pytest_cache",".ruff_cache"],"problem_keywords":["gitignore","provisioning artifact","worktree gc","untracked file","git status"],"propositions":[".provision.log is written during venv provisioning but not listed in .gitignore, causing git status --porcelain to report untracked files","worktree GC refuses to reclaim worktrees with non-empty git status, causing .provision.log to permanently pin worktrees",".provision.log is a provisioning artifact with no post-build purpose and should never be committed","adding .provision.log to .gitignore alongside other provisioning noise entries (.venv, __pycache__, etc) allows worktrees to be garbage collected after idleness"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787707913065691001,"uuid":"993afd7a-b48a-405f-9b3d-e3928bda1104"}