{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b06b4bb56cb35ae6c8ccf3dd2adb925da712d6c84371ff823d13c56a992c8290","digest":{"component_or_area":"repository configuration (.gitignore)","key_entities":[".gitignore",".provision.log","com.navapbc.rebar-worktree-gc",".venv/","__pycache__/",".pytest_cache/",".ruff_cache/"],"problem_keywords":["gitignore","provisioning artifact","worktree gc","untracked file","git status"],"propositions":[".provision.log is written during venv provisioning but not listed in .gitignore, causing git status --porcelain to report it as untracked","worktree gc refuses to reclaim worktrees with non-empty git status, permanently pinning worktrees that contain only .provision.log","the .provision.log file is a provisioning artifact containing build output that should never be committed and is never read after provisioning","adding .provision.log to .gitignore with an unanchored pattern allows it to be matched at any directory depth, consistent with existing provisioning artifact entries"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787871718597448001,"uuid":"74346ee5-089f-4312-912c-66295477cebb"}