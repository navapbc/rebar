{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b06b4bb56cb35ae6c8ccf3dd2adb925da712d6c84371ff823d13c56a992c8290","digest":{"component_or_area":".gitignore / build artifacts","key_entities":[".gitignore",".provision.log",".venv/","__pycache__/",".pytest_cache/",".ruff_cache/","com.navapbc.rebar-worktree-gc"],"problem_keywords":["gitignore","provision log","worktree","untracked file","git status","provisioning artifact"],"propositions":[".provision.log is written during venv provisioning but not listed in .gitignore, causing git status --porcelain to remain non-empty","worktrees with only .provision.log as untracked file cannot be garbage collected due to the dirty-state safety guard, permanently pinning them",".provision.log is a pure build/provisioning artifact that should never be committed and is never read after provisioning","adding .provision.log to .gitignore alongside other provisioning noise entries will allow worktrees to be correctly identified as clean and eligible for garbage collection"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787394587483925001,"uuid":"88eecb5b-927d-49b5-9b5b-def813194783"}