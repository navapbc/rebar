{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b06b4bb56cb35ae6c8ccf3dd2adb925da712d6c84371ff823d13c56a992c8290","digest":{"component_or_area":"repository configuration / worktree lifecycle","key_entities":[".gitignore",".provision.log","com.navapbc.rebar-worktree-gc",".venv/","__pycache__/",".pytest_cache/",".ruff_cache/"],"problem_keywords":["gitignore","provisioning artifact","worktree","untracked file","garbage collection"],"propositions":[".provision.log is written by venv provisioning but not ignored, causing git status --porcelain to report untracked files permanently","worktree garbage collection refuses to reclaim worktrees with non-empty git status, causing .provision.log to pin worktrees indefinitely regardless of idleness","adding .provision.log to .gitignore next to other provisioning artifacts allows git to ignore the file and enables worktree garbage collection to proceed","the .provision.log pattern must be unanchored to match the file at any directory depth where the provisioner runs"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787547902594623001,"uuid":"4912cd81-736c-4d6b-aff0-56e3d4ca63e2"}