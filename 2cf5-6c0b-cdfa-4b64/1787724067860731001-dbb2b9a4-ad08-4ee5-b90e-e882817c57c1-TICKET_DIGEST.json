{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b06b4bb56cb35ae6c8ccf3dd2adb925da712d6c84371ff823d13c56a992c8290","digest":{"component_or_area":".gitignore configuration","key_entities":[".gitignore",".provision.log",".venv/","__pycache__/",".pytest_cache/",".ruff_cache/","com.navapbc.rebar-worktree-gc"],"problem_keywords":["gitignore","provisioning artifact","worktree gc","untracked files","git status"],"propositions":[".provision.log is written to worktree during venv provisioning but not listed in .gitignore, causing git status --porcelain to report untracked files","worktree GC refuses to reclaim worktrees with non-empty git status, causing .provision.log to pin worktrees permanently and prevent garbage collection",".provision.log is a pure build/provisioning artifact that is never read after provisioning and should never be committed","adding .provision.log to .gitignore next to other provisioning noise entries prevents the file from blocking worktree garbage collection"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787724067860731001,"uuid":"dbb2b9a4-ad08-4ee5-b90e-e882817c57c1"}