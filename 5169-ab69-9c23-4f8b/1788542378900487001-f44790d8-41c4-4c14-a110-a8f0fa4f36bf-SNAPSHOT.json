ger":[{"content_hash":"62d871e2a408001fe3c365be64b93903b9e66056fc8b91f0c78e4a88bdb175b2","event_uuid":"2dbce9f2-bdb5-4479-9551-42de4335b8a2","position":{"commit_sha":"23e2b81b262ea61645839095332370be1478df46","position":"1788494446111191001-2dbce9f2-bdb5-4479-9551-42de4335b8a2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e57cba9b8f8e15ed7a08468d44632534fda609da5bc952868c19b1360c125be0","event_uuid":"a555b0e8-08e7-4fb6-bca4-d6bb905596f0","position":{"commit_sha":"5952c08e3b59b9ac5bd4d06b244f32c6cf3d5c27","position":"1788494465110201001-a555b0e8-08e7-4fb6-bca4-d6bb905596f0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"73e27970305175da31154d3ebea3557675f2e48600d1a473de18aa1081e1533a","event_uuid":"875c5f67-5a24-4c78-84bc-956012eb3c29","position":{"commit_sha":"81fb91ed2fd9be04b3ca7e348d685080cf99b656","position":"1788494943432645001-875c5f67-5a24-4c78-84bc-956012eb3c29"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c9b48fea044670ad64cb48e6814692ff8c09ce25fe4223bfb28539ff6db3734e","event_uuid":"5c468c0c-dda7-4687-a8f6-d24a20ec9562","position":{"commit_sha":"23d3f93ccf50b4bb92f89d48200e0c8a757abd7a","position":"1788494978484209001-5c468c0c-dda7-4687-a8f