ar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fc7c47494929438233065b820eae15d5235d243c68eb5405db545b485e763a47","event_uuid":"1d992cd0-8e40-4148-a22b-da92a30a9904","position":{"commit_sha":"60d1b4c6ead88b83f67b19650fb24cac05a6e1af","position":"1785772649726569001-1d992cd0-8e40-4148-a22b-da92a30a9904"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2f5118fc37d6be11ac3e8c4416a52fcbcb6f7c420d045c385443a9f0d3b35cc4","event_uuid":"15063e52-dfe8-46c2-a3a5-f34a26334324","position":{"commit_sha":"60d1b4c6ead88b83f67b19650fb24cac05a6e1af","position":"1785772650887115001-15063e52-dfe8-46c2-a3a5-f34a26334324"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f966009f49aa1d329ba11bc1060d82d73d9ffb8d0507ea5676c62530e3bd7732","event_uuid":"0964c795-9595-474f-bfdf-6770627f847a","position":{"commit_sha":"63d53f6758c56bf5a1a9cf145d5a1506233c6bc4","position":"1785774764580671001-0964c795-9595-474f-bfdf-6770627f847a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Drift update after origin/main refresh (50 commits): cc77-8120 (typed reconciler transports) has LANDED and CLOSED (commits 6072eeb, 2791391, 48756f3, b022725). The Context line 'separate in-flight work — do not duplicate' is now historical: the typed port exists, so the property tests in this ticket should BUILD ON the landed typed transport surface rather than avoid it. Also corrected file_impact: the shared paged-iterator seam is src/rebar/_engine/rebar_reconciler/fetcher.py (not adapters/jira/fetcher.py — that path never existed; citation error at creation). acli_graph.py pagination (nextPageToken cursor loop, ~:194-:271) verified present on current main.","timestamp":1785706533044154001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation pushed: Gerrit change 1297 (commit defacafc6d). Registry src/rebar/_engine/rebar_reconciler/_field_contract.py (176 LOC): 11 fields declared across bidirectional/add_wins/one_way_gated; conflict_class mirrors conflict_resolver.FIELD_CLASSES; links/parent name should_propagate_removal as removal gate; status declares lossy_values={blocked,cancelled,deleted}. Property tests tests/unit/rebar_reconciler/test_field_contract_properties.py (16 tests, all green): import-time coverage guard (FIELD_CLASSES + _OUTBOUND_TO_INBOUND_FIELD -> collection failure on undeclared field), conflict-class parity, status roundtrip on canonical preimages + computed-residue==declared-lossy (both directions), link_direction involution + resolve_inbound_link, reducer TAG_DELTA add-wins (in-both stays added, replay idempotent, plain remove applies), gate managed/unmanaged/malformed. docs/architecture.md registration-contract paragraph added. Mutation checks per plan verified: flip labels class -> test_core_field_classes_pinned FAILS by name; delete watchers entry -> collection ERROR; restored -> 16 pass. Full reconciler unit suite: 2033 passed, 1 pre-existing env-dependent failure (test_ref_lock roundtrip, fails on stashed clean tree too — unrelated). Lint/format/mypy green. Note: today's main landed 6baa030460 + revert 2241e3d189 (inbound parent clear destroyed data) — a live instance of exactly the asymmetry class this registry pins (parent is one_way_gated; removal only via managed-ref gate).","timestamp":1785774764580671001}],"created_at":1785640092677590001,"creation_channel":"cli","deps":[{"link_uuid":"c736f38d-07de-4501-bf45-83ae17453d64","relation":"relates_to","target_id":"cc77-8120-bcc6-47e8"},{"link_uuid":"525c0009-b05c-4620-8972-a65f9a7e3ef6","relation":"relates_to","target_id":"496a-d258-db7d-42da"}],"description":"## Context / Problem\nReconciler parity bugs (3f04, 4b59, 32cc class: inverted link directions, asymmetric field handling) escape because per-field asymmetry POLICY lives scattered in code with no single declarative source: the should_propagate_removal gate (rebar.reducer._managed_refs) is imported at four separate reconciler sites, add-wins tag merging is an inline dedup in apply_inbound_records.py, and inbound_differ carries only a 2-entry field-NAME canonicalization map (_OUTBOUND_TO_INBOUND_FIELD). No enumerable \"field contract\" exists yet — this ticket CREATES it. The typed-transport half of this hardening already landed as bug cc77 (closed; Gerrit 1222-1225 merged) — do not duplicate it. Pagination-iterator consolidation was split out of this ticket into its own child (see discovered_from link) after plan review flagged the bundle.\n\n## Approach\n(1) MATERIALIZE the contract: new module src/rebar/_engine/rebar_reconciler/_field_contract.py — a declarative registry enumerating each reconciled field with its symmetry class (bidirectional-roundtrip / add-wins / one-way-with-propagation-gate) plus references to its codec/gate (e.g. should_propagate_removal for managed refs, the tag dedup for add-wins). The module docstring records this as the cross-cutting registration contract for future fields, and a one-paragraph pointer is added to the reconciler section of docs/architecture.md so new call sites know to register (captures the new convention durably).\n(2) Property tests parameterized OFF the registry: tests/unit/rebar_reconciler/test_field_contract_properties.py. Coverage guard: the test module enumerates the reconciled fields handled by inbound_differ/apply_inbound_records and fails collection if any handled field lacks a registry entry (adding a field without declaring its class breaks the build). Per-class properties: roundtrip identity asserted ONLY for declared-bidirectional value codecs (status mapping, link inward/outward direction); add-wins fields get a merge-idempotence + no-removal property; one-way-gated fields get a gate-consulted property (behavior asserted consistent with should_propagate_removal through the real call path).\n(3) NO behavior refactor: the registry declares, tests assert code behavior MATCHES declarations. Rewiring call sites to import the registry is explicitly out of scope (follow-up candidate if drift recurs); this keeps the change additive and low-risk.\n\n## Scope\n- src/rebar/_engine/rebar_reconciler/_field_contract.py (new, declarative registry)\n- tests/unit/rebar_reconciler/test_field_contract_properties.py (new)\n- docs/architecture.md (one-paragraph registration-contract note in the reconciler section)\n- OUT of scope: pagination iterators (split to sibling ticket), call-site rewiring, any transport work (cc77 landed).\n\n## Testing\nThe property tests are the deliverable. Mutation check before push: flip one declared symmetry class in the registry — the named field's property test must fail; delete one registry entry — collection must fail via the coverage guard.\n\n## Acceptance Criteria\n- [ ] _field_contract.py registry exists; every reconciled field handled by the differ/apply path has a declared symmetry class; docstring + docs/architecture.md note record the registration contract.\n- [ ] Coverage guard fails collection for a handled-but-undeclared field (proven by the deletion mutation).\n- [ ] Roundtrip identity asserted only for declared-bidirectional codecs; add-wins and gated classes have their class-specific properties asserted through real call paths.\n- [ ] relates_to link recorded to cc77 (typed transport, already landed/closed) and discovered_from link on the split-out pagination child.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/_field_contract.py","reason":"new declarative symmetry registry"},{"path":"tests/unit/rebar_reconciler/test_field_contract_properties.py","reason":"new property tests off the registry"},{"path":"docs/architecture.md","reason":"registration-contract note"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","2f4c-7e5c-e782-4e97"],["relates_to","496a-d258-db7d-42da"],["relates_to","cc77-8120-bcc6-47e8"]],"no_file_impact_reason":"","parent_id":"2f4c-7e5c-e782-4e97","parent_status_uuid":"1d992cd0-8e40-4148-a22b-da92a30a9904","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["reconciler"],"ticket_id":"e931-7f1f-8b0c-465b","ticket_type":"story","title":"Reconciler: declared-asymmetry property tests + pagination iterator dedup","verify_commands":[]},"source_event_uuids":["4b3e4992-17c1-42ea-a9e5-82d4b146bc97","c736f38d-07de-4501-bf45-83ae17453d64","ab9a720a-f87d-49fe-a23b-fb74d53b6286","093ca491-43a5-4cd1-92a9-c753593bcacf","d00ab572-8122-4d5d-b091-0b4af70ba873","b3ec149a-51a2-4b88-8bd1-932c621e47cd","d1463511-3b49-4c88-b538-499595500b9e","a0680240-9431-4f75-bdd5-eb64f7b9c46c","1d992cd0-8e40-4148-a22b-da92a30a9904","15063e52-dfe8-46c2-a3a5-f34a26334324","0964c795-9595-474f-bfdf-6770627f847a","525c0009-b05c-4620-8972-a65f9a7e3ef6"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785776237739529007,"uuid":"eb7a3ed3-6ca0-4427-99cc-26f10fa16c9a"}