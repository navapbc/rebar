9de2944e3d37"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0affcb26676197da7b1eb98e23d129d9041201f6e5b1421d63f38d13ca5fa13f","event_uuid":"4220ba84-1e23-4290-afb0-4220fd1edf3d","position":{"commit_sha":"24decdc4e9edaafcd6c1cdbdfdcb09af7c9f0f87","position":"1787361425313317001-4220ba84-1e23-4290-afb0-4220fd1edf3d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f262635cf06c585167c25a8b15434396e46469c7c8ba27b41f3eaf765b9971b0","event_uuid":"7a098c73-77a3-40e2-ac12-3e6a226e7c6d","position":{"commit_sha":"5c951f394e0beb3beae22e4398b8dce2e7f4d35e","position":"1787361435417661001-7a098c73-77a3-40e2-ac12-3e6a226e7c6d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787081169597662001,"creation_channel":"cli","deps":[{"link_uuid":"0bdb8b6e-2c2a-4565-b340-ece553a9d106","relation":"depends_on","target_id":"60c1-80de-a22f-4d39"},{"link_uuid":"cf6cc6fc-13a6-4356-931b-2dfe5f0e95db","relation":"relates_to","target_id":"04cc-9ff4-06c2-43c6"},{"link_uuid":"1faab52b-0377-4210-bea6-5613216d2941","relation":"relates_to","target_id":"0bb5-5b2a-dc39-482d"}],"description":"## Context / Problem\nThe workflow editor currently presents authored YAML/BPMN configuration without a trustworthy view of the effective criteria policy derived from built-ins plus project overlays. RP-06 adds an immutable derived policy and an explicit project applicability rule; exposing derived state as if it were editable topology would create a second policy authority and make misconfiguration difficult to diagnose.\n\n## Approach\nExtend the workflow-editor server to obtain the S1 `CriteriaSnapshot` for the selected repository and expose a narrow, read-only Effective Policy view. Keep Authored Workflow as the only editable YAML/BPMN topology. The effective view shows snapshot digest/source, criterion id, gate, execution tier, effective posture/threshold, applicability summary, enabled/disabled state, and a concise derived reason. It never serializes edits back into workflow or project routing.\n\nAt authoring/save validation, a new `project.*` code-review LLM criterion must have a non-empty list of non-empty repository-relative `applies_to` globs. The editor rejects an empty/missing selector with the exact `[\"**\"]` repository-wide remedy. Built-in entries, project DET criteria, and plan-review criteria retain their distinct trigger authoring controls and are not forced through this field.\n\nKeep stored execution trace and per-call debugging detail out of the editor response. The Effective Policy panel is configuration provenance, not a review-result/status viewer. Repository or validation errors fail the save or mark the effective view unavailable with a located, actionable message; they do not silently display packaged defaults as effective policy.\n\n## Rationale and Compatibility\nA read-only projection makes the centralized pattern visible while preserving one authored source of topology. Older workflow files remain readable. The UI and server add fields without rewriting saved YAML/BPMN, and rollback removes the panel/endpoint while leaving authored artifacts unchanged.\n\n## Testing\nUse server contract tests with real overlay/snapshot compilation and focused editor DOM/state tests. The oracle is the serialized authored document remaining byte-equivalent while the read-only view changes with project policy. Negative controls cover built-in empty trigger semantics, project DET, and plan review. Error fixtures prove unavailable policy is explicit and save validation is fail-loud.\n\n## Acceptance Criteria\n- [x] The editor renders distinct Authored Workflow and read-only Effective Policy sections, and no action in the effective section mutates or serializes YAML/BPMN.\n- [x] Effective Policy data comes from the repository-bound `CriteriaSnapshot` and displays digest/source plus concise criterion gate, tier, posture, applicability, and enabled/disabled provenance.\n- [x] Creating or saving a project code-review LLM criterion with missing, empty, non-list, or blank globs is refused with the criterion location and `use [\"**\"] for repository-wide` remedy.\n- [x] Built-in secondary triggers, project DET selector controls, and plan-review `applies_at`/`trigger` authoring remain valid negative controls and are not subjected to the project-LLM glob rule.\n- [x] A snapshot load/validation failure marks Effective Policy unavailable with an actionable located error and never substitutes packaged defaults or permits an invalid save.\n- [x] Server and editor tests prove policy changes update only the derived view while authored workflow round-trips byte-equivalently.\n- [x] Editor payloads contain no per-unit discovery trace, raw prompt/context body, provider response, or secret.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/workflow/editor_server.py","reason":"Serve repository-bound effective-policy data and located validation errors."},{"path":"src/rebar/llm/workflow/editor_contracts.py","reason":"Define the narrow read-only effective-policy response contract and the fail-loud criterion-authoring guard."},{"path":"src/rebar/llm/workflow/criterion_preview.py","reason":"Honor the routing gate hint so an editor-authored code-review criterion lands under the code_review section/activation, not silently under plan_review."},{"path":"src/rebar/llm/workflow/editor_assets/src/rebarProvider.jsx","reason":"Render separate authored and effective policy views, the gate selector + applies_to globs input, and guard the effective-policy fetch on r.ok."},{"path":"src/rebar/llm/workflow/editor_assets/dist/editor.js","reason":"Regenerated shipped editor bundle."},{"path":"tests/unit/workflow/test_editor_effective_policy.py","reason":"Read-only projection, unavailable state, and sensitive-field exclusion tests."},{"path":"tests/unit/workflow/test_editor_roundtrip.py","reason":"Authored YAML/BPMN byte-equivalent round-trip negative control."},{"path":"tests/unit/workflow/test_editor_batch.py","reason":"Project LLM glob authoring validation and built-in/DET/plan-review controls (pure-function unit)."},{"path":"tests/unit/workflow/test_editor.py","reason":"Server-seam tests: /library/create refuses a bad-glob code-review project criterion with no file written, and a valid one lands under the code_review gate."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","60c1-80de-a22f-4d39"],["parent","58bd-d656-c52f-4cf4"],["relates_to","04cc-9ff4-06c2-43c6"],["relates_to","0bb5-5b2a-dc39-482d"]],"no_file_impact_reason":"","parent_id":"58bd-d656-c52f-4cf4","parent_status_uuid":"4220ba84-1e23-4290-afb0-4220fd1edf3d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":["rp-06","llm","workflow-editor","ux"],"ticket_id":"65bf-173b-e16b-4bb9","ticket_type":"story","title":"RP-06 S6 — Separate authored workflow from effective review policy","verify_commands":[]},"source_event_uuids":["6e821402-6ead-4a80-90d9-96d7675b815e","e7793ca2-7b01-4e79-b23a-0c81456a84ad","b4fe67d1-05fb-4d66-9371-9ff178cb5971","6e06a103-0537-4082-8862-9aad938c3be2","cf6cc6fc-13a6-4356-931b-2dfe5f0e95db","cd088afc-f6d2-4f4d-989e-fd206f25fc60","1faab52b-0377-4210-bea6-5613216d2941","35c0979c-4eeb-41d9-a446-87d4a13e8a71","b696cff5-2353-4f60-9085-9de2944e3d37","4220ba84-1e23-4290-afb0-4220fd1edf3d","7a098c73-77a3-40e2-ac12-3e6a226e7c6d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787364829513988001,"uuid":"9dbc92c0-258a-4f43-aae5-d8b9bcd63726"}