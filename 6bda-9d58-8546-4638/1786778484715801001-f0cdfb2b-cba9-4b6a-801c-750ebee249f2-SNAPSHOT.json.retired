{"author":"RebarBotNava","author_email":"joeoakhart@navapbc.com","data":{"compacted_at":1786778484715801001,"compiled_state":{"alias":"satiated-unrideable-tapeworm","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"1dd31ec2b24bebc6dec9f5288136fd1f4a15347a","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6bda-9d58-8546-4638","material: e73cfdd2f3ee88b7","material-part: children 647ea2107ca5072f 0","material-part: description 28b22cf9a7e3d6a4 7997","material-part: description_boxes 670af646a34cdc2a 0","material-part: file_impact d36083ec80d95b1a 5","material-part: ticket_id b91b05dfa2fe855b 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.11.0 (1dd31ec2b2)","regver: 4f90349cd81c4911","verified-at-sha:588d7df0bd0e7d7645554a7380e1743117e017a2","dep 0f63e73c67f71abdbfcb02d1e3bc4af70302ae6729c269220d5481d69ab2cd40 src/rebar/_commands/__init__.py","dep fab96e73d9fae4e15fab3b4da1c1939d742b1b7552df1f6663d07255dedbd3a5 src/rebar/_commands/composer.py","dep 48d264d84fa40ce9fdece2c8510e162ec4d4656401a9adf571c33db7a0984f3b src/rebar/_commands/leaf.py","dep edb64fd07f6241e2768d3f6f2cb6d28caf33c6f11ec82a55a4f18ded999552de src/rebar/_commands/link_revert.py","dep absent tests/unit/commands/","read-set: 8","read-path: src/rebar/_cli/__init__.py","read-path: src/rebar/_commands/__init__.py","read-path: src/rebar/_commands/link_revert.py","read-path: src/rebar/_commands/transition.py","read-path: src/rebar/_engine_support/output.py","read-path: src/rebar/_mcp_writes.py","read-path: src/rebar/graph/_links.py","read-path: src/rebar/schemas/__init__.py","currency-basis: file_impact"],"material_fingerprint":"e73cfdd2f3ee88b7","merged_log_commit":"588d7df0bd0e7d7645554a7380e1743117e017a2","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786773467471311000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"12417240ef101eb9a4a03b46e62d19a8081cfe29d2405b0476822e290278dd23","event_uuid":"c92046d3-4293-4ec0-9333-46ae38ab3473","position":{"commit_sha":"b71b1e23214c135c152c44b0e191d96436adf6a8","position":"1786761367507090001-c92046d3-4293-4ec0-9333-46ae38ab3473"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e7846c5b0b521e395c69bb68b2590d43e153ae3029464a10b2e747b20c1de4d8","event_uuid":"fb0a4ee2-ba48-4816-bfc8-82a4364eb7b9","position":{"commit_sha":"74fc8ac44d3d37e210e19890ac8b37d5c9334610","position":"1786761405532522001-fb0a4ee2-ba48-4816-bfc8-82a4364eb7b9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d8235ec70b435f29dcccd85cd4df9b06a9b0f61f674a7a6033b40ab1a86e49a9","event_uuid":"78f639fd-4ac4-4fc0-9596-c7e66befda7d","position":{"commit_sha":"9b77db1be309395c6550768d1794b488b97f5dc7","position":"1786763568555906001-78f639fd-4ac4-4fc0-9596-c7e66befda7d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"s