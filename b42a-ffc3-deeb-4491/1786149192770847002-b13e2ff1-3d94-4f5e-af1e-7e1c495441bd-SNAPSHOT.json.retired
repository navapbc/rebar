43398047001-e16b902e-8d01-44ca-9d1c-f9bf6022add6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"60d5eba8cb2516d6aca233a46a45eefbd10f1bd64f08d8e2d61e7638a5648e77","event_uuid":"7af47682-79b9-4acf-901a-3165102c2c50","position":{"commit_sha":"be4e2fa1a57a6fdb9df122ac1db2bd4e49ba8d03","position":"1786143356136510001-7af47682-79b9-4acf-901a-3165102c2c50"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2e04ce339009133e2cdd4f2b4b97068fc7c1f4688dc3a5e44ffd0f09291fba76","event_uuid":"b76f0f27-1e97-4d32-8c44-a320aee8e3ca","position":{"commit_sha":"e2177da3afbf799cffe4fab01621636428a9b208","position":"1786143498080034001-b76f0f27-1e97-4d32-8c44-a320aee8e3ca"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d669d2cf698e2c7c1df3d0286ab8ec241afe63332e0afba32477e7bd81449e79","event_uuid":"9a042177-3fdf-4dd2-a1ce-c7ff473c415d","position":{"commit_sha":"6efb8c94df1119d667ad094f7fbb925022c11334","position":"1786143626779135001-9a042177-3fdf-4dd2-a1ce-c7ff473c415d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI