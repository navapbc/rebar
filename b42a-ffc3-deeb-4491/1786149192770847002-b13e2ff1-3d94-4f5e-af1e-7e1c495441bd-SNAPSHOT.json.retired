{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786149192770847002,"compiled_state":{"alias":"unspecific-digitiform-earthworm","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"bd3e4f97b6868b44d57a809ed66a263a51f8a9b1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b42a-ffc3-deeb-4491","material: 9736b07615475ac3","material-part: children 647ea2107ca5072f 0","material-part: description 8735ad451d4b64e2 5315","material-part: file_impact 689a755f987ebf71 12","material-part: ticket_id d29f4b107fe5853f 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (bd3e4f97b6)","regver: 368938c5729d4170","verified-at-sha:2bda965db6a300235a0e6a9be2c40f18ae8e210d","dep c858eb107b8bae3057c4f925a68f8ad2750727066bea133c3cb2406343a5dbeb docs/cli-reference.md","dep 8ea262a3110a89fb8f81bd86ecc7e4bdec97ad80b800b8900fdcaf3428c99ba4 docs/exit-codes.md","dep eed8519bad35992d20131d4b5f3b65fe38589e7f5a4aa11fa1085c3a86148ee1 docs/release-notes.md","dep 28379af0a6a0fb79b0edc9437c66a4edd672e22d358a45cd1aee0923a3777660 docs/user-guide.md","dep 1b335767d4c8c64ec0168caf754d99ebc27b045dba7286a6463429ade6669fa1 scripts/gen_cli_reference.py","dep 532ca34479f2a4bf3c446859b33858a2baa8f3bc730ed9f4b7a37cb623bf59ec src/rebar/_cli/__init__.py","dep absent src/rebar/_cli/_bridge_commands.py","dep absent src/rebar/_cli/help/bridge.txt","dep 1097ac10c0338c20912c147a86445d64c441c1f44a402611f09383a7e3c4eb18 src/rebar/_cli/help/overview.txt","dep e1e07706c092a8aaea0f11af63a8ef9d342b5befc