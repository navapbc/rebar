red: assert seen==set(allowed),f\"missing allowlisted docstrings: {sorted(set(allowed)-seen)}\"\n return tree\ndef norm(text,path,allowed,required):\n tree=strip_docs(ast.parse(text,filename=path,type_comments=True),allowed,required)\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef directives(text):\n lines=text.splitlines()\n picked=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),picked\ndef admitted(line,lines,spans):\n return any(s<=line<=e for s,e in spans) or (1<=line<=len(lines) and not lines[line-1].strip() and any(s-1<=line<=e+1 for s,e in spans))\nfor path,rule in SPEC.items():\n before=src(BASE,path); after=src(AFTER,path)\n assert norm(before,path,rule[\"docs\"],True)==norm(after,path,rule[\"docs\"],False),f\"runtime AST changed: {path}\"\n assert directives(before)==directives(after),f\"directive/shebang changed: {path}\"\n a=before.splitlines(); b=after.splitlines()\n for tag,i1,i2,j1,j2 in difflib.SequenceMatcher(a=a,b=b,autojunk=False).get_opcodes():\n  if tag==\"equal\": continue\n  if i1==i2:\n   assert any(s-1<=i1<=e for s,e in rule[\"spans\"]),f\"insertion outside allowlist: {path}:{i1+1}\"\n  else:\n   bad=[line for line in range(i1+1,i2+1) if not admitted(line,a,rule[\"spans\"])]\n   assert not bad,f\"changed base lines outside allowlist: {path}:{bad}\"\nprint(f\"immutable prose oracle PASS: {len(SPEC)} paths at {BASE} -> {AFTER}\")'","dd_id":"immutable-prose-only","dd_text":"Immutable-base AST, allowlisted-span, and directive/shebang oracle passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import json, subprocess\nexpected=set(json.loads(\"\"\"[\"tests/_bank_observer.py\",\"tests/_child_diag.py\",\"tests/_engine_path.py\",\"tests/_extra_guard.py\",\"tests/_git_counts.py\",\"tests/_git_floor.py\",\"tests/_git_upkeep.py\",\"tests/_isolation.py\",\"tests/_jira_shape_contract.py\",\"tests/_live_jira_confinement.py\",\"tests/_log_integrity.py\",\"tests/_nested_pytest.py\",\"tests/_repo_root.py\",\"tests/_stall_remote.py\",\"tests/_subprocess_isolation.py\",\"tests/_topology_template.py\",\"tests/_tree_scan.py\",\"tests/conftest.py\",\"tests/module_size_support.py\"]\"\"\"))\nactual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nassert actual==expected,f\"changed paths differ: missing={sorted(expected-actual)} extra={sorted(actual-expected)}\"'","dd_id":"exact-leaf-paths","dd_text":"The one-commit changed-path set exactly equals file impact."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Repository comment-history hygiene passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_completion_bank_observer_forwarding.py tests/unit/test_completion_banking_oracle.py tests/unit/test_live_dc_pass_health.py tests/unit/test_external_mutation_diagnostics.py tests/unit/test_extra_coverage_guard.py tests/unit/io/test_git_counts_helper.py tests/unit/test_git_version_floor.py tests/unit/test_topology_template_upkeep_guard.py tests/interfaces/test_rebar_repo_isolation.py::test_fixture_bare_remote_leaves_no_detached_upkeep_behind_a_push tests/unit/test_repo_isolation_guard.py tests/integration/rebar_reconciler/jira_contract/test_verified_fake_contract.py tests/unit/test_live_jira_xdist_confinement.py tests/unit/test_caplog_coverage_integrity.py tests/unit/test_nested_pytest_helper.py tests/unit/test_nested_pytest_uniqueness.py tests/unit/test_repo_root_install_agnostic.py tests/unit/test_snapshot_fetch_stall_abort_12e4.py tests/unit/test_network_fetch_stall_abort_851e.py tests/unit/test_collection_isolation_guard.py tests/unit/test_module_size_