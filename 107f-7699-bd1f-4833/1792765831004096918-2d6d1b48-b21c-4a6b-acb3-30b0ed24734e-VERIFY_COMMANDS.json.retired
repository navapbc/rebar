{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, io, re, subprocess, sys, tokenize\nBASE=\"8ff0355e32c6fb1ba67e4964dc12ba1b4c3e45b0\"\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\ndef source(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(source,path):\n tree=ast.parse(source,filename=path,type_comments=True)\n for node in ast.walk(tree):\n  if isinstance(node,(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)) and node.body:\n   head=node.body[0]\n   if isinstance(head,ast.Expr) and isinstance(head.value,ast.Constant) and isinstance(head.value.value,str): node.body.pop(0)\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(source):\n lines=source.splitlines()\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\",[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(source).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)])\nfor path in sys.argv[1:]:\n before=source(BASE,path); after=source(\"HEAD\",path)\n assert norm(before,path)==norm(after,path),f\"runtime AST changed: {path}\"\n assert protected(before)==protected(after),f\"directive/shebang changed: {path}\"\nprint(f\"parent-to-final AST/directive PASS: {len(sys.argv)-1} paths\")' tests/_bank_observer.py tests/_child_diag.py tests/_extra_guard.py tests/_git_counts.py tests/_git_floor.py tests/_git_upkeep.py tests/_isolation.py tests/_jira_shape_contract.py t