{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787713800512021001,"compiled_state":{"alias":"smart-evadable-teledu","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"95387192861c7ab4e411937d81debcefd3a2e2a8","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6cd0-0786-4de8-415e","material: 8d68a2e706f1f21c","material-part: children 647ea2107ca5072f 0","material-part: description f9f34f6623a1ce47 7178","material-part: description_boxes 05a8475feebbfea6 0","material-part: file_impact f7a2c5e7775e3b35 4","material-part: ticket_id a7bc80678eef5681 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.12.0 (95387192861c)","regver: aa61189569d34126","verified-at-sha:95387192861c7ab4e411937d81debcefd3a2e2a8","dep 82871f6d02df80876871d86d68fb0f33b6e9b24db1b99b9adaf03ed9faff3a43 src/rebar/llm/config.py","dep 80b9512dec12684e22c73f9aa8cd840c48ace4dcf19975be1b90659316bc5264 src/rebar/llm/runner.py","dep 9f4927a7764791947ec5cf6db4fc2c37c464f85ee66354741e64fb82974dd247 src/rebar/llm/workflow/gate_dispatch.py","dep absent tests/unit/test_run_correlation.py","read-set: 20","read-path: .rebar/cache/plan-review/6cd0-0786-4de8-415e/6a68cf8f4875e97ca53f2929fc73c9555fb89c39aa96bab8e771760b5bd350d2.json","read-path: src/rebar/llm/completion_reconcile.py","read-path: src/rebar/llm/config.py","read-path: src/rebar/llm/findings.py","read-path: src/rebar/llm/operations.py","read-path: src/rebar/llm/plan_review/container_stage.py","read-path: src/rebar/llm/plan_review/generation.py","read-path: src/rebar/llm/plan_review/pass1.py","read-path: src/rebar/llm/review_kernel/verify.py","read-path: src/rebar/llm/reviewers/plan_review_T5e.md","read-path: src/rebar/llm/runner.py","read-path: src/rebar/llm/spec_scan.py","read-path: src/rebar/llm/workflow/completion_failures.py","read-path: src/rebar/llm/workflow/completion_verdict_assembly.py","read-path: src/rebar/llm/workflow/gate_dispatch.py","read-path: src/rebar/llm/workflow/gate_ops.py","read-path: src/rebar/llm/workflow/gates/completion-verification.yaml","read-path: src/rebar/llm/workflow/runs.py","read-path: src/rebar/schemas/completion_verdict.schema.json","read-path: src/rebar/schemas/review_result.schema.json","currency-basis: file_impact"],"material_fingerprint":"8d68a2e706f1f21c","merged_log_commit":"95387192861c7ab4e411937d81debcefd3a2e2a8","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787711179353911000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":12,"unsigned":0},"authorship_ledger":[{"content_hash":"b14d541ea740e1b3f2e69194dfcccaa45e0c6831d46359409d51b2299b875d5e","event_uuid":"9d0f4002-fd5f-4c52-b967-ae00ef94d59a","position":{"commit_sha":"e1cb09e85478d4cd61bb4c0f7be3133013b8af18","position":"1787705216754133001-9d0f4002-fd5f-4c52-b967-ae00ef94d59a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5447a8efa04ac47b88972f2e90f2d9206449986f84c84733f49cf10b3432f6ac","event_uuid":"6c73c455-5511-40c6-a8bb-a7ed2cf8db67","position":{"commit_sha":"cc9e5ee8435e91e9869189b21303a411003836c7","position":"1787705348912257001-6c73c455-5511-40c6-a8bb-a7ed2cf8db67"},"signature":"{\"payload\": \"\", \"payloadType\": \"application