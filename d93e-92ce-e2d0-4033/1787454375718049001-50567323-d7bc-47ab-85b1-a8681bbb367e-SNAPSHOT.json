c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix pushed as Gerrit change 2126 (commit fced846d4f5): each degradation-path test file in _optionality.yml's clean-core-wheel job is now guarded on its own presence (per-file if-present pattern from bugs 1909/5bc6); node-id list built from present files; both-absent exits 0 before pip install; KNOWN GAP marker removed. New parity test test_ci_workflow_parity.py::test_degradation_step_runs_only_the_present_test_files drives all four presence combos with stubbed pip/python. Awaiting LLM-Review+1 and Verified+1.","timestamp":1787437954211934001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"MERGED as Gerrit change 2126 -> main commit 5eea642c27b (LLM-Review+1, Verified+1, 0 unresolved). Evidence per AC: (1) independent per-file guards with the four-presence-combination case test_ci_workflow_parity.py::test_degradation_step_runs_only_the_present_test_files — passing; (2) marker removed and completeness test passing; (3) empty-tree skip test passing; (4) full test_ci_workflow_parity.py passing (32 tests across both parity modules). make lint (incl. complexity ratchet, zizmor, actionlint) and make typecheck green. Origin attribution: the degradation-path step landed unguarded in 343c8dd2a04 (ticket 15e7-f013-0cfb-494b), before the ee2a/1909 guard obligation existed — a latent gap the 1909 rollout missed, hence class=preexisting, caused-by=15e7-f013-0cfb-494b.","timestamp":1787441387782329001}],"completion_expectation":"required","created_at":1787377614970095001,"creation_channel":"cli","deps":[{"link_uuid":"75f0b2d8-796a-4435-ae8b-b62e5b102634","relation":"discovered_from","target_id":"7e0d-7815-4425-4fdb"},{"link_uuid":"33a5eba5-79e3-4f8b-aa0e-5c45239cf2fa","relation":"relates_to","target_id":"e37e-b94e-d3fe-4f3e"},{"link_uuid":"d7d878fc-8dd3-40b5-9cce-1bb235c1aba3","relation":"caused_by","target_id":"15e7-f013-0cfb-494b"}],"description":"## Context / Problem\n`.github/workflows/_optionality.yml` job `clean-core-wheel`, step \"degradation-path tests run with NO agents extra\" (lines 149-168), runs pytest against `tests/interfaces/store/test_llm_optionality.py` and `tests/interfaces/lifecycle/test_completion_gate.py::test_gate_missing_llm_fails_closed` with no predates-gate guard. This workflow IS on the Verified lane (`gerrit-verify.yaml:252` invokes it against the exact patchset), so on a patchset whose base predates either test file pytest collects nothing and exits 4 — a `Verified -1` caused by the gate rather than by the change under review. That is exactly bug `1909-c1a7-9f20-440f`, which the SAME workflow already fixed for the step below it (`_optionality.yml:133` guards `tests/interfaces/contracts/test_cli_registry_distribution.py`) — the fix landed in one copy and its twin stayed broken.\n\n## Approach\nGuard the two test files independently, following the two-generator form at `_optionality.yml:108,114` (bug `5bc6-5496-4e17-403a`): a joint guard would silence the check for the file that IS present. Build the pytest node-id list from the files that exist and skip only the absent ones, keeping the canonical \"change predates the gate\" message.\n\n## Scope\n`.github/workflows/_optionality.yml`.\n\n## Acceptance Criteria\n- [x] Each of the two test files is guarded independently, so a tree with one and not the other still runs the one it has; checked by a case in `tests/unit/test_ci_workflow_parity.py` covering all four presence combinations.\n- [x] The step carries an `-f` guard naming each test file it runs; checked by `pytest tests/unit/test_predates_gate_guard_parity.py::test_completeness_every_gate_step_is_guarded_or_marked` passing with the marker REMOVED from that step.\n- [x] The guarded body exits 0 and prints the canonical message in an empty directory; checked by `pytest tests/unit/test_predates_gate_guard_parity.py::test_empty_tree_every_guarded_step_skips_cleanly`.\n- [x] The clean-lane assertion that the agents extra is ABSENT still runs; checked by `pytest tests/unit/test_ci_workflow_parity.py` passing unchanged.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/_optionality.yml","reason":"add independent -f guards to the degradation-path pytest step and remove the KNOWN GAP marker"},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"add a four-presence-combination case for the guarded degradation step"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","e37e-b94e-d3fe-4f3e"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"67641eec-0571-4a7f-bc6e-eacfe4849219","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"d93e-92ce-e2d0-4033","ticket_type":"bug","title":"Guard the degradation-path test files in the Verified optionality lane","verify_commands":[]},"source_event_uuids":["03b3712e-73fe-4a99-ac11-fc22eed9e917","dcaea57b-faf1-44b9-8e32-21642249a5cb","ccb9d01e-c35a-416c-86aa-b14440161bbb","932258d5-e9e2-4436-b0fd-b2138309049d","2510f6f3-c459-4b65-99f1-eae456964df8","33a5eba5-79e3-4f8b-aa0e-5c45239cf2fa","3bc17fc2-e8d4-43b4-bf88-c3565cd8df4b","89d43b5a-316e-4cab-94ff-29cc3de92b7c","67641eec-0571-4a7f-bc6e-eacfe4849219","05f572f7-fc36-4d6b-9b4f-e34604b0e53c","d7d878fc-8dd3-40b5-9cce-1bb235c1aba3"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787454375718049001,"uuid":"50567323-d7bc-47ab-85b1-a8681bbb367e"}