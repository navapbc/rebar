3.4,"llm_calls":1,"output_tokens":90.4,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1058.5,"llm_calls":1,"output_tokens":202.91666666666666,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":6912.0,"llm_calls":1,"output_tokens":417.0,"requests":1}}}},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"Reconcile the plan's 'only guard-passing dirs are removed' claim with the tool's behavior: state that `--clean` removes the ENTIRE foreign set, and require a `--status` re-run immediately before `--clean` that lists exactly the 8 triaged ids (abort if the foreign set differs) so the guards actually gate the sweep.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan: 'Only directories passing all four are removed, via the sanctioned door rebar tracker-maintenance --clean'","src/rebar/_commands/tracker_maintenance.py:242 `for name in foreign:` then `shutil.rmtree(full)` — removes the entire foreign set with no per-guard check","src/rebar/_commands/fsck.py:450-452 `foreign_store_path_list` returns any non-dot dir not holding a .json/.retired event file","There is no CLI surface to pass a filtered subset of dirs to --clean"],"finding":"The plan states 'Only directories passing all four [guards] are removed, via the sanctioned door `rebar tracker-maintenance --clean`', but the tool does not filter by the four guards: `_foreign_worktree_paths`/`foreign_store_path_list` returns every top-level entry lacking an event file and the removal loop `for name in foreign: shutil.rmtree(full)` deletes ALL of them unconditionally. The four-guard triage (AC1) is advisory and does not gate what `--clean` removes.","group_criteria":null,"group_id":null,"id":"f5a421bbbef74c518","impact":1.0,"is_primary":null,"location":"Plan (minimal, deterministic — four-guard discipline); AC2","norm_id":"n3526b8a5bbe0e186","priority":0.9,"reason":"high-priority+criterion-opted-in","scenarios":["A foreign dir that is NON-empty (holds a partial/foreign file but no event) fails Guard 1 yet is still swept by --clean","The foreign set at --clean time differs from the triaged 8, so --clean removes something the four-guard verdict never cleared"],"severity":"critical","suggested_fix":"Reword the Plan/AC2 to acknowledge `--clean` acts on the whole foreign set, and add a step: run `rebar tracker-maintenance --status`, assert its 'foreign top-level paths' list is byte-equal to the 8 triaged ids, and only then run `--clean`; if any additional path appears, abort and re-triage.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Reconcile AC2 (partial exclusion permitted) with AC3 (zero MISSING_CREATE/FOREIGN_STORE_PATH): state what happens to an excluded directory's residual fsck finding — e.g. AC3 counts zero only among removed dirs, or an excluded dir converts this ticket to blocked pending re-triage.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T6","T9","project.portability"],"criteria":["COH","E6"],"decision":"advisory","decision_margin":-0.131,"drop_reason":null,"evidence":["AC2: 'any directory failing a guard is excluded with its reason recorded'","AC3: 'Post-sweep rebar fsck reports zero MISSING_CREATE and zero FOREIGN_STORE_PATH findings ... returning 0'","The two cannot both hold if a directory is excluded: the excluded dir remains and keeps generating those findings."],"finding":"AC2 explicitly permits any directory that fails a guard to be excluded from removal, but AC3 requires fsck to report ZERO MISSING_CREATE and ZERO FOREIGN_STORE_PATH. If even one of the 8 dirs is excluded (guard failure), it will remain in the store and fsck will still report MISSING_CREATE and/or FOREIGN_STORE_PATH for it — making AC2 and AC3 unsatisfiable together.","group_criteria":null,"group_id":null,"id":"fb9351a79eb13c930","impact":0.536,"is_primary":null,"location":"Acceptance Criteria AC2 and AC3","norm_id":"n562d661c13a4f8b5","priority":0.469,"reason":"default-advisory","scenarios":[],"severity":"major","suggested_fix":"Amend AC3 to: 'zero MISSING_CREATE/FOREIGN_STORE_PATH for the removed set; any guard-excluded directory is recorded and this ticket documents the residual finding as expected-remaining,' so the exclusion branch is not self-contradictory.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifia