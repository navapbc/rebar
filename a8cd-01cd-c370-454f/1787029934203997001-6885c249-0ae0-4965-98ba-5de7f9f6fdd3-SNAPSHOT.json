519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2e9f380f7b09d4aa377cb3a8f7357d048527d72da2aeb8d8a0be3d66fe49882f","event_uuid":"dd336b50-a8f4-4248-a2b0-e43127fd2227","position":{"commit_sha":"1aaf4d3bd70f77023399a24808a3efad6e2179eb","position":"1787027874946851001-dd336b50-a8f4-4248-a2b0-e43127fd2227"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027843891965001,"creation_channel":"cli","deps":[{"link_uuid":"dd336b50-a8f4-4248-a2b0-e43127fd2227","relation":"depends_on","target_id":"7bc2-5203-d5f4-4a4a"}],"description":"## Context\nCloud summary writes currently cross ACLI subprocess behavior and a shared REST helper that retries three times with 2s/5s waits. The selected route must consume only the shared logical budget without weakening unrelated callers.\n\n## Outcome\nImplement one Cloud summary write invocation and primary-store observation under the S1 contract. Each write launches one ACLI process; summary recovery performs one REST request with no inner sleep.\n\n## Plan\n1. Add sanitized historical exit/stdout/stderr fixtures, including the real exit-1 unauthorized shape, and fail loud on unknown shapes.\n2. Execute one `acli jira workitem edit` process per physical write invocation. Preserve POSIX process-group and non-POSIX child cleanup.\n3. Add a per-call retry policy to `_rest_urlopen_with_retry`. `get_issue_by_rest` summary recovery alone selects one attempt/no sleep; every existing caller retains three attempts and 2s/5s waits.\n4. Classify auth/TLS/permission/invalid requests as permanent; eligible network, 429, and retryable 5xx outcomes return metadata to the shared budget rather than replaying locally.\n5. Observe the primary REST issue resource, never indexed ACLI JQL, before any ambiguous replay.\n\n## Testing\nStateful fakes and real child-process tests assert process/request counts, cleanup, classification, redaction, and neighbor retry behavior.\n\n## Acceptance Criteria\n- [ ] One Cloud write invocation launches exactly one ACLI process.\n- [ ] Summary recovery performs one primary-store REST request with no inner sleep or JQL.\n- [ ] All unrelated REST callers retain three attempts with 2s/5s waits.\n- [ ] Permanent and transient outcome classes map to the shared contract without adapter replay.\n- [ ] Historical triples decode deterministically and unknown triples do not retry.\n- [ ] Timeout cleanup passes for POSIX process groups and non-POSIX child processes.\n- [ ] Diagnostics and completion logs are bounded and redacted.\n\n## Out of scope\nCore dispatch cutover and Jira DC execution.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","reason":"Expose the selected Cloud summary write and observation."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_subprocess.py","reason":"One-process invocation, outcome decoding, timeout, and cleanup."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_rest.py","reason":"Per-call single-attempt observation while preserving neighbor retry defaults."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"Expose the typed Cloud operation."},{"path":"tests/fixtures/reconciler/rp03_acli_outcomes.json","reason":"Sanitized historical ACLI outcome corpus."},{"path":"tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py","reason":"Cloud stateful operation and classification tests."},{"path":"tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","reason":"Cross-platform process cleanup regressions."},{"path":"tests/unit/rebar_reconciler/state/test_acli_auth_failure.py","reason":"Historical unauthorized output regression."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","7bc2-5203-d5f4-4a4a"],["parent","f5ac-6373-5e33-4374"]],"no_file_impact_reason":"","parent_id":"f5ac-6373-5e33-4374","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp03","retry","jira-cloud","tdd"],"ticket_id":"a8cd-01cd-c370-454f","ticket_type":"task","title":"RP-03 S1 T2 — Execute and observe one Cloud summary postcondition","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py tests/unit/rebar_reconciler/state/test_acli_auth_failure.py -k \"cloud or acli or redaction\"","dd_id":"AC1-AC5,AC7","dd_text":"Cloud process/REST counts, preserved retries, classification, historical decoding, and redaction"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","dd_id":"AC6","dd_text":"POSIX and non-POSIX timeout cleanup"}]},"source_event_uuids":["0b89bea2-993d-4d35-8680-0d12153930a5","bbcd762d-d509-43de-9ebf-9d1c25027d75","a19a8ef4-8061-4b65-9719-79f8e6be9ce8","dd336b50-a8f4-4248-a2b0-e43127fd2227"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029934203997001,"uuid":"6885c249-0ae0-4965-98ba-5de7f9f6fdd3"}