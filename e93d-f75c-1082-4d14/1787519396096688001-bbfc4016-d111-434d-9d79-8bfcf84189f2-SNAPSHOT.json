ches the displayed interaction.\n- [ ] The SVG remains static and text-editable.\n- [ ] The SVG retains its accessibility label and the README retains alternative text.\n- [ ] Rendered normal and narrow views remain legible.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/assets/rebar-demo.svg","reason":"Correct the static displayed workflow, output, narration, and accessible label."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","b8bf-a5aa-2f4d-44d4"]],"no_file_impact_reason":"","parent_id":"b8bf-a5aa-2f4d-44d4","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","accuracy","f16"],"ticket_id":"e93d-f75c-1082-4d14","ticket_type":"task","title":"F16 correct the static CLI workflow demonstration","verify_commands":[{"command":"xmllint --noout docs/assets/rebar-demo.svg","dd_id":"D1","dd_text":"SVG structural validity"},{"command":"python scripts/check_readme_quickstart.py","dd_id":"D2","dd_text":"README quickstart contract"},{"command":"python scripts/check_docs_index.py --check","dd_id":"D3","dd_text":"Documentation links and index"},{"command":"git diff --check","dd_id":"D4","dd_text":"Changed file whitespace"}]},"source_event_uuids":["1f0657c7-9804-4241-84b9-85c008126b04","73f3506f-9c27-453e-bcc1-f23d779b2847","b4b06bd5-ec9b-4a88-ad8b-86138efff9f0","badd47a0-3145-4bbd-8a8d-bbbdbaf4ab4b"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787519396096688001,"uuid":"bbfc4016-d111-434d-9d79-8bfcf84189f2"}