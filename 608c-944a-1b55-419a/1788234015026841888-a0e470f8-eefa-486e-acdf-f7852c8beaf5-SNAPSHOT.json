9c90292b7f4e92c17560ceb3d5efcaf44bf0","position":"1788231696575240615-aa4f5628-7637-4c15-b700-6aaad79d1b03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2c73ffef15c59c1bf546339b58a01fc66c9e7487894e296f8c63d3ef9bbbc95c","event_uuid":"80ab35eb-4925-4f8f-9735-a410ebb5b36c","position":{"commit_sha":"abbf44507d40b45f668f8c8024bc85a2831b2d0c","position":"1788231965766501036-80ab35eb-4925-4f8f-9735-a410ebb5b36c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3657af40bc811a8218b6d108058c3f7fca07216d6a404fe5b596df73b92d95e7","event_uuid":"a8eea96f-5ae2-4d65-a3d4-7beab3521b92","position":{"commit_sha":"605c23e1e28cbe703f2a17758ec83ea1ce9c72e1","position":"1788231991305429567-a8eea96f-5ae2-4d65-a3d4-7beab3521b92"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"duplicate","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Duplicate/RCA disposition before close.\n\nStep 0(a): tracker sweep for `dict(os.environ) pytest fixture secrets environment leak` found closed canonical `broadish-permanent-condor` for this same `tests/scripts/test_autodeploy_review_drain.py::box` fixture leak and closed sibling `dumbstruck-wonderful-xiphosuran` for the broader class. Step 0(b): no report version in this duplicate; using created_at floor gives origin/main floor a22257e7d10e3d079ee676cbb38d2b39811d0fd5, with no later changes to `tests/scripts/test_autodeploy_review_drain.py`. Step 0(c): worktree `/Users/joeoakhart/credleak-fixtures` at e768151d680f7295bfd37424cec31946b88d0ab8 (= origin/main).\n\nProven root cause: this ticket is not a new live defect. It is a duplicate of already-landed `broadish-permanent-condor`: prior RCA showed pre-fix commit parent of 034e17209c had `box` returning a nested full `dict(os.environ)`, and pytest default-long fixture rendering could print a first-position synthetic ambient sentinel. Current origin/main has the established fix pattern at `tests/scripts/test_autodeploy_review_drain.py:177-187`: a narrow mutable allowlist (`PATH`, `STATE_DIR`, `DEPLOY_REPO`, `COMPOSE_DIR`, `MIRROR_DIR`, `HEALTH_TIMEOUT`) rather than a full environment copy.\n\nProof/replication: `env -i PATH=/usr/bin:/bin \"$PWD/.venv/bin/python\" -m pytest -q tests/scripts/test_autodeploy_env_repr_security.py tests/scripts/test_autodeploy_review_drain.py` was included in a focused run of all affected surfaces; result `72 passed, 1 skipped in 97.73s`. The original sentinel-rendering report no longer reproduces. Construct sweep: an AST scan of all `tests/**/*.py` found no `@pytest.fixture` returning `dict(os.environ)`, `os.environ.copy()`, or a nested alias to either. Remaining raw-env strings are security-test fixtures/strings or non-fixture subprocess-env work covered by `antiutopic-toadyish-goldfinch` per the canonical RCA.\n\nDefect origin/Gerrit: canonical fix is Gerrit Change 1847, commit 034e17209c9b30dad3aa08971a10b71f39fd5547, reachable from origin/main with trailer `rebar-ticket: fc43-3c50-ec6c-4a3e`; prior ticket records LLM-Review +1, Verified +1, zero unresolved comments, and merged CI run 32101886011. Because this ticket is a duplicate rather than an independent defect fix, the durable origin is the `duplicates` edge to `broadish-permanent-condor`, not a new `caused_by` edge.","timestamp":1788231696575240615}],"completion_expectation":"disposition","created_at":1788224229978569001,"creation_channel":"python","deps":[{"link_uuid":"b60e9e09-f45f-4f0e-b448-97bfd5b313a8","relation":"duplicates","target_id":"fc43-3c50-ec6c-4a3e"}],"description":"## Context\nThe box fixture in tests/scripts/test_autodeploy_review_drain.py constructs env = dict(os.environ) and returns that mapping inside the fixture value. When a test fails, pytest renders the fixture argument and can print ambient credential values into local or CI logs. This was directly observed during a deliberate defect-seeded RED run; no credential value is recorded on this ticket. The performance ticket must not absorb an unrelated security fix.\n\n## Plan\n- Reproduce with a synthetic sentinel secret in the ambient environment and a deliberate assertion failure.\n- Change the fixture boundary to pass only required environment variables or use a representation-safe wrapper while preserving the real bash subprocess environment needed by the tests.\n- Audit sibling subprocess fixtures for the same dict(os.environ)-inside-rendered-fixture shape.\n- Prove the synthetic sentinel never appears in pytest failure output while the autodeploy suite remains behaviorally green.\n\n## Scope and alternative rationale\nThe construct sweep separates two runtime carriers rather than deferring equivalent leaks. This parent and child dumbstruck-wonderful-xiphosuran own the eight decorated fixtures whose returned values pytest renders as function arguments; explicit allowlists are correct there because minimal-parent runs prove their consumers need only declared harness values. The remaining broad mappings are test-local or helper values exposed only when subprocess startup itself raises. Some intentionally forward the invoking pytest environment or environment-only live-service credentials, so applying the fixture allowlist would break their contract. Follow-up antiutopic-toadyish-goldfinch owns all 103 of those sites as one atomic shared representation-safe mapping migration, with a repository guard and exact child-value preservation test. A repo-wide allowlist was rejected because it would drop required values; independent per-file wrappers were rejected because they would duplicate the same diagnostic boundary without enforcement.\n\n## Acceptance Criteria\n- [x] [operator-attested] A deterministic regression test fails before the fix because a synthetic ambient secret appears in captured pytest failure rendering.\n  provenance: environment=sanitized-red-probe-034e17209c; principal=RebarBotNava; privilege_posture=narrower; instrument=simulation — real nested pytest default-long traceback with first-position synthetic sentinel\n- [x] The synthetic secret is absent from failure output after the fix.\n- [x] Required PATH and autodeploy environment behavior remains covered through the real bash subprocess.\n- [x] Sibling occurrences are inventoried and either fixed or linked as follow-ups.\n- [x] [operator-attested] Repository gates and Gerrit votes pass before closure.\n  provenance: environment=gerrit-ci-run-32101886011; principal=rebar-ci-bot; privilege_posture=production-equivalent; instrument=static-analysis — canonical Gerrit Verified and LLM-Review gates for merged change 1847","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/scripts/test_autodeploy_review_drain.py","reason":"narrow the returned fixture environment to required values"},{"path":"tests/scripts/test_autodeploy_env_repr_security.py","reason":"prove failure rendering cannot expose ambient values and sandbox nested pytest artifacts"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"80ab35eb-4925-4f8f-9735-a410ebb5b36c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"608c-944a-1b55-419a","ticket_type":"bug","title":"Prevent autodeploy test failures from printing ambient credentials","verify_commands":[]},"source_event_uuids":["3b581cb9-5536-4cd3-9acf-d719942b9890","15fa9e98-763a-40b2-954f-1a93b4f2916e","0610c36a-3010-426a-9757-f9fb93043ba8","1a6f1d50-8a69-4b5e-9a2a-5b8207971c0d","b60e9e09-f45f-4f0e-b448-97bfd5b313a8","aa4f5628-7637-4c15-b700-6aaad79d1b03","80ab35eb-4925-4f8f-9735-a410ebb5b36c","a8eea96f-5ae2-4d65-a3d4-7beab3521b92"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1788234015026841888,"uuid":"a0e470f8-eefa-486e-acdf-f7852c8beaf5"}