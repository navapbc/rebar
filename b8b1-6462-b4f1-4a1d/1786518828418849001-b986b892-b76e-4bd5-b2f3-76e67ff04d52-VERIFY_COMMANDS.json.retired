{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k classify -q","dd_id":"AC1","dd_text":"classify returns the correct reason for each of the three real error texts and None for a transient/unknown exception"},{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k attempted_once_then_never_again -q","dd_id":"AC2","dd_text":"A matching record with an unchanged digest suppresses the rebar.link call; two passes yield one attempt then zero"},{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k \"requalifies or does_not_requalify\" -q","dd_id":"AC3","dd_text":"Changed deciding inputs (source reopened) re-qualify the link; a non-structural comment does not"},{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k transient -q","dd_id":"AC4","dd_text":"A non-permanent failure is not recorded and is retried next pass"},{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k warns_and_the_repeat -q","dd_id":"AC5","dd_text":"First impossible link WARNs; the repeat skip emits no WARNING"},{"command":"python -m pytest tests/unit/rebar_reconciler/apply/test_impossible_links_cicada.py -k durably -q","dd_id":"AC6","dd_text":"The record is durable and survives a fresh store instance"},{"command":"make lint && make typecheck && python -m pytest tests/unit/rebar_reconciler/apply tests/unit/rebar_reconciler/diffing -q","dd_id":"AC7","dd_text":"Lint, typecheck, and the existing inbound-link suites pass unchanged"}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"V