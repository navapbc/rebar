{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast,subprocess,sys\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nclass S(ast.NodeTransformer):\n def generic_visit(self,n):\n  n=super().generic_visit(n)\n  if isinstance(n,(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)) and n.body and isinstance(n.body[0],ast.Expr) and isinstance(n.body[0].value,ast.Constant) and isinstance(n.body[0].value.value,str): n.body=n.body[1:]\n  if isinstance(n,ast.TypeIgnore): n.lineno=0\n  return n\ndef tree(ref,p):\n s=subprocess.check_output([\"git\",\"show\",f\"{ref}:{p}\"],text=True)\n return ast.dump(S().visit(ast.parse(s,type_comments=True)),include_attributes=False)\nbad=[p for p in sys.argv[1:] if tree(BASE,p)!=tree(\"HEAD\",p)]\nif bad: raise SystemExit(f\"normalized AST changed: {bad}\")' tests/unit/test_eval_solver.py tests/unit/test_external_canary.py tests/unit/test_external_integration_cloud_mutation_workflow.py tests/unit/test_external_mutation_diagnostics.py tests/unit/test_external_tier_gate_ref.py tests/unit/test_external_tier_live_reachability.py tests/unit/test_extra_coverage_guard.py tests/unit/test_fcntl_import_guard.py tests/unit/test_fetch_common_dir_coordination.py tests/unit/test_fidelity_spot_eval.py tests/unit/test_file_tombstone_behavior_d064.py tests/unit/test_first_request_window_f79d.py tests/unit/test_fixture_admission_heldout.py tests/unit/test_fixture_admission.py tests/unit/test_fixture_emit_heldout.py tests/unit/test_fixture_emit.py tests/unit/test_fixture_heal_heldout.py tests/unit/test_fixture_heal.py","dd_id":"semantic","dd_text":"All scoped Python files have exactly equal normalized ASTs against the immutable audit basis."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io,re,subprocess,sys,tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"; PAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\")\ndef sig(ref,p):\n s=subprocess.check_output([\"git\",\"show\",f\"{ref}:{p}\"],text=True); lines=s.splitlines(); out=[]\n for t in tokenize.generate_tokens(io.StringIO(s).readline):\n  if t.type!=tokenize.COMMENT or not PAT.match(t.string): continue\n  row,col=t.start; left=lines[row-1][:col].rstrip(); anchor=(\"inline\",left) if left else (\"next\",next((x.strip() for x in lines[row:] if x.strip() and not x.lstrip().startswith(\"#\")),\"<EOF>\")); out.append((t.string,anchor))\n return out\nbad=[p for p in sys.argv[1:] if sig(BASE,p)!=sig(\"HEAD\",p)]\nif bad: raise SystemExit(f\"directive text/attachment changed: {bad}\")' tests/unit/test_eval_solver.py tests/unit/test_external_canary.py tests/unit/test_external_integration_cloud_mutation_workflow.py tests/unit/test_external_mutation_diagnostics.py tests/unit/test_external_tier_gate_ref.py tests/unit/test_external_tier_live_reachability.py tests/unit/test_extra_coverage_guard.py tests/unit/test_fcntl_import_guard.py tests/unit/test_fetch_common_dir_coordination.py tests/unit/test_fidelity_spot_eval.py tests/unit/test_file_tombstone_behavior_d064.py tests/unit/test_first_request_window_f79d.py tests/unit/test_fixture_admission_heldout.py tests/unit/test_fixture_admission.py tests/unit/test_fixture_emit_heldout.py tests/unit/test_fixture_emit.py tests/unit/test_fixture_heal_heldout.py tests/unit/test_fixture_heal.py","dd_id":"directives","dd_text":"Directive text and attachment remain exact in every scoped file."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess,sys\nexpected=sorted(sys.argv[1:]); actual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD