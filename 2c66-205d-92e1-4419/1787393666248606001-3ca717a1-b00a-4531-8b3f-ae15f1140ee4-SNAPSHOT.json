{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787393666248606001,"compiled_state":{"alias":"viceregal-granite-sloth","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"c530880907d501231bf80a744678f2e0db2024d7","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 2c66-205d-92e1-4419","material: fb15f738d621879f","material-part: children 647ea2107ca5072f 0","material-part: description 014b69c5c7899c5d 7940","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 9f20d8c132447e89 3","material-part: ticket_id ca84593b29f3c05a 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (c530880907-dirty)","regver: aa61189569d34126","verified-at-sha:b86a1b4c293ab98480c4561ef5eb48e317bfa872","plan-material-pin: prerequisite a8ea-be28-2394-4f0c a7f326fc82f839b1","dep cc32f320b758b69f665a071ea88818268f24c0c594bb43c5f3f67ebe71e8807e src/rebar/_engine/rebar_reconciler/outbound_comments.py","dep a7c22be84cc7d45a85f96a3222a91228a8afe4f5d2d1e79f3eb72301e0d19606 src/rebar/_engine/rebar_reconciler/pass_io.py","dep absent tests/unit/rebar_reconciler/test_parent_breadcrumb.py","read-set: 13","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/adf.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/j