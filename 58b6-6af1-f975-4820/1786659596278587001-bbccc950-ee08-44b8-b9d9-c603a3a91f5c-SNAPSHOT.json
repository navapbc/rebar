c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3c6a3f17e9662c359a76c84a9173277ff54b83ac0d1f918cc6624306c9e29822","event_uuid":"9439cb9b-b0e4-41e1-9c06-0b70f10eeb44","position":{"commit_sha":"560ef60b45380bf3a0203c5b631a1bfe08da9717","position":"1785908937370720001-9439cb9b-b0e4-41e1-9c06-0b70f10eeb44"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"duplicate","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Duplicate of 7e90-233b-3ee9-4f14, which was filed concurrently by the orchestrator for the same root cause (980d's Git version floor gate reads .github/git-version-floor.txt from the checked-out patchset tree, while the Gerrit Verified lane supplies the workflow definition from main). Closing in favour of 7e90; the ee2a if-present-guard suggestion in this ticket's description is the same remedy.","timestamp":1785908916530925001}],"created_at":1785908868692812001,"creation_channel":"cli","deps":[{"link_uuid":"406b82e2-bef9-47cf-ba4d-d83c068c6407","relation":"discovered_from","target_id":"fd30-a088-cbbc-4dbd"},{"link_uuid":"387a049c-7484-4bf3-ac1e-bf05c8c00f95","relation":"duplicates","target_id":"7e90-233b-3ee9-4f14"}],"description":"## Symptom\n\nGerrit change 1416 (ticket fd30) earned `LLM-Review +1` but `Verified -1`. The failing step was\n`Git version floor gate` in `build-and-test / pytest`, with:\n\n    ##[error]missing .github/git-version-floor.txt (the single source of the Git version floor)\n\nThe change touched only `Makefile`, `docs/local-dev-env.md` and `docs/user-guide.md` -- nothing\nrelated to git versions.\n\n## Root cause\n\n`.github/git-version-floor.txt` was introduced by ticket 980d ('declare and enforce the Git 2.38+\nfloor'). The Gerrit Verified lane takes the workflow **definition** from the target branch (main,\nwhich now has the gate) but checks out the **change's tree** (which predates the file). So the gate\nruns against a tree that cannot contain its own input.\n\n`.github/workflows/_build-and-test.yml` already documents this exact hazard and its remedy under\nticket ee2a -- the 'Definition-vs-tree skew guard': a new gate step that consumes a repo file must\nskip, with a log line, when that file is absent from the checked-out tree, then re-enforce on rebase\nand on every post-merge change. The `raw-git-write` gate implements it. The Git version floor gate\ndoes not.\n\n## Impact\n\nEvery open change whose base predates 980d gets a spurious `Verified -1` and must rebase, even when\nits diff is unrelated. This is noise that trains agents and humans to treat `Verified -1` as\n'probably just rebase', which erodes the value of the gate.\n\n## Suggested fix\n\nWrap the floor gate's step in the same if-present guard the raw-git-write gate uses: when\n`.github/git-version-floor.txt` is not in the checked-out tree, echo a skip line and pass.\n\n## Acceptance Criteria\n\n- [ ] The Git version floor gate skips (with a log line) when `.github/git-version-floor.txt` is\n      absent from the checked-out tree, and enforces normally when present.\n- [ ] A change based before 980d no longer earns `Verified -1` for this reason.\n- [ ] A survey of other gate steps added since ee2a confirms each either consumes no repo file or\n      carries the guard.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"b54f3329-f8ac-4be7-ac85-8192bc93a00d","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","tags":[],"ticket_id":"58b6-6af1-f975-4820","ticket_type":"bug","title":"Git version floor gate lacks the ee2a if-present guard, so it fails every change based before 980d","verify_commands":[]},"source_event_uuids":["816b60d9-19ef-42b7-b31d-91395d04c74b","406b82e2-bef9-47cf-ba4d-d83c068c6407","387a049c-7484-4bf3-ac1e-bf05c8c00f95","e9b3a311-d08a-40de-a8cc-982c036e2c0b","b54f3329-f8ac-4be7-ac85-8192bc93a00d","9439cb9b-b0e4-41e1-9c06-0b70f10eeb44"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659596278587001,"uuid":"bbccc950-ee08-44b8-b9d9-c603a3a91f5c"}