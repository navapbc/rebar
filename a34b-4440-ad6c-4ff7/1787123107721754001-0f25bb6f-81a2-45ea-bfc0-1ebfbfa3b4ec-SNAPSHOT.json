94c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"faff94b8f7b8abe17b8fd0235005b7af3c4f4351e4be1b29e0a448dc6ae85560","event_uuid":"6fd9de87-5bcf-470d-b128-7121ec6e4164","position":{"commit_sha":"ceb44375f662c359ec764181444afa6c22528183","position":"1787121121215280001-6fd9de87-5bcf-470d-b128-7121ec6e4164"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented + landed via Gerrit 1894 (MERGED to origin/main; LLM-Review +1, Verified +1). Commit fa48354e51 rebar-ticket:a34b-4440-ad6c-4ff7. 12 legacy config-ownership rows drained (11 cut to owned resolvers, 1 read-via marker). Held-out oracle tests/scripts/test_reconciler_jira_seam_clean_heldout.py 9/9 GREEN + teeth-verified (ImportError-guard mutation -> RED). All AC met.","timestamp":1787120690362003001}],"created_at":1787107007614446001,"creation_channel":"cli","deps":[{"link_uuid":"0e30edf5-71c5-47ed-b147-926d49c98bae","relation":"relates_to","target_id":"8c83-6f34-7685-4e20"}],"description":"## Context\nSlice C1 recorded 12 below-seam ambient config reads in the reconciler JIRA adapter/credential surface as `LEGACY_EXCEPTIONS` rows in `scripts/config_ownership_exceptions.py`, below the seams enforced by the in-process AST gate `scripts/check_config_ownership.py`. Parent C3a 6633-219e-988a-42f6; grandparent C3 075b-1479-dcb7-40ab. Disjoint file subtree from sibling C3a-CORE (ba8b).\n\nThe 12 flagged reads (path :: symbol), all under `src/rebar/_engine/rebar_reconciler/`:\n- `access_check.py` :: JIRA_URL, JIRA_USER, JIRA_PROJECT (probe scope + probe client)\n- `adapters/jira/acli_subprocess.py` :: JIRA_URL, JIRA_USER, JIRA_PROJECT (env fallback), load_config (`_acli_call_timeout` L86, `resolve_jira_settings` L119)\n- `adapters/jira/outbound_fields.py` :: REBAR_RECONCILER_VERBOSE via the `_rebar_env` shim\n- `adapters/jira_datacenter/settings.py` :: load_config (`resolve_comment_max_chars` L83, `resolve_jira_datacenter_settings` L97)\n- `adapters/jira_family/rich_text.py` :: load_config (`cutover_clients` L90)\n- `adapters/jira_family/wiki_render.py` :: load_config (`_pandoc_timeout` L352)\n\nAffected SOURCE files: the 6 above plus `src/rebar/config.py`/`_config_sources.py` (owned resolvers) and `scripts/config_ownership_exceptions.py` (remove rows).\n\n## Why the JIRA_* reads are flagged (gate mechanism)\nThe gate classifies `os.environ.get(\"X\")` as owner=**credential** only if X is a derived credential name (`rebar._child_env._ADAPTER_SECRET_NAMES` = ONLY `JIRA_API_TOKEN`/`JIRA_PAT`; JIRA_URL/USER/PROJECT are intentionally absent/non-secret), else owner=**composition**. So JIRA_URL/USER/PROJECT are owner=composition reads: even as direct `os.environ.get` literals in a credential-boundary file they stay flagged. The correct cut routes them through an OWNED `config.py` resolver (composition root). The `JIRA_API_TOKEN`/`JIRA_PAT` reads are owner=credential, already owned, out of scope.\n\n## Decision rule\n- **(a) CUT-TO-SEAM (11 of 12).** A composed-config read is routed through an owned `config.py`/`_config_sources.py` resolver (reuse `compose_config()`/`load_config()`; add narrow named resolvers), so the ambient read moves into the composition root. Each adapter helper delegates to the owned resolver INTERNALLY (signature unchanged). Timing: the JIRA endpoint + reconciler knobs resolve LIVE per operation today (env over file, re-read each call); the resolvers read live per call — never composed once and threaded — so a mid-pass env override is not lost.\n- **(b) OWNED-IN-PLACE via `# read-via:` marker (cap 1 read = 1 line).** `outbound_fields.py` `REBAR_RECONCILER_VERBOSE` — subsystem debug switch (`=1` emits a side-car RECON record; off by default; not in the config schema). No other listed read is marked.\n\n## Cut details (each helper delegates internally, signatures unchanged)\n- **`access_check.py` JIRA_URL/USER/PROJECT** (`_resolve_probe_scope`, `_build_probe_client`): read the non-secret trio from an injectable `env` mapping (default `os.environ`), live per probe, via owned `config.py` `resolve_jira_endpoint(env=None)->(url,user,project)`. `JIRA_API_TOKEN` stays in-boundary (owned).\n- **`acli_subprocess.py`**: `resolve_jira_settings` (L119) non-secret url/user/project resolution (env-over-file + `InsecureUrlError` fail-loud / `ConfigError` degrade) moves into an owned resolver; the helper delegates and appends env-only `JIRA_API_TOKEN`. `_acli_call_timeout` (L86) → owned `resolve_acli_timeout()` (same 0/negative→default clamp).\n- **`jira_datacenter/settings.py`**: `resolve_comment_max_chars` (L83) and `resolve_jira_datacenter_settings` (L97) delegate to owned resolvers preserving FAIL-LOUD (no `except ConfigError`) and `>0 else 0=unlimited`; `JIRA_PAT` stays in-boundary.\n- **`jira_family/rich_text.py`** `cutover_clients` (L90) and **`wiki_render.py`** `_pandoc_timeout` (L352) delegate to owned resolvers preserving BOTH `except ConfigError`→default AND `except ImportError`→default: these helpers run in a stdlib-only pandoc subprocess where `rebar` may not be importable, so the delegation keeps the import lazy/guarded and falls back to the same default when `import rebar...` raises ImportError — the stdlib-only-subprocess importability invariant is unchanged.\n- **`outbound_fields.py` `os.environ.get`**: the module-local `_rebar_env` shim serves only the single VERBOSE read; inline it to a literal `os.environ.get(\"REBAR_RECONCILER_VERBOSE\", \"0\")` (marked, treatment b) and DELETE the unused shim — one caller here; siblings have own copies.\n\n## Affected TEST consumers (updated in-scope)\nDrive the cut env/config through the new resolvers/typed config: `tests/unit/rebar_reconciler/state/{test_config_jira_wiring,test_config_file_wiring,test_acli_subprocess_timeout}.py`; `tests/unit/rebar_reconciler/{test_jira_dc_config_settings,test_rich_text_cutover,test_wiki_render_hardening,test_dc_pat_required_heldout}.py`; probe `tests/scripts/bridge/test_jira_capability_probe.py`. Assertions preserved; only the injection seam changes. Call sites confirmed via Serena `find_referencing_symbols` + a string `grep` — no signature change needed.\n\n## Testing (RED -> GREEN)\nHeld-out `tests/scripts/test_reconciler_jira_seam_clean_heldout.py` (gate scripts imported by bare name: `import check_config_ownership`) asserts: (i) `check(REPO_ROOT)` returns no finding for any of the 6 listed files; (ii) `LEGACY_EXCEPTIONS` has zero entries for a listed file; (iii) `# read-via:` markers across the 6 files total exactly 1, confined to `outbound_fields.py`. Behavior regressions kept green: JIRA endpoint env-over-file LIVE precedence (a mid-pass override is still observed after the cut), `resolve_jira_settings` insecure-url fail-loud + malformed-config degrade, DC fail-loud, the acli timeout clamp, and the rich_text/wiki_render `ImportError`→default degrade — via the consumers above plus `tests/integration/rebar_reconciler`.\n\n## Portability / rollback\nThe gate is in-process AST with no CI-provider trigger; the cutover adds no CI dependency. No stored-format or config-key changes; env/file precedence and defaults are byte-preserved. Rollback = revert.\n\n## Acceptance Criteria\n- [x] The 11 composed-config reads are cut-to-seam through owned resolvers, live-per-call for the JIRA endpoint + reconciler knobs; no ambient config read remains below the seam in the 6 files.\n- [x] Exactly 1 read (`REBAR_RECONCILER_VERBOSE`) is owned-in-place with a `# read-via:` marker; no other listed read is marked.\n- [x] The secret `JIRA_API_TOKEN`/`JIRA_PAT` boundary reads are unchanged (owner=credential, owned).\n- [x] The 12 `LEGACY_EXCEPTIONS` rows are removed; `check_config_ownership.py` passes with no path-glob exception (proven by the held-out oracle incl. marker-total==1 / per-file-placement).\n- [x] The Testing regressions pass: JIRA-endpoint live-precedence, insecure-url fail-loud, DC fail-loud, acli-timeout-clamp, and rich_text/wiki_render ImportError->default degrade each verified; deltas noted as a comment.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/access_check.py","reason":"cut JIRA_URL/USER/PROJECT reads to owned config.py resolve_jira_endpoint; JIRA_API_TOKEN unchanged"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_subprocess.py","reason":"delegate load_config + JIRA_URL/USER/PROJECT to owned config.py resolvers; JIRA_API_TOKEN unchanged"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","reason":"inline+mark REBAR_RECONCILER_VERBOSE (read-via); delete unused _rebar_env shim"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/settings.py","reason":"delegate load_config resolvers to owned config.py; JIRA_PAT unchanged"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_family/rich_text.py","reason":"delegate cutover_clients load_config to owned config.py resolver"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_family/wiki_render.py","reason":"delegate _pandoc_timeout load_config to owned config.py resolver"},{"path":"src/rebar/config.py","reason":"add owned resolvers (jira endpoint, acli timeout, comment_max_chars, dc settings, rich_text cutover, pandoc timeout)"},{"path":"scripts/config_ownership_exceptions.py","reason":"remove the 12 LEGACY_EXCEPTIONS rows for this subsystem"},{"path":"tests/scripts/test_reconciler_jira_seam_clean_heldout.py","reason":"held-out oracle: gate clean + zero exceptions + marker-total==1/per-file placement"},{"path":"src/rebar/_config_sources.py","reason":"Owned jira-endpoint/verbose resolvers re-exported from config for the cut reads."},{"path":"docs/env-vars.md","reason":"Regenerated env-var registry after relocating jira reads to owned seams."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","6633-219e-988a-42f6"],["relates_to","8c83-6f34-7685-4e20"]],"no_file_impact_reason":"","parent_id":"6633-219e-988a-42f6","parent_status_uuid":"cf94d436-a00d-4201-93a7-caa61e15f775","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"a34b-4440-ad6c-4ff7","ticket_type":"story","title":"C3a-JIRA: config-ownership cutover — reconciler JIRA adapter/credential surface","verify_commands":[]},"source_event_uuids":["e41f878f-043b-46ca-bc1e-3796bb213184","540a44e5-1a1f-4717-ab68-9fb83a0f1fcb","57a7d84b-2600-4ec1-b347-c250512cd27e","097d4d5a-4676-4288-afd9-32c0de3a1568","9133b46b-5b4e-4f18-9ff9-154ae3161487","b4bd35fe-9f8c-4771-89c9-839ad2f56c1c","3da64dd5-5fee-48f3-9bcd-4322245b2b53","ccae3bc6-ff27-44e9-b187-d491d2810966","73dfc9d8-e080-407f-a95b-01fa697ee0ce","0e30edf5-71c5-47ed-b147-926d49c98bae","37441317-7a8c-497a-a08d-97e22acb77ba","6dde4828-7825-4ad9-ae96-9604126410ab","cf94d436-a00d-4201-93a7-caa61e15f775","6fd9de87-5bcf-470d-b128-7121ec6e4164"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787123107721754001,"uuid":"0f25bb6f-81a2-45ea-bfc0-1ebfbfa3b4ec"}