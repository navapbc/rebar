5519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788314439476447001,"creation_channel":"cli","deps":[{"link_uuid":"412f8717-a40a-4e66-bd5e-f4c933367de9","relation":"depends_on","target_id":"3b66-615c-fbfb-4b1f"}],"description":"## Context / Problem\n\n`src/rebar/_lib_ops.py:373` and `src/rebar/_mcp_reads.py:575` retain `reconcile(mode=...)` compatibility even after canonical bridge operations exist. The canonical diagnostic/bridge contract is delivered by nosy-drooly-milksnake [rebar:nosy-drooly-milksnake].\n\n## Approach\n\nRemove the Python and MCP `reconcile(mode=...)` entrypoints and their schemas, examples, baselines, and tests. Replace every repository consumer with explicit `bridge_preview`, `bridge_sync`, or `bridge_run` operations and preserve their result contracts. This is a deliberate pre-1.0 public break.\n\n## Scope\n\n- library/MCP operation definitions and exports\n- input/output schemas/baselines, docs/examples, changelog\n- static, dynamic, string, and monkeypatch consumers\n\n## Testing\n\nAssert removed APIs reject before reconciliation execution; run each explicit bridge operation through existing result-contract tests.\n\n## Acceptance Criteria\n\n- [ ] Python and MCP `reconcile(mode=...)` contracts, schemas, examples, and exports are removed.\n- [ ] Every repository consumer calls one explicit canonical bridge operation.\n- [ ] Old library/MCP invocations fail at signature/schema validation before work begins.\n- [ ] Explicit bridge operations retain their documented result and error contracts.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_lib_ops.py","reason":"remove rebar.reconcile(mode=...) compatibility entrypoint"},{"path":"src/rebar/_mcp_reads.py","reason":"remove MCP reconcile(mode=...) compatibility tool/input"},{"path":"src/rebar/_mcp_models.py","reason":"update generated result/input models if legacy contract owns them"},{"path":"src/rebar/__init__.py","reason":"remove public Python alias export"},{"path":"docs","reason":"replace Python/MCP reconcile examples with explicit bridge operations"},{"path":"CHANGELOG.md","reason":"record pre-1.0 API/MCP breaking removal"},{"path":"tests","reason":"prove old calls reject and bridge operations preserve result contracts"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","3b66-615c-fbfb-4b1f"],["parent","0cfc-e511-8f8a-4c8b"]],"no_file_impact_reason":"","parent_id":"0cfc-e511-8f8a-4c8b","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["janitor","reconciler","mcp","api","breaking-change"],"ticket_id":"c195-03cd-fc03-4ae0","ticket_type":"story","title":"Remove reconcile compatibility from Python and MCP contracts","verify_commands":[]},"source_event_uuids":["629f9669-41b9-467f-982c-5ca0fec49190","8b6b033e-ce4d-480d-b408-8f5f784dc09e","412f8717-a40a-4e66-bd5e-f4c933367de9"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328074203009001,"uuid":"e6769284-b4b1-4792-af37-29230d51e585"}