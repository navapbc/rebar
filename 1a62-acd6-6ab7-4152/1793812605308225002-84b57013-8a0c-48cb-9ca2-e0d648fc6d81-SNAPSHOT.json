{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793812605308225002,"compiled_state":{"alias":"cliffy-nonliving-blacklab","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"1c8a67702f819fde184513c213a5ed0a3eba7e5a","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 1a62-acd6-6ab7-4152","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.14.0 (1c8a67702f8)","material: 92630a73ddddcdb6","verified-at-sha:1c8a67702f819fde184513c213a5ed0a3eba7e5a"],"material_fingerprint":"92630a73ddddcdb6","merged_log_commit":"1c8a67702f819fde184513c213a5ed0a3eba7e5a","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1793812605307116000},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"1c8a67702f819fde184513c213a5ed0a3eba7e5a","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1a62-acd6-6ab7-4152","material: 92630a73ddddcdb6","material-part: children 647ea2107ca5072f 0","material-part: description ccfe5102bd7d3b5f 6878","material-part: description_boxes eaf16bc07968e013 5","material-part: file_impact addbd24d736a3ec6 6","material-part: ticket_id e482148d9eeb7546 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","revi