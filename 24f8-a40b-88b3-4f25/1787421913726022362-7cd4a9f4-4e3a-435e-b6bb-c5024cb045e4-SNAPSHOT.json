9 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787417394012396001,"creation_channel":"cli","deps":[],"description":"## Context\n`docs/config.md` cites obsolete ADR numbers for cross-ticket overlap and transport retry. It also says `REBAR_OPERATION_SNAPSHOT_SHADOW` was removed, while `src/rebar/_operation_config.py` and focused tests still read it as an enabled-by-default diagnostic switch.\n\n## Plan\n- Point cross-ticket overlap guidance to ADR 0086.\n- Point transport retry guidance to ADR 0087.\n- Describe `REBAR_OPERATION_SNAPSHOT_SHADOW` as an active diagnostic switch and state its current default and false-value behavior.\n- Preserve the distinction between diagnostic snapshot composition and behavior-bearing configuration.\n- Change Markdown only and do not alter the switch.\n\n## Acceptance Criteria\n- [ ] Cross-ticket overlap and transport retry links resolve to ADR 0086 and ADR 0087.\n- [ ] The shadow switch is documented as active, diagnostic, and enabled by default.\n- [ ] False spellings and invalid-value behavior match `shadow_enabled()`.\n- [ ] No source, test, or configuration behavior changes.\n- [ ] Targeted documentation index and link checks pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/config.md","reason":"Correct ADR references and diagnostic-switch guidance."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","66c6-2fe5-4850-4297"]],"no_file_impact_reason":"","parent_id":"66c6-2fe5-4850-4297","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f19c","configuration"],"ticket_id":"24f8-a40b-88b3-4f25","ticket_type":"task","title":"F19C correct configuration dec