{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, re, subprocess, sys, tokenize\nBASE='\"'\"'d6669496cae441fc8381b5ee6de21a3993defd84'\"'\"'\nCURRENT='\"'\"'6e3c3571dd5b4f82a0faf55ac4b3f3a44401b708'\"'\"'\nALLOWED=json.loads('\"'\"'{\"tests/unit/test_review_kernel.py\":{\"docs\":[\"<module>\",\"test_pass3_decide_never_stamps_a_severity_key\",\"test_absence_claim_veto_drops_refuted_absence\",\"test_on_target_veto_only_fires_in_execution_review\",\"test_parameterized_threshold_two_consumers_one_kernel\",\"test_verification_contract_shares_the_binary_vocabulary\",\"test_verify_findings_degrades_to_indeterminate_on_unparseable_turn\",\"test_strict_verification_model_rejects_divergent_shape_tolerant_drops\",\"test_reshape_classifies_contract_violations_structurally\",\"test_verify_findings_surfaces_structured_contract_failure_loudly\",\"test_verify_findings_clean_chunk_counts_as_clean_outcome\",\"test_verify_findings_flags_semantically_empty_outcome_as_contract_violation\",\"test_verify_findings_recovered_outcome_counted_distinctly_from_clean\",\"test_verify_findings_mixed_chunks_tally_each_outcome_independently\"],\"comments\":[{\"scope\":\"test_decision_labels_by_construction\",\"before\":\"n_no = len(review_kernel.GRADED_BINARY) // 2 + 1\"},{\"scope\":\"test_verification_contract_shares_the_binary_vocabulary\",\"before\":\"expected_binary = {\"},{\"scope\":\"test_strict_verification_model_rejects_divergent_shape_tolerant_drops\",\"before\":\"assert parse_structured(wrong_wrapper, tolerant).verifications == []\"}]},\"tests/unit/test_reviewbot_bedrock_cutover.py\":{\"docs\":[\"<module>\",\"test_compose_review_bot_sets_no_deprecated