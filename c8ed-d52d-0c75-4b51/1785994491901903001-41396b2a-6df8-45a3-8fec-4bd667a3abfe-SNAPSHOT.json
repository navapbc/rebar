9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5340abbd1920b9555bdb77cf0d34b894bbb32f0ac051fdf3ce2ebd75d2f75551","event_uuid":"ffbfb0e3-5c2f-47df-b282-123058e47708","position":{"commit_sha":"c72f55878016eaff2af84abf71ceaf6b8b58dd19","position":"1784248365970225001-ffbfb0e3-5c2f-47df-b282-123058e47708"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-211_agent","claim_remote_session":null,"claimed_session":"dd03eb60-2371-4b50-91b1-9fd0c63ef175","comments":[{"author":"Joe Oakhart","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"[operator-attested] One-time Jira link-direction repair: NO-OP — no inverted links exist to correct. Live audit on 2026-07-16 classified all 315 depends_on relationships (every pair with both endpoints bound, from the rebar store) against live Jira via REST (GET /rest/api/3/issue/<key>?fields=issuelinks): result = 315 correct / 0 reversed / 0 absent / 0 errors. Spot-verified REB-1 (REB-283 Blocks REB-1 = correct) and the exact cycle-warning cluster REB-832/30ff + siblings REB-833..837 (all correctly oriented). The defect is latent (buggy outbound dedup-skips existing correct links; it would only reverse a brand-new depends_on link synced fresh) — the 07-14 cycle-warning evidence was stale and has since resolved. Therefore no Jira mutation was performed or needed; the code fix (Gerrit 739) prevents future reversal.","timestamp":1784238370730536001}],"created_at":1784235321465760001,"creation_channel":"unknown","deps":[{"link_uuid":"f0e6461e-d6fd-4259-bdfa-908d971ebe01","relation":"discovered_from","target_id":"8002-a92f-0999-45dd"},{"link_uuid":"2fda924b-c44e-41a7-ad1a-b5fc5b142986","relation":"supersedes","target_id":"ecc7-eee7-9341-4f6d"},{"link_uuid":"ffbfb0e3-5c2f-47df-b282-123058e47708","relation":"relates_to","target_id":"3b86-4e61-4a09-4e4a"}],"description":"## Summary\nOutbound Jira link sync writes `depends_on` dependencies with **inverted endpoints**, because\nthe apply seam drops the `swap_endpoints` flag. This produces backwards \"Blocks\" links in Jira\nand perpetual, non-fatal `rebar.link … \"would create a cycle\"` WARNINGs on every inbound pass.\n\n## Reproduction Steps\n1. Create rebar tickets A, B with `A depends_on B` (B blocks A).\n2. Reconcile outbound to Jira; observe Jira records **\"A Blocks B\"** (WRONG — should be \"B Blocks A\").\n3. Reconcile inbound; the reconciler reads the inverted link and tries `add_dependency(A, B, blocks)`,\n   which collides with the existing `A depends_on B` edge → `check_would_create_cycle` rejects it.\n   Observed live for the 6 closed sibling stories under epic `jira-reb-687` (30ff/a879/95a5/978d/9a82/fd1d).\n\n**Expected:** `A depends_on B` → Jira \"B Blocks A\"; inbound re-read is idempotent (no cycle).\n**Actual:** Jira \"A Blocks B\" (inverted); inbound re-read cycle-rejects on every pass forever.\n\n## Root Cause (verified, runtime-reproduced)\n`depends_on` maps to `(\"Blocks\", swap=True)` — \"A depends_on B\" must be written as \"B Blocks A\".\n- `src/rebar/_engine/rebar_reconciler/outbound_links.py:121`: `jira_type, _swap = mapped` — **`_swap`\n  is discarded**; the emitted mutation carries `type`/`to_key`/`relation` but no direction correction.\n- `src/rebar/_engine/rebar_reconciler/dispatch_one.py:831`: applies `set_relationship(issue_key,\n  to_key, link_type)` — always making `issue_key` the outward/blocker side; **`relation` is never read,\n  no swap anywhere in the apply path.** This violates the module's own documented contract\n  (`outbound_links.py:105`: \"swap_endpoints is handled by the applier when issuing the directional\n  Jira call\") and the intent of bug 3f04 (`f57cdcd2d`, \"sync issue-link relationships in both directions\").\n- Pre-existing since 3f04 (2026-06-26); unrelated to the reconcile-bridge outage fix.\n\n## Impact\n- **rebar store:** no divergence/data loss — the acyclic DAG is correct; the rejected inbound links are\n  the inverse edges that *should not* exist. The WARNINGs are cosmetic noise to rebar.\n- **Jira:** real, persistent, SILENT data-fidelity divergence — every `depends_on`-derived link points the\n  wrong way and never self-heals (outbound + inbound are both ADD-only and dedup \"either direction\").\n\n## Acceptance Criteria\n- [ ] Outbound apply honors `swap_endpoints`: a `depends_on` dep emits Jira \"B Blocks A\" (swap `--out`/`--in`),\n  while `blocks` is unchanged. Proof: unit test on the applier for both relations.\n- [ ] `tests/unit/rebar_reconciler/mutate/test_link_sync.py` gains a `depends_on` (swap=True) case (currently\n  only the `blocks`/swap=False path is tested — the gap that let this ship).\n- [ ] After the fix, an inbound pass over an A depends_on B pair applies idempotently (no cycle WARNING).\n- [ ] [operator-attested] one-time repair of the already-inverted Jira links (neither diff self-corrects them).","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","3b86-4e61-4a09-4e4a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ca4ddfe7-03e2-4176-8365-9ce642c219ff","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","tags":[],"ticket_id":"c8ed-d52d-0c75-4b51","ticket_type":"bug","title":"Outbound Jira link sync inverts depends_on direction (drops swap_endpoints) — backwards Jira links + perpetual cycle-warning noise","verify_commands":[]},"source_event_uuids":["1afce2c5-702b-4103-8f33-a987a888c3c7","f0e6461e-d6fd-4259-bdfa-908d971ebe01","2fda924b-c44e-41a7-ad1a-b5fc5b142986","f8a5aef0-bdac-443a-8e76-fc318c5c2bc4","21e3502d-1d73-494b-a071-c160a0d72024","d8d48e80-dd48-4ef9-b83c-61940097c8cc","6720be96-12c5-4a70-b4a0-b3b9901d8808","569b65f0-28f3-4ea8-b88c-cc9e2847e16e","7ce561af-4d15-4736-9219-e39de21662a8","ca4ddfe7-03e2-4176-8365-9ce642c219ff","2b77be37-7e04-482d-9ef2-b30dd7a27fe5","ffbfb0e3-5c2f-47df-b282-123058e47708"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785994491901903001,"uuid":"41396b2a-6df8-45a3-8fec-4bd667a3abfe"}