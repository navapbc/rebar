{"author":"Unknown","author_email":"","data":{"content_hash":"9b172f0782876c1c3c6b53330f5e6814f4e20ce5f22d71824c51f21c653d908a","digest":{"component_or_area":"docs/README.md index and navigation","key_entities":["docs/README.md","intent router","troubleshooting table","claim/transition","rebar-mcp","mcp extra","global build","repo venv"],"problem_keywords":["documentation","navigation","routing","troubleshooting","onboarding","intent-based","audience segmentation"],"propositions":["Documentation README lacks intent-based routing for four distinct audiences: human clients, LLM clients, human contributors, LLM contributors.","Users cannot quickly locate the correct documentation path for their use case or role.","Common failure modes lack a compact, centralized troubleshooting reference with symptom-to-fix mappings.","The troubleshooting table must resolve specific symptoms (claim/transition exit code 10, missing rebar-mcp, stale build configuration) to concrete recovery steps."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1785820330972998358,"uuid":"42ff77b9-fc82-42db-8db1-2cf51f8ec2ff"}