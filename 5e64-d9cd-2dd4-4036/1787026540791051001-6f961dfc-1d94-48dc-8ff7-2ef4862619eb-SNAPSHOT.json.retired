e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"337f87ab0c5c21aee4ba91194ed0559c7f777396be5c57d1c88685adfef32f07","event_uuid":"45cc852f-4a37-4d21-ae2e-459788d83914","position":{"commit_sha":"2902b2e8d1d4fbf7df3a7791a0a3b4a67c164278","position":"1787023738321580001-45cc852f-4a37-4d21-ae2e-459788d83914"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"41018bbbcb27f447252a734af464f9157c224eff858823a405295f7e8cd0e2a8","event_uuid":"f39e59e0-2b02-4d5c-9bd9-23bf62dde666","position":{"commit_sha":"6b8aaa0efcf625e56b20c59e5212e440be8e9a2f","position":"1787023885318884001-f39e59e0-2b02-4d5c-9bd9-23bf62dde666"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"476596807f78d6f5234565873cb95903725185e1f056ac9fc04ca1c5c632b1ff","event_uuid":"9f2583dc-9803-4428-b090-1cffac8a90df","position":{"commit_sha":"158fe4546117d929c0192e9857ac5ba749343dd7","position":"1787023926488957001-9f2583dc-9803-4428-b090-1cffac8a90df"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f0367a660475fa46412ae991c3a69a40df8b4585137b27941b8361e1959c6c3e","event_uuid":"33a0f6be-59bd-45d2-9906-2b4aba3c351d","position":{"commit_sha":"11c0cb46bbf935c6d806cf5abb422b347909833b","position":"1787024200849740001-33a0f6be-59bd-45d2-9906-2b4aba3c351d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787022368517469001,"creation_channel":"cli","deps":[{"link_uuid":"5bb96047-4c47-4773-9780-923fbbf2b44a","relation":"discovered_from","target_id":"10c8-9981-3877-4ed5"},{"link_uuid":"cea35be4-555f-4b74-b566-caf7cbc60841","relation":"relates_to","target_id":"9b75-8bb5-601d-402d"},{"link_uuid":"06a5e2e0-5679-489b-a9d9-819675591ca5","relation":"relates_to","target_id":"ee98-a2c0-7d12-4c75"}],"description":"## Context / Problem\n`BindingStore` is the authoritative local-id ↔ Jira identity aggregate and must remain so, but its 799-line module now owns byte persistence, live/reverse lifecycle policy, retirement, recovery, peer-state delegates, comment identity, and GET rotation. New safety rules have no cohesive owner, and production code mutates an inner entry returned by the shallow `all_bindings()` compatibility query. A mechanical split could regress hard-won crash, index-lag, identity, serialization, and selective-publication behavior.\n\n## Outcome\nKeep one public `BindingStore` facade and existing import/method compatibility while extracting three internal owners: a byte-preserving repository/unit-of-work, lifecycle policy, and incomplete-operation recovery. Typed views remain open over the original dictionaries so unknown fields and exact JSON behavior survive. Add the approved journal-free retirement completion rule: a durable tombstone is authoritative intent, and a live forward/reverse pair is removed only when tombstone, forward, and reverse identities all agree. Only explicit `unretire` revokes that intent; automatic liveness observations never resurrect a tombstoned identity.\n\n## Delivery slices\n1. Extract repository/unit-of-work persistence behind the facade with byte, fault-cut, corruption, rotation-order, and selective-publication regression oracles; establish ADR 0099 with the complete approved target design.\n2. Extract lifecycle policy and add narrow facade operations so new production code no longer needs mutation-through-query while `all_bindings()` remains shallow-compatible.\n3. Extract recovery, cut the live caller to the narrow mutation seam, complete exact-match interrupted retirements before remote issue observation, and finalize ADR 0099 to describe the realized behavior.\n\n## Architectural constraints\n- Preserve `peer_state.py`, `get_rotation.py`, pending → confirmed → reversible retired lifecycle, numeric-ID re-key, comment identity, and the existing five-file selective tickets publication.\n- Preserve unknown fields, `indent=2`, sorted keys, trailing newline, legacy additive reads, and unchanged-pass byte/HEAD idempotency.\n- Corrupt live state still fails closed; retired/rotation/alert/commit failure behavior changes only when this plan names it.\n- Construction, load, check, dry-run, preview, selection, and filtered operations do not perform recovery writes.\n- Live recovery runs after configuration snapshot/preflight and exclusive lock/staleness validation but before remote issue fetch, binding walk, differ, or lifecycle mutation. This ordering prevents an upgraded pass from interleaving new liveness evidence with completion.\n- In a historical overlap, stale `absent_404_count`, automatic 200/`clear_absent`, or same-key confirm cannot revoke the durable tombstone; only explicit `unretire` removes it and thereby eliminates the completion candidate.\n- No general journal, format migration, eager rewrite, broad `git add -A`, deep-copy change to `all_bindings()`, or new identity writer.\n\n## Compatibility / rollback\nEach slice is an internal facade delegation with unchanged stored formats and public signatures. A slice can be reverted independently to the preceding facade implementation. The exact-match repair is additive and idempotent: disabling its pre-observation live-operation call restores the prior detectable overlap without rewriting coherent stores. Rollback never deletes a remote issue or implies automatic unretire.\n\n## Acceptance Criteria\n- [ ] Existing `BindingStore` imports, signatures, shallow `all_bindings()` behavior, unknown-field preservation, and exact serialization remain compatible through direct-loader and public-facade tests.\n- [ ] Repository fault-cut tests preserve current rotation-before-live ordering, per-file atomic replacement, selective five-file publication, and explicit failure outcomes.\n- [ ] Lifecycle tests preserve both-index identity guards, pending/confirmed/retired rules, 404 grace/reset, immutable-ID re-key, tombstone suppression/unretire, and append-only comment identity.\n- [ ] Recovery tests prove keyed/keyless create recovery and exact-match retirement completion are idempotent; repair runs before remote observation, identities must agree, and ambiguity/replace failure safety-aborts.\n- [ ] Automatic liveness signals do not override durable retirement intent; explicit `unretire` removes the tombstone and prevents completion.\n- [ ] Load/check/dry-run/preview/selection/filtered tests prove zero recovery writes; only a validated write-bearing operation may repair an interrupted retirement.\n- [ ] ADR 0099 identifies preserved behavior, the intentional repair behavior, explicit-unretire reversal, pre-observation ordering, rollback, and the prohibition on broad tickets-branch staging.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_store.py","reason":"Stable public facade over the new internal owners."},{"path":"src/rebar/_engine/rebar_reconciler/binding_repository.py","reason":"Byte persistence and unit-of-work owner."},{"path":"src/rebar/_engine/rebar_reconciler/binding_lifecycle.py","reason":"Identity and lifecycle policy owner."},{"path":"src/rebar/_engine/rebar_reconciler/binding_recovery.py","reason":"Create and interrupted-retirement recovery owner."},{"path":"src/rebar/_engine/rebar_reconciler/run_differs.py","reason":"Validated live-operation recovery boundary."},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"Narrow facade mutation cutover."},{"path":"docs/adr/0099-binding-store-internal-ownership.md","reason":"Architecture and behavior decision record."},{"path":"tests/unit/rebar_reconciler/state/test_binding_repository.py","reason":"Persistence fault-cut evidence."},{"path":"tests/unit/rebar_reconciler/state/test_binding_lifecycle.py","reason":"Lifecycle invariant evidence."},{"path":"tests/unit/rebar_reconciler/state/test_binding_recovery.py","reason":"Recovery and read-only-boundary evidence."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["relates_to","9b75-8bb5-601d-402d"],["relates_to","ee98-a2c0-7d12-4c75"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["janitor","rp02","reconciler","architecture"],"ticket_id":"5e64-d9cd-2dd4-4036","ticket_type":"epic","title":"RP-02 — Decompose binding persistence, lifecycle, and recovery behind BindingStore","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_binding_repository.py tests/unit/rebar_reconciler/state/test_binding_lifecycle.py","dd_id":"AC1-AC3","dd_text":"Repository and lifecycle compatibility across extracted owners"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_binding_recovery.py tests/unit/rebar_reconciler/orchestrate/test_recovery_write_boundary.py","dd_id":"AC4-AC6","dd_text":"Recovery exactness, tombstone intent/reversal, and read-only pre-observation operation boundary"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_check_docs_index.py tests/scripts/test_check_adr_numbers.py tests/unit/rebar_reconciler/state/test_binding_retired_commit.py","dd_id":"AC7","dd_text":"Finalized architecture record and selective publication regressions"}]},"source_event_uuids":["acf23f91-c524-4585-91c2-af51681fdade","5bb96047-4c47-4773-9780-923fbbf2b44a","cea35be4-555f-4b74-b566-caf7cbc60841","06a5e2e0-5679-489b-a9d9-819675591ca5","d4f3b4cf-b5d6-4b54-83b5-eda7e96ac77e","9da08790-6c78-440e-8cff-c0510acee605","dc93c483-6de3-45c1-b2b2-4f52b99b20ad","45cc852f-4a37-4d21-ae2e-459788d83914","f39e59e0-2b02-4d5c-9bd9-23bf62dde666","9f2583dc-9803-4428-b090-1cffac8a90df","33a0f6be-59bd-45d2-9906-2b4aba3c351d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787026540791051001,"uuid":"6f961dfc-1d94-48dc-8ff7-2ef4862619eb"}