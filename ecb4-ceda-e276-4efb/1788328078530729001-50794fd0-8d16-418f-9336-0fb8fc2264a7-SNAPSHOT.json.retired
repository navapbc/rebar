ayload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5c3560d1da06b6ca2767d32a0e0e36f8c66bb14f84b369bd9fe0aa4e0cf2342a","event_uuid":"8a56e48a-29a6-4537-900a-ba58f57937fa","position":{"commit_sha":"48ace54fcaae4f22cd984fc9dedf889536577705","position":"1788316325566508001-8a56e48a-29a6-4537-900a-ba58f57937fa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788313758177836001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n\n`src/rebar/_mcp_llm.py:217-254` and generated `docs/mcp-reference.md:54` advertise plan-review P1-P9 while production executes P1-P11 (`plan_review/registry.py:118`, `det_floor.py:1`, `workflow_ops.py:13`). Code-review lifecycle comments across review-kernel, prompting, workflow, and review-workflow modules also contradict the shipped four-pass gate.\n\n## Approach\n\nCorrect the existing canonical tool descriptions and source-local ownership comments, then regenerate the current MCP reference with the existing generator. Do not introduce a second executable review-policy registry.\n\n## Scope\n\n- MCP LLM tool descriptions and affected review/code-review source comments\n- `scripts/gen_mcp_reference.py`, generated MCP reference, and its tests\n\n## Testing\n\nRegenerate the reference, run its generator test, and assert the canonical descriptions name P1-P11 and the current four-pass lifecycle.\n\n## Acceptance Criteria\n\n- [ ] Canonical MCP tool descriptions advertise P1-P11 exactly as implemented.\n- [ ] Canonical code-review comments describe the shipped four-pass execution rather than future, legacy, or single-pass states.\n- [ ] `docs/mcp-reference.md` is regenerated from the corrected source descriptions.\n- [ ] `tests/unit/test_gen_mcp_reference.py` and focused documentation checks pass without adding a new registry.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_mcp_llm.py","reason":"correct canonical MCP tool descriptions"},{"path":"src/rebar/llm/review_kernel/__init__.py","reason":"correct review lifecycle ownership comment"},{"path":"src/rebar/llm/review_kernel/discovery.py","reason":"correct review lifecycle comment"},{"path":"src/rebar/llm/prompting/prompts.py","reason":"correct canonical four-pass prose"},{"path":"src/rebar/llm/plan_review/workflow_ops.py","reason":"correct workflow lifecycle comment"},{"path":"src/rebar/llm/review_workflows.py","reason":"correct code-review execution comment"},{"path":"scripts/gen_mcp_reference.py","reason":"regenerate current reference from canonical descriptions"},{"path":"docs/mcp-reference.md","reason":"generated MCP contract reference"},{"path":"tests/unit/test_gen_mcp_reference.py","reason":"verify reference generation"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","78f2-b104-e3c9-4b86"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["janitor","documentation","mcp","rp21"],"ticket_id":"ecb4-ceda-e276-4efb","ticket_type":"task","title":"Correct canonical review and gate descriptions and regenerate MCP reference","verify_commands":[]},"source_event_uuids":["005a6147-d722-457e-9034-3eb5c0a65d23","917545d7-c4d4-4873-afcd-e44733db369c","8a56e48a-29a6-4537-900a