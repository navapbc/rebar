.95,"blocking_enabled":false,"checklist_item":"- [ ] Name the doc/ADR to add or update covering the `headers` field, `REBAR_LLM_HEADERS`, `-c llm.headers`, and the `${env:}`/`${run:}` grammar with its closed vocabulary.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5e","T7"],"criteria":["T7","T5e"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["'so there is one documented precedence story' implies documentation exists yet no doc file is listed in Scope","New env var REBAR_LLM_HEADERS, new CLI key llm.headers, and a new placeholder grammar are user-visible config with no doc/ADR target named"],"finding":"The change introduces a new operator-facing config surface (the `headers` field, the `REBAR_LLM_HEADERS` env var, and the `-c llm.headers=<json>` CLI form) plus a closed `${env:...}`/`${run:...}` grammar, but the plan names no documentation to add or update for it.","group_criteria":null,"group_id":null,"id":"f629b535bc59b3710","impact":1.0,"is_primary":null,"location":"Approach / Scope","norm_id":"n6445c147ee6a3063","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["An operator configuring gateway headers has no documented reference for the grammar or precedence","The closed ${run:...} vocabulary (trace_id/ticket_id/operation) is undocumented for consumers"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State why headers.py reimplements ${env:VAR} resolution rather than reusing/factoring the existing resolver in workflow/executor.py (_ENV_RE + sub_env at :304-310, same unset-is-hard-error disposition), or note the deliberate divergence and its rationale.","cohort":["A1"],"criteria":["A1"],"decision":"advisory","decision_margin":-0.95,"drop_reason":null,"evidence":["executor.py:73 `_ENV_RE = re.compile(r\"\\$\\{env:([A-Za-z_][A-Za-z0-9_]*)\\}\")`","executor.py:304-310 sub_env raises `environment variable {var!r} is not set` on unset — same disposition the plan calls a 'hard error, matching the REBAR_LLM_CONFIG_FILE rule'","lint_refs.py and lint.py also already special-case the `${env:` token, so this is the second/third site parsing the same syntax","Plan text names headers.py as owner of '${env:...} resolution' with no reference to the existing resolver"],"finding":"The plan builds a fresh ${env:VAR} resolver in the new headers.py without acknowledging the existing ${env:VAR} resolution already in src/rebar/llm/workflow/executor.py (the _ENV_RE regex at :73 and resolve_value/sub_env at :304-310), which uses the identical 'unset variable is a hard error' disposition the plan proposes.","group_criteria":null,"group_id":null,"id":"f369b5ec535eaae8e","impact":0.0,"is_primary":null,"location":"Approach — 'Grammar and validation live in a new leaf module src/rebar/llm/headers.py … ${env:...} resolution'; Scope bullet 'src/rebar/llm/headers.py (new)'","norm_id":"n34d5af87b7d1ff46","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["An operator learns two subtly different ${env:} grammars (workflow's ${env:} + ${{}} vs headers' closed ${env:}/${run:}) that diverge over time","A future fix to env-var-unset behavior must be applied in two places"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Ground the 'vendor SDKs merge caller headers last' claim in a cited SDK doc or a probe test for BOTH vendor SDKs, or restate the denylist rationale so it does not depend on an unverified per-SDK merge order.","cohort":["T1"],"criteria":["T1"],"decision":"advisory","decision_margin":-0.7,"drop_reason":"novelty","evidence":["Plan text: 'both vendor SDKs merge caller headers last, so a caller-supplied Authorization silently displaces the real credential'","T1(c): 'unverified capability assertions (library supports X) are resolved'","Retrieved: anthropic SDK exposes default_headers (pypi.org/project/anthropic) but the caller-override/merge-precedence order is not established by the plan","The denied set (authorization, x-api-key, etc.) and the whole 'nothing is sent yet' framing depend entirely on this merge-order behaviour being true for BOTH SDKs"],"finding":"The plan's central security justification — 'both vendor SDKs merge caller headers last, so a caller-supplied Authorization silently displaces the real credential' — is an unverified capability assertion. It is the load-bearing claim that makes the denylist necessary, yet the plan cites no SDK doc, source, or test establishing the merge order for either vendor SDK.","group_criteria":null,"group_id":null,"id":"f601666ee4aa99e99","impact":0.0,"is_primary":null,"location":"Context / Problem section: 'both vendor SDKs merge caller headers last'","norm_id":"na2568dad7185dc7b","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["If one vendor SDK actually merges configured credentials LAST (caller headers cannot displace), the denylist for that provider is defending against an impossible threat","If merge order differs between the two SDKs, a single denylist may be correct for one and wrong for the other"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Acknowledge existing header-validation prior art (email.headerregistry / http.client illegal-value checks / httpx LocalProtocolError) and justify the bespoke CR/LF/NUL + token-char validator, or reuse a vetted primitive for the value/name checks while keeping the rebar-specific denylist.","cohort":["T1"],"criteria":["T1"],"decision":"advisory","decision_margin":-0.7,"drop_reason":"novelty","evidence":["resolve_symbol confirmed http.client._is_illegal_header_value and email.headerregistry are importable in this environment","Retrieved: httpx docs / httpcore raise LocalProtocolError('Illegal header value') on CRLF-bearing values","T1(a): 'relevant prior art is considered before committing — not reinventing something that exists'","Plan gives a strong reason for config-time validation (SDK merges caller headers last; must reject before delivery) but does not weigh it against reusing existing validators"],"finding":"The value-level validation (rejecting CR, LF, NUL and enforcing RFC 7230 token chars for names) reinvents header-validation that the stdlib and the HTTP stack already provide, with no prior-art acknowledgement. http.client._is_illegal_header_value and email.headerregistry exist in the environment, and httpx/httpcore already raise LocalProtocolError on illegal header values. The plan should note these and justify a bespoke check (the config-time timing and the credential-displacement denylist ARE rebar-specific; the raw CR/LF/NUL scan largely is not).","group_criteria":null,"group_id":null,"id":"fb3ce356762ab4b1f","impact":0.0,"is_primary":null,"location":"Approach: 'names outside RFC 7230 token characters; values containing CR, LF or NUL'","norm_id":"ncab504a9bef48f55","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["A hand-rolled RFC 7230 token regex risks drifting from the spec (e.g. omitting a permitted token char) where a vetted stdlib/email primitive would not"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"eddf57ce18f032fb","material_parts":{"children":["647ea2107ca5072f",0],"description":["01d09d8204775306",6669],"description_boxes":["83b7db61ca197115",0],"file_impact":["c1f244534dfe80ee",3],"ticket_id":["111a8b79a0b45cc8",19]},"metrics":{"cache_read_tokens":0,"cache_write_tokens":0,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":5409.6,"input_tokens":489622,"llm_calls":29,"llm_ms":234446.9,"output_tokens":21700,"precheck":{"cited_anchor_warning":false},"total_ms":254921.7,"verify_requests":17},"model":"bedrock:us.anthropic.claude-sonnet-4-6","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4-6","anthropic:claude-sonnet-4-6"],"capabilities":{"native_structured_output":true,"prompt_cache_style":"none","supports_temperature":true,"supports_thinking":true,"web_access":"off"},"endpoint_host":null,"model":"bedrock:us.anthrop