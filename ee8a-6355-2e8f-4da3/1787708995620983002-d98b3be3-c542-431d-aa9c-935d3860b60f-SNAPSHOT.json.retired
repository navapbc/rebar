RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":7,"unsigned":0},"authorship_ledger":[{"content_hash":"7f92359643f0e79a4906fb1231e73d0337ee12e632a430e7bbb0f1de644114af","event_uuid":"76a9de7a-cecc-4f0e-8cab-80582bab2624","position":{"commit_sha":"2bbc2775edc61be98063b342685dce3635be3af4","position":"1787705208665580001-76a9de7a-cecc-4f0e-8cab-80582bab2624"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8a6c75dbb8151fee90031ca2721330108ce291cfc602b189fa4341d50baaf344","event_uuid":"600c4af6-ccae-4038-970f-c50d1e2e98f8","position":{"commit_sha":"6488821e5977262e7dd0165fcc891d467cd7e8a6","position":"1787705339981183001-600c4af6-ccae-4038-970f-c50d1e2e98f8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"30519991a41f24f4b6678d3fb029be8be109cea775d4b6fe9fd0e4a4ef19a775","event_uuid":"d35d787c-0806-491f-af36-057e13a5f89c","position":{"commit_sha":"78a022cc576d2618da34309e3b442d5ea17bc437","position":"1787706356007473001-d35d787c-0806-491f-af36-057e13a5f89c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"624eff770c51caad723d764fc1617dd4dc040e025a48303fff49c7fdd278094d","event_uuid":"a51bd2fe-5398-4ca8-9f78-a0f4efb73a7a","position":{"commit_sha":"39fbd8b24b5c4e52211c2df069d51a4bd9cc0e4f","position":"1787707014678922001-a51bd2fe-5398-4ca8-9f78-a0f4efb73a7a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"698b286807f66c81da819e262a6ff0c972318ff4a612ce4c447c0ec362348abe","event_uuid":"a6d6f4c5-01c3-40d2-ad01-5ad385aaaf2e","position":{"commit_sha":"295e9c81811bfff720ad8bd9b9fc9de6becc0ec7","position":"1787707701040940001-a6d6f4c5-01c3-40d2-ad01-5ad385aaaf2e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c858b4ae188918558a5a649bd784d4077a0fcd13266ff1ee8a0cd649f3088168","event_uuid":"24aa769a-9d59-44c7-bc08-1c4a3b992573","position":{"commit_sha":"0fe0a7d78ab0b5e1b72fb0368c517ca9dba7d6a3","position":"1787708334441465001-24aa769a-9d59-44c7-bc08-1c4a3b992573"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8b5756c60dff51ebfdd45601c6f8ddf93f50c83a4ae646707eac6b55e48f4e9d","event_uuid":"b30d935e-2b56-4703-a1f2-81cd3513453d","position":{"commit_sha":"66b07d60d1a6ff7e1f0115f225aad05f87cb8d97","position":"1787708995620983001-b30d935e-2b56-4703-a1f2-81cd3513453d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787705208665580001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n\n`LLMConfig` (`src/rebar/llm/config.py:473`) exposes `base_url` and `api_key` but no way to\nattach request headers, so an operator behind a gateway cannot label rebar's gate calls. A raw\ndict is unsafe as-is: both vendor SDKs merge caller headers last, so a caller-supplied\n`Authorization` silently displaces the real credential. This ticket adds the configuration\nsurface and the validation that makes it safe; nothing is sent yet.\n\n## Approach\n\nAdd `headers: dict[str, str] = field(default_factory=dict)` to `LLMConfig`, resolved in\n`from_env` by the three-layer precedence `mcp_servers` already uses at\n`src/rebar/llm/config.py:574-594` (CLI `-c llm.headers=<json>` > `REBAR_LLM_HEADERS` JSON >\nthe `[tool.rebar.llm]` file table), so there is one documented precedence story.\n\n**Precedence only — deliberately not error handling.** `mcp_servers` degrades malformed JSON\nto `{}` silently (`config.py:582-583`, `:593-594`). `headers` does not copy that: malformed\nJSON in any layer raises `LLMConfigError` naming the layer. Silently discarding headers would\nleave an operator with an unattributed gateway and no signal, contradicting the fail-loud rule\nbelow. One fail-loud story for the whole surface.\n\nGrammar and validation live in a new leaf module `src/rebar/llm/headers.py`, keeping\n`config.py` from absorbing them and making the logic testable without building a config.\n\n**The `${...}` grammar is closed.** Exactly two namespaces, `env` and `run`; `headers.py` owns\nthat set and the `${run:...}` key vocabulary (`trace_id`, `ticket_id`, `operation`) as a module\nconstant, so the grammar is self-contained and does not depend on the ticket supplying those\nvalues. Any `${` begins a placeholder; there is no escape for a literal `${`, since no\nlegitimate gateway header value contains one. Dispositions at config-resolution time:\n\n- `${env:VAR}` — resolved now; unset is a hard error, matching the `REBAR_LLM_CONFIG_FILE`\n  rule that a missing path never silently degrades (`config.py:19-21`).\n- `${run:KEY}` — left unresolved (its value exists only inside a gate run), but `KEY` is\n  checked against the closed vocabulary now, so a typo fails at configuration time.\n- Unrecognized namespace (`${foo:bar}`), missing colon (`${envVAR}`), or unclosed `${...}` —\n  hard `LLMConfigError`, never a silently-accepted literal. Passing placeholder text through as\n  a header value would be a silent misconfiguration in a feature meant for attribution.\n\n**Ordering: substitute first, then validate.** Every check runs on the resolved value, never on\na literal containing `${env:...}`. Validating first would let an env var whose value holds\nCR/LF carry an injected header past the check meant to stop it — a configured\n`${env:GATEWAY_TAG}` where `GATEWAY_TAG` is `foo\\r\\nInjected: bar` passes a check applied to\nthe literal, and substitution then injects. Validation therefore runs after `${env:...}`\nsubstitution with any `${run:...}` placeholder still present as literal text (which holds no\ncontrol characters), and the delivery ticket re-runs it after substituting `${run:...}`.\n\nRejected with a named `LLMConfigError`: header names in the denied set `authorization`,\n`x-api-key`, `cookie`, `host`, `proxy-authorization` (case-insensitive, exact-name — these\nforge or displace authentication); names outside RFC 7230 token characters; values containing\nCR, LF or NUL. A denylist rather than an allowlist because arbitrary gateway header names are\nthe point of the feature, and the threats being closed — credential displacement and protocol\ninjection — are themselves closed sets.\n\n## Scope\n\n- `src/rebar/llm/config.py` — the `headers` field and its three-layer resolution in `from_env`.\n- `src/rebar/llm/headers.py` (new) — grammar, `${env:...}` resolution, name/value validation.\n- `tests/unit/test_llm_headers.py` (new) — the tests below.\n\n## Testing\n\nTier: in-process unit tests against the real functions — the mechanism is pure string\nresolution and validation, with no boundary to cross, so no higher tier is warranted.\n\n- Happy path: a literal header and an `${env:VAR}` header both resolve.\n- Grammar dispositions: `${foo:bar}`, `${envVAR}`, `${en:VAR}`, `${env:VAR`, `${run:bogus}`\n  each raise; a well-formed `${run:trace_id}` survives unresolved.\n- Failure paths: each denied name; a name with an invalid character; CR, LF and NUL in values;\n  an `${env:VAR}` naming an unset variable; malformed JSON in the env and CLI layers.\n- Injection-via-indirection: a value of `${env:VAR}` where `VAR` resolves to a string\n  containing a control character is rejected — the ordering regression test.\n- Negative control: `x-authorization-context` is accepted, proving exact-name matching.\n\n## Acceptance Criteria\n\n- [ ] `LLMConfig.headers` defaults to `{}` so an unconfigured deployment is byte-unchanged;\n      checked by a test asserting it with no relevant env set.\n- [ ] Headers resolve from all three layers with CLI > env > file precedence; checked by a test\n      setting all three and asserting the CLI value wins.\n- [ ] A `${env:VAR}` value resolves from the environment; checked by a monkeypatched test.\n- [ ] An `${env:VAR}` naming an unset variable raises `LLMConfigError` naming the variable;\n      checked by `pytest.raises` asserting the name appears in the message.\n- [ ] An unrecognized namespace, missing colon, unclosed placeholder, or `${run:...}` key\n      outside the closed vocabulary each raise `LLMConfigError` rather than being accepted as a\n      literal; checked by a parametrized test over the five forms above.\n- [ ] A well-formed `${run:trace_id}` survives config resolution unresolved; checked by a test\n      asserting the stored value still contains the placeholder.\n- [ ] A value clean as a literal but resolving through `${env:VAR}` to a string containing CR,\n      LF or NUL is rejected; checked by a parametrized test over the three characters, proving\n      validation runs on the resolved value.\n- [ ] Each denied name is rejected case-insensitively; checked by a parametrized test over the\n      five names in three casings.\n- [ ] Malformed JSON in the env or CLI layer raises `LLMConfigError` naming that layer rather\n      than degrading to `{}`; checked by a parametrized test over both layers.\n- [ ] `x-authorization-context` is accepted; checked by a test asserting it survives.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/config.py","reason":"add the headers field and its three-layer resolution"},{"path":"src/rebar/llm/headers.py","reason":"new leaf module: value grammar, env interpolation, name/value validation"},{"path":"tests/unit/test_llm_headers.py","reason":"new tests for resolution, precedence and rejection"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","7e9e-07f7-8fe1-4e38"]],"no_file_impact_reason":"","parent_id":"7e9e-07f7-8fe1-4e38","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"ee8a-6355-2e8f-4da3","ticket_type":"story","title":"Add the LLMConfig headers surface with env indirection and safety validation","verify_commands":[]},"source_event_uuids":["76a9de7a-cecc-4f0e-8cab-80582bab2624","600c4af6-ccae-4038-970f-c50d1e2e98f8","d35d787c-0806-491f-af36-057e13a5f89c","a51bd2fe-5398-4ca8-9f78-a0f4efb73a7a","a6d6f4c5-01c3-40d2-ad01-5ad385aaaf2e","24aa769a-9d59-44c7-bc08-1c4a3b992573","b30d935e-2b56-4703-a1f2-81cd3513453d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787708995620983002,"uuid":"d98b3be3-c542-431d-aa9c-935d3860b60f"}