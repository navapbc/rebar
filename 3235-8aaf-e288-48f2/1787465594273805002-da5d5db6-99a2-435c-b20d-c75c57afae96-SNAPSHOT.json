{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787465594273805002,"compiled_state":{"alias":"crusty-brinish-ass","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"8481a057b69565908c27adfc82c76510f35620dc","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3235-8aaf-e288-48f2","material: 40418b493b87b35d","material-part: children 647ea2107ca5072f 0","material-part: description aa8aa0abcdafe9bc 6313","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 7c318a815c58bf17 3","material-part: ticket_id c6b9afb282fab46e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (8481a057b69-dirty)","regver: aa61189569d34126","verified-at-sha:aec961e9732b60a16a12213b83187857eec1a2ce","dep 55a1c26f90dd5e1f5889880edaa0d362c3130c1eb7026d88eca8aa0c890e80e3 src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","dep 64fda868b8490f546f88370302488ea1390840ebcea2870439a21b9323f80e59 src/rebar/_engine/rebar_reconciler/dispatch_apply_phases.py","dep c91bf562154b90286c2d30af17c71c857465893f2c88dc029e14517c7b78026c tests/unit/rebar_reconciler/apply/test_comment_id_acli_envelope.py","read-set: 11","read-path: src/rebar/_engine/rebar_reconciler/_backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_subprocess.py","read-path: src/rebar/_engine/rebar_reconciler/app