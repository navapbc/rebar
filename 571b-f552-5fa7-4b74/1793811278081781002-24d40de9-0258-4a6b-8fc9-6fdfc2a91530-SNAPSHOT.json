{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793811278081781002,"compiled_state":{"alias":"subsolar-sonorous-puppy","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"02f78b847d28a379ebed74189088c6dc807f6c83","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 571b-f552-5fa7-4b74","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.14.0 (02f78b847d2)","material: 998f15a18327d937","verified-at-sha:02f78b847d28a379ebed74189088c6dc807f6c83"],"material_fingerprint":"998f15a18327d937","merged_log_commit":"02f78b847d28a379ebed74189088c6dc807f6c83","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1793811278081141000},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"02f78b847d28a379ebed74189088c6dc807f6c83","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 571b-f552-5fa7-4b74","material: 998f15a18327d937","material-part: children 647ea2107ca5072f 0","material-part: description e53283a0487364aa 2830","material-part: description_boxes 5dde896887f6754c 2","material-part: file_impact b1d6c380dfc3b8b3 2","material-part: ticket_id 118a176573f79665 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review