59454cc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"418194f9955425ade0b4da61871e7f17e1277763a572f4eb16c952d9df05499d","event_uuid":"d3bfb5c4-5431-42eb-9376-45c7855cdfa2","position":{"commit_sha":"3215995d59a04bd122229b8a55c37cc416ca8ddd","position":"1786079008635467001-d3bfb5c4-5431-42eb-9376-45c7855cdfa2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"36c0824c668865cdb5743db8bedb6385357bd1e16d30629710046f5ab4b0dbf2","event_uuid":"82bb8b95-4427-4e49-8899-e60283701853","position":{"commit_sha":"7bfe9b5119f73a90e3e3f4921cf2a888c5301e83","position":"1786086577577999001-82bb8b95-4427-4e49-8899-e60283701853"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-223_agent","claim_remote_session":null,"claimed_session":"6ff494b3-b67f-4284-9d1e-818a0b7eecfd","comments":[],"created_at":1786051109839774001,"creation_channel":"cli","deps":[{"link_uuid":"fd383f02-f050-44da-9fe1-bc7e17316dba","relation":"relates_to","target_id":"a302-1a8c-49f1-4e25"}],"description":"Three values that are accepted by a signature and then never read. All three were confirmed against\nthe code during the 2026-08-05/06 janitor run; the approved remediation is deletion in every case,\nbecause each \"wire it up\" alternative requires inventing a capability no caller has asked for.\n\n**a. `timeout_s` — `src/rebar/_engine/rebar_reconciler/dispatch_one.py:71`**\n\n`_call_with_retry(fn, *args, timeout_s: int = 30, max_retries: int = 3, **kwargs)` declares,\ndefaults and documents `timeout_s` (\"Per-call timeout in seconds (currently advisory for stub-based\ncallers)\", `:86`) but the body never reads it. Six call sites in `apply_outbound.py` (`:101`, `:109`,\n`:180`, `:202`, `:227`); none passes it.\n\nThe defect is not inertness. Because `timeout_s` is a *named* keyword-only parameter in front of\n`**kwargs`, a caller who passes `timeout_s=60` intending it for the wrapped Jira client has it\n**swallowed by the wrapper instead of forwarded**. This wrapper is on the path for every Jira write.\nDeleting the parameter restores the natural behaviour: `timeout_s` flows through `**kwargs` to `fn`.\n\n**b. `run_eval(dirty=True)` — `src/rebar/llm/evals/eval.py:626`**\n\nDeclared, never read in the body; no caller in `src/` or `tests/` passes it (five `run_eval(` call\nsites, all in `tests/unit/test_eval.py`). The boolean falsely implies the eval-provenance source can\nbe switched.\n\n**c. Two permanently-`Unavailable` metric seeds — `src/rebar/metrics/registry.py:136-158`**\n\n`module_size_trend` and `commit_cadence_trend` both carry `compute=_no_data_yet`, which returns\n`None`, so `evaluate` always yields `Unavailable`. `accruing_since` is `2026-07-18` with no data\nsource landed. `git_metrics.register()` registers six entirely different ids\n(`module_size_distribution`, `oversized_module_count`, `complexity_summary`, `duplication_summary`,\n`churn`, `refactor_to_addition_ratio`), so nothing currently competes for these ids.\n\nThe latent trap: every registrar appends under `if spec.id not in existing`\n(`git_metrics.py:277`, `event_metrics.py:367`, `bug_trends.py:337`). A future real implementation of\n`module_size_trend` would find the seed already holding the id and be **silently skipped** — no\nerror, no warning, and the metric would keep reporting `Unavailable`. Deleting the seeds frees both\nids so a real spec registers cleanly.\n\n`tests/unit/metrics/test_git_metrics_heldout.py:138-142` (`test_trend_unavailable`) asserts the\nplaceholder stays `Unavailable` — a change-detector test pinning a stub in place. It goes with them.\n\nNote: no consumer of the two metric ids was found outside the registry and that test.\n\n## Acceptance Criteria\n\n- [x] `timeout_s` is removed from `_call_with_retry`'s signature and its docstring `Args:` entry;\n      a caller passing `timeout_s=` now reaches `fn` through `**kwargs`\n- [x] `dirty` is removed from `run_eval`'s signature\n- [x] The `module_size_trend` and `commit_cadence_trend` specs are removed from `REGISTRY`, and\n      `_no_data_yet` goes too if it has no remaining user\n- [x] `test_trend_unavailable` is removed\n- [x] `rebar metrics` output no longer advertises two ids that can never carry a value\n- [x] No behavior change to Jira retry/backoff, eval runs, or any metric that reports real data","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/dispatch_one.py","reason":"remove unused timeout_s parameter and its docstring entry"},{"path":"src/rebar/llm/evals/eval.py","reason":"remove unused dirty parameter"},{"path":"src/rebar/metrics/registry.py","reason":"remove two permanently-Unavailable seed specs"},{"path":"tests/unit/metrics/test_git_metrics_heldout.py","reason":"remove test_trend_unavailable which pins the deleted stub"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","b5bc-f4f7-3433-4181"],["relates_to","a302-1a8c-49f1-4e25"]],"no_file_impact_reason":"","parent_id":"b5bc-f4f7-3433-4181","parent_status_uuid":"ad66381e-3cc2-423d-8af4-ad02459454cc","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["janitor"],"ticket_id":"7504-a127-e9b0-42bb","ticket_type":"task","title":"Delete three accepted-then-ignored values: timeout_s, run_eval(dirty=), two metric seeds","verify_commands":[]},"source_event_uuids":["76fe52cf-a119-4550-9b7a-7dcfd28d8b28","121f6050-4191-4fe2-81c7-75c2ec89ef42","66cd2d90-f989-43fe-89dc-e20063446a3e","ad66381e-3cc2-423d-8af4-ad02459454cc","d3bfb5c4-5431-42eb-9376-45c7855cdfa2","fd383f02-f050-44da-9fe1-bc7e17316dba","82bb8b95-4427-4e49-8899-e60283701853"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786086577577999002,"uuid":"b207b492-99bc-4d3a-9fa2-7fbd942375f1"}