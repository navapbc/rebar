-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d6f801dad353a0ecb168c15f3bdda13d6d7956c73b81ebdf6983e4f416b96ab2","event_uuid":"3222ff0a-a36f-4a9f-aebd-ee5c14614915","position":{"commit_sha":"ed056e132ab0a75aed28174643bac1c2f261bfa1","position":"1787336368502146001-3222ff0a-a36f-4a9f-aebd-ee5c14614915"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0e486ad3bb01ad7f36874d8277df3e25c373522e3c32dec2ffb244fda587ac63","event_uuid":"7cda2937-e68a-4257-ab5f-636e187164af","position":{"commit_sha":"310f71e4e866977c41bb7c48eb3da2fb78791db5","position":"1787336529795541001-7cda2937-e68a-4257-ab5f-636e187164af"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"dc3456088e62680cfdd778324277ca2b96df1a6b6be37aad73f442039544eebf","event_uuid":"feb538e7-027f-453a-8492-0af56aca0f7d","position":{"commit_sha":"310f71e4e866977c41bb7c48eb3da2fb78791db5","position":"1787336531112677001-feb538e7-027f-453a-8492-0af56aca0f7d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"956e532f96ce146105ffe50549394493bd532855f4adff1cc8c6955075c4b0a7","event_uuid":"0befb2b9-ab83-4c7e-b97d-76e99afedd08","position":{"commit_sha":"6910d81e456022126a744f831f8fc8aef3b4ec69","position":"1787338820266989001-0befb2b9-ab83-4c7e-b97d-76e99afedd08"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e84d0c8b91754dd436364db96088ca0f982653c3fbf4a697ffc16ca4bd2b43af","event_uuid":"f04a7061-af53-4e52-ac77-79369dff352a","position":{"commit_sha":"be4caa3b7d89dde31d5a9ce1770e79ff98585db8","position":"1787339637440407001-f04a7061-af53-4e52-ac77-79369dff352a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"63fe15d11fbea37b4cda7086764bd5d44fcae8e431eafc90983083a1dccb1572","event_uuid":"83e8faeb-e513-458b-9e0b-733e3bdebd97","position":{"commit_sha":"90431ab9e6926cddc09637ee2649b5c6cd735db3","position":"1787339644527340001-83e8faeb-e513-458b-9e0b-733e3bdebd97"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787290309928978001,"creation_channel":"cli","deps":[{"link_uuid":"92f6031e-dc2a-46d7-8e57-c538a1a8c592","relation":"depends_on","target_id":"bfe7-0900-c3d1-4141"}],"description":"# Config-driven status mapping (map-or-drift, round-trip via rebar-status labels)\n\n## Context / Problem\n\nStatus mapping is hardcoded: outbound reads built-in `local_to_jira_status` at the CREATE/UPDATE\nsites; inbound inverts built-in `jira_to_local_status`, preferring a `rebar-status:<local>` label\nhardcoded to `blocked`/`cancelled`. A project needing a remap/collapse has no echo-safe path.\nMake status config-driven on the S1 core: **map-or-drift** (never coerce); remap/collapse must\nround-trip via `rebar-status:`.\n\n## Dependency (prerequisite ticket)\n\nOn the S1 mapping core **[rebar:bfe7-0900-c3d1-4141]** (merged): `mapping_config` provides\n`load_mapping_config(root=None)` + `resolve_for_project(config, key, *, builtin) -> MappingLayer`\n(merges `builtin ← default ← projects.<KEY>`) with `.status_map` (local→Jira; `SKIP`=drop,\nABSENT=drift). `local_to_jira_status` is the `builtin`, so no `[mapping]` ⇒ effective map =\ntoday's default — behaviour and parity unchanged.\n\n## Approach — one FORWARD seam; inbound stays reverse-map-free\n\nOnly **outbound (forward)** becomes per-project; inbound needs no reverse map/project key — the\n`rebar-status:` label makes every non-built-in status self-describing (see 4).\n\n1. **`config.py` — forward resolution entry point.** Add\n   `effective_status_map(project_key, root=None) -> dict[str,str]` = `load_mapping_config` +\n   `resolve_for_project(builtin=LOCAL_STATUS_TO_JIRA)`. The literal stays the built-in fallback\n   (parity-tested); `mapping_config` imported LAZILY (config.py stays stdlib-only). NO reverse\n   resolution added.\n\n2. **Outbound consumers read the resolved map via the `OutboundMapper` Protocol.**\n   `outbound_differ` resolves the project key once per ticket (`projects_store.resolve_project`\n   already runs) and passes the effective `status_map` (optional; `None`→built-in) into both\n   Protocol methods: `map_local_to_remote` (CREATE, differ:543) and, via `compute_update_fields`\n   (`outbound_field_diff`:291), `map_fields_to_remote` (UPDATE). The `_backend.py` Protocol\n   signatures + the two backend wrappers (`jira/backend`, `jira_datacenter/backend`) gain the\n   param. `.get()` sites reached: shared `outbound_mapper.map_fields_to_remote` (UPDATE,\n   Cloud+DC), `outbound_fields._map_local_to_jira_fields` (Cloud CREATE), `_map_local_to_dc_fields`\n   (DC CREATE). `acli.transition_issue` is NOT threaded — it gets the ALREADY-mapped name (no\n   double-map).\n\n3. **Drift = leave Jira as-is, never a per-mutation failure.** Decided ONLY in the mapper: with\n   no entry for a local status it **omits the `status` field** (Jira unchanged) + a drift alert,\n   replacing today's `.get(status,\"To Do\")` coerce. `reconcile_helpers.preflight_status_mapping`\n   runs AFTER the mapper (`reconcile.py:485`); a drifted mutation carries no `status` field (its\n   skip-when-no-status branch makes it non-offending), but a config REMAP makes the mapper emit a\n   config-only Jira NAME absent from the BUILT-IN keys∪values it tolerates → spurious warning.\n   Widen its tolerated set to built-in keys∪values ∪ `mapping_config.declared_status_names`\n   (thread `repo_root` from `reconcile.py:485`), mirroring step 5's fetcher fix; kill-switch\n   untouched.\n\n4. **Generalised `rebar-status:` round-trip (built-in-reverse stamp rule).** Outbound\n   (`outbound_labels`): stamp `rebar-status:<local>` **iff\n   `config.jira_to_local_status.get(status_map[local]) != local`** (`.get`, no KeyError). On the\n   built-in map this selects exactly {blocked, cancelled} (in_progress/closed are canonical\n   preimages; `deleted` excluded via `excluded_statuses={archived,deleted}`) — default stamping\n   preserved. Under ANY config remap/collapse, every status whose Jira target isn't the built-in\n   canonical name for `<local>` is labelled → inbound recovers it from the label, no reverse map;\n   a DRIFTED status has no target → no label. Inbound: parse the `rebar-status:<local>` suffix,\n   validating `<local>` against the local-status vocabulary (a constant — no config/project key),\n   via one shared helper; the plain `_JIRA_TO_LOCAL_STATUS.get()` built-in fallback stays correct\n   since every non-built-in status is labelled. Malformed `[mapping]` fails closed via S1's\n   `MappingConfigError`.\n\n5. **Fetcher known-set widened.** `fetcher._known_jira_statuses` today reads only built-in\n   `jira_to_local_status` keys → a config-only status trips a spurious \"no reconciler mapping\"\n   warning. Widen to built-in ∪ every Jira NAME declared across config (`status_map` values +\n   `statuses`, from `repo_root`) via `mapping_config.declared_status_names`; kill-switch kept.\n\n## Scope (files)\n\n- `config.py` — `effective_status_map` (forward only, lazy `mapping_config`).\n- `outbound_differ.py` — resolve project key once; pass `status_map` to CREATE/UPDATE Protocol calls + label diff.\n- `outbound_field_diff.py` — `compute_update_fields` forwards `status_map` to `map_fields_to_remote`.\n- `_backend.py` — `OutboundMapper` Protocol: optional `status_map` on both map methods.\n- `adapters/jira/backend.py`, `adapters/jira_datacenter/backend.py` — both wrappers forward `status_map`; DC `_map_local_to_dc_fields` uses it (DC CREATE) w/ fallback + drift-omit.\n- `adapters/jira_family/outbound_mapper.py` — `map_fields_to_remote` uses `status_map` (UPDATE); drift-omit; fallback.\n- `adapters/jira/outbound_fields.py` — `_map_local_to_jira_fields` uses `status_map` (Cloud CREATE); drift-omit.\n- `outbound_labels.py` — stamp rule keyed on built-in `config.jira_to_local_status`.\n- `inbound_fields.py` — generalised `rebar-status:<local>` recovery (shared helper); plain built-in reverse unchanged.\n- `inbound_translate.py` / `apply_inbound_events.py` / `inbound_differ.py` — use shared helper (retire `_REBAR_STATUS_LABEL_TO_LOCAL`).\n- `applier.py` — re-export shared helper in `__all__`.\n- `fetcher.py` — widen `_known_jira_statuses` to built-in ∪ config-declared Jira status names.\n- `reconcile_helpers.py` — widen `preflight_status_mapping` tolerated set to include config-declared names (`repo_root` param).\n- `reconcile.py` — thread `repo_root` into the `preflight_status_mapping` call.\n- `tests/unit/rebar_reconciler/test_status_mapping.py` (new).\n\n## Testing\n\nTier: **in-process unit** — pure over the resolved map; tests hit REAL entry points\n(`config.effective_status_map`, the outbound mappers, `_diff_status_annotation_labels`,\n`inbound_fields._map_jira_to_local_fields`, `fetcher._known_jira_statuses`,\n`preflight_status_mapping`), never copies. Each AC below names its test. Drift/warn alerts are\nnon-fatal stderr lines asserted via `capsys`.\n\n## Acceptance Criteria\n\n- [ ] Effective forward map = `LOCAL_STATUS_TO_JIRA` ← `default` ← `projects.<KEY>` via S1\n  `resolve_for_project`; a non-default overlay changes the outbound target through the real\n  mapper path — `test_status_config_effect`.\n- [ ] An unmapped status **drifts**: the mutation omits `status` (Jira unchanged) + a non-fatal\n  warning; never skipped nor a per-mutation failure — `test_unmapped_status_drifts`.\n- [ ] A config remap AND a collapsed pair (OTHER than blocked/cancelled) round-trip losslessly\n  via `rebar-status:<local>` labels, recovered inbound without a reverse map —\n  `test_status_remap_roundtrip`/`test_status_collapse_roundtrip`.\n- [ ] A config-only/remapped Jira status name is tolerated by BOTH the fetcher known-set AND the\n  post-mapper `preflight_status_mapping` (no spurious warning) —\n  `test_fetcher_known_includes_config`, `test_preflight_tolerates_config_remap`.\n- [ ] The duplicated `_REBAR_STATUS_LABEL_TO_LOCAL` literal is retired: each inbound entry point\n  (`inbound_fields`/`inbound_translate`/`apply_inbound_events`/`inbound_differ`) recovers a\n  generalised label for a local OTHER than blocked/cancelled via the shared helper (the old\n  literal could not) — `test_status_label_helper_single_source`.\n- [ ] `value_maps`↔`config` parity tests in `state/test_config.py` stay green.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/config.py","reason":"add effective_status_map forward resolution over the S1 mapping core (lazy import)"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"resolve project key once; thread effective status_map into the CREATE/UPDATE Protocol calls and the status-annotation label diff"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_field_diff.py","reason":"compute_update_fields accepts and forwards status_map to map_fields_to_remote"},{"path":"src/rebar/_engine/rebar_reconciler/_backend.py","reason":"OutboundMapper Protocol: optional status_map on map_local_to_remote and map_fields_to_remote"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"Cloud backend wrappers forward status_map to the shared mapper / outbound_fields"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","reason":"DC backend wrappers forward status_map; _map_local_to_dc_fields uses it for DC CREATE with built-in fallback and drift-omit"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_family/outbound_mapper.py","reason":"shared map_fields_to_remote uses status_map (UPDATE, Cloud+DC); drift-omit on unmapped; built-in fallback"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","reason":"_map_local_to_jira_fields uses status_map for Cloud CREATE; drift-omit; built-in fallback"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_labels.py","reason":"generalised rebar-status stamp rule keyed on built-in config.jira_to_local_status over the effective forward map"},{"path":"src/rebar/_engine/rebar_reconciler/inbound_fields.py","reason":"generalised rebar-status:<local> label recovery via a shared parse helper; plain built-in reverse lookup unchanged"},{"path":"src/rebar/_engine/rebar_reconciler/inbound_translate.py","reason":"use the shared rebar-status parse helper; retire the duplicated _REBAR_STATUS_LABEL_TO_LOCAL literal"},{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","reason":"use the shared rebar-status parse helper; retire the duplicated literal"},{"path":"src/rebar/_engine/rebar_reconciler/inbound_differ.py","reason":"use the shared rebar-status parse helper in place of the imported literal"},{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"re-export the shared parse helper in __all__ in place of the retired literal"},{"path":"src/rebar/_engine/rebar_reconciler/fetcher.py","reason":"widen _known_jira_statuses to built-in plus config-declared Jira status names so a config-only status is not flagged unmapped"},{"path":"tests/unit/rebar_reconciler/test_status_mapping.py","reason":"new behavioral oracle: config-effect, drift, remap/collapse round-trip, fetcher known-set, label-helper single-source"},{"path":"src/rebar/_engine/rebar_reconciler/mapping_config.py","reason":"add declared_status_names(config) so the fetcher can union config-declared Jira status names"},{"path":"tests/unit/rebar_reconciler/test_backend_characterization.py","reason":"update the Cloud UPDATE characterization from coerce-to-To-Do to map-or-drift (unmapped status omitted)"},{"path":"tests/unit/rebar_reconciler/test_dc_backend_characterization.py","reason":"update the DC CREATE/UPDATE characterization to map-or-drift (unmapped status omitted)"},{"path":"tests/unit/rebar_reconciler/test_backend_neutrality.py","reason":"recording OutboundMapper test double accepts the new optional status_map kwarg"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py","reason":"injected OutboundMapper test double accepts the new optional status_map kwarg"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"widen preflight_status_mapping tolerated set to include config-declared Jira names (repo_root param) so a per-project remap is not false-flagged"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile.py","reason":"thread repo_root into the preflight_status_mapping call"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","bfe7-0900-c3d1-4141"],["parent","3d7a-7795-efde-4df7"]],"no_file_impact_reason":"","parent_id":"3d7a-7795-efde-4df7","parent_status_uuid":"7cda2937-e68a-4257-ab5f-636e187164af","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"438a-e1d9-29d3-4081","ticket_type":"story","title":"Config-driven status mapping (map-or-drift, collapse round-trip via rebar-status labels)","verify_commands":[]},"source_event_uuids":["744ba867-98b3-4426-853e-b7659b934ba9","deb24fa9-c638-44ba-ba93-aa0faaec9faa","6d3d3ffa-ddcd-4547-bbdb-e14a5d6d27a8","e9f456fe-bb92-4cab-b221-a97da1dc641e","350d3652-ae1e-47aa-9ec1-b954e6721838","d1997b3c-3a7d-43b6-81e7-d767e64fcf98","f5d0dfe5-ada8-4c9f-82b2-695edcd1e9ec","531a89ee-259f-4d89-872c-b11f1e686426","fd755c28-277d-4cf3-9436-e300abbd4b51","4c123aad-1d33-471b-a979-b87805bc0182","5d74212c-4960-4d95-9fdc-c28bbc738000","3222ff0a-a36f-4a9f-aebd-ee5c14614915","7cda2937-e68a-4257-ab5f-636e187164af","feb538e7-027f-453a-8492-0af56aca0f7d","0befb2b9-ab83-4c7e-b97d-76e99afedd08","f04a7061-af53-4e52-ac77-79369dff352a","83e8faeb-e513-458b-9e0b-733e3bdebd97"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787339644527340002,"uuid":"92929ca8-019d-47ed-b608-e9c8561b50e4"}