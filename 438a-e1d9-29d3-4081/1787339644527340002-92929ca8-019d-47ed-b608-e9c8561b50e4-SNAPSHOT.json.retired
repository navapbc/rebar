{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787339644527340002,"compiled_state":{"alias":"weeping-vaccinated-arrowworm","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"82190ec79b2b4ff2450c306834db7b5bd00f806d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 438a-e1d9-29d3-4081","material: 18203433b206d798","material-part: children 647ea2107ca5072f 0","material-part: description e6cd440a69576f15 7776","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact eba62257726c18f8 16","material-part: ticket_id 418384f475de6cc4 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.12.0 (82190ec79b)","regver: 362a5dd2d2052826","verified-at-sha:1ab859777a95b6d5573bb96aff863a73e97d6098","plan-material-pin: prerequisite bfe7-0900-c3d1-4141 2814cef81e53ef63","dep d3aef131b359c07f9f2bb67627672a2257d064e1005eb5fffc8653df87755fcf src/rebar/_engine/rebar_reconciler/_backend.py","dep 7215f84765995e7a249d3443efa69f48987436a3facc6c131a452a3e4c43da8b src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","dep 401215342e529c7e2a385c4e3721f54bb09291d358b29e6e3dd0105a33a08be4 src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","dep 2c9f317d9df65a9e7d7a38069075179f8598950044246ccc01beac86542db8d4 src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","dep a140314005f1066174869f7305fe6398e4f1356ac0d65b762642b224e10153f7 src/rebar/_engine/rebar_reconciler/adapters/jira_family/outbound_mapper.py","dep 34b5da41d4ad876c10e7936ced233fe81b97a38ca445a4ad1075f7d4910a6b27 src/rebar/_engine/rebar_reconciler/applier.py","dep b72b441ab16761de8171aa116c7421780b11ef9734b0ccef4f4dec85b4eed3e9 src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","dep e98d05a9aa2fc35149fa6e60b985883b4a00382ffad48076f54c9d96f3177b86 src/rebar/_engine/rebar_reconciler/config.py","dep cf49e5eb9ec26af3b0d8e6a42c208c52a6a3a15faaf7ebc97f889f7db932ff32 src/rebar/_engine/rebar_reconciler/fetcher.py","dep 35552c0afd830d39abfa05e9eeec9f15e7a4c2ef9769f48f9775fad9b208adc9 src/rebar/_engine/rebar_reconciler/inbound_differ.py","dep 5535ae1387b6f236ecb76e9defd3198d175c477d10e02dedb4185a72b2780760 src/rebar/_engine/rebar_reconciler/inbound_fields.py","dep baf9a57c561f3ba5373f98c81569b4686664cc4c3c8fea563ae736bb3934212f src/rebar/_engine/rebar_reconciler/inbound_translate.py","dep 43d770e7f7e4b40b8fc1aac56eec1a628844736b387d01b4a4f8d18b1801dce4 src/rebar/_engine/rebar_reconciler/outbound_differ.py","dep c1217c36306b8fb38e94e81870a3401d4b09dc51891ed93efa2406b42cd5d23d src/rebar/_engine/rebar_reconciler/outbound_field_diff.py","dep 63ff8f55a5a8e50cb1bcfaae655b9bf6a0e5c7527fc4c88caed16fa800e99658 src/rebar/_engine/rebar_reconciler/outbound_labels.py","dep absent tests/unit/rebar_reconciler/test_status_mapping.py","read-set: 19","read-path: AGENTS.md","read-path: docs/adr/0029-reconciler-bidirectional-status-and-echo.md","read-path: docs/plan-review-criteria-guide.md","read-path: src/rebar/_engine/rebar_reconciler/_backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/outbound_fields.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/outbound_mapper.py","read-path: src/rebar/_engine/rebar_reconciler/applier.py","read-path: src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","read-path: src/rebar/_engine/rebar_reconciler/config.py","read-path: src/rebar/_engine/rebar_reconciler/fetcher.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_differ.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_fields.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_translate.py","read-path: src/rebar/_engine/rebar_reconciler/mapping_config.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_differ.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_field_diff.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_labels.py","read-path: tests/unit/rebar_reconciler/test_mapping_config.py","currency-basis: file_impact"],"material_fingerprint":"18203433b206d798","merged_log_commit":"1ab859777a95b6d5573bb96aff863a73e97d6098","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787336368479210000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":20,"unsigned":0},"authorship_ledger":[{"content_hash":"1ecbe1a61afa6270718f78a9908cc27d3db8314cd2d03c92509b65a0188b6fbf","event_uuid":"744ba867-98b3-4426-853e-b7659b934ba9","position":{"commit_sha":"f1e822c187578f89227cfa47726aab71595933ff","position":"1787332090322268001-744ba867-98b3-4426-853e-b7659b934ba9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"dd9c570d4722c859e1dde5b8e317c0be667679e9e17c4209bdcd1e155704dc42","event_uuid":"deb24fa9-c638-44ba-ba93-aa0faaec9faa","position":{"commit_sha":"d638c65e0e2944916f3383f4882776355d0ca03a","position":"1787332094753555001-deb24fa9-c638-44ba-ba93-aa0faaec9faa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"80ee0e957331f3dac0ab895cf6003135e59f2f3d47639d56718f99c69353f321","event_uuid":"6d3d3ffa-ddcd-4547-bbdb-e14a5d