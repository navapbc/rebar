-phase: planning","rebar-version: 0.12.0 (44189b0f1f-dirty)","regver: aa61189569d34126","verified-at-sha:dc2f8098962b7ccfeea43269556a48af2140c319","dep 428dafdd4952433f64fd722c3ad01139cecece045220fc30eb6ed83c6488059d src/rebar/_engine/rebar_reconciler/binding_walk.py","dep 636c2c9950a1e48e4107bfa56fbef50ed272c8c7a424a29cd85f08c57350fa30 tests/unit/rebar_reconciler/apply/test_apply_inbound_adopt.py","dep 6754b7e50748fbf0e0cec1bcfc996d4be73c6d54173c9bfa50807bf9d923b1f3 tests/unit/rebar_reconciler/orchestrate/test_reconcile_once.py","dep aba8d37bb08522d8a5cff52228e025b26e4549513bea363e725dbb34639ff463 tests/unit/rebar_reconciler/test_binding_walk.py","read-set: 10","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/deployment.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/identity.py","read-path: src/rebar/_engine/rebar_reconciler/apply_inbound.py","read-path: src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","read-path: src/rebar/_engine/rebar_reconciler/binding_store.py","read-path: src/rebar/_engine/rebar_reconciler/binding_walk.py","read-path: src/rebar/_engine/rebar_reconciler/differ.py","read-path: src/rebar/_engine/rebar_reconciler/inbound_translate.py","read-path: src/rebar/_engine/rebar_reconciler/run_differs.py","read-path: src/rebar/_engine_support/bridge_fsck.py","currency-basis: file_impact"],"material_fingerprint":"ff802aa638cd6142","merged_log_commit":"dc2f8098962b7ccfeea43269556a48af2140c319","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787464683738130000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":0},"authorship_ledger":[{"content_hash":"e679f91b1ba72277a9e1a950a58c1ce8eb73f1620d2ba5841b355a64b4a29943","event_uuid":"fdb74432-7ca7-4f59-a6b2-bd3fc15ee565","position":{"commit_sha":"112d531f39b599329128dfac318c6b1174788129","position":"1787454480791789001-fdb74432-7ca7-4f59-