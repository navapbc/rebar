happy path and the existing recovery-failure paths are unchanged\n      (existing suite green).","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/workflow/completion_recovery.py","reason":"move _recover prelude show_ticket inside the diagnostic-capturing try; widen catch so a RebarError prelude failure preserves the primary diagnostic and sidecar"},{"path":"tests/unit/workflow/test_completion_recovery_prelude_215f.py","reason":"held-out oracle: prelude RebarError must not discard primary evidence"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","9b71-55b3-1bd1-4a97"],["relates_to","48c9-c109-c5b5-4697"]],"no_file_impact_reason":"","parent_id":"9b71-55b3-1bd1-4a97","parent_status_uuid":"819e8a0c-08fd-460e-afd5-2ded9ec6453f","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"215f-92ab-9780-443d","ticket_type":"bug","title":"completion recovery prelude failure drops primary diagnostic","verify_commands":[]},"source_event_uuids":["3616b36f-91a0-42f1-a85d-06d8c1848ff0","4d6d6d47-5fec-49f8-84b1-d2bbc80f0c6c","cfada126-4612-419f-8b5d-1303d3863ddc","38fd8c60-f5a3-4fc6-8906-f31b3146422a","819e8a0c-08fd-460e-afd5-2ded9ec6453f","ac25680d-9036-4367-91b0-424ed86cd2ae","dd162ed7-18b1-4d59-ae08-f4715f23246f","13b16bf5-3461-48a9-93e0-962156c70a5e","815e02d1-c666-4494-9b2e-ca65efbabcc1"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785982777497157002,"uuid":"d66d2c0b-4ac2-472b-9f60-11ce1e49fac9"}