9-d2f90da16024","position":{"commit_sha":"598527b6a2de80ff2096ff8b63782bed74b45943","position":"1784739594918890001-2e458452-d5fb-407b-8a69-d2f90da16024"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7c2a458424b8296ff64ad33584676ebfcf14bcdb0de6b303ebf45f4b734d5842","event_uuid":"d1129ef2-ae69-4c48-9f32-2cb3b1a1ebe7","position":{"commit_sha":"598527b6a2de80ff2096ff8b63782bed74b45943","position":"1784739595210258001-d1129ef2-ae69-4c48-9f32-2cb3b1a1ebe7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"69e48e8e035baa78a6ea816a284fe8afa39d2041c6be993fa2a50acd121f61bc","event_uuid":"07fec354-cfb5-41f9-b945-63c138083562","position":{"commit_sha":"39f39265750cf55bcc06a2b16bc231f85eefcfbc","position":"1784739928881584863-07fec354-cfb5-41f9-b945-63c138083562"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-217_agent","claim_remote_session":null,"claimed_session":"558cb323-38be-4b58-af2c-56610b23b144","comments":[],"created_at":1784738803128466001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n`rebar review-code` runs the same four-pass reviewer the Gerrit bot casts `LLM-Review`\nwith, so an author can preview code-review findings locally before pushing — the exact\nanalog of `rebar review-plan` for the plan gate. But the code-review on-ramp never\nmentions it: the plan-review author can discover their local self-check, the code-review\nauthor cannot. This closes that discoverability asymmetry so both gates read symmetrically.\n\n## Approach\nSurface `rebar review-code` in the same three places plan review's local self-check is\nsurfaced: the author on-ramp (`docs/passing-code-review.md`, printed by `rebar explain\nreview`), the docs index (`docs/README.md`), and the canonical `AGENTS.md` pointer.\nRejected: adding a new `rebar explain` topic for local code review — the existing `review`\nguide is the right home, and a second topic would fragment the on-ramp rather than fix\ndiscoverability.\n\n## Scope\n- docs/passing-code-review.md  (new \"Preview the review locally\" section, intro cross-link, loop-diagram preview step)\n- docs/README.md               (index entry mentions the local preview)\n- AGENTS.md                    (code-review pointer names `rebar review-code`)\n\n## Acceptance Criteria\n- [ ] `docs/passing-code-review.md` has a \"Preview the review locally\" section teaching\n      `rebar review-code`, incl. the `[agents]` extra and `REBAR_VERIFY_ENABLE_CODE_REVIEW`\n      enabling requirement; verified by\n      `grep -q 'REBAR_VERIFY_ENABLE_CODE_REVIEW' docs/passing-code-review.md && grep -q '## Preview the review locally' docs/passing-code-review.md`.\n- [ ] The loop diagram in `docs/passing-code-review.md` shows the optional local\n      `rebar review-code` preview step; verified by\n      `grep -q 'rebar review-code — optional local preview' docs/passing-code-review.md`.\n- [ ] The `docs/README.md` passing-code-review index entry names `rebar review-code`;\n      verified by `grep -A2 'passing-code-review.md)\\*\\*' docs/README.md | grep -q 'rebar review-code'`.\n- [ ] `AGENTS.md` code-review pointer names `rebar review-code`; verified by\n      `grep -q 'preview the review locally with .rebar review-code' AGENTS.md`.\n- [ ] The intro anchor link resolves to the new section heading (GitHub-generated anchor\n      `#preview-the-review-locally-before-you-push` matches the heading text); verified by\n      `grep -q '#preview-the-review-locally-before-you-push' docs/passing-code-review.md`.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"docs/passing-code-review.md","reason":"new local-preview section, intro cross-link, loop diagram"},{"path":"docs/README.md","reason":"index entry names rebar review-code"},{"path":"AGENTS.md","reason":"code-review pointer names rebar review-code"}],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"parent_id":null,"parent_status_uuid":"2e458452-d5fb-407b-8a69-d2f90da16024","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"86a5-9221-0037-4e38","ticket_type":"task","title":"Make local code review as discoverable as plan review","verify_commands":[]},"source_event_uuids":["9d84bb03-886a-4219-96a4-e8b4c88cc063","08c3aa32-c422-4f3b-adcd-5b2cb30f7b96","189a8780-b0de-4629-bde7-621125d8a9fb","f86aec1c-1d8a-4b75-98a9-d9aad9010efb","2e458452-d5fb-407b-8a69-d2f90da16024","d1129ef2-ae69-4c48-9f32-2cb3b1a1ebe7","07fec354-cfb5-41f9-b945-63c138083562"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1784739928881584864,"uuid":"080493a8-5a70-4660-ad66-a0a9e39e5601"}