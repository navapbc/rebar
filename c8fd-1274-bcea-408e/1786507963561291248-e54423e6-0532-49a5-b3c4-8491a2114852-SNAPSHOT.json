{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786507963561291248,"compiled_state":{"alias":"syllabic-spiteful-urutu","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"f7e684c3004c987ad5688ea28b815bd4babef08d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: c8fd-1274-bcea-408e","material: f5dcfe12195da320","material-part: children 647ea2107ca5072f 0","material-part: description 36389a9feb43dd1d 6413","material-part: file_impact fc110cf8d3f84489 2","material-part: ticket_id 08a6629ec3135a0a 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (f7e684c300-dirty)","regver: 4f90349cd81c4911","verified-at-sha:513a51347dc4f2a5d119cd5d0903140e6e714227","dep f895533b36c315d9da0e778acf049bb02886ba6b398beb6303fce6aba25c5d35 src/rebar/_commands/close_precheck.py","dep absent tests/unit/test_close_precheck_duplicate_link_c8fd.py"],"material_fingerprint":"f5dcfe12195da320","merged_log_commit":"513a51347dc4f2a5d119cd5d0903140e6e714227","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786504454584970000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":0},"authorship_ledger":[{"content_hash":"39e807255f68377202967c4a5ad18ffe09a71fca3371975db9f45bb55ba4c0df","event_uuid":"cfda46b7-387d-4111-8134-2c55b109ba71","position":{"commit_sha":"025a91b29e92fa1b4a62bd4fbb0d4b114d0d619d","position":"1786380964181942001-cfda46b7-387d-4111-8134-2c5