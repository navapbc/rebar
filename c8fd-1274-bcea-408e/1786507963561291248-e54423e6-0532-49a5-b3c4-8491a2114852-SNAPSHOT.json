AAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"de1069a6571aab07347036e5b8e726be54757e2e23790ab79d3cf6662b75677c","event_uuid":"f32d8e94-2302-41fb-8244-ebfe3acbbbf9","position":{"commit_sha":"6988d9f9d3965c89bd4637de879638444d158761","position":"1786505354939579974-f32d8e94-2302-41fb-8244-ebfe3acbbbf9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"059de6345c0b48131dbef255d48c1439170469c7bf2e624bdb9a2092f40b3b33","event_uuid":"cdd790c0-ec38-4ac7-9953-f9f26ecc0b41","position":{"commit_sha":"b6220a1909499817056bed042ab3bc7e6bbe26a4","position":"1786505474407926001-cdd790c0-ec38-4ac7-9953-f9f26ecc0b41"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a54b8ad51e8278ffcf9054024da9e7130bab13c862324a98d93427720812f08b","event_uuid":"d0f62991-f5b7-4ac7-9fc6-66c66792d4a6","position":{"commit_sha":"4bc41fd89ee35b3ac0a01f62d184d5ac156c2866","position":"1786507963561291247-d0f62991-f5b7-4ac7-9fc6-66c66792d4a6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OPERATOR DECISION 2026-08-12: APPROVED to hard-fail a --class duplicate close that has no live replacement/duplicates link, with a clear message naming the missing link. Behavior change authorized.","timestamp":1786502581251368001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OPERATOR CONFIRMED 2026-08-12 refinement: the gate requires the replacement/duplicates LINK to exist — it must NOT require the link target to be open (closing a duplicate of an already-closed canonical is the common case).","timestamp":1786503654438505001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented on change 1618 (https://rebar.solutions.navateam.com/c/rebar/+/1618). close_precheck now hard-fails a --class duplicate close with no usable replacement link, naming the exact 'rebar link <id> <canonical> duplicates' command, and distinguishes a dead/archived named target from having named none. Scoped to 'duplicate' alone per the operator decision; not_a_bug and escalated keep the prior fallthrough since neither owes a duplicates link. Link EXISTENCE only is required — a regression test pins that a CLOSED canonical still takes the disposition path. New decision points live in a guard function because _completion_precheck sits at its ceiling in the shrink-only complexity baseline. 10 new unit tests; verified RED (3 fail without the fix). Gates: make lint PASS, make typecheck PASS, tests/unit -k close 236 passed, tests/interfaces -k 'close or transition' 160 passed. LLM-Review +1 (PASS, 2 advisory).","timestamp":1786505474407926001}],"created_at":1786380964181942001,"creation_channel":"cli","deps":[{"link_uuid":"6a077a62-b935-47af-9aab-c0afe3bbce05","relation":"discovered_from","target_id":"9b70-3108-706a-4483"},{"link_uuid":"f32d8e94-2302-41fb-8244-ebfe3acbbbf9","relation":"relates_to","target_id":"0169-bd68-e492-4b36"},{"link_uuid":"d0f62991-f5b7-4ac7-9fc6-66c66792d4a6","relation":"relates_to","target_id":"f9da-dc08-64e1-4059"}],"description":"# The close gate never names the one remedy that works for a duplicate close\n\n## Context / Problem\n\n`close_precheck` exempts a bug closed as `duplicate` / `not_a_bug` / `escalated` from the\nbillable completion verifier when it names a live replacement:\n`src/rebar/_commands/close_precheck.py:232` calls `_has_live_replacement_link`\n(`:49-91`), and on True routes to `close_disposition.verdict()` (`:236-238`).\n\nWhen that predicate returns **False** the branch simply falls through to the ordinary\ncompletion path (`:241` onwards) and the LLM verifier synthesizes \"Bug <title> is actually\nresolved\", which correctly FAILS — a duplicate's defect is not resolved by the duplicate.\nBut the remediation text then offers only two impossible paths: complete the unfinished\nwork (it belongs to the canonical ticket), or mark the criterion `[operator-attested]`\n(a false attestation). The single action that works — recording the `duplicates` link — is\nnever mentioned. Observed on bug 9b70: repeated close failures, nearly escalated for a gate\nchange or a `--force`; the actual fix was `rebar link 9b70 6a81 duplicates`.\n\n## Approach\n\nAdd a deterministic, pre-LLM hard fail at the existing fallthrough. When the ticket is a\n`bug` and `close_class == \"duplicate\"` and `_has_live_replacement_link` returned False,\nraise `CommandError` naming the missing link and the exact `rebar link <id> <canonical>\nduplicates` command, instead of falling through.\n\nThree decisions, each taken deliberately:\n\n1. **Scope the hard fail to `duplicate` only**, not all of\n   `_NON_COMPLETION_BUG_CLASSES` (`close_precheck.py:26`). This follows the operator\n   decision recorded on this ticket (\"APPROVED to hard-fail a `--class duplicate` close\").\n   It is also the only class with a canonical counterpart: `not_a_bug` asserts there is no\n   defect and `escalated` may point outside the tracker, so demanding a `duplicates` link\n   from either would be wrong. Those two keep today's fallthrough behaviour exactly.\n2. **Require the link's EXISTENCE, not an open target** — the operator's confirmed\n   refinement, since closing a duplicate of an already-closed canonical is the common case.\n   No code change is needed to honour this: `_is_live_ticket` (`close_precheck.py:29-46`)\n   already accepts any resolvable, non-archived, non-deleted ticket and only rejects\n   `status in {\"archived\",\"deleted\"}` — a `closed` canonical already passes. A regression\n   test pins that so a future tightening of `_is_live_ticket` cannot silently reintroduce\n   an open-target requirement.\n3. **Distinguish a dead target from a missing one.** A new helper reads the same reduced\n   state and reports whether a `duplicates` dep (or inbound `supersedes` link) was recorded\n   at all. Named-but-unresolvable gets \"the ticket you named is archived/deleted/unknown —\n   re-link to a live canonical\"; nothing recorded gets \"you named none — run `rebar link\n   …`\". This is pure reduced-state reading, so it costs no LLM request.\n\nThe new helper is added rather than folded into `_has_live_replacement_link` because two\nexisting tests monkeypatch that predicate by name\n(`tests/unit/test_close_disposition_attestation_738a.py:66,101`); keeping its bool\nsignature intact keeps the disposition attestation (bug 738a) wiring tests meaningful.\n\nThe check sits after the `force_close` early return (`:211`) and after the\n`bug_close_class_ok` guard (`:218`), so `--force` still bypasses it and an invalid\n`--class` still reports its own error first.\n\n## Scope\n\n- `src/rebar/_commands/close_precheck.py` — new `_recorded_replacement_target()` helper and\n  the hard-fail branch at the `_has_live_replacement_link` fallthrough. File is 394 LOC;\n  the change keeps it well under the 800-LOC cap.\n- `tests/unit/test_close_precheck_duplicate_link_c8fd.py` — new unit test module for the\n  four cases below.\n\n## Testing\n\n- Happy path: `--class duplicate` on a bug whose `duplicates` link targets an **open**\n  ticket still routes to the disposition verdict (no error, no LLM call).\n- Operator-confirmed path: same, but the target is **closed** — must also proceed, proving\n  the gate requires link existence and not target openness.\n- Failure path: `--class duplicate` with **no** link raises `CommandError` whose message\n  contains the literal `duplicates` link command and the ticket id, and the completion\n  verifier (`rebar.llm.verify_completion`) is **never** called.\n- Edge path: `--class duplicate` naming an **archived/unresolvable** target produces the\n  distinct dead-target message, not the \"you named none\" one.\n- Unaffected path: `--class not_a_bug`, `--class escalated`, and a non-disposition class\n  such as `plan_defect` with no link all fall through to the completion path unchanged.\n\n## Acceptance Criteria\n\n- [ ] `_completion_precheck` raises `CommandError` (returncode 1) for a `bug` closed\n      `--class duplicate` with no recorded replacement link, and the message contains\n      `rebar link`, the word `duplicates`, and the ticket id.\n      Verify: `python -m pytest tests/unit/test_close_precheck_duplicate_link_c8fd.py -q`\n- [ ] The hard fail runs BEFORE any billable LLM call: the test asserts a monkeypatched\n      `llm.verify_completion` recorded zero calls on that path.\n      Verify: `python -m pytest tests/unit/test_close_precheck_duplicate_link_c8fd.py -q -k llm`\n- [ ] A `duplicates` link whose target is **closed** still takes the disposition path (link\n      existence only; target need not be open).\n      Verify: `python -m pytest tests/unit/test_close_precheck_duplicate_link_c8fd.py -q -k closed`\n- [ ] A `duplicates` link naming an archived/unresolvable target yields a message that\n      names the dead target and differs from the no-link message.\n      Verify: `python -m pytest tests/unit/test_close_precheck_duplicate_link_c8fd.py -q -k dead`\n- [ ] `not_a_bug`, `escalated`, and non-disposition classes are unchanged — no new error on\n      the no-link path.\n      Verify: `python -m pytest tests/unit/test_close_precheck_duplicate_link_c8fd.py -q -k unaffected`\n- [ ] The existing disposition-attestation suite still passes unchanged.\n      Verify: `python -m pytest tests/unit/test_close_disposition_attestation_738a.py -q`\n- [ ] Repository gates pass.\n      Verify: `make lint && make typecheck && python -m pytest tests/unit -q -k close`\n\n## Provenance\n\nFound closing 9b70 (itself a duplicate of 6a81). Cross-referenced there.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/close_precheck.py","reason":"hard-fail a duplicate close with no replacement link and add the recorded-target helper"},{"path":"tests/unit/test_close_precheck_duplicate_link_c8fd.py","reason":"new unit tests for the no-link, closed-target, dead-target and unaffected-class cases"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","0169-bd68-e492-4b36"],["relates_to","f9da-dc08-64e1-4059"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5fd3d452-b788-408a-b49b-779f63cbc7e3","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"c8fd-1274-bcea-408e","ticket_type":"bug","title":"Close gate does not tell a duplicate close it needs a replacement link","verify_commands":[]},"source_event_uuids":["cfda46b7-387d-4111-8134-2c55b109ba71","6a077a62-b935-47af-9aab-c0afe3bbce05","4a996f59-8f75-4bd6-a698-48dbc27e8836","589fa886-cbe5-4569-9f12-ef619e8edec5","1805dfcb-bb17-4abf-8044-a848a37145a4","160093c6-c1b4-4e06-b484-8789f8e6f39b","c3adbcfc-baab-496a-89a9-24c22313d0d8