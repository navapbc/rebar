{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787376261692816002,"compiled_state":{"alias":"vinyl-cheesy-termite","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"3406014085761087786aa7b4788c17fc0ac7f494","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4329-4761-6e3d-41d7","material: cae4c99749ade537","material-part: children 647ea2107ca5072f 0","material-part: description 4a154cf1759ee25d 4392","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact a2996ec462947084 5","material-part: ticket_id 72ac269bf9a0e82d 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (3406014085)","regver: aa61189569d34126","verified-at-sha:55e308eaaf3623e8acca564857641f7486773667","dep 96cc27a4009796b40ed73982f413064f1ef99a02eebcad6642249623c1df65d3 src/rebar/_commands/_seam.py","dep 9621067ba59002001b6458b798a4d0a48f3ed177fb5f7a86fba349803bdafe36 src/rebar/_commands/claim.py","dep absent src/rebar/_commands/lifecycle_cascade.py","dep cb974551bba0bc2d680c96b854a23d353988621965955a55c0a87261a89ccea4 src/rebar/_commands/transition.py","dep absent tests/unit/commands/test_lifecycle_cascade.py","read-set: 5","read-path: src/rebar/_commands/_seam.py","read-path: src/rebar/_commands/claim.py","read-path: src/rebar/_commands/transition.py","read-path: src/rebar/_commands/transition_close.py","read-path: src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","currency-basis: file_impact"],"material_fingerprint":"cae4c99749ade537