{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nBASES=json.loads(\"{}\")\nALLOWED=json.loads(\"{\\\"tests/unit/test_snapshot_gc_trigger.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_snapshot_janitor.py\\\":{\\\"docs\\\":[\\\"_real_store_bytes\\\",\\\"test_evicting_a_shared_entry_keeps_the_byte_total_honest\\\",\\\"test_populating_shared_entries_tracks_real_disk_without_a_sweep\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_GIB = 1024**3\\\"],[\\\"<module>\\\",\\\"def test_max_bytes_cap_evicts_when_over_budget(store, repo):\\\"],[\\\"<module>\\\",\\\"def test_entry_count_cap_reclaims_under_every_byte_denominated_threshold(store):\\\"]]},\\\"tests/unit/test_snapshot_present_sha_no_fetch.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"clone_with_present_sha\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_snapshot_targeted_fetch.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"clone_with_large_unrelated_branch\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_spawn_detached.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_step_failures.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_batch_write.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_commit_maintenance_bd66.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_copy_needs_env_id.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_sync_reconverge.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_TRACKED_DIR = \\\\\\\"cccc-trkd-3333-3333\\\\\\\"\\\"]]},\\\"tests/unit/test_store_write_git_timeout_c2ba.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_write_index_reset_on_failure.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_store_write_unmerged_recovery.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_write_self_heals_unmerged_path_foreign_to_the_branch\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_structured_matrix_scorer.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_structured_run_seam.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_structured_run.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_OPEN = \\\\\\\"<<<REBAR_OUTPUT>>>\\\\\\\"\\\"]]},\\\"tests/unit/test_structured.py\\\":{\\\"docs\\\":[],\\\"comments\\\":[[\\\"test_validate_to_unwraps_single_element_array\\\",\\\"obj = structured.validate_to(_Verdict, [{\\\\\\\"verdict\\\\\\\": \\\\\\\"PASS\\\\\\\", \\\\\\\"confidence\\\\\\\": 0.9}])\\\"],[\\\"test_validate_to_recovers_sole_dict_among_non_dict_noise\\\",\\\"obj = structured.validate_to(\\\"],[\\\"test_tolerant_parse_skips_nonjson_brace_before_object\\\",\\\"text = (\\\"],[\\\"test_completion_verdict_recovered_when_prose_holds_github_actions_expr\\\",\\\"from rebar.llm.contracts import completion_verdict_response_model\\\"],[\\\"<module>\\\",\\\"_CORPUS_DIR = _Path(__file__).parent.parent / \\\\\\\"fixtures\\\\\\\" / \\\\\\\"structured_reply_corpus\\\\\\\"\\\"],[\\\"test_selection_recovers_verdict_over_quoted_dep_record\\\",\\\"from rebar.llm.contracts import completion_verdict_response_model\\\"],[\\\"test_selection_recovers_verdict_all_corpus_variants\\\",\\\"from rebar.llm.contracts import completion_verdict_response_model\\\"],[\\\"test_selection_last_valid_wins_and_warns_when_two_validate\\\",\\\"import logging\\\"],[\\\"<module>\\\",\\\"_OPEN = \\\\\\\"<<<REBAR_OUTPUT>>>\\\\\\\"\\\"],[\\\"<module>\\\",\\\"def test_last_block_invalid_earlier_block_valid_returns_earlier_valid():\\\"]]},\\\"tests/unit/test_subcall_class_selection.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"class_table\\\",\\\"_Recorder\\\",\\\"test_ticket_digest_selects_the_trivial_class\\\",\\\"test_ticket_digest_holds_on_the_store_write_path\\\",\\\"test_review_ticket_uses_the_operators_configured_model\\\",\\\"_parsed\\\",\\\"_combine\\\",\\\"_verdict\\\",\\\"_is_run_request_construction\\\",\\\"run_request_sites\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_CFG_MODEL = \\\\\\\"anthropic:cfg-model-must-not-be-inherited\\\\\\\"\\\"],[\\\"test_overlap_judge_selects_the_standard_class_for_every_pair\\\",\\\"ids = [f\\\\\\\"C{i}\\\\\\\" for i in range(_CANDIDATES_PER_CALL + 1)]\\\"],[\\\"test_review_ticket_uses_the_operators_configured_model\\\",\\\"operations._review_ticket_impl(\\\"],[\\\"<module>\\\",\\\"_MODEL_TRANSPARENT = (\\\\\\\"max_output_cfg\\\\\\\", \\\\\\\"_max_output_cfg\\\\\\\")\\\"],[\\\"<module>\\\",\\\"_CFG_MODEL_BY_DESIGN: dict[str, str] = {}\\\"],[\\\"<module>\\\",\\\"_UNFOLLOWABLE: dict[str, str] = {\\\"]]}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef normalize(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True)\n    seen=set()\n    allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]\n                seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path):\n    tree=ast.parse(raw,type_comments=True)\n    lines=raw.splitlines()\n    scopes=[(\"<module>\",1,len(lines))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    full={}\n    inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]\n    i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1\n            continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((scope for scope in scopes if scope[1]<=comments[0][0]<=scope[2]),key=lambda scope:scope[2]-scope[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(value for _,value in comments)))\n    rules=ALLOWED[path][\"comments\"]\n    for scope,prefix in rules:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in regions)>1:\n            raise SystemExit(\"ambiguous comment stable id: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    protected=[region for region in regions if not any(region[0]==scope and region[1].startswith(prefix) for scope,prefix in rules)]\n    return inline,protected,regions\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    before=source(base,path)\n    after=source(\"HEAD\",path)\n    if normalize(before,path,True)!=normalize(after,path,False):\n        raise SystemExit(\"normalized AST changed: \"+path)\n    before_inline,before_protected,before_regions=comment_state(before,path)\n    after_inline,after_protected,after_regions=comment_state(after,path)\n    for scope,prefix in ALLOWED[path][\"comments\"]:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in before_regions)!=1:\n            raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    if before_inline!=after_inline:\n        raise SystemExit(\"inline comment changed: \"+path)\n    if before_protected!=after_protected:\n        raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)' tests/unit/test_snapshot_gc_trigger.py tests/unit/test_snapshot_janitor.py tests/unit/test_snapshot_present_sha_no_fetch.py tests/unit/test_snapshot_targeted_fetch.py tests/unit/test_spawn_detached.py tests/unit/test_step_failures.py tests/unit/test_store_batch_write.py tests/unit/test_store_commit_maintenance_bd66.py tests/unit/test_store_copy_needs_env_id.py tests/unit/test_store_sync_reconverge.py tests/unit/test_store_write_git_timeout_c2ba.py tests/unit/test_store_write_index_reset_on_failure.py tests/unit/test_store_write_unmerged_recovery.py tests/unit/test_structured_matrix_scorer.py tests/unit/test_structured_run_seam.py tests/unit/test_structured_run.py tests/unit/test_structured.py tests/unit/test_subcall_class_selection.py","dd_id":"semantic","dd_text":"Immutable/final Python parses; only allowlisted leading docstrings and full-line comment regions may differ; normalized runtime ASTs match."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, json, re, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nBASES=json.loads(\"{}\")\nPATTERN=re.compile(r\"#\\s*(?:!|(?:-\\*-\\s*)?coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string):\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            anchor=(\"inline\",left.strip())\n        else:\n            anchor=(\"next\",\"<EOF>\")\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    anchor=(\"next\",stripped)\n                    break\n        found.append((tok.string,anchor))\n    return found\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    if signatures(source(base,path))!=signatures(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \"+path)' tests/unit/test_snapshot_gc_trigger.py tests/unit/test_snapshot_janitor.py tests/unit/test_snapshot_present_sha_no_fetch.py tests/unit/test_snapshot_targeted_fetch.py tests/unit/test_spawn_detached.py tests/unit/test_step_failures.py tests/unit/test_store_batch_write.py tests