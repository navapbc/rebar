9","priority":0.6375,"reason":"default-advisory","recalled":false,"scenarios":["Author retains three no-consumer adapters, inflating the retained surface the ticket's own AC4 measures as net line delta","A reader trusts the false claim that pinning tests bind those three names and preserves them unnecessarily"],"severity":"critical","suggested_fix":"State that sync.py keeps only `_quarantine_untracked` and `_restore_local_changes` as delegating adapters (doctor.py binds the former; sync._recover_merge_abort resolves both at module scope), and that the parser/path functions are called directly on `merge_recovery` with no sync-local adapter.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Inline (or restate in the plan) the uniqueness-guard construction — how it counts movers/parsers and how each of the three mutation cases (unmarked copy / reasoned marker / bare marker) is exercised — so AC1's proving mechanism is reviewable in the plan itself.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5e"],"criter