{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^\\([[:space:]]*#[^!].*\\|[[:space:]]*#[[:space:]]*\\|[[:space:]]*\\)$\" HEAD^ HEAD -- .github/codeql/codeql-config.yml .github/dependabot.yml","dd_id":"preserve-github-yaml","dd_text":"Prove the YAML files change only standalone comments or blank lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import re, subprocess\np = \".github/pull_request_template.md\"\nread = lambda rev: subprocess.check_output([\"rtk\", \"proxy\", \"git\", \"show\", f\"{rev}:{p}\"], text=True)\nvisible = lambda rev: [line for line in re.sub(r\"\\A\\s*<!--.*?-->\\s*\", \"\", read(rev), count=1, flags=re.S).splitlines() if line.strip()]\nassert visible(\"HEAD^\") == visible(\"HEAD\")'","dd_id":"preserve-visible-template","dd_text":"Permit only the leading hidden HTML block to change; preserve all visible template lines exactly."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_docs_index.py --check","dd_id":"documentation-index","dd_text":"Validate maintained-source coverage and relative links after the hidden block edit."},{"command":"rtk git diff --check HEAD^ HEAD -- .github/codeql/codeql-config.yml .github/dependabot.yml .github/pull_request_template.md","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"Run repository lint and policy gates."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788609503972585001,"uuid":"23ac774a-f197-42e2-8b53-dd6d038a71e9"}