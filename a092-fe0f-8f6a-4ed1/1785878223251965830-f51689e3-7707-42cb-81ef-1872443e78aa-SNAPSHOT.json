96afda1","position":{"commit_sha":"91e678d76ba119cf70d8d0ca89d60d3926b43b99","position":"1785878044011153001-29c72fa3-e6f3-4630-8bda-298ff96afda1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4e0b8e803c86032481133fd865f69e5393c113887ba050b49b7d7a68cf5f4775","event_uuid":"8b680706-f7df-41d9-b234-0d03da8c5975","position":{"commit_sha":"21cd2de947d98b97814865760e7bd1ae6961ee85","position":"1785878048056962001-8b680706-f7df-41d9-b234-0d03da8c5975"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Per operator direction, removing the pack-size gate rather than bumping the limit. Rationale: the ceiling has repeatedly blocked the workflow since it landed and the append-only tickets pack can only grow, so any fixed cap keeps re-tripping and blocks all Gerrit changes repo-wide. Pushed as Gerrit change 1392.","timestamp":1785878048056962001}],"created_at":1785877855072488001,"creation_channel":"python","deps":[{"link_uuid":"7f46a11d-5968-4cfc-90ad-0c8fed14620c","relation":"discovered_from","target_id":"ad85-e5e3-be8d-4be5"},{"link_uuid":"246be860-725b-4ef3-8d64-73735c90006d","relation":"relates_to","target_id":"4fb2-7bc9-4fc2-44b0"}],"description":"## Problem\nThe `verify-identity (whole-store authorship gate)` job in `.github/workflows/gerrit-verify.yaml` fetches the full `tickets` branch (`git fetch --filter=blob:none`) and fails closed if the resulting pack exceeds `REBAR_TICKETS_PACK_LIMIT_KIB` (131072 KiB = 128 MiB). As of 2026-08-04 the tickets pack measures **131830 KiB**, ~758 KiB (0.6%) over the limit, so the gate casts **Verified -1**.\n\nThis blocks EVERY Gerrit change (repo-wide), not any one change's code. First observed on change 1385 (ad85), whose own pytest/lint/typecheck jobs all pass.\n\n## Why history cannot be truncated\nThe gate deliberately mounts FULL tickets history for commit-ancestry era scoping (ADR 0051; the append-only event log is authorship-critical). So the pack only grows monotonically; compaction/truncation is not an option.\n\n## Decision (chosen approach)\nREMOVE the pack-size gate entirely (not bump the limit). Deliberate choice: the\n`REBAR_TICKETS_PACK_LIMIT_KIB` ceiling has repeatedly blocked the normal review workflow since\nthe feature was implemented, for reasons unrelated to the change under review, because the\ntickets branch is append-only full-history (ADR 0051) and its pack only ever grows — a fixed\nKiB ceiling is guaranteed to keep tripping and, once tripped, casts Verified -1 on EVERY Gerrit\nchange repo-wide. It cost far more than it protected. Change 1392 removes the env var + the\nfail-closed step and leaves an in-file NOTE recording the rationale. If tickets-pack growth\never needs bounding, use a real mechanism (server-side gc / history compaction).\n\n## Acceptance criteria\n- [ ] The `REBAR_TICKETS_PACK_LIMIT_KIB` env var and the \"Fail closed if the filtered tickets pack exceeds its limit\" step are removed from `.github/workflows/gerrit-verify.yaml`, with an in-file NOTE documenting the deliberate removal.\n- [ ] A Gerrit change passes the `verify-identity` whole-store gate (Verified +1) without the pack-size check.\n","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":".github/workflows/gerrit-verify.yaml","reason":"remove the tickets-pack-size fail-closed step and its REBAR_TICKETS_PACK_LIMIT_KIB env var from the verify-identity job"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","4fb2-7bc9-4fc2-44b0"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f693ecc0-240f-4c4f-a522-4291d2a8dbaa","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"a092-fe0f-8f6a-4ed1","ticket_type":"bug","title":"Gerrit Verified gate blocks all changes: tickets pack crossed CI size limit (131830 > 131072 KiB)","verify_commands":[]},"source_event_uuids":["fbe1cdd9-e06c-4300-acee-fc166e178d27","ccf49635-0159-46f6-9849-55032cc48253","7f46a11d-5968-4cfc-90ad-0c8fed14620c","f693ecc0-240f-4c4f-a522-4291d2a8dbaa","ca1a73a8-88a6-4245-ba59-508a825a58dc","b5ff6e6d-e267-43f5-b9a4-890c76a43701","29c72fa3-e6f3-4630-8bda-298ff96afda1","8b680706-f7df-41d9-b234-0d03da8c5975","246be860-725b-4ef3-8d64-73735c90006d"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785878223251965830,"uuid":"f51689e3-7707-42cb-81ef-1872443e78aa"}