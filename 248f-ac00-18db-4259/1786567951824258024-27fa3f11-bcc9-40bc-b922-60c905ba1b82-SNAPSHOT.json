{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786567951824258024,"compiled_state":{"alias":"nonlineal-melancholy-grouper","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"cc69cc117980e219909306cd094c6c903705c308","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 248f-ac00-18db-4259","material: b4c133a517b552e8","material-part: children 647ea2107ca5072f 0","material-part: description 9ce2fa082761d9a8 7929","material-part: description_boxes 83b7db61ca197115 0","material-part: file_impact fea7edaea93447cb 6","material-part: ticket_id 27a4b7b2c6c3bfe0 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.11.0 (cc69cc117-dirty)","regver: 4f90349cd81c4911","verified-at-sha:cc69cc117980e219909306cd094c6c903705c308","dep 91f39db70594d3e4ccc2fd7a27469ae1648c025c42b3c4a77ae277c9ac53deef src/rebar/_engine/rebar_reconciler/apply_handlers.py","dep 5bee20a0c1259e6eaec716cf6f12912324ff8b5346528c9fcf86692d691affb7 src/rebar/_engine/rebar_reconciler/dispatch_one.py","dep b490132951651defcf27213f779c61d3fd146bcd3089544c89d507807cef8172 src/rebar/_engine/rebar_reconciler/git_adapter.py","dep absent src/rebar/_engine/rebar_reconciler/peer_confirmations.py","dep a2d672830ca368435d2982c0185500e867478cc64ac2194340d2cbb1a6c9ab1f src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","dep absent tests/unit/rebar_reconciler/apply/test_peer_confirmations_store.py","read-set: 12","read-path: src/rebar/_engine/rebar_reconciler/_backend.py","read-path: src/rebar/_engine/re