r/local/bin/docker-storage-cap.sh)","OBS_PATHS='infra/scripts/observability.sh infra/scripts/install-observability.sh' (autodeploy.sh:264) — no cap script"],"finding":"The 'Consequence' says the cap files 'do reach the box with the checkout, so this is a missed TRIGGER rather than a missing file.' But the copies that observability.sh reads and compose-up.sh installs live at /usr/local/bin/*-cap.sh and are (re)written only when install-observability.sh runs; install-observability.sh re-materializes on OBS_PATHS, which does NOT include the cap scripts. So a cap-only edit leaves the INSTALLED /usr/local/bin copies stale — a stronger consequence than 'the checkout has it, just no trigger.'","group_criteria":null,"group_id":null,"id":"f450cafd193f8c93f","impact":0.55,"is_primary":null,"location":"Plan 'Consequence' section","norm_id":"n1e82f7aa6f09e7c7","priority":0.55,"reason":"default-advisory","recalled":false,"scenarios":["Operator edits only the ceiling in docker-storage-cap.sh; no OBS_PATHS path changed, install-observability.sh never re-runs, so /usr/local/bin/docker-storage-cap.sh stays at the old ceiling for both the probe's percent-of-cap reading and any future compose-up --install"],"severity":null,"suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"n