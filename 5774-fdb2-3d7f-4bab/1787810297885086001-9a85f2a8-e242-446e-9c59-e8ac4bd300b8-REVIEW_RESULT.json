-deploy-backoff` recorder')","norm_id":"nddd360ce5618fb3f","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["The new mcp-deploy-backoff file is written but never pruned, leaving a stale backoff window that silently throttles mcp after the condition has cleared.","The bot/global backoff is pruned on a schedule the new file is excluded from, producing asymmetric retention."],"severity":"none","suggested_fix":"Add a sentence noting that mcp-deploy-backoff is pruned by the same path as deploy-backoff (and, if so, extend/assert the prune test to cover it).","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] Re-derive the full list of tests that read/mutate the backoff state file (grep `deploy-backoff` across tests/ surfaces test_autodeploy_prune.py, test_autodeploy_fetch_secrets.py, test_autodeploy_health_gate.py, and test_autodeploy_mcp_bluegreen.py) and reconcile each against the plan's claim that only prune reads it; in particular decide whether test_autodeploy_mcp_bluegreen.py:506 must switch to unlink