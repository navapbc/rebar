{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nowners=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef norm(ref,path):\n source=subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\n tree=ast.parse(source,type_comments=True)\n for node in ast.walk(tree):\n  if isinstance(node,owners) and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n   node.body=node.body[1:]\n for item in tree.type_ignores:\n  item.lineno=0\n return ast.dump(tree,include_attributes=False)\nbad=[p for p in sys.argv[1:] if norm(\"HEAD^\",p)!=norm(\"HEAD\",p)]\nassert not bad,f\"normalized AST changed: {bad}\"' tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py tests/unit/store/test_store_paths.py tests/unit/store/test_windows_exclusive_leg.py","dd_id":"semantic","dd_text":"Require normalized Python AST equality after removing true leading docstrings and normalizing only type-ignore line numbers."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io,re,subprocess,sys,tokenize\ndirective=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma\\b|fmt\\b|nosec\\b)\",re.I)\ndef kept(ref,path):\n source=subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\n lines=source.splitlines()\n out=[]\n for tok in tokenize.generate_tokens(io.StringIO(source).readline):\n  if tok.type!=tokenize.COMMENT:\n   continue\n  prefix=lines[tok.start[0]-1][:tok.start[1]]\n  if prefix.strip() or directive.search(tok.string):\n   out.append((tok.string, prefix.rstrip()))\n return out\nbad=[p for p in sys.argv[1:] if kept(\"HEAD^\",p)!=kept(\"HEAD\",p)]\nassert not bad,f\"inline comment or directive changed: {bad}\"' tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py tests/unit/store/test_store_paths.py tests/unit/store/test_windows_exclusive_leg.py","dd_id":"directives-inline","dd_text":"Preserve every inline comment and behavior-bearing directive exactly."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess,sys\nexpected=set(sys.argv[1:])\nactual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nassert actual==expected,f\"changed paths mismatch: missing={sorted(expected-actual)} extra={sorted(actual-expected)}\"' tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py tests/unit/store/test_store_paths.py tests/unit/store/test_windows_exclusive_leg.py","dd_id":"paths","dd_text":"Require the one leaf commit to change exactly the five impacted files."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -m pytest -q tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py tests/unit/store/test_store_paths.py tests/unit/store/test_windows_exclusive_leg.py","dd_id":"focused-tests","dd_text":"Execute the five owned store test modules."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/ruff check tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py tests/unit/store/test_store_paths.py tests/unit/store/test_windows_exclusive_leg.py && rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/ruff format --check tests/unit/store/test_git_outcome.py tests/unit/store/test_merge_recovery.py tests/unit/store/test_stamped_lock.py 