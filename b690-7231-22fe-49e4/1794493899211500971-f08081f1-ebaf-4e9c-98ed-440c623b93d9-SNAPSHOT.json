{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794493899211500971,"compiled_state":{"alias":"antifungal-amenable-mite","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"6dbf05538f776495c31ccb37b6241ba95a2e8bb1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b690-7231-22fe-49e4","material: 929180b465c720c6","material-part: children 647ea2107ca5072f 0","material-part: description 86388eaf2c4f1f58 7832","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact a3f2603b0909253a 4","material-part: ticket_id 16105f79c11d027d 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 6","review-phase: planning","rebar-version: 0.15.1 (6dbf05538f7)","regver: aa61189569d34126","verified-at-sha:6dbf05538f776495c31ccb37b6241ba95a2e8bb1","plan-material-pin: prerequisite 75af-1212-aa22-463f 8e7de17c027cf9b9","dep 94072d02b61a347bbd2d59f618f846185940a66044a392065d050470bdbee7f6 docs/llm-framework.md","dep absent src/rebar/llm/eval_specs/engine_comparison_results.json","dep absent src/rebar/llm/evals/engine_comparison.py","dep absent tests/unit/test_engine_comparison.py","read-set: 25","read-path: evals/plan-review-gate/replay/labels-b3784f0609e3d7f7dcd5a20f2d83081bc37c31dfddd62e2bf8f0baeb3eed8ad6.jsonl","read-path: evals/plan-review-gate/replay/labels-report-b3784f0609e3d7f7dcd5a20f2d83081bc37c31dfddd62e2bf8f0baeb3eed8ad6.md","read-path: scripts/check_raw_git_writes.py","read-path: src/rebar/llm/config.py","read-path: src/rebar/llm/evals/__init__.py","read-path: src/rebar/llm/eval