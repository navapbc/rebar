d":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Widen the regression AST scan to cover all browser-tier fixtures/test modules under tests/e2e/ (not just conftest.py) so no bare pytest.skip on a browser-tier path escapes the guard.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan Testing: 'an AST scan of tests/e2e/conftest.py asserts the browser fixtures contain no bare pytest.skip(...) call'","Grep confirms two bare pytest.skip('e2e(browser): ...') calls live in tests/e2e/test_editor_library.py:31 and tests/e2e/test_editor_batch_library.py:41, outside the scanned file"],"finding":"The AST regression scan is scoped only to tests/e2e/conftest.py, so it cannot detect the two existing bare pytest.skip browser-tier paths in test_editor_library.py and test_editor_batch_library.py, nor a future silent path added in any e2e test file rather than conftest.","group_criteria":null,"group_id":null,"id":"f1dde54299dc9e65c","impact":1.0,"is_primary":null,"location":"Testing 'Regression scan' bullet / AC (regression scan)","norm_id":"n91ab7ca6174fab40","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A future author adds a new per-file browser fixture with a bare skip in a test module: the conftest-only scan passes green while a silent skip path is reintroduced"],"severity":null,"suggested_fix":"Scan every module under tests/e2e/ (or every fixture consumed by a browser_runner test) for bare pytest.skip in the tier's non-execution paths, so both the existing library fixtures and future additions are covered.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Route the in-module browser-tier fixtures (library_editor_server, batch_library_editor_server) through tier_unavailable too, and widen the regression AST scan from conftest.py to all of tests/e2e (or to every fixture feeding a browser_runner-consuming test), so no browser-tier non-execution path bypasses the record.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["Approach states the design goal: 'make every non-execution path of the tier consult it'","Scope lists only 'route browser_runner / editor_server / editor_server_batch skip paths through tier_unavailable' — omitting the two in-module fixtures","Testing bullet 5: 'an AST scan of tests/e2e/conftest.py asserts the browser fixtures contain no bare pytest.skip(...)' — scoped to conftest.py only, so it cannot see the two in-module skips","tests/e2e/test_editor_library.py:31 `pytest.skip(\"e2e(browser): fixture workflow or built editor bundle missing\")` inside library_editor_server, consumed by test at line 52 alongside browser_runner","tests/e2e/test_editor_batch_library.py:41 equivalent bare skip, consumed at line 62 alongside browser_runner"],"finding":"The mechanism does not cover every non-execution path of the browser tier: two browser-tier test modules define their own in-module fixtures with bare pytest.skip() (tests/e2e/test_editor_library.py:31 library_editor_server, tests/e2e/test_editor_batch_library.py:41 batch_library_editor_server), and both consume browser_runner. The plan routes only conftest.py's browser_runner/editor_server/editor_server_batch through tier_unavailable, and its regression scan is scoped to tests/e2e/conftest.py — so these two skips remain silent self-skips AND go unguarded, leaving the exact 'vacuous green' the ticket exists to remove and defeating AC3 for those two tests.","group_criteria":null,"group_id":null,"id":"f0ed03251afa07bc0","impact":1.0,"is_primary":null,"location":"Scope + Approach step 3 + Testing 'Regression scan'; tests/e2e/test_editor_library.py:31, tests/e2e/test_editor_batch_library.py:41","norm_id":"ne6a2b0f341b05318","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["CI (or any checkout) where the editor bundle is unbuilt: test_editor_library / test_editor_batch_library self-skip silently, contributing green with no BrowserTierNotRunWarning and no failure when the record is absent","A future edit assumes the tier is fully guarded and relies on the conftest-only AST scan, which never inspects these two modules"],"severity":null,"suggested_fix":"Extend Scope to include tests/e2e/test_editor_library.py and tests/e2e/test_editor_batch_library.py (replace their bare pytest.skip with tier_unavailable), and change the Testing 'Regression scan' to scan the whole tests/e2e tree (every fixture that any browser_runner-consuming test depends on) rather than only conftest.py.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"Add an acceptance criterion covering the conftest AST regression scan (no bare pytest.skip in the browser fixtures), or fold it explicitly under AC3.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5d","T5e","T7"],"criteria":["E1","E6"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["Testing lists 'Regression scan — an AST scan of tests/e2e/conftest.py asserts the browser fixtures contain no bare pytest.skip(...) call'","No AC references this s