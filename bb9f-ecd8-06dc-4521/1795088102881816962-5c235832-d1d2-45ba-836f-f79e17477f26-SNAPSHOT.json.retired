{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795088102881816962,"compiled_state":{"alias":"digestive-greasy-kingsnake","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"79f46cde8a49c4cfcb03f960bfbe059c82652a24","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: bb9f-ecd8-06dc-4521","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: reused","rebar-version: 0.16.0","material: 15e38fdbbbd1462f","verified-at-sha:92d3f373e2c4159c2f495aea7c3b029941200d62"],"material_fingerprint":"15e38fdbbbd1462f","merged_log_commit":"92d3f373e2c4159c2f495aea7c3b029941200d62","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1795088102881443386},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"1654f3e3e5335ef07bde868d8ff4991850f4c77e","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: bb9f-ecd8-06dc-4521","material: ffddbd1cdf699c67","material-part: children 647ea2107ca5072f 0","material-part: description f39f4ad196028fd6 5141","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact f985d59e5c380277 3","material-part: ticket_id 87a999dfebe38497 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 14","review-phase: planning","rebar-version: 0.16.0","regver: aa61189569d34126","verified-at-sha:1654f3e3e5335ef07bde868d8ff4991850f4c77e","dep 501fb55eff78f57032064d9b2393cb01144069a1df0388d04d060e445da27913 src/rebar/_mcp_llm.py","dep 85ac0e195e7cc070d04b3dd413576d2e6a57b74b7e796cac2a57c403599a86cc src/rebar/llm/gate_runs.py","dep ef805ce36b6c05a7024cb91e20c19dc9143670d4fcf4f19fa3503a84c8e738b0 tests/unit/test_mcp_gate_async.py","read-set: 15","read-path: infra/compose/docker-compose.yml","read-path: scripts/_mechanism_delta/compare.py","read-path: scripts/_mechanism_delta/detect_code.py","read-path: scripts/_mechanism_delta/markers.py","read-path: scripts/check_mechanism_delta.py","read-path: src/rebar/_commands/doctor_locks.py","read-path: src/rebar/_mcp_inflight.py","read-path: src/rebar/_mcp_llm.py","read-path: src/rebar/_mcp_ticket_async.py","read-path: src/rebar/_store/lock.py","read-path: src/rebar/_store/lock_kernel.py","read-path: src/rebar/llm/gate_admission.py","read-path: src/rebar/llm/gate_runs.py","read-path: tests/unit/test_gate_status_sidecar_visibility.py","read-path: tests/unit/test_mcp_gate_async.py","currency-basis: file_impact"],"material_fingerprint":"ffddbd1cdf699c67","merged_log_commit":"1654f3e3e5335ef07bde868d8ff4991850f4c77e","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1795068429475657450}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"b6b78a55e441a2144ac482b4e5050b767aad258220b86ea08235d8f538628b4e","event_uuid":"df0d6919-16c6-4b97-9011-8c5cb683ddba","position":{"commit_sha":"d5b8af51b29e21624ab36df7905aba113c71f799","position":"1795068054700531563-df0d6919-16c6-4b97-9011-8c5cb683ddba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b5879598b014b67