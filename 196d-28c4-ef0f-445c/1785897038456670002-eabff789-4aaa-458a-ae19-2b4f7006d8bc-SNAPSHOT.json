u4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"457995520bb36077a924cb1f1bfaa9763f12df49659c58c95fd8020f745d07bf","event_uuid":"87e87ff3-9f7b-4cd0-b1c8-7d9844afabe7","position":{"commit_sha":"4c6c497943377c39cee3dfe5dccb17d4eded75b2","position":"1785894343241654001-87e87ff3-9f7b-4cd0-b1c8-7d9844afabe7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ced96a18dc0373631286e8f8a0855187b113f28b1780b6765dd62c879890c6ba","event_uuid":"c37bb252-ed7a-458d-b2bf-fa0e35cfaee3","position":{"commit_sha":"947e623c9e8e6ddb119fe35f7a451f35df8fdc3f","position":"1785897002186436001-c37bb252-ed7a-458d-b2bf-fa0e35cfaee3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fdf5e34fff3ddc6e0b6fe4c36bdd65da083bdfa53e49347fc8350b0e43ee6d6c","event_uuid":"da73aa99-8d16-4955-8ea7-2c6a29b73ad2","position":{"commit_sha":"85c169c27a81539d252834cc8d4ce68b57c0f78e","position":"1785897037928960001-da73aa99-8d16-4955-8ea7-2c6a29b73ad2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"38dfb20a0ec5df3968d96b41fdf2a8ae8454245e165fe18c25a677054a63bbc3","event_uuid":"e4289308-9287-4065-ac65-8b63ad889380","position":{"commit_sha":"85c169c27a81539d252834cc8d4ce68b57c0f78e","position":"1785897038456670001-e4289308-9287-4065-ac65-8b63ad889380"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785891841819301001,"creation_channel":"cli","deps":[{"link_uuid":"c37bb252-ed7a-458d-b2bf-fa0e35cfaee3","relation":"relates_to","target_id":"240c-4b5a-b24d-43fb"}],"description":"## Context / Problem\n\nFive recurrences of one defect class: rebar's prompted structured-output extraction is\nschema-blind — `tolerant_parse` (src/rebar/llm/structured.py:121) returns the FIRST parseable\nJSON object in a reply (fenced blocks first, `_FENCE_RE` at :40, then `_first_json_object` at\n:82), so any JSON-shaped material the model quotes (tool results, dependency-link records,\nexamples) beats the real payload appearing later. Latest instance: bug child \"Completion\nverifier returns a dependency-link record instead of a CompletionVerdict\" blocked a legitimate\nclose. Prior instance-fixes (git 9007f290, 5ed760a1, 1aa90fa5) keep being re-broken by routine\nmodel swaps (the Bedrock cutover changed the trigger rate). This epic retires the class, not\nthe instance. All design decisions were derisked by live experiments E1–E4 recorded as\ncomments on the bug child (design-investigation + experiment-results comments).\n\n## Approach\n\nThree coordinated thrusts, each child independently landable via Gerrit, fail-closed\nthroughout:\n\n1. **Harden the prompted path every model shares**: schema-filtered candidate selection with\n   last-valid-wins in `parse_structured` (the bug child); an explicit sentinel output channel\n   whose directive and extraction land atomically (sentinel child); an opt-in replayable\n   raw-reply artifact on parse failure (artifact child).\n2. **Provider-native structured output where MEASURED safe**: raise the Bedrock SDK floor\n   (SDK child); replace `output_mode()`'s stale blanket thinking guard with measured\n   call-property gating (guard child); add exact-id measured-fact capability rows only for\n   cells a live measurement passed (rows child). Unmeasured cells stay prompted.\n3. **Measure, don't assume**: a reusable provider-matrix raw-output baseline/eval harness\n   running as a manual CI job where the API keys already live (harness child).\n\n## Acceptance Criteria\n\nEach criterion is delivered by exactly one child, with no overlapping responsibilities.\n\n- [ ] A reply that quotes schema-valid-looking JSON before the real payload parses to the\n      correct contract object — delivered by the selection bug child; checked by its corpus +\n      property tests passing under `make test`.\n- [ ] Prompted structured replies carry an explicit sentinel output channel whose extraction\n      ships in the same change as the directive — sentinel child; checked by its unit pins and\n      recorded before/after eval artifact.\n- [ ] A final structured-parse failure can leave an opt-in replayable raw-reply artifact,\n      default off — artifact child; checked by its config-effect contrast tests.\n- [ ] The locked Bedrock SDK accepts Converse `outputConfig` client-side (botocore >= 1.43) —\n      SDK child; checked by lock resolution and a recorded `uv tree` version proof.\n- [ ] `output_mode` gates native output on measured thinking-compatibility per model instead\n      of blanket-forcing prompted — guard child; checked by its contrast unit tests.\n- [ ] Every model cell measured PASS runs native structured output and every unmeasured or\n      failing cell stays prompted with a recorded reason — rows child; checked by\n      config-effect tests through the real capability read path plus the recorded cell table.\n- [ ] Before/after raw-output distributions for the configured provider matrix exist as\n      recorded, deterministically scored artifacts — harness child; checked by the\n      workflow_dispatch run's uploaded artifacts referenced on that child.\n\n## Risks\n\n- Trailing-recap schema-valid decoy wins under last-valid-wins — accepted residual; a warning\n  marks it; zero of the five historical recurrences show that layout (E3 evidence).\n- The sentinel directive changes output distribution (measured: quote-in-prose 0% -> 100%) —\n  mitigated by shipping directive+extraction atomically and measuring before/after (harness).\n- Bedrock rejects `outputConfig` for opus-4-7/4-8 server-side — those cells stay on the\n  hardened prompted path with a recorded re-measure trigger; no workaround exists client-side.\n- The botocore floor collides with the `[eval]` -> aiobotocore cap — pyproject.toml's\n  `[tool.uv]` conflicts block (~line 261) already forks eval vs bedrock resolution; the SDK\n  child must keep those forks resolvable.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/structured.py","reason":"aggregate of children: selection, sentinel, guard"},{"path":"src/rebar/llm/capabilities.py","reason":"aggregate of children: field + rows"},{"path":"src/rebar/llm/structured_run.py","reason":"aggregate: artifact hook"},{"path":"pyproject.toml","reason":"aggregate: SDK floor"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","240c-4b5a-b24d-43fb"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"da73aa99-8d16-4955-8ea7-2c6a29b73ad2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"196d-28c4-ef0f-445c","ticket_type":"epic","title":"Eliminate the schema-blind structured-output extraction defect class","verify_commands":[]},"source_event_uuids":["41abe667-65fb-4525-98b9-f09a09c7b930","497664f5-34e9-40c8-8b35-fdd5b6313fa9","87e87ff3-9f7b-4cd0-b1c8-7d9844afabe7","c37bb252-ed7a-458d-b2bf-fa0e35cfaee3","da73aa99-8d16-4955-8ea7-2c6a29b73ad2","e4289308-9287-4065-ac65-8b63ad889380"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785897038456670002,"uuid":"eabff789-4aaa-458a-ae19-2b4f7006d8bc"}