ar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ef5dc8b1dc01559f4c0f30d020c2c25fc021d0d254b3794fbe13644d84f0eaa6","event_uuid":"71187c9e-014d-495c-a7b8-255bef81c0b4","position":{"commit_sha":"116dd43ffa39eb138c3350a54cc5e0d7862c9b08","position":"1788575113921454001-71187c9e-014d-495c-a7b8-255bef81c0b4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"70eb379830b6eb0be50acd99648c27eff95dd3c8b6ec61b9662ea1e39fa0060e","event_uuid":"966eff4b-7612-47a8-a62d-7cc4da2e950c","position":{"commit_sha":"b1423fe90bc51269ff5b90458aba47585edb0017","position":"1788575138905002001-966eff4b-7612-47a8-a62d-7cc4da2e950c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"016eb9ee8059cc9cee9a566d981089a2dfd66ce785a4de79c36430c3dc14757d","event_uuid":"b3b4da6b-7454-41a2-ac41-b071a5d736eb","position":{"commit_sha":"c106f084d3bd95491fdaa4df148daf941343313a","position":"1788575178112346001-b3b4da6b-7454-41a2-ac41-b071a5d736eb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix pushed as Gerrit change 2631 (commit 957aff4c0eba), NOT yet closed.\n\nRED first, on origin/main tip cfff861c061c in a clean worktree:\n  `pytest tests/unit/test_mechanism_delta.py::test_a_marker_in_a_new_gate_scripts_head_admits_it`\n  -> ModuleNotFoundError: No module named 'scripts._mechanism_delta'\nThe same node under `python -m pytest` passed, confirming the reported mechanism\n(cwd on sys.path under -m, absent under the bare console script).\n\nFix, scoped to tests/unit/test_mechanism_delta.py only:\nthe module now installs its own sys.path entry at import time, derived from __file__,\nand imports `_mechanism_delta.markers` by bare name - the same pattern\nscripts/check_mechanism_delta.py already uses to reach that subpackage.\nscripts/_mechanism_delta/__init__.py needed no change.\n\nScope decision (the broader alternative was considered and rejected):\na repo-root conftest.py or a pythonpath setting would fix this and every future case,\nbut the repo root being OFF sys.path is a load-bearing invariant here - it is what\ntests/unit/test_tests_import_convention.py (bug a371) enforces. Putting the root on the\npath would make `tests.`-rooted imports resolve under the bare console script and reduce\nthat standing guard to a no-op. An AST sweep also found exactly ONE package-form\n`scripts.` import in the whole repository - the one removed here - so the narrow fix is\nalso the complete one. file_impact unchanged.\n\nAC3 guard: test_the_reported_selection_passes_standalone spawns the BARE pytest console\nscript from a cwd outside the repository and asserts the reported node passes. Proven to\nbe a real oracle, not a change detector: with the insert removed it fails even under\n`python -m pytest`, the invocation that originally masked the defect.\n\nVerification: node RED->GREEN under the bare script; `python -m pytest` still green;\nwhole module 32 passed under BOTH invocation styles; both sibling import-convention\nguards still green; make lint and make typecheck exit 0 with no ratchet baseline edits\nand no new mechanism.","timestamp":1788552786318141001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Orchestrator close verification — all three ACs re-proven on this host at close time, not inferred\nfrom the merge.\n\nFix merged as `98d4ab96325d` (\"Fix mechanism-delta test import under bare pytest\").\n\n## AC1 — both halves, run just now\n\n```\n$ pytest tests/unit/test_mechanism_delta.py::test_a_marker_in_a_new_gate_scripts_head_admits_it -q\n1 passed in 1.82s                        <- the BARE console script, the reported reproduction\n\n$ python -m pytest tests/unit/test_mechanism_delta.py -q\n32 passed in 104.15s                     <- and the module still green under -m\n```\n\nBoth invocation modes pass, which is the point: the bug was that only ONE of them worked.\n\n## AC2 — the import is explicit, derived from `__file__`\n\n`tests/unit/test_mechanism_delta.py:42-43` inserts `_SCRIPTS_DIR` on `sys.path` at module import,\nand `:29` derives it from `Path(__file__).resolve()`. The comment at `:36-38` records the\nnon-obvious part — it is the `scripts/` directory, NOT the repository root — so the next reader\ndoes not \"fix\" it back to the root. No reliance on collection order remains, and the reported\n`ModuleNotFoundError` does not appear in either run above.\n\n## AC3 — the isolation property is enforced, not incidental\n\n`test_the_reported_selection_passes_standalone` at `:424`, carrying the marker\n`allow_unharnessed_subprocess(\"spawns the BARE pytest console script; the child's own sys.path IS\nthe thing under test\")`. That is the correct shape: an in-process assertion could not have caught\nthis, because the parent's `sys.path` is exactly what was masking the defect.\n\n## Close class\n\n`preexisting`. The defect was latent from when the module was written — the import happened to\nresolve because some other collected test had already put `scripts/` on `sys.path`. Nothing\nregressed; a narrower selection simply stopped supplying the accident. Recording it that way\nmatters, because \"it only fails in a narrow selection\" is the signature of an incidental\ndependency, not of a flake, and treating it as a flake would have meant retrying it forever.","timestamp":1788574798824551001}],"completion_expectation":"required","created_at":1788524754894611001,"creation_channel":"cli","deps":[{"link_uuid":"1982e8eb-3449-4fe8-aa33-7944e7e43169","relation":"discovered_from","target_id":"1035-bed7-c855-4732"},{"link_uuid":"213865a6-dc03-4a40-9d7b-37428c1c4a19","relation":"relates_to","target_id":"7902-719e-3f91-4e1a"},{"link_uuid":"b3b4da6b-7454-41a2-ac41-b071a5d736eb","provenance":"derived","relation":"caused_by","target_id":"9ca8-675e-4dfb-427d"}],"description":"## Symptom\n\nOn current `origin/main` (69cd2b9e15aa), this passes in the full suite but FAILS when run as\na narrow selection:\n\n    pytest tests/unit/test_mechanism_delta.py::test_a_marker_in_a_new_gate_scripts_head_admits_it\n    E   ModuleNotFoundError: No module named 'scripts._mechanism_delta'\n\nThe failing import is inside `ratchet_head_lines()`:\n`from scripts._mechanism_delta.markers import HEAD_LINES`. It needs the repo root on\nsys.path, which in a narrow selection is not established.\n\n## Bisected\n\n    6b034b9f8224  PASS   (Make scanner-integration recipe POSIX-sh portable)\n    9c7d78127696  FAIL   <- first bad commit: 'Revert scanner-integration Verified gate'\n    cad66dd237cc  FAIL\n    457d9a20bed9  FAIL\n    a220bfafa7ae  FAIL\n    69cd2b9e15aa  FAIL   (current main)\n\nReproduced on a clean detached worktree of unmodified origin/main, so this is not a\nworktree or venv artifact. `import scripts` succeeds at BOTH refs when the repo root is\nexplicitly on sys.path, so the regression is in what puts it there during collection, not in\nthe package itself. The revert deleted scripts/install_review_scanners.py,\n.github/workflows/_scanner-integration.yml and three infra/compose files, and touched the\nMakefile; the mechanism connecting that to collection-time sys.path is the open question.\n\n## Why CI is green anyway\n\nThe default suite runs the whole tree, where something else establishes the import before\nthis module needs it, so `Verified` passes and nothing surfaces. The failure appears only\nwhen a contributor runs the module (or a small set of modules) on its own — which is exactly\nwhat an agent does when told to 'run the three gates make lint does not cover'.\n\nThat makes this a sibling of bug 1035-bed7-c855-4732, in the OPPOSITE direction: 1035 is a\nlocal green on a tree CI rejects; this is a local red on a tree CI accepts. Both erode the\nsame thing — whether a local result can be believed. A test that passes only by grace of\nanother test's import side effect is not a trustworthy oracle either way.\n\n## Acceptance criteria\n\n- [x] The narrow selection above passes on a clean checkout of main. Proven by running\n      `pytest tests/unit/test_mechanism_delta.py::test_a_marker_in_a_new_gate_scripts_head_admits_it`\n      (the BARE console script) and seeing it go from red to green, with\n      `python -m pytest tests/unit/test_mechanism_delta.py` still green.\n- [x] The fix makes the import explicit — the module puts the directory it imports from on\n      `sys.path` itself, derived from `__file__`, the way `scripts/check_mechanism_delta.py`\n      already does for its own `_mechanism_delta` import — rather than relying on collection\n      order. Checked: the reported `ModuleNotFoundError` no longer appears in the output of\n      `pytest tests/unit/test_mechanism_delta.py` run from a clean checkout.\n- [x] A regression test pins that the reported reproduction passes when run ALONE, so the\n      isolation property is enforced rather than incidental. It spawns the BARE `pytest`\n      console script in a child from a cwd outside the repository, mirroring\n      `tests/unit/test_scripts_import_convention.py::test_repro_module_passes_standalone`.\n      Proven by `pytest tests/unit/test_mechanism_delta.py -k standalone`.\n\n## Testing\n\n- **RED first:** `pytest tests/unit/test_mechanism_delta.py::test_a_marker_in_a_new_gate_scripts_head_admits_it`\n  must fail with `ModuleNotFoundError: No module named 'scripts._mechanism_delta'` BEFORE the\n  fix, and pass after. A test not seen red proves nothing when it passes.\n- **The masking invocation stays green:** `python -m pytest tests/unit/test_mechanism_delta.py`.\n- **The whole module under the bare script:** `pytest tests/unit/test_mechanism_delta.py`.\n- **No collateral damage:** `make test` (the full suite) stays green.\n- **Gates:** `make lint` and `make typecheck` both exit 0, which includes the shrink-only\n  complexity and mechanism-delta ratchets.\n\n## Not claimed by this reporter\n\nFound while rebasing change 2619 (bug 1035). Reported, not fixed: it is unrelated to that\nchange and fixing it there would have bloated an approved change and delayed both.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_mechanism_delta.py","reason":"the failing module; must establish the repo root on sys.path itself rather than relying on another module import side effect"},{"path":"scripts/_mechanism_delta/__init__.py","reason":"the package that fails to import under the bare pytest console script"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","7902-719e-3f91-4e1a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"71187c9e-014d-495c-a7b8-255bef81c0b4","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"7f46-790d-7b9f-4db1","ticket_type":"bug","title":"test_mechanism_delta fails in a narrow pytest selection on main: scripts._mechanism_delta unimportable","verify_commands":[]},"source_event_uuids":["ad69798d-6879-43de-adfd-394aff25330f","9fd43f8e-199c-4c78-aa69-6f44efefd3be","3e3ec410-6377-4ca9-b90e-e353e13ae095","5bc287d4-d843-4981-85db-8ea7f3845c19","ca52951d-09b1-4bc2-ab15-b11c5d381efb","8b70b5dd-2d6e-43ab-9d58-16b35d055fd6","213865a6-dc03-4a40-9d7b-37428c1c4a19","02577c1b-1e0e-4be3-8ec1-bb8ef886feca","bc247dd5-9311-4f92-841c-5f8afc11b020","71187c9e-014d-495c-a7b8-255bef81c0b4","966eff4b-7612-47a8-a62d-7cc4da2e950c","b3b4da6b-7454-41a2-ac41-b071a5d736eb"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788582699354629001,"uuid":"52bc1997-6489-4037-888b-acb92ce0d202"}