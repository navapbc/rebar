{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788582699354629001,"compiled_state":{"alias":"newborn-ethnologic-scaup","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"e510c64dbcb681fd8e14050a854dfce86f488faf","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 7f46-790d-7b9f-4db1","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.13.1 (e510c64dbc-dirty)","material: 77f0cfe9e3243987","verified-at-sha:e510c64dbcb681fd8e14050a854dfce86f488faf"],"material_fingerprint":"77f0cfe9e3243987","merged_log_commit":"e510c64dbcb681fd8e14050a854dfce86f488faf","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788575138903263000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"cfff861c061cfd12faaf4291e20dea452ba329ff","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 7f46-790d-7b9f-4db1","material: 77f0cfe9e3243987","material-part: children 647ea2107ca5072f 0","material-part: description 94e126eebdcefc30 4149","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 8cb361bf841a228d 2","material-part: ticket_id ab39980580e469cc 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review