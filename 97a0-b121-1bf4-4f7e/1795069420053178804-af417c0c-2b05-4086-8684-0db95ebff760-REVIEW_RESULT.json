/test_mutation_gate.py":"b922c05b697a1a537446f8b38ffd3648fcea8a88031bcae9e3fa6e239e9b4211","tests/unit/reconciler/state/test_sync_logger.py":"5c057372c8254cf7a6c6ca536a2efb8c07b7e5498300c48e0b3312fe22b33135","tests/unit/test_child_hooks.py":"868127e0952ec6a42a57785eb37ed67d460c78803ffc9f1d9e7721d3f0cd7e18","tests/unit/test_compact_fold_prelock.py":"3c2f2a522570192f1b06034c4152595d57e8c59893cb0a92184f275df9ee4009","tests/unit/test_read_freshness_git_spawns.py":"cd34a89223cf361b1e29d4c06348e558084d0e6fddfceccd3b5e647312e2724b","tests/unit/test_read_freshness_parity.py":"1969f4f9c4c8663637aceb6b25d44ca054f35b4cb335ab9d00390d35e0ee4058","tests/unit/test_sync_marker_tempdir.py":"53e3fd1414364e14b29f3bfdc41c744fffd980730f7e36909afd366754429842"},"dropped":[{"agreement":1,"block_threshold":0.54,"blocking_enabled":true,"checklist_item":"- [ ] Point the sandboxed children's TMPDIR at a writable directory separate from pytest's --basetemp (e.g. a sibling under root), so pytest's basetemp cleanup cannot delete live temp files.","criteria":["edge-cases","maintainability"],"decision":"dropped","evidence":["scripts/mutation_gate.py:570: basetemp = root / \".mutation-pytest\"","scripts/mutation_gate.py:582: f\"--basetemp={basetemp}\",","scripts/mutation_gate.py:593: env[\"TMPDIR\"] = str(basetemp)","scripts/mutation_gate.py:666: env[\"TMPDIR\"] = str(basetemp)","Not confirmed in the repo: as I understand pytest's own code (TempPathFactory.getbasetemp), an existing --basetemp directory is deleted and recreated on first temp-dir use, so it is not a stable home for the system temp dir."],"finding":"mutation_gate points the sandboxed children's TMPDIR at the same directory passed to pytest as --basetemp. As I understand pytest, it deletes and recreates an existing --basetemp the first time a test asks for a temp directory. Any file or directory that shard code, plugins, mutmut or session fixtures put in tempfile.gettempdir() before that point is then deleted mid-session, and later use of it fails with FileNotFoundError.","id":"0","impact":0.0,"location":"scripts/mutation_gate.py:593","norm_id":"n257f4563afd759e5","priority":0.0,"reason":"low-validity","scenarios":["A session-scoped fixture or conftest calls tempfile.mkdtemp() before any test requests tmp_path, then uses that directory after pytest wipes basetemp.","mutmut runs pytest several times in one process, and each pass wipes temp state left by earlier passes."],"suggested_fix":"Create a sibling directory such as `root / \".mutation-tmp\"`, add it to `sandbox_allow`, set `env[\"TMPDIR\"]` to it in both execute_shard and _diagnose_non_killed, and make sure the repo-root leak guard ignores it (or that it is gitignored).","tier":"LLM","validity":0.3571,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"insufficient","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"insufficient","no_viable_alternative_explanation":"no","path_reachable":"insufficient","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":false,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"low","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}},{"block_threshold":0.95,"blocking_enabled":fals