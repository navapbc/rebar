{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794868919415597847,"compiled_state":{"alias":"majestic-depilatory-beetle","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"b4e0d01b6491cd280fd46841082b63bd8e3d3f4a","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6798-606d-37dc-46e7","material: 648a8ce44a23dd52","material-part: children fb51e4a33132ded8 2","material-part: description 50b906fe26eeda3e 5468","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact a07f62b96dd9332a 3","material-part: ticket_id e1c18c5ffc00d0e0 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 16","review-phase: execution","priority-floor: 0.80","rebar-version: 0.16.0","regver: aa61189569d34126","verified-at-sha:b4e0d01b6491cd280fd46841082b63bd8e3d3f4a","plan-material-pin: child 0559-f639-508d-4ac8 0a5dcd162b68c918","plan-material-pin: child 1ebf-599a-e15c-465d 44fbc4232903d51f","dep absent .github/windows-sweep-deselect/","dep 91b48c11668e0f294ab83d07c13eef79712cd52c3b2dc89de0fa5260be75c80d .github/workflows/test.yml","dep c35a1e211de9b39da2f76517ec67505d5ded95b00ebc9fa8a0e7f9b9744d8d3c tests/unit/test_conftest_windows_skip_rule.py","dep absent tests/unit/test_windows_sweep_deselect.py","read-set: 3","read-path: .github/workflows/test.yml","read-path: pyproject.toml","read-path: tests/conftest.py","currency-basis: file_impact"],"material_fingerprint":"648a8ce44a23dd52","merged_log_commit":"b4e0d01b6491cd280fd46841082b63bd8e3d3f4a","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794857691105598016}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":12,"unsigned":4},"authorship_ledger":[{"content_hash":"e28c7f69cadba254b4ba2897aa8b221032ef67f1bc3ba289694cf6f8abedb7bb","event_uuid":"ab115f8e-7b4d-46cc-8db1-31f1e5c3cb9c","position":{"commit_sha":"44740999a45adb23012c2493f58ebf7bdb9c1b27","position":"1789925132784701330-ab115f8e-7b4d-46cc-8db1-31f1e5c3cb9c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e4bbb7b1bef986b6c1118419808b2caae47e5332d17e98d022f36aa445f7f4a3","event_uuid":"32296d3a-c33e-48c3-a5fb-c894f0961be1","position":{"commit_sha":"44740999a45adb23012c2493f58ebf7bdb9c1b27","position":"1789925740121041843-32296d3a-c33e-48c3-a5fb-c894f0961be1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a69d5de8372b0b72e1ca4a0a2e08e6a9e1f6fe93658ea85aa878076c2cfaf907","event_uuid":"5b735488-51a4-4e5a-b22c-2b2f79ef737d","position":{"commit_sha":"9584033b229b17a5830ff45f9f27881c0039168d","position":"1794857084751933314-5b735488-51a4-4e5a-b22c-2b2f79ef737d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a817159140c4eaedb632cb8c6ee0785ae37d93b7edea53051e882ec60a89707b","event_uuid":"7888b445-b42c-4f7d-92fc-70f8653ca8ef","position":{"commit_sha":"92079c23b839e0ac78d49f6d1fb161906b1e4079","position":"1794857255884167388-7888b445-b42c-4f7d-92fc-70f8653ca8ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1f6d0cd5f5b1c9326499ef2a6d4c15733ef84be55e6c989b899b0d2c67b18a95","event_uuid":"7a9f2ffa-0940-4d3f-9cc3-4cef0fa111a1","position":{"commit_sha":"7b80652246ad9be134f184fa864c5cbbf3fa65d4","position":"1794857691105888648-7a9f2ffa-0940-4d3f-9cc3-4cef0fa111a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"824de633d2d09be41d42afb47081a6ff786efe367ea22181ee23e0ca93c67231","event_uuid":"da44a29b-219c-48a4-b057-452d294143cb","position":{"commit_sha":"958324083e03308740d3de7412e83050b58a5755","position":"1794857829451968751-da44a29b-219c-48a4-b057-452d294143cb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f95489b39263ba1e0ec5133fa60cf4a98938add5d9265f8c1bb8f02d728e5134","event_uuid":"d30a3194-6351-4b1f-a9dd-41b20850bdfc","position":{"commit_sha":"f050c411ff571c387c1620c5f2057550871b68f1","position":"1794868242522920309-d30a3194-6351-4b1f-a9dd-41b20850bdfc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8c2ea0be725f9333993f78066a24a6dfcface39497ac1cda41974e11a9a69dae","event_uuid":"65e1d49a-7736-4312-9c00-6fe6ed0ee81e","position":{"commit_sha":"e0b7072797e8bb3f7fa9796f0dd00f5ae0e92bb4","position":"1794868280859004574-65e1d49a-7736-4312-9c00-6fe6ed0ee81e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e1240c840e345accbdfaaf7ab54b672ab6c6e06a5786757db23a97bd9585c0c7","event_uuid":"0cdd41ca-0880-47b8-914f-60030997d1b2","position":{"commit_sha":"c46db3383f3fdb955ed8bd58094d9e1a43f5c7de","position":"1794868404164881796-0cdd41ca-0880-47b8-914f-60030997d1b2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0eb39b32d3cbe44b91dbd422d828e7d0fcd29996d90b11b31f8defeff69c9901","event_uuid":"0082626d-cb66-4cc1-8844-9f37c8596ae7","position":{"commit_sha":"a2d157e5127493a899c851539f5912d735f6b7ea","position":"1794868919415597846-0082626d-cb66-4cc1-8844-9f37c8596ae7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-292_agent","claim_remote_session":null,"claimed_session":"254a15f9-8e90-485d-964d-ba73152a1dcb","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Measured classification: 6 classes explain the whole wall, and one is 45% of it\n\nRead-only CI log analysis from macOS. No claim, no transition, no fix.\n\n### The count in the title is an undercount\n\n| Run | Date | Ref | Measured |\n|---|---|---|---|\n| `35250748887` | 2026-09-17 17:07Z | `4f12815e9a0b` | **1626 failed + 1382 errors = 3008** |\n| `35511654149` | 2026-09-20 12:48Z | `e84e4c5e9439` | **1636 failed + 1383 errors = 3019** |\n\nWorkflow `294845723` (`Test Suite (mirror)`, `.github/workflows/test.yml`). The count basis is\nthe final unindented pytest `short test summary info` block, with nested subprocess pytest\nsummaries excluded so they are not double-counted.\n\n**1626 counted only `FAILED` and missed 1382 `ERROR`s** \u2014 setup failures, which is precisely\nwhere the dominant cause lives. The title should say 3008. The 3-day-later run confirms it is\nstable and getting marginally worse, not drifting randomly.\n\n### The classes\n\nPercentages are of 3008.\n\n| # | Class | Count | % | Classification |\n|---|---|---|---|---|\n| 1 | Linked-worktree template copy cannot rewrite `.tickets-tracker\\.git` | **1361** | **45.2%** | Cascade from ONE fixture defect |\n| 2 | Linux/WSL/POSIX script + process assumptions | 545 | 18.1% | POSIX-only test assumption |\n| 3 | Path/newline/encoding + golden-output long tail | 544 | 18.1% | Mostly POSIX-only assumptions |\n| 4 | Offline network-guard / mock gaps | 392 | 13.0% | Test-harness defect |\n| 5 | OpenSSH op-cert toolchain + Windows ACL semantics | 98 | 3.3% | Runner toolchain gap |\n| 6 | MAX_PATH and remaining file-lock defects | 68 | 2.3% | **Genuine portability defect** |\n\nRepresentative verbatim errors:\n\n```\n1: PermissionError: [Errno 13] Permission denied:\n   'C:\\...\\test_half_fixed_copy_is_reject0\\half\\.tickets-tracker\\.git'\n2: CalledProcessError: Command '['bash', 'D:\\a\\rebar\\rebar\\infra\\scripts\\vartmp-cap.sh',\n   '--print-conf']' returned non-zero exit status 1\n3: UnicodeDecodeError: 'utf-8' codec can't decode byte 0x97 in position 976\n4: RuntimeError: Network access is forbidden in unit/scripts tests.\n5: SigningError: cannot mint op-cert signature: ssh-keygen (OpenSSH) not found;\n   SSHSIG requires OpenSSH >= 8.9\n6: SnapshotError: git checkout-index ... error: unable to create file\n   C:\\...\\rebar-gate-snapshots\\tmp\\tickets-752d00fbe360-...-CREATE.json: Filename too long\n```\n\n### The important structural finding\n\n**Class 1 is not 1361 bugs. It is one fixture defect with 1361 dependents.** The per-test store\ntemplate copy/rewrite path fails on `.tickets-tracker\\.git`, and every interface test that needs\na store then dies at setup. That is why the `ERROR` count is so close to the `FAILED` count and\nwhy counting only `FAILED` was so misleading.\n\nFixing that one path plausibly takes the wall from 3008 to roughly 1650 in a single change,\nwithout touching any product code. Nothing else on this list has that leverage.\n\nThe likely mechanism is a POSIX metadata assumption in the copy/rewrite \u2014 on Windows, `.git`\ninside the copied template is not rewritable the way the fixture expects, and a linked worktree's\n`.git` is a **file** containing a `gitdir:` pointer rather than a directory, which is exactly the\nkind of thing that works everywhere on POSIX and not at all on Windows.\n\n### Recommended sequence, by signal recovered per unit of work\n\n1. **Class 1** \u2014 one fixture fix, recovers 45% and removes the cascade that is currently hiding\n   everything behind it. Do this before diagnosing anything else, because the residual long tail\n   cannot be honestly classified until the setup cascade is gone.\n2. **Class 2** \u2014 decide per test: make portable, or explicitly mark non-Windows. 545 outcomes that\n   require `bash`/WSL/`fcntl`/`os.geteuid` are not Windows product signal in any case.\n3. **Class 4** \u2014 deterministic harness work: mock the provider path or mark genuine loopback tests\n   `@pytest.mark.allow_network`. The guard is behaving correctly; the tests are under-mocked.\n4. **Class 3** \u2014 only tractable after 1, 2 and 4 clear. 438 of it is an undecomposed assertion\n   tail that is not worth root-causing while the cascade is still in place.\n5. **Class 5** \u2014 a scoping call: provision OpenSSH \u2265 8.9 on the runner, or declare op-cert tests\n   unsupported on Windows.\n6. **Class 6** \u2014 small but the only class that is a **real product defect affecting real Windows\n   users**. Prefer shortening rebar's constructed paths over enabling `core.longpaths` on the\n   runner: runner config hides the defect from CI while leaving it live for downstream users.\n\n### Gate verdict\n\n**Not worth keeping as a gate in its current form.** At ~3000 red outcomes a new regression is\ninvisible, which is the definition of a destroyed signal. Keep it `continue-on-error` while\nclasses 1\u20134 are worked, then either restore it as a gate over a maintained Windows subset, or\nenumerate a baseline so it fails only on NEW classes \u2014 the same ratchet shape this repo already\nuses for module size, complexity and mechanism growth.\n\n### Could not establish\n\n- The 438-outcome residual assertion tail inside class 3 is measured but not decomposed. Doing\n  that before removing the class-1 cascade would be low-value.\n- Not reproduced on Windows; this is CI log and code analysis from macOS.\n- The MAX_PATH policy in class 6 is a deliberate human scoping decision and was not made here.","timestamp":1789925132784701330},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Class-1 defect (45.2% of all red outcomes) located and fixed\n\nFollow-up to the classification comment. The largest cause class is now root-caused to a single line, and a POSIX-verifiable fix is committed locally.\n\n### The defect\n\n`tests/_topology_template.py:199` (pre-fix). `_rewrite_embedded_paths()` rewrote **every** copied metadata file with `path.write_bytes(rewritten)` \u2014 including linked-worktree `.tickets-tracker/.git` **pointer files**.\n\n**The POSIX assumption:** that a copied Git marker file can always be reopened in place for `wb`.\n\n**The Windows operation that rejects it:** `pathlib` opening `...\\.tickets-tracker\\.git` with `mode='wb'` raises `PermissionError: [Errno 13]`. In a linked worktree `.git` is a *file* containing `gitdir: <path>`, and the copy preserves it read-only; Windows refuses the in-place rewrite that POSIX allows silently.\n\nThis is the same underlying fact as bug 84aa \u2014 a linked worktree's `.git` is a pointer, not a directory.\n\n### The fix\n\nNarrow and shape-guarded: only when a rewrite targets a `.git` file whose original bytes start with `gitdir:`, the helper temporarily adds owner-write permission, writes the rewritten pointer, then **restores the original mode**. Nothing else changes.\n\n### POSIX verification\n\nThe regression test simulates the Windows read-only marker on POSIX and proves the copied store stays self-contained. It fails before the fix and passes after.\n\n- `pytest tests/interfaces/test_rebar_repo_isolation.py -q` \u2192 14 passed in 17.08s\n- `pytest tests/integration/test_b636_rebuild_history_loss.py::test_rebuild_refuses_when_snapshot_cites_missing_sources -q` \u2192 1 passed in 9.42s\n- `make lint` \u2192 passed\n- `make typecheck` \u2192 passed\n\nCommit `daab41274c292f39af6949b84654f70a91107cdf` in worktree `.rebar/worktrees/investigate-6798`. **Not pushed** \u2014 see the scoping note below.\n\n### Other sites with the same `.git`-is-a-directory assumption\n\nTest-only, left unchanged because they sit outside the 1361-outcome copy/rewrite defect and some may deliberately fabricate full `.git` directories: `tests/integration/test_concurrency_regression.py`, `tests/unit/test_store_sync_reconverge.py`, `tests/unit/test_push_recovery_untracked.py`, `tests/scripts/bridge/test_bridge_fsck_keyset_prev_heldout.py`, `tests/scripts/bridge/test_bridge_fsck_repair.py`, `tests/unit/test_push_pending_marker.py`, `tests/unit/test_commit_and_push_tickets_branch_heldout.py`.\n\n### Scoping note \u2014 why this is not being landed under this ticket\n\nThis ticket is parked on a **user decision** (the MAX_PATH policy, and whether the Windows sweep should be a gate or a narrowed advisory). The class-1 fixture defect does not depend on either of those. It is being tracked as a separate bug linked `discovered_from` this one so it can land without pre-empting the decision.\n\n**Unverified:** actual Windows CI. The POSIX regression covers the structural mechanism Windows exposed \u2014 a read-only linked-worktree `gitdir:` marker rejected by direct in-place rewrite \u2014 but the Windows-side confirmation needs a run of the advisory job after the fix lands.\n","timestamp":1789925740121041843},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Triage 2026-10-25 (bug sweep): not worked, no code changed. The ticket itself says the main remedy (long-path support on the runner and in Git, versus shortening the constructed path) needs a decision, and the other classes need a Windows runner to reproduce and verify. The class-1 fix described in the earlier comment is not on main as far as this sweep checked. Left open.","timestamp":1792946038979473001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Decision recorded 2026-10-26 (user, in chat): option (1) \u2014 narrow the advisory Windows job to a maintained subset and hold that subset green. Long-path remedy: shorten the constructed paths; do not enable core.longpaths on the runner (a runner setting would hide the defect from CI while it stays live for downstream Windows users).\n\nCorrection to the 2026-10-25 triage comment: the class-1 fixture fix IS on main. tests/_topology_template.py:207 carries the gitdir-pointer guard (commits 04dd2d1e1de and 290424c8491, 2026-09-20); the work sat on other branches (investigate-6798, fix-icecold, fix-d724) and later landed. Nothing remains to land for class 1.\n\nFresh measurement. Scheduled run 40284466555, job 'sweep (windows)', ref 6080140e7af, created 2026-10-26 07:13Z, finished 09:14Z: '1652 failed, 18031 passed, 134 skipped, 1680 warnings, 39 errors in 7215.12s (2:00:15)'. Count basis: the first unindented 'short test summary info' block (nested subprocess summaries excluded); 1679 distinct node ids = 1652 FAILED + 27 ERROR, across 321 modules. Versus run 35511654149 (2026-09-20): errors fell from 1383 to 39 (class 1 cascade gone); failures stayed at about 1650.\n\nBy top-level directory (distinct ids): tests/unit 1008, tests/scripts 470 (53 modules), tests/interfaces 168, tests/integration 33. Summary-line signature counts (a row can match several): 474 rows in infra/server-script-shaped modules (observability, autodeploy, docker/journald/vartmp/container caps, user-data device resolution), 402 'Network access is forbidden' (network guard), 177 'Filename too long' (MAX_PATH), 112 UnicodeDecodeError, 48 fcntl/signal/geteuid/AF_UNIX, 11 PermissionError. Unverified: the per-signature counts only cover what the pytest summary line shows, and the 84 + 81 failures in tests/unit/test_review_bot.py and test_gate_step_tree_skew.py have not been root-caused. Nothing here was reproduced on Windows; it is CI-log analysis from macOS.","timestamp":1793030521051313001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Measured 2026-11-16, decomposition, and the change under this ticket\n\n**Current state.** The 5 scheduled `Test Suite (mirror)` runs at `b4e0d01b649` (43715434886, 43748511894, 43783350127, 43820680079, 43871224211; 2026-11-15/16) each report 877-882 failed + 43 errors (job conclusion `failure`, `continue-on-error`). Count basis: the last unindented `short test summary info` block. 909 node ids fail in all 5 runs, 918 in at least one; the 9 intermittent ones are all concurrency tests. Versus 2026-10-26 (1652 failed + 39 errors), failures roughly halved.\n\n**Classes (AC1).** Recorded in the description table: max-path 216, posix-shell 143, text-encoding 133, posix-permissions 47, path-separators 42, posix-api 28, nested-pytest-plugins 27, hardcoded-tmp 21, file-locks 19, unclassified 242 (total 918). Signature rules are regexes over each summary line's message; `bash` launches that hit the WSL launcher print UTF-16, so they are matched before the encoding rule.\n\n**PermissionError diagnosis (AC3).** The original population (2722 `PermissionError` lines, 1361 setup errors) was not file-handle lifetime: it was the read-only linked-worktree `gitdir:` pointer that `tests/_topology_template.py` rewrote in place (comment 2; fixed under icecold-rusted-fowl, on main). Today 19 tests remain in the file-locks class, with 3 distinct causes: deleting read-only git object files (`WinError 5`, a read-only attribute, not an open handle), removing a directory still in use as a cwd (`WinError 32`, handle lifetime), and concurrent writers replacing one target (`PermissionError` sharing violation; these are the 9 intermittent tests).\n\n**MAX_PATH (AC2) and scoping (AC4)** are the 2026-10-26 decisions already on this ticket: shorten constructed paths, no `core.longpaths`; narrow the job to a maintained subset held green.\n\n**Decomposition.** One bug per class, each linked `discovered_from` this ticket and owning its `.github/windows-sweep-deselect/<class>.args` file:\n- max-path: halfcrazed-rubbly-whimbrel\n- posix-shell: citreous-talented-wildebeest\n- text-encoding: obtuse-phenocryst-verdin\n- posix-permissions: almondy-columned-iguanodon (relates_to cloistered-decomposed-nymph, the ACL policy question)\n- path-separators: arctic-unsecular-esok\n- posix-api: warmish-primordial-neontetra\n- nested-pytest-plugins: injured-reclusive-tamarin\n- hardcoded-tmp: leafy-gorillian-gnat\n- file-locks: charitable-tyrannical-hydra\n- unclassified: breezy-hogged-mastiff\n\n**Change under this ticket (AC5).** The Windows suite step passes the 10 argument files (`@file`, pytest's own argparse `fromfile_prefix_chars`), deselecting exactly the 918 known ids, so the job should go green and any red is new. `tests/unit/test_windows_sweep_deselect.py` pins the files to the command on the Linux gate. All 917 `--deselect` ids match a node id collected on macOS, so none is a silent no-op.\n\nNote: epic simple-brotherly-peacock and bug unsuited-locustal-incatern (both `idea`, last touched 2026-09-08) record an earlier decision to adopt Windows as a declared support target with a gating job. The 2026-10-26 decision on this ticket (advisory, maintained subset) is the later one and is what this change implements; the class bugs above are compatible with either.","timestamp":1794857829451968751},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed Gerrit change 3402 (commit e0e55946d12, plan-review certified at b4e0d01b649). Local `make verify`: lint + typecheck green; tests 21294 passed, 3 failed, 7 errors in 3h02m at host load average ~40. None of the 10 touch the changed files. Causes read from the log: 4 errors were the repo-HEAD guard seeing this change's own commit land mid-run; 3 were `git rev-parse` 5 s timeouts under load; the AF_UNIX/forkserver failures were `PermissionError: [Errno 1]` from the agent sandbox that ran verify. All 38 tests in those 10 node ids/modules pass on rerun outside the sandbox (97 s). Waiting on Verified / LLM-Review.","timestamp":1794868242522920309},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Handoff (session 3d705fec ended before merge)\n\nThe ticket stays in_progress. Remaining work:\n1. Gerrit change 3402 (patch set 1, e0e55946d1252b76cc0740ce9b8cc6965853b8f8, hashtag rebar-session-3d705fec): waiting on LLM-Review and Verified, with neither vote cast at handoff. Submit it with `scripts/gerrit_safe_submit.py 3402 --revision <current sha>` once both votes are +1 and no comments are unresolved. Worktree: `.rebar/worktrees/win-sweep-6798` (branch win-sweep-6798).\n2. After the merge, run `gh workflow run test.yml --ref main` or wait for the next scheduled run, and confirm that `sweep (windows)` concludes `success`. That run is the evidence for AC5. If the run is red, the red tests are new regressions or intermittent tests outside the 5-run union; add them to the matching class file or file a bug for them.\n3. Tick the AC boxes. AC1 through AC4 are evidenced in the 2026-11-16 comment. Then run verify_completion_start and close with close_class `preexisting` from a worktree fast-forwarded to origin/main.\n\nThe 10 class bugs (halfcrazed-rubbly-whimbrel, citreous-talented-wildebeest, obtuse-phenocryst-verdin, almondy-columned-iguanodon, arctic-unsecular-esok, warmish-primordial-neontetra, injured-reclusive-tamarin, leafy-gorillian-gnat, charitable-tyrannical-hydra, breezy-hogged-mastiff) are open and unclaimed. Each one owns its `.github/windows-sweep-deselect/<class>.args` file. They are not prerequisites for closing this ticket, because its AC5 is met once the subset is held green.","timestamp":1794868280859004574},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Update: Verified run 43970720131 for change 3402 was not stuck. It was dispatched at 22:30:32Z. Its first two jobs finished by 22:30:43Z, and `classify Verify route from trusted main` started at 22:32:33Z after a normal runner wait. No recheck was posted. At handback both LLM-Review and Verified were still 0, so the remaining steps in the handoff comment above are unchanged.","timestamp":1794868404164881796}],"created_at":1789670571214510546,"creation_channel":"mcp","deps":[{"link_uuid":"342bc3f1-8ed7-4108-a350-1ccc281b6e3e","relation":"discovered_from","target_id":"15c8-0940-df83-46b1"},{"link_uuid":"0082626d-cb66-4cc1-8844-9f37c8596ae7","relation":"relates_to","target_id":"56fd-733e-aa7a-4ac0"}],"description":"## Context / Problem\n\n`sweep (windows)` in `.github/workflows/test.yml` is an advisory job (`continue-on-error: true`) whose stated purpose is to make Windows path, temporary-directory, Git and file-lock regressions visible. It has been red at a scale that destroys that signal: run 35250748887 (2026-09-17) reported 1626 failed + 1382 errors. A new Windows regression is indistinguishable from the standing noise.\n\nMeasured today (2026-11-16) on the 5 scheduled runs at `b4e0d01b649` (43715434886, 43748511894, 43783350127, 43820680079, 43871224211): 877-882 failed + 43 errors per run, 909 node ids failing in all 5 and 918 in at least one (9 intermittent, all concurrency tests). The class-1 cascade (read-only `gitdir:` pointer, bug d724-6bb0-2674-42a0) is fixed on main; the remaining 918 ids sort into these classes by failure signature:\n\n| Class | Tests | Modules | Signature |\n|---|---:|---:|---|\n| max-path | 216 | 30 | `SnapshotError ... Filename too long`, `WinError 206` |\n| posix-shell | 143 | 23 | `bash` resolves to WSL with no distribution, `/bin/sh`, `.sh` scripts |\n| text-encoding | 133 | 58 | `UnicodeDecodeError` reading UTF-8 files with the cp1252 default |\n| posix-permissions | 47 | 8 | `0600 or stricter` key mode, `group/world accessible` artifact dir |\n| path-separators | 42 | 21 | `\\` vs `/` in asserted paths, cross-drive `relpath` |\n| posix-api | 28 | 16 | `fcntl`/`flock`, `signal.SIGKILL`, `DETACHED_PROCESS` stubs |\n| nested-pytest-plugins | 27 | 5 | nested pytest fails loading `pytest11` / root conftest plugin |\n| hardcoded-tmp | 21 | 5 | literal `/tmp/.ticket-sync-*` paths |\n| file-locks | 19 | 15 | `WinError 5`/`32` on open handles or read-only git objects, plus the 9 intermittent concurrency tests |\n| unclassified | 242 | 100 | assertion-level failures not yet root-caused |\n\nDecisions already recorded on this ticket (2026-10-26, user): narrow the advisory job to a maintained subset and hold that subset green; for MAX_PATH, shorten rebar's constructed paths and do not enable `core.longpaths` on the runner, because a runner setting hides the defect from CI while it stays live for downstream Windows users.\n\n## Approach\n\nHold a maintained subset green by deselecting the known-failing tests through pytest argument files, one file per defect class:\n\n- `.github/windows-sweep-deselect/<class>.args`, each line `--deselect=<nodeid>` (or `--ignore=<module>` for `tests/unit/test_bridge_runner_spawn.py`, which fails at collection). pytest's argument parser reads `@file` natively (`fromfile_prefix_chars=\"@\"`), so no conftest hook, plugin, env var or config key is added.\n- The `sweep (windows)` \"Run the default suite\" step passes every file as `'@.github/windows-sweep-deselect/<class>.args'`. The job stays `continue-on-error: true` (Windows is not a gate target), so a red sweep now means a NEW Windows regression.\n- The list is the union of the 5 runs above, so the 9 intermittent tests are covered.\n- A new unit test, `tests/unit/test_windows_sweep_deselect.py`, runs on the Linux gate and pins that every file is wired into the command and nothing else is, every line is a well-formed argument (sorted, unique, ASCII, no blanks), no test sits in two classes, and every listed module still exists so a rename cannot leave a dead entry.\n- Each class becomes its own bug linked `discovered_from` this ticket. Fixing a class deletes its lines (and its file once empty), so the list only shrinks.\n\nRejected: comparing results against an enumerated baseline after the run. That needs a new junit-parsing script and CI step, and node ids are lossy in junit.\n\n## Scope\n\n- `.github/workflows/test.yml` - pass the argument files to the Windows suite step and document the maintained-subset contract in the job comment.\n- `.github/windows-sweep-deselect/*.args` (10 new files) - the per-class deselect lists.\n- `tests/unit/test_windows_sweep_deselect.py` (new) - pins the files to the command.\n\nOut of scope: fixing any class (the child bugs own that), and making the job gate.\n\n## Testing\n\n- `pytest tests/unit/test_windows_sweep_deselect.py -q` passes (13 tests). Failure cases checked by hand: adding an unreferenced `.args` file, a malformed line, and a line naming a missing module each make it fail.\n- `pytest --collect-only -m \"not integration and not external\" @.github/windows-sweep-deselect/*.args` on Linux collects without error. All 917 `--deselect` ids match a collected node id, so none is a silent no-op.\n- `make verify` green; `Verified +1` on Gerrit.\n- After merge: the next `sweep (windows)` run on main (scheduled, or `gh workflow run test.yml --ref main`) concludes `success`.\n\n## Acceptance criteria\n\n- [ ] The 1626 failures and 1382 errors are classified into named defect classes with a count per class, so the work can be scoped and split.\n- [ ] The `MAX_PATH` remedy is chosen explicitly between runner/Git long-path support and path shortening, with the tradeoff for downstream Windows consumers recorded.\n- [ ] The `PermissionError` population is diagnosed rather than assumed \u2014 confirmed as file-handle lifetime, or identified as something else.\n- [ ] A scoping decision is recorded: either Windows is supported to a readable-green standard, or the advisory job is narrowed to a maintained subset that is held green.\n- [ ] After the change, `sweep (windows)` is in a state where a NEW regression would be visible \u2014 either green, or red with a known and enumerated baseline that CI compares against.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":".github/workflows/test.yml","reason":"pass the per-class deselect argument files to the sweep (windows) suite step and document the maintained-subset contract"},{"path":".github/windows-sweep-deselect/","reason":"new per-defect-class pytest argument files listing the tests known to fail on Windows"},{"path":"tests/unit/test_windows_sweep_deselect.py","reason":"new Linux-gate test pinning the argument files to the workflow command and keeping their entries well-formed and live"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","56fd-733e-aa7a-4ac0"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f564975a-91e9-4c79-8378-979070a38d16","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"6798-606d-37dc-46e7","ticket_type":"bug","title":"Advisory sweep (windows) is red at a scale that destroys its signal: 1626 failures across five defect classes","verify_commands":[]},"source_event_uuids":["ab115f8e-7b4d-46cc-8db1-31f1e5c3cb9c","32296d3a-c33e-48c3-a5fb-c894f0961be1","aa9e8349-1dbe-4d12-83d1-9883ac9d3066","cf3bf3ea-acb2-4857-8903-bce7f53a7e9e","f564975a-91e9-4c79-8378-979070a38d16","70ab187a-fdf9-4e61-968a-53029247d222","5b735488-51a4-4e5a-b22c-2b2f79ef737d","7888b445-b42c-4f7d-92fc-70f8653ca8ef","7a9f2ffa-0940-4d3f-9cc3-4cef0fa111a1","da44a29b-219c-48a4-b057-452d294143cb","d30a3194-6351-4b1f-a9dd-41b20850bdfc","65e1d49a-7736-4312-9c00-6fe6ed0ee81e","0cdd41ca-0880-47b8-914f-60030997d1b2","0082626d-cb66-4cc1-8844-9f37c8596ae7"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794868919415597847,"uuid":"a18e1346-0f03-4427-9121-7d5229bae69a"}
