{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785974970850144014,"compiled_state":{"alias":"chilled-bereaved-equine","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"98d3436a8895d719da0f95e6e477130fd38a2d49","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 8b97-a0ca-82a4-4d4e","material: 2670cc73cad4f55c","material-part: children 647ea2107ca5072f 0","material-part: description 0570356f53a37a59 7034","material-part: file_impact 32b029e5e54edd5b 2","material-part: ticket_id 99db3f23cbf34f98 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.10.1 (98d3436a889)","regver: 368938c5729d4170","verified-at-sha:5d2ca5b676c99df7c221f45a7171b40988b51076","plan-material-pin: prerequisite fd84-92b4-01ba-4911 191dd56df5f0e0fb","dep 7cc8fe624b65841a7d16038804f689703d50a2feae88022fb48971e0d6a6c4ef src/rebar/llm/workflow/completion_recovery.py","dep 25a479cd2f23479fbb56271ca1549aa91c08ee702473eefca54ede157e2f4327 tests/unit/workflow/test_completion_token_recovery.py"],"material_fingerprint":"2670cc73cad4f55c","merged_log_commit":"5d2ca5b676c99df7c221f45a7171b40988b51076","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1785970576705159000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":1},"authorship_ledger":[{"content_hash":"c73ddc15247d65baee20749f920cebe488adc5d0ed673723303d726548d62c1d","event_uuid":"5e94da9a-56f4-4cc9-ae3c-4b2df0a94