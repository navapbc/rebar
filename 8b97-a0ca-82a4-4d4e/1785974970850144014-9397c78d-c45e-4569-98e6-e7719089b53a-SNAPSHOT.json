d.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d1a0ec15c7ef9a283ad84bc98765b7dd8cd795e791feb93b6c39e7f42f05ba76","event_uuid":"1f01e308-eeea-46de-b83a-4f2e155352cc","position":{"commit_sha":"fc7da7f5e777092c84ce268b0cedb5d3fccf1f96","position":"1785971187295125001-1f01e308-eeea-46de-b83a-4f2e155352cc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2fdf5db6de3abd229b95111acc132d8d06cf3ea0900586a2fef65255cc6bc961","event_uuid":"6ac5cfb9-4132-4bde-8148-58148e771d3c","position":{"commit_sha":"fc7da7f5e777092c84ce268b0cedb5d3fccf1f96","position":"1785971188720476001-6ac5cfb9-4132-4bde-8148-58148e771d3c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"46107817119d6a00176d36fb0c817f69852a6598f54e28485c685837c4b783e2","event_uuid":"d7b13d67-4295-4302-9e4e-22effa3dcc4e","position":{"commit_sha":"0fd94d23bdb0b4d46c1df68ebd3e835ddf1bc760","position":"1785974007115220001-d7b13d67-4295-4302-9e4e-22effa3dcc4e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation complete (commit df34119e02e, pending Gerrit review).\n\nDiscipline: held-out TDD — 4 oracle tests written and proven RED first, fixer\nimplemented blind from the contract, oracle GREEN on first contact. Mutation\nchecks: allowlist key re-stripped, merge() list handling reverted, message\nrendering dropped — each went RED; restored fix GREEN.\n\nIndependent seam review (subagent, read-only) found one residual bug IN this\nfix: the message-rendering gate required all six format_repetition fields\nnon-None, but usage_log guarantees distinct_ratio_window is None below 24 tool\ncalls — so every short-run exhaustion (e.g. token exhaustion at 10 calls)\nrecreated the computed-then-discarded defect. Fixed RED-first: ratio dropped\nfrom the gate, None rendered as n/a(<window). Second review finding (recovery\nprelude show_ticket outside the diagnostic-capturing try, in merged fd84 code)\nfiled as 215f-92ab-9780-443d, discovered_from this ticket.\n\nLive Bedrock proof (exp_i_8b97_live.py): two GENUINE UsageLimitExceeded runs on\nhaiku-4-5 driven through the real interpret_failure -> CompletionAgentStep ->\nraise_completion_workflow_failure chain:\n- LONG (26 requests, 250 tool calls, ratio 0.375): repetition line rendered\n  with real values; sidecar carries aggregate_* keys; no tool arguments leak.\n- SHORT (2 requests, 6 tool calls, ratio None BY DESIGN): line still renders\n  with n/a(<window); no literal None anywhere.\nBoth regimes PASS all checks.\n\nGates: lint clean, mypy clean, targeted 37 passed; full marker suite matches\nthe pre-existing red baseline (verifying exact file list before push).","timestamp":1785974007115220001}],"created_at":1785932640392378001,"creation_channel":"cli","deps":[{"link_uuid":"d921a3cf-1564-4ade-b947-dde6420e373f","relation":"discovered_from","target_id":"bf31-fd55-d28d-4b7a"},{"link_uuid":"9a5b3df4-122c-4cea-9073-9f86a240ae6c","relation":"relates_to","target_id":"d166-036c-238c-4b39"},{"link_uuid":"401fd8c3-ddd0-4a95-a805-59cf2267736d","relation":"depends_on","target_id":"fd84-92b4-01ba-4911"},{"link_uuid":"adae12ad-cc6d-4277-94c3-da018c8f8c8d","relation":"relates_to","target_id":"761c-729a-ce17-42b8"}],"description":"# The step-budget repetition diagnostic is computed, then dropped\n\n## Context / Problem\n\nDiscovered while root-causing [rebar:bf31-fd55-d28d-4b7a]. The reported symptom was \"the gate cannot\nbe tuned because it cannot be observed\" — no partial verdict, no count of anything, just a bare\nbudget number. The diagnostic that answers it **already exists** and is thrown away one frame from\nthe surface.\n\n`interpret_failure` (`src/rebar/llm/structured_run.py:75-103`) builds `budget_diag` via\n`usage_log.failure_usage`, which reduces every tool call to a `(tool_name, sha256(args)[:8])`\nsignature and summarizes it — `tool_calls_distinct`, `max_consecutive_repeat`,\n`top_repeated_tool_calls`. That is precisely the loop-vs-explore discriminator, and it is attached\nas `budget_err.diagnostic`.\n\nIt then goes nowhere. `emit_gate_error` is only called by `raise_completion_workflow_failure` when\n`failure_diagnostic` is truthy (`src/rebar/llm/workflow/completion_recovery.py:373-403`), and\n`failure_diagnostic` is set ONLY inside `CompletionAgentStep._recover` — which a budget exhaustion\nnever reaches (the sibling [rebar:fd84-92b4-01ba-4911] fixes reachability). So **no `gate_error_v1`\nsidecar is written** and the CLI message carries none of it. In the instrumented reproduction the\npropagated exception reached the caller with `diagnostic: null`.\n\nTwo operators burned ~50 minutes each escalating the budget 480 -> 1600 against a constraint that\nwas never a budget (and ticket 46a2-9c1a-d855-4706 records a third: 480 -> 1200, same result). The\nmeasurement that would have said so in one line was computed on the first run and discarded.\n\n## Approach\n\nWire the already-computed diagnostic through the two drops. First, `CompletionAgentStep` records the\ncaught exception's `.diagnostic` onto `self.failure_diagnostic` when it enters recovery (fd84 adds\nthe budget entry edge; this ticket makes the diagnostic it carries survive), so\n`raise_completion_workflow_failure` — whose sidecar emission and `CompletionRecoveryError` path\nalready exist and are keyed on a truthy `failure_diagnostic` — emits the `gate_error_v1` sidecar\ncarrying the repetition counters. The carry path is NOT automatic: the caught exception's\n`.diagnostic` is filtered through `_bounded_diagnostic`\n(`src/rebar/llm/workflow/completion_recovery.py`), whose `allowed` allowlist strips\n`tool_calls_distinct`, `max_consecutive_repeat`, `top_repeated_tool_calls` and\n`distinct_ratio_window` today — and whose scalar-only merge guard would drop the list-valued\n`top_repeated_tool_calls` even if allowlisted. This ticket widens that allowlist with those four\nrepetition keys and relaxes the scalar-only guard for exactly `top_repeated_tool_calls` (a bounded\nlist of `{signature, count}` dicts — hashed signatures, no prompts or arguments), so the summary\nsurvives both the recovery-exception merge and the primary-exception merge\n([rebar:fd84-92b4-01ba-4911], landed, established that carry). On the budget path the counters ride\nthe PRIMARY exception, and every primary-diagnostic key is re-prefixed `aggregate_` before landing\non `failure_diagnostic` — so the sidecar carries them as `aggregate_tool_calls_distinct`,\n`aggregate_max_consecutive_repeat`, `aggregate_top_repeated_tool_calls`,\n`aggregate_distinct_ratio_window`. `format_repetition` reads the BARE key names, so\n`raise_completion_workflow_failure` builds its render input by projecting the prefix off first —\n`{k.removeprefix(\"aggregate_\"): v for k, v in diag.items() if k.startswith(\"aggregate_\")}` — and\npasses that projection to `format_repetition`; the sidecar itself keeps the `aggregate_`-prefixed\nnames unchanged. Second, the operator-facing\nclose-gate failure message renders the distinct-vs-total counts (via the existing\n`usage_log.format_repetition` renderer, which already formats exactly these fields) so \"it looped\"\nis distinguishable from \"it ran out of room\" without reading a log. No new computation: every value\nis already produced by `usage_log.failure_usage`; this ticket widens the diagnostic filter to stop\ndropping it and renders it.\n\n## Scope\n\n- `src/rebar/llm/workflow/completion_recovery.py` — `_bounded_diagnostic`: extend the `allowed`\n  allowlist with `tool_calls_distinct`, `max_consecutive_repeat`, `top_repeated_tool_calls`,\n  `distinct_ratio_window`, and permit the list-typed `top_repeated_tool_calls` through `merge()`\n  (all other keys stay scalar-only); in `raise_completion_workflow_failure`, project the\n  `aggregate_`-prefixed keys back to bare names and render that projection through\n  `usage_log.format_repetition` into the raised message.\n- `tests/unit/workflow/test_completion_token_recovery.py` — the tests below.\n\nOut of scope: making budget exhaustion reach this code at all ([rebar:fd84-92b4-01ba-4911], landed:\nbudget exhaustions now enter `_recover` and set `failure_diagnostic`); computing the detector's new\nfield ([rebar:70bc-ab05-6d4c-45a0], landed: `failure_usage` now emits `distinct_ratio_window`).\nThis ticket carries both through the `_bounded_diagnostic` filter that currently strips them.\n\n## Testing\n\n    pytest tests/unit/workflow/test_completion_token_recovery.py -q\n\nHappy path: a budget exhaustion whose recovery also fails emits a `gate_error_v1` sidecar populated\nwith the repetition counters. Edge: a failure with NO diagnostic (the pre-existing bare path) still\nraises `LLMError` exactly as today (regression-pinned). Privacy: the sidecar payload carries no\nprompts, tool arguments, or response text.\n\n## Acceptance Criteria\n\n- [ ] a step-budget exhaustion whose recovery also fails writes a `gate_error_v1` sidecar carrying\n      the repetition summary under the `aggregate_`-prefixed names the primary-exception merge\n      produces (`aggregate_requests`, `aggregate_tool_calls`, `aggregate_tool_calls_distinct`,\n      `aggregate_max_consecutive_repeat`, `aggregate_top_repeated_tool_calls`,\n      `aggregate_distinct_ratio_window`) — i.e. the `_bounded_diagnostic` allowlist passes these\n      keys and the list-valued `top_repeated_tool_calls` survives the merge; verified by a test\n      asserting the sidecar is emitted and those keys are populated\n- [ ] the operator-facing close-gate failure message includes the distinct-vs-total tool-call counts\n      rendered from the `aggregate_`-prefix-stripped projection (so `format_repetition`'s bare-key\n      lookups resolve to the actual numbers, never `None`), making \"it looped\" distinguishable from\n      \"it ran out of room\" without reading a log; verified by a test asserting the raised error's\n      message contains the concrete counts (e.g. `30 distinct / 253 calls`), not `None`\n- [ ] the sidecar payload stays free of prompts, tool arguments and response text (the existing\n      privacy contract in `usage_log.failure_usage` is preserved); verified by a test asserting only\n      hashed signatures and counters appear\n- [ ] a failure without any diagnostic still raises the current bare `LLMError` unchanged (no\n      manufactured empty sidecar); regression-pinned by a test","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/workflow/completion_recovery.py","reason":"preserve caught exception diagnostic onto failure_diagnostic so the repetition summary reaches the close-gate message and gate_error_v1 sidecar"},{"path":"tests/unit/workflow/test_completion_token_recovery.py","reason":"tests: diagnostic surfaces in raised gate message and sidecar payload"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","fd84-92b4-01ba-4911"],["parent","9b71-55b3-1bd1-4a97"],["relates_to","761c-729a-ce17-42b8"],["relates_to","d166-036c-238c-4b39"]],"no_file_impact_reason":"","parent_id":"9b71-55b3-1bd1-4a97","parent_status_uuid":"1f01e308-eeea-46de-b83a-4f2e155352cc","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"8b97-a0ca-82a4-4d4e","ticket_type":"bug","title":"Step-budget repetition diagnostic is computed then dropped: no gate_error_v1 sidecar, no counters in the operator message","verify_commands":[]},"source_event_uuids":["5e94da9a-56f4-4cc9-ae3c-4b2df0a94d2d","d921a3cf-1564-4ade-b947-dde6420e373f","9a5b3df4-122c-4cea-9073-9f86a240ae6c","08c493f2-b72c-456f-968b-721754b6b73f","401fd8c3-ddd0-4a95-a805-59cf2267736d","d9925e31-f5d2-4a0a-ba11-83c447000fb8","a0bca758-f014-4e17-8e01-1911ed939825","e1928a5d-c246-4cc0-b9b3-03f9b9ff565a","2eacaecb-cbef-4127-a6c3-a206da45121a","5109a44a-394a-4c04-8896-b3029525fa26","7386b643-6efa-4809-8d70-afd1fc08ec8c","1f01e308-eeea-46de-b83a-4f2e155352cc","6ac5cfb9-4132-4bde-8148-58148e771d3c","d7b13d67-4295-4302-9e4e-22effa3dcc4e","adae12ad-cc6d-4277-94c3-da018c8f8c8d"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785974970850144014,"uuid":"9397c78d-c45e-4569-98e6-e7719089b53a"}