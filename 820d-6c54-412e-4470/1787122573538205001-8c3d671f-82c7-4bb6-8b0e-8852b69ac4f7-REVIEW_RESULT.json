ed consumer.","group_criteria":null,"group_id":null,"id":"f824662f61daef6db","impact":0.85,"is_primary":null,"location":"Scope: 'EDIT registry.py (OVERLAY_IDS)...'; Testing: only test_base_prompt_enumerates_exactly_the_overlay_ids named as lockstep","norm_id":"n5a56dd7a795696cd","priority":0.7556,"reason":"default-advisory","recalled":false,"scenarios":["tests/unit/test_code_review_recommend_overlays.py::test_overlay_ids_is_the_expected_closed_set — the literal set assertion fails the moment 'surface-parity' is added to OVERLAY_IDS unless this test's expected set is updated in lockstep; consequence: a red test suite not accounted for in the plan's Scope/Testing."],"severity":"critical","suggested_fix":"In Scope, list tests/unit/test_code_review_recommend_overlays.py as an EDIT (update the `assert set(reg.OVERLAY_IDS) == {...}` literal to include \"surface-parity\"), alongside the base-prompt drift test already noted.","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Add a short prior-art para