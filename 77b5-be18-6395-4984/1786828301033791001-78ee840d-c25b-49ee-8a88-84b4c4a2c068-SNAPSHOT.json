79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4b9b00b8cb4e90b827d71ba962fa032b2d7c669ef75add7940b4a8eea97e1a67","event_uuid":"04cd136e-df68-4ee9-a807-df6a4b0d6826","position":{"commit_sha":"17c32acff7f525ed1a60698ec2a0dbe71b52a11a","position":"1786823321235498001-04cd136e-df68-4ee9-a807-df6a4b0d6826"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a7f72c6cb904b17778c3de7c0f545cfbc9004a3e8872c0ba11ee88d7d19cdedb","event_uuid":"60858d59-97e1-4a23-af1e-8f1aa7957df2","position":{"commit_sha":"9521188eeebdadbf33469de5d87d0f3bfc142fb6","position":"1786823327854082001-60858d59-97e1-4a23-af1e-8f1aa7957df2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix implemented and pushed: Gerrit change 1803 (https://rebar.solutions.navateam.com/c/rebar/+/1803), commit 287505d4ff.\n\n**Change**: replaced the bare substring assertion in test_notice_names_pandoc_its_version_and_its_licence with a module-level scheme+host-anchored regex:\n\n    _UPSTREAM_RE = re.compile(\n        r\"https?://(www\\.)?pandoc\\.org(?![\\w.-])|https?://github\\.com/jgm/pandoc(?![\\w-])\"\n    )\n    assert _UPSTREAM_RE.search(text), (...)\n\n**RED demonstration** (executed): the old expression accepted both https://notpandoc.org (prefix lookalike) and https://pandoc.org.evil.com (suffix lookalike — the case \\b would still pass, per the plan-review blocker); the anchored regex rejects both plus a schemeless bare 'pandoc.org' mention, and still accepts the real NOTICE (all 4 tests in the file pass).\n\n**Sibling sweep**: alert #88 is the ONLY open code-scanning alert repo-wide (gh api confirmed). Grep for URL/hostname substring-in checks found no other same-class occurrences: remaining matches are scheme-anchored full-URL literals (test_release_workflow_pins, test_ci_tickets_partial_clone_workflows, test_canary_bridge), error-message assertions on example.com addresses, or doc-content mentions (test_harness_shims checks 'developers.openai.com/codex' appears in a docs string — not a URL-sanitization pattern, unflagged by CodeQL, left alone). No new tickets needed.\n\n**Gates**: pytest tests/unit/test_notice_records_pandoc_gpl.py — 4 passed; make lint — pass; make typecheck — pass (543 files, no issues). Version pins and NOTICE content untouched (diff is 10+/2- in the one test file).\n\nAwaiting LLM-Review +1 and Verified +1 on change 1803; ticket stays in_progress until the change merges.","timestamp":1786765459867008001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Merged as Gerrit 1803 (588d7df0bd, auto-submitted by the overnight driver on LLM-Review +1 / Verified +1). Lookahead-anchored regex replaces the substring check; RED demo vs pandoc.org.evil.com passed. Alert #88 still shows open on GitHub — code-scanning re-analysis runs on the default-branch mirror sync; expected to auto-close on the next scan.","timestamp":1786774826342017001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"CodeQL alert #88 verification (2026-08-15 12:25 PT): `gh api repos/navapbc/rebar/code-scanning/alerts/88 --jq .state` returns **fixed** — cleared by re-analysis after the merged fix, NOT dismissed. This supersedes the earlier comment noting the alert still showed open (default-branch re-analysis had not yet run). Final AC satisfied; evidence lives in GitHub code-scanning, outside the repo, hence operator-attested.","timestamp":1786822482325107001}],"created_at":1786764018561903001,"creation_channel":"cli","deps":[{"link_uuid":"a29cfc84-d16f-4e1c-8ac0-b62a3905994a","relation":"relates_to","target_id":"9b36-5859-19e7-4f03"},{"link_uuid":"60858d59-97e1-4a23-af1e-8f1aa7957df2","relation":"caused_by","target_id":"5c0e-e25f-b14e-4aba"}],"description":"## Context / Problem\nGitHub code-scanning alert #88 (`py/incomplete-url-substring-sanitization`, Security/quality) flags the upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` in `tests/unit/test_notice_records_pandoc_gpl.py` (currently line 51):\n\n```python\nassert \"pandoc.org\" in text or \"github.com/jgm/pandoc\" in text, (...)\n```\n\nThis is not real URL sanitization — there is no untrusted input; the test checks that NOTICE mentions upstream so the GPL source-availability obligation is actionable. But the finding is still worth fixing: bare substring containment accepts a NOTICE that only contains a lookalike host — prefix-style (`https://notpandoc.org`) or suffix-style (`https://pandoc.org.evil.com`) — which does NOT actionably point at upstream. The same rule class was fixed before in `test_llm_fallback_chain.py` (ticket revealable-ungracious-billygoat, alerts 81/82) with parsed-origin netloc equality.\n\n## Approach\nReplace the two substring checks with a single scheme+host-anchored regex whose host ends with an explicit end-of-host boundary (a negative lookahead), so BOTH lookalike classes are rejected:\n\n```python\n_UPSTREAM_RE = re.compile(\n    r\"https?://(www\\.)?pandoc\\.org(?![\\w.-])|https?://github\\.com/jgm/pandoc(?![\\w-])\"\n)\nassert _UPSTREAM_RE.search(text), (...)\n```\n\n`(?![\\w.-])` after `pandoc\\.org` refuses to end the host before a dot, letter, digit, or hyphen, so `https://pandoc.org.evil.com` is rejected (unlike a `\\b` anchor, which matches before a literal dot) while `https://pandoc.org`, `https://pandoc.org/`, and `http://www.pandoc.org` all match. `(?![\\w-])` after the github path rejects `https://github.com/jgm/pandoc-extras` (a different repo) while allowing a trailing `/`, whitespace, or end of text. This handles arbitrary subdomain sequences per the CodeQL guidance, matching the strictness of the parsed-origin prior art without urlparse machinery — appropriate because the subject is a whole document, not a single URL to validate. Alternative weighed: extracting every URL from NOTICE and comparing parsed netlocs exactly, as `test_llm_fallback_chain.py` does — rejected as over-engineering for a one-line document-content assertion; the lookahead-anchored regex achieves the same rejection set here.\n\nRED-first demonstration (already executed): the old expression accepts both `https://notpandoc.org.evil.com` (prefix) and `https://pandoc.org.evil.com` (suffix); the anchored regex rejects both and still accepts the real NOTICE.\n\n## Scope\n- `tests/unit/test_notice_records_pandoc_gpl.py` — only the upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` (plus the module-level compiled regex it uses). Do NOT touch the pandoc version pin strings or NOTICE content (a parallel agent is bumping pypandoc-binary in the same file; anchoring the change to the assertion, not a line number, keeps the two changes rebase-clean).\n\nSibling sweep (already executed): alert #88 is the only open code-scanning alert repo-wide; grep for URL/hostname substring-`in` checks found no other same-class occurrences in scope (remaining matches are scheme-anchored full-URL literals or error-message assertions).\n\n## Testing\nTest-only change. Happy path: `pytest tests/unit/test_notice_records_pandoc_gpl.py -x -q` stays green against the real NOTICE. Failure path: the RED demonstration shows the anchored regex rejects `https://pandoc.org.evil.com`, `https://notpandoc.org`, and a bare schemeless `pandoc.org` mention, all of which (except the last two prefix forms partially) satisfied the old expression.\n\n## Acceptance Criteria\n- [x] The upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` no longer uses bare substring containment; it matches via a scheme+host-anchored regex with an explicit end-of-host boundary. Verify: read the diff.\n- [x] The new assertion rejects a suffix-style lookalike: `_UPSTREAM_RE.search(\"https://pandoc.org.evil.com\")` is None. Verify: run the expression in Python.\n- [x] The new assertion rejects a prefix-style lookalike: `_UPSTREAM_RE.search(\"https://notpandoc.org\")` is None. Verify: run the expression in Python.\n- [x] The new assertion accepts the real NOTICE, preserving the test's intent that NOTICE actionably points at upstream. Verify: `pytest tests/unit/test_notice_records_pandoc_gpl.py -x -q` passes.\n- [x] The diff touches only the upstream-URL assertion and its supporting regex; version pins and NOTICE content are unchanged. Verify: read the diff.\n- [x] `make lint` passes. Verify: run it.\n- [x] `make typecheck` passes. Verify: run it.\n- [x] The change is pushed to Gerrit for review. Verify: a Gerrit change exists for the commit.\n- [x] [operator-attested] After the fix lands and CodeQL re-runs, alert #88 clears without dismissal. Verify: `gh api repos/navapbc/rebar/code-scanning/alerts` shows no open alert #88.\n  provenance: environment=github.com/navapbc/rebar code-scanning (live GitHub API); principal=operator session via authenticated gh CLI; privilege_posture=production-equivalent; instrument=live-call — `gh api repos/navapbc/rebar/code-scanning/alerts/88 --jq .state` returned \"fixed\" on 2026-08-15 12:25 PT: cleared by default-branch re-analysis after the merged fix, not dismissed.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_notice_records_pandoc_gpl.py","reason":"anchor the upstream-URL assertion (host-anchored regex) to clear code-scanning alert #88"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","9b36-5859-19e7-4f03"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ba4a6937-128e-431d-b8d7-02734f80e730","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"77b5-be18-6395-4984","ticket_type":"bug","title":"code-scanning #88: anchor upstream-URL assertions in NOTICE test (incomplete URL substring sanitization)","verify_commands":[]},"source_event_uuids":["d070c92f-9840-4eb2-a8e0-95bac108870f","d9c3d705-53bf-44e5-895c-00e230717cd7","26f2e935-f7e9-4490-9940-8cd18f089821","dd8a55e1-8575-4aaf-8b28-5c95c8787ddb","578ffa86-f1b0-456b-a640-e7f4abe35fa7","241aeb0b-4945-47c3-9556-155f6e792db4","f73e1130-9eeb-40f3-b52b-764a77c37a7c","1c8b33a4-f08a-4651-87fb-6e40000ff17b","ba4a6937-128e-431d-b8d7-02734f80e730","04cd136e-df68-4ee9-a807-df6a4b0d6826","60858d59-97e1-4a23-af1e-8f1aa7957df2"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786828301033791001,"uuid":"78ee840d-c25b-49ee-8a88-84b4c4a2c068"}