ip.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d4b84c61630762232e582c126b491eb96813634dcea17eca4c3bf2d20a3cbca6","event_uuid":"7290dd47-bdc8-4083-80ea-972948e9b4a9","position":{"commit_sha":"501299f028e9f14a903e91526e173a404eb9d808","position":"1786765318081831001-7290dd47-bdc8-4083-80ea-972948e9b4a9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d691489d43491bfe446a1a2b8fb8b7c11c1b3fbedd9a026aa7ec7cd2dff3dfce","event_uuid":"d8f9a051-3eb6-4f98-8794-25b579dc4ea3","position":{"commit_sha":"501299f028e9f14a903e91526e173a404eb9d808","position":"1786765319127500001-d8f9a051-3eb6-4f98-8794-25b579dc4ea3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3e6ff44ab677109137627bce85a28fbe08e7e3f5075ec124ce0d69c99ad1da98","event_uuid":"d155764a-f49e-436c-b792-7a574769c6f6","position":{"commit_sha":"ac4257229cf5853cdd96443b58e2c979f3d9dbfe","position":"1786765459867008001-d155764a-f49e-436c-b792-7a574769c6f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"40a5d564af563f9567d50ddcb69b75c39ee61b4ee5637b90e3af10f55c34df1f","event_uuid":"a29cfc84-d16f-4e1c-8ac0-b62a3905994a","position":{"commit_sha":"f1cde66a97176a27c69f0647340c374015e48a33","position":"1786765662750199482-a29cfc84-d16f-4e1c-8ac0-b62a3905994a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix implemented and pushed: Gerrit change 1803 (https://rebar.solutions.navateam.com/c/rebar/+/1803), commit 287505d4ff.\n\n**Change**: replaced the bare substring assertion in test_notice_names_pandoc_its_version_and_its_licence with a module-level scheme+host-anchored regex:\n\n    _UPSTREAM_RE = re.compile(\n        r\"https?://(www\\.)?pandoc\\.org(?![\\w.-])|https?://github\\.com/jgm/pandoc(?![\\w-])\"\n    )\n    assert _UPSTREAM_RE.search(text), (...)\n\n**RED demonstration** (executed): the old expression accepted both https://notpandoc.org (prefix lookalike) and https://pandoc.org.evil.com (suffix lookalike — the case \\b would still pass, per the plan-review blocker); the anchored regex rejects both plus a schemeless bare 'pandoc.org' mention, and still accepts the real NOTICE (all 4 tests in the file pass).\n\n**Sibling sweep**: alert #88 is the ONLY open code-scanning alert repo-wide (gh api confirmed). Grep for URL/hostname substring-in checks found no other same-class occurrences: remaining matches are scheme-anchored full-URL literals (test_release_workflow_pins, test_ci_tickets_partial_clone_workflows, test_canary_bridge), error-message assertions on example.com addresses, or doc-content mentions (test_harness_shims checks 'developers.openai.com/codex' appears in a docs string — not a URL-sanitization pattern, unflagged by CodeQL, left alone). No new tickets needed.\n\n**Gates**: pytest tests/unit/test_notice_records_pandoc_gpl.py — 4 passed; make lint — pass; make typecheck — pass (543 files, no issues). Version pins and NOTICE content untouched (diff is 10+/2- in the one test file).\n\nAwaiting LLM-Review +1 and Verified +1 on change 1803; ticket stays in_progress until the change merges.","timestamp":1786765459867008001}],"created_at":1786764018561903001,"creation_channel":"cli","deps":[{"link_uuid":"a29cfc84-d16f-4e1c-8ac0-b62a3905994a","relation":"relates_to","target_id":"9b36-5859-19e7-4f03"}],"description":"## Context / Problem\nGitHub code-scanning alert #88 (`py/incomplete-url-substring-sanitization`, Security/quality) flags the upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` in `tests/unit/test_notice_records_pandoc_gpl.py` (currently line 51):\n\n```python\nassert \"pandoc.org\" in text or \"github.com/jgm/pandoc\" in text, (...)\n```\n\nThis is not real URL sanitization — there is no untrusted input; the test checks that NOTICE mentions upstream so the GPL source-availability obligation is actionable. But the finding is still worth fixing: bare substring containment accepts a NOTICE that only contains a lookalike host — prefix-style (`https://notpandoc.org`) or suffix-style (`https://pandoc.org.evil.com`) — which does NOT actionably point at upstream. The same rule class was fixed before in `test_llm_fallback_chain.py` (ticket revealable-ungracious-billygoat, alerts 81/82) with parsed-origin netloc equality.\n\n## Approach\nReplace the two substring checks with a single scheme+host-anchored regex whose host ends with an explicit end-of-host boundary (a negative lookahead), so BOTH lookalike classes are rejected:\n\n```python\n_UPSTREAM_RE = re.compile(\n    r\"https?://(www\\.)?pandoc\\.org(?![\\w.-])|https?://github\\.com/jgm/pandoc(?![\\w-])\"\n)\nassert _UPSTREAM_RE.search(text), (...)\n```\n\n`(?![\\w.-])` after `pandoc\\.org` refuses to end the host before a dot, letter, digit, or hyphen, so `https://pandoc.org.evil.com` is rejected (unlike a `\\b` anchor, which matches before a literal dot) while `https://pandoc.org`, `https://pandoc.org/`, and `http://www.pandoc.org` all match. `(?![\\w-])` after the github path rejects `https://github.com/jgm/pandoc-extras` (a different repo) while allowing a trailing `/`, whitespace, or end of text. This handles arbitrary subdomain sequences per the CodeQL guidance, matching the strictness of the parsed-origin prior art without urlparse machinery — appropriate because the subject is a whole document, not a single URL to validate. Alternative weighed: extracting every URL from NOTICE and comparing parsed netlocs exactly, as `test_llm_fallback_chain.py` does — rejected as over-engineering for a one-line document-content assertion; the lookahead-anchored regex achieves the same rejection set here.\n\nRED-first demonstration (already executed): the old expression accepts both `https://notpandoc.org.evil.com` (prefix) and `https://pandoc.org.evil.com` (suffix); the anchored regex rejects both and still accepts the real NOTICE.\n\n## Scope\n- `tests/unit/test_notice_records_pandoc_gpl.py` — only the upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` (plus the module-level compiled regex it uses). Do NOT touch the pandoc version pin strings or NOTICE content (a parallel agent is bumping pypandoc-binary in the same file; anchoring the change to the assertion, not a line number, keeps the two changes rebase-clean).\n\nSibling sweep (already executed): alert #88 is the only open code-scanning alert repo-wide; grep for URL/hostname substring-`in` checks found no other same-class occurrences in scope (remaining matches are scheme-anchored full-URL literals or error-message assertions).\n\n## Testing\nTest-only change. Happy path: `pytest tests/unit/test_notice_records_pandoc_gpl.py -x -q` stays green against the real NOTICE. Failure path: the RED demonstration shows the anchored regex rejects `https://pandoc.org.evil.com`, `https://notpandoc.org`, and a bare schemeless `pandoc.org` mention, all of which (except the last two prefix forms partially) satisfied the old expression.\n\n## Acceptance Criteria\n- [ ] The upstream-URL assertion in `test_notice_names_pandoc_its_version_and_its_licence` no longer uses bare substring containment; it matches via a scheme+host-anchored regex with an explicit end-of-host boundary. Verify: read the diff.\n- [ ] The new assertion rejects a suffix-style lookalike: `_UPSTREAM_RE.search(\"https://pandoc.org.evil.com\")` is None. Verify: run the expression in Python.\n- [ ] The new assertion rejects a prefix-style lookalike: `_UPSTREAM_RE.search(\"https://notpandoc.org\")` is None. Verify: run the expression in Python.\n- [ ] The new assertion accepts the real NOTICE, preserving the test's intent that NOTICE actionably points at upstream. Verify: `pytest tests/unit/test_notice_records_pandoc_gpl.py -x -q` passes.\n- [ ] The diff touches only the upstream-URL assertion and its supporting regex; version pins and NOTICE content are unchanged. Verify: read the diff.\n- [ ] `make lint` passes. Verify: run it.\n- [ ] `make typecheck` passes. Verify: run it.\n- [ ] The change is pushed to Gerrit for review. Verify: a Gerrit change exists for the commit.\n- [ ] After the fix lands and CodeQL re-runs, alert #88 clears without dismissal. Verify: `gh api repos/navapbc/rebar/code-scanning/alerts` shows no open alert #88.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_notice_records_pandoc_gpl.py","reason":"anchor the upstream-URL assertion (host-anchored regex) to clear code-scanning alert #88"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","9b36-5859-19e7-4f03"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"7290dd47-bdc8-4083-80ea-972948e9b4a9","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"77b5-be18-6395-4984","ticket_type":"bug","title":"code-scanning #88: anchor upstream-URL assertions in NOTICE test (incomplete URL substring sanitization)","verify_commands":[]},"source_event_uuids":["bb25ffe9-725a-4025-aac3-9b216186e95c","8330a872-7cb3-499f-a0e4-f2249bdeae01","cf03e87f-8ae1-4908-a66f-e08f32727a0c","25aa96d3-69bf-43af-ac4d-253c57e2f9f6","7290dd47-bdc8-4083-80ea-972948e9b4a9","d8f9a051-3eb6-4f98-8794-25b579dc4ea3","d155764a-f49e-436c-b792-7a574769c6f6","a29cfc84-d16f-4e1c-8ac0-b62a3905994a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786772515362095001,"uuid":"8850a2eb-786d-4541-8883-247d2a7cad33"}