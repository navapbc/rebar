{"author":"Unknown","author_email":"","data":{"content_hash":"873fe93dcfdbf936ba6e6930a199e00355d4daaa659a2269475786c0c4197289","digest":{"component_or_area":"test suite refactoring (applier, fs_tools, overlap retrieval, code review reconciliation)","key_entities":["test_applier_exceptions.py","test_applier_reschedule.py","test_fs_tools_extraction.py","test_overlap_retrieve.py","test_code_review_artifact.py","DirectionMismatchError","UnknownActionError","StatusMappingError","EXIT_RESCHEDULE","_FIELD_WEIGHTS","code_review","fs_tools._safe_path","outbound_differ.compute_outbound_mutations"],"problem_keywords":["test anti-pattern","hasattr existence test","behavioral provocation","test coverage","observable behavior"],"propositions":["Tests using hasattr or constant equality checks do not exercise actual error-raising code paths and can pass while behavior is broken.","Exception classes must be raised by triggering their actual failure paths, not by verifying existence via hasattr.","EXIT_RESCHEDULE and _FIELD_WEIGHTS must be validated through observable runtime behavior (return values, ranking effects) rather than constant value assertions.","Code review Jira exclusion must be proven by running reconciliation and observing mutation output, not by grepping source for symbol presence.","Shared utility identity (fs_tools._safe_path reuse) must be proven via reference equality, not via existence checks."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1785817564338808741,"uuid":"15f7219b-02de-410d-b339-9115016dfb33"}