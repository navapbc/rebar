.0,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":2307.6,"llm_calls":1,"output_tokens":98.0,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":60710.0,"llm_calls":1,"output_tokens":2003.0,"requests":5}}}},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State the page-cap value and the cap-exhaustion disposition (raise TransportUnavailableError vs. treat collected keys as complete) and add an AC exercising the cap-hit branch.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5d","T5e","T6","T9"],"criteria":["E2","T5b"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["'a hard page cap (guard against a server that never sets isLast)' — cap value and cap-hit disposition unstated","No AC exercises the cap-exhaustion branch; the six ACs cover isLast/empty-page/multi-page but not cap-hit"],"finding":"The pagination 'hard page cap' guard is specified but its exhaustion behavior is undefined: when the cap is reached without seeing isLast, the plan does not state whether the probe treats the collected key set as authoritative (risking a false ProjectVisibilityError for a required key on an un-fetched page) or raises TransportUnavailableError.","group_criteria":null,"group_id":null,"id":"f702d522f4e1895af","impact":1.0,"is_primary":null,"location":"Approach — 'Pagination terminates on isLast, an empty values page, or a hard page cap'","norm_id":"n4cf20fe923a8a327","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A Jira Cloud instance with many projects and a server that never sets isLast: the probe stops at the cap and a legitimately-visible required key that lives on a later page is reported as missing, aborting a valid pass"],"severity":"critical","suggested_fix":"Specify: on cap exhaustion without isLast, raise TransportUnavailableError (fail-closed, do not conclude a key is missing), and add a test that a never-isLast server hitting the cap yields TransportUnavailableError.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"missing_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Reconcile the retry mechanism with `_direct_rest_get`'s actual error semantics: `_rest_urlopen_with_retry` already retries TimeoutError/ConnectionError and raises HTTPError (incl. 401/403) without retry — specify which exception types map to TransportUnavailableError (fail-closed) vs a reachable-but-not-listing outcome, and whether any additional retry beyond the inner transport layer is intended (JQL_RETRY_COUNT is an empty-results loop, not a transport-error loop).","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["Plan: 'a retryable transport error is retried up to JQL_RETRY_COUNT with the _retry_sleep backoff; if still unreachable it raises a distinct TransportUnavailableError'","access_check.py:119-127 — the JQL_RETRY_COUNT loop retries on EMPTY search results (`if results: break`), not on transport exceptions; _retry_sleep is only the sleeper indirection (access_check.py:40-52)","acli_rest.py:57-83 — _rest_urlopen_with_retry already retries TimeoutError/ConnectionError (3 attempts) and re-raises HTTPError (4xx/5xx) deterministically; _direct_rest_get (acli_rest.py:228) goes through it"],"finding":"The plan states it reuses access_check's retry helper (`_retry_sleep` / `JQL_RETRY_COUNT`) to retry a retryable transport error, but that helper is the JQL empty-results consistency-retry loop (access_check.py:119-127), not a transport-error retry; meanwhile the reused `_direct_rest_get` already performs its own transport retry (`_rest_urlopen_with_retry`, acli_rest.py:57-83: 3 attempts over TimeoutError/ConnectionError, with HTTPError including 401/403 raised deterministically without retry). Layering JQL_RETRY_COUNT over `_direct_rest_get` either double-retries transient errors or misapplies a search-consistency helper to transport failures, and a hard auth error would raise from the inner layer immediately rather than after JQL_RETRY_COUNT attempts.","group_criteria":null,"group_id":null,"id":"faed74d3897b214b0","impact":1.0,"is_primary":null,"location":"Approach — 'Retry vs hard fail' paragraph","norm_id":"ne61565f5da61085e","priority":0.8,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Backend times out mid-probe: inner _direct_rest_get already retried 3x, then plan's outer JQL_RETRY_COUNT retries again — compounded delay","Bot lacks credentials/permission (401/403): _direct_rest_get raises HTTPError with no retry; plan's stated 'retried up to JQL_RETRY_COUNT' never happens for this case"],"severity":"critical","suggested_fix":"Classify by exception at the probe layer: treat HTTPError 401/403/5xx and TimeoutError/ConnectionError (after the inner _rest_urlopen_with_retry exhausts) as TransportUnavailableError (fail-closed); rely on the inner transport retry rather than re-wrapping the JQL empty-results loop. If any outer retry is wanted, define its own small transport-error retry rather than reusing JQL_RETRY_COUNT/_retry_sleep whose semantics are search-consistency, not transport.","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Verify GET /rest/api/3/project/search's real response envelope (values[].key, isLast) and pagination against the Jira Cloud REST docs (or a staging probe) before committing, and record the evidence class — or route this new endpoint surface to a SPIKE.","cohort":["T3"],"criteria":["T3"],"decision":"advisory","decision_margin":-0.9,"drop_reason":null,"evidence":["search_files for 'project/search' returns zero hits in src/ — the endpoint is not currently used anywhere in the codebase, so it is a NEW integration surface under T3's endpoint-granularity axis","The codebase's other v3 endpoints use /rest/api/3/issue/..., /rest/api/3/user/..., etc. — project/search is unprecedented here","Plan: 'the real envelope/pagination is unit-tested against the documented Jira Cloud shape, live ve