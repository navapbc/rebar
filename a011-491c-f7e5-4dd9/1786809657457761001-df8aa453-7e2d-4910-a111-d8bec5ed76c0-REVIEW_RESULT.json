p_id":null,"id":"f978b74619d6b818d","impact":1.0,"is_primary":null,"location":"Approach paragraph: 'The probe reuses access_check.py's existing AcliClient transport ... calls _direct_rest_get ... against GET /rest/api/3/project/search'","norm_id":"ncfee6690ee859428","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A deployment configured with reconciler.backend = 'jira-datacenter' runs a live (non-read-only) reconcile pass"],"severity":"critical","suggested_fix":"Prefer a small addition to the Backend port (e.g. a `visible_project_keys()` capability) implemented by both adapters, and drive the preflight through select_backend(load_config()).transport rather than access_check.py's Cloud AcliClient; if DC support is genuinely out of scope, say so and gate the preflight on the selected backend's vendor.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Verify the /rest/api/3/project/search endpoint surface against Jira Cloud REST docs (cite the r