{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786823354725505001,"compiled_state":{"alias":"archetypal-curvy-piranha","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"53efe2426edbb7ba7f1766668393b9d8d007185d","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: a011-491c-f7e5-4dd9","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.11.0 (53efe2426e)","material: 49db7ce52300f1d7","verified-at-sha:53efe2426edbb7ba7f1766668393b9d8d007185d"],"material_fingerprint":"49db7ce52300f1d7","merged_log_commit":"53efe2426edbb7ba7f1766668393b9d8d007185d","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786821056205358000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"53efe2426edbb7ba7f1766668393b9d8d007185d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: a011-491c-f7e5-4dd9","material: 49db7ce52300f1d7","material-part: children 647ea2107ca5072f 0","material-part: description 47fb20f39106e60d 7720","material-part: description_boxes b7fb217694ae2d30 6","material-part: file_impact 43adfc3849fec3e5 5","material-part: ticket_id 06a4e05d2bc6c092 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: execution","priority-floor: 0.80","rebar-version: 0.11.0 (53efe2426e)","regver: 4f90349cd81c4911","verified-at-sha:53efe2426edbb7ba7f1766668393b9d8d007185d","dep b80fd8e33a71971fd31ead8581392217a30512e78c2d8c24f6f9b6ff537d823b src/rebar/_engine/rebar_reconciler/__main__.py","dep 320f7f0848ea9b0252745bd23a139726c65eebdb7b7c1569aa5f11babf34953d src/rebar/_engine/rebar_reconciler/_preflight.py","dep 5a9ed680613f576de521cb04ececd4f9bd0edf52a362664f49b1fce885ba3861 src/rebar/_engine/rebar_reconciler/access_check.py","dep b0b3e5fd0cc7ccc51fe7b3b0d6fd12f7ebd9c0d853fd3d2b0c2d1431febf43fa tests/unit/rebar_reconciler/orchestrate/test_main_entry.py","dep 33c897b273879830e806ab4f8c367b2e3d2c911e4d8c992fe53e71fcc8ec04b4 tests/unit/rebar_reconciler/test_preflight_project_visibility.py","read-set: 8","read-path: src/rebar/_engine/rebar_reconciler/__main__.py","read-path: src/rebar/_engine/rebar_reconciler/_preflight.py","read-path: src/rebar/_engine/rebar_reconciler/access_check.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_rest.py","read-path: src/rebar/_engine/rebar_reconciler/applier.py","read-path: src/rebar/_engine/rebar_reconciler/fetcher.py","read-path: src/rebar/_engine/rebar_reconciler/projects_store.py","read-path: tests/unit/rebar_reconciler/test_preflight_project_visibility.py","currency-basis: file_impact"],"material_fingerprint":"49db7ce52300f1d7","merged_log_commit":"53efe2426edbb7ba7f1766668393b9d8d007185d","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786820388569556000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":21,"unsigned":0},"authorship_ledger":[{"content_hash":"6ca088433f05bbc0424bc0ec80f59157814019829e3a1e77d12a01c2d0f35a5d","event_uuid":"3a3bf81d-3d11-455b-96b3-f7601d80baf6","position":{"commit_sha":"f15e27b313646fed02536b18db7979fc6f660de8","position":"1786814819877727001-3a3bf81d-3d11-455b-96b3-f7601d80baf6"},"si