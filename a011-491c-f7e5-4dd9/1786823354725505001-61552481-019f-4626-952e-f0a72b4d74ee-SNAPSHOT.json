NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a6509b1e8344a942142ece027bf266fbf3a0eeb2615b532945f87aa0551b0982","event_uuid":"8190a1d3-115d-411e-a594-0d1052af0442","position":{"commit_sha":"bcd276276ef62cad4e02ebdfcec24af1d301f589","position":"1786821051239102001-8190a1d3-115d-411e-a594-0d1052af0442"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ec34511c9d8dbc4db6d11dfd33366f8b47d867b9068e5ead60bd371bf4fb2b3f","event_uuid":"d697543a-812c-4170-9397-a422279ea783","position":{"commit_sha":"400b61eb1cae3d93b435b018077b421dd73174c4","position":"1786821056205919001-d697543a-812c-4170-9397-a422279ea783"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed to Gerrit for review: https://rebar.solutions.navateam.com/c/rebar/+/1816 (commit fc4c90dcac).\n\nImplemented the reconcile-pass project-visibility preflight:\n- access_check.py: reusable single source of truth (also for ticket 9702) — check_mapped_project_visibility(repo_root, *, probe=None, client_cls=AcliClient, env=None, query_project=None, projects_store_mod=None) -> ProjectVisibilityResult(status, required, visible, missing, detail); status in ok/missing/transport_unavailable/skipped. enforce_mapped_project_visibility(**kwargs) is the raising wrapper (ProjectVisibilityError on missing, TransportUnavailableError fail-closed). Probes GET /rest/api/3/project/search via AcliClient._direct_rest_get (built-in retry, no hand-rolled loop); pagination fails closed on page-cap exhaustion.\n- _preflight.py: reconcile-pass gating (mutating passes only; configured Cloud backend only; observable skip otherwise), maps verdict -> PreflightAbort.\n- __main__.run_pass_result: calls the preflight strictly before reconcile_once (only outbound-mutation call). Missing/invisible key or unreachable backend aborts with an actionable message naming offending key(s); no Jira write. Never crashes the pass.\n\nRED->GREEN: 16 new tests in tests/unit/rebar_reconciler/test_preflight_project_visibility.py with an injected fake probe (no live Jira). Teeth proven via mutation: (1) forcing status='ok' -> 3 tests fail; (2) disabling the wiring abort -> 2 wiring tests fail. Gates: make lint PASS, make typecheck PASS, complexity baseline new=0 increased=0 stale=0, __main__.py 778 LOC (<800), cc77 transport-typing guard PASS. Rebased onto origin/main 11d5994594.\n\nLeaving ticket open pending Verified +1 / LLM-Review +1.","timestamp":1786816719516499001}],"created_at":1786807640698988001,"creation_channel":"cli","deps":[{"link_uuid":"5c3b9e92-b373-4702-bd2c-6a2747691b24","relation":"discovered_from","target_id":"05b8-4efe-8d58-4c27"},{"link_uuid":"4b57c776-211b-4792-80d9-ebe69a814330","relation":"relates_to","target_id":"428a-c414-b944-4584"}],"description":"## Problem\nNothing validates, before a reconcile pass mutates a live client Jira, that the mapped\nprojects EXIST / are visible to the bridge bot. Two live-only failure modes:\n1. A mapped-but-nonexistent (decommissioned / permission-lost) project key is syntactically\n   valid, so `_validate_project_key` passes; the failure only surfaces deep in fan-out as an\n   ACLI error. This is exactly the `05b8-4efe-8d58-4c27` incident class.\n2. `resolve_project` (projects_store.py) returns `mapping.legacy_default` VERBATIM,\n   unvalidated. Every unbound/legacy ticket (absent bridge_project) resolves there. The\n   cross-project write guard's allowed set = `read_projects().keys()` and EXCLUDES creates\n   (applier.py `_cross_project_targets`), so a legacy_default pointing at a real-but-wrong\n   (or nonexistent) project drives a mass CREATE storm into the wrong place, unguarded.\n\n## Approach\nAdd a reconcile-pass PREFLIGHT that runs BEFORE any outbound mutation and validates every\nproject the pass could touch is visible to the configured backend.\n\nRequired-key set (single source of truth, mirrors the fetcher fan-out at fetcher.py:540 so it\nvalidates exactly what fan-out queries): `read_projects(repo_root).keys()`; when that mapping\nis EMPTY the fetcher falls back to the single configured backend `query_project`\n(`[_query_project]`) — the exact green-state incident shape `{legacy_default:'REB',\nprojects:{}}` — so the preflight INCLUDES that fallback `query_project` when `projects` is\nempty. PLUS `legacy_default` (when non-empty), since `resolve_project` sends every\nunbound/legacy create there. Empty-and-no-fallback → nothing to check (never probes).\n\nProbe transport: reuse `access_check.py`'s existing `AcliClient` transport. Enumerate\nbot-visible keys through the client's ALREADY-PRESENT generic REST accessor\n`AcliClient._direct_rest_get` (acli_rest.py:207 — used by `get_issue_property`,\n`transition_issue`, `validate_assignee_exists`) against the standard Jira Cloud\n\"Get projects paginated\" endpoint `GET /rest/api/3/project/search`. That endpoint returns a\nPageBean (`values[]` / `startAt` / `maxResults` / `total` / `isLast`), NOT the token-cursor\nenhanced-search shape; the loop advances `startAt` by the page size and terminates on\n`isLast`, an empty `values` page, or `startAt >= total`. A hard page cap guards a server that\nnever terminates; if the cap is hit WITHOUT a clean termination the probe FAILS CLOSED\n(raises `TransportUnavailableError`) rather than treating the partial key set as\nauthoritative (a partial set could yield a FALSE project-not-visible). No new transport class\nor subprocess.\n\nRetry vs hard fail: `_direct_rest_get` ALREADY retries transient transport faults itself\n(acli_rest.py `_rest_urlopen_with_retry`: 3 attempts over TimeoutError/ConnectionError) and\nraises `HTTPError` deterministically on auth/HTTP errors (401/403). The helper adds NO retry\nloop of its own (it does NOT reuse the unrelated JQL empty-results consistency loop); it\ncatches `urllib.error.HTTPError` / `URLError` / `TimeoutError` / `ConnectionError` / JSON-decode\nerrors from `_direct_rest_get` and maps them to a distinct `TransportUnavailableError`\n(fail-closed, own message), separate from `ProjectVisibilityError` (a reachable backend that\nsimply does not list a required key).\n\nReusable single source of truth: an importable `access_check.py` function\n`check_mapped_project_visibility(repo_root, *, client=..., query_project=..., ...)` returning a\nstructured `ProjectVisibilityResult` (`status` in {`ok`,`missing`,`transport_unavailable`,\n`skipped`}), plus an `enforce_*` wrapper that raises. Ticket `9702` (bridge fsck live\ndiagnostic) reuses this exact function — NOT inlined into the reconcile pass.\n\nBackend-neutrality: the WIRING GATES ON THE BACKEND — it reads\n`rebar.config.load_config().reconciler.backend` and only builds the Cloud `AcliClient` and\nprobes when that key is `\"jira\"`. Any other backend (e.g. `\"jira-datacenter\"`, whose\npycontribs transport has no `_direct_rest_get`) logs an observable \"skipped: backend <key> has\nno visible-projects probe\" and returns without a Cloud client. Defence in depth: the helper\nreturns `status=\"skipped\"` if handed a client lacking a callable `_direct_rest_get`.\n\nWiring + result classification: wired at `__main__.py` `run_pass_result`, STRICTLY BEFORE\n`reconcile.reconcile_once` (the only outbound-mutation call), only for mutating passes.\nRead-only passes are skipped by concrete pre-`reconcile_once` signals: `route == \"preview\"`,\nand `target_mode.value in {\"dry-run\",\"reconcile-check\"}` (`reconcile-check` is already\nshort-circuited in `main()`; `no_write` is computed INSIDE `reconcile_once`, after this point,\nso it is NOT used here). A preflight failure is CONVERTED INTO a classified `PassResult`\n(`_Disposition.OPERATIONAL_FAILURE`, exit 1) like the existing `reconcile_once` path — never\nan uncaught raise, so the `run_pass` / `_lib_ops.py` consumers do not crash. The\nmissing-project message names the offending key(s) + the fix; observable via stderr/log.\n\n## Acceptance Criteria\n- [x] A pass with a mapped key not visible to the bot aborts at preflight naming the key\n      BEFORE any Jira write — `reconcile.reconcile_once` NOT called; `run_pass_result` returns\n      an `OPERATIONAL_FAILURE` `PassResult`. Verified by\n      `python -m pytest tests/unit/rebar_reconciler/test_preflight_project_visibility.py -q`.\n- [x] `legacy_default` (when non-empty) is in the check; an invisible `legacy_default` is\n      caught, naming it. Verified by the same test module.\n- [x] When `projects` is empty, the configured `query_project` fallback is included, so an\n      invisible fallback is caught. Verified by the same test module.\n- [x] An all-visible mapping passes and the pass proceeds unchanged (`reconcile.reconcile_once`\n      is called; no happy-path change). Verified by the same test module.\n- [x] A hard auth/transport error fails closed with a distinct transport-unavailable message\n      and is observable via log/stderr. Verified by the same test module.\n- [x] A non-Cloud backend (`config.reconciler.backend != \"jira\"`) and a client lacking\n      `_direct_rest_get` are both skipped (observable) and the pass proceeds without a Cloud\n      client. Verified by the same test module.\n\n## Testing\n- `python -m pytest tests/unit/rebar_reconciler/test_preflight_project_visibility.py -q` —\n  fake/injected transport (no live Jira). Helper: fake client `_direct_rest_get` returns\n  `project/search` pages listing `{GOOD}` / `BAD` absent → `enforce_*` raises\n  `ProjectVisibilityError` naming `BAD`; all-visible → `status=\"ok\"`; `legacy_default=WRONG`\n  caught; empty `projects` + `query_project=FALL` (not visible) caught; `_direct_rest_get`\n  raising → `TransportUnavailableError`; no `_direct_rest_get` → `status=\"skipped\"`; multi-page\n  `values` all collected. Wiring (`run_pass_result` with stubbed `reconcile_once`): missing →\n  NOT called + `OPERATIONAL_FAILURE`; transport-unavailable → NOT called + `OPERATIONAL_FAILURE`;\n  all-visible → called once; `route==\"preview\"`, `target_mode.value==\"dry-run\"`, and a\n  non-`\"jira\"` backend each skip the probe and proceed. RED first: without the preflight the\n  pass proceeds to fan-out on an invisible key.\n- No unit test hits live Jira; the real envelope/pagination is unit-tested against the\n  documented Jira Cloud shape, live verification deferred to the existing\n  `rebar bridge access-check` / staging path (same transport/credentials).\n- `make lint` and `make typecheck` from the worktree.\n\n## Sequencing\nLives in `access_check.py` (new importable reusable helper) + wiring at `__main__.py`\n`run_pass_result`. Disjoint from A/B/C/E files. Reads projects_store (no edit).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/access_check.py","reason":"Add check_mapped_project_visibility + enforce_mapped_project_visibility reusable helpers"},{"path":"src/rebar/_engine/rebar_reconciler/_preflight.py","reason":"New preflight module: gate mutating Cloud passes on mapped-project visibility; extracted to keep __main__.py <= 800"},{"path":"src/rebar/_engine/rebar_reconciler/__main__.py","reason":"Wire preflight before the outbound-mutation call"},{"path":"tests/unit/rebar_reconciler/test_preflight_project_visibility.py","reason":"RED-first coverage for preflight gating + helper"},{"path":"tests/unit/rebar_reconciler/orchestrate/test_main_entry.py","reason":"Update main-entry wiring test for the preflight call"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","428a-c414-b944-4584"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"8190a1d3-115d-411e-a594-0d1052af0442","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"a011-491c-f7e5-4dd9","ticket_type":"task","title":"Reconciler preflight: verify every mapped project + legacy_default is visible in target Jira before any mutation","verify_commands":[]},"source_event_uuids":["3a3bf81d-3d11-455b-96b3-f7601d80baf6","f378215c-5f7f-4945-90f1-e1a35889f901","3c64f234-8c13-4e55-9d2f-567c08fbd62b","d4057a57-de56-4d40-a241-fcb43806f18d","99e28ec3-1ff7-432c-84fa-c17fd199bd0c","a0da9bfc-ca2a-4391-b1fa-40f925c85b92","f545f6bb-7799-4ae4-bfaa-6123d449c337","4b57c776-211b-4792-80d9-ebe69a814330","61e02127-ff0b-4acc-8c22-a94fec82d814","348bae0c-b6f4-4dac-ba35-d7f5792428ee","01afaaaf-e2fb-4c18-89f2-96c686605c10","8190a1d3-115d-411e-a594-0d1052af0442","d697543a-812c-4170-9397-a422279ea783"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786823354725505001,"uuid":"61552481-019f-4626-952e-f0a72b4d74ee"}