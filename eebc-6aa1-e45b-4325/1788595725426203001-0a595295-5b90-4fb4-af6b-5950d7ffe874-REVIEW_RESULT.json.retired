ion":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Pin the required action for the could-not-establish state per mode (fail-closed in the scheduled drift sweep; surfaced-but-non-fatal locally) so the fetch-failure path cannot silently pass.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E6","T5b"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["'THREE-valued -- current / stale / could-not-establish -- because collapsing the third state into either of the other two is how this bug class is made'","No stated exit/gating behavior for could-not-establish in the drift workflow or local run"],"finding":"The three-valued result defines 'could-not-establish' as a distinct state, but the plan does not specify the REQUIRED ACTION for that state per mode (scheduled sweep vs PR merge vs local) — fail-closed or warn-and-proceed — which is exactly where this bug class hides.","group_criteria":null,"group_id":null,"id":"f3818d4465e5db09a","impact":1.0,"is_primary":null,"location":"AC2 (CURRENCY MECHANISM), AC3","norm_id":"n8c7f7394deab39fa","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["git fetch fails transiently in CI; check reports could-not-establish; workflow proceeds green and drift detection is silently blinded"],"severity":null,"suggested_fix":"Scheduled sweep and PR-merge modes: treat could-not-establish as a failing (non-zero) outcome; local mode: print a loud warning and non-zero exit that the operator may override.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Name the local delivery mechanism for AC5 (e.g. a `check-currency` script or terraform wrapper the developer runs before plan) and how it emits the current/stale/could-not-establish signal.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E2","E6"],"decision":"advisory","decision_margin":-0.13,"drop_reason":null,"evidence":["'works for a developer running terraform locally with no CI provider'","No named local artifact or invocation is described; AC2 specifies the comparison logic but not its local delivery vehicle"],"finding":"AC5 requires the check to work for a local developer with no CI provider, but the plan never names WHAT the developer runs (a wrapper script, git hook, make target) or how the staleness signal surfaces locally.","group_criteria":null,"group_id":null,"id":"ff1119b81173ea085","impact":0.67,"is_primary":null,"location":"AC5 / AC1","norm_id":"n917b7f56b1d55c0f","priority":0.67,"reason":"default-advisory","recalled":false,"scenarios":["Executor must choose between a git pre-run hook, a terraform wrapper, or a standalone script with no guidance"],"severity":null,"suggested_fix":"Specify a single portable script (invoked by both CI and a documented local command) that prints one of the three states and exits non-zero on stale/could-not-establish in tip mode.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Describe the concrete assertion step in terraform-drift.yml (invoke the tip-mode currency check as a required gating step before terraform plan) that proves the workflow ran against current main.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E6"],"decision":"advisory","decision_margin":-0.3637,"drop_reason":null,"evidence":["'provably runs against current main, and that is asserted rather than assumed'","No named workflow step, script invocation, or check that performs the assertion is described"],"finding":"AC3 requires the drift workflow to 'provably run against current main... asserted rather than assumed', but no concrete assertion mechanism or proving command is described (the plan states the requirement but not the step/artifact that satisfies it).","group_criteria":null,"group_id":null,"id":"fe939210e441a0c93","impact":0.67,"is_primary":null,"location":"AC3","norm_id":"ne854f5e90f4c49b0","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["Executor adds a comment claiming currency but no runtime assertion, satisfying the AC text without the guarantee"],"severity":null,"suggested_fix":"Add a required step in terraform-drift.yml that runs the tip-mode currency check and fails the job on stale/could-not-establish, before the plan step.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable).","no verification commands or testing plan referenced","AC item 'AC1 - A Terraform plan or apply executed against a tree that is behind the track' cites operational evidence (iac) that lives outside the codebase; tag it [non-codebase] — prefix the checkbox text with [non-codebase] so the completion verifier accepts a recorded attestation instead of failing to find code proof."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P7"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["destructive terms: destroy; no backup/dry-run/rollback nearby"],"finding":"Destructive/irreversible operation(s) with no stated safeguard.","group_criteria":null,"group_id":null,"id":"f4e1650fc06461e62","impact":0.4,"is_primary":null,"location":"","norm_id":"n4b1254c143290a68","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"State the safeguard (backup, dry-run, reversible migration, rollback) or justify the irreversibility explicitly (T4).","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] State the default tracked ref (origin/main) and whether it is configurable, so the comparison target is unambiguous.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E2"],"decision":"dropped","decision_margin":-0.701,"drop_reason":null,"evidence":["'behind the tracked branch'","'fetch the remote ref FRESH and compare the local HEAD against it'"],"finding":"AC1/AC2 reference 'the tracked branch' and fetching 'the remote ref' but do not state which ref is authoritative (hardcoded origin/main vs configurable), leaving a scope boundary undefined.","group_criteria":null,"group_id":null,"id":"f48e854f033583c15","impact":0.264,"is_primary":null,"location":"AC1, AC2","norm_id":"nccd456ec4465e08e","priority":0.099,"reason":"low-validity","recalled":false,"scenarios":["A fork or a repo whose default is not origin/main runs the check against the wrong ref"],"severity":null,"suggested_fix":"Default to origin/main; allow override via an env var or arg, documented in the plan.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a documentation deliverable (AGENTS.md or a design note) describing the currency check, its three states, and the local invocation/override.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["T5e"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'AGENTS.md forbids fast-forwarding the shared main checkout'","New cross-cutting check convention with no documentation-update deliverable named"],"finding":"The plan introduces a new operator-facing convention (a currency check that gates terraform runs locally and in CI) but does not mention capturing it in AGENTS.md or a design doc, despite AGENTS.md already governing checkout behavior referenced in the ticket.","group_criteria":null,"group_id":null,"id":"f4616f5e5622db0ec","impact":0.0,"is_primary":null,"location":"Note on the local checkout / AC5","norm_id":"nac540b216d41588d","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["Future operators encounter the could-not-establish exit and do not know it is expected or how to override it"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.2143,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"insufficient","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] State the disposition of the fresh-fetch failure arm in AC2: whether a transient fetch failure is retryable/transient (surfaced as could-not-establish and safe to retry) or fatal — and confirm it never collapses to 'current'.","cohort":["E3","E5","F4","G5","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["project.failure-disposition-contract"],"decision":"dropped","decision_margin":-0.8175,"drop_reason":null,"evidence":["'fetch the remote ref FRESH and compare the local HEAD against it'","The three-valued result names could-not-establish but does not attach a disposition word (transient/retryable vs fatal/permanent) to the fetch-failure case that produces it."],"finding":"AC2 introduces a fresh remote fetch whose own failure produces the 'could-not-establish' state, but the plan does not state the disposition of that fetch-failure arm — whether a transient network/fetch failure is retryable/transient (retry) versus surfaced immediately as a blocking could-not-establish — only that could-not-establish must not collapse into current/stale.","group_criteria":null,"group_id":null,"id":"f1ac41d4c3329723c","impact":0.264,"is_primary":null,"location":"AC2 CURRENCY MECHANISM — 'fetch the remote ref FRESH'","norm_id":"nee5324b31940881f","priority":0.0825,"reason":"low-validity","recalled":false,"scenarios":[],"severity":null,"suggested_fix":"Add to AC2: a fetch failure surfaces as could-not-establish (transient/retryable — the operator may retry) and is NEVER treated as 'current'; the run must not proceed as if convergence was verified.","tier":"LLM","validity":0.3125,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"insufficient","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"30db74dd37b30d23","material_parts":{"children":["647ea2107ca5072f",0],