{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786502202408592129,"compiled_state":{"alias":"spinal-grayish-perch","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"f7e684c3004c987ad5688ea28b815bd4babef08d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 291e-7b48-3f24-41c6","material: a4370cd740deba4b","material-part: children 647ea2107ca5072f 0","material-part: description 6bbb100a3cdb0f51 7685","material-part: file_impact 1dc674abcc94d4bb 3","material-part: ticket_id fdf3404093ca507e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (f7e684c300)","regver: 4f90349cd81c4911","verified-at-sha:f7e684c3004c987ad5688ea28b815bd4babef08d","dep aba5855750d9e33ebf4b25fac3eb7f756dd3d1e685ebaf3fd503a961fdb5f4d8 scripts/canary_bridge.py","dep bb876958376387311e42abcaba39b7bd80aa9d36edd935c89d066791fadbb090 scripts/dependency_audit.py","dep absent tests/unit/test_scripts_import_convention.py"],"material_fingerprint":"a4370cd740deba4b","merged_log_commit":"f7e684c3004c987ad5688ea28b815bd4babef08d","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786498528987288000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":12,"unsigned":0},"authorship_ledger":[{"content_hash":"9b4cd703540dbdbf392cb0fa1bdea3b3c60981f6af8c19538257bf38a6a0c6d5","event_uuid":"62302265-6941-4fbe-9371-4330f1726943","position":{"commit_sha":"89c6e97dd6aa48863b074bc3b98dd3f35