n mirroring the docs/cli-reference.md one: declare the help/*.txt bodies an APPROVED regeneration delta (parser-rendered bodies replace the hand-captured option tables), keep only the 'Usage:' capitalization as a byte-parity invariant for the substring consumers, and name the parser-factory work (adding argument help= text, --no-pull, description/epilog curation, argparse.SUPPRESS on --include-provenance) needed to carry the curated explanations the plan says live 'inside parser descriptions/epilogs'.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"high","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"high","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify the source of the curated per-option and per-subcommand descriptions in the generated artifacts — e.g. add argument help= strings and parser description/epilog text to the factories, and a group-order/summary source for the overview — so generation neither drops today's operator-facing text nor requires post-hoc concatenation.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":