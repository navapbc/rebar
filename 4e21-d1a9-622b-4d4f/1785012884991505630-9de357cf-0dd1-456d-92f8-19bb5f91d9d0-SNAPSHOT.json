d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c31e18192cd6ca1997562562504fec90b7a3fbe985b23c54686eb935d3def080","event_uuid":"46562851-e79e-4069-bb12-b04b5d1a327f","position":{"commit_sha":"3bfaf278025c38b2bb2ca9e29620a97e3020addd","position":"1785012884991505629-46562851-e79e-4069-bb12-b04b5d1a327f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"a0c7f005-a8ab-42a9-8776-67996a66e0cb","comments":[],"created_at":1785012111944914001,"creation_channel":"cli","deps":[],"description":"# Jira descriptions render a line break at the end of every soft-wrapped source line\n\n## Context / Problem\n\nTickets synced into Jira are hard to read: a visible break appears at the end of each fixed-width line of prose. Confirmed live on REB-1581, whose stored description is 27 top-level ADF nodes, ALL of type `paragraph` — a single prose paragraph is split across four consecutive paragraph nodes of 102/108/106/111 chars.\n\nRoot cause: `text_to_adf` (src/rebar/_engine/rebar_reconciler/adapters/jira/adf.py:239-251) splits the description on `\\n` and wraps EVERY source line in its own ADF paragraph node. Rebar descriptions are authored hard-wrapped at ~95-110 columns, so each soft-wrapped continuation line becomes a separate Jira paragraph.\n\n## Acceptance criteria\n\n- A blank-line-delimited block of soft-wrapped prose renders in Jira as ONE paragraph, with the wrapped lines joined.\n- Intentional structure is preserved: blank-line paragraph separation still produces separate paragraphs, and list items / headings stay on their own lines rather than being joined into a run-on.\n- No description re-sync churn: the differ must not re-emit a description update on every pass. The identical normalization must be applied to the local value at ALL THREE compare sites (outbound_fields.py:566, inbound_differ.py:209, reconcile_check.py:180-189), following the existing `fit_text_to_adf_limit` precedent.\n- Verified live against Jira with a probe ticket, which is then removed from both Jira and rebar.\n\n## Design notes / risks\n\n- Joining soft-wrapped lines is inherently lossy, so the documented round-trip invariant `adf_to_text(text_to_adf(t)) == t` (adf.py:9, pinned by tests/unit/rebar_reconciler/mutate/test_adf.py:694-699) must be restated as idempotency on already-normalized text. This is a deliberate contract change, not test weakening.\n- Grouping shrinks the ADF (~8432 -> ~7977 chars on a real ticket), moving where `fit_text_to_adf_limit` truncates. That converges but causes a one-time re-emit for currently-truncated descriptions; check against test_inbound_differ.py:484 and test_reconcile_roundtrip.py:221 (the tarry-amble-bugle clobber class).\n- Churn history this must not regress: bug 626d, bug 85a1, and the DIG-4175 plateau (339 outbound updates across batches 7-20 from a trailing `\\n\\n`).\n- Emitting `hardBreak` instead of joining WOULD preserve invertibility (`_handle_hard_break` decodes to `\"\\n\"`), but does not fix the report — a hardBreak is still a per-line break. Rejected.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"parent_id":null,"parent_status_uuid":"d9a9890a-3a39-4f7b-bf71-0835f793c2bb","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"4e21-d1a9-622b-4d4f","ticket_type":"bug","title":"Jira sync injects a line break at the end of every soft-wrapped description line","verify_commands":[]},"source_event_uuids":["1d1f92fc-e8ab-44b7-bfc4-c602ed9dab83","d9a9890a-3a39-4f7b-bf71-0835f793c2bb","ecbfdc6b-eba7-41cf-af53-c735256a733d","46562851-e79e-4069-bb12-b04b5d1a327f"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785012884991505630,"uuid":"9de357cf-0dd1-456d-92f8-19bb5f91d9d0"}