{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787389553079051359,"compiled_state":{"alias":"compliable-evaluable-mamba","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"960fbfef2fc0e5664470d18fc1d53cb9327b1a9b","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: d075-7916-7156-4216","material: cb173bdbd459eea5","material-part: children 647ea2107ca5072f 0","material-part: description 6d34fc1d6eba968b 7850","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact 0083e492b73f58ff 5","material-part: ticket_id 23d16214e365af0a 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: planning","rebar-version: 0.12.0 (960fbfef2fc-dirty)","regver: aa61189569d34126","verified-at-sha:3a31e7368edaed168449103d47b1812aee93eb7e","dep b9de1468f281bd52c2e35945ecd44d606a8872b59be34cf9e43bce61049de947 examples/agent-skills/rebar-janitor/SKILL.md","dep c246b9f120aeea38ad96e020fbffb593a30fee956b26d7e6f83ae86cb7732069 examples/agent-skills/rebar-janitor/phases/discovery.md","dep 35adb32303e3021328ac677c2babe4e0454d06964efe5e8159680b512313f325 examples/agent-skills/rebar-janitor/phases/verification.md","dep 863f783c76b1654ada42920cfd08fa638a88a1cfea61f74bc07a0e1423d739ea examples/agent-skills/rebar-janitor/references/patterns.md","dep absent tests/unit/test_janitor_concern_schema.py","read-set: 7","read-path: examples/agent-skills/rebar-janitor/SKILL.md","read-path: examples/agent-skills/rebar-janitor/phases/discovery.md","read-path: examples/agent-skills/rebar-janitor/phases/verification.md","read-path: examples/agent-skills/rebar-janitor/references/patterns.md","read-path: scripts/check_skill_frontmatter.py","read-path: src/rebar/llm/reviewers/code-review-tests.md","read-path: tests/unit/test_skill_shared_sync.py","currency-basis: file_impact"],"material_fingerprint":"cb173bdbd459eea5","merged_log_commit":"3a31e7368edaed168449103d47b1812aee93eb7e","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787382810564487000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"eed43ce461441f19f044019a2fcb35bd5efbe50709ec4d978e0dcdfd849a6328","event_uuid":"9651956b-24a9-437d-b3ca-3b8aeb54069e","position":{"commit_sha":"4b258902c87a73e43fe0eb243044002f4d79972b","position":"1787368869143470001-9651956b-24a9-437d-b3ca-3b8aeb54069e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7386fc2ecf8784e1a5b5aabe1b8ba41e86742a42ed478b508055a9af0d7f2a97","event_uuid":"490d05ee-77b6-4de1-a0ce-e51159fef8a3","position":{"commit_sha":"4d607d9a8458785009af997131df9e4480cfe756","position":"1787370960371381001-490d05ee-77b6-4de1-a0ce-e51159fef8a3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ae8bd4c9bc07faa16c4718c399f88fac5d12c6e4dbdec0663734b48db85c4168","event_uuid":"a03880be-5835-4310-af06-65b926f0e782","position":{"commit_sha":"349193fa24f58217e0c17c0395b66e50