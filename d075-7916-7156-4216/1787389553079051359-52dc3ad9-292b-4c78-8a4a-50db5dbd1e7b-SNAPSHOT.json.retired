":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2ccc4f3f7174cdbf34e121229c3567ce1b2a68c9aa8a5bb921d324242c36a442","event_uuid":"f95cac9e-a78e-4947-a594-bc59a345bc10","position":{"commit_sha":"92905679eeee5789df6e9319701e95e95eae611d","position":"1787376633661037001-f95cac9e-a78e-4947-a594-bc59a345bc10"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ecf780cf7bc66c98f7021d2fb32cb98bf78f3e48e4def1378bb9fa2f24e4dba2","event_uuid":"728e9dab-fa54-4050-bfb1-0ff4800b7afd","position":{"commit_sha":"2e7754bf38aeb898865f25b688aad015f9747a75","position":"1787378266744909001-728e9dab-fa54-4050-bfb1-0ff4800b7afd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a890f0b8c4b7a472244596899be25389ca4a6b229ac58b3cbbbc108dc03257f1","event_uuid":"9c7d57db-974c-477e-a598-f4d78574b378","position":{"commit_sha":"21abce97f6eb6575acaac35dcc0bd46a0f69b671","position":"1787382810594577001-9c7d57db-974c-477e-a598-f4d78574b378"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"075bc855d156c3af352850c838332ea66232145fcb2b9f55bb1425adb264f233","event_uuid":"a313812f-4ff3-490b-b3d6-d9d0013500ef","position":{"commit_sha":"d58f518b824c56b52b9da26960817c4e26103f82","position":"1787382923404884001-a313812f-4ff3-490b-b3d6-d9d0013500ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"43ab27a3fc2afed699227781bb23ab7efe9ac198eea1c6ef4d4f4cdb4ccb6393","event_uuid":"79a78706-4808-492c-8893-2ef0a4eac374","position":{"commit_sha":"d58f518b824c56b52b9da26960817c4e26103f82","position":"1787382927571126001-79a78706-4808-492c-8893-2ef0a4eac374"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"027a97fa44778b74512a2ff92fb1e5777d56261b192a565eec5482332a8172ce","event_uuid":"9aff9bf2-414d-4850-8a55-a8d2842810f6","position":{"commit_sha":"d032564ec8f1baa9ba05ee9bfff58dd43a5246dc","position":"1787383655376420001-9aff9bf2-414d-4850-8a55-a8d2842810f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f48a93c722d81f9f61eb2346b98f27350e2aead83fdc3926824902090ffb1bfb","event_uuid":"02d7e5c0-a388-4cc6-b74e-566b5bf3db94","position":{"commit_sha":"0d1d9f98761213b04227f3518ef209ec4fff29d6","position":"1787389553079051358-02d7e5c0-a388-4cc6-b74e-566b5bf3db94"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-239_agent","claim_remote_session":null,"claimed_session":"e50ec61e-3a77-4eb8-b56b-c1d0f90ff9bc","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Review remediation record (2026-08-21) — moved out of the ticket description to fit the 8000-char plan-review admission cap.\n\n## Review remediation (2026-08-21)\n- Removed the flagship \"new project-specific instance\": an absent-string subprocess assertion with no `returncode`/`check=True` already ships as the `fail-open oracle` antipattern at `src/rebar/llm/reviewers/code-review-tests.md:56-70`, landed by commit `6fb4d801c9` — the fix for `obvious-saline-gerbil` (`0e1d-c698-c38d-4c3e`), the very bug the dry run uses. Concern #12 now cites it rather than re-declaring it.\n- Removed the \"wall-clock budget standing in for an observable event\" as new: `code-review-tests.md:49` already flags a concurrency/race test whose PRIMARY synchronization is a timing sleep.\n- Reduced the do-not-flag list to citations: all seven entries were already false-positive guards (ii)-(x) at `code-review-tests.md:71-106` — Rule-5 structural greps (ii, `:82-88`), command-output greps with established liveness (iii, `:91-94`), exact-value asserts on pure functions (iv, `:94-96`), external-boundary mocks (vi, `:96`), bare \"no test for X\" (vii, `:97`), strict `xfail` with a named removal condition (viii, `:99-101`), and secondary settling sleeps (ix, `:102-103`). Restating them contradicted the plan's own \"single source of truth, not restated\" principle.\n- Kept only the three instances verified absent from the rubric: a fixture mutating state it did not create; an equivalence test whose two sides use different hardening helpers; an oracle encoding a policy preference the contract does not state.\n- Corrected the Scope path: `tests/unit/test_skill_frontmatter.py` does not exist. The real file is `tests/unit/test_check_skill_frontmatter.py`, and it needs no edit — it tests the script, not skill bodies.\n- Corrected the Testing claim: `scripts/check_skill_frontmatter.py` globs `**/SKILL.md` and validates only YAML frontmatter, so it never reads `phases/discovery.md`, `phases/verification.md`, or `references/patterns.md` — three of the four files in `file_impact`. Those edits are now proven by explicit greps in the acceptance criteria instead.\n- Added the missing consumer: `discovery.md:152` hardcodes \"which of the eleven concerns above\" in the output schema handed to every discovery subagent; adding #12 without updating it leaves the schema contradicting the concern list.\n- Added the missing scope item and its constraint: `SKILL.md` is in `file_impact` but had no criterion. Its frontmatter `description` enumerates the concerns and measures 980 characters against the 1024-character cap, leaving 44 characters of headroom.\n- Replaced ACs #1-#3, which were \"checked by reading the file\" and \"checked by the run transcript\" — no command, no oracle. Every criterion is now a command that fails on the current tree; the stochastic dry run is retained as an explicitly non-gating `[operator-attested]` item, carrying the provenance marker `project.measurement-provenance` triggers on.\n- Added the portable antipattern core in `references/patterns.md` (`project.portability` is blocking and active per `.rebar/criteria_routing.json`): rebar-janitor runs against non-rebar repos where `src/rebar/llm/reviewers/code-review-tests.md` does not exist, which would have left concern #12 with no antipattern list at all.\n- Dropped the hedged `docs/` page from Scope: `grep -rln \"janitor\" docs/` confirms no page documents the janitor concern list.","timestamp":1787370973717349001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Review remediation round 3 (2026-08-21) — responding to the two blocking findings of the last\n`review-plan` pass, plus the antipattern-id advisory. Narration lives here to keep the description\nunder the 8000-char plan-review admission cap (it is now 7802).\n\n## Blocking finding 1 — the SKILL.md description edit was conditional and unverified\nThe old Scope said \"SKILL.md (frontmatter `description`, only if it still fits under 1024 chars)\"\nand the only gating AC was \"frontmatter still lints\", which a stale description passes.\nInvestigated and removed the conditionality: the description is exactly **980** characters\n(measured by parsing the frontmatter with PyYAML in the worktree; the cap is\n`DESCRIPTION_MAX_LENGTH = 1024` at `scripts/check_skill_frontmatter.py:46`). The intended\ninsertion is the literal string `oracle strength, ` — 17 characters — into the discovery topic\nlist after `oversized units, `, giving 997. There is therefore no displacement case at all, so\nthe plan now commits to the exact edit unconditionally and adds a positive AC:\n`sed -n '/^---$/,/^---$/p' $J/SKILL.md | grep -q \"oracle strength\"`. That grep is scoped to the\nfrontmatter block, so a mention landing only in the skill body does not satisfy it.\n\n## Blocking finding 2 — the portable-fallback AC proved only that the word \"oracle\" appeared\n`grep -qi \"oracle\" $J/references/patterns.md` was far weaker than the deliverable the Approach\ndescribed. Replaced with a conjunction over a named section. The plan now specifies that\n`references/patterns.md` gains a heading `## Oracle strength & contract coverage (concern 12)`,\nand the AC extracts exactly that section (`awk '/^## Oracle strength & contract coverage\n\\(concern 12\\)/,/^## /'`) and requires **seven** independent greps to pass against it: the\noracle-strength question, `escape_input`, the false-positive floor, each of the three portable\nantipattern ids by name, and a runnable query line. Each of the seven maps to one element the\nApproach promises, so the criterion can now fail on a partial implementation — which was the\nreviewer's point.\n\n## Advisory (blocking in the round before) — `antipattern_id` had an undefined vocabulary\nThe three classes #12 introduces are verified absent from `code-review-tests.md`, so\n`antipattern_id` had no value for them. They now carry stable ids named in both the description and\nthe portable core: `fixture-mutates-foreign-state`, `mismatched-hardening-equivalence`,\n`unstated-policy-oracle`. The no-class-applies case is specified explicitly (the field is omitted),\nand that rule is itself an AC:\n`grep -A2 '^- \\`antipattern_id\\`' $D | grep -qi omit`.\n\n## Corrected a false verification command\nThe old Scope claimed \"no `docs/` page documents the janitor concern list (verified by\n`grep -rln \"janitor\" docs/`)\" — but that grep returns **seven** files. Reading them shows every hit\nis the unrelated snapshot-GC janitor (`docs/config.md:500`, `docs/repo-snapshot-gates.md:183` etc.).\nThe substantive claim holds but the cited command did not verify it. Replaced with\n`grep -rl \"rebar-janitor\" docs/ --include='*.md'`, which returns nothing (the sole tree-wide hit is\n`docs/experiments/.../operator_attested_ac_corpus.jsonl`, experiment data rather than a docs page).\n\n## Added a durable executable oracle rather than one-shot greps\nThis ticket is about oracle strength, so an all-grep acceptance set was self-undermining: the greps\nprove the edit landed once and then never run again. The \"eleven concerns\" hardcoded at\n`discovery.md:152` while eleven numbered concerns exist above it is precisely the failure mode #12\nnames — two halves of one artifact silently disagree and nothing fails. New\n`tests/unit/test_janitor_concern_schema.py` DERIVES the count from each side (the top-level numbered\nconcern list; the number word in the schema's `concern` line) and asserts agreement, so a thirteenth\nconcern added without a schema update fails CI. It pins no wording and no concern text, so it\nsurvives any rewording of a concern — it is not a change-detector. Added to Scope and `file_impact`.\n\n## Facts re-verified against the tree this round (worktree at origin/main)\n- `code-review-tests.md`: `unrealistic fault injection` starts `:45`, timing-sleep clause `:49`,\n  `fail-open oracle` `:56`, false-positive guards heading `:72`, guard (x) ends `:106`. The old\n  description said `:71-106`; corrected to `:72-106`.\n- `discovery.md`: eleven numbered concerns (last `11.` at `:119`), \"eleven concerns\" at `:152`,\n  `### Temporal decay pass` at `:134`, #11's sharding bullet at `:131-132`. No `12.` line exists.\n- `verification.md:115` reads `none = docs/test-only`.\n- `patterns.md`: zero occurrences of \"oracle\" (case-insensitive) today.\n- `references/patterns.md:116-118` is the assertion-light `rg` block; `discovery.md:51-52` is #7's\n  \"smelly/missing tests\" clause.\n- Both cited escaped bugs exist and are closed: `0e1d-c698-c38d-4c3e` (\"Live DC pass-health asserts\n  fail OPEN on a signal-killed child\"), `9bb7-4430-1202-4d93` (\"Nested repo-isolation timeout oracle\n  expires after watchdog fires\").\n- `tests/unit/test_skill_shared_sync.py` excludes rebar-janitor at `:28` (`CONSUMERS` tuple);\n  `tests/unit/test_skill_frontmatter.py` does not exist, `test_check_skill_frontmatter.py` does.\n- Every acceptance-criterion command was run against the current tree and every one fails, so none\n  is vacuously satisfied.","timestamp":1787376633661037001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation landed as Gerrit change 2087 (`453ad3e40de`, Change-Id\n`I7b0fe78fe3080ce37ee4ba67d55ef7a369cc9025`). Recording the RED/GREEN sequence and the mutation\nevidence the acceptance criteria call for.\n\n## RED/GREEN, not test-after\n1. `tests/unit/test_janitor_concern_schema.py` was written FIRST and run against the untouched\n   tree: 3 passed. The invariant it asserts (11 numbered concerns == \"eleven\") held then.\n2. Concern #12 was added to `discovery.md` WITHOUT touching the schema sentence.\n   `test_schema_concern_count_matches_the_concern_list` went RED with exactly the intended\n   diagnosis: `AssertionError: ... lists 12 numbered concerns (highest: 12) but its output schema\n   says the subagent must pick 'which of the 11 concerns above'` / `assert 11 == 12`. Not an\n   ImportError, not a collection error — the assertion itself failed on the real drift.\n3. The schema sentence was then updated to \"twelve\" and the suite went GREEN.\n\nThat is the actual bug this file guards, reproduced before the fix and closed by it.\n\n## Mutation evidence (each mutation applied to `discovery.md`, then reverted)\n| # | Mutation | Result |\n|---|---|---|\n| 1 | Rewrote every `^N. **` concern heading as `- **` (numbering stripped) | `test_discovery_defines_a_numbered_concern_list` FAILED — the anti-vacuous guard fires rather than the suite passing on an empty list |\n| 2 | Renumbered `12. **Oracle strength` as `13.` | `test_concern_numbers_are_contiguous_from_one` FAILED (`[1..11, 13]` vs the expected contiguous run) |\n| 3 | Reverted the schema word `twelve` -> `eleven` | `test_schema_concern_count_matches_the_concern_list` FAILED (`assert 11 == 12`) |\n| 4 | Removed the count clause entirely (`which of the twelve concerns above` -> `the concern this belongs to`) | FAILED in `_schema_count` — \"no 'which of the <N> concerns above' schema sentence\" |\n\nEvery test in the file is killed by at least one mutation, and each mutation kills a DIFFERENT\ntest, so none of the three is redundant and none is a tautology. Mutations 1-4 all edit the live\nfile the tests read (`DISCOVERY.read_text()`), not a docstring or a comment.\n\n## What was deliberately NOT kept\nAn earlier draft carried `test_number_word_table_is_self_consistent`, parametrized over the\nmodule's own `NUMBER_WORDS` constant. It asserted test data against a literal range — it exercised\nno artifact and could not fail on any real change. Given this ticket is about oracle strength, a\ntautology in its own gate would be self-refuting, so it was deleted before the commit rather than\ncarried as filler coverage.\n\n## Why this is not a change-detector\nBoth sides of the comparison are DERIVED from the document at run time: the concern count from\n`^(\\d+)\\. \\*\\*` matches, the stated count from the number word in the schema sentence. Rewording a\nconcern's title, reordering the bullets inside a concern, or rewriting the prose of any concern\nleaves all three tests green. Only a genuine disagreement between the two halves — or the loss of\none half — fails them. It survives every behaviour-preserving edit to the artifact it guards.\n\n## Frontmatter arithmetic, verified rather than asserted\nThe `SKILL.md` description measured 980 characters before the edit and 997 after inserting\n`oracle strength, ` (17 characters) into the discovery topic list, against the 1024-character cap\nat `scripts/check_skill_frontmatter.py:46`. Measured by parsing the YAML frontmatter, not by\ncounting the source line. `python scripts/check_skill_frontmatter.py` reports\n`PASS: 4 SKILL.md file(s)`.\n\n## Acceptance criteria\nAll 23 criterion commands were executed verbatim from the repo root against the post-change tree\nand all pass; each had been executed against the pre-change tree first and failed there, so none is\nvacuously satisfied. `git diff --name-only origin/main` lists exactly the five Scope paths.\n`make lint`, `make typecheck` and `python scripts/check_complexity_baseline.py --check`\n(`new=0 increased=0`) are clean.\n\n## One correction found while running the criteria\nThe pre-remediation AC extracted the portable core with\n`awk '/^## Oracle strength .../,/^## /'`. That range is a no-op: awk evaluates the end pattern\nagainst the same record as the start, and `^## ` matches the heading line itself, so the range\ncollapsed to one line and all seven greps failed on a correct implementation. Replaced with\n`sed -n '/^## Oracle strength & contract coverage (concern 12)/,/^## Temporal decay/p'`, which\nextracts the full 32-line section. Caught by running the criterion rather than reading it.","timestamp":1787383655376420001}],"created_at":1787358258288859001,"creation_channel":"cli","deps":[{"link_uuid":"02d7e5c0-a388-4cc6-b74e-566b5bf3db94","relation":"relates_to","target_id":"95ca-1e0a-c6f1-4fda"}],"description":"## Context / Problem\nJanitor `discovery.md` (under `examples/agent-skills/rebar-janitor/`) covers tests only as\nsmelly/missing tests (#7 `:51-52`; an `rg` count of files with <2 assertions,\n`references/patterns.md:116-118`) and change-detector/duplication/dead-path health (#11 `:119-133`).\nNeither asks: **can this assertion fail when the contract is violated?** Nothing covers oracle\nstrength or contract-coverage gaps (a documented promise no test fails on). And\n`phases/verification.md:115` anchors `prod_impact = none` at \"docs/test-only\", so a weak-test\nfinding sits below the impact floor however critical the contract it fails to guard. Two such bugs\nescaped in Aug 2026: `0e1d-c698-c38d-4c3e`, `9bb7-4430-1202-4d93`.\n\nThe rubric naming these classes ALREADY exists at `src/rebar/llm/reviewers/code-review-tests.md`\n(`fail-open oracle` `:56-70`, `unrealistic fault injection` `:45-49`, the guards `:72-106`) but runs\n**only on a diff**, never on the resting tree: the gap is reach, not vocabulary.\n\n## Approach\nAdd concern **#12 \"Oracle strength and contract coverage\"** to `phases/discovery.md`, sharded by\ntest-tree region as #11 is (`:131-132`) and cross-referenced from #11.\n\n- **Brief.** Per test, name the contract (docstring, ADR, `--help` text, schema statement) and the\n  oracle (its assertion set). Finding = the oracle cannot fail on a violation of that contract,\n  proven by a concrete `escape_input` — a state the oracle accepts but the contract forbids. A\n  contract-coverage gap takes the same proof shape.\n- **Cite `code-review-tests.md`; never restate it.** In a rebar checkout it is the single source of\n  truth for antipatterns AND the do-not-flag guards (ii)-(x) `:72-106`, applied by reference. #12\n  must NOT re-declare classes it owns: absence / empty-capture assertions with no producer-liveness\n  check (`fail-open oracle` `:56-70`); a race test synchronized by sleep (`:49`).\n- **Portable fallback (required — janitor also runs on repos lacking that rubric).**\n  `references/patterns.md` gains a `## Oracle strength & contract coverage (concern 12)` section\n  carrying, on labelled lines: (a) the oracle-strength question, (b) the mandatory `escape_input`\n  proof, (c) the false-positive floor (no finding without a violating input), (d) the three ids\n  below plus `fail-open-oracle`, so the fallback vocabulary stands alone rather than mirroring part\n  of the rubric, (e) the runnable #12 query.\n- **Additional instances** (absent from the rubric), with portable ids:\n  `fixture-mutates-foreign-state` (a fixture mutating state it did not create);\n  `mismatched-hardening-equivalence` (equivalence sides using different hardening helpers);\n  `unstated-policy-oracle` (an oracle encoding a policy the contract does not state).\n- **Evidence shape.** New schema fields: `contract` (quote + `path:line`), `oracle` (quote +\n  `path:line`), `escape_input`, `antipattern_id`, `scope` (sibling-site count). `antipattern_id` takes\n  the `code-review-tests.md` name where one applies, else one of the three ids above; when no named\n  class fits it is **omitted**. `discovery.md:152` — the schema handed to every\n  discovery subagent — hardcodes \"eleven concerns\" -> \"twelve\".\n- **Verification.** Amend `phases/verification.md:115` so a test-only finding takes `prod_impact`\n  from the **guarded production contract**, not from its file being under `tests/`. `harm_reachable`\n  needs a tree-state demonstration (a run against a deliberately broken stub, or the `escape_input`\n  reasoned through the assertion); else `:49-50` reclassifies it `HARDENING`. A #12 class the rubric\n  lacks becomes a Phase-5 ticket adding it.\n- **Frontmatter.** `SKILL.md`'s `description` is 980 chars against the 1024 cap\n  (`scripts/check_skill_frontmatter.py:46`), so insert `oracle strength, ` (17 chars -> 997) into\n  its discovery topic list after `oversized units, `; no displacement needed.\n- **Durable oracle.** The \"eleven\"/\"twelve\" drift is itself the class #12 names: two halves of one\n  artifact disagree and nothing fails. New `tests/unit/test_janitor_concern_schema.py` DERIVES the\n  count from each side — the numbered concern list, and the schema's `concern` number word — and\n  asserts they agree, so a future concern added without a schema update fails it. It pins no wording\n  and no concern text.\n\n## Scope\nUnder `examples/agent-skills/rebar-janitor/`: `phases/discovery.md`, `phases/verification.md`,\n`references/patterns.md`, `SKILL.md` (frontmatter only). Plus new\n`tests/unit/test_janitor_concern_schema.py`.\n\nNot in scope: no `docs/` page documents the concern list —\n`grep -rl \"rebar-janitor\" docs/ --include='*.md'` returns nothing (the `janitor` hits under `docs/`\nare the unrelated snapshot-GC janitor). `tests/unit/test_check_skill_frontmatter.py` tests the\nscript, not skill bodies; `tests/unit/test_skill_shared_sync.py:28` excludes rebar-janitor.\n\n## Testing\n`test_janitor_concern_schema.py` is the executable oracle, mutation-checked by perturbing either\nside of the count and seeing it RED. `check_skill_frontmatter.py` covers the `description` edit.\nThe prose edits are proven by the greps below, all of which fail on the current tree.\n\n## Acceptance Criteria\nFrom the repo root, with `J=examples/agent-skills/rebar-janitor`, `D=$J/phases/discovery.md`.\n- [ ] #12 exists: `grep -qE '^12\\. \\*\\*Oracle strength and contract coverage\\*\\*' $D` exits 0.\n- [ ] With `R=$(awk '/^12\\. \\*\\*Oracle strength/,/^### Temporal decay pass/' $D)`, #12 demands an escape input, shards like #11 and cites the rubric: `grep -qi escape_input <<<\"$R\"`, `grep -qi shard <<<\"$R\"`, `grep -q code-review-tests.md <<<\"$R\"` all exit 0 — and does not duplicate it: `grep -ciE \"fail-open oracle|strict xfail|settling\" <<<\"$R\"` returns `0`.\n- [ ] The portable core is COMPLETE, not merely present. With `P=$(sed -n '/^## Oracle strength & contract coverage (concern 12)/,/^## Temporal decay/p' $J/references/patterns.md)`, all seven exit 0 against `$P`: `grep -qi \"can this assertion fail\"`, `grep -q escape_input`, `grep -qi \"no finding without\"`, `grep -q fixture-mutates-foreign-state`, `grep -q mismatched-hardening-equivalence`, `grep -q unstated-policy-oracle`, `grep -qE '^(rg|grep|sg) '` (the query).\n- [ ] Schema gained the #12 fields: `for f in contract oracle escape_input antipattern_id scope; do grep -q \"^- \\`$f\\`\" $D || exit 1; done` exits 0, and the no-class rule is stated: `grep -A2 '^- \\`antipattern_id\\`' $D | grep -qi omit` exits 0.\n- [ ] Count consistent and #11 points at #12: `grep -c \"which of the eleven concerns above\" $D` returns `0`, `grep -q \"which of the twelve concerns above\" $D` exits 0, and `awk '/^11\\. \\*\\*Test-suite health/,/^### Temporal decay pass/' $D | grep -q '#12'` exits 0.\n- [ ] `verification.md` re-anchors the floor on the contract, not the path, and demands proof: `grep -qi \"guarded production contract\"` and `grep -qi \"tree-state demonstration\"` on `$J/phases/verification.md` both exit 0, and its `prod_impact` bullet no longer reads `none = docs/test-only` unqualified.\n- [ ] The SKILL.md description names it and still lints: `sed -n '/^---$/,/^---$/p' $J/SKILL.md | grep -q \"oracle strength\"` and `python scripts/check_skill_frontmatter.py` (which enforces the 1024 cap, reporting `PASS: 4 SKILL.md file(s)`) both exit 0.\n- [ ] The durable oracle exists AND can fail: `pytest tests/unit/test_janitor_concern_schema.py -q` exits 0, and goes RED when the schema count word is edited to disagree with the list; transcript in a comment.\n- [ ] No collateral edits — `git diff --name-only origin/main` lists only Scope files — and `make lint`, `make typecheck`, `pytest tests/unit -q` all exit 0.\n- [ ] [operator-attested] Dry run on `git checkout 6fb4d801c9^` reports that tree's fail-open absent-string oracle with a concrete `escape_input`; transcript in a comment. Non-gating: stochastic.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"examples/agent-skills/rebar-janitor/SKILL.md","reason":"frontmatter description names oracle strength"},{"path":"examples/agent-skills/rebar-janitor/phases/discovery.md","reason":"concern #12, schema fields, count"},{"path":"examples/agent-skills/rebar-janitor/phases/verification.md","reason":"prod_impact anchored to the guarded contract"},{"path":"examples/agent-skills/rebar-janitor/references/patterns.md","reason":"portable oracle-strength core"},{"path":"tests/unit/test_janitor_concern_schema.py","reason":"durable concern-count consistency oracle"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","2ddd-b523-06da-4b4a"],["relates_to","95ca-1e0a-c6f1-4fda"]],"no_file_impact_reason":"","parent_id":"2ddd-b523-06da-4b4a","parent_status_uuid":"a313812f-4ff3-490b-b3d6-d9d0013500ef","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["gates","fortnight-review"],"ticket_id":"d075-7916-7156-4216","ticket_type":"story","title":"rebar-janitor concern #12: oracle strength and contract coverage, scored by the guarded contract","verify_commands":[]},"source_event_uuids":["9651956b-24a9-437d-b3ca-3b8aeb54069e","490d05ee-77b6-4de1-a0ce-e51159fef8a3","a03880be-5835-4310-af06-65b926f0e782","b219a3db-6c0f-46a4-966c-a1d6cbaab0b9","ebd21e5c-f431-4554-8ff3-7fe955fec60c","ca163b41-741a-4401-a4d1-1d75204e297e","f95cac9e-a78e-4947-a594-bc59a345bc10","728e9dab-fa54-4050-bfb1-0ff4800b7afd","9c7d57db-974c-477e-a598-f4d78574b378","a313812f-4ff3-490b-b3d6-d9d0013500ef","79a78706-4808-492c-8893-2ef0a4eac374","9aff9bf2-414d-4850-8a55-a8d2842810f6","02d7e5c0-a388-4cc6-b74e-566b5bf3db94"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787389553079051359,"uuid":"52dc3ad9-292b-4c78-8a4a-50db5dbd1e7b"}