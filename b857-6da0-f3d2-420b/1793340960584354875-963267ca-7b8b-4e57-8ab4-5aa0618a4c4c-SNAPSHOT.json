s.py","currency-basis: file_impact"],"material_fingerprint":"514d919d80d35f8e","merged_log_commit":"7a020c034c0df0c82aed8688d007e9bcd15fc49e","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1793331130654620000}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":0,"unsigned":6},"authorship_ledger":[],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-308_agent","claim_remote_session":null,"claimed_session":"a85e3cd3-9e61-4f25-9de4-cd740e853b4d","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Compatibility check: tests/scripts/bridge/test_bridge_fsck_keyset_prev_heldout.py (held-out oracle, 2026-08-09/10) pins keys-only snapshot -> indeterminate for a binding that carries NO baseline. The plan keeps exactly that case indeterminate (AC3), so the held-out test must stay green unchanged; the fallback only applies when bindings.json records baseline.status.","timestamp":1793330611177519001}],"created_at":1793330533140974001,"creation_channel":"cli","deps":[],"description":"## Observation\n`rebar bridge fsck` reports bindings whose local ticket is deleted or archived as \"indeterminate ... (jira status unavailable in key-set snapshot)\" under \"informational; not alerting\" and concludes \"No issues found\" (exit 0), even when every one is queued for a terminal transition. Reproduced (evidence: .rebar/worktrees/inv-bridge-tombstone/.rebar/scratch/inv-75058/): with no prev_snapshot or a full-field snapshot fsck reports alerting `would_terminal` and exits 1; with the keys-only snapshot rebar writes today it reports indeterminate and exits 0. The ADP store's prev_snapshot.json has 130 entries, all `{}`.\n\nCause: commit 6cdd4b00d9e (ticket 2cc0-da4a-d736-4ba2) narrowed the saved snapshot to keys; the guard from commit 5ce20c53500 (ticket 4e3e-d36f-53b9-4c1e) then reports indeterminate rather than risk a false drift. That makes the class-A check from ticket 8de5-31b4 (commit 5d450b6fe44: real drift exits non-zero) blind in practice, and the scheduled canary's triage text (ticket 8656) still expects `would_terminal`.\n\n## Plan\n1. When the snapshot holds a key but no status, fall back to the binding's recorded `baseline.status` in bindings.json (written at each sync; ADP-41's reads Done) before declaring indeterminate.\n2. Keep the 5ce20c53500 guarantee: no false drift when neither source has a status.\n3. Test with a keys-only snapshot: a bound deleted ticket whose baseline status is not terminal reports alerting `would_terminal` and exits non-zero; one whose baseline is Done reports nothing; one with no baseline stays indeterminate.\n\n## Acceptance criteria\n- [ ] With a keys-only snapshot, fsck reports `would_terminal` (alerting, non-zero exit) for a bound deleted ticket whose baseline status is not terminal.\n- [ ] A binding whose baseline status is already terminal produces no drift line.\n- [ ] A binding with neither a snapshot status nor a baseline status still reports indeterminate and exit 0.\n\n## File impact (expected)\n- src/rebar/_engine_support/bridge_fsck_drift.py\n- tests/unit/ (fsck drift tests)","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_engine_support/bridge_fsck_drift.py","reason":"fall back to binding baseline.status for keys-only snapshot entries"},{"path":"tests/scripts/bridge/test_bridge_fsck_binding_drift.py","reason":"keys-only snapshot with baseline status cases"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"1677b2c1-718c-49f3-8f6b-a3144a0c371a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"b857-6da0-f3d2-420b"