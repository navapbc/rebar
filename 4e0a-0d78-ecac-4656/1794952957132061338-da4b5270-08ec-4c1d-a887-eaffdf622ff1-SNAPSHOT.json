{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794952957132061338,"compiled_state":{"alias":"gustable-musophobic-dogfish","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"23e8764dada3dcba2a1cde28fcd0cb37af9ce818","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 4e0a-0d78-ecac-4656","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: reused","rebar-version: 0.16.0","material: 858fda009c8bc245","verified-at-sha:e6b9f8f849bc2717ec4d42bb7a4d634d59af4549"],"material_fingerprint":"858fda009c8bc245","merged_log_commit":"e6b9f8f849bc2717ec4d42bb7a4d634d59af4549","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794952957131729089},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"83ca81e709ee54faa09848f7997942680effe31d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4e0a-0d78-ecac-4656","material: 858fda009c8bc245","material-part: children 647ea2107ca5072f 0","material-part: description 5dba6b40106dac6f 5394","material-part: description_boxes 0aad7da77d2ed59c 0","material-part: file_impact 543433309b1b33cb 4","material-part: ticket_id 973ffc6b8ab1b898 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 10","review-phase: planning","re