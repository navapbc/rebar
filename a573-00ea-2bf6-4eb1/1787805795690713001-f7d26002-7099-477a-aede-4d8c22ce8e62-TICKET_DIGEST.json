{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"0196fdc6d654352918216407759fbd3867e9f7a09b0ca34b5b31bf2515961118","digest":{"component_or_area":"CodeHealthConfig, metrics system","key_entities":["CodeHealthConfig.enabled","src/rebar/_config_schema.py","src/rebar/_commands/metrics.py","code_health.enabled","REBAR_CODE_HEALTH_ENABLED","module_size_distribution","oversized_module_count","complexity_summary","duplication_summary"],"problem_keywords":["inert config field","config not gated","structural metrics","code health","off switch"],"propositions":["CodeHealthConfig.enabled field is declared but never read anywhere in the codebase; structural metrics evaluate regardless of its value","The field defaults to False but has zero call sites that check it, making it impossible for operators to disable code-health analysis as the documentation claims","The inert-config detection gate cannot catch this because .enabled is read on other config classes, causing false negatives in static analysis","Removal of the field requires tombstone entries in _deprecations.py to warn users who still have it set in their configs, not silently drop it"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787805795690713001,"uuid":"f7d26002-7099-477a-aede-4d8c22ce8e62"}