{"author":"Joe Oakhart","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"b5846eae7879a0289e577bf5c3019cf394792c01282846305c2cfad757fea555","digest":{"component_or_area":"op-cert service configuration","key_entities":["REBAR_OPCERT_PRIVATE_KEY","OpcertServiceConfig.from_env","src/rebar/opcert_service/config.py","_private_key_env","compose_signer","keyprov.py","workspace.py","app.py","tests/unit/test_opcert_privkey_env_pop_932d.py"],"problem_keywords":["credential hygiene","environment variable exposure","secret management","inline PEM","process environment"],"propositions":["REBAR_OPCERT_PRIVATE_KEY environment variable remains in os.environ after OpcertServiceConfig.from_env() reads it, exposing the inline PEM to child processes and environment dumps","Child processes spawned after config load (ssh-keygen, git) inherit the unset REBAR_OPCERT_PRIVATE_KEY variable because it is never removed from os.environ","The inline-PEM secret should be consumed (removed from os.environ) immediately after being read into the config object to minimize exposure window","A second call to OpcertServiceConfig.from_env() in the same process must fail gracefully or return None to enforce single-consumption semantics"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787536332980190001,"uuid":"9db7138f-b75c-47db-a71c-a83ade4a40e2"}