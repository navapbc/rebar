a02c7c0c2130b3bac43276eb2","position":"1795059867630080218-6ba88119-52ab-47fe-a191-5a07abf1dec6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"fe46458ceec649ab8b9680aed7e7876eb6213f4e27c9329bbd6745f3a9b5704e","event_uuid":"be5f19ec-6829-4eef-aae0-47f4bceeaf89","position":{"commit_sha":"b7b8062bfc137aa59667e4889cb01c0dffea645b","position":"1795059876637886260-be5f19ec-6829-4eef-aae0-47f4bceeaf89"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"env_integration","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Root cause (2026-11-18, at 7e442645e51): twine, not packaging, rejects 2.5. The locked packaging 26.2 accepts '2.5' in packaging.metadata._VALID_METADATA_VERSIONS, but twine 6.2.0 twine/package.py overwrites that list with a hardcoded one ending at 2.4. twine 7.0.0 passes the same 2.5 artifacts. The isolated build emits 2.5 because pyproject's open `hatchling>=1.27` resolves to the newest hatchling (1.33.0), while the release lock pins hatchling 1.31.0 (2.4). Fix: `make release-build-check` (scripts/release_build_check.py) repeats release.yml's build job in a fresh temporary venv. Live run on the change's tree: exit 0, wheel and sdist both `PASSED`. twine is not added to the dev extra; the check installs it from the release lock. Portability: stdlib only; the venv interpreter path comes from venv.EnvBuilder's context.env_exe (no bin/ vs Scripts/ assumption), the dist glob is expanded with pathlib (no shell), temp dir from tempfile; no fds, signals or fixed paths. The script is a maintainer tool that no Windows CI job runs, so no Windows sweep dispatch is needed for it.","timestamp":1795035179877759221},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Session 05f74084: change https://rebar.solutions.navateam.com/c/rebar/+/3434 (stacked on 3433; scripts/release_build_check.py, Makefile release-build-check, docs step 1 note, tests/unit/test_release_build_check.py). make verify on chain tip: exit 0.","timestamp":1795044592490659962},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Merged: change 3434 at 70b43262ae755785ac2e5ce1c29145a4ef244d8b (LLM-Review +1, Verified +1). On merged main: `make release-build-check` exit 0, wheel and sdist both `PASSED` by twine; `pytest tests/unit/test_release_build_check.py` passes (36 with the pins file).","timestamp":1795058342470684882}],"completion_expectation":"required","created_at":1794259641612464001,"creation_channel":"cli","deps":[{"link_uuid":"f123b1bc-41a3-45e6-a2b7-0a3696a831ea","relation":"discovered_from","target_id":"c0a9-e8d2-8058-4250"},{"link_uuid":"e3aa7e23-565e-4098-8651-cae2ca6c62c7","relation":"relates_to","target_id":"9fb4-7ed1-d07d-4b7b"}],"description":"## Context / Problem\nA maintainer checking a release locally runs the command docs/releasing.md step 1 gives (`python -m build && python -m twine check dist/*`, docs/releasing.md:339-340). On a correct tree it fails, and the artifact it checks is not the one release.yml publishes, so the local check can neither pass nor predict the release.\n\n## Observation (2026-11-09, release 0.15.0 at ab534d1b382; reproduced 2026-11-18 at 7e442645e51)\n- In a `make worktree` venv, `python -m twine` fails: No module named twine. twine is only in .github/release-requirements.txt.\n- `python -m build` (isolated) resolves pyproject's `hatchling>=1.27` (pyproject.toml:2) to the newest hatchling and produces a wheel and sdist with Metadata-Version 2.5. The release-pinned twine 6.2.0 rejects both: \"InvalidDistribution: Invalid distribution metadata: '2.5' is not a valid metadata version\".\n- Root cause of the rejection is twine, not packaging: the locked packaging 26.2 lists '2.5' in `packaging.metadata._VALID_METADATA_VERSIONS`, but twine 6.2.0 `twine/package.py` overwrites that list with its own hardcoded list that stops at 2.4. twine 7.0.0 (current PyPI) checks the same 2.5 artifacts as PASSED.\n- The release.yml path (fresh venv, `pip install --require-hashes --no-deps -r .github/release-requirements.txt`, hatchling 1.31.0, `python -m build --no-isolation`, release.yml:137-159) produces Metadata-Version 2.4, and twine 6.2.0 `twine check` passes both artifacts.\n\n## Approach\nGive maintainers one command that runs exactly release.yml's build-and-check path, instead of making the isolated build pass: a check that builds with a different toolchain than the release cannot predict the release, whatever twine version it uses.\n- New `scripts/release_build_check.py` (stdlib only, so it runs from any venv on any OS). It creates a fresh venv in a temporary directory with `venv.EnvBuilder(with_pip=True)` (the venv interpreter path comes from the builder context's `env_exe`, so no `bin/` vs `Scripts/` assumption), then runs release.yml's build-job steps in order with that interpreter: `pip install --require-hashes --no-deps -r .github/release-requirements.txt`; `pip freeze` captured to a file and passed to `scripts/check_build_env_locked.py --lock ... --freeze ...`; `python -m build --no-isolation --outdir <tmp>/dist`; `python -m twine check` on the wheel and sdist. It stops at the first failing step, names that step, and exits non-zero; on success it prints the artifact directory. The step list is built by a pure function (`release_build_steps`) so a unit test can compare it with release.yml.\n- New Makefile target `release-build-check` running the script (the same shape as the existing `verify-mcp-pin` target, Makefile:509-510).\n- docs/releasing.md step 1's local sanity line uses `make release-build-check`, with one sentence on why a bare `python -m build` differs (newest hatchling emits Metadata-Version 2.5, which the pinned twine 6.2.0 rejects).\ntwine is not added to the dev extra: the check installs it from the hash-locked release lock, the same version the release uses.\n\n## Scope\n- `scripts/release_build_check.py` (new).\n- `tests/unit/test_release_build_check.py` (new).\n- `Makefile` \u2014 `release-build-check` target and `.PHONY` entry.\n- `docs/releasing.md` \u2014 step 1 local sanity line.\n\n## Testing\n- `tests/unit/test_release_build_check.py`, written first:\n  - parity: every command fragment of release.yml's `build` job steps \"Build sdist + wheel\" and \"Validate metadata\" (`--require-hashes --no-deps -r .github/release-requirements.txt`, `check_build_env_locked.py`, `build --no-isolation`, `twine check`) appears in `release_build_steps()`, in the same order.\n  - failure path: with an injected runner that fails the build step, `main` returns non-zero, does not run twine, and the error names the failed step.\n  - the Makefile defines `release-build-check` and it invokes the script.\n- Live: `make release-build-check` on the change's tree passes (needs network for the pinned pip install), and its output shows Metadata-Version 2.4 artifacts with twine `PASSED`.\n- `make verify` passes.\n\n## Acceptance Criteria\n- [x] A documented local command reproduces release.yml's build and twine check, and passes on a correct tree. Checked: docs/releasing.md names `make release-build-check`, and running it on merged main exits 0 with both artifacts `PASSED`.\n- [x] `pytest tests/unit/test_release_build_check.py` passes on merged main, including the release.yml parity test.\n","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"scripts/release_build_check.py","reason":"new: run release.yml's hash-locked build and twine check locally"},{"path":"tests/unit/test_release_build_check.py","reason":"new: parity with release.yml, failure path, Makefile target"},{"path":"Makefile","reason":"release-build-check target"},{"path":"docs/releasing.md","reason":"step 1 local sanity check uses make release-build-check"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","9fb4-7ed1-d07d-4b7b"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"6ba88119-52ab-47fe-a191-5a07abf1dec6","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"07b5-2e8e-caea-4bef","ticket_type":"bug","title":"Local 'python -m build && twine check' fails a correct release: isolated build emits Metadata-Version 2.5, and twine is absent from the dev venv","verify_commands":[]},"source_event_uuids":["9e333585-7178-4f08-9067-0cf837e9c1ec","683640f0-505b-4382-a22d-dc775bc6bf36","d12e3965-e94f-4506-b946-67efb5a99940","b5bfb652-90bd-4af0-93c8-5edaf88fc017","18891ceb-6ca2-46f8-a1ff-a7a723b7625d","927c68e3-c228-418b-8bce-5faff6228117","a5ef5649-c2b8-4a8b-9ee6-ce062213a07e","e3aa7e23-565e-4098-8651-cae2ca6c62c7","87c094d1-c9dd-4b25-abb6-e74d17442243","3d515f4c-aef0-4397-99ed-9d5f1a673895","61e673db-3c31-4af4-8c92-e258be641e23","6ba88119-52ab-47fe-a191-5a07abf1dec6","be5f19ec-6829-4eef-aae0-47f4bceeaf89"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1795059876637886261,"uuid":"a9c06585-cebc-40aa-92d8-ef4a44cabbce"}
