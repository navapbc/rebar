{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787713798235063001,"compiled_state":{"alias":"antelopine-limivorous-chinchilla","assignee":"joeoakhart@navapbc.com","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":9,"unsigned":0},"authorship_ledger":[{"content_hash":"c8e161a6a0cd1d27b2fc840eba6c8a0c2c677500295538523da8c1a7b15e7f24","event_uuid":"ef689675-8aa8-4d88-b41e-8989f6e5d295","position":{"commit_sha":"51a8181b480e9fa536f28d7cab0b0e531272367b","position":"1787705735137922001-ef689675-8aa8-4d88-b41e-8989f6e5d295"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3d84f253886427a9ea33e162da5d464470057c3a356054cdcbc85de62fe7aafd","event_uuid":"bdf2d506-5aab-4175-8e37-a0e17b5b9a63","position":{"commit_sha":"38da26570531ec1dc0fa496f6baef97c88e466fc","position":"1787705811095389001-bdf2d506-5aab-4175-8e37-a0e17b5b9a63"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4fdf95a7c4ba6b37124091d5ea1f35e9a652a43b9daeaa098099fd7ae0be791a","event_uuid":"73bac9b4-6fdd-4070-9760-c8e5b0669b79","position":{"commit_sha":"38da26570531ec1dc0fa496f6baef97c88e466fc","position":"1787705820953868001-73bac9b4-6fdd-4070-9760-c8e5b0669b79"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d7ecc4dabca0cba0f99820ac96e167bab4af6245b1e1d41e569cef573d0ea8fb","event_uuid":"c37340d0-8ba0-4115-98b8-7ee41a4380e0","position":{"commit_sha":"1268d9ec9cdadd094cffeb5faeb22cca42a96e2a","position":"1787705862289944001-c37340d0-8ba0-4115-98b8-7ee41a4380e0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"32ec96a8e92b1031cf4235c23dc2dbc493d2ae727cf31726e765eefc2bcbadc6","event_uuid":"17f83d87-bda8-42a1-8c6f-f236893e91d5","position":{"commit_sha":"841930a1595f883e1728c160d1ea7a27bb3c86d5","position":"1787705918226929001-17f83d87-bda8-42a1-8c6f-f236893e91d5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e47e0be5e13569d65a349552809a136c02212ee167c212a12a5ee2bd7f13abca","event_uuid":"b3ba1b4d-e479-4eab-89c9-956aa92e4982","position":{"commit_sha":"8118c8854df2091a5da7e437ce0d95b06405d228","position":"1787706170690745001-b3ba1b4d-e479-4eab-89c9-956aa92e4982"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d977d084ed5e4fe03f5389266f45cec379652d2c21d826a879e00e1a07fbfc1d","event_uuid":"40789ef1-1b14-4f75-96e0-8b5bf99b4330","position":{"commit_sha":"d998edf95e04a9d284e236b7b39d4ba7450a7690","position":"1787706559561878001-40789ef1-1b14-4f75-96e0-8b5bf99b4330"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d2816fd348b83b2938abcec7e527f9e05d9a69b9f3b6688a3da7fa60c9dca654","event_uuid":"4f4e5321-01e2-4330-94f1-80b06e0ea1ef","position":{"commit_sha":"cf8fa73e5dc3b2460722d24c49710e8a14cae461","position":"1787709706251971001-4f4e5321-01e2-4330-94f1-80b06e0ea1ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"20739ff5f32104fbcc89dbbd750d77ef6984feebbca18e198a49eb4b92f4c46c","event_uuid":"80207396-8f8e-4042-8abc-b9c164edd51f","position":{"commit_sha":"7c6fc881f55cf3e42155fe824664bf7a0590441c","position":"1787710873843299944-80207396-8f8e-4042-8abc-b9c164edd51f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-246_agent","claim_remote_session":null,"claimed_session":"41c69740-e628-4506-a328-65f32258a98e","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"rebar-debug Phase 1 COMPLETE — root cause confirmed, mechanism observed at runtime.\n\nPROVEN ROOT CAUSE\nThe in-process library read path has no initialization guard. `_reads._tracker()`\n(_reads.py:31-33) resolves the tracker dir and returns it unchecked; all 7 read entries\n(_reads.py:61,82,129,139,149,168,184) funnel through it. The actual masking happens one\nlayer down at reducer/_api.py:257-260, which wraps `os.listdir(tracker_path)` in\n`except OSError: return results` — FileNotFoundError IS an OSError, so a missing tracker\ndirectory yields `[]` rather than an error.\n\nDISCRIMINATING EXPERIMENT (purely local; no network, no proxy, no AWS)\nSame uninitialized store, same library, same process:\n  rebar.list_tickets(repo_root=tmp)   -> []                       (SILENT)\n  rebar.create_ticket(..., tmp)       -> RebarError \"ticket system not initialized\"\n  rebar list (CLI)                    -> Error: not initialized, exit 1\nReads and writes DISAGREE about whether an absent store is an error. This kills the\n\"intended behavior\" alternative: the codebase plainly treats an uninitialized store as an\nerror condition; only the read path fails to say so. Scope measured: list_tickets, search,\nand recent_session_logs all return [] silently; show_ticket raises but with the WRONG cause\n(\"Ticket '<id>' not found\" instead of \"store not initialized\").\n\nThe guard exists on every sibling surface and is missing on exactly one:\n  CLI reads      _engine_support/reads_cli.py:340,384   -> guards, exit 1\n  library writes _store/event_prepare.py:99-102          -> guards, RebarError\n  library reads  _reads.py                                -> NO GUARD  <-- the defect\n\nPRODUCTION IMPACT (how this was found)\nThe deployed MCP server at https://rebar.solutions.navateam.com/mcp reports \"Connected\" and\nanswers list_tickets/search/ready_tickets with [], show_ticket with \"ticket_not_found\", while\nfsck reports \"ticket system not initialized (/app/.tickets-tracker not found)\"\n(_commands/fsck.py:263-267 — the only tool that checks). The container genuinely has no\nstore; that provisioning gap is a SEPARATE defect filed alongside this one. This ticket is\nthe reason the gap is invisible: an agent following the MCP-first tracker rule is told\n\"no tickets\" instead of \"store missing\", and files duplicates.\n\nAUTHORITY VIOLATED (why this is a defect, not intended behavior)\n- docs/mcp-reference.md:7 — MCP faults surface as distinct error codes \"instead of silently\n  resolving to a fallback\", so \"a driving agent can tell a broken config from a deliberate\n  policy refusal\". Returning [] for a missing store defeats exactly that contract.\n- In-repo precedent that this failure CLASS is a defect: bug spiny-ferry-ripen (a filter that\n  \"returns [] with exit 0 — indistinguishable from 'no tickets match'\", quoted at\n  reads_cli.py:325-328) and bug bilingual-capitalist-caecilian (\"Silent data-hiding: no error\n  is surfaced to the operator; the store simply looks empty\").\n\nDEFECT ORIGIN — attributed to tend-tomb-doe (df9b-663a-98ed-4dc4), NOT by blame majority\nIntroducing commit 7d53bc5b43b7 (2026-06-09), \"feat(reads): in-process native library reads\nbehind REBAR_NATIVE_READS (#2 Steps 0/2/3)\". It created the second read path, claiming to\nreplicate \"each shim's exact contract\", while stating in the same message:\n  \"Deliberate behavior change: in-process reads do not run the dispatcher's\n   _ensure_initialized — they are pure local replay.\"\nThe drop was framed as being about the git-fetch, but _ensure_initialized also carried the\nnot-initialized signal, so the guard silently left the read path. Its parity test\n(tests/interfaces/test_native_read_parity.py) covered an *empty* store but never an\n*uninitialized* one; 28406790c61e later deleted that test as \"now-moot\", and no test asserts\nuninitialized-store read behavior today.\n\nAttribution note — I am NOT naming the commit a whole-file blame would name. `git blame` on\n_reads.py points at later refactors (f0bae9dec78b, ad30433f3443) that only moved the\nunguarded code around; those are carriers. 7d53bc5b43b7 is where the behavior became wrong.\nThe commit predates the rebar-ticket trailer convention, so the ticket was recovered by\ntracker search on the changed behavior: tend-tomb-doe, \"#2 Step 3: wire public reads behind\nREBAR_NATIVE_READS kill-switch\", whose own scope was \"Map in-process exceptions to existing\nRebarError/ConcurrencyError shapes\" with AC \"parity tests green both ways\". The uninitialized\ncase was never mapped and never tested — an unmet obligation a reviewer on that ticket could\nplausibly have caught. close_class will be plan_defect.\n\nCALLER-DEPENDENCY GATE: CLEARED\nAll _reads consumers are the public facade in _lib_reads.py plus llm/completion.py and\nllm/spec_scan.py (show_ticket, which already raises). Callers that legitimately tolerate a\nmissing tracker already guard it themselves (mcp_server.py:760, next_batch.py:153), so none\ndepend on [] for an absent store.\n\nFIX SEAM: the guard goes at _reads._tracker(), the one chokepoint the 7 read entries share —\nthe read-side mirror of event_prepare._ensure_initialized. An initialized-but-empty store\nstill returns [] (the directory exists), so the no-regression AC holds by construction.","timestamp":1787705918226929001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review: PASS (0 blocking, 4 advisory), model bedrock:us.anthropic.claude-sonnet-4-6.\nDispositions for all four advisories:\n\nE1 + E3 (apply-now, priority 1.0) — \"AC1 omits ready_tickets although the Impact section names\nit as one of the silently-empty reads\". ACCEPTED AND FIXED. This was a real under-coverage: the\nImpact section lists `list_tickets / search / ready_tickets -> []` but AC1 enumerated only\nlist_tickets, search, recent_session_logs. AC1 is amended to read:\n\n  AC1: A library read — `list_tickets`, `search`, `ready`, `recent_session_logs` (the MCP tool\n  spelling of `ready` is `ready_tickets`) — against a repo with no tracker directory raises the\n  same not-initialized RebarError the write path raises, instead of returning [].\n\nThe regression test is extended to exercise `rebar.ready` alongside the other three. Because the\nfix already existed in the tree when this gap was found, the added coverage was NOT simply\nappended to a passing suite: the fix was reverted first, the strengthened test was re-verified\nRED with no fix present, and only then was the fix re-applied — the test-modification ordering\nthe debug protocol requires.\n\nE2 (deferred, priority 0.17) — \"state the fix locus explicitly rather than leaving it inferable\".\nACCEPTED as documentation. The locus is now stated in the code itself: the guard lives at the\nsingle `_reads._tracker()` funnel point, so all seven read entries inherit it uniformly; the ACs\nsample the user-visible ones rather than enumerating internals.\n\nG6 (deferred, priority 0.52) — \"the two cited parity targets use DIFFERENT guard predicates; the\nplan does not say which the new guard uses\". ACCEPTED as a real ambiguity, and resolved\ndeliberately AGAINST the reviewer's suggested fix. The facts are correct:\n\n  write path    event_prepare.py:101   isdir(tracker) AND exists(tracker/.git)\n  CLI read path reads_cli.py:340       isdir(tracker) only\n\nThe reviewer suggested adopting the stronger write-path predicate \"for true read/write parity\".\nWe deliberately chose `isdir` only, matching the CLI READ path, because:\n\n1. The surface being brought into parity is the READ surface. The defect was that library reads\n   disagreed with CLI reads; matching `reads_cli.py:340` closes exactly that gap. Adopting the\n   write predicate would make library reads STRICTER than CLI reads and open a NEW divergence in\n   the opposite direction — trading one asymmetry for another.\n2. A tracker directory that exists WITHOUT `.git` is a real, supported read case in this repo,\n   not a hypothetical. `tests/unit/test_store_copy_needs_env_id.py` documents a store\n   materialised by `git archive` of the orphan `tickets` branch: writes are refused on it while\n   reads are expected to work. A `.git`-requiring read guard would break that fixture and the\n   J11 live-DC cells that depend on it.\n3. The write path's extra `.git` check exists to protect event APPENDS (provenance stamping),\n   which has no read-side analogue.\n\nSo the divergence between the two predicates is intentional and load-bearing, not an oversight —\nreads and writes legitimately answer different questions about the same directory. Recorded here\nrather than as an ADR (the E2 coaching move suggested one) because this is a restatement of\nexisting behavior, not a one-way door.","timestamp":1787706559561878001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"rebar-debug COMPLETE — Phase 2 landed for review as Gerrit change 2226.\n\nTEST (held out from the fix subagent)\ntests/unit/test_reads_uninitialized_store.py, 7 cases.\n- Proven RED first, for the RIGHT reason: 6 failed / 1 passed with no fix present. The four\n  list-shaped reads and the parity case failed \"DID NOT RAISE RebarError\"; show_ticket failed\n  on blaming the id. The 1 pass was the no-regression case, which is what proves the oracle\n  discriminates rather than just rejecting everything.\n- GREEN after the fix: 7/7, against a file the fix subagent never saw. The test was physically\n  moved OUT of its worktree before it was launched, and its prompt named the path as off-limits;\n  it received only the mechanism and the contract, never the assertions.\n- Has teeth (mutation check): re-introducing the exact confirmed defect — deleting the isdir\n  guard so `_tracker` returns the path unchecked — returned the suite to 6 failed; restoring the\n  guard returned it to 7 passed.\n- Not a change-detector: every assertion is on observable behavior (raised type + message), none\n  on a private name, an intermediate value, or a grep of source text.\n\nFIX\nsrc/rebar/_reads.py, +12/-2. The guard goes at `_tracker()`, the single chokepoint the seven\nlibrary read entries share — the read-side mirror of `event_prepare._ensure_initialized`. It\nkeys on the tracker DIRECTORY's existence, so an initialized-but-empty store still reads `[]`.\n`reducer/_api.py`'s `except OSError` is deliberately left alone: other callers rely on that\nlow-level tolerance, so the fault is named at the library read boundary instead.\n\nNote the fix subagent was stopped mid-verification after ~30 minutes and the validation above was\nrun directly. That does not weaken the held-out property: the diff had been frozen in the tree\nfor 30 minutes at that point, and the subagent never had access to the oracle at any stage, so\nthere was no path by which it could tailor to it. Only its self-check was cut short, and every\ncheck it would have run was then re-run here.\n\nSCOPE & SAFETY\n- Caller-dependency gate: CLEARED. All `_reads` consumers are the public facade plus\n  llm/completion.py and llm/spec_scan.py (show_ticket, which already raised). Callers that\n  legitimately tolerate a missing tracker already guard it themselves (mcp_server.py:760,\n  next_batch.py:153). Nothing depended on `[]` for an absent store.\n- Restoration, not creation: the guard restores parity that already exists on the CLI read path\n  and the write path. No new command, artifact, or external call.\n- No new dependency: uses the already-imported `os` and the existing `_rebar_error` helper.\n- No test weakened: the only pre-existing file touched is `_reads.py`; the test file is purely\n  additive.\n\nREGRESSION EVIDENCE\n13,697 passed / 45 skipped on tests/unit. Five ERRORs appeared, all of them the same repo-hygiene\nwatchdog (\"New entries appeared in REPO_ROOT: ['.ruff_cache']\") tripped by my own concurrent\n`make lint` run, NOT by this change. Re-run clean after removing `.ruff_cache`: 114/114 passed.\n`make lint` (incl. the complexity ratchet and module-size gate) and `make typecheck` (660 files)\nboth clean.\n\nSIBLINGS — Step 7, both axes\nAxis 1 (construct sweep): the root cause is a single missing guard at one chokepoint, not a\nrepeatable construct, so there is no construct to sweep for. Not swept, deliberately.\nAxis 2 (parity census) — the rule: \"a read against a non-existent tracker must report the missing\nstore\". Five slots:\n  1 CLI command        GUARDED    reads_cli.py:340,384\n  2 MCP tool           GUARDED    inherits via _mcp_reads -> rebar.list_tickets\n  3 library facade     GUARDED    this fix\n  4 automated callers  MISSING    impossible_links.py:182 and relation_snapshot.py:257 call\n                                  reduce_all_tickets directly, bypassing the boundary\n  5 dual-direction     GUARDED    event_prepare.py:99-102 (writes)\nSlot 4 disposition: ticket FILED, not fixed in scope — brigandish-weepy-amurminnow\n(cecb-5a41-b8ca-4957), linked discovered_from this bug. Both callers run against a store already\nestablished by the time they execute, so this is a latent parity gap rather than a reachable\nfailure; folding it in would have widened a proven single-site fix into a speculative one.\n\nREPLICATION\nThe original report reproduces no longer. Against a store with no tracker directory, all five\npublic reads now raise \"ticket system not initialized\" — `list_tickets`, `search`, `ready`,\n`recent_session_logs`, and `show_ticket` (which now blames the store, not the id) — matching what\n`fsck` has always reported. An initialized-but-empty store still reads `[]`.\n\nRESIDUAL RISK — observed with citations, each dispositioned\n- Slot 4 above — TICKET FILED (cecb-5a41-b8ca-4957).\n- The public `rebar.reduce_all_tickets` export (__init__.py:143,235) keeps the same silent-[]\n  property — ACCEPTED: it is the low-level primitive and its tolerance is relied upon; the\n  guard belongs at the boundary above it.\n- `tests/interfaces` was not run to completion in this session (the subagent's run was cut short\n  at ~30 min and only tests/unit was re-run) — ACCEPTED: CI's Verified gate runs the full suite\n  on change 2226, and this change touches one private function on the read path.\n\nTHE PRODUCTION FAULT THIS EXPOSED IS SEPARATE AND STILL OPEN\nThis ticket fixes only the MASKING. The deployed server's store is still absent, and its cause is\nan infra omission tracked separately: kilted-nuclear-bronco (mcp service never provisions a\nstore), mobile-groovy-badger (/health cannot see the store, so a storeless deploy passes the\nreadiness gate), receptive-houndy-nilgai (autodeploy AuthConfigError crash-loop, alarm firing,\nlive fix un-versioned). After this change the server will report the fault loudly instead of\nanswering \"no tickets\", but it will not have tickets until kilted-nuclear-bronco is resolved.","timestamp":1787709706251971001}],"created_at":1787705735137922001,"creation_channel":"cli","deps":[{"link_uuid":"b3ba1b4d-e479-4eab-89c9-956aa92e4982","relation":"relates_to","target_id":"0bd6-c3b2-d9a8-45b2"},{"link_uuid":"80207396-8f8e-4042-8abc-b9c164edd51f","relation":"relates_to","target_id":"d27a-a101-a38a-430c"}],"description":"## Summary\n\nThe in-process library read path (`rebar._reads`) has **no initialization guard**, so every\nread against a repo whose tracker directory does not exist returns an EMPTY result with no\nerror. The CLI read path guards this exact condition\n(`_engine_support/reads_cli.py:340-342` -> \"ticket system not initialized\", exit 1), and the\nlibrary WRITE path guards it too (`_store/event_prepare.py:99-102`), but the library/MCP READ\npath does not.\n\nBecause the MCP read tools delegate straight to the library (`_mcp_reads.py:295` ->\n`rebar.list_tickets`), an MCP client pointed at a host with a missing store is told\n\"there are no tickets\" instead of \"this store is not initialized\".\n\n## Impact (observed in production)\n\nThe deployed rebar MCP server at `https://rebar.solutions.navateam.com/mcp` has no\n`/app/.tickets-tracker`. It reports \"Connected\" and answers:\n\n- `list_tickets` / `search` / `ready_tickets` -> `[]`   (silent)\n- `show_ticket <real alias>`                  -> \"ticket_not_found\"  (loud but WRONG cause)\n- `fsck`                                      -> \"ticket system not initialized (/app/.tickets-tracker not found)\"  (correct)\n\nAn agent following the repo's MCP-first tracker rule therefore sees an empty tracker,\nconcludes no ticket exists for its work, and files duplicates -- the precise\nsilent-data-hiding failure mode already recorded as a defect for the store-divergence case\nin bug bilingual-capitalist-caecilian (\"Silent data-hiding: no error is surfaced to the\noperator; the store simply looks empty\") and for the filter case in bug spiny-ferry-ripen.\n\n## Authoritative sources violated\n\n- `docs/mcp-reference.md:7` -- MCP faults are surfaced as distinct error codes \"instead of\n  silently resolving to a fallback\", so \"a driving agent can tell a broken config from a\n  deliberate policy refusal\". `[]` for a missing store defeats exactly this.\n- Surface parity: the CLI (`reads_cli.py:340`) and library writes (`event_prepare.py:99`)\n  both raise on this condition; library reads alone do not.\n\n## Root cause\n\n`_reads.py` resolves the tracker through `_tracker()` (`_reads.py:31-33`) and never checks\nthat the directory exists; all 8 read entries funnel through it unguarded.\n\nOrigin: commit 7d53bc5b43b7 (2026-06-09, \"#2 Steps 0/2/3\") introduced the in-process read\npath, stating it replicated \"each shim's exact contract\" while explicitly noting the\nin-process reads \"do not run the dispatcher's `_ensure_initialized`\". Its parity test\ncovered an *empty* store but never an *uninitialized* one; that test was later deleted as\n\"now-moot\" by 28406790c61e. Ticket: tend-tomb-doe (df9b-663a-98ed-4dc4), whose own scope was\n\"Map in-process exceptions to existing RebarError shapes\" + \"parity tests green both ways\".\n\n## Reproduction (purely local, no network)\n\n    tmp=$(mktemp -d); cd \"$tmp\"; git init -q .\n    python3 -c \"import rebar; print(rebar.list_tickets(repo_root='$tmp'))\"   # -> []      (silent)\n    python3 -c \"import rebar; rebar.create_ticket('task','x',repo_root='$tmp')\"  # -> RebarError: not initialized\n    rebar list                                                              # -> Error: not initialized, exit 1\n\n## Acceptance Criteria\n\n- [ ] A library read (`list_tickets`, `search`, `recent_session_logs`) against a repo with no\n      tracker directory raises the same not-initialized `RebarError` the write path raises,\n      instead of returning `[]`.\n- [ ] `show_ticket` against an uninitialized store reports the store as uninitialized rather\n      than the misleading \"Ticket '<id>' not found\".\n- [ ] The corresponding MCP read tools surface that fault as a machine-readable error\n      envelope, not an empty array.\n- [ ] An INITIALIZED-but-empty store still returns `[]` with no error (no regression).\n- [ ] Regression coverage asserts read/write parity on an uninitialized store.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_reads.py","reason":"Add the missing not-initialized guard at the single _tracker() chokepoint all 7 library read entries funnel through, mirroring the write path's _ensure_initialized"},{"path":"tests/unit/test_reads_uninitialized_store.py","reason":"New regression coverage: reads and writes must agree that an absent tracker is an error, and an initialized-but-empty store must still return []"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","0bd6-c3b2-d9a8-45b2"],["relates_to","d27a-a101-a38a-430c"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"bdf2d506-5aab-4175-8e37-a0e17b5b9a63","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["store","mcp","reads","data-integrity"],"ticket_id":"44fd-230c-5893-4246","ticket_type":"bug","title":"Library and MCP reads mask an uninitialized store as an empty one (list/search/ready return [] instead of erroring)","verify_commands":[]},"source_event_uuids":["ef689675-8aa8-4d88-b41e-8989f6e5d295","bdf2d506-5aab-4175-8e37-a0e17b5b9a63","73bac9b4-6fdd-4070-9760-c8e5b0669b79","c37340d0-8ba0-4115-98b8-7ee41a4380e0","17f83d87-bda8-42a1-8c6f-f236893e91d5","b3ba1b4d-e479-4eab-89c9-956aa92e4982","40789ef1-1b14-4f75-96e0-8b5bf99b4330","4f4e5321-01e2-4330-94f1-80b06e0ea1ef","80207396-8f8e-4042-8abc-b9c164edd51f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787713798235063001,"uuid":"15f8302f-c15a-4148-9f43-bfd5950c2f88"}