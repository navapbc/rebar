orship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"79ef1f3d47d613c5c22be070d509e9a7ed4ffa8d1587954297b68ea9a0bcec33","event_uuid":"19ec8def-453d-471e-8c26-167596ca0eec","position":{"commit_sha":"9e33b46c9d97214d066d396af71b15ff3c258f22","position":"1794971175196940275-19ec8def-453d-471e-8c26-167596ca0eec"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c6eeffe59528cc4697b586b324a9c1ea94028d7e309f1b3ab775114dcae58149","event_uuid":"0dcec9fd-2611-4d24-8a0e-828abf8c6aa2","position":{"commit_sha":"08c31f2b756f0aa3181687eead541d9f45e4ae6f","position":"1794971304442004670-0dcec9fd-2611-4d24-8a0e-828abf8c6aa2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"70790ff6402ccabd21053be3637046a9627ad4b42cc03c27ae4f2ecf3b124f85","event_uuid":"2fa95d93-a3dd-4c9a-818e-5205952f0f89","position":{"commit_sha":"08c31f2b756f0aa3181687eead541d9f45e4ae6f","position":"1794971304460339783-2fa95d93-a3dd-4c9a-818e-5205952f0f89"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e60d1832507f212ac6b285a6828a54c7158fd8e4c148a42ebc9669075320b03d","event_uuid":"2065130b-2661-4208-a96f-01348b8b4369","position":{"commit_sha":"2fa149de16e2ced53fc238c77eb5dd750d17dc19","position":"1794971668037975147-2065130b-2661-4208-a96f-01348b8b4369"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e8538b53f49b221b79cab38a62b0c8405f472fe19e62de7d9956ddd3df9e0ece","event_uuid":"732a680d-3615-4666-bba1-c5123703232f","position":{"commit_sha":"cbf24b9c62725aa9d67e0a2e6d734814b9ce914a","position":"1794978222656529335-732a680d-3615-4666-bba1-c5123703232f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented in local commit 1ae781b63ab (shared with dissocial-unpleasant-adouri and knightly-salty-orangutan).\n\n- `eval_scorers.py`: `_schema_plan_review_findings` (dict + list `findings`, `passes.register_contracts()` then `contracts.response_model_for(\"plan_review_findings\").model_validate`, non-empty `finding`); `emits_valid_findings` now maps to it. `_attributes_criterion` credits an exact case-insensitive `criteria` element match before the old substring check.\n- Measured deviation in the self-registration test: `import rebar` already imports `rebar.llm.plan_review.passes`, so \"passes not in sys.modules\" can never hold in a fresh interpreter. The test instead removes `plan_review_findings` from the contract registry in a fresh interpreter, then scores a Pass-1 output and asserts it passes and that the contract was re-registered. This proves the same thing: the scorer registers the contract itself and does not fall back to review_result.\n- Offline evidence: 44 scorer tests pass; 13 of the new ones fail against origin/main 05c6414358f code, including all 7 parametrized criterion-id specs with the `'dimension'` error.\n- No live run: the failure is a deterministic scorer/shape mismatch, reproduced and verified offline.\n- Portability: pure in-process validation; the fresh-interpreter test uses `subprocess.run([sys.executable, \"-c\", ...])`, an argument list with no shell, fds or POSIX paths.","timestamp":1794971668037975147}],"created_at":1794277673014852001,"creation_channel":"cli","deps":[{"link_uuid":"37e319ae-8c68-40f5-bb8e-4bb7d766654f","relation":"discovered_from","target_id":"81a1-0fc3-496d-4a00"},{"link_uuid":"512b0ba6-8d26-49f0-ae20-657547e737b1","relation":"relates_to","target_id":"3952-3e5b-96bd-4ce0"},{"link_uuid":"732a680d-3615-4666-bba1-c5123703232f","relation":"relates_to","target_id":"4dfb-1cb3-229c-4742"}],"description":"## Problem\n\nIn the live prompt-eval loop (`run_eval` per dataset-bearing spec, `eval-live` job in `.github/workflows/prompt-eval.yml`), seven plan-review criterion specs fail some cases with `review result failed schema validation: 'dimension' is a required property`: plan-review-G7 (6), -ac-process-gate (2), -asserted-capability (5), -decomp-shape (2), -evidence-kind (14), -necessity (2), -no-file-impact (3) (at `REBAR_EVAL_MAX_CASES=12`, 3 epochs). It also appears on origin/main 872e7f6c3fd with Opus 4.8 / Sonnet 4.6, so it is not model-specific.\n\n## Root cause (reproduced offline 2026-11-17, origin/main 05c6414358f)\n\n`emits_valid_findings` is registered as `_schema_review_result` (`src/rebar/llm/evals/eval_scorers.py:425`, `:160`), which validates against the `review_result` schema via `findings.validate_result` (`src/rebar/llm/findings.py:134`); that schema requires `dimension`.\n\nThe seven specs are criterion-id specs: `_criterion_id` (`src/rebar/llm/evals/eval_solver.py:76`) resolves them, so `run_case` uses the criterion arm (`eval_solver.py:101`), which returns Pass-1 findings in the `plan_review_findings` contract shape (`finding`, `criteria`, `evidence`, ... — `src/rebar/llm/plan_review/passes.py:46` `_pass1_model`), never `dimension`. The specs describe the scorer as \"validates against the plan_review_findings contract\". `pass1_chunk`/`pass1_container` normalize findings first (`passes.py:284-301`, `:379-412`): `finding` is coerced with `f.get(\"finding\", \"\")`, and findings with no in-set criterion are dropped.\n\nEvery other consumer of the name is also a criterion-id spec emitting the Pass-1 shape, so none needs an edit and all benefit: `evals/plan-review-gate/fixtures/eval_specs/*.eval.yaml`, `.rebar/evals/plan-review-project-*.eval.yaml` (dotted `project.*` ids), and specs generated by `src/rebar/llm/evals/fixture_emit.py`. The PASS-named specs plan-review-container/-finder/-isf-finder raise \"no eval solver\" today (`eval_solver.py:423`); sibling bug `knightly-salty-orangutan` routes them, and they emit the same shape.\n\nRepro: `run_case(\"plan-review-G7\", <G7 must-fire case>, runner=FakeRunner(findings=[{\"finding\": \"x\", \"criteria\": [\"G7\"]}]))`, then `score(\"emits_valid_findings\", ...)` -> `passed=False, \"'dimension' is a required property\"`. With no findings it passes, so only fired cases were lost.\n\nSame mismatch in `attributes_g3_vs_g4` (`_attributes_criterion`, `eval_scorers.py:287`), used only by plan-review-container: it searches `criterion`/`dimension`/`title`/`detail`, but Pass-1 container findings carry attribution in `criteria`, so a correct G3/G4 finding scores as unattributed once the container spec runs.\n\n## Approach\n\nScore plan-review output against the contract it is produced under, reusing the registered Pass-1 model:\n\n1. Add `_schema_plan_review_findings` in `eval_scorers.py`. Inside the function it imports `rebar.llm.plan_review.passes` and calls `passes.register_contracts()` (idempotent, `passes.py:120`) before `contracts.response_model_for(\"plan_review_findings\")`, so it never falls back to the review_result model (`contracts.py:38-40`). It fails when: output is not a dict; `findings` is absent or not a list; the model rejects it (pydantic message); or any finding's `finding` is empty after `strip()` (the normalized shape coerces a missing claim to `\"\"`).\n2. Register `emits_valid_findings` to it. `emits_valid_review_result` keeps `_schema_review_result` (code-quality, spec-alignment).\n3. `_attributes_criterion` also credits a finding whose `criteria` list contains the case's criterion, by exact case-insensitive element match (`G3` never matches `G33`; `g3` matches `G3`). A finding listing G3 and G4 is credited to each. The existing substring match over the string keys is kept; either source credits.\n\nNo config key, env var or flag is added.\n\n## Scope\n\n- `src/rebar/llm/evals/eval_scorers.py` — new scorer, registry entry, attribution read.\n- `tests/unit/test_eval_scorers.py` — offline tests.\n- `tests/unit/test_eval.py` — the existing `run_eval` tests inject a `solve` returning review_result-shaped findings for `plan-review-finder`, so they reach `emits_valid_findings` directly; migrate them to the Pass-1 shape.\n\nPortability: pure in-process validation. The fresh-interpreter test runs `sys.executable` with an argument list (no shell).\n\n## Testing\n\nOffline, no model:\n- happy path, parametrized over packaged criterion-id specs listing `emits_valid_findings`; first assert the discovered set is exactly the seven above. For each, `run_case` on one must-fire case with a `FakeRunner` firing that criterion; `emits_valid_findings` passes, no message mentions `dimension`. Empty `findings` passes.\n- self-registration: `subprocess.run([sys.executable, \"-c\", ...])` imports `eval_scorers`, asserts `\"rebar.llm.plan_review.passes\" not in sys.modules`, scores a hand-built Pass-1 output, asserts it passes.\n- failure path: review_result-shaped finding (`dimension`, no `finding`), empty `finding`, non-list `findings`, non-dict output each fail.\n- attribution: one end-to-end positive built through `run_case(\"G3\", <first G3 must-fire case of the packaged container spec, which carries `children`>)` (the criterion arm routes it through `passes.pass1_container`) is credited to G3. Then direct scorer calls on hand-built `{\"findings\": [{\"finding\": \"x\", \"criteria\": [...]}]}`: `[\"G4\"]` on a G3 case fails; `[\"G3\",\"G4\"]` passes on a G3 and a G4 case; `[\"G33\"]` on G3 fails; `[\"g3\"]` on G3 passes.\n\n## Acceptance Criteria\n\n- [ ] `emits_valid_findings` validates the `plan_review_findings` contract: for each of the seven criterion-id specs a fired Pass-1 finding from the criterion arm passes, with no `'dimension'` error; checked by a parametrized test in `tests/unit/test_eval_scorers.py` (exact discovered-set assertion) that fails on origin/main 05c6414358f.\n- [ ] The scorer registers the contract itself (fresh-interpreter test passes with `passes` not preloaded) and fails malformed output: review_result-shaped finding, empty `finding`, non-list `findings`, non-dict; checked by unit tests.\n- [ ] `attributes_g3_vs_g4` credits a finding's `criteria` list by exact case-insensitive element match: G3 credited, G4-only rejected on G3, `[\"G3\",\"G4\"]` credited on both, `G33` rejected, `g3` credited; checked by unit tests.\n- [ ] The migrated `tests/unit/test_eval.py` `run_eval` tests pass under the new scorer, and `emits_valid_review_result` is unchanged (existing tests pass).\n- [ ] `make verify` exits 0.\n","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/llm/evals/eval_scorers.py","reason":"score plan-review criterion output against plan_review_findings; read criteria for attribution"},{"path":"tests/unit/test_eval_scorers.py","reason":"offline scorer tests"},{"path":"tests/unit/test_eval.py","reason":"migrate review_result-shaped run_eval fixtures to the Pass-1 shape"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","3952-3e5b-96bd-4ce0"],["relates_to","4dfb-1cb3-229c-4742"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"0dcec9fd-2611-4d24-8a0e-828abf8c6aa2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"246e-71dd-911a-4742","ticket_type":"bug","title":"Prompt evals: plan-review criterion specs fail with \"'dimension' is a required property\" schema error","verify_commands":[]},"source_event_uuids":["eb803565-0437-4d43-8e2d-1cf7b5dccd7d","da59ff54-5390-4dad-be4b-4bf2b829fe7b","36996291-623a-4c02-8a3a-cafa9ad03ab7","271f47f0-6907-42b9-a07d-bd69c0457016","512b0ba6-8d26-49f0-ae20-657547e737b1","9ea52629-f22a-4502-b4bd-eca1b49d0a5a","38264d19-207a-43e3-8f22-1d18ee66620f","19ec8def-453d-471e-8c26-167596ca0eec","0dcec9fd-2611-4d24-8a0e-828abf8c6aa2","2fa95d93-a3dd-4c9a-818e-5205952f0f89","2065130b-2661-4208-a96f-01348b8b4369","732a680d-3615-4666-bba1-c5123703232f"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794978222656529336,"uuid":"dc9e25f6-f4fe-499b-991e-e0d164e92800"}