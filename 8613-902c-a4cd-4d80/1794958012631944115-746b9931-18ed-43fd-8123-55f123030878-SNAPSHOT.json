ae-edaafb414f56","position":{"commit_sha":"9928d3bb9f624b9cac226d7a57e6d1350b037ae7","position":"1794957772058884650-d5e3513a-c792-4897-96ae-edaafb414f56"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"c4da7d9e0eff64e672fd3b0868642aa434e6875f69202b0355aa7b93fb00646c","event_uuid":"83429015-7bf7-465f-9156-4599d995f4a9","position":{"commit_sha":"5231c7df2620eb9d9b38b0ced8fb563aedb492de","position":"1794958004342799674-83429015-7bf7-465f-9156-4599d995f4a9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"31b437aa0e4bb554bbca3909f1b35faa659c5fcd76af95144e1237bdeb976066","event_uuid":"516acce7-3092-43c9-b4b6-9c93f47f5bbd","position":{"commit_sha":"a6fb8b00348e10c08fa4383c71972068b9b107ec","position":"1794958012631944114-516acce7-3092-43c9-b4b6-9c93f47f5bbd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"flaky","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Another instance, 2026-11-16 (worktree cb1b-gate-async-starters, b4e0d01b649 + an MCP-only change, load avg 17-44): `make verify` default tier `1 failed, 21306 passed, 29 skipped in 10519.99s`. The only failure was tests/scripts/test_observability_interrupt_reasons.py::test_each_reason_counter_keeps_its_own_offset, with the same `TimeoutExpired` after 60 s from `run_observability`. The file alone at load ~11: `5 passed in 43.71s`. So a third observability test file is affected, not only the two listed above.","timestamp":1794869523660699512},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Investigation (session rebar-session-3d705fec, origin/main 57d45053272, 2026-11-17 PST, host load 17-51 from other sessions)\n\n### Observation\n- One stubbed run of the rotation-test environment takes 7.4-8.5 s wall and 3.0-3.5 s CPU at load ~30, and starts about 480 short-lived processes. Exec counts via PATH shims: bash 119, dirname 41, tr 38, date 30, perl 26, sed 26, mkdir 20, wc 18, tail 16, head 14, mv 12, plus about 165 subshell forks in the script itself (distinct `$BASHPID`s under `bash -x`). System CPU is higher than user CPU.\n- Roughly 60% of those processes come from the test stubs: 26 clamped journal reads each go through TIMEOUT_STUB (env, bash, perl, forked child) and the JOURNALCTL_EMULATOR (env, bash, tr, wc, tr, sed). The aws stub runs 23 times and the logger stub 20 times, each through `env bash`.\n- Where the wall time goes: the journal-counter section (script lines 400-470) takes about half of each run, and the cap scripts take about 1.5 s.\n- If every stub is replaced by /usr/bin/true and the timeout stub is removed (the lowest cost reachable from test-side changes), a run takes 3.2 s wall and 1.7 s CPU.\n- Replacing TIMEOUT_STUB's 0.1 s polling loop with a blocking `alarm`, and the emulator's tr/wc/sed with bash builtins, cuts an uncontended run from 8.0 s to 5.6 s. CPU drops only from 3.4 s to 2.9 s.\n- test_observability_reviewbot_webhook_auth.py already uses trivial stubs (`timeout` is `exec \"$@\"`, `journalctl` is `exit 0`). It still takes about 4 s per run, so its reported 60 s failure means the run was at least 15x slower than at load 30. The failing default tier took 2 h 59 min, against the documented 22-26 min, so the whole suite was about 7-8x slower.\n- Contention reproduction: K concurrent stubbed runs under `taskpolicy -c background`, each with the harness's 60 s bound:\n  - K=32 (original stubs): 27 of 32 timed out.\n  - K=24: original stubs 24 of 24 timed out; cheaper stubs (alarm + builtin emulator) 24 of 24 timed out; no stubs at all 0 of 24 timed out, but runs took 42-47 s.\n  - K=12: original stubs 47-49 s and cheaper stubs 49-50 s. Under contention the cheaper stubs saved nothing.\n\n### Conclusion\nThe cost driver is process creation, about 480 per run. Under CPU starvation, wall time grows with process count times contention. No hang or blocking stub is involved: every run that was not killed finished. Cutting stub cost does not move the failure point under contention. Removing every stub entirely still leaves runs at 42-47 s under the K=24 contention, about 75% of the bound. So the acceptance criterion \"fix at class level without raising the 60 s bound\" cannot be met by reducing what the test asks the script to do.\n\n## Decision: change what the liveness bound measures, or reduce host contention?\n- The 60 s `run_observability` bound is a hang guard. Wall time cannot tell a starved run from a hung one.\n- About 25 whole-script call sites use it. Some tests run the script twice inside pytest's 300 s per-test budget.\n- The same host-overload class has produced bd66, ddc8, 8e6c, b0f0 and ab03.\n\nWhich way should this bug be fixed?\n(1) Replace the wall-clock bound in `tests/_observability_harness.py` with a no-progress bound (kill when the process group makes no progress for 60 s), plus a hard ceiling under the 300 s per-test budget. The AC gets amended to allow this.\n(2) **Cap concurrent `make verify` runs on this host (a host-level queue) so suites stop running at 7-8x slowdown. The test bound stays as is, and this bug closes against that ticket.**\n(3) Close as `env_integration`: document that the whole-script tests need less than ~8x host oversubscription, with no code change.\n\nStopped here; nothing claimed, no code changed. Scratch evidence lives in the fix-8613-observability-load worktree's .rebar/scratch and is removed with that worktree.","timestamp":1794938411379972890},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Contention re-check with SCRIPT_RUN_TIMEOUT = 135 s (2026-11-17 13:41-13:48 PST, host load 28-60 from other sessions)\n\n### Observation\nConcurrent stubbed runs of the rotation-test environment, each bounded at 135 s:\n- Default scheduling class (the class pytest workers run in):\n  - K=24: 0 of 24 timed out, 34-41 s.\n  - K=48: 0 of 48 timed out, 64-80 s.\n- `taskpolicy -c background`, which limits the runs to the background QoS class:\n  - K=1: 21 s, against 11 s at default QoS.\n  - K=8: 0 of 8 timed out, 52-53 s.\n  - K=24: 24 of 24 timed out at 135 s.\n\nSeparately, every observability test file (237 tests) passed under `-n 4` at load ~78.\n\n### Conclusion and plan correction\nThe Testing section named the K=24 background-QoS run as the re-check. That run stacks 24-way contention on top of background-class throttling, which no `make verify` worker experiences. Covering it would need a tier above 150 s, and then a test that runs the script twice would no longer finish inside pytest's 300 s per-test budget. The operator's budget constraint rules that out.\n\nSo the representative re-check is the default-QoS one: K=24 shows about 3.3x headroom, and K=48 still clears with 1.7x headroom. The Testing section is updated to say this. The 135 s tier is unchanged.","timestamp":1794952173740982776},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed: Gerrit 3418 (LLM-Review +1, Verified +1, revision b7fd6c4272c), merged as fc446d89df7884ed6d2557e79241679dc0c30e81 at 2026-11-17 15:18 PST.\n\nEvidence:\n- `make verify` exited 0 on b7fd6c4272c: 21347 passed, 30 skipped; integration tier 222 passed, 2 skipped.\n- All 237 observability tests passed under `-n 4` at load ~78.\n- The new AST scan failed on origin/main (32 sites) and passes after the change.\n- The default-class re-check passed: 0 of 24 runs timed out (34-41 s), and 0 of 48 timed out (64-80 s).","timestamp":1794957663618378961}],"completion_expectation":"required","created_at":1794869109450205794,"creation_channel":"mcp","deps":[{"link_uuid":"a8ad3369-9bb4-43af-8e47-5a06cf279687","relation":"discovered_from","target_id":"ab03-0276-374b-46af"},{"link_uuid":"09549490-8c07-48f6-83c8-62bc2cd47ede","relation":"relates_to","target_id":"60ab-be94-085a-41a2"}],"description":"## Observation\nA full `make verify` on macOS/arm64 (`PYTEST_WORKERS=4`, 2026-11-16, host load average 40-70 on 18 CPUs, with other sessions' verifies running) ended `4 failed, 21291 passed, 29 skipped in 10796.46s (2:59:56)`. All 4 failures raised `subprocess.TimeoutExpired: ... observability.sh ... timed out after 60 seconds` from `run_observability(..., timeout=60)`:\n- tests/scripts/test_observability_reviewbot_webhook_auth.py::test_reviewbot_webhook_auth_rejections_publish_from_health_payload\n- tests/scripts/test_observability_rotation_2dc7.py::test_shrinking_journal_publishes_zero_not_the_remaining_total[replication_errors-REPL_OFFSET_FILE] and [voter_errors-VOTER_OFFSET_FILE]\n- tests/scripts/test_observability_rotation_2dc7.py::test_markers_after_a_rotation_still_publish\n\nThe same files alone afterwards: `10 passed in 89.99s`. A third file (test_observability_interrupt_reasons.py) failed the same way in another session.\n\n## Root cause (measured 2026-11-17 PST; full evidence in the 09:5x PST comment)\n- No hang is involved. A stubbed observability.sh run spawns about 480 short-lived processes (exec counts by PATH shims). Its wall time scales with process count times CPU contention.\n- Idle cost: one run takes 3-8 s wall and 3-3.5 s CPU at load 30.\n- Under the suite: the failing default tier ran at about 7-8x its documented 22-26 min.\n- Contention reproduction: 24 concurrent runs under `taskpolicy -c background`. With the original stubs, 24 of 24 exceeded 60 s. With cheaper stubs, 24 of 24 still did. With every stub removed, the runs took 42-47 s, about 75% of the bound.\n- So reducing per-run work cannot keep a fixed 60 s bound clear of contention. The bound is a hang guard, and it sits inside the range of legitimate run times.\n\n## Approach (operator decision, 2026-11-17)\nOperator approved on 2026-11-17 after comparing CPython (test.support LOOPBACK/SHORT/LONG_TIMEOUT), Bazel (test size timeouts), Go (-timeout), LLVM lit and pytest-timeout practice: replace the hard-coded 60 s subprocess bound with a named, measured timeout tier.\n- Add one constant, `SCRIPT_RUN_TIMEOUT = 135.0`, in `tests/_observability_harness.py`, the single source for every whole-script observability run. Its derivation comment records:\n  - Normal loaded run: idle 3.5-4 s times the measured 7-8x full-suite slowdown, about 27 s.\n  - 5x that is about 135 s. That clears the 42-47 s worst stub-free contention by about 3x, so a starved run passes.\n  - A real hang still fails in 135 s rather than at pytest's 300 s budget.\n  - A test that runs the script twice spends at most 270 s, under the 300 s per-test budget (pyproject.toml `timeout = 300`), with 30 s left for setup and teardown.\n- The scale lives in code. There is no environment variable, config key or CLI flag.\n- Replace every literal `timeout=60` that bounds an observability script run with `timeout=SCRIPT_RUN_TIMEOUT`. That is 32 sites across 16 files under tests/scripts/ (`grep -rn \"timeout=60\" tests/scripts/test_observability_*.py` lists 33; Serena finds no further references because callers pass a literal):\n  - `run_observability` calls;\n  - the `--report-exit` runs and the census-harness `subprocess.run` calls in test_observability_timeout_9313.py;\n  - the installer run in test_observability_journal_bounding_1205.py:324.\n- Excluded: the one `timeout=60` inside the sample-source string in test_observability_harness_isolation.py:194. That is text the anti-vacuity scan reads, not a bound.\n- Out of scope: the deliberate short bound (`timeout=3`, harness reaping test), and the existing 120/180/300 s bounds, which already exceed 60 s.\n- Hang detection is kept. `run_observability` still raises `subprocess.TimeoutExpired` naming the command and the bound, after reaping the process group.\n\n## Scope\n- `tests/_observability_harness.py`: the `SCRIPT_RUN_TIMEOUT` constant and its derivation comment.\n- The 16 `tests/scripts/test_observability_*.py` files listed above: replace the literal 60 s bounds with the constant (imported from `_observability_harness`).\n- `tests/scripts/test_observability_harness_isolation.py`: 2 regression tests.\n  - An AST scan of `tests/scripts/test_observability_*.py` fails on any call with a literal `timeout=60` keyword. It skips string contents, because a string is not a call.\n  - A check that `2 * SCRIPT_RUN_TIMEOUT` is below the pytest `timeout` ini value read from pyproject.toml.\n\n## Testing\n- Failure path: the new AST-scan test fails on origin/main (32 literal sites) and passes after the change.\n- The budget check passes (270 < 300). It fails if the tier is raised past 150 s.\n- Hang path: the existing `timeout=3` reaping test in test_observability_harness_isolation.py still passes, showing that `run_observability` still raises `TimeoutExpired` on a stalled run.\n- Contention re-check, recorded on this ticket: concurrent stubbed runs of the rotation-test environment at the 135 s bound, in the default scheduling class (the class `make verify`'s pytest workers run in). They must show 0 timeouts at K=24, with K=48 as a headroom check. The background-QoS K=24 run (`taskpolicy -c background`) stacks QoS throttling on top of 24-way contention, which no `make verify` worker experiences. It is recorded as out of envelope: it would need a tier above the 150 s budget ceiling.\n\n## Acceptance Criteria\n- [x] The cost driver of a stubbed observability.sh run is measured and recorded on this ticket.\n- [x] The 4 tests pass with the cause addressed at class level: the bound is a named tier derived from measured durations, applied to every 60 s observability script bound, with no retries. Checked by the new AST scan and the budget check, plus the recorded K=24 contention re-check.\n- [x] `make verify` exits 0.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"tests/_observability_harness.py","reason":"SCRIPT_RUN_TIMEOUT tier constant with derivation"},{"path":"tests/scripts/test_observability_harness_isolation.py","reason":"AST scan forbidding literal 60 s bounds + budget check; its own literal sites"},{"path":"tests/scripts/test_observability_coldstart_e2a6.py","reason":"use tier"},{"path":"tests/scripts/test_observability_data_disk_debris.py","reason":"use tier"},{"path":"tests/scripts/test_observability_disk_pressure.py","reason":"use tier"},{"path":"tests/scripts/test_observability_exit.py","reason":"use tier"},{"path":"tests/scripts/test_observability_interrupt_reasons.py","reason":"use tier"},{"path":"tests/scripts/test_observability_journal_bounding_1205.py","reason":"use tier for installer run"},{"path":"tests/scripts/test_observability_marker_anchor_8c2f.py","reason":"use tier"},{"path":"tests/scripts/test_observability_mcp_health_9ea3.py","reason":"use tier"},{"path":"tests/scripts/test_observability_mcp_markers.py","reason":"use tier"},{"path":"tests/scripts/test_observability_memory_9ea3.py","reason":"use tier"},{"path":"tests/scripts/test_observability_mirror_sync_bff5.py","reason":"use tier"},{"path":"tests/scripts/test_observability_offsets_6a65.py","reason":"use tier"},{"path":"tests/scripts/test_observability_reviewbot_webhook_auth.py","reason":"use tier"},{"path":"tests/scripts/test_observability_rotation_2dc7.py","reason":"use tier"},{"path":"tests/scripts/test_observability_timeout_9313.py","reason":"use tier for report-exit and census runs"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","60ab-be94-085a-41a2"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"83429015-7bf7-465f-9156-4599d995f4a9","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"8613-902c-a4cd-4d80","ticket_type":"bug","title":"Flaky: observability.sh tests time out at their 60 s subprocess bound under full-suite load","verify_commands":[]},"source_event_uuids":["1cd687c4-42ee-4fa8-a82a-2fc228ea8636","a465ed75-bd4c-4264-bd7d-058ce1469335","3e74fbf7-ad08-4b00-bda2-7a0ebc7adfc6","9f9b80c3-319a-4b6d-b9a3-7a2a9613a121","2e531dd2-87e2-4e78-be52-44ca5953d446","52eeed46-4c42-482e-abb3-f439153df980","58916fc6-0e3a-440b-ae72-40f55abb3aa6","09549490-8c07-48f6-83c8-62bc2cd47ede","ba11e0e3-9156-4c4f-8496-3a62aaeda2e5","68323bee-2150-43e0-99da-ca5f28fa1ffa","05fac851-834c-4d20-bf39-8648174f07a6","d5e3513a-c792-4897-96ae-edaafb414f56","83429015-7bf7-465f-9156-4599d995f4a9","516acce7-3092-43c9-b4b6-9c93f47f5bbd"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794958012631944115,"uuid":"746b9931-18ed-43fd-8123-55f123030878"}
