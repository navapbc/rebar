{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"d078ef6781167ad064cf6da48c6ae0fd56b267b5736efac0fe48bbacc8a874ab","digest":{"component_or_area":"Reconcile Bridge monitoring","key_entities":[".github/workflows/reconcile-bridge.yml","infra/terraform/iam_bridge_metrics.tf","infra/terraform/monitoring_bridge.tf","aws_iam_openid_connect_provider.github","rebar/host:bridge_run_failures","rebar-bridge-metrics","rebar-bridge-run-failures","cloudwatch:PutMetricData","AWS_BRIDGE_METRICS_ROLE_ARN","AWS_BRIDGE_METRICS_REGION"],"problem_keywords":["cloudwatch observability","github actions","bridge run failures","oidc authentication","metric publishing"],"propositions":["Reconcile Bridge runs on GitHub Actions but produce zero CloudWatch signal when failures occur, making outages invisible to monitoring and alerting.","Bridge failure visibility relies only on GitHub-native step summaries and annotations, requiring manual inspection of workflow runs rather than automated detection.","CloudWatch alarm on bridge_run_failures metric with 3600s period and threshold 1 detects sustained failures (second failure within an hour) while suppressing transient blips from single failed runs.","OIDC-authenticated GitHub Actions workflow step publishes bridge_run_failures = 1 on failure and 0 on success to rebar/host namespace, with separate narrowly-scoped IAM role granting only cloudwatch:PutMetricData."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787532297716560001,"uuid":"7edc4d7f-a5da-465f-a82e-916153a83145"}