+bot@navapbc.com"},{"content_hash":"9f228056ff0ed8c71cb403477f1dcd37e606fb692cb6a523b16c934abf637fcb","event_uuid":"2af88257-0c00-4d73-a3a7-a009003f21ae","position":{"commit_sha":"85e8612275972e3d93a9d1dc9bfc34e1ddde5702","position":"1786996252156058001-2af88257-0c00-4d73-a3a7-a009003f21ae"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"df36d05cd3222bc04cd7a6f54fa89424e7eea861e291f59650745258d311f22c","event_uuid":"76dcba17-1db0-42ca-b4c6-6fe44837af04","position":{"commit_sha":"8398b4172d9a304fec8a6731d0faf04b770cd880","position":"1786996363255916001-76dcba17-1db0-42ca-b4c6-6fe44837af04"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e1d3659aaea2f945494e65ff86fa0b8724815f4acec0dae3947da73b0a69fb0f","event_uuid":"528d0d08-eda9-4086-8fab-c5ab41b75d77","position":{"commit_sha":"8ac152b69521e74f501e4e8737ef60ae2d088840","position":"1786996386075421001-528d0d08-eda9-4086-8fab-c5ab41b75d77"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"040edb886a71613b1d7ddba04c2f5ad8ca1c9c9d2820802fd7343a94c72f6377","event_uuid":"d1224c52-2353-4b89-b19d-a5b7553d4565","position":{"commit_sha":"fc2a763da9de8bae6368d7de3bb8e14460b09656","position":"1786996587011488001-d1224c52-2353-4b89-b19d-a5b7553d4565"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"696e100de8b48543c8dedb3c142c7ae1c35426f695faeecb8e4c0e07bee1774a","event_uuid":"0233e860-af2b-4153-849e-d8a8c7aa051f","position":{"commit_sha":"14b396ad060133bee3c88f942ebb784f5caf8a53","position":"1786996699065471001-0233e860-af2b-4153-849e-d8a8c7aa051f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"110f95b1af187bc0dc91ad953a233325470ce9fae944c366399e9ca0e0f6348c","event_uuid":"56ae7ccc-cfb5-4a06-8e2d-b3faaab8b671","position":{"commit_sha":"d548a59380001b3b8284b813524d7204e171140a","position":"1786996813400007001-56ae7ccc-cfb5-4a06-8e2d-b3faaab8b671"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cc30ba7bdb96b9e2e5322bb99b2a0a0a57dbaaf027e7b467db956bf00f7279e9","event_uuid":"b12b9f60-9e1a-4035-8b2a-81da0acc94e6","position":{"commit_sha":"d519c77a28d3b5266b2f40103c7595050efe0ae7","position":"1786996950779314001-b12b9f60-9e1a-4035-8b2a-81da0acc94e6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786995147815626001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\nADR 0098 requires one immutable, non-secret configuration authority per operation, but current CLI, library, MCP, and direct reconciler entry points resolve overlapping environment/files/cwd state independently. This first slice establishes a walking skeleton in shadow mode without cutting behavior-bearing consumers over.\n\n## Outcome\nAdd a stdlib-core `OperationSnapshot` and central composer. The snapshot contains validated non-secret effective values, explicit source-kind provenance, the selected repository root, and an envelope version. It is immutable and serializable; live auth objects, secret wrappers/values, provider clients, source-file paths, and subprocess environments cannot be fields or fingerprint inputs. Subsystem projections expose only the fields their owner needs.\n\nComposition precedence is explicit operation input > environment > project config > user config > schema default. “Explicit operation input” is the surface-neutral contract mapped by CLI, MCP, and Python adapters into `resolve_with_sources(cli_overrides=...)`; it retains the existing `cli` provenance source kind and does not create a sixth layer. Repository root is selected independently as explicit `repo_root` > `REBAR_ROOT` > Git top-level/current directory; a winning relative path is interpreted against that root. CLI composes once after parsing and before effects for ordinary ticket/store, LLM-gate, and reconcile commands; Python and MCP compose once per corresponding operation; direct `python -m rebar_reconciler` uses the same compatibility composer once. Long-running process startup policy is not implemented in this slice.\n\n## Plan\n1. Add `src/rebar/_operation_config.py` with frozen snapshot/projection/provenance types, versioned canonical non-secret serialization, and the central composer. Delegate value/provenance loading to `config.resolve_with_sources()`, root selection to `_config_sources.repo_root()`, and serialization/fingerprinting to `_store.canonical.canonical_bytes()`/`content_hash()` with the envelope version inside the hashed document; adapt their results rather than reimplementing precedence, discovery, canonical JSON, or hashing. Re-export the supported library seam from `src/rebar/config.py`, document its supported construction/serialization/projection contract in `docs/reuse-surface.md`, and document the temporary rollback switch in `docs/config.md`; do not add pydantic-settings or a second schema.\n2. Make `src/rebar/_config_sources.py` expose layer inputs to the composer without changing unrelated callers. Move effective operator defaults needed by the slice into `src/rebar/_config_schema.py`; protocol constants remain adapter-owned. The temporary migration switch is `REBAR_OPERATION_SNAPSHOT_SHADOW`, read only at the approved composition boundary, boolean-parsed with the existing config coercion rules, enabled by default, and removed in S7.\n3. Thread one snapshot in shadow mode through the shared command seam, CLI, public library operations, MCP reads/writes/LLM tools, and the direct reconciler entry point. Exercise representative ordinary ticket/store, LLM-gate, and reconcile operations so the design is application-wide rather than a reconciler-only container. Existing execution remains authoritative; shadow comparison emits only version, source kinds, and a redacted fingerprint.\n4. Preserve current behavior except the approved fail-fast rule: malformed selected operation config raises the existing typed config error before lock/network/write. When shadow mode is enabled, catch any other snapshot assembly/fingerprint/diagnostic failure at the integration seam, emit a redacted warning containing no input values or paths, and continue the untouched authoritative legacy operation. Do not persist a snapshot or alter ticket/bridge formats.\n\n## Testing (RED -> GREEN)\n- Interface tests drive representative ordinary ticket/store, LLM-gate, and reconcile operations through CLI, public Python, and MCP plus direct reconciler compatibility with the same five input layers and assert one effective non-secret snapshot/fingerprint.\n- Component tests mutate environment, config file, and cwd after capture: the current snapshot/projection stays byte-stable and a newly composed operation observes the change.\n- Unit/property-table tests cover every precedence pair, root-A versus ambient-root-B resolution, relative-path interpretation, immutable projections, deterministic canonical serialization, and envelope-version rejection.\n- Secret sentinels in known credential environment names and injected capability doubles must be absent from snapshot fields, serialization, fingerprint, repr, equality/hash inputs, provenance, logs, exceptions, and CLI/MCP schemas.\n- Failure spies assert malformed config performs zero lock, subprocess, network, or store writes. Separate injected non-config failures in snapshot construction, serialization, fingerprinting, and warning emission assert that the authoritative operation retains its exact output/effects, a redacted diagnostic is attempted, and no secret/path sentinel escapes. The default-enabled and explicit-disabled switch cases prove the compatibility behavior through the real composition boundary. Existing config/tracker/Jira characterization suites remain green.\n\n## Compatibility / rollback\nShadow composition does not control execution. `REBAR_OPERATION_SNAPSHOT_SHADOW` is enabled by default; setting it to the existing canonical false spelling at the composition boundary disables shadow construction and returns entry points to legacy behavior, including when selected files are malformed. This temporary switch is not read by consumers and is removed in S7. This slice creates no stored-format dependency; rollback is file-level. Intentional precedence/backend cutovers belong to later stories.\n\n## Acceptance Criteria\n- [ ] Given identical five-layer inputs, representative ticket/store, LLM-gate, and reconcile operations through CLI, Python, MCP, and direct reconciler entry points produce the same immutable snapshot values, source kinds, root, version, and redacted fingerprint.\n- [ ] Given environment/file/cwd mutation after capture, the current operation's serialized snapshot is unchanged and a second operation observes the new values.\n- [ ] Explicit input wins each pairwise precedence case, and relative paths resolve against the independently selected repository root.\n- [ ] Snapshot/projection construction rejects secret wrappers and live capability/client objects; secret sentinels are absent from every named serialization/diagnostic/schema boundary.\n- [ ] Malformed selected config raises the typed config error before instrumented lock, subprocess, network, or store effects.\n- [ ] With `REBAR_OPERATION_SNAPSHOT_SHADOW` unset, shadow mode is enabled; every injected non-config shadow construction/serialization/fingerprint/diagnostic failure leaves the authoritative operation's exact output and effects unchanged and exposes no secret/path sentinel.\n- [ ] Setting `REBAR_OPERATION_SNAPSHOT_SHADOW` to canonical false at the composition boundary skips shadow construction and restores the legacy path, while neither switch state changes stored ticket/bridge formats.\n- [ ] `docs/reuse-surface.md` names the supported `OperationSnapshot` construction/serialization/projection contract, and `docs/config.md` records the temporary switch's default, rollback use, and S7 removal.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_operation_config.py","reason":"New frozen OperationSnapshot, provenance, projection, envelope, fingerprint, and central composition seam."},{"path":"src/rebar/config.py","reason":"Supported composition API and compatibility export."},{"path":"src/rebar/_config_schema.py","reason":"Single-source effective operator defaults used by the snapshot."},{"path":"src/rebar/_config_sources.py","reason":"Expose existing config layers to one composer without a second loader."},{"path":"src/rebar/_commands/_seam.py","reason":"Create and carry one shadow snapshot for shared command operations."},{"path":"src/rebar/_cli/__init__.py","reason":"Compose once per CLI invocation after parsing and before effects."},{"path":"src/rebar/_lib_ops.py","reason":"Compose once per Python operation."},{"path":"src/rebar/_mcp_reads.py","reason":"Compose once per MCP read/reconcile operation."},{"path":"src/rebar/_mcp_writes.py","reason":"Compose once per MCP write operation."},{"path":"src/rebar/_mcp_llm.py","reason":"Compose once per MCP LLM-gate operation."},{"path":"src/rebar/_engine/rebar_reconciler/__main__.py","reason":"Direct-module compatibility composition boundary."},{"path":"tests/unit/test_operation_snapshot.py","reason":"Precedence, root, immutability, serialization, fingerprint, and exclusion oracles."},{"path":"tests/interfaces/contracts/test_operation_snapshot_surfaces.py","reason":"Ticket/store, LLM-gate, reconcile, and no-effect failure interface oracles."},{"path":"docs/reuse-surface.md","reason":"Document the supported OperationSnapshot library construction, serialization, and projection contract."},{"path":"docs/config.md","reason":"Document the temporary default-enabled shadow switch, rollback use, and S7 removal."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","e215-ab23-ed6a-4791"]],"no_file_impact_reason":"","parent_id":"e215-ab23-ed6a-4791","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp04","config","walking-skeleton"],"ticket_id":"a377-7fcd-4af0-4d11","ticket_type":"story","title":"RP-04 S1 — Compose immutable operation snapshots in shadow mode","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/interfaces/contracts/test_operation_snapshot_surfaces.py","dd_id":"AC1","dd_text":"Cross-surface snapshot equivalence and no-effect failure boundary"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_operation_snapshot.py","dd_id":"AC2-AC4","dd_text":"Snapshot lifecycle, precedence, root, immutability, serialization, and secret exclusion"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_config_loader.py tests/unit/test_config_cli_overrides.py tests/unit/test_config_tracker_dir.py tests/interfaces/store/test_tracker_config_e2e.py","dd_id":"AC5-AC6","dd_text":"Existing config/tracker behavior remains green in shadow mode"}]},"source_event_uuids":["2393d8c1-bd36-4c7f-b0b2-6f908f80d352","e748854b-f2fa-4972-98bc-71c758c66340","8e6eac11-b3be-4a9b-92ec-fcad43ea88dd","bf5fa309-6c90-4ea3-ad78-970d7b132c90","0d95763f-8d14-4475-82c3-513d073d2cfc","68433a50-709a-42f2-a7e8-bc601309ac13","0d716fa1-6081-4be2-b7f4-e26ef76e078a","3dba9c98-c517-4e8b-8d1c-b8680dbb56ca","2af88257-0c00-4d73-a3a7-a009003f21ae","76dcba17-1db0-42ca-b4c6-6fe44837af04","528d0d08-eda9-4086-8fab-c5ab41b75d77","d1224c52-2353-4b89-b19d-a5b7553d4565","0233e860-af2b-4153-849e-d8a8c7aa051f","56ae7ccc-cfb5-4a06-8e2d-b3faaab8b671","b12b9f60-9e1a-4035-8b2a-81da0acc94e6"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786999213300562001,"uuid":"bc9b0c72-7460-4068-8bdd-da2bf6aa2dde"}