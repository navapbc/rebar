{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786999213300562001,"compiled_state":{"alias":"cotton-only-cuckoo","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"349d91bb270c602b4f13a45924a2ac7bedd71ba1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: a377-7fcd-4af0-4d11","material: c54825ce774e43f9","material-part: children 647ea2107ca5072f 0","material-part: description 7693056a1b0d3190 7439","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact b29887b127c6e282 15","material-part: ticket_id 78877eea202b6a7e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (349d91bb27)","regver: 4f90349cd81c4911","verified-at-sha:349d91bb270c602b4f13a45924a2ac7bedd71ba1","dep 36db2198efafe0e5d14cfad496614d35db5f18e3d3982772a9cc0e287d3a6bb4 docs/config.md","dep ca681d4e2ecf6de41e84977bc58671046de15f44e6dcb7b9f65bf7e4e1a63918 docs/reuse-surface.md","dep 8ddbce1531c7438c1f3ac580dbcb360807d074b21beccd1886813b4ab0827b77 src/rebar/_cli/__init__.py","dep 1211741caee084b193095a7b4f8295c3dcf24368709936c6a3ced197aebb30b6 src/rebar/_commands/_seam.py","dep 7e1109e35b7f817f616ea092b92ba1c9f62c2496ac14412ea806dcf121558cfc src/rebar/_config_schema.py","dep 4a08f7bf1a118f95660f7f58642bb581aed8bc197c187287da99f59171b49582 src/rebar/_config_sources.py","dep b80fd8e33a71971fd31ead8581392217a30512e78c2d8c24f6f9b6ff537d823b src/rebar/_engine/rebar_reconciler/__main__.py","dep eceaf2b02c21b2d5d9312400e54363f6055ad5d0ec2baf844354b12ae79867c2 src/rebar/_lib_ops.py","dep ec31616452152e617857c6d94ee2d050b8dd4e68ee5e0a31f09918b4dbf6730b src/rebar/_mcp_llm.py","dep c5a23d94aaddc2d97b5985e17e449c6ae46261d341997184b243c05ac50e08bc src/rebar/_mcp_reads.py","dep 759531261bb97275bb490b15ddcfe644d003e1f26cf2665533fb1b0cba730f00 src/rebar/_mcp_writes.py","dep absent src/rebar/_operation_config.py","dep 3a0f0c87950f7fbfbafeeeb7179dfdb97fad6670fa175b712feb2b3c8b0b4cb7 src/rebar/config.py","dep absent tests/interfaces/contracts/test_operation_snapshot_surfaces.py","dep absent tests/unit/test_operation_snapshot.py","read-set: 10","read-path: docs/adr/0098-operation-scoped-config-and-provider-composition.md","read-path: docs/config.md","read-path: src/rebar/_commands/_seam.py","read-path: src/rebar/_config_coercion.py","read-path: src/rebar/_config_sources.py","read-path: src/rebar/_mcp_auth.py","read-path: src/rebar/_store/canonical.py","read-path: src/rebar/config.py","read-path: src/rebar/mcp_server.py","read-path: src/rebar/secret_screen.py","currency-basis: file_impact"],"material_fingerprint":"c54825ce774e43f9","merged_log_commit":"349d91bb270c602b4f13a45924a2ac7bedd71ba1","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786996950776320000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"73f2b4dc6c1cf3391abab1be0a6795a108a191035d021b87753fad52cbd7e42d","event_uuid":"2393d8c1-bd36-4c7f-b0b2-6f908f80d352","position":{"commit_sha":"fb149a4351017cfe35f2aed523c7b146a552e7fa","position":"1786995147815626001-2393d8c1-bd36-4c7f-b0b2-6f908f80d352"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8e3cb077d87f93b00