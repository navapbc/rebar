.py","dep 3050b529945b27dab4718ddc63b4b230f4f367deccc02af0ae4e3e5cb646c356 tests/interfaces/store/test_llm_optionality.py","dep 240e15219adfa1f1eae6ff30f973cbe29bea811e012c15bd0122ae64d412409f tests/interfaces/store/test_pass1_fanout_gate_session.py","dep b4d500c26efa5d75f89adcb1062e3cdcba395ae3c7b375ecf834e48a69855dea tests/interfaces/store/test_push_shared_stash_2fa6.py","dep 0abc378c5c96b214ed49374fa3b5335b52de91449fdd800665725858e584def7 tests/interfaces/store/test_reads_under_sync_contention.py","dep bb51d06f8faf83152ef0857dbda0db16db8c28e78dad37c69831f7f81032d010 tests/interfaces/store/test_reconcile_workflow_no_shallow_rebase.py","dep 23248086e7eb53c0a0af0dfb36cdd4e4b654299c34533994c8e60ad0ae6d4f65 tests/interfaces/store/test_reconciler_apply_bindings.py","dep d6d35e2416241baed48b7c83211f6c40e456367da9a125fd90c2f08480dbff3b tests/interfaces/store/test_reconciler_apply_bindings_engine_identity.py","dep 733c3da86671db6e52cbbb227c8fdf5076ba127996bd63f017ccb2414d3f12ee tests/interfaces/store/test_reconciler_operation_bindings.py","dep d6d8dedc7d0c6eb280e2aec8ac299557840b892b2c8ad60eebb153cf68498ce9 tests/interfaces/store/test_review_as_workflow.py","dep 66368f3747d304064a38013923b2b20b9b1ebd1dbf77c0d741c6fdabcb1deb94 tests/interfaces/store/test_review_regressions.py","dep 61a9ed403d7b789158690a63faafffe2ae7a3670c617639eb40709a84be5da8d tests/interfaces/store/test_show_no_stall.py","dep bc9ef673e9c03e810358e43279458621d9049d08ed9fb8f081b69ca31d68576a tests/interfaces/store/test_txn_transient_retry.py","read-set: 4","read-path: scripts/check_comment_hygiene.py","read-path: tests/interfaces/store/test_push_shared_stash_2fa6.py","read-path: tests/interfaces/store/test_reconciler_apply_bindings.py","read-path: tests/interfaces/store/test_reconciler_apply_bindings_engine_identity.py","currency-basis: file_impact"],"material_fingerprint":"71dc82b293be6ae1","merged_log_commit":"88c90f8b5abf4a80be3b1289d7719d6e03e29684","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","