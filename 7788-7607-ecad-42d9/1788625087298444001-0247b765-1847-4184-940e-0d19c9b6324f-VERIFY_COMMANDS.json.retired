{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nowners=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef norm(ref,path):\n source=subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\n tree=ast.parse(source,type_comments=True)\n for node in ast.walk(tree):\n  if isinstance(node,owners) and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str):\n   node.body=node.body[1:]\n for item in tree.type_ignores:\n  item.lineno=0\n return ast.dump(tree,include_attributes=False)\nbad=[p for p in sys.argv[1:] if norm(\"HEAD^\",p)!=norm(\"HEAD\",p)]\nassert not bad,f\"normalized AST changed: {bad}\"' tests/interfaces/store/sync_contention_harness.py tests/interfaces/store/test_atomic_ticket_dir_create_021d.py tests/interfaces/store/test_event_append_transient_retry.py tests/interfaces/store/test_execution_mode_dispatch.py tests/interfaces/store/test_git_contention_9305.py tests/interfaces/store/test_inline_write_push.py tests/interfaces/store/test_llm_optionality.py tests/interfaces/store/test_pass1_fanout_gate_session.py tests/interfaces/store/test_push_shared_stash_2fa6.py tests/interfaces/store/test_reads_under_sync_contention.py tests/interfaces/store/test_reconcile_workflow_no_shallow_rebase.py tests/interfaces/store/test_reconciler_apply_bindings.py tests/interfaces/store/test_reconciler_operation_bindings.py tests/interfaces/store/test_review_as_workflow.py tests/interfaces/store/test_review_regressions.py tests/interfaces/store/test_show_no_stall.py tests/interfaces/store/test_txn_transient_retry.py