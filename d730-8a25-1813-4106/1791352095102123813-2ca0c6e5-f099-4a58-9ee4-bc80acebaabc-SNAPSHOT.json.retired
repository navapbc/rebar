{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1791352095102123813,"compiled_state":{"alias":"idiotproof-bigboned-cornsnake","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"0ca99c39f90892a276ea2ae3f2cde30911b76466","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: d730-8a25-1813-4106","material: f6a3e9d61addb09c","material-part: children 647ea2107ca5072f 0","material-part: description 7d8783f4fedd947b 3372","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 4e5a6882160c8ed4 5","material-part: ticket_id cbaceec6e13a8474 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:02a4c71a519e9ec6115969243b2d1a186d6c4c11","dep 67b5d491be73b23428fc5d525fe790c960f1654856fe36471969f9139cc8ea6e src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","dep 4295e2b760268a1cb4a44b9603d5909a19f712ac9de11a91d6e0d49f5e25fc29 src/rebar/_engine/rebar_reconciler/adapters/jira/acli_graph.py","dep 122332827b381710ddb24129d70e64b836e755168b97b0db55bcbc32d444c9fb tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","dep 81b3c7243ee68789c0bc110c42e052fc2386bd67a59254b9769d3063f995642a tests/unit/rebar_reconciler/test_acli_search_cache_freshness.py","dep absent tests/unit/rebar_reconciler/test_acli_search_pagination.py","read-set: 8","read-path: .rebar/criteria_routing.json","read-path: .rebar/prompts/plan-review-project-failure-disposition-contract.md","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_graph.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_rest.py","read-path: src/rebar/_engine/rebar_reconciler/fetch_paging.py","read-path: tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","read-path: tests/unit/rebar_reconciler/test_cloud_rate_limit_sweep_heldout.py","currency-basis: file_impact"],"material_fingerprint":"f6a3e9d61addb09c","merged_log_commit":"02a4c71a519e9ec6115969243b2d1a186d6c4c11","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1791349514380489694}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"6ba08a8f2026fc7ac1fafd90bd11b7e19de4ae53f76159f7b9677aedbf49b670","event_uuid":"c34af9da-b6bb-4ba3-9cbd-6cd94e48b2ab","position":{"commit_sha":"ce5da87077194b59949893f1c079638c8bbf2fae","position":"1791348411063331002-c34af9da-b6bb-4ba3-9cbd-6cd94e48b2ab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2966d3490419e8bef578dba52f3f10da34f782f3a5ec118c0fb9b69ee8a24330","event_uuid":"07db2694-0452-42e4-9f01-f08a2a9667fc","position":{"commit_sha":"ce5da87077194b59949893f1c079638c8bbf2fae","position":"1791348411090582224-07db2694-0452-42e4-9f01-f08a2a9667fc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6b2a6efeb5e2d757ac99506f699303712c940289bcf66391e546bbbdfc6af3fa","event_uuid":"6a7b78f2-d88d-424d-abf8-49596a360f49","position":{"commit_sha":"77ab7563c12f0719f1a29c883923a956b5e883a4","position":"179134842946910