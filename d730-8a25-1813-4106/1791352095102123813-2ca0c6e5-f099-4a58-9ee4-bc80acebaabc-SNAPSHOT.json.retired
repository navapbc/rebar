gnatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0a502b4d80df2c0f83221c53444d1272fc0e0e36d536a6228a558bda79bab146","event_uuid":"9a2303a9-973b-412c-a41f-eaf28b9f0e2d","position":{"commit_sha":"216092cd7010f85247abb23bd4d4d221fb36a89f","position":"1791349243848533168-9a2303a9-973b-412c-a41f-eaf28b9f0e2d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"372f2948406c5a08dfd553d0d15be0db5ae1ce229aef0c4b128921d8852e7c0e","event_uuid":"971d1c5a-ac93-4a26-a51b-0953941d5ba2","position":{"commit_sha":"6f8c175af4b05ba5a82cb91da147f899dcd38ea3","position":"1791349319277534159-971d1c5a-ac93-4a26-a51b-0953941d5ba2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"807c1634d364a619d39cfbcf2b922948ce4c2772b501089856ab6fa917f31b0a","event_uuid":"51594412-9234-426c-b224-bed4844bcdcd","position":{"commit_sha":"f19766e5744514ecb496a44a81832d16337fcff4","position":"1791349502541883264-51594412-9234-426c-b224-bed4844bcdcd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0111879e6dcaa0f4850aa70ea50cb2bda811e018993bd2337c9fb968fc53e786","event_uuid":"a514cc57-5dbe-41e8-87c8-46fa59dd8694","position":{"commit_sha":"ce5ca522d577cb95590d0cbcd8e1e4583141e40c","position":"1791349514380749012-a514cc57-5dbe-41e8-87c8-46fa59dd8694"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1ea5b2c9f1b5a7914de39613fdc935e6ea8d12d279dc5e1659e1b30801fd9f25","event_uuid":"645bf9fb-5d49-4ec2-a72d-82bda351a737","position":{"commit_sha":"136c839b995d7869c0037a3769562375ff7546f3","position":"1791349660380757117-645bf9fb-5d49-4ec2-a72d-82bda351a737"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2a685b30484aad74c94bcb06224ef42ac1126bb33e5544673eef016c6f83228f","event_uuid":"a004a01a-a0a3-41d3-83eb-37584fe1156d","position":{"commit_sha":"899d2ed93247842b00872b11f6637c9d71d391ee","position":"1791351837621468643-a004a01a-a0a3-41d3-83eb-37584fe1156d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fdc5a4f12252a4219d1086f22ba95345186aec459abad5cc5c6f6f100da1df0f","event_uuid":"79a71294-fd1d-448f-adb8-ad7fc576ed7c","position":{"commit_sha":"ffc6be54f75341c898bfce94386f9d5e0fabbe39","position":"1791351981478560285-79a71294-fd1d-448f-adb8-ad7fc576ed7c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"873578a6d053ae0881bf7db57cae3954051655a96943ed4ca4dec239d23922cb","event_uuid":"41c34ed1-9ce7-4acb-97a1-c8d177e85174","position":{"commit_sha":"c7161d360c98aa3f7ea35fb0218c3113fb62b315","position":"1791352095102123812-41c34ed1-9ce7-4acb-97a1-c8d177e85174"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Claimed for autonomous remediation through Gerrit and live verification. Next: reproduce/timing probes of Done search, compare paging paths, establish root cause before edits. Memento technical/process recall attempted; both failed because Neo4j at 127.0.0.1:7687 is unavailable. Using repository docs and tracker evidence. No override used; claim succeeded normally.","timestamp":1791348429469103062},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Root-cause experiment: live REST read of identical Done query/fields returned 5,276 tickets, 34,960,514 bytes, 53 pages, 33.503 seconds. First 1,000 took 7.047 seconds / 6,777,061 bytes; slowest page 0.971 seconds. Local ACLI 1.3.39 --limit 1000 returned exactly 1,000 in 24.361 seconds; --paginate comparison pending. Existing AcliClient.search_issues eagerly downloads all results with --paginate, then slices locally; fetcher's _DONE_RECENT_CAP=1000 therefore does not bound transport. Proposed remediation: on-demand Jira REST cursor pages using existing REST transport/cursor helper, preserving offset-slice, cache invalidation, field and caller cap contracts. No timeout increase. Will prove bounded reads and failure behavior with regression tests, live probe, make verify, Gerrit gates, and live main workflow.","timestamp":1791348711565020741},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Confirmed reproduction with CI-pinned ACLI 1.3.19 (macOS arm64 build): original full Done search timed out at 120.011s; same fields/JQL with --limit 1000 succeeded in 24.054s. Fixed AcliClient via existing REST cursor path + fetch_paging.collect(cap=1000): 1000 issues, 10 requests, 6.747s. Regression failed on original eager path and passes on fix. Focused paging/cache/shared-cursor/subprocess suite: 83 passed. make lint passed. Full parity probe and make verify next. Evidence files live in worktree .rebar/scratch/d730-20261006-probes; no production timeout or telemetry changes.","timestamp":1791349049947646947},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Live parity: fixed REST search and CI-pinned ACLI --limit 1000 return identical ordered keys. All non-URL leaf fields match across 1000 tickets. Differences are only Jira gateway vs tenant URL forms in issuetype/priority/status self/iconUrl, statusCategory.self and assignee.self. Running existing inbound_fields._map_jira_to_local_fields on both payloads yields 0 canonical-field mismatches across all 1000. make verify running; lint, typecheck (772 source files) and import guard passed. No payload normalization or timeout configuration change introduced.","timestamp":1791349243848533168},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Additional live regression check: uncapped active-query drain returned 292 unique tickets in 2.524s, 3 requests, maximum page 0.915s. Local structured code review (spec compliance, quality, domain integrity) passed; saved under worktree .rebar/scratch/d730-20261006-probes/.reviews/codex-bridge-done-timeout.md. Canonical baseline mapping was inspected: arbitration maps stored vendor fields before comparing, so gateway/tenant URL differences do not change ticket-field decisions. Full make verify is running without reported failures so far.","timestamp":1791349502541883264},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review PASS, current certified attestation. Advisory clarification: search uses existing REST failure policy unchanged. Network timeout/connection failures are transient and get that transport's bounded retries. HTTP errors (including transient 429/503) propagate after one HTTP attempt and fail the current pass; this fix adds no retry wrapper. Malformed pages and stalled cursors are fatal for the current search/pass. Any raised search evicts partial cache before propagation; an explicit later search or a later scheduled pass starts afresh, rather than treating failed partial results as complete. Local tests cover HTTP 429 propagation/cache recovery and fatal malformed/stalled responses. Full make verify has reported a test failure; awaiting complete output before remediation.","timestamp":1791349660380757117},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Initial macOS make verify completed: 20 failed, 20333 passed, 107 skipped, 50 setup errors, 36m47s test duration. Root causes: new dataclass fails legacy importlib loaders without sys.modules registration (replaced with plain typed state holder); transport census needs new read helpers accounted (updated); interface fake ACLI no longer supplies REST search (added loopback HTTP fixture shared across library/MCP/CLI tests). Renderer failures require documented native pandoc 3.9; supplying it clears rendering failures but hits existing frenzied-snively-llama provenance defect (darwin-arm64 hash is x86_64). Running full verify on isolated Linux x86_64 rather than altering that unrelated gate. Temporary AWS runner i-0102ecad99a7cbf6d, SG sg-064d928ba06d0e5d9, key rebar-d730-1791351788, no instance role, SSH limited to this caller IP. Cleanup required after verification. Local evidence/keys in worktree .rebar/scratch/d730-20261006-probes.","timestamp":1791351837621468643},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"All 183 affected adapter/cache/cursor/subprocess/cross-mixin/field-coverage/census/interface tests pass (59.00s). Plain typed _SearchResult initialization preserves standalone importlib loader compatibility. Shared loopback REST fixture preserves actual library/MCP no-write preview and CLI lock-contention behavior; production TLS configuration is unchanged. Linux x86_64 runner passes pinned pandoc provenance (1 passed), confirming the isolated local macOS mismatch. A comment-length lint error was corrected before the Linux full test run. Full make verify on the final patch is running in the isolated Linux checkout using its own canonical .venv.","timestamp":1791352095102123812}],"created_at":1791324542755005377,"creation_channel":"mcp","deps":[{"link_uuid":"d8e183cd-675e-41c2-a279-2f628299a6f5","relation":"discovered_from","target_id":"d8e3-96a2-1c1f-4625"}],"description":"## Context / Problem\nOn October 6, 7 of the first 15 hourly bridge runs failed at the 120s ACLI Done-ticket search; run 37541199419 later failed identically. AWS rebar-bridge-run-failures alarmed. AcliClient.search_issues (adapters/jira/acli.py) downloads the complete JQL result with --paginate before slicing; fetcher._DONE_RECENT_CAP=1000 therefore does not bound network work. Live REST probe: 5,276 Done issues, 53 pages, 34,960,514 bytes; first 1000 took 7.047s versus 33.503s for all results. Local ACLI --limit 1000 took 24.361s. Evidence is in linked investigation loony-osmophilic-bass and comments.\n## Approach\nReplace eager CLI search with demand-driven REST cursor pagination using the existing Jira search endpoint and transport. Preserve search_issues(jql,start_at,max_results), requested fields/order, per-JQL memoization and invalidate_search_cache. Fetch only enough pages to satisfy the requested slice; let the existing fetcher cap stop further requests. Use existing _iter_cursor_pages guard and AcliRestMixin._direct_rest_post_json rather than introducing a backend, dependency or configuration. Keep cursor progress checked before emitting a stalled page. Reject malformed search responses; invalidate a partially failed search so a later attempt cannot silently reuse a truncated result. Preserve negative-result caching and cache independence across JQLs. Preserve other Cloud reads/writes and Data Center behavior. Do not increase the timeout or suppress failure metrics.\n## Scope\nsrc/rebar/_engine/rebar_reconciler/adapters/jira/acli.py: demand-driven search/cache. adapters/jira/acli_graph.py: existing cursor validation before page delivery if required. tests/unit/rebar_reconciler/test_acli_search_cache_freshness.py: existing memo behavior at REST seam. New test_acli_search_pagination.py: transport paging regressions. state/test_acli_subprocess_timeout.py: remove migrated REST read from subprocess-only census. Amend stale search-path documentation where directly affected.\n## Testing\nRegression with 5,276 simulated Done issues must reach the real AcliClient through fetch_paging.collect(cap=1000), return exactly 1000, and request only those pages; pre-fix path must fail. Cover continued active pagination, short and empty pages with live cursor, cursor stall, out-of-order slice calls, per-query/full invalidation, negative cache, HTTP/malformed-response failure and retry without partial-cache poisoning. Run affected Cloud/fetch tests, make verify, and normal Gerrit review/CI gates. Live read probe compares bounded returned keys and fields to baseline; run the merged main workflow and inspect actual reconcile result and telemetry.\n## Acceptance Criteria\n- [ ] Real Cloud search lazily fetches requested slices while preserving fields, order, cache freshness and uncapped active traversal; focused tests pass, including cap regression failing on old behavior.\n- [ ] Failed or stalled page reads fail loudly without returning a partial successful result; error/recovery tests pass.\n- [ ] make verify passes and the change merges through LLM-Review +1, Verified +1, no unresolved comments.\n- [ ] [non-codebase] Record live bounded-query timing/count evidence, successful merged-main bridge runs and AWS alarm OK with Seattle timestamps. Recurring timeout path is removed; incidental unrelated warnings are accounted for explicitly.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","reason":"Lazy REST search and legacy loader-compatible state holder"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_graph.py","reason":"Validate cursor progress before yielding"},{"path":"tests/unit/rebar_reconciler/test_acli_search_cache_freshness.py","reason":"Preserve freshness behavior at REST seam"},{"path":"tests/unit/rebar_reconciler/test_acli_search_pagination.py","reason":"Cap and paging failure regression coverage"},{"path":"tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","reason":"Subprocess read census after REST migration"},{"path":"tests/unit/rebar_reconciler/test_cloud_rate_limit_sweep_heldout.py","reason":"Classify new REST read helpers"},{"path":"tests/interfaces/conftest.py","reason":"Loopback REST fixture for actual bridge entry points"},{"path":"tests/interfaces/facades/test_bridge_programmatic_e2e_heldout.py","reason":"Wire no-write preview test to REST fixture"},{"path":"tests/interfaces/store/test_bridge_preview_under_sync_contention_heldout.py","reason":"Wire lock-free CLI preview test to REST fixture"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"c34af9da-b6bb-4ba3-9cbd-6cd94e48b2ab","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"d730-8a25-1813-4106","ticket_type":"bug","title":"Bridge Done-ticket ACLI search intermittently exceeds 120s, triggering recurring AWS alarms","verify_commands":[{"command":"pytest -q tests/unit/rebar_reconciler/test_acli_search_pagination.py tests/unit/rebar_reconciler/test_acli_search_cache_freshness.py tests/unit/rebar_reconciler/test_acli_graph_pagination_heldout.py tests/unit/rebar_reconciler/state/test_acli_subprocess_timeout.py","dd_id":"AC1-AC2","dd_text":"Lazy cap, paging failure, and freshness contracts"}]},"source_event_uuids":["c34af9da-b6bb-4ba3-9cbd-6cd94e48b2ab","07db2694-0452-42e4-9f01-f08a2a9667fc","6a7b78f2-d88d-424d-abf8-49596a360f49","1e41c722-8fbb-49c5-9d6a-f3dfe82d7951","9d4eb1d3-be4c-4daa-9458-a6b1edba4f17","1302837a-16e5-4e19-9a86-1a22607a5b7b","44797b47-d9ec-4d4d-afe1-e0817197679d","9a2303a9-973b-412c-a41f-eaf28b9f0e2d","971d1c5a-ac93-4a26-a51b-0953941d5ba2","51594412-9234-426c-b224-bed4844bcdcd","a514cc57-5dbe-41e8-87c8-46fa59dd8694","645bf9fb-5d49-4ec2-a72d-82bda351a737","a004a01a-a0a3-41d3-83eb-37584fe1156d","79a71294-fd1d-448f-adb8-ad7fc576ed7c","41c34ed1-9ce7-4acb-97a1-c8d177e85174"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1791352095102123813,"uuid":"2ca0c6e5-f099-4a58-9ee4-bc80acebaabc"}