{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786992515691411359,"compiled_state":{"alias":"miniscule-unschooled-snowmonkey","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"81c3e9ec86d5fda18258e53e9fc9887d86251f45","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 23e9-cad1-64bf-4bb7","material: 4d5480f1a51e0232","material-part: children 647ea2107ca5072f 0","material-part: description 893daabe7fa2c44d 5218","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 0dc01bd3ee7c0caa 4","material-part: ticket_id ad1cce947f1c69b5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (81c3e9ec86)","regver: 4f90349cd81c4911","verified-at-sha:f0275172d1d60873293179128479777f89af62f9","dep absent docs/adr/.numbers/0098","dep absent docs/adr/0098-operation-scoped-config-and-provider-bindings.md","dep f25f2b7b8685003af843d2ec26601785d43fe32199b3e6d4c7f6c79844ac60d4 docs/adr/README.md","dep 2918e4254cf3a1e6e40ef9f94a3888ed1178646869f44cfe82c263c44a016618 docs/architecture.md","read-set: 8","read-path: .joe-janitor/tools.md","read-path: docs/adr/0008-secrets-source-ssm.md","read-path: docs/adr/0049-opcert-asymmetric.md","read-path: docs/adr/0059-llm-provider-seam-and-support-tiers.md","read-path: docs/adr/README.md","read-path: docs/architecture.md","read-path: scripts/check_adr_numbers.py","read-path: scripts/gen_adr_index.py","currency-basis: file_impact"],"material_fingerprint":"4d5480f1a51e0232","merged_log_commit":"f027517