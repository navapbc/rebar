5519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787889814329741001,"creation_channel":"cli","deps":[{"link_uuid":"721683aa-a039-43f3-b666-31c28954c0a8","relation":"discovered_from","target_id":"734d-0998-c47c-48d9"}],"description":"Follow-up to the MCP cross-session warning story (734d). That story covers all single-ticket MUTATION tools plus show_ticket, including transition_ticket/reopen_ticket (via an additive dict key). Three single-ticket tools remain deferred because they return a contract the additive approach cannot ride without a breaking or disproportionate change: check_ac and quality_check return GateResultOut (READ_ONLY gate-verdict tools sharing one model, not the mutation the feature targets), and declare_no_file_impact returns a bare 'ok' str whose outputSchema would have to change type. Extend the cross-session warning to these three (a new optional field on GateResultOut for check_ac/quality_check; a return-shape change for declare_no_file_impact). The CLI surface already warns on the corresponding verbs, so this closes the remaining MCP structured-response parity gap.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"83aa-153e-4ff1-4300","ticket_type":"task","title":"MCP: carry cross_session_warning in dict/GateResult-returning single-ticket tools","verify_commands":[]},"source_event_uuids":["fa63bee0-625e-45f5-8088-4ea70c9b6314","721683aa-a039-43f3-b666-31c28954c0a8","2bf42776-b238-4812-8b0a-78b2583ab30a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787894807052224001,"uuid":"9fd892ac-69c5-4570-98e8-781210373ddc"}