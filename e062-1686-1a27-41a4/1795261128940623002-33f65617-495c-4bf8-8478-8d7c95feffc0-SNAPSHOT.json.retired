01-faf5ec2f-21d9-4ac6-a55a-ad4588987d5e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"b8c45df77810060597edad6accdc9dc29aa1f7ca9424c5bdaa0aec59383a4b07","event_uuid":"ad42a3ec-4ce2-40cb-94af-9717d3e16f89","position":{"commit_sha":"6235599b8ebad0d0390fa85da13b0a5992da4940","position":"1795258213717665001-ad42a3ec-4ce2-40cb-94af-9717d3e16f89"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"2c076390a09890673870398623be77720023a3c1ee726b82f57da3beb868babc","event_uuid":"fe69a8d9-31ff-45b3-8c17-5bdd5cf52887","position":{"commit_sha":"6235599b8ebad0d0390fa85da13b0a5992da4940","position":"1795258228894809001-fe69a8d9-31ff-45b3-8c17-5bdd5cf52887"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"6b8980e49b86e5e0d6c21698e37b89c0e0c14621376f54076f0e2cc1ec82f149","event_uuid":"0ec98d92-fbf7-4483-b33a-c343121617a4","position":{"commit_sha":"eadb03de5c6aa72dc7f8dbfdba8dc10708bc1a71","position":"1795261128940623001-0ec98d92-fbf7-4483-b33a-c343121617a4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"One more test in this class, new on main since the triage: tests/interfaces/store/test_repair_pause_ownership_store.py::test_a_slow_local_git_call_does_not_fail_the_repair_pause (added by ce11e259f8e, 2026-11-19). It writes a shebang git shim into a PATH directory; on Windows the shim never runs, so its call log delayed-update-refs is never written and read_text raises FileNotFoundError (test_repair_pause_ownership_store.py:626). It fails in main dispatch run 44838478830 at 459ad3874dd, sweep (windows) job 136640714807, the only failure there. breezy-hogged-mastiff's change adds its line to posix-shell-stubs.args.","timestamp":1795229486338994001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Design notes (2026-11-21 PST, origin/main 863abe7cd19). Census of the 56 lines (23 modules): 15 modules write '#!/bin/sh' stub executables onto PATH, 6 run bash/sh/make directly, test_repo_isolation_guard writes '#!{sys.executable}' scripts, and test_metrics_polyglot / test_serena_grep_reminder_hook / test_check_readme_quickstart / test_repair_pause_ownership_store use other spawn paths, each needing a per-module read. Why the stubs never run: subprocess on Windows calls CreateProcess, which looks up a bare name like 'git' on PATH by appending '.exe' only. It ignores PATHEXT, so neither a shebang file nor a 'git.cmd' shim can shadow git.exe. And 'bash' on the runner's PATH resolves to the WSL launcher (UTF-16 'no installed distributions' output in test_git_floor_gate_tree_skew / test_predates_gate_guard_parity). Proposed class fix: one test helper (tests/_exe_stub.py) installing a stub whose body is Python. On POSIX it writes a '#!{sys.executable}' script with mode 0755; on Windows it builds a real '<name>.exe' with distlib's ScriptMaker launcher (t64.exe / t64-arm.exe, shipped in distlib 0.4.3, which uv.lock already resolves via virtualenv), so CreateProcess finds it. Each module's sh stub body is ported to Python against the helper. Tests whose subject is a POSIX shell recipe (make worktree, bash-gate parity, shellcheck) get a Windows skip with the reason, which the AC allows. distlib is only a transitive dependency today; the change would declare it in the dev extra rather than rely on virtualenv. Validation: a tmp-branch Windows run of the tree with the fixed lines removed from posix-shell-stubs.args.","timestamp":1795255840699105001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Root cause recorded in the description (2026-11-21 PST). Evidence: JUnit tracebacks from run 44681457334 per test; CRLF hypothesis for the 3 shellcheck tests reproduced on macOS (a CRLF ok.sh gives shellcheck rc 1, SC1017 on every line); the delta-tree fallback test compares str(Path) (backslashes on Windows) with git ls-tree names. Design evaluated: adopted the distlib ScriptMaker .exe stub, because the _run_in_group seam precedent covers only in-process git and cannot reach the child-process stubs in metrics_polyglot_support.py and test_repo_isolation_guard.py, and a .cmd shim is not found by CreateProcess. distlib 0.3.6 (the lowest-direct floor) checked to build and run a stub under Python 3.13. Investigation run: tmp/w3-pangolin at d8b1aec2633, dispatch run 44894685390.","timestamp":1795257268466291001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Clarifying the review advisory on 'one module-level pytest.mark.skipif per module': the implementation defines one module-level marker object (_POSIX_SHELL_SUBJECT) per module and applies it per test, only to the listed POSIX-subject tests. No module is skipped wholesale; e.g. the ported seatbelt test in test_mutation_sandbox.py is unmarked (commit d8b1aec2633).","timestamp":1795258191617790001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Windows run 44894685390 (tmp/w3-pangolin at d8b1aec2633, 2026-11-21 PST): sweep (windows) job 136817719489 concluded failure with 7 failed, 20480 passed, 892 skipped. All 27 tests removed from posix-shell-stubs.args passed (none carries a skip marker). Failures: tests/test_exe_stub.py::test_the_stub_name_matches_what_the_platform_looks_up (shutil.which reports git.EXE; fixed with a normcase comparison); 3 test_check_verify_host AF_UNIX tests (consummate-amethyst-bull); test_windows_text_encoding src scan at _opcert_gate_config.py:61 (stable-diminutive-thrasher); 2 tests/unit/metrics/test_git_metrics.py tests failing at git fast-import (new in 863abe7cd19, outside this class). Re-run on the amended tree 3158a9e1f94: run 44900037100.","timestamp":1795261128940623001}],"created_at":1795153939525534001,"creation_channel":"cli","deps":[{"link_uuid":"e11ca302-6982-4c70-bf2f-627b7eb57c8b","relation":"discovered_from","target_id":"8aa0-2120-5ef3-4750"}],"description":"## Context / Problem\nDiscovered while triaging breezy-hogged-mastiff, which owns `.github/windows-sweep-deselect/unclassified.args`. These entries moved to `.github/windows-sweep-deselect/posix-shell-stubs.args`, which this bug owns: 56 lines across 23 modules at origin/main `863abe7cd19`.\n\nThese tests install fake `git`/`uv`/`acli`/`scc`/`sandbox-exec` executables as shebang scripts on `PATH`, run `bash`/`sh`/`make`, or symlink a tool into a stub directory. On the Windows runner the stubs never run (the count and args files they write are missing: `test_makefile_worktree.py`, `test_repo_isolation_guard.py`), the stubbed timeouts never fire (`test_snapshot_git_watchdog_d33f.py`, `test_snapshot_submodules_watchdog_c605.py`, `test_delta_tree_timeout_b0e0.py`, `test_store_write_git_timeout_c2ba.py`: DID NOT RAISE), and `bash` resolves to the WSL launcher, which prints a UTF-16 \"no installed distributions\" message (`test_git_floor_gate_tree_skew.py`, `test_predates_gate_guard_parity.py`).\n\nEvidence: Windows runs on throwaway branch `tmp/w05-remeasure` with origin/main `717c50f8b33` code plus a selection-only workflow change: run 44665461131 (48 passed, 194 failed or errored) and run 44681457334 (xdist, JUnit XML with full tracebacks). Both 2026-11-19 PST.\n\n## Root cause (established 2026-11-21 PST)\n1. Stub lookup. `subprocess` on Windows calls CreateProcess, which resolves a bare `git` on `PATH` by appending `.exe` only and ignores PATHEXT, so a shebang file or `git.cmd` never shadows `git.exe`; `shutil.which` (used by `acli_binary_available`, `src/rebar/reconciler/adapters/jira/acli_subprocess.py:184`) honours PATHEXT, which a shebang file named `acli` has no extension for. `bash` on the runner's PATH is the WSL launcher.\n2. Two failures in the class are not stubs. `tests/unit/test_check_shellcheck.py` fixtures are written in text mode, so Windows writes CRLF and shellcheck reports SC1017 (reproduced on macOS by writing a CRLF `ok.sh`: rc 1, SC1017). `test_delta_tree_timeout_b0e0.py::test_timeout_falls_back_to_full_materialization` builds its on-disk listing with `str(Path)`, which is backslash-separated on Windows, against git's forward-slash `ls-tree` names.\n3. 29 lines test something inherently POSIX: Makefile recipes run by `make` under `/bin/sh` (`test_makefile_worktree.py` 6, `test_worktree_python_pin.py` 2, `test_check_criteria_vocabulary.py` 1), bash workflow step scripts run with `bash -c` (`test_gerrit_verify_triage_comment.py` 3, `test_git_floor_gate_tree_skew.py` 1, `test_predates_gate_guard_parity.py` 1, `test_ci_workflow_parity.py` 1), bash probe scripts (`test_jira_pressure_test_preflight.py` 6, `scripts/jira-pressure-test/*.sh`), the bash session hook (`test_session_shims.py` 1), the hook command run through `/bin/sh -c` (`test_serena_grep_reminder_hook.py` 1), the README bash quickstart (`test_check_readme_quickstart.py` 1), POSIX `${VAR:?}` expansion (`test_mutation_sandbox.py` 1), and SIGKILL-ed children (`test_child_oracle_fail_open.py` 4). Sibling tests in 4 of those modules already carry `requires_posix_shell` (`tests/_sandbox_capabilities.py:50`).\n\n## Approach\n- New helper `tests/_exe_stub.py::install_exe_stub(bin_dir, name, body)`. The body is Python. It is packaged with distlib's `ScriptMaker` (`distlib/scripts.py:423` `make`, `:346` `_copy_script`, `:261` `_write_script`, which on Windows writes `<name>.exe` = launcher + shebang + zipped script at `:289`): a `#!<sys.executable>` script on POSIX, a real `<name>.exe` on Windows, so CreateProcess and `shutil.which` both find it. A prelude defines `exec_real(argv)`: `os.execv` on POSIX (the watchdog kill lands on the real process, as the sh stubs' `exec` did), a child plus `sys.exit` on Windows. The launcher runs the body inside a kill-on-close job, so killing the stub kills the body.\n- Why this over alternatives: intercepting rebar's spawn seam (`rebar._store.gitutil._run_in_group`, as `test_repair_pause_ownership_store.py` already does) works only for in-process calls and replaces the real timeout path under test; it cannot reach the child-process stubs in `metrics_polyglot_support.py` and `test_repo_isolation_guard.py`. A `.cmd` shim is not found by CreateProcess. ScriptMaker is how pip builds console scripts, so the launcher is the proven path.\n- Dependency: declare `distlib>=0.3.6` in the `dev` extra in `pyproject.toml`. It is already locked (`uv.lock:705`) only through `virtualenv`, and the Windows sweep installs `.[dev,reviewbot,ui]` unlocked (`.github/workflows/test.yml:278`). Checked: 0.3.6, the lowest-direct floor, builds and runs a stub under Python 3.13. This is a dev-extra dependency, not a config key, env var or flag.\n- Port 9 modules' stubs to the helper: `test_snapshot_git_watchdog_d33f.py`, `test_snapshot_submodules_watchdog_c605.py`, `test_store_write_git_timeout_c2ba.py` (drops the perl dependency), `test_delta_tree_timeout_b0e0.py`, `test_scc_loc.py`, `test_acli_preflight_missing_binary.py`, `test_mutation_sandbox.py` (the seatbelt \"accepts\" test), `test_repo_isolation_guard.py`, and `tests/interfaces/metrics_polyglot_support.py` (scc, jscpd, git-only bin). `test_repair_pause_ownership_store.py` already routes git through the seam on main (`ebd2a68a451`) and only needs Windows confirmation.\n- Fix the 2 fixture bugs: write shellcheck fixtures with `newline=\"\\n\"`; compare with `Path.as_posix()`.\n- Skip the 29 POSIX-subject tests where `posix_shell_available()` is false, one module-level `pytest.mark.skipif` per module with a reason naming the POSIX subject. Their deselect lines stay in `posix-shell-stubs.args` (a skipped test did not pass), recorded on this ticket as intentionally unsupported with the reason. None of those subjects is a product code path that runs on Windows: they are CI workflow steps (ubuntu runners), Makefile recipes, bash scripts and POSIX signals.\n\n## Scope\n`tests/_exe_stub.py` (new), `tests/test_exe_stub.py` (new), `pyproject.toml`, `uv.lock`, `.github/windows-sweep-deselect/posix-shell-stubs.args`, and the 23 test modules or support files named above. No product code changes.\n\n## Testing\n- `tests/test_exe_stub.py` (runs on every OS): a bare-name `git` spawn runs the stub; `exec_real` passes stdout and exit status through, including a non-zero real-git failure; a `timeout=2` kill raises `TimeoutExpired` well before the body's 60 s sleep (proves the body does not outlive the kill and hold the pipes); the file written is `git.exe` on Windows and `git` elsewhere and is what `shutil.which(\"git\")` returns.\n- The ported tests pass on macOS (local run: 132 passed, 1 skipped) and on Windows in a `sweep (windows)` run of the exact tree on `tmp/w3-pangolin`.\n- `make verify` through the verify-slot queue.\n\n## Acceptance Criteria\n- [ ] Every line removed from `posix-shell-stubs.args` names a test that passed in a `sweep (windows)` run on main after the fix (run id recorded in a comment).\n- [ ] `posix-shell-stubs.args` is empty and deleted with its reference in `.github/workflows/test.yml`, or each remaining line names a test recorded on this ticket as intentionally unsupported on Windows with the reason.\n- [ ] `tests/test_exe_stub.py` passes in that `sweep (windows)` run and in `make verify` (log path recorded in a comment).\n- [ ] `python scripts/check_mechanism_delta.py --check` exits 0 with `tests/_exe_stub.py` admitted by its marker.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":".github/windows-sweep-deselect/posix-shell-stubs.args","reason":"remove each line whose test passes on Windows"},{"path":"pyproject.toml","reason":"declare distlib in the dev extra"},{"path":"tests/_exe_stub.py","reason":"new portable stub helper"},{"path":"tests/interfaces/metrics_polyglot_support.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/scripts/test_check_readme_quickstart.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/scripts/test_jira_pressure_test_preflight.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/scripts/test_mutation_sandbox.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/test_exe_stub.py","reason":"cross-OS tests of the helper"},{"path":"tests/unit/metrics/test_scc_loc.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/reconciler/test_acli_preflight_missing_binary.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_check_criteria_vocabulary.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_check_shellcheck.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_child_oracle_fail_open.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_delta_tree_timeout_b0e0.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_gerrit_verify_triage_comment.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_git_floor_gate_tree_skew.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_makefile_worktree.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_predates_gate_guard_parity.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_repo_isolation_guard.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_serena_grep_reminder_hook.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_session_shims.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_snapshot_git_watchdog_d33f.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_snapshot_submodules_watchdog_c605.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_store_write_git_timeout_c2ba.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"tests/unit/test_worktree_python_pin.py","reason":"port its stub to the helper, fix its fixture, or skip its POSIX-only subject"},{"path":"uv.lock","reason":"lock the dev-extra distlib declaration"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ad42a3ec-4ce2-40cb-94af-9717d3e16f89","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":["windows","portability"],"ticket_id":"e062-1686-1a27-41a4","ticket_type":"bug","title":"Windows sweep: 55 tests drive POSIX shell scripts, make recipes or shebang stub executables","verify_commands":[]},"source_event_uuids":["d25432d2-944e-47e4-911d-c543431e190c","6837185c-99ef-4831-84a0-aba7522210da","77cb5e5e-7c90-4dc6-8eeb-928b189ca227","5580721b-85d0-48b5-b194-0031db4f3b19","8f0552b9-c1e6-4255-adfc-16b48d77aaa1","d5d991ea-1a54-4553-9335-c61fd603242b","a456b9a5-fd72-4e53-ad6e-c6b316205c85","faf5ec2f-21d9-4ac6-a55a-ad4588987d5e","ad42a3ec-4ce2-40cb-94af-9717d3e16f89","fe69a8d9-31ff-45b3-8c17-5bdd5cf52887","0ec98d92-fbf7-4483-b33a-c343121617a4"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795261128940623002,"uuid":"33f65617-495c-4bf8-8478-8d7c95feffc0"}