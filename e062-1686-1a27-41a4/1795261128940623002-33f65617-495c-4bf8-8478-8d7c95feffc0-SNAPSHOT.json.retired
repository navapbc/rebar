{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795261128940623002,"compiled_state":{"alias":"transhuman-wounded-pangolin","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"863abe7cd19a4a386a01fb3a9c484358ebdc7596","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: e062-1686-1a27-41a4","material: fb1477d77178b369","material-part: children 647ea2107ca5072f 0","material-part: description adbde36e8176aaf7 7373","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 2ca15ce05113d9c0 27","material-part: ticket_id dd2f9be09e64f246 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 19","review-phase: planning","rebar-version: 0.16.0 (863abe7cd19)","regver: aa61189569d34126","verified-at-sha:863abe7cd19a4a386a01fb3a9c484358ebdc7596","dep 2fd86648fbe1dedf72575793c13625fbad33202ef8286877b052432f55865c59 .github/windows-sweep-deselect/posix-shell-stubs.args","dep 9a0ec5df6161a070d47a217a01467ef67b4cfb4501c17f030344dc2f93bc596e pyproject.toml","dep absent tests/_exe_stub.py","dep d85262c2a828059cfdc98ada7262c4b91fd7bb2f18e641f6c332a6b5f7116751 tests/interfaces/metrics_polyglot_support.py","dep a78fb508aaf7401854ece4d12bcff756bba723218dc17ef7cee6fdbbdbd1ff5b tests/scripts/test_check_readme_quickstart.py","dep 61da1ce19b7d3755ac9428a0b5c5284a41fed77396911ac8e564db3edcdcfdae tests/scripts/test_jira_pressure_test_preflight.py","dep a61c113bf8e3385e2d8021e5205a0a5ea2368cbf54becf15a8a87402774e6365 tests/scripts/test_mutation_sandbox.py","dep absent tests/test_exe_stub.py","dep ee70aa032