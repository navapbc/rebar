 environment help text saying reconcile is dry-run only\n- comments around the legacy mode-cap binding that still refer to the reconcile tool\n\n## Scope\n\nUpdate `src/rebar/mcp_server.py` comments/docstrings/help text only, preserving any runtime symbols still needed by CLI/engine code or bridge operations.\n\n## Acceptance Criteria\n\n- [ ] `src/rebar/mcp_server.py` no longer describes a registered MCP `reconcile` tool.\n- [ ] Any retained mode-cap or environment text names the current explicit bridge operation that uses it, or is removed if obsolete.\n- [ ] No runtime behavior changes.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[["parent","0cfc-e511-8f8a-4c8b"]],"no_file_impact_reason":"","parent_id":"0cfc-e511-8f8a-4c8b","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"629b-ce2a-9329-49dd","ticket_type":"task","title":"Remove stale MCP server reconcile documentation comments","verify_commands":[]},"source_event_uuids":["3ace35a5-e5eb-4c63-937c-063e1c6cfedc","1304ecf6-d53a-4700-88a3-6b39922765f7"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788542380307127001,"uuid":"c79fd438-745c-46ef-bbac-69ffcc5329e3"}