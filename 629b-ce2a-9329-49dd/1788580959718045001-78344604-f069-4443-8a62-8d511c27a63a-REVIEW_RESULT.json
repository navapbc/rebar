ar/mcp_server.py — is refuted by the named file. All three cited locations refer to `bridge_sync` or the live `rebar_reconciler` engine module, not the removed MCP reconcile tool.","group_criteria":null,"group_id":null,"id":"f62a883dc2a308c17","impact":0.85,"is_primary":null,"location":"Context / Problem (bulleted list of stale references)","norm_id":"nd709c051bbaaeb6b","priority":0.765,"reason":"veto:plan-goal-satisfied","recalled":false,"scenarios":["An implementer opens mcp_server.py to remove the described stale reconcile prose and finds none of the three items exists as described, leaving the plan with no actionable edit."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Pin the exact line/prose in src/rebar/mcp_server.py that still describes a registered MCP `reconcile` tool (distinct from the legitimate `rebar_reconciler/mode.py` engine-path comment and the already-noted removed alias at L114-115), so the edit targets are concrete and preserved runtime references