{"author":"Unknown","author_email":"","data":{"content_hash":"db9c4a207a96170f4d6d62c42ffc0f59bb4403de803b6875e71ceecf9ea7c3e6","digest":{"component_or_area":"test suite configuration and isolation","key_entities":["tests/conftest.py","REBAR_IDENTITY_REQUIRE_AUTHENTICATED","_identity_enforcement_off_by_default","_gate_source_local_by_default","tests/unit/test_identity_*","tests/interfaces/lifecycle"],"problem_keywords":["test isolation","environment variable","global configuration","autouse fixture","authentication enforcement"],"propositions":["A stray global REBAR_IDENTITY_REQUIRE_AUTHENTICATED=1 environment variable breaks the test suite by causing CommandError on create/mutate operations for non-exempt types","Test isolation via REBAR_ROOT and XDG_CONFIG_HOME stubbing does not protect against globally-set enforcement environment variables","An autouse fixture in tests/conftest.py must force REBAR_IDENTITY_REQUIRE_AUTHENTICATED=0 to guard the suite against stray global defaults","Dedicated identity enforcement tests must retain the ability to override the fixture's default via isolated subprocess environment dictionaries"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b2b5c498-2f67-4ae3-bafc-eca40294bec2","event_type":"TICKET_DIGEST","timestamp":1785822677797083906,"uuid":"404397dd-2640-4abe-afac-60bc815f173c"}