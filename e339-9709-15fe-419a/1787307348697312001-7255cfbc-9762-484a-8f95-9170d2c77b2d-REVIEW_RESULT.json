":"nd67e93f61580354d","priority":0.4467,"reason":"default-advisory","recalled":false,"scenarios":["rich_text_cutover=cloud, over-length comment, crash between add_comment and record_comment_id → secondary body-equality skip still never matches, comment re-posts on next pass"],"severity":"major","suggested_fix":"","tier":"LLM","validity":0.6667,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Disambiguate 'landed body' in AC 2 and state which rich mode(s) the retargeted convergence test runs, clarifying that AC 2 asserts equality of the emit-side fit/comparison key (not the round-tripped Jira body) so it goes GREEN independent of the separately-filed inbound-decode divergence.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5e"],"criteria":["E6","E1","COH"],"decision":"advisory","decision_margin":-0.3812,"drop_reason":null,"evidence":["AC 2: 'A test drives both and asserts the landed body equals the comparison key for an over-length comment (RED on current code).'","Blast radius: 'under this project's `cloud