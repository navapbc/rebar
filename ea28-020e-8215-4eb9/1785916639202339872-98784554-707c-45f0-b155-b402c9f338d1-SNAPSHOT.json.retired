583d75cf577ca","position":"1785907393825185001-1cfef34d-ce20-4345-954d-cf7e8b050b92"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"41eb0abb87af7a24d961377c5eb0b48345736c4bc1c78c1aaa94459d156e5e5d","event_uuid":"f87b76f7-3a7b-4835-aeca-db47d48a04f6","position":{"commit_sha":"c02b4e0a21083ebee8dc546000f9973a59f48fde","position":"1785907603451513001-f87b76f7-3a7b-4835-aeca-db47d48a04f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4ccd5858518adbb233ae4d02a09804e81fcdebcf9a5d33a77ffd5a951aa2e5c3","event_uuid":"c3cfe7f3-c5a1-49f5-87d3-b4d5dacf0180","position":{"commit_sha":"b37b9f589c518102a713e75e2bc1355886e094df","position":"1785914068784980001-c3cfe7f3-c5a1-49f5-87d3-b4d5dacf0180"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a0ec57967031c99ddae17be73340b4ab3d1a22b8fcc87ba618239c341e699049","event_uuid":"56a9f4f7-0360-4251-b283-d86cbfc51e0d","position":{"commit_sha":"b37b9f589c518102a713e75e2bc1355886e094df","position":"1785914069548532001-56a9f4f7-0360-4251-b283-d86cbfc51e0d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-222_agent","claim_remote_session":null,"claimed_session":"a8e73304-f7f3-4412-b4c4-68aff489e438","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Remediated plan after review BLOCK (blocking=2, +critical advisory): (1) added a real ## Acceptance Criteria checklist of in-session-provable items; (2) embedded the full T15 rubric (S1-S3 + checks a-d + anti-FP) verbatim so the artifact is authorable without resolving the epic (fixes T8 critical co-location); (3) removed the unprovable finder-behavior AC and scoped it to the eval-fixtures dependency 36ab; (4) specified facet/applies_at/overlay_routing values (fixes E2); (5) corrected routing description to overlay_routing:llm orchestrator-dispatched like T13/T14 (fixes E4); (6) single-token dimension overlay-derisk instead of slash-compound (fixes A1/G6). Re-running review.","timestamp":1784920542314689001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Remediation 2 after 2nd review BLOCK (all 5 blocks were 2 real code-grounded errors): (1) front-matter execution_mode AGENT -> agentic (valid loader enum is single_turn|agentic; routing exec stays 'AGENT' — distinct field, now called out explicitly); (2) AC5 validator names -> real symbols check_registry_coverage / validate_packaged_routing / validate_criteria_guide (there is no validate_routing). Also hardened weak AC commands (E6 advisories): AC2 now asserts routing field VALUES via json load, AC6 now asserts the T15 section spans all four checks, AC1 verifies front-matter+body content. Re-running review.","timestamp":1784921131836344001}],"created_at":1784918866430144001,"creation_channel":"cli","deps":[{"link_uuid":"94774eb6-c6b6-4cdb-8a6a-cdb92ff535ff","relation":"relates_to","target_id":"09d1-7a6d-bc96-4b0d"}],"description":"Add the core built-in plan-review criterion T15 \"overlay-derisk\". Stack-agnostic; LLM-routed on plan content via `overlay_routing: llm`, dispatched by the review orchestrator exactly like T13/T14 (there is no ticket-tag routing). The full rubric is specified verbatim below so the artifact can be authored without resolving any other ticket.\n\nNote on two distinct fields: the routing-entry `exec` uses the descriptor value \"AGENT\"; the rubric FRONT-MATTER `execution_mode` uses the prompt-loader enum value `agentic` (valid values are single_turn|agentic — \"AGENT\" is NOT valid front-matter and will fail the loader).\n\n## Rubric to write verbatim into src/rebar/llm/reviewers/plan_review_T15.md\nYAML front-matter: `title: Overlay de-risk — prove risky mechanisms out-of-loop`, `category: plan-review-criterion`, `execution_mode: agentic`, `dimension: overlay-derisk`.\n`title:` is REQUIRED, not decorative: `build_descriptor` computes `name = prompt.title or cid`, so a rubric with no `title` degrades the criterion's rendered name to the bare id `T15` in both the guide header and `rebar explain T15`. AC #4 (which requires `rebar explain T15` to print the criterion name) would then pass only degenerately, and T15 would read differently from every sibling (T13 'Behavioral-prohibition consumer scan', T14 'CI-trigger / release-infrastructure coverage audit').\nBody:\n\nOVERLAY — apply only when ALL of the following hold; else PASS not-applicable.\n- S1 Codified loop? the mechanism is delivered/validated by pushing through an automated pipeline or an environment/infrastructure apply, not by running or unit-testing code directly.\n- S2 Slow or costly pass? one pass through that loop is slow (minutes-to-hours) or otherwise costly to run.\n- S3 Runtime-only correctness? the change introduces behavior whose correctness only resolves when it actually runs in a realistic environment (boots, authenticates, connects, is authorized, passes readiness) — unreachable by static/unit checks.\n\nWhen applicable, report a finding for each check not satisfied:\n- (a) RISK NAMED — the plan identifies the specific mechanism(s) confirmable only by completing the full loop.\n- (b) FAST OUT-OF-LOOP PROOF — for each named risk, the plan commits to proving it via the fastest feedback path available for that mechanism, outside the slow loop: running the unit locally/emulated where feasible, OR a manual experiment directly against the real target (an interactive call, a one-off CLI/console action, a probe script, a throwaway resource) where local reproduction isn't possible. The experiment is concrete and returns a verdict in minutes, not a delivery cycle. An unnamed \"we'll verify\" / \"we'll check after deploy\" does not satisfy it.\n- (c) PROVE-THEN-CODIFY — the cheap experiment comes before committing the mechanism into the slow loop, so the loop validates an already-proven mechanism.\n- (d) SCOPED CLEANUP — throwaway experiments are cleaned up afterward, with teardown that removes ONLY the artifacts the experiment itself created (the records a probe inserted, the scratch resource it spun up) and touches nothing pre-existing, shared, or persistent; a cleanup step that could delete, reset, or truncate a resource the experiment did not create (e.g. dropping an existing table or wiping a bucket to \"reset\" it) fails this check.\n\nANTI-FP: a manual experiment against the real target is a fully valid proof — never penalize choosing it over local reproduction; many stacks cannot be reproduced locally. A mechanism already proven elsewhere in the codebase needn't be re-proven.\n\n## Routing entry to add to src/rebar/llm/plan_review/criteria_routing.json (key \"T15\")\n- `exec`: \"AGENT\"\n- `facet`: \"overlay-derisk\"\n- `overlay_routing`: \"llm\"  (orchestrator-dispatched content routing, as T13/T14)\n- `applies_at`: { \"suppress_types\": [\"bug\"] }\n- Posture/threshold: NOT set here — inherit the registry default (advisory). Advisory-vs-blocking is decided by the normal registry/review process, out of scope for this ticket.\n\n## Implementation steps\n1. Create src/rebar/llm/reviewers/plan_review_T15.md with the front-matter (execution_mode: agentic) + body above.\n2. Add the \"T15\" routing entry above to src/rebar/llm/plan_review/criteria_routing.json.\n3. Add \"T15\" to CANONICAL_LLM in src/rebar/llm/plan_review/registry.py.\n4. Regenerate the guide: `python -m rebar.llm.plan_review.registry regenerate-criteria-guide` (updates docs/plan-review-criteria-guide.md).\n\n## Scope boundary\nThis ticket authors the criterion artifact + registration + regenerated guide only. Runtime routing/finder BEHAVIOR (does T15 fire on an infra plan and stay silent on an app-only plan) is proven by the eval-fixtures story 36ab-b649-b72b-4608, which depends on this ticket — not asserted here.\n\n## Acceptance Criteria\n- [ ] src/rebar/llm/reviewers/plan_review_T15.md exists containing the S1-S3 gate, checks (a)-(d), and the ANTI-FP paragraph verbatim, with front-matter `execution_mode: agentic` and `dimension: overlay-derisk`. Verify: `python -c \"import pathlib; s=pathlib.Path('src/rebar/llm/reviewers/plan_review_T15.md').read_text(); assert 'execution_mode: agentic' in s and 'dimension: overlay-derisk' in s and all(k in s for k in ['S1','S2','S3','RISK NAMED','FAST OUT-OF-LOOP PROOF','PROVE-THEN-CODIFY','SCOPED CLEANUP','ANTI-FP'])\"` exits 0.\n- [ ] Routing entry has the required field VALUES (not just the key). Verify: `python -c \"import json; e=json.load(open('src/rebar/llm/plan_review/criteria_routing.json'))['T15']; assert e['exec']=='AGENT' and e['facet']=='overlay-derisk' and e['overlay_routing']=='llm' and e['applies_at']['suppress_types']==['bug'], e\"` exits 0.\n- [ ] `python -c \"from rebar.llm.plan_review.registry import CANONICAL_LLM; assert 'T15' in CANONICAL_LLM\"` exits 0.\n- [ ] `rebar explain T15` prints the criterion name, exec tier AGENT, facet overlay-derisk, and the rubric body (S1-S3 + checks a-d).\n- [ ] Registry validators pass. Verify: `python -c \"from rebar.llm.plan_review.registry import check_registry_coverage, validate_packaged_routing, validate_criteria_guide; ok,missing=check_registry_coverage(); assert ok, missing; assert not validate_packaged_routing(); assert not validate_criteria_guide()\"` exits 0.\n- [ ] The regenerated guide contains the full T15 section (heading + checks). Verify: `python -c \"s=open('docs/plan-review-criteria-guide.md').read(); assert '## T15' in s and all(k in s for k in ['RISK NAMED','FAST OUT-OF-LOOP PROOF','PROVE-THEN-CODIFY','SCOPED CLEANUP'])\"` exits 0.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/reviewers/plan_review_T15.md","reason":"new T15 rubric"},{"path":"src/rebar/llm/plan_review/criteria_routing.json","reason":"T15 routing entry"},{"path":"src/rebar/llm/plan_review/registry.py","reason":"add T15 to CANONICAL_LLM"},{"path":"docs/plan-review-criteria-guide.md","reason":"regenerated guide"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","8fc2-0306-a9a0-4864"],["relates_to","09d1-7a6d-bc96-4b0d"]],"no_file_impact_reason":"","parent_id":"8fc2-0306-a9a0-4864","parent_status_uuid":"c3cfe7f3-c5a1-49f5-87d3-b4d5dacf0180","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"ea28-020e-8215-4eb9","ticket_type":"story","title":"Add T15 overlay-derisk criterion: rubric + routing + registry + regenerate guide","verify_commands":[]},"source_event_uuids":["8f09f2c6-5f55-4da8-9947-c53dea5ae5ea","74894b4c-1b29-4939-8f1f-ffeeebcae215","dc72682a-db78-4af5-a21d-03e7f8a6dbc4","b4997936-83cb-4021-9cd0-ff2c176fb6be","7ccfca51-dc9e-43ba-8f26-008d57294a64","2737320a-3db3-4c6d-ab76-0df2900453ec","0fa7b671-ee39-4d2d-bff1-adaf21b9ef17","1cfef34d-ce20-4345-954d-cf7e8b050b92","f87b76f7-3a7b-4835-aeca-db47d48a04f6","c3cfe7f3-c5a1-49f5-87d3-b4d5dacf0180","56a9f4f7-0360-4251-b283-d86cbfc51e0d","94774eb6-c6b6-4cdb-8a6a-cdb92ff535ff"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785916639202339872,"uuid":"98784554-707c-45f0-b155-b402c9f338d1"}