{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785916639202339872,"compiled_state":{"alias":"emerald-blizzardy-centipede","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"261382756467b768bdef0a82e87397c62cf79020","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: ea28-020e-8215-4eb9","material: d56e0f8858341090","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.10.1 (2613827564)","regver: 98022a04a68b0fef","verified-at-sha:c4336637214cc1f14dc03b22f22087f93250f2d3","dep 2e523e2968e49f1bf2fb601866d78908681d726c2a3a8195c03ed0678288cb65 docs/plan-review-criteria-guide.md","dep e934b7af4056ca21c41af641e897558d26c31b50af694d4143d050c89934fbad src/rebar/llm/plan_review/criteria_routing.json","dep 320a66804c2a2369574a85d91e668b70deb5eb9e49ba979abdca17580037c003 src/rebar/llm/plan_review/registry.py","dep absent src/rebar/llm/reviewers/plan_review_T15.md"],"material_fingerprint":"d56e0f8858341090","merged_log_commit":"c4336637214cc1f14dc03b22f22087f93250f2d3","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1785907603450521000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":11,"unsigned":1},"authorship_ledger":[{"content_hash":"bec4831397c9f61b124ca501bd561f1da9307fef012749eff49018cbc36b0ca3","event_uuid":"8f09f2c6-5f55-4da8-9947-c53dea5ae5ea","position":{"commit_sha":"f6093a9ca5cd9251d89306840ef77e2860220c14","position":"1784918866430144001-8f09f2