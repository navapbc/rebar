{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, subprocess, sys\ndef norm(ref, path):\n    tree = ast.parse(subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True), type_comments=True)\n    for ti in tree.type_ignores:\n        ti.lineno = 0\n    for node in ast.walk(tree):\n        body = getattr(node, \"body\", None)\n        if isinstance(body, list) and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            node.body = body[1:]\n    return ast.dump(tree, include_attributes=False)\nbad = [p for p in sys.argv[1:] if norm(\"HEAD^\", p) != norm(\"HEAD\", p)]\nassert not bad, f\"non-prose AST changes: {bad}\"' scripts/alert_dedup.py scripts/amend_commit_message.py scripts/backfill_caused_by.py scripts/backtest_bugfix_size.py scripts/build_cloud_adf_corpus.py scripts/build_dc_wiki_corpus.py scripts/canary_bridge.py scripts/capture_jira_fixtures.py scripts/check_cli_json_js_safe.py scripts/check_comment_hygiene.py scripts/check_commit_message_wrap.py scripts/check_complexity_baseline.py scripts/check_config_ownership.py scripts/check_config_reads.py scripts/check_criteria_vocabulary.py scripts/check_deploy_manifest.py scripts/check_destructive_test_exec.py scripts/check_fcntl_import_guard.py","dd_id":"python-prose-only","dd_text":"Compare Python ASTs after stripping docstrings and normalizing TypeIgnore line numbers so no executable structure changes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/test_alert_dedup.py tests/unit/test_amend_msg_change_id.py tests/scripts/test_backfill_caused_by.py tests/scripts/test_canary_b