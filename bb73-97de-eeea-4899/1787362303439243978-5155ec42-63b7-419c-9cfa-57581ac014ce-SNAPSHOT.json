sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9494a1819bbe3ebbfa4acf58a545d006729df5b92c704339cfbb4424b84e0f43","event_uuid":"02b4e091-ac9e-42bb-a9a8-b5a48e39d277","position":{"commit_sha":"b57a65c3317a55bf093951bef08dd2833b56e293","position":"1787361134213205001-02b4e091-ac9e-42bb-a9a8-b5a48e39d277"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a50aea689e179d59e7eff92689c956dd6e3db3270f59142f5f374bb7d0e75e74","event_uuid":"33844cea-32e3-4dd1-a856-0a172c4453b3","position":{"commit_sha":"b5d6d8a19919865bd7dfabd13bba0c18379cb7da","position":"1787361722994945001-33844cea-32e3-4dd1-a856-0a172c4453b3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c5073b65876c26ff85796f85e3ad0ade8bc30e0be897af2b2853e25d767d2038","event_uuid":"570831a3-115b-4355-9d45-6feaff36a75a","position":{"commit_sha":"94eb164c5c9186b92de26be2cd41d01a5eb9d696","position":"1787362303439243977-570831a3-115b-4355-9d45-6feaff36a75a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OPERATOR RULING (recorded verbatim on behalf of the operator): \"rebar should maintain, as an invariant, that no non-terminal-state ticket can be a child of a closed ticket.\" This resolves the ticket's decision-first question: the doc-only option (option 2, declaring inbound apply a cascade=False surface) is REJECTED. The inbound-reconcile write surface must uphold the same parent-first invariant the interactive cascade upholds (option 1).","timestamp":1787334403740255001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation pushed for review: https://rebar.solutions.navateam.com/c/rebar/+/2044 (commit 4819296c31). Plan-review PASSED (advisories only) and ticket claimed. Fix: _cascade_inbound_status_parents in apply_inbound_events.py shares the interactive cascade DECISION (_CASCADING_EDGES + _resolve_parent_in_status from rebar._commands.transition) and writes eligible ancestors' STATUS events first (topmost first, cycle-guarded) on both inbound-update and inbound-create paths; same-status inbound writes are now suppressed no-ops (batch self-consistency + idempotency). Deliberately NOT routed through transition_compute (would impose the LLM start-work gate + eager per-event push on reconcile). docs/concurrency.md §I4a now scopes the invariant across ALL write surfaces, citing the operator ruling. RED demonstrated: 4 affirmative tests failed pre-fix; 7/7 pass post-fix. Gates: make lint, make typecheck (624 files), complexity ratchet (new=0 increased=0), full tests/unit/rebar_reconciler suite (3040 passed). Fork check: the 'Jira holds parent closed + child active' case is NOT a new fork — the ruling makes the local invariant authoritative, and the outbound differ pushes the cascaded parent reactivation back to Jira on the next pass, exactly as after an interactive reactivation.","timestamp":1787361722994945001}],"created_at":1787308882729976001,"creation_channel":"cli","deps":[{"link_uuid":"cda11ca5-b9e3-4a49-b7d1-f8f68fd50bdf","relation":"discovered_from","target_id":"96db-365e-f2c3-4547"},{"link_uuid":"7095451a-aa57-451e-8b53-3cf18c3ca582","relation":"relates_to","target_id":"0446-4278-b7df-438d"},{"link_uuid":"91190347-8647-4151-9a82-520c6b528b81","relation":"relates_to","target_id":"4329-4761-6e3d-41d7"},{"link_uuid":"570831a3-115b-4355-9d45-6feaff36a75a","relation":"relates_to","target_id":"9d67-b074-f28d-43b1"}],"description":"## Context / Problem\nThe parent-first cascade (`docs/concurrency.md` §I4a) is implemented ONLY in\n`transition_compute` / `claim_compute`. The Jira reconciler's inbound-apply path writes\nSTATUS events **directly**, bypassing that seam entirely:\n`src/rebar/_engine/rebar_reconciler/apply_inbound_events.py`\n(`_inbound_update_write_status_event` and `_inbound_create_write_status_event`) both call\n`_write_event_file(tracker_dir, local_id, \"STATUS\", ...)` with no cascade. So an inbound\nJira status change that moves a child into an active status does NOT pull its ancestors\nalong, and can compose exactly the invalid states I4a forbids — a `closed` parent holding\nan `open`/`in_progress` child.\n\nThis is a parity gap on the automated-caller surface, found by the Step-7 parity census\nwhile fixing `paragonite-fruited-minnow` (96db-365e-f2c3-4547).\n\n## Decision (operator ruling)\nThe operator ruled: \"rebar should maintain, as an invariant, that no non-terminal-state\nticket can be a child of a closed ticket.\" (Recorded verbatim as a comment on this\nticket.) That resolves the open design question: the doc-only option 2 (declare inbound\napply a `cascade=False` surface) is REJECTED; option 1 is chosen — the inbound-reconcile\nwrite surface upholds the same parent-first invariant the interactive cascade upholds.\n\n## Approach\nMirror the interactive cascade at the inbound event-write surface, single-sourced on the\ninteractive machinery — no second cascade table:\n\n- Add one helper `_cascade_inbound_status_parents(tracker_dir, local_id,\n  current_status, target_status)` in `apply_inbound_events.py`. It consults\n  `rebar._commands.transition._CASCADING_EDGES` (the one authoritative edge table) and\n  `rebar._commands.transition._resolve_parent_in_status` (the one authoritative\n  parent-eligibility lookup), and when the child's STATUS edge is a cascading edge with\n  an eligible parent, writes the parent's STATUS event FIRST via the same\n  `_write_event_file` writer — walking recursively up the chain (topmost eligible\n  ancestor first) with a cycle guard, exactly the §I4a ordering.\n- Call it from both inbound STATUS writers: `_inbound_update_write_status_event`\n  (before the child's STATUS write, using the same `_read_latest_status` previous\n  status) and `_inbound_create_write_status_event` (previous status is `open`, so only\n  the `open -> in_progress` edge can cascade there). Cascaded parent event paths are\n  appended to the update path's `written` list.\n- Deliberately do NOT route inbound status through `transition_compute`: inbound apply\n  re-materialises peer-recorded state and must stay deterministic and gate-free —\n  routing through the interactive verb would subject Jira-originated moves to the\n  start-work plan-review gate (an LLM gate) and to eager per-event commit/push,\n  breaking the reconciler's batch orchestration. The cascade DECISION (edge table +\n  parent eligibility) is shared; only the write primitive differs, matching how the\n  inbound path already writes every other event.\n- Batch self-consistency / idempotency: suppress the update-path STATUS write when the\n  target status equals the current local status (a no-op write). This is what keeps a\n  cascaded parent from fighting the parent's OWN inbound status mutation later in the\n  same batch (the parent's own write becomes a suppressed no-op), and makes re-applying\n  the same inbound payload idempotent. Default: order-independent within a batch —\n  whichever of parent/child applies first, the final local state is identical.\n- Failure posture mirrors both existing seams: an absent/unreadable/ineligible parent\n  yields no cascade and the child proceeds alone (identical to the interactive\n  `_resolve_parent_in_status` contract), and a cascade `_write_event_file` failure\n  propagates out of the leaf exactly as the child's own STATUS write failure already\n  does — no new batch-corruption mode.\n- Out of scope (recorded as discovered work if confirmed): the inbound `* -> closed`\n  parity with the interactive open-children close guard is a DIFFERENT mechanism (§I4a\n  explicitly excludes closing edges from the cascade); this ticket changes only the\n  three cascading edges.\n\n## Scope\n- `src/rebar/_engine/rebar_reconciler/apply_inbound_events.py` — the cascade helper +\n  calls from the two STATUS writers + the no-op suppression.\n- `docs/concurrency.md` — §I4a scoped to BOTH write surfaces (interactive verbs AND\n  inbound reconcile), citing the operator ruling.\n- `tests/unit/rebar_reconciler/mutate/test_inbound_status_cascade.py` — new test module\n  driving the inbound-apply path (not `transition_compute`).\n\n## Testing\n- RED (bypass proof, then GREEN): `_apply_inbound_update` moving a `closed` child to\n  `in_progress` under a `closed` parent writes the parent's `closed -> in_progress`\n  STATUS event first; reduced states show parent AND child `in_progress` (was: parent\n  left `closed` — the I4a-invalid state).\n- Chain: grandparent `closed` -> parent `closed` -> child; inbound child reactivation\n  cascades both ancestors, topmost first.\n- Negative/edge: no parent → no cascade, single STATUS event; parent already active →\n  no cascade; `* -> closed` inbound write → never cascades.\n- Batch no-fight: after the child's cascade moved the parent, the parent's own inbound\n  status mutation to the same status writes NO duplicate STATUS event (suppressed\n  no-op).\n- Create path: inbound CREATE with status `in_progress` under an `open` local parent\n  cascades the parent `open -> in_progress`.\n\n## Acceptance Criteria\n- [x] A decision is recorded for whether inbound reconcile applies the parent-first\n      cascade (operator ruling comment on this ticket; option 1).\n- [ ] `docs/concurrency.md` §I4a states explicitly which write surfaces the invariant\n      binds (all of them — interactive verbs and inbound reconcile), citing the operator\n      ruling; checked by reading the section in the landed change.\n- [ ] An inbound status change into an active status cascades to eligible ancestors,\n      with tests driving the inbound-apply path (not `transition_compute`): the new test\n      module above passes, and its central case fails on the pre-fix code (RED\n      demonstrated in-session).\n- [ ] The cascade decision is single-sourced on `_CASCADING_EDGES` /\n      `_resolve_parent_in_status` from `rebar._commands.transition` (no duplicated edge\n      table); checked by inspection of the diff.\n- [ ] `make lint`, `make typecheck`, the complexity ratchet, and the targeted reconcile\n      test suites (`tests/unit/rebar_reconciler`) pass in the worktree.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/apply_inbound_events.py","reason":"add the inbound parent-first STATUS cascade helper, call it from both inbound STATUS writers, and add the no-op suppression"},{"path":"docs/concurrency.md","reason":"scope the I4a invariant across both write surfaces per the operator ruling"},{"path":"tests/unit/rebar_reconciler/mutate/test_inbound_status_cascade.py","reason":"new tests driving the inbound-apply path: cascade, chain, negatives, batch no-fight, create path"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","0446-4278-b7df-438d"],["relates_to","4329-4761-6e3d-41d7"],["relates_to","9d67-b074-f28d-43b1"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ec276072-808b-4e82-9865-c89fea6755e2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"bb73-97de-eeea-4899","ticket_type":"bug","title":"Inbound reconcile writes STATUS directly, bypassing the parent-first cascade","verify_commands":[]},"source_event_uuids":["e8720bed-0552-4a73-88a3-9cbeb3515bcf","f8d5cd44-976d-4628-8c6d-fc25c3c5980b","e4e1ad56-c69d-4271-a747-2104b5328f75","c2c93dc3-2d02-46d1-92e9-a66936605993","7095451a-aa57-451e-8b53-3cf18c3ca582","91190347-8647-4151-9a82-520c6b528b81","5ff03693-1f8e-49f2-a707-d8273d9653fa","ec276072-808b-4e82-9865-c89fea6755e2","02b4e091-ac9e-42bb-a9a8-b5a48e39d277","33844cea-32e3-4dd1-a856-0a172c4453b3","570831a3-115b-4355-9d45-6feaff36a75a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787362303439243978,"uuid":"5155ec42-63b7-419c-9cfa-57581ac014ce"}