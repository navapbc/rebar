uid":"28fdc65c-18a2-4f85-ae6e-394016b4caa7","position":{"commit_sha":"7036c29bcffb622fb251bcddde67658d4ac05184","position":"1785391312380698001-28fdc65c-18a2-4f85-ae6e-394016b4caa7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"856f1f9da16eddef82a882ab842f2d07fc025956f97002801a2196fa5afd4d59","event_uuid":"00fee182-30e6-4fcd-9bf2-c0cab2fa36c4","position":{"commit_sha":"40fb0dbddb289b9c764787f626ae4e645b65235e","position":"1785391713158001001-00fee182-30e6-4fcd-9bf2-c0cab2fa36c4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2b01b1d60ae136b1a20cb8e7951fad2ff837d0e69f59ef9ad9b3d6adabd36b64","event_uuid":"02330983-ad63-4139-93f8-8690e04aeab7","position":{"commit_sha":"5558361700278f4983423a49d952f05ce8b30293","position":"1785391716249198001-02330983-ad63-4139-93f8-8690e04aeab7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"de5a52faa2b0daf4c7c83c7cace7712cf053cbbb277c477a1380d1e77f425380","event_uuid":"29de3673-711d-42d9-bcef-17812e6f26a8","position":{"commit_sha":"29af5a73c1fd554bd26e737642b0f6cc11dc6ec8","position":"1785392313334838001-29de3673-711d-42d9-bcef-17812e6f26a8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.author