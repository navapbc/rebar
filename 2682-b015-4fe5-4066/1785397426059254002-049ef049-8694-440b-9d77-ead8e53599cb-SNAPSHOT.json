{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785397426059254002,"compiled_state":{"alias":"punctual-scavenger-fallowdeer","assignee":"","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"5d0840aecc817393394b72b22140ab960e582b6b","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 2682-b015-4fe5-4066","material: 42498925222cd718","model: claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: planning","rebar-version: 0.10.1 (5d0840aec)","regver: f9bb73223e5d6715","verified-at-sha:5d0840aecc817393394b72b22140ab960e582b6b","dep 649667d297c67f6413e364b62a0b9f155b2598c6abb3a580a3e639de718926a4 src/rebar/llm/runner.py","dep absent src/rebar/llm/structured_run.py","dep 0530d9b3f72749de5eb622364ab21220b3ee5c7675af7a0149b7b9aa40858931 tests/interfaces/store/test_execution_mode_dispatch.py"],"material_fingerprint":"42498925222cd718","merged_log_commit":"5d0840aecc817393394b72b22140ab960e582b6b","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1785392768344848000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"faa7e38f7bbdafef2d5bb9a327a3187b125be84d4feda6fa92cc3dde4882dd1d","event_uuid":"69d7401b-fc45-4311-9167-a746b12b57aa","position":{"commit_sha":"2401c201de56894f3aefaf24bc5625bc088772ac","position":"1785380992394330001-69d7401b-fc45-4311-9167-a746b12b57aa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9