639943c1bcaa64285a8a7e613ba5010b939a","position":"1787424494270686001-e07b7f97-d137-4ce0-a767-c111744c5d94"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"652d6ea6c3afcfc7b2899908d89631210dd0762ef3dc734c360e7f136d46e335","event_uuid":"d0b632cc-a2af-49aa-b8f8-db438dc19890","position":{"commit_sha":"4756639943c1bcaa64285a8a7e613ba5010b939a","position":"1787424499205074001-d0b632cc-a2af-49aa-b8f8-db438dc19890"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"498a54e5d2635f73a87f0e654d2a7aaba9c1b93a789b4719af3c63fd1c0b424d","event_uuid":"058eaf96-78bc-4776-ab5b-2ab681588f7d","position":{"commit_sha":"dd6d3f72c8430ba36ad78a601138491d898dbe4c","position":"1787425261731258940-058eaf96-78bc-4776-ab5b-2ab681588f7d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787423704453228001,"creation_channel":"cli","deps":[{"link_uuid":"2b67d4e8-8fab-483f-83f5-664af826fcf6","relation":"discovered_from","target_id":"3fa7-94ba-42aa-4623"},{"link_uuid":"058eaf96-78bc-4776-ab5b-2ab681588f7d","relation":"relates_to","target_id":"57d4-d260-550e-4946"}],"description":"## Problem\nThe Verified gate's integration tier runs `pytest -n 4 --dist loadgroup --timeout-method=thread`. When a thread-method timeout (or any crash) kills an xdist worker, loadgroup/loadscope requeues the dead node's whole pending workload INCLUDING the crashing item (loadscope.py:166-205), so every respawned worker re-runs it and dies again, up to xdist's default restart cap of numprocesses*4 = 16 (dsession.py:555-568). Measured locally: one 20s-timeout test cost 183s at -n 2 (9 failures from one bad test); at CI integration scale this burns toward the 60-minute job ceiling (bug 3fa7, runs 32585303586 / 32587991195). Upstream xdist #1094/#1189 document the cascade; fixes unmerged as of Aug 2026.\n\n## Approach (operator-approved 2026-08-22, conditional on OSS adoption — condition verified)\nAdd `--max-worker-restart=0` to the integration (loadgroup) pytest lane in .github/workflows/_build-and-test.yml, so a worker crash aborts the session immediately and cleanly (xdist triggershutdown) instead of cascading respawns. Fail-fast precedent: huggingface/transformers sets max-worker-restart=0 globally with group-scoped dist modes (.circleci/create_circleci_config.py); BerriAI/litellm pairs a restart cap with timeout_method=thread; upstream docs/crash.rst sanctions =0 to disable restarting. This is a guard, not the primary fix — the budget restore (change 2115, merged) is the fix; this bounds the blast radius if any test ever hangs again.\n\nScope: the loadgroup lane only (worksteal does not re-dispatch the crash item — verified empirically). Extend the existing CI-parity contract test (tests/unit/test_ci_workflow_parity.py hang-guard family) to pin the flag so it cannot silently regress. No behavior change for green runs.\n\nNote: per the workflow-text provenance rule (Gerrit gate executes _build-and-test.yml from trusted main), this change is inert on its own Verified run and takes effect only after merge. That is expected and fine — its own run just needs to be green.\n\n## Acceptance criteria\n- [ ] Integration lane in .github/workflows/_build-and-test.yml carries --max-worker-restart=0\n- [ ] A contract test pins the flag on the loadgroup lane (RED before the workflow edit, GREEN after)\n- [ ] make lint, typecheck, and complexity ratchet clean (new=0 increased=0)\n- [ ] No other lane or pytest config altered","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/_build-and-test.yml","reason":"add --max-worker-restart=0 to the integration loadgroup lane"},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"contract test pinning the flag on the loadgroup lane"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","57d4-d260-550e-4946"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"e07b7f97-d137-4ce0-a767-c111744c5d94","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"8a4f-f0f4-ed92-4c70","ticket_type":"task","title":"Bound loadgroup worker respawns with --max-worker-restart=0","verify_commands":[]},"source_event_uuids":["002afec7-ad76-478d-8553-5db3d957bed1","14580754-a61b-4bca-9570-12362a3786e5","2b67d4e8-8fab-483f-83f5-664af826fcf6","1841380f-f453-4a5e-a7ae-2aa24bf1ac84","e07b7f97-d137-4ce0-a767-c111744c5d94","d0b632cc-a2af-49aa-b8f8-db438dc19890","058eaf96-78bc-4776-ab5b-2ab681588f7d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787425261731258941,"uuid":"2a3392ba-5487-4a34-84fe-3df5bf2035cb"}