{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, io, json, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nBASES=json.loads(\"{}\")\nALLOWED=json.loads(\"{\\\"tests/unit/test_ci_tickets_push_policy.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_ci_workflow_parity.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_every_ci_pytest_lane_has_a_per_test_hang_guard\\\",\\\"test_the_shared_tier_lanes_are_flag_free_and_governed_by_the_ini\\\",\\\"test_integration_lane_fails_fast_on_worker_crash_and_worksteal_lane_does_not\\\",\\\"test_macos_default_suite_lane_passes_when_platform_compat_collects_nothing\\\"],\\\"comments\\\":[[\\\"<module>\\\",\\\"_OPTIONALITY_SUITE = (\\\\\\\"tests/unit/test_core_optionality.py\\\\\\\", \\\\\\\"tests/unit/test_optional.py\\\\\\\")\\\"]]},\\\"tests/unit/test_claim_default_assignee.py\\\":{\\\"docs\\\":[\\\"test_default_assignee_resolves_when_the_tracker_lives_outside_the_repo\\\",\\\"test_plan_review_gate_still_applies_when_the_tracker_lives_outside_the_repo\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_body_guard.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_json_js_safe_guard.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_registry_cutover_s6_heldout.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_registry_cutover_s6.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_registry_dispatch.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_registry_split.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_cli_registry.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[[\\\"test_construction_imports_no_command_handlers\\\",\\\"forbidden = (\\\"]]},\\\"tests/unit/test_close_autoresume_b5f8.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_close_gate_insufficiency_only_fail_disposes_as_retryable_exit_11\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_disposition_attestation_738a.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_every_replacement_bearing_class_can_produce_a_verdict\\\",\\\"test_a_force_close_is_still_never_signed_even_for_a_linked_duplicate\\\",\\\"test_the_precheck_ACTUALLY_returns_the_disposition_verdict\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_gate_bound_message_d59e.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_genuine_unavailability_still_recommends_installing_the_extra\\\",\\\"test_non_bound_recovery_failure_does_not_claim_a_size_breach\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_gate_bound_remedy_db1c.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_advising_a_description_edit_must_name_the_attestation_cost\\\",\\\"test_the_remedy_never_offers_comment_shortening\\\",\\\"test_the_size_diagnosis_survives_the_new_remedy\\\",\\\"test_the_remedy_points_at_a_lever_the_operator_can_actually_pull\\\",\\\"test_a_real_ticket_sized_like_2932_is_no_longer_refused\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_gate_disposition_69b9.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_gate_step_budget_message_d59e.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_precheck_duplicate_link_c8fd.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_a_duplicate_close_with_no_link_names_the_exact_link_command\\\",\\\"test_a_duplicates_link_to_a_closed_canonical_still_takes_the_disposition_path\\\",\\\"test_reason_required_dispositions_are_refused_pre_llm_not_routed_to_the_verifier\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_close_precheck_message_fb8b.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef normalize(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True)\n    seen=set()\n    allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]\n                seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path):\n    tree=ast.parse(raw,type_comments=True)\n    lines=raw.splitlines()\n    scopes=[(\"<module>\",1,len(lines))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno))\n                walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\")\n    full={}\n    inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]\n    i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1\n            continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((scope for scope in scopes if scope[1]<=comments[0][0]<=scope[2]),key=lambda scope:scope[2]-scope[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(value for _,value in comments)))\n    rules=ALLOWED[path][\"comments\"]\n    for scope,prefix in rules:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in regions)>1:\n            raise SystemExit(\"ambiguous comment stable id: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    protected=[region for region in regions if not any(region[0]==scope and region[1].startswith(prefix) for scope,prefix in rules)]\n    return inline,protected,regions\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    before=source(base,path)\n    after=source(\"HEAD\",path)\n    if normalize(before,path,True)!=normalize(after,path,False):\n        raise SystemExit(\"normalized AST changed: \"+path)\n    before_inline,before_protected,before_regions=comment_state(before,path)\n    after_inline,after_protected,after_regions=comment_state(after,path)\n    for scope,prefix in ALLOWED[path][\"comments\"]:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in before_regions)!=1:\n            raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    if before_inline!=after_inline:\n        raise SystemExit(\"inline comment changed: \"+path)\n    if before_protected!=after_protected:\n        raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)' tests/unit/test_ci_tickets_push_policy.py tests/unit/test_ci_workflow_parity.py tests/unit/test_claim_default_assignee.py tests/unit/test_cli_body_guard.py tests/unit/test_cli_json_js_safe_guard.py tests/unit/test_cli_registry_cutover_s6_heldout.py tests/unit/test_cli_registry_cutover_s6.py tests/unit/test_cli_registry_dispatch.py tests/unit/test_cli_registry_split.py tests/unit/test_cli_registry.py tests/unit/test_close_autoresume_b5f8.py tests/unit/test_close_disposition_attestation_738a.py tests/unit/test_close_gate_bound_message_d59e.py tests/unit/test_close_gate_bound_remedy_db1c.py tests/unit/test_close_gate_disposition_69b9.py tests/unit/test_close_gate_step_budget_message_d59e.py tests/unit/test_close_precheck_duplicate_link_c8fd.py tests/unit/test_close_precheck_message_fb8b.py","dd_id":"semantic","dd_text":"Immutable/final Python parses; only allowlisted leading docstrings and full-line comment regions may differ; normalized runtime ASTs match."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, json, re, subprocess, sys, tokenize\nBASE=\"d6669496cae441fc8381b5ee6de21a3993defd84\"\nBASES=json.loads(\"{}\")\nPATTERN=re.compile(r\"#\\s*(?:!|(?:-\\*-\\s*)?coding[:=]|noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\",re.IGNORECASE)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT or not PATTERN.match(tok.string):\n            continue\n        row,col=tok.start\n        left=lines[row-1][:col].rstrip()\n        if left:\n            anchor=(\"inline\",left.strip())\n        else:\n            anchor=(\"next\",\"<EOF>\")\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    anchor=(\"next\",stripped)\n                    break\n        found.append((tok.string,anchor))\n    return found\nfor path in sys.argv[1:]:\n    base=BASES.get(path,BASE)\n    if signatures(source(base,path))!=signatures(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \"+path)' tests/unit/test_ci_tickets_push_policy.py tests/unit/test_ci_workflow_parity.py tests/unit/test_claim_default_assignee.py tests/unit/test_cli_body_guard.py tests/unit/test_cli_json_js_safe_guard.py tests/unit/test_cli_registry_cutover_s6_heldout.py tests/unit/test_cli_registry_cutover_s6.py tests/unit/test_cli_registry_dispatch.py tests/unit/test_cli_registry_split.py tests/unit/test_cli_registry.py tests/unit/test_close_autoresume_b5f8.py tests/unit/test_close_disposition_attestation_738a.py tests/unit/test_close_gate_bound_message_d59e.py tests/unit/test_close_gate_bound_remedy_db1c.py tests/unit/test_close_gate_disposition_69b9.py tests/unit/test_close_gate_step_budget_message_d59e.py tests/unit/test_close_precheck_duplicate_link_c8fd.py tests/unit/test_close_precheck_message_fb8b.py","dd_id":"directives","dd_text":"Directive text and attachment remain exact on every owned path."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines())\nif actual!=expected:\n    raise SystemExit(\"one-commit path set mismatch: actual=\"+repr(actual)+\" expected=\"+repr(expected))' t