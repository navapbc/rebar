hree sum to the budget'.","group_criteria":null,"group_id":null,"id":"f604aab7fb7e0f8cf","impact":0.264,"is_primary":null,"location":"'Which file owns what, and one budget' section","norm_id":"nc12f2cc70e5963c8","priority":0.132,"reason":"default-advisory","recalled":false,"scenarios":["An implementer updating docker-storage-cap.sh reads 20/2/13 and cannot tell what the third share's value is"],"severity":null,"suggested_fix":"Add the BuildKit share figure: 'leaving images 13 GiB and the BuildKit cache 5 GiB, so 13 + 5 + 2 = 20 GiB'.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Name the per-candidate writable-layer size source the reaper uses to order oldest-first and to test the 80% low-water mark after each removal (e.g. `docker ps -a --size`/SizeRw with creation timestamp), distinct from the aggregate `docker system df` reading §2i publishes.","cohort":["G6"],"criteria":["G6"],"decision":"dropped","decision_margin":-0.5175,"drop_reason":null,"evidence":["AC1: 'reaps oldest-first to an 80% low-water mark'","'candidates come