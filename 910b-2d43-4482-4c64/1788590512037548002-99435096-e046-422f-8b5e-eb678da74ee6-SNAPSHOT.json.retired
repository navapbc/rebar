t_sha":"13543c8a0563fc0d542fef3a4e86cbfcc8e10bfb","position":"1788590328070910001-201504a1-b72c-4408-a8b8-a9f016f334b3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"713df643e58fcef2a59a3df4c47a38613621be7626f91c32c3f146ce92456b8b","event_uuid":"679c9132-6a28-4ac1-9b5a-f73a77f04507","position":{"commit_sha":"3585b3af24b6942e6ee99a2bd9af23f025d859ca","position":"1788590355740571001-679c9132-6a28-4ac1-9b5a-f73a77f04507"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"729b752eb145b6ad09aa8dcf863be063d36ce3f656082da8261ce4ccc9e4d642","event_uuid":"b7468eac-328b-4f96-bf6c-dbeadc0e0775","position":{"commit_sha":"793a31dfeadfc071984673d02aaf2ad7f1fbd851","position":"1788590388015618001-b7468eac-328b-4f96-bf6c-dbeadc0e0775"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0ef557d4cd73d8d898b42825cb3dfd3ad16974d5cbca4c162050c646e4b5fa53","event_uuid":"0b7af90a-1809-41f3-82c4-4b3bebe8c445","position":{"commit_sha":"0c4c627f64b59ee23ff3e1f393c11c2736612f42","position":"1788590423461622001-0b7af90a-1809-41f3-82c4-4b3bebe8c445"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8dbe24f34818eb36b40b9e77f6b49e2618ad4b64d963dd407333efb02c43971c","event_uuid":"1cb9bdbe-190a-456b-a3fa-85c93ba0c3a0","position":{"commit_sha":"dde86402ac14c0195516cbcbd9b91c326340a504","position":"1788590452765347001-1cb9bdbe-190a-456b-a3fa-85c93ba0c3a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"17e1b560fde0fbaad89216ecaf5c263216f5e7b288c0f1fb2a452769dd028eaa","event_uuid":"7ad53fd3-4a7e-4803-98a0-f19068404225","position":{"commit_sha":"3b2dc92ee9dbf91fc5fb75e09a0eb83585ca544f","position":"1788590482704853001-7ad53fd3-4a7e-4803-98a0-f19068404225"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ad77e035551e09d33dd75b4790c417c39a612abb5096dd95aedd985a054cc0cf","event_uuid":"49d6e686-24da-4d07-b50a-731082d4cd74","position":{"commit_sha":"4f8196f21daff11b36504b6e837544109172fe6f","position":"1788590512037548001-49d6e686-24da-4d07-b50a-731082d4cd74"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788375027119321123,"creation_channel":"mcp","deps":[],"description":"## Why\nWritable container layers are each container's overlay2 `upperdir`. They grow independently of\nimage layers and BuildKit cache, no prune reaches them, and nothing measured them on 2026-09-02\n— the only signal was \"root disk high\". The last cap under ADR 0112.\n\n## Mechanism decision, with evidence\nThe ticket offers a runtime storage quota \"when compatible\", else a reaper. **The quota is NOT\ncompatible here.** overlay2's `--storage-opt size=` (and the `overlay2.size` daemon default) is\naccepted only when the filesystem backing `/var/lib/docker` is XFS mounted with `pquota`, else\nthe daemon refuses: `--storage-opt is supported only for overlay over xfs with 'pquota' mount\noption`. That filesystem is ROOT here, and XFS reads quota options at MOUNT time and refuses\nthem on a remount — so it needs `rootflags=pquota` and a REBOOT: the constraint S4 (`2ba3`) hit\nfor `/var/tmp`, re-derived and binding here. Even after that reboot it is PER-CONTAINER, not an\naggregate ceiling, and applies at creation, so every live service must be recreated. So this\nships the mitigation, publishes which regime the box is in, and documents the enablement steps.\n\n## What the reaper does NOT guarantee\n1. **It cannot reclaim a RUNNING container's writable layer at all.** Only exited/dead ones are\n   removable, so for the live compose set this is MEASUREMENT AND AN ALARM, not a bound; only\n   the reboot-gated quota would bound those. Sharper than S4's fill rate, so it is said first.\n2. For the debris it does bound, the bound is `cap + fill_rate x interval`: at 2 GiB and 300 s a\n   sustained net fill above ~7.2 MB/s outruns it, and this gp3 volume does 125 MB/s (~17x).\n3. Nothing that exited inside the 900 s grace window is removed, so a burst of fresh exits is\n   unreclaimable by design. When it cannot get under the share it SAYS SO.\n\n## Safety — proved against the live set\n`docker container prune --filter until=…` cannot express what this host needs: its filters are\n`until` and `label` only, with NO name filter. `autodeploy.sh` starts the mcp blue-green backends\nwith a bare `docker run` compose never sees, and reaps them in `mcp_retire_sweep` under a guard\nthis reaper cannot replicate — it reads the nginx `/mcp/` upstream include and refuses to reap\nan exited container still named as the live backend, since `--restart always` would have\nrestored it. Reaping one anyway is bug `9ea3`: a transient exit became a permanent 502 on\n2026-09-02. So candidates are enumerated and removed individually, sparing:\n\n* anything labelled `com.docker.compose.project` (gerrit, review-bot, opcert, compose-mcp-1):\n  an exited compose service is a crashed one whose logs are the evidence;\n* anything labelled `rebar.service` (`mcp_run_new`'s stable identity);\n* anything matching `^(rebar-mcp|compose-mcp-1)` — `mcp_managed`'s regex, so the two agree.\n\nTwo daemon-enforced guarantees, not shell logic: candidates come from `docker ps -a --filter\nstatus=exited --filter status=dead`, which never lists a running container; removal is\n`docker rm` WITHOUT `-f`, which the daemon refuses for a running one (the precedent\n`mcp_retire_image` relies on). No `-v`/`--volumes`; `docker system prune` never used.\n\n## What invokes the reaper, and what publishes the heartbeat\nTwo DIFFERENT callers; naming one is how a heartbeat ends up with no producer.\n* The REAPER runs from its own `rebar-container-reaper.timer` (5 min, `TimeoutStartSec` nested\n  strictly below the period per bug `1205`), rendered by `--print-units` and installed by\n  `compose-up.sh` beside the three caps it already installs. A timer rather than a hook in the\n  autodeploy tick, because `prune_docker_caches` runs only on deploy/backoff/pressure paths and\n  a quiescent `main` never reaps.\n* The HEARTBEAT is published by `observability.sh`, whose 5-minute timer already exists\n  (`install-observability.sh`); §2i calls the side-effect-free `--check-active`. So \"every tick\"\n  is the OBSERVABILITY tick, and the heartbeat still has a producer when the reaper timer is the\n  dead thing — the point of having it.\n\n## Observability (S2's publish-or-stay-silent rule)\n§2i, from the SAME single `docker system df` call §2f already makes — the format string gains\n`{{.Reclaimable}}` rather than a second daemon walk: `container_writable_bytes` (Containers\nSize), `container_exited_bytes` (Containers Reclaimable), `container_writable_used_percent`\n(`pct_of_cap`, S3's helper, reused), `container_reaper_active` (1/0 heartbeat) and\n`container_quota_enforceable` (1/0: is the kernel enforcing XFS project quota on the Docker root\nfs, i.e. could a ceiling exist at all). Non-heartbeat readings publish ONLY on success.\n\n**Field surface verified — MATCH.** `docker system df --format` exposes `{{.Reclaimable}}`; on\nthe Containers row `Size` sums writable layers (`SizeRw`) and `Reclaimable` is the non-running\nsubset, i.e. the stopped-container debris. Checked against the CLI reference before the\nformat string was changed. An unrecognised row or a missing third field publishes NOTHING for\nthat reading, so a rendering change degrades to silence.\n\n## Alarms (`monitoring_autodeploy.tf`)\n`rebar-container-writable-usage-high` (>85%) and `rebar-container-reaper-not-active` (<1).\n**The second pre-empts the S4 finding**: without it a silently-dead timer leaves usage nominal\nwhile nothing enforces anything. Both `treat_missing_data = \"breaching\"`, both SNS-wired.\n`container_quota_enforceable` gets NO alarm: its honest value is 0 until the reboot, and an\nalarm that pages continuously is muted within a day.\n\n## Which file owns what, and one budget\n`docker-storage-cap.sh` owns the BUDGET; `container-cap.sh` owns only the reaper, the checks and\nthe rendering. ADR 0112 puts this share INSIDE the Docker budget, so `docker-storage-cap.sh`\ngains `DOCKER_CONTAINER_WRITABLE_BYTES` (2 GiB) carved out of the existing 20 GiB, leaving\nimages 13 GiB; `container-cap.sh` READS it, so no second literal can drift. The 2 GiB is a\nstarting point under ADR 0112 decision 6, labelled as one: no writable-layer figure was captured\nat the outage, so it is sized from the split, not a measurement.\n\n## Scope\nIn, enumerated: NEW `infra/scripts/container-cap.sh`; `docker-storage-cap.sh` (third share);\n`observability.sh` (§2i + extended parse); `compose-up.sh` (installs the timer);\n`infra/terraform/monitoring_autodeploy.tf`; `infra/runbooks/review-bot-ops.md`; tests.\nOut: overlay2 deletion, the BuildKit cap (S2), journald (S3), `/var/tmp` (S4), gate scratch.\n\n## Acceptance Criteria\n- [ ] `--reap` removes an exited unowned container when the footprint exceeds the share, nothing\n      under it, reaps oldest-first to an 80% low-water mark, and WARNs naming the running and\n      protected bytes when it cannot get under. (`tests/scripts/test_container_cap.py`)\n- [ ] `--reap` removes nothing for each of: a `running` row; a `com.docker.compose.project`\n      label; a `rebar.service` label; a `rebar-mcp-*` / `compose-mcp-1` name; an exit inside the\n      grace window; an unreadable share. Its argv never contains `-f`, `-v`, `--volumes`,\n      `system prune` or `container prune`. A test pins the name pattern to `mcp_managed`'s.\n- [ ] `observability.sh` publishes the three readings from a parseable Containers row and NONE\n      when it is absent or unparseable; percent clamped to 100; both heartbeats publish every\n      tick including their 0 path; all five dimensionless.\n- [ ] `docker-storage-cap.sh --print-env` states the third share, the three sum to the budget,\n      and an over-subscribed split is refused.\n- [ ] Both alarms exist by name, `treat_missing_data = \"breaching\"`, SNS-wired, asserted in\n      `tests/unit/test_alarm_actions_terraform.py`; `terraform fmt -check`/`validate` pass.\n\n- [ ] The runbook documents diagnosis, remediation, the `rootflags=pquota` + reboot steps, and\n      forbids manual overlay2 deletion.\n- [ ] Portability: Docker APIs, systemd and local pytest only; no CI-provider trigger.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/scripts/autodeploy.sh","reason":"Add bounded stopped-container/writable-layer reaping if implemented in autodeploy path."},{"path":"infra/scripts/compose-up.sh","reason":"Install Docker runtime storage quota config or cleanup timer if needed."},{"path":"infra/scripts/observability.sh","reason":"Publish writable/exited-container layer usage/cap metric."},{"path":"infra/terraform/monitoring_autodeploy.tf","reason":"Add writable-container-layer saturation CloudWatch alarm."},{"path":"infra/runbooks/review-bot-ops.md","reason":"Document safe container-layer remediation and no manual overlay2 deletion."},{"path":"tests/unit/test_autodeploy_prune.py","reason":"Cover container prune/reaper safety."},{"path":"tests/scripts/test_observability_disk_pressure.py","reason":"Cover writable/exited-container metric emission."},{"path":"tests/unit/test_alarm_actions_terraform.py","reason":"Assert new alarm action wiring."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["blocks","e956-b1c3-45b9-4016"],["parent","6202-e1c7-c57f-4897"]],"no_file_impact_reason":"","parent_id":"6202-e1c7-c57f-4897","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"open","tags":["infra","gerrit","disk-ceiling","containers"],"ticket_id":"910b-2d43-4482-4c64","ticket_type":"story","title":"S5 — Bound writable container layers and alarm on exited-container debris","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_autodeploy_prune.py tests/scripts/test_observability_disk_pressure.py tests/unit/test_alarm_actions_terraform.py","dd_id":"AC3","dd_text":"Writable container layer reaping, metrics, and alarms are covered."},{"command":"terraform -chdir=infra/terraform validate","dd_id":"AC4","dd_text":"Terraform syntax remains valid."}]},"source_event_uuids":["74c142b4-21a9-4384-9f99-a27e8c6fb60e","d325701f-bfe4-4287-9830-0194dc43dc90","7670c007-b4de-4ee8-9ed3-55d5b76ec772","36dd3383-3a27-44c5-b02f-8b30ba6a2a44","4c9b843b-beca-42d2-b345-fcd26d820541","aece4dad-9ca1-4e4a-b402-78241df7490d","201504a1-b72c-4408-a8b8-a9f016f334b3","679c9132-6a28-4ac1-9b5a-f73a77f04507","b7468eac-328b-4f96-bf6c-dbeadc0e0775","0b7af90a-1809-41f3-82c4-4b3bebe8c445","1cb9bdbe-190a-456b-a3fa-85c93ba0c3a0","7ad53fd3-4a7e-4803-98a0-f19068404225","49d6e686-24da-4d07-b50a-731082d4cd74"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788590512037548002,"uuid":"99435096-e046-422f-8b5e-eb678da74ee6"}