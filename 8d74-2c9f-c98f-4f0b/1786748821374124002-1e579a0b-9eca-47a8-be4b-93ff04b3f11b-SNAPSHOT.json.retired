:{"commit_sha":"26d2876fc3eb36d86fd82d7813ff27c0c31f4f84","position":"1786742430354741001-ee92d5af-4e02-4f70-a806-22297dc20af8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ba9d7cd20b295add7d6649e4b857360808d1d4e50dc0d3471659b084b772425c","event_uuid":"1a8422d3-319c-4973-b332-67932d217721","position":{"commit_sha":"4c89b550aad4a28fce728401ad8b0aecfc8b030c","position":"1786742976386936001-1a8422d3-319c-4973-b332-67932d217721"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b0b16f303de060c96102a5c44f75699d1dcf0e1aa7be322899adc274e8021a98","event_uuid":"182c417a-4c08-40bc-9fe4-f14cec33373f","position":{"commit_sha":"a229c001a8aa3f29856eb2929d2aa7c58589c025","position":"1786743539632916001-182c417a-4c08-40bc-9fe4-f14cec33373f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"602821d5f3991bb7f41ec0ebcc8a4760579bfa0eccdb6f64dbc318fe6b8e2d8d","event_uuid":"b838138c-4718-42b4-b48c-33ee029b8d71","position":{"commit_sha":"c73974be7ed5bf8690aa4a46d341238e07a9f7d1","position":"1786743718256100001-b838138c-4718-42b4-b48c-33ee029b8d71"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9d