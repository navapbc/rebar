id":"b8d08bad-6bd2-4613-85ad-e2567a5b4bea","position":{"commit_sha":"cb080947bbcbf2851d5024f41f9dd88f33ba00cd","position":"1786745879128384001-b8d08bad-6bd2-4613-85ad-e2567a5b4bea"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"055a1d7a9efdf27c4a970fc071b6155fff20fd57470d135f04e8936ece927a58","event_uuid":"4f6e7740-7a96-4b93-a0f8-2e9d65b9fbc6","position":{"commit_sha":"010e1a55feed844cc3380055d28c2c67eda934eb","position":"1786746077487738001-4f6e7740-7a96-4b93-a0f8-2e9d65b9fbc6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"566559bf392d0ce3e16e012c13048b9735a3374a3f8e1cfebeb7eca02adeaef0","event_uuid":"fc500ceb-4f59-4c17-9058-9615e4fd6612","position":{"commit_sha":"72588c8fbbe620fb263489f83831939d909d20e9","position":"1786746792619702001-fc500ceb-4f59-4c17-9058-9615e4fd6612"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"10377be23d9f1cd6af45b956eecbbdd4bb0d0bb7047ca38d5bd51b409452a61c","event_uuid":"96260b35-8279-44bc-ade4-6571e89142fc","position":{"commit_sha":"d4790b9c6f84dbcf3016d46878aecbf3125c9a48","position":"1786747183488897001-96260b35-8279-44bc-ade4-6571e89142fc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"48d466199262e6cf45d982c0819555d96a3bdc1c253370424b00527fc55e0729","event_uuid":"63b19b93-6c9a-4e8e-a959-fa8b5191b799","position":{"commit_sha":"67f301c71dd084a0f4ccfd259e3d37cf20ae694a","position":"1786747267958686001-63b19b93-6c9a-4e8e-a959-fa8b5191b799"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bade4bd7af8966b67f28e087fa247fe1163f56ee55eeeeb491d5ef40bb721d30","event_uuid":"bc63e420-6de9-44ec-9515-d12db899a6a2","position":{"commit_sha":"67f301c71dd084a0f4ccfd259e3d37cf20ae694a","position":"1786747268845340001-bc63e420-6de9-44ec-9515-d12db899a6a2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fa007ddc553a3ae4268a2eefc4031d5670cb4a7205d6c836a6062eb940dbeb65","event_uuid":"8273a5e0-7f01-4f58-8c55-7d40b60b0174","position":{"commit_sha":"c9f96caf4ac87cd8d83c4a428b641c73eb9b9a65","position":"1786748821374124001-8273a5e0-7f01-4f58-8c55-7d40b60b0174"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Validation data (7-day store mining, report in session files): BUDGET-EXHAUSTION-FALSE-UNMET is the top failure mode (10 incidents; observed exhaustions at request_limit 24-56 on 6-14-AC tickets), confirming the floor/scaling fix. Implementer cautions from the data: (1) validate bank persistence against REAL retry patterns — 5e53 and 266d retried at new --ref / refreshed worktrees, which would rotate a whole-tree key; the plan's file_impact-scoped blob fingerprint must be tested against exactly those flows (unrelated commits + worktree refresh must NOT invalidate). (2) dd41 retro: the budget lever was raised five times without spend data — size the new defaults against the runner's existing steps=N/limit logs (usage_report.py) and record observed headroom in the closing evidence. (3) Per-criterion fan-out was previously implemented and REMOVED for exploding token/wall-clock cost (12b7) — the child-traversal term must stay a budget-sizing input, never a fan-out execution model. (4) ZERO-BANKING-WEDGE is budget-independent (cf3c: 4x budget, 0 banks) — out of scope here, handled by 265a-9014-bd16-4623 (ERROR outcome).","timestamp":1786743718256100001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator context (2026-08-14), recorded so this work is interpreted correctly: the verifier was originally a simple harness-native read-only subagent and was reliable; runaway tool calls / context overruns appeared only after the harness-independent transition, and the banking/budget/recovery machinery is containment for those emergent failure modes. This ticket (generous budgets + child-traversal term + PASS-verdict cache) is INTERIM SYMPTOM RELIEF and proceeds as planned — but it is not a direction to extend. The long-term direction is viral-peppy-lowchen (b4be-0ed8-22cb-4b01): deterministic evidence prepack + single-pass verdict, demoting banking/budget to a rarely-exercised runaway backstop. Any further verifier complexity must justify itself against that simple-core goal.","timestamp":1786748821374124001}],"created_at":1786742425210037001,"creation_channel":"cli","deps":[{"link_uuid":"ee92d5af-4e02-4f70-a806-22297dc20af8","relation":"discovered_from","target_id":"1d71-a76c-04f6-4642"}],"description":"## Problem\nThe verifier's step budget routinely exhausts on legitimate validation, failing criteria as \"unmet\" that are merely unproven-within-budget (fb8a: request_limit=24, 2 false unmets; pony: repeated exhaustion, 5 then 1 false unmets). The pressure drives operators toward attestation-laundering.\n\n## Design intent (operator-stated)\nThe budget's ONLY goal is preventing runaway tool use. For valid tool use the floor must be GENEROUS with ample scaling; we never artificially limit authorized validation.\n\n## Current mechanics\n`verify_step_floor(c) = clamp(steps_per_criterion x c, step_floor_min, 480)`, defaults 8/48; structured_run halves steps into request_limit (6-AC epic: 48 steps = 24 requests). Defects: (1) story-calibrated cost model — epic criteria traverse child tickets (show_ticket + comments + repo reads, 5-10 requests each) plus fixed overhead, no evidence-surface term; (2) runaway is ALREADY separately guarded (tool_calls_limit, loop detection, the clamp), so a small budget adds no safety, only false FAILs; (3) no cross-run carryover — every re-verify re-proves all criteria (~10 min/cycle).\n\n## Plan\n1. Raise defaults: completion_verify_steps_per_criterion 8 -> 24, completion_verify_step_floor_min 48 -> 160 (supersedes the interim operator-machine config mitigation). Raise the 480 clamp to 960 so 24/criterion scales past 20 ACs — the clamp is a runaway ceiling, not a validation cap.\n2. Evidence-surface scaling: budget = per_criterion x c + child_traversal x direct_children + fixed_overhead, with defaults child_traversal = 16 steps/direct child and fixed_overhead = 16 steps (mid-band of observed 5-10 requests/child at the 2x steps halving; initial show_ticket+parse sizes the same). Both are new config keys: typed VerifyConfig fields (defaults 16) in _config_schema.py (:249-250 area) AND validators in _config_sections.py:35-36 style. Children counted from the ticket graph at budget-sizing time; any enumeration/read error at the completion.py:780 site fails OPEN to direct_children=0, preserving its \"enumeration must not raise\" invariant (criteria_count already fail-closes to 0 there, keeping the lean-install typed missing-extra LLMError path). The child term lands INSIDE `verify_step_floor` (new `direct_children: int = 0` param), NOT at the sizing call — its exactly-two consumers, primary sizing (completion.py:780) and `plan_recovery_pool` (completion_banking.py:224), stay on one formula. `plan_recovery_pool` gains a pass-through `direct_children` param (default 0) forwarded by its sole caller (completion_recovery.py:625); its docstring oracle pins (c=8 -> floor 64, N 32, global 48, successor 16; clamp-max) update to 24/160/960 mechanics with childless + childful rows.\n3. Cross-run PASS-verdict cache — a NEW ticket-scoped store; the run-scoped `CriterionBank` (completion_banking.py:396-435) stays as designed (run-unique dir = concurrent-close isolation). Cache at `.rebar/cache/completion_verdicts/<ticket>/<criterion-hash>.json`, written ONLY on a validated PASS at finalize (atomic tmp+rename; last-write-wins safe). Invalidation: NOT the whole-repo HEAD tree sha (`_resolve_tree_sha` :358-373 — any unrelated commit rotates it); key each entry by (criterion-text hash, scoped content fingerprint).The scoped fingerprint is NET-NEW code (BankStamps' material_fingerprint hashes PLAN TEXT, not file bytes): a new helper resolves each file_impact path to its git BLOB SHA (batch `git rev-parse HEAD:<path>`) and hashes the sorted (path, blob-sha) pairs; absent path -> sentinel; git failure disables reuse for the run (fail-open to re-verification); when own file_impact is empty but the ticket has children (the epic case), the fingerprint unions direct-child file_impact blobs (DIRECT children from the ticket graph, the same list budget sizing uses) — NOT `_subtree_impacts` (completion_prefetch.py:257; whole-subtree BFS, {path:count} frequencies not blobs, excludes root). Whole-tree sha is the fallback ONLY for childless tickets with empty file_impact. Cache entries store the FULL banked record (met, evidence, citations); at run start (completion_recovery.py:487 `CriterionBank.for_run`) still-valid entries are SEEDED into the run's bank, stamped `seeded: true`. Seeded ids are EXCLUDED from the primary's work surface twice over: (a) `primary_criteria_manifest` (DEFINED completion_banking.py:193, signature (expected, id_by_text); recovery.py:540 is its call site in `_primary_manifest_contract`) gains a `seeded_ids` frozenset param threaded through _primary_manifest_contract and omits those ids; (b) since the manifest is data-only, the primary context ALSO annotates each seeded criterion's prose with an \"already credited — do not re-verify\" directive, so the primary (launched first, :495) actually skips them. Finalizer interaction: `merge_finalizer_with_bank` today PRESERVES the finalizer's met on echoed records (only the evidence_sufficient marker re-stamps via `_restamp_marker`), so this plan SCOPES A CHANGE: `seeded: true` records bypass finalizer judgment — an echo (incl. a met:false downgrade) is replaced by the bank's validated-PASS record, an omission appended from the bank. Same-run (non-seeded) downgrade preservation unchanged — the rule keys strictly on the seeded flag. RED test: an echo that drops OR downgrades a seeded criterion still yields the credited verdict; a same-run downgrade is still preserved. Exhaustion converges across runs. (Marker semantics from 1d71-a76c: cached entries are PASS-only; insufficiency never cached.)\n4. Runaway guards stay authoritative: tool_calls_limit + loop detection unchanged; document at verify_step_floor that the budget exists ONLY for runaway prevention.\n\n## Acceptance criteria\n- [ ] Defaults raised (24/160; clamp 960), rationale documented at verify_step_floor; a 6-AC epic sizes to >=80 requests, a 15-AC epic to >=180; formula unit tests, INCLUDING updating the hard-coded pins in tests/interfaces/contracts/test_completion_budget.py (verify_step_floor(1)==48, (8)==64, (40)==320, (100)==480, captured max_iterations==48, _VERIFY_STEP_FLOOR_MAX==480) to the new mechanics.\n- [ ] Budget sizing adds a child-traversal term inside verify_step_floor (new direct_children param, default 0) so BOTH consumers — completion.py:780 primary sizing and plan_recovery_pool (completion_banking.py:224, forwarded by completion_recovery.py:625) — share the formula; new VerifyConfig fields + _config_sections validators for the two keys; epic-fixture test (childful sizes strictly larger than childless at equal criteria count, primary AND recovery pool; enumeration failure -> direct_children=0, no raise); plan_recovery_pool docstring pins AND the hard-coded pins in tests/unit/workflow/test_completion_banking.py:53-67 (floor/N/global/successor) updated to the new mechanics plus a childful row.\n- [ ] A re-verify after exhaustion credits still-valid cached PASS verdicts (same scoped fingerprint + criterion text) by seeding them into the run-scoped CriterionBank with the seeded flag; the primary manifest omits seeded ids AND the primary context marks each seeded criterion \"already credited — do not re-verify\" (both tested); the merge path credits seeded records verbatim (finalizer echo/omission cannot downgrade them) while same-run finalizer downgrades stay preserved; invalidation RED->GREEN on fingerprint or text change, INCLUDING an in-scope content edit (a file under file_impact changes, ticket text unchanged -> blob sha rotates -> cached PASS invalidated); an unrelated commit outside file_impact does NOT invalidate; run-scoped bank concurrent-close isolation regression-tested.\n- [ ] Runaway protection regression-guarded: tool_calls_limit and loop detection unchanged; a looping-tool fixture still trips the backstop under the larger budget.\n- [ ] `make lint`/`make typecheck` clean; lands via Gerrit (LLM-Review +1, Verified +1).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"63b19b93-6c9a-4e8e-a959-fa8b5191b799","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"8d74-2c9f-c98f-4f0b","ticket_type":"task","title":"Completion-verifier budget: generous runaway-only floor, evidence-surface scaling, cross-run bank persistence","verify_commands":[]},"source_event_uuids":["301129ed-039d-4c76-b319-833e43ae9d11","ee92d5af-4e02-4f70-a806-22297dc20af8","1a8422d3-319c-4973-b332-67932d217721","182c417a-4c08-40bc-9fe4-f14cec33373f","b838138c-4718-42b4-b48c-33ee029b8d71","8ad41692-f113-4912-bbb4-42a3fad8231f","3cd6464a-b827-4fc8-88d3-f9e0c9d76f57","194bce6d-dfc4-469c-967c-bf647bbb34c4","b8d08bad-6bd2-4613-85ad-e2567a5b4bea","4f6e7740-7a96-4b93-a0f8-2e9d65b9fbc6","fc500ceb-4f59-4c17-9058-9615e4fd6612","96260b35-8279-44bc-ade4-6571e89142fc","63b19b93-6c9a-4e8e-a959-fa8b5191b799","bc63e420-6de9-44ec-9515-d12db899a6a2","8273a5e0-7f01-4f58-8c55-7d40b60b0174"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786748821374124002,"uuid":"1e579a0b-9eca-47a8-be4b-93ff04b3f11b"}