ner_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5a867b07ff0fca74f7233dfe7d0969312c5a889e5b91c9c2eba1b0207cfc59b1","event_uuid":"bb225eac-d5e3-40a3-92da-26bcf9d4eeeb","position":{"commit_sha":"093e73ca3057396a6c26b78569f04be4e0bd857d","position":"1785862340018410001-bb225eac-d5e3-40a3-92da-26bcf9d4eeeb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c8c48c74dba50264fd2fefa824c86d23620443d48afa51dc583b6395ec62bb49","event_uuid":"04d19c6f-5759-4259-bca3-2641591c0a3d","position":{"commit_sha":"093e73ca3057396a6c26b78569f04be4e0bd857d","position":"1785862340575519001-04d19c6f-5759-4259-bca3-2641591c0a3d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0fb4e6e9363989f5140edb95118fcf672858503029e808a095286490ffcf2793","event_uuid":"f5f58e96-4c41-4563-a342-3ec08a6ee628","position":{"commit_sha":"bc5f72322b3b33573f7702d94353829d9505294b","position":"1785862463556169001-f5f58e96-4c41-4563-a342-3ec08a6ee628"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-221_agent","claim_remote_session":null,"claimed_session":"03d46327-27e5-406b-a8f2-adcd55335d05","comments":[],"created_at":1785727212352770001,"creation_channel":"cli","deps":[{"link_uuid":"0fa375d0-aaac-4317-94c3-0577eec2a33d","relation":"discovered_from","target_id":"049e-9fac-a821-4ea2"},{"link_uuid":"3d7d69f8-e5c8-47b5-860c-8134f8b65484","relation":"relates_to","target_id":"0e62-249f-77ee-49de"}],"description":"# Settle 049e's one documentary claim with a live measurement\n\n## Context\n\nBug `049e-9fac-a821-4ea2` made the DC comment ceiling configurable\n(`[tool.rebar.reconciler].comment_max_chars`, default 32767) and DROPPED the idea of\nauto-discovering the ceiling from `/rest/api/2/application-properties`, on the grounds that the\n`/advanced-settings` sub-resource where `jira.text.field.character.limit` is actually exposed\nrequires the global \"Administer Jira\" permission, while rebar authenticates as an ordinary user's PAT.\n\n**That conclusion is DOCUMENTARY, not measured.** 049e's agent tried to probe live and could not: the\n`tests/external/live_jira_dc` harness image is linux/amd64 only and its README records three measured\nattempts where Jira never became usable within an hour on the arm64 workstation. So no 403 was ever\ncaptured. 049e's AC asked for an EMPIRICAL determination and got a documentary one; rather than tick\nthat box on inference, the limitation was recorded and the probe deferred here.\n\n## Why this is worth doing rather than dropping\n\nThe probe is genuinely runnable — just not on that host. The `jira-dc-harness` job in\n`.github/workflows/external-integration.yml` runs the same harness on GitHub Actions' amd64 runners,\nwhere the image works. So this is a deferred measurement, not an impossible one.\n\n## What it does NOT change\n\n049e's remedy stands either way. Configuration is the correct fix whether or not the endpoint is\nreadable: a readable endpoint would enable an OPTIONAL auto-discovery convenience on top of the config\nkey, not invalidate it. So this ticket cannot regress 049e — it can only add an enhancement or confirm\nthe drop. That independence is why 049e was closeable with this leg outstanding.\n\n## Approach\n\nAdd a single cell to the live DC suite that requests `/rest/api/2/application-properties` (and the\n`/advanced-settings` sub-resource) with the harness's ordinary non-admin PAT and RECORDS the outcome —\nstatus code and body shape — asserting only that the outcome is one of the two documented\npossibilities, so the cell reports a fact rather than pinning a guess.\n\n## Acceptance criteria\n\n- [ ] a live DC cell requests `/rest/api/2/application-properties` with a NON-ADMIN PAT and records\n      the observed status code, run id, and job name on this ticket\n- [ ] the `/advanced-settings` sub-resource is probed separately, because that is where\n      `jira.text.field.character.limit` is exposed and its permission requirement may differ\n- [ ] the cell distinguishes 403 (permission, the documented expectation) from 404 (endpoint absent on\n      8.17.1) from 200 (readable) — a bare non-200 assertion does NOT satisfy this\n- [ ] the outcome is written back onto `049e-9fac-a821-4ea2` so its documentary claim is either\n      confirmed or corrected in the record\n- [ ] if the endpoint IS readable, a follow-up is filed for optional auto-discovery; 049e's config key\n      remains the supported mechanism either way","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"tests/external/live_jira_dc/test_transport.py","reason":"_request_as helper (arbitrary principal) plus the 275e probe cell: creates an ordinary user, mints its PAT, probes application-properties and advanced-settings with three positive controls"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","e369-a449-4773-48fb"],["relates_to","0e62-249f-77ee-49de"]],"no_file_impact_reason":"","parent_id":"e369-a449-4773-48fb","parent_status_uuid":"bb225eac-d5e3-40a3-92da-26bcf9d4eeeb","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"275e-81a4-f11a-4b5b","ticket_type":"bug","title":"Probe empirically whether /rest/api/2/application-properties is readable by rebar's non-admin PAT on DC","verify_commands":[]},"source_event_uuids":["d5cd9716-7fc7-4345-9348-ec1650b9f719","0fa375d0-aaac-4317-94c3-0577eec2a33d","1aac00a5-16f2-4157-a81d-c533e59d7dd5","bb225eac-d5e3-40a3-92da-26bcf9d4eeeb","04d19c6f-5759-4259-bca3-2641591c0a3d","f5f58e96-4c41-4563-a342-3ec08a6ee628","3d7d69f8-e5c8-47b5-860c-8134f8b65484"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785864643297404388,"uuid":"c63f2159-3ac3-42ff-8939-ca9af8166dc0"}