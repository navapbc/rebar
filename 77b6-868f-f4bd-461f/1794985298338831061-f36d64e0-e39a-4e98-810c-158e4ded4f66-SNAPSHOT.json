_uuid":"89244926-1b5e-457a-b0d8-9c1fd022613d","position":{"commit_sha":"ac53a3fb0e7672c633cd94b346b531edbc53259c","position":"1794969344291837914-89244926-1b5e-457a-b0d8-9c1fd022613d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a525c659922225e60a218c377eaf85f330ae5207f0ef8836a8246635a5c22c37","event_uuid":"fd3ee49a-80dd-4c77-8608-4c97ff5b467e","position":{"commit_sha":"53838aad0028081c83e2c1af91ff9e34c58c0e2d","position":"1794969352865566288-fd3ee49a-80dd-4c77-8608-4c97ff5b467e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4e438235f406a3be6df9ccef3671be93882e6120d209cc7967651caa16d381de","event_uuid":"a125d7e9-d368-417c-bcd5-bb0de2305c04","position":{"commit_sha":"703d558fa7e28fba6da16bdeac1a9e99635a4e1a","position":"1794969758671461125-a125d7e9-d368-417c-bcd5-bb0de2305c04"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e05f9009e6c8c157124682098b1a436cf1028b1fe2d2d54e3674844cb5edfa48","event_uuid":"1fd95461-c37e-4ef3-b829-eaa6b600045f","position":{"commit_sha":"7dda2be1209c2df140048704a943f7a02a3ec7c1","position":"1794970081443308463-1fd95461-c37e-4ef3-b829-eaa6b600045f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"11b6507682d99b725c079024d3b348c6bfdfd0df925190772c8de75b26f44944","event_uuid":"945f9e04-2684-4e51-afd7-d23426842f33","position":{"commit_sha":"7dda2be1209c2df140048704a943f7a02a3ec7c1","position":"179497008146394342