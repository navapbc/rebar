{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1794985298338831061,"compiled_state":{"alias":"dissocial-unpleasant-adouri","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"de94cc70b3be8d828e4ac612c553ed4d1756a60f","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 77b6-868f-f4bd-461f","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","rebar-version: 0.16.0","material: 6c8fd9919c5ee7e3","verified-at-sha:de94cc70b3be8d828e4ac612c553ed4d1756a60f"],"material_fingerprint":"6c8fd9919c5ee7e3","merged_log_commit":"de94cc70b3be8d828e4ac612c553ed4d1756a60f","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1794985298338530149},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"de94cc70b3be8d828e4ac612c553ed4d1756a60f","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 77b6-868f-f4bd-461f","material: 6c8fd9919c5ee7e3","material-part: children 647ea2107ca5072f 0","material-part: description 1c7d31e73176f1ed 5322","material-part: description_boxes b7fb217694ae2d30 6","material-part: file_impact a842e7fcae99a895 9","material-part: ticket_id 077837fd718d1319 19","model: bedrock:us.anthropic.claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 6","review-phase: execution