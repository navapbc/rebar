4-015642df9a7f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1b6f1c831f9999fddfaaf5b737d392210854866e7579923c42bd87302ef11252","event_uuid":"d15b8053-ec95-4ba9-839b-f019ad960fdf","position":{"commit_sha":"47df55736f7de711b9004dc9eb2167ae61b61b3e","position":"1794985018822138786-d15b8053-ec95-4ba9-839b-f019ad960fdf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1e72cb52c8e5fd8966e8ff80449f764e7c496c8776224e782543247170b612c2","event_uuid":"7eceac58-6885-4750-9d41-8678b452ef7e","position":{"commit_sha":"e62f51653a2171bcef179773c88d4f52cdf3bc87","position":"1794985297635889546-7eceac58-6885-4750-9d41-8678b452ef7e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"935b11527b378d47a3561a74c491518bbd7b64eb7dcbf009627797f08e2114f0","event_uuid":"2a148fca-63c9-4599-abe6-1484258adca8","position":{"commit_sha":"f5886dc5fd06ddfca1976455432120556c03a2ae","position":"1794985298338831060-2a148fca-63c9-4599-abe6-1484258adca8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"regression","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Released back to `open`; the claim is withdrawn.\n\nThis ticket was claimed on a mistaken read that it carried the\n`complexity-reduction` tag. It does not — it is eval CI infrastructure\n(the `prompt-eval.yml` live arm calls `ev.run_eval` with no gate session,\nso every case errors, `run_eval` records them as unscored rather than as a\ncrash, and `continue-on-error: true` downgrades the result to an advisory\nwarning). Real defect, correctly specified, but not complexity reduction.\n\nPlan review PASSED and was certified at\n`4c4e9b2f0ba89663c9d6ac86c7297690288d6106` (job\n1793822616425741639-2dd194319b2f4ccbb56fc89773b2692b), so whoever picks this\nup next can check currency with `rebar review-plan <id> --status` instead of\npaying for a fresh review. No code was written and no worktree was created.","timestamp":1793823897679082113},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Removed the `complexity-reduction` tag. This stays an open, valid bug — the live prompt-eval\nCI job really does score 0.0 on every spec — but it is not part of the complexity-reduction\nprogram, so it should not count against that program's census.\n\nTwo independent reasons, both from the operator's stated scope for that program:\n\n1. Evals are out of scope for complexity remediation. Running an eval does not reduce\n   complexity.\n2. The program's working test is whether the change DELETES something. Fixing a `run_eval`\n   call site that sits outside a gate session is a repair, not a deletion.\n\nTags remaining: `evals`, `ci`. Priority 1 is unchanged and the ticket is untouched otherwise.\n","timestamp":1793826378208996670},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented in local commit 1ae781b63ab (worktree fix-prompt-eval-live), shared with knightly-salty-orangutan and newborn-advanced-hoopoe: one change, because all three are needed before the eval-live loop scores anything and they touch disjoint files in the same subsystem (eval.py+workflow / eval_solver.py / eval_scorers.py).\n\n- `eval.py`: new `_gated(solve, repo_root=...)` resolves `resolve_gate_handle(None, SOURCE_LOCAL, repo_root, fetch=False)` once and runs every case inside `gate_read_root(handle)`; applied in `run_eval` and `calibrate_criterion`. `run_eval` now returns `errored` and `run_failure`.\n- `prompt-eval.yml`: specs with `run_failure` go to `::error::` and the step exits 1 after all JUnit files are written; scored regressions stay `::warning::`.\n- Offline evidence: the 3 new tests in `tests/unit/test_eval.py` pass on the change and all 3 fail when run against origin/main 05c6414358f code (PYTHONPATH pointed at a detached origin/main worktree).\n- No live LLM run: the offline tests reach `assert_gated` itself, which is the failing call, so a paid run adds nothing.\n- Portability: a contextvars marker plus `Path.resolve()` of the checkout; no subprocess, fd, signal or POSIX-only path API.\n\nNext: make verify, then Gerrit.","timestamp":1794971659878930510},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change 3421 patch set 1: LLM-Review +1, Verified -1. The only failure was my new test `test_calibrate_criterion_opens_a_gate_session_for_its_solver`, which called `calibrate_criterion(\"G7\")`; on the case-sensitive ubuntu runners `plan-review-G7.eval.yaml` does not exist (the file is `plan-review-g7.eval.yaml`). Switched the test to the `necessity` criterion (filename matches its prompt) and amended. The filename/prompt mismatch is a separate pre-existing defect that would also abort the eval-live loop on Linux at G7: filed as militant-vixenish-gorilla (discovered_from this ticket).","timestamp":1794978451546921963},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed: Gerrit change 3421, merged as 07f023db8031f1a09b5d0e51ea1ca3ff35cd63c2 (patch set 2, LLM-Review +1, Verified +1). make verify exited 0 on the pushed tree (21390 + 226 passed).\n\nImplementation note against Approach step 1-2: the helper is `_gated(solve, *, repo_root)` in `src/rebar/llm/evals/eval.py`, which resolves the SOURCE_LOCAL handle once (before any case) and enters `gate_source.gate_read_root(handle)` around each `solve` call, rather than a context manager around the loop. Same session, same explicit source; per-call wrapping also covers default-solver construction without re-indenting the loops. Applied in both `run_eval` and `calibrate_criterion`.\n\nAC evidence: tests `test_run_eval_opens_a_gate_session_for_its_solver`, `test_calibrate_criterion_opens_a_gate_session_for_its_solver` (uses the `necessity` criterion, see militant-vixenish-gorilla), `test_run_eval_reports_an_all_errored_epoch_as_a_run_failure`; all 3 fail against origin/main 05c6414358f code.","timestamp":1794984382585307672}],"completion_expectation":"required","created_at":1793760466971365145,"creation_channel":"mcp","deps":[{"link_uuid":"a993ab40-98ce-4da7-9ccb-631cdead131d","relation":"discovered_from","target_id":"e508-ce6c-2e52-4adc"},{"link_uuid":"65b0bcf2-3d28-43b7-ad86-16a2c906e468","relation":"relates_to","target_id":"4dfb-1cb3-229c-4742"},{"link_uuid":"4fc8cac7-d775-4d33-85a3-507343c1b3ad","relation":"relates_to","target_id":"8cf0-cb18-d8ff-44df"}],"description":"# Live prompt-eval CI job scores coverage 0.0 on every spec\n\n## Context / Problem\n\n`.github/workflows/prompt-eval.yml`'s `eval-live` job calls `ev.run_eval(pid, max_cases=cap)`\ndirectly (`.github/workflows/prompt-eval.yml:136`) with no gate session and no\n`REBAR_GATE_ALLOW_UNGATED`. Every agentic finder run therefore reaches\n`assert_gated` (`src/rebar/llm/runner.py:374` -> `src/rebar/llm/gate_context.py:137`) and raises\n\"agentic filesystem tools was attempted OUTSIDE the repo-snapshot gate process\". `run_eval`\nrecords a solver exception as an UNSCORED case (`src/rebar/llm/evals/eval.py:673`), so each spec\nreports `coverage = 0.0`, and the job (`continue-on-error: true`, `:95`) only emits an advisory\n`::warning::` (`:143`). A total scoring failure is indistinguishable from an ordinary regression.\n\nThe sibling entry point `calibrate_criterion` (`src/rebar/llm/evals/eval.py:384`, used by\n`rebar criteria eval`, which the same workflow runs at `prompt-eval.yml:72`) has the same defect:\nmeasured offline 2026-11-17 at origin/main 05c6414358f, a `solve` that calls `assert_gated`\nraises `RuntimeError` out of `calibrate_criterion(\"G7\", solve=...)`.\n\n## Reproduction (measured)\n\n- Full dataset, worktree at origin/main 0e7401446c58: `ev.run_eval('code-review-tests')` ->\n  `coverage=0.0 epoch_pass=[false,false,false]` in 40 s; all 117 case-runs carry the gate error.\n- Offline, origin/main 05c6414358f: `run_eval('plan-review-g7', solve=<solve calling\n  assert_gated>, max_cases=3)` -> `coverage 0.0`; the same call inside\n  `gate_source.gate_read_root(resolve_gate_handle(None, SOURCE_LOCAL, None, fetch=False))` ->\n  `coverage 1.0`.\n\n## Approach\n\nMake both eval entry points establish the gate session themselves, in-process, so every caller\n(the CI step, the CLI, a project on another CI provider or none) gets it. The eval deliberately\nevaluates the DIRTY working tree (`run_eval` docstring), so the explicit source mode is\n`SOURCE_LOCAL`, which is exactly what `gate_source.gate_read_root`\n(`src/rebar/llm/gate_source.py:189`) marks as a deliberate local gate session. This reuses the\nexisting gate seam already used by `fixture_mining/heal.py:435` and `provider_parity.py:355`.\n\n1. In `src/rebar/llm/evals/eval.py`, add one private context manager `_eval_gate_session(repo_root)`\n   that resolves `gate_source.resolve_gate_handle(None, gate_source.SOURCE_LOCAL, repo_root,\n   fetch=False)` and enters `gate_source.gate_read_root(handle)`.\n2. Wrap the case loop of `run_eval` and of `calibrate_criterion` (including default-solver\n   construction) in it.\n3. `run_eval` returns two new keys: `errored` (count of case-runs that raised) and\n   `run_failure` (True iff any epoch scored zero of its non-empty dataset).\n4. The `eval-live` step collects specs with `run_failure`, prints a `::error::` line naming them,\n   and exits non-zero after writing all JUnit files; ordinary regressions stay a `::warning::`.\n\nNo config key, env var or flag is added; `REBAR_GATE_ALLOW_UNGATED` is not used.\n\n## Scope\n\n- `src/rebar/llm/evals/eval.py` — gate-session helper, both entry points, `run_failure`/`errored`.\n- `.github/workflows/prompt-eval.yml` — report `run_failure` specs as an error.\n- `tests/unit/test_eval.py` — regression tests.\n- `docs/workflow-engine.md` — one sentence on the run-failure report in the live-eval paragraph\n  (`docs/workflow-engine.md:186`).\n\nPortability: the change uses a `contextvars` gate marker and the local-mode handle\n(`Path.resolve()` of the checkout); no subprocess, file descriptor, signal or POSIX path API.\n\n## Testing\n\nOffline, with an injected `solve` that calls `assert_gated` and `REBAR_GATE_ALLOW_UNGATED`\nremoved via `monkeypatch.delenv`:\n- happy path: `run_eval` returns `coverage > 0`, `run_failure False`, `errored 0`;\n  `calibrate_criterion` returns a report;\n- failure path: calling that `solve` directly outside the entry point raises `RuntimeError`, and\n  a `solve` that always raises gives `coverage 0.0`, `run_failure True`, `errored == epochs * cases`.\n\n## Acceptance Criteria\n\n- [x] The `eval-live` job's live step runs `run_eval` inside a gate session whose source mode is\n      chosen explicitly (`SOURCE_LOCAL` inside `run_eval`), not the configured default.\n      `REBAR_GATE_ALLOW_UNGATED` is NOT used. Checked by reading `eval.py` and `prompt-eval.yml`.\n- [x] A regression test in `tests/unit/test_eval.py` asserts that with the safeguard active and\n      no override set, `run_eval` completes with `coverage > 0` against an injected offline\n      `solve` that calls `assert_gated`, and that the same `solve` called outside raises. The test\n      fails against origin/main 05c6414358f (checked by running it there).\n- [x] `calibrate_criterion` runs its cases inside the same gate session; a regression test with\n      a gated `solve` returns a report instead of raising.\n- [x] `run_eval` distinguishes \"every case errored\" from \"cases scored and failed\": a 0.0-coverage\n      epoch sets `run_failure: True`, and the `eval-live` step reports it as `::error::` and\n      exits non-zero rather than as the advisory warning. Checked by a unit test and by reading\n      the workflow.\n- [x] The portability constraint holds: the gate-session requirement is enforced in-process (in\n      `eval.py`), not by a GitHub-Actions-only step.\n- [x] `make verify` exits 0.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/evals/eval.py","reason":"gate-session helper around run_eval and calibrate_criterion; run_failure/errored result keys"},{"path":".github/workflows/prompt-eval.yml","reason":"report run_failure specs as an error"},{"path":"tests/unit/test_eval.py","reason":"regression tests"},{"path":"docs/workflow-engine.md","reason":"document the run-failure report"},{"path":"src/rebar/llm/evals/eval_solver.py","reason":"shared landing commit 07f023db803 only: changed by sibling bug knightly-salty-orangutan, not by this ticket's work"},{"path":"src/rebar/llm/evals/eval_scorers.py","reason":"shared landing commit 07f023db803 only: changed by sibling bug newborn-advanced-hoopoe, not by this ticket's work"},{"path":"tests/unit/test_eval_solver.py","reason":"shared landing commit only: sibling bug knightly-salty-orangutan's tests"},{"path":"tests/unit/test_eval_scorers.py","reason":"shared landing commit only: sibling bug newborn-advanced-hoopoe's tests"},{"path":"tests/unit/test_provider_parity.py","reason":"shared landing commit only: sibling bug knightly-salty-orangutan's docstring correction"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","4dfb-1cb3-229c-4742"],["relates_to","8cf0-cb18-d8ff-44df"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"7eceac58-6885-4750-9d41-8678b452ef7e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":["evals","ci","complexity-reduction"],"ticket_id":"77b6-868f-f4bd-461f","ticket_type":"bug","title":"Live prompt-eval CI job scores coverage 0.0 on every spec — run_eval is called outside a gate session","verify_commands":[]},"source_event_uuids":["89244926-1b5e-457a-b0d8-9c1fd022613d","fd3ee49a-80dd-4c77-8608-4c97ff5b467e","a125d7e9-d368-417c-bcd5-bb0de2305c04","1fd95461-c37e-4ef3-b829-eaa6b600045f","945f9e04-2684-4e51-afd7-d23426842f33","e40744cb-ad6f-47d2-a3db-e906b89543f9","65b0bcf2-3d28-43b7-ad86-16a2c906e468","cf5a2f5b-ce6f-4f52-9d25-efff4f9b2c0f","4fc8cac7-d775-4d33-85a3-507343c1b3ad","94585f32-e9e0-4844-87aa-2ca8a6509579","93c6a86c-2fae-48b5-8f16-5eccecafc738","c245533e-0ed9-4f5e-b8c6-295928c440e2","9a935732-da92-441f-9004-015642df9a7f","d15b8053-ec95-4ba9-839b-f019ad960fdf","7eceac58-6885-4750-9d41-8678b452ef7e","2a148fca-63c9-4599-abe6-1484258adca8"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1794985298338831061,"uuid":"f36d64e0-e39a-4e98-810c-158e4ded4f66"}