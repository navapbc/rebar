{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terraform_grounding_receipt.schema.json",
  "title": "Terraform structural grounding receipt",
  "description": "The canonical, credential-redacting RECEIPT a Terraform structural grounding query emits alongside its three-valued grounding evidence (REB-640). It records provenance — normalized query, bounded snapshot + module content digests, backend identity, enforced limits, outcome, reasons, and a result digest — so a verifier can reproduce and check the answer WITHOUT re-parsing. It carries only safe classes, hashes, and repo-relative locations: NEVER credentials, attribute literal values, or `default` values. Closed (`additionalProperties: false`) at every level.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "A `sha256:`-prefixed lowercase-hex SHA-256 digest."
    },
    "operation": {
      "type": "string",
      "enum": ["lookup_declaration", "resolve_reference", "probe_source", "corroborate_diagnostic"],
      "description": "Which per-call session operation produced this receipt."
    },
    "reason_detail": {
      "type": ["string", "null"],
      "description": "The CLOSED, sub-reason detail for an abstention (null for a refuted outcome). Paired one-to-one with the generic evidence `reason` via the slice's abstention-translation table.",
      "enum": [
        "missing_extra",
        "parser_version",
        "not_terraform",
        "invalid_input",
        "unreadable_file",
        "worker_timeout",
        "worker_failure",
        "duplicate_address",
        "no_unique_address",
        "dynamic_source",
        "dynamic_expression",
        "computed_value",
        "provider_attribute",
        "splat_index",
        "unknown_tfvars",
        "path_outside_snapshot",
        "module_limit",
        "file_limit",
        "byte_limit",
        "registry_not_found",
        "registry_unauthorized",
        "registry_rate_limited",
        "dns_error",
        "tls_error",
        "proxy_error",
        "registry_server_error",
        "rejected_redirect",
        "probe_timeout",
        "malformed_metadata",
        "oversized_metadata",
        "rejected_target",
        "non_registry_remote",
        "invalid_detector",
        "executable_not_resolvable",
        "rejected_executable",
        "binary_replaced",
        "nonzero_exit",
        "upstream_diagnostics",
        "config_inspect_schema_skew",
        null
      ]
    },
    "backend": {
      "type": "object",
      "description": "The parser/analyzer backend that produced this receipt and its configuration digest.",
      "additionalProperties": false,
      "required": ["parser", "parser_version", "analyzer", "analyzer_version", "config_digest"],
      "properties": {
        "parser": { "type": "string", "description": "The parser/tool identity (`python-hcl2` or `terraform-config-inspect`)." },
        "parser_version": { "type": "string", "description": "The parser/tool version when discoverable, otherwise `unknown`." },
        "analyzer": { "type": "string", "description": "The structural analyzer identity." },
        "analyzer_version": { "type": "integer", "description": "The structural analyzer version." },
        "config_digest": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" }
      }
    },
    "limits": {
      "type": "object",
      "description": "The bounds enforced before any fact was returned (module / file / byte / timeout).",
      "additionalProperties": false,
      "required": ["modules", "files", "bytes", "timeout_ms"],
      "properties": {
        "modules": { "type": "integer" },
        "files": { "type": "integer" },
        "bytes": { "type": "integer" },
        "timeout_ms": { "type": "integer" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "query",
    "snapshot_digest",
    "module_digest",
    "backend",
    "limits",
    "outcome",
    "reason",
    "reason_detail",
    "result_digest"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "operation": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/operation" },
    "query": {
      "type": "object",
      "description": "The NORMALIZED query (repo-relative POSIX paths, trimmed/canonical address or reference). Structural keys only — never literal attribute values.",
      "additionalProperties": true
    },
    "snapshot_digest": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" },
    "module_digest": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" },
    "backend": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/backend" },
    "limits": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/limits" },
    "outcome": {
      "type": "string",
      "enum": ["refuted", "match", "abstain"],
      "description": "The three-valued grounding outcome: `refuted` for refutation-only tools, `match` for positive config-inspect corroboration, or `abstain`."
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "unsupported_lang",
            "no_tool",
            "parse_error",
            "timeout",
            "ambiguous",
            "private_or_internal_suspected",
            "network_error",
            "rate_limited",
            "version_skew",
            "invalid_detector",
            "other"
          ]
        },
        { "type": "null" }
      ],
      "description": "The GENERIC grounding abstention reason (mirrors grounding.schema.json's closed enum); null for a refuted outcome."
    },
    "reason_detail": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/reason_detail" },
    "source_kind": {
      "type": "string",
      "enum": ["local_module", "registry_provider", "registry_module"],
      "description": "Optional Terraform source category for positive source probes."
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" },
        "version": { "type": "string" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "shell",
        "stdin",
        "start_new_session",
        "deadline_seconds",
        "stdout_limit",
        "stderr_limit",
        "snapshot_path_digest"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shell": { "type": "boolean" },
        "stdin": { "type": "string", "enum": ["closed"] },
        "start_new_session": { "type": "boolean" },
        "deadline_seconds": { "type": "integer" },
        "stdout_limit": { "type": "integer" },
        "stderr_limit": { "type": "integer" },
        "snapshot_path_digest": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" }
      }
    },
    "result_digest": { "$ref": "terraform_grounding_receipt.schema.json#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "abstain" } } },
      "then": {
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": ["reason"]
      },
      "else": {
        "properties": {
          "reason": { "type": "null" },
          "reason_detail": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "match" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["executable", "invocation"],
        "description": "A positive `match` receipt MUST carry the audited-executable identity and the exact subprocess invocation, so the corroboration is reproducible and attributable."
      }
    }
  ]
}
