5519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9d29b435121c66037c57afa56b3e51e584505cf80a3708609fc160e47335d669","event_uuid":"5b9b77c8-46c5-43cd-820f-648f77de3418","position":{"commit_sha":"de438f2fc05c382d8948e32034babf8f00d2b86d","position":"1788641828317262001-5b9b77c8-46c5-43cd-820f-648f77de3418"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d2fc17a1075e27949533cb48d756c4f32aba4edb24b398853bf8184d27f3eaab","event_uuid":"5bfa9a4f-eb3f-4a6a-ab02-e06b3ae874f7","position":{"commit_sha":"7060f792b9130af28bd6b267b973c7b23cb5ceb8","position":"1788642534273059001-5bfa9a4f-eb3f-4a6a-ab02-e06b3ae874f7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fa3b1be955bc9a8d42a263c2a332b0688afbce570cdb4f63e6bc80dea03370b9","event_uuid":"af8c87e2-29aa-4fe2-b660-97504fe3231b","position":{"commit_sha":"50146b1f0950ac64ee8f7f88f1304fb24d0316fd","position":"1788643124332516001-af8c87e2-29aa-4fe2-b660-97504fe3231b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788641323302053001,"creation_channel":"cli","deps":[{"link_uuid":"c943b10d-f09f-4d83-9ce9-92518158fa98","relation":"discovered_from","target_id":"d645-8f51-0ff9-4070"}],"description":"## Context\n- This prerequisite story enables the two-stage safe promotion for epic 78f2-b104-e3c9-4b86 and voting story d645-8f51-0ff9-4070.\n- `gerrit-verify.yaml` is dispatched from `main`, so DAG-level changes in a patchset do not run on their own introducing change. Enforcing scanner-integration in the same change that adds its job would recreate the incident-90c7 vacuous-vote class.\n- Stage A therefore lands only an auto-running advisory scanner job. Once this invoker is on `main`, Stage B can observe the scanner job executing on Stage B's own patchset before flipping it into the voting aggregate.\n\n## Scope\n- Add a concrete `scanner-integration` job inside `.github/workflows/gerrit-verify.yaml`, gated to the full route like build-and-test/optionality, calling `./.github/workflows/_scanner-integration.yml` with Gerrit refspec/project/url and `advisory-mode: true` so it scans the exact patchset automatically without affecting Verified during Stage A. Invert the existing tests that currently assert the job is absent from `gerrit-verify.yaml`: they must now assert the job exists and carries the full-route `if:` plus Gerrit patchset inputs.\n- Keep the job advisory in Stage A: do not add it to `vote.needs`, do not reference it in vote normalization, and do not remove the `scripts/check_verify_gate_parity.py` ADR-0114 advisory exception yet. Because `im-open/workflow-conclusion` observes all jobs in the run, Stage A must not put `continue-on-error` on the reusable-workflow caller. Instead, add an explicit `advisory-mode` input to `_scanner-integration.yml` and apply `continue-on-error: ${{ inputs.advisory-mode }}` to every step whose failure could make the reusable scanner job conclude failure: both checkout alternatives, setup-python, setup-uv, the lock/install step, and the scanner contract step. The Gerrit Stage-A caller passes `advisory-mode: true`, so any scanner/setup failure remains visible in logs but the job conclusion stays success while advisory; branch/mirror and Stage-B voting callers use the default `false` fail-closed behavior. Add a structural test that every scanner reusable step with `uses:` or `run:` carries this advisory-mode continue-on-error expression, preventing a hidden setup failure from reddening `WORKFLOW_CONCLUSION`.\n- Keep the existing manual `gerrit-scanner-verify.yml` workflow as an on-demand operator probe; the new required evidence for Stage A is that a subsequent real patchset run shows the Gerrit Verified workflow contains a `scanner-integration` job that executes and passes.\n- Update only Stage-A tests and docs needed to distinguish advisory auto-run from voting enforcement. Stage B remains responsible for parity-exception reversal, vote aggregation, and ADR-0114 supersession.\n\n## Anti-90c7 safety design\n- No enforcement changes land in Stage A, so a scanner failure cannot block all merges while the auto-run invoker is being introduced.\n- Empirical GHA proof is required after Stage A lands: observe a real Gerrit patchset Verified run from `main` with `scanner-integration` present, executed, and passing. Record the run URL/job id on this ticket and on d645 before starting Stage B submit decisions.\n- Portability remains through the existing portable `make scanner-integration` target and `_scanner-integration.yml` wrapper; Stage A introduces only an Actions wrapper input around that same command, no bash-only Make recipe and no GitHub-only scanner implementation.\n\n## Testing\n- `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/unit/test_gerrit_verify_triage_comment.py tests/unit/test_ci_workflow_parity.py tests/unit/test_predates_gate_guard_parity.py tests/unit/test_code_review_ws5.py::test_scanner_workflow_is_shared_by_mirror_and_gerrit_advisory -q` proves the scanner job is auto-run from `gerrit-verify.yaml`, remains out of `vote.needs` and vote normalization, passes `advisory-mode: true`, the reusable applies step-level `continue-on-error` from that input to every executable scanner job step, and the scanner reusable is present in the predates local-uses closure.\n- `env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_verify_gate_parity.py` must still pass with `scanner-integration` excluded as advisory.\n- `env PATH=\"$PWD/.venv/bin:$PATH\" make lint && env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck` proves repo gates remain green.\n- Sandboxed mutation removes the advisory scanner job from `gerrit-verify.yaml` and confirms the held-out tests fail, then restores.\n\n## Acceptance Criteria\n- [ ] Newly-added assertions in `pytest tests/unit/test_ci_workflow_parity.py`, plus inverted assertions in `tests/unit/test_gerrit_verify_triage_comment.py` and `tests/unit/test_code_review_ws5.py::test_scanner_workflow_is_shared_by_mirror_and_gerrit_advisory`, prove `gerrit-verify.yaml` contains a full-route advisory `scanner-integration` job using `_scanner-integration.yml` with Gerrit patchset inputs; these are Stage-A coverage updates.\n- [ ] `pytest tests/unit/test_gerrit_verify_triage_comment.py` proves Stage A keeps `scanner-integration` out of `vote.needs` and out of vote normalization, passes `advisory-mode: true` to the reusable, and proves `_scanner-integration.yml` contains step-level `continue-on-error: ${{ inputs.advisory-mode }}` on every executable scanner job step so the advisory caller cannot cast Verified -1 through `WORKFLOW_CONCLUSION` even on checkout/setup/install failures.\n- [ ] `python scripts/check_verify_gate_parity.py` still passes with `scanner-integration` documented in `EXCLUDED_JOBS` as the temporary Stage-A advisory exception.\n- [ ] `pytest tests/unit/test_predates_gate_guard_parity.py` proves the auto-running scanner reusable is reachable from the Gerrit Verified workflow closure, so future patchsets exercise it from `main`.\n- [ ] `make lint && make typecheck` pass locally with `.venv/bin` first on PATH.\n- [ ] [non-codebase] After Stage A lands, a ticket comment records the real GHA run URL/job id showing `scanner-integration` executed and passed on a Gerrit patchset before Stage B enforcement is submitted.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/gerrit-verify.yaml","reason":"Add full-route advisory scanner-integration job on Gerrit patchsets without voting aggregation."},{"path":"tests/unit/test_gerrit_verify_triage_comment.py","reason":"Assert Stage-A scanner job remains advisory and outside vote normalization."},{"path":"tests/unit/test_ci_workflow_parity.py","reason":"Assert Gerrit Verified auto-runs scanner reusable with patchset inputs."},{"path":"tests/unit/test_predates_gate_guard_parity.py","reason":"Assert scanner reusable is reachable from Gerrit Verified closure for future patchsets."},{"path":"tests/unit/test_code_review_ws5.py","reason":"Update scanner workflow sharing test for auto-run advisory shape."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","78f2-b104-e3c9-4b86"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"283b-7104-87c1-4015","ticket_type":"story","title":"Auto-run scanner-integration on Gerrit patchsets as advisory evidence","verify_commands":[]},"source_event_uuids":["9a98ecfa-d436-483a-a82f-18091c3f6ada","37de8560-63aa-414a-b05c-dada103a080d","c943b10d-f09f-4d83-9ce9-92518158fa98","5b9b77c8-46c5-43cd-820f-648f77de3418","5bfa9a4f-eb3f-4a6a-ab02-e06b3ae874f7","af8c87e2-29aa-4fe2-b660-97504fe3231b"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788643124332516002,"uuid":"151880b7-7411-4472-9b27-fe96cb8c7f89"}