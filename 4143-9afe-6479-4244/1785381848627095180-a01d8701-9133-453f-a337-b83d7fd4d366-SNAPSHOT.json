+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5e8535770c933bc3514e70c3f753a6cde19466b39166e424e1d531119064a219","event_uuid":"42d358df-3bf8-4ed4-92c2-a45b7cdfcd14","position":{"commit_sha":"bdbcc81e3b4fbcbdfae95a80684186e89fb68d6b","position":"1785379288633398001-42d358df-3bf8-4ed4-92c2-a45b7cdfcd14"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"751df13452759441e7f995a1fd9dcdb05f00bd7bd82509d91832191df165e979","event_uuid":"4417f51c-6991-4b50-be0b-740bfff2c3c8","position":{"commit_sha":"c3de5baa8900e295f06cc68bff0f6fd7e1684e61","position":"1785381166569769001-4417f51c-6991-4b50-be0b-740bfff2c3c8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2c5160ab71f7eb17a930f4f4039fe34b2d649f31a261b2b6b4ecea27d79eddd5","event_uuid":"df910244-c7c4-471b-8aeb-5008e881f289","position":{"commit_sha":"c3de5baa8900e295f06cc68bff0f6fd7e1684e61","position":"1785381167004033001-df910244-c7c4-471b-8aeb-5008e881f289"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"332205c56d0336abd830b09737973577ba80dcc13d639828d2fa435e6263f010","event_uuid":"38a947ed-b149-4a9b-bc56-5bdbddd6ff78","position":{"commit_sha":"faa38faa6c7422541bd24014b0893d459fd7694c","position":"1785381848627095179-38a947ed-b149-4a9b-bc56-5bdbddd6ff78"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"04f7d44a-42fa-4c45-a2bb-b8c054a9be6f","comments":[],"created_at":1785368698660420001,"creation_channel":"cli","deps":[],"description":"# A — PreToolUse hook: re-surface Serena on every grep\n\n## Context / Problem\n\n`AGENTS.md` already says to prefer Serena's symbol tools over `grep`, and an agent with Serena configured still\nenumerated call sites by hand with `grep` for many turns (epic `061c` story S2). Launch-time guidance decays: by\nmid-task, one line of a long document has no salience. The fix is a reminder delivered **at the moment of the\naction**, executed by the harness rather than remembered by the agent.\n\n## Approach\n\nA `PreToolUse` hook on the `Bash` tool that emits a short reminder when the command invokes the grep family.\n\n**The trigger must be as dumb as possible.** Match a grep-family invocation (`grep`, `rg`, `egrep`, `fgrep`) in\nthe command string — nothing more. Deliberately do NOT try to classify whether the pattern \"looks like a\nsymbol\", whether the target is under `src/`, or parse the command: a clever predicate is fragile, mis-fires, and\na hook that mis-fires gets disabled, which is worse than a hook that occasionally reminds you of something you\nalready knew. Accepting false positives is the design, because the cost of a false positive is three lines of\ntext and the cost of a false negative is the behaviour this epic exists to fix.\n\n**The message must be small and must not be wrong.** Two to three lines. It names the preferred path AND the one\ncase where `grep` is genuinely correct, so an agent that reads it and continues with `grep` for a string-literal\nsearch has been *helped*, not overridden. Something of the shape:\n\n```\nSerena (LSP) is available: find_referencing_symbols / find_symbol resolve real references — prefer it for\n\"who calls/imports X\". grep is still right for symbols named as STRINGS (monkeypatch.setattr, getattr) and\nfor current line numbers, which the LSP index can lag.\n```\n\n**Non-blocking, always.** The hook informs; it never denies the call.\n\n## Scope\n\n- `.claude/settings.json` — ADD a `hooks.PreToolUse` entry matching `Bash`. This file is **created and made\n  trackable by story C** (`06ae-0d45-aff1-46f2`), which also adds the `.gitignore` negation without which\n  nothing under `.claude/` can be committed at all (`.gitignore:38` ignores `.claude/`). This story therefore\n  **depends on C** (`blocks` edge recorded) and must MERGE its `hooks` block into the existing tracked file\n  rather than overwrite it — C's `env.ENABLE_TOOL_SEARCH` must survive.\n- `scripts/hooks/serena_grep_reminder.py` — the hook body as a tracked, testable script rather than an inline\n  shell one-liner buried in JSON, so the trigger and the message can be pinned by an automated test.\n- `docs/` — one line pointing at the hook from the same doc home story C uses.\n\n## Verified ground truth (probed 2026-07-29)\n\n- `PreToolUse` surfaces text to the model via `hookSpecificOutput.additionalContext`. **Plain non-JSON stdout is\n  NOT shown to the model** (debug log only), so the hook must emit JSON — a bare `echo` reminder would be\n  invisible and the story would silently under-deliver.\n- The hook stays non-blocking by **omitting `permissionDecision` entirely** (normal permission flow applies).\n  Emitting `\"allow\"` would also be non-blocking but would additionally SUPPRESS the permission prompt, changing\n  this repo'''s security posture — out of scope, so do not do it. Exit code 2 blocks the call; the hook must never\n  exit 2.\n- Project settings resolve to the operator'''s MAIN checkout, shared across worktrees — so the hook cannot be\n  observed firing from the authoring worktree session. Verification is by EXECUTING the hook script directly\n  against the documented stdin envelope (which is exactly what CI can re-check), plus a post-land transcript.\n\n## Testing\n\n- The hook fires on a plain `grep -rn foo src/` and on `rg foo`.\n- It does NOT block: the grep still runs and its output is unchanged.\n- A command with no grep produces no reminder.\n\n## Acceptance Criteria\n\n- [ ] a `PreToolUse` hook on `Bash` emits the reminder for `grep`, `rg`, `egrep`, `fgrep`\n- [ ] the trigger is a plain grep-family string match — no pattern classification, no path heuristics — and the\n      hook config is small enough to read at a glance\n- [ ] the message is <= 3 lines and names both `find_referencing_symbols` AND the string-literal/line-number\n      grep exceptions, so it is never misleading\n- [ ] the hook is non-blocking: a transcript shows the grep executing normally after the reminder\n- [ ] an AUTOMATED TEST shows it firing on `grep -rn foo src/` and `rg foo`, and NOT firing on a non-grep\n      command; the test executes the hook against the documented `PreToolUse` stdin envelope and asserts the\n      emitted JSON carries `additionalContext` and NO `permissionDecision` (proving informative + non-blocking)\n- [ ] the hook never exits non-zero and never emits `permissionDecision`, so it cannot deny a call or suppress a\n      permission prompt even on malformed input (asserted for empty stdin / absent command / non-JSON stdin)\n- [ ] C'''s `env.ENABLE_TOOL_SEARCH` setting is still present in `.claude/settings.json` after this change","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":".claude/settings.json","reason":"add hooks.PreToolUse Bash entry (merge into the tracked file story C creates)"},{"path":"scripts/hooks/serena_grep_reminder.py","reason":"the hook body as a tracked, testable script"},{"path":"tests/unit/test_serena_grep_reminder_hook.py","reason":"pin the grep-family trigger, the message contract, and non-blocking behaviour"},{"path":"docs/local-dev-env.md","reason":"one-line pointer to the hook"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","9109-2ad9-2477-4cf6"]],"no_file_impact_reason":"","parent_id":"9109-2ad9-2477-4cf6","parent_status_uuid":"4417f51c-6991-4b50-be0b-740bfff2c3c8","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"4143-9afe-6479-4244","ticket_type":"story","title":"A — PreToolUse hook: re-surface Serena on every grep call","verify_commands":[]},"source_event_uuids":["ef6ec7c4-eacf-46b8-9873-0ee550e48b71","f27e013f-2c6f-4a66-beba-1a0da184cd1c","fe7197b2-a851-448d-9437-1792cddd5483","a23a7ed8-285d-4609-b29e-a24ec092e0ef","42d358df-3bf8-4ed4-92c2-a45b7cdfcd14","4417f51c-6991-4b50-be0b-740bfff2c3c8","df910244-c7c4-471b-8aeb-5008e881f289","38a947ed-b149-4a9b-bc56-5bdbddd6ff78"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785381848627095180,"uuid":"a01d8701-9133-453f-a337-b83d7fd4d366"}