0966b53e608eb811e964f27d3dec5","position":"1785222204085383001-3d7af05d-4ac4-49d9-bed4-78d11d90083c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6da8ae4af9094dfa085d68fd784e6c8e98cb457f18e3958581b95e056f7f0631","event_uuid":"eb82c7f5-c2e1-45cb-8389-57f841e15b5c","position":{"commit_sha":"6072057cd0b282be94f339363f44cc39bb199658","position":"1785222782430162342-eb82c7f5-c2e1-45cb-8389-57f841e15b5c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"372fd08f02ee8ddb93c6282ff5ce07f9aafd8a5971fc4012d500994f2348e158","event_uuid":"cc99b246-9d46-40d7-9a96-30b8253b8c27","position":{"commit_sha":"740265fc8c3f2685891e15949019c1d12d02ae53","position":"1785225911958256001-cc99b246-9d46-40d7-9a96-30b8253b8c27"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation complete under held-out TDD. RED: 11 new behavior-contract failures with 127 neighboring passes. Separate standard-tier implementer saw only manifest/fingerprint happy paths; restored signed-record, tamper, malformed-token, material-transition, and recovery tests all passed (138/138) on first held-out run. Whole-HEAD fallback mutation made the none-scope signed-record test fail, then exact restoration passed. Fresh-context five-axis review approved with no findings. Exact gates: make lint PASS; make typecheck PASS (381 files); make test PASS (7339 passed, 29 skipped, 114 deselected).","timestamp":1785225911958256001}],"created_at":1785196785761652001,"creation_channel":"cli","deps":[{"link_uuid":"cce6f73c-8708-4e71-bae3-af7b43401db9","relation":"depends_on","target_id":"1934-63dd-4be9-4c48"},{"link_uuid":"09ce2de3-d118-45fb-b2a4-7c3758929d6a","relation":"relates_to","target_id":"7d7e-801b-54ad-4d8b"}],"description":"## Context / Problem\n\nPlan-review attestations currently have two effective code-freshness modes: a non-empty signed dependency map is re-hashed path by path, while an empty map falls back to whole-HEAD freshness. Story 1934-63dd-4be9-4c48 added an explicit `file_impact_scope: none` state. A ticket that truthfully declares no repository edits should keep its certified plan after an unrelated commit, without weakening the conservative behavior of legacy or undeclared empty-impact tickets.\n\n## Approach\n\nAdd a signed manifest scope contract with three classifier results:\n\n- non-empty dependency paths always classify as `paths`;\n- empty dependency paths plus effective own scope `none` classify as `none`;\n- every other empty dependency set classifies as `unscoped`.\n\nThe pure helper contract is `classify_file_scope(dependency_paths, own_scope, *, container_all_none=False)`. This story exercises the leaf path. The keyword is an intentional pre-seam for story 0b14-5c30-fe45-4fdf, which alone will pass `container_all_none=True` when every live child explicitly declares none.\n\nThe signing data flow is explicit. `sign_plan_review` keeps `dependency_hashes` focused on path hashing, reads the effective own scope with the existing public `rebar.get_file_impact_scope(verdict[\"ticket_id\"], repo_root=...)`, calls `classify_file_scope(deps.keys(), own_scope)`, and passes the result through a new backward-compatible `file_scope=\"unscoped\"` keyword on `build_manifest`. `manifest.py` remains dependency-light and performs no ticket-store read. `build_manifest` emits the additive exact line `file-scope: none` only when the classified result is `none`; `paths` and `unscoped` keep the previous serialized output byte-for-byte. `manifest_file_scope` reads only the authenticated manifest and returns `none` only for that exact signed declaration; an absent, unknown, or malformed declaration is treated as `unscoped`, preserving fail-closed whole-HEAD behavior.\n\n`resign_plan_review` already calls `sign_plan_review`, so its recovery path obtains the current effective scope through the same signing boundary without a new branch or a change to `resign.py`. A public integration test will create a none-scoped ticket, recover its PASS through `rebar.llm.resign_plan_review`, verify the authenticated signature, and observe that the recovered manifest retains the none scope. The separate dependency drift-refresh path cannot receive a none-scoped record because it requires a non-empty dependency map; no new refresh branch is added.\n\nIn `compute_validity` under the DEFAULT profile, non-empty deps continue to re-hash as today. When deps are empty and `manifest_file_scope(auth_manifest) == \"none\"`, code freshness is not applicable and evaluation continues through material, phase, and relationship-pin checks. Empty deps with any other scope retain the existing whole-HEAD `stale-head` verdict. CLOSE and DRIFT_REFRESH profiles are unchanged. The ordinary review path also remains coherent with drift-floor logic: `_idempotent_reuse` consumes this same validity result before drift-floor selection, so a still-certified none-scoped attestation is reused and never enters the unscoped re-review floor. Explicit forced reviews remain outside this freshness optimization.\n\nThe material fingerprint preserves the exact legacy basis for `paths` and `unscoped`. Only `none` adds a canonical JSON basis member `\"file_impact_scope\": {\"kind\": \"none\", \"reason\": <no_file_impact_reason>}` before the existing sorted-key serialization. This makes none distinct from an undeclared empty impact and makes a reason-only edit stale, while leaving every existing fingerprint byte-compatible. A scope flip or reason change after signing therefore yields `stale-material`.\n\nAll new manifest helpers are re-exported from `attest`, matching the existing one-way `attest -> manifest` compatibility surface. The operational package `plan_review.__init__` does not re-export low-level manifest readers and is not changed. Because `attest.py` is already at the 800-line hard cap, the implementation must keep it at or below the cap by tightening adjacent comments or equivalent local simplification; it must not raise the limit or create a sub-100-line fragment.\n\nRollback is conservative. Old readers ignore the additive `file-scope: none` line and apply whole-HEAD freshness. A none-scoped attestation signed by new code also recomputes as `stale-material` after rollback because the old fingerprint omits the new declaration marker; forced re-review is expected, with no data loss or false certification. New readers treat an older manifest with no file-scope line as unscoped.\n\n## Scope\n\n- `src/rebar/llm/plan_review/manifest.py` — scope classifier, backward-compatible `build_manifest` keyword, exact none declaration, and authenticated-manifest reader.\n- `src/rebar/llm/plan_review/attest.py` — signing-boundary scope lookup/classification, helper re-exports, and DEFAULT validity branch while preserving the 800-line cap.\n- `src/rebar/llm/plan_review/pass1.py` — canonical none-only material-fingerprint basis member.\n- `tests/unit/test_plan_review.py` — public manifest serialization/classification and fingerprint contract coverage.\n- `tests/unit/test_attestation_invalidation.py` — signed validity, legacy, moved-HEAD, tamper, and material-staleness behavior.\n- `tests/unit/test_plan_review_resign.py` — public recovery re-sign behavior for a none-scoped ticket.\n\nOut of scope: container inheritance and P9 lint (story 0b14-5c30-fe45-4fdf), the `no-file-impact` review criterion (story 1fd4-cebe-87e9-4937), package-level operational exports, and changes to drift-floor policy.\n\n## Testing\n\nTests assert public behavior and serialized contracts only; they do not grep source text, inspect private registries, or pin internal call structure.\n\n- A table drives `build_manifest` and its public reader across `paths`, `none`, and `unscoped`. The none result contains exactly one authenticated declaration, while the other two outputs equal their pre-feature expected manifests byte-for-byte.\n- A signed-attestation table moves HEAD and observes `compute_validity`: path-scoped records re-hash dependencies, none-scoped records remain `valid` with verdict `certified`, and unscoped or legacy records return `stale-head`.\n- A tamper scenario adds a none declaration only to an unauthenticated plaintext mirror while the signed manifest lacks it; validity remains `stale-head`.\n- Stateful ticket tests compare `current_material_fingerprint` for otherwise identical undeclared, none, and paths tickets. Changing only `no_file_impact_reason` changes the none fingerprint, while legacy paths/undeclared expected fingerprints remain unchanged.\n- A public `resign_plan_review` recovery scenario verifies the resulting signature and observes none scope through the authenticated manifest reader.\n- The full suite plus lint and typecheck prove compatibility, including the module-size gate.\n\n## Acceptance Criteria\n\n- [ ] After an unrelated commit moves HEAD, a signed none-scoped plan remains `valid` with verdict `certified`, while all non-code freshness dimensions still run (checked through the public `compute_validity` result).\n- [ ] An unscoped or pre-feature empty-impact attestation still returns `stale-head` after HEAD moves (checked in the same signed-attestation behavior table).\n- [ ] The authenticated manifest contract emits exactly one `file-scope: none` declaration only for a none scope; paths and unscoped manifest output is byte-identical to the pre-feature contract (checked through `build_manifest` return values, not source inspection).\n- [ ] A none declaration present only in unauthenticated plaintext cannot suppress `stale-head` (checked by a signed-manifest tamper scenario).\n- [ ] Flipping scope between none and paths, or changing only `no_file_impact_reason`, makes the signed record return `stale-material` (checked against stateful ticket material through public validity/fingerprint behavior).\n- [ ] The public recovery re-sign operation preserves none scope in its authenticated manifest, and a legacy manifest with no file-scope declaration retains unscoped validity semantics (checked through `resign_plan_review`, signature verification, and the manifest reader).\n- [ ] `make lint`, `make typecheck`, and the full test suite pass; every edited `src/rebar` module remains at or below the locked 800-line cap.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/plan_review/manifest.py","reason":"scope classifier, manifest scope contract, and authenticated reader"},{"path":"src/rebar/llm/plan_review/attest.py","reason":"signing-boundary scope data flow, helper re-exports, and DEFAULT validity semantics"},{"path":"src/rebar/llm/plan_review/pass1.py","reason":"none-only canonical material-fingerprint basis"},{"path":"tests/unit/test_plan_review.py","reason":"public manifest serialization, classifier, and fingerprint contracts"},{"path":"tests/unit/test_attestation_invalidation.py","reason":"signed validity, moved-HEAD, legacy, tamper, and stale-material behavior"},{"path":"tests/unit/test_plan_review_resign.py","reason":"public recovery re-sign preserves authenticated none scope"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","1934-63dd-4be9-4c48"],["parent","94d9-f225-844c-43e5"],["relates_to","7d7e-801b-54ad-4d8b"]],"no_file_impact_reason":"","parent_id":"94d9-f225-844c-43e5","parent_status_uuid":"8188deb1-065a-4e7e-9761-bbb29a91925e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"749c-7546-6fe3-4d27","ticket_type":"story","title":"Attestation scoping: a declared-none file impact signs 'file-scope: none' and skips whole-HEAD drift","verify_commands":[]},"source_event_uuids":["e4405337-1034-4b40-bb57-90f6a4adf308","cce6f73c-8708-4e71-bae3-af7b43401db9","860abf06-6693-4dd4-935f-ad38c7f8e19e","f163e273-d779-43ad-81a6-65e5500b5f39","f70d2fad-0dc1-48c6-99c8-ed0887da141d","570826f1-9af1-45a7-abe8-871e4701c1c3","8bf5e6b9-16f3-448d-aeb7-10cfff2e3ed8","068bf81c-bc7c-49d2-81d9-84350281bf27","e39bd284-f50b-44d2-8940-32ada569ff5b","8188deb1-065a-4e7e-9761-bbb29a91925e","3d7af05d-4ac4-49d9-bed4-78d11d90083c","eb82c7f5-c2e1-45cb-8389-57f841e15b5c","cc99b246-9d46-40d7-9a96-30b8253b8c27","09ce2de3-d118-45fb-b2a4-7c3758929d6a"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785226538054762994,"uuid":"8ba8cb72-783d-49e9-b594-19e63bcf2285"}