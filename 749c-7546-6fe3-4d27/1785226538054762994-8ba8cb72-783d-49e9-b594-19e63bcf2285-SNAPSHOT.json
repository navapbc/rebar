{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785226538054762994,"compiled_state":{"alias":"cephalic-close-curlew","assignee":"","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"975828ccb0630aebf3d045ce75f607bec14a8d0b","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 749c-7546-6fe3-4d27","material: fd4af9c45ac5ff6f","model: claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.10.1 (975828ccb)","regver: b058e30f0de6a907","verified-at-sha:68bbbc9a1a22199f83491d269ba570b25cfadf99","plan-material-pin: prerequisite 1934-63dd-4be9-4c48 0706998811a99af4","dep 34f237cfc991c0dba7a305d0e383e79130ddbccddef92f3f2dc2521751c66715 src/rebar/llm/plan_review/attest.py","dep 21692a23830a26dc72c31fd657370b0762757882de1624994c1a6f1206986287 src/rebar/llm/plan_review/manifest.py","dep 964f9cba20dfa7dfa3c680adfe18f54d465418e6d5324eda02136a60d94f0bfa src/rebar/llm/plan_review/pass1.py","dep 1c682154791a2226cec6bcac11962fb7cb6344342e68e3089da6131312364298 tests/unit/test_attestation_invalidation.py","dep 4e16234503dc5c39a924dc53f0f807ac29620c6c7fdc52df87c4706359e84420 tests/unit/test_plan_review.py","dep 0cce6675489f0abd1d14122204993fed5888bef226c31fab0a4dd69e5ce5002b tests/unit/test_plan_review_resign.py"],"material_fingerprint":"fd4af9c45ac5ff6f","merged_log_commit":"68bbbc9a1a22199f83491d269ba570b25cfadf99","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1785222015106072000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":