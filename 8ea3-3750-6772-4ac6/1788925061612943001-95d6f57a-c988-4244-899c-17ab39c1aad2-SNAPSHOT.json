{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788925061612943001,"compiled_state":{"alias":"dour-gummy-hapuku","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"be40fd250fdd71319dbb2712601d0e89d6fa5c16","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 8ea3-3750-6772-4ac6","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.13.1 (be40fd250fdd7)","material: 8e999ac1bc2da9e1","verified-at-sha:be40fd250fdd71319dbb2712601d0e89d6fa5c16"],"material_fingerprint":"8e999ac1bc2da9e1","merged_log_commit":"be40fd250fdd71319dbb2712601d0e89d6fa5c16","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788912736461010000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"b9ee71c45c3200d8af99a25077e0fc46c45f4496","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 8ea3-3750-6772-4ac6","material: 2cf472a1505e8c85","material-part: children 647ea2107ca5072f 0","material-part: description 11107cfe6a57b945 5315","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: ticket_id c005058e990b59a2 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: pl