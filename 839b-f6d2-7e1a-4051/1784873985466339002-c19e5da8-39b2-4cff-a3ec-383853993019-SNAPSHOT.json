784853066765837001-fe230e2f-9150-4a87-baa4-96d570aa1b21"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b437b71419db03853428ca3e3b18f2a36f38da6d22875711e8c368d96df6e752","event_uuid":"e72bb81d-b20a-497b-8cb7-5bc4bf0a76d4","position":{"commit_sha":"7414f3cd5e453ff642bf99c04528434afcaa1ae6","position":"1784857030248959001-e72bb81d-b20a-497b-8cb7-5bc4bf0a76d4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"151a2bcf4b4539a13d76d8a9f5d98e555841ada22c69c1aab3ad54e1bad0b94f","event_uuid":"f7b11cbb-7453-479a-bfe0-71a0c5bddb6a","position":{"commit_sha":"fb0f82dd105e5d98bddc7053fd90c57179f9aa02","position":"1784873985466339001-f7b11cbb-7453-479a-bfe0-71a0c5bddb6a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1784517052523817001,"creation_channel":"cli","deps":[{"link_uuid":"da037c0c-53cd-4f7a-851c-4703c604b8fd","relation":"relates_to","target_id":"7e17-d75e-dfa2-4055"},{"link_uuid":"419f3fed-b269-4d56-b75f-171c004e3a9e","relation":"depends_on","target_id":"9597-1b85-d2ab-4eed"},{"link_uuid":"71e303cc-5573-438b-a981-94950214c391","relation":"depends_on","target_id":"e7a0-acef-ec67-42bb"},{"link_uuid":"38b415a0-7323-4c10-8e21-095ca954830d","relation":"relates_to","target_id":"5d28-cd94-ec65-4999"},{"link_uuid":"6dc02cee-cd40-46ff-96c1-77be96eee6c6","relation":"relates_to","target_id":"a120-3023-1d1f-4f16"},{"link_uuid":"aea94d6d-0d4b-461f-96aa-b7b997e9c3ff","relation":"relates_to","target_id":"be15-1e02-591a-451d"},{"link_uuid":"4adfeab0-160e-487a-8306-20489479fd36","relation":"relates_to","target_id":"5bd0-37a1-4a85-48fe"},{"link_uuid":"91762295-6442-4000-b672-7e56264ecc69","relation":"relates_to","target_id":"e381-c8a6-f1b9-4e06"},{"link_uuid":"fe230e2f-9150-4a87-baa4-96d570aa1b21","relation":"relates_to","target_id":"f61f-a996-61b8-43fc"},{"link_uuid":"e72bb81d-b20a-497b-8cb7-5bc4bf0a76d4","relation":"relates_to","target_id":"3cfa-1932-8fdc-41ca"},{"link_uuid":"f7b11cbb-7453-479a-bfe0-71a0c5bddb6a","relation":"relates_to","target_id":"65c8-493c-86c1-4ffc"}],"description":"## Goal\nMake the `code_health` metric lens portable to non-Python client projects by replacing rebar-specific, Python-only readers with a configurable, per-project **code-analyzer** built on actively-maintained polyglot OSS tools. Ship the analyzer + its tool dependencies as an **optional `[metrics]` extra** so rebar core gains no new hard dependencies.\n\n## Why\nAudit finding (portability review): of 15 registered metrics, only the `code_health` lens is truly language-coupled. `module_size_distribution` / `cap_change_events` / module-size seeds hardcode `src/rebar/**/*.py`, LOC-of-.py, and `.github/module-size-limit.txt` (a rebar governance artifact). Used as-is by a client they DON'T fail loudly — they either fabricate authoritative-labeled zeros (scan an absent path -> {count:0,max_loc:0} at confidence=high) or leak a raw FileNotFoundError as the 'unavailable' reason. Ticket-derived (agent_process) and git-delta (churn/refactor_ratio) metrics are already language-agnostic and stay in core.\n\n## Recommended default stack (deterministic, no network, permissive licenses, verified actively-maintained 2026)\n- **scc** (MIT, Go) — LOC + fast size/DRYness + approx complexity + COCOMO. v4.x, 8.5k stars.\n- **lizard** (MIT, Python) — TRUE cyclomatic complexity (CCN) + token/param counts across ~25 languages. v1.23 (2026). Already a rebar dev/backfill dep.\n- **jscpd** (MIT) — duplication/clone detection, 223 formats, Rabin-Karp. v5. Already a rebar dep.\n- (rust-code-analysis has richer metrics — cognitive/Halstead/MI — but is STALE, last release 2023; not adopted.)\n\n## Design\n- Define an analyzer interface: `analyze(repo_root, languages) -> {loc, complexity, duplication}`, shelling out to the configured tool(s); deterministic, no LLM.\n- Per-project config selects tool + thresholds; the rebar module-size CAP becomes one optional policy layered on the generic LOC signal (not hardcoded).\n- **Hard fallback contract:** if no analyzer is configured for the client's language, emit a genuine `Unavailable(\"no analyzer configured for <lang>\")` — NEVER scan a hardcoded path, NEVER fabricate zeros, NEVER leak an errno as a reason. (Fixes the silent-misleading-data mode found in the audit.)\n- Package tools + analyzer under an optional `[metrics]` extra; core install stays dependency-free and degrades to Unavailable when the extra is absent.\n\n## Acceptance criteria\n- [ ] `code_health` metrics computed via the analyzer stack (scc/lizard/jscpd) for a Python client AND at least one non-Python client (e.g. Go or TS).\n- [ ] Zero new HARD deps in rebar core; analyzer + tools live behind `pip install rebar[metrics]`; core-only install reports code_health as Unavailable with a clear reason.\n- [ ] No hardcoded `src/rebar` / `.github/module-size-limit.txt`; scan root + size policy are per-project config.\n- [ ] Missing analyzer/tool -> honest `Unavailable`, never fabricated zeros and never a leaked exception string.\n- [ ] Module-size cap re-expressed as an optional policy over the LOC signal.\n- [ ] Docs (reuse-surface, user-guide) describe the extra, config, and the fallback contract.\n\n## Out of scope\n- Polyglot **dependency-graph** analysis — tracked separately as an idea (no mature drop-in polyglot tool exists; needs per-language adapters or tree-sitter/stack-graphs/SCIP). Explicitly NOT part of this epic.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/metrics/analyzer.py","reason":"new analyzer seam the code_health lens reads through (reuses Unavailable sentinel)"},{"path":"src/rebar/metrics/analyzers/","reason":"new scc/lizard/jscpd analyzers (separate from quarantined adapters/)"},{"path":"src/rebar/metrics/git_metrics.py","reason":"remove hardcoded src/rebar + module-size cap file; read via analyzer"},{"path":"pyproject.toml","reason":"new optional [metrics] extra + _optional.EXTRAS entry"},{"path":"src/rebar/_config_schema.py","reason":"new [code_health] config section"},{"path":"docs/config.md","reason":"document the extra, config keys, fallback contract"}],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","0734-ceae-be55-4fa7"],["depends_on","9597-1b85-d2ab-4eed"],["depends_on","e7a0-acef-ec67-42bb"],["relates_to","3cfa-1932-8fdc-41ca"],["relates_to","5bd0-37a1-4a85-48fe"],["relates_to","5d28-cd94-ec65-4999"],["relates_to","65c8-493c-86c1-4ffc"],["relates_to","7e17-d75e-dfa2-4055"],["relates_to","a120-3023-1d1f-4f16"],["relates_to","be15-1e02-591a-451d"],["relates_to","e381-c8a6-f1b9-4e06"],["relates_to","f61f-a996-61b8-43fc"]],"parent_id":null,"parent_status_uuid":"e3e243d3-e4f7-4b36-95f2-604b47573590","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["metrics","code-health","portability"],"ticket_id":"839b-f6d2-7e1a-4051","ticket_type":"epic","title":"Code-health metrics: adopt polyglot analyzer stack (scc/lizard/jscpd) behind a [metrics] extra","verify_commands":[]},"source_event_uuids":["9e2691f0-c4e1-49a7-9df4-dc71e57a718d","da037c0c-53cd-4f7a-851c-4703c604b8fd","b9ac7613-518e-4294-af1f-e0b8fc77a3e4","4055c7e4-a99e-4fa0-8402-a53f956b65a9","89aac952-80b4-4a46-a565-e2c7988fa1a8","d521e5ae-0d85-40c8-ab2d-5bf253090464","419f3fed-b269-4d56-b75f-171c004e3a9e","71e303cc-5573-438b-a981-94950214c391","38b415a0-7323-4c10-8e21-095ca954830d","82b0200e-3e5a-4876-ae82-2f28da0496ac","e3e243d3-e4f7-4b36-95f2-604b47573590","e1bbe04f-cf0f-4e9a-8cab-fa723404b1d6","6dc02cee-cd40-46ff-96c1-77be96eee6c6","aea94d6d-0d4b-461f-96aa-b7b997e9c3ff","4adfeab0-160e-487a-8306-20489479fd36","91762295-6442-4000-b672-7e56264ecc69","fe230e2f-9150-4a87-baa4-96d570aa1b21","e72bb81d-b20a-497b-8cb7-5bc4bf0a76d4","f7b11cbb-7453-479a-bfe0-71a0c5bddb6a"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1784873985466339002,"uuid":"c19e5da8-39b2-4cff-a3ec-383853993019"}