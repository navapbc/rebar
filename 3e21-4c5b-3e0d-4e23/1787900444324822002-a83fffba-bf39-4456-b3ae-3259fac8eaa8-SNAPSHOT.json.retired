{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787900444324822002,"compiled_state":{"alias":"rookie-fickle-hydra","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"3da535d977d5211205c2576048457e8bf1a87150","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3e21-4c5b-3e0d-4e23","material: d239806c97f9656a","material-part: children 647ea2107ca5072f 0","material-part: description c0bfc11ba42dd0ab 4203","material-part: description_boxes 2481a63c85a62cf8 4","material-part: file_impact aaaf8893889a82ff 2","material-part: ticket_id d374a23410b2e4a3 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (fc100dbe455e)","regver: aa61189569d34126","verified-at-sha:43c934b6ad3728cf1f2e78d5f2c1663dfe8b8c88","dep 31579110a77474f6e743ef98c7184d22e61a72446f5d88375b35d7e74ad2317f src/rebar/_commands/transition_close.py","dep 51dd4ccaf1cac69d693594ae46b8925571ac95cfdfa929e11bd39c96bd4f0707 tests/interfaces/lifecycle/test_close_symbolic_ref_pins_3e21.py","read-set: 2","read-path: src/rebar/_commands/transition_close.py","read-path: tests/interfaces/lifecycle/test_close_symbolic_ref_pins_3e21.py","currency-basis: file_impact"],"material_fingerprint":"d239806c97f9656a","merged_log_commit":"43c934b6ad3728cf1f2e78d5f2c1663dfe8b8c88","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787900293389784000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":8,"unsigned":0},"authorship_ledger":[{"content_hash":"581b5777e4820472c7dde7ac9ad8f2bc5ae2012847cf4a571be8c3c29a51afda","event_uuid":"77be6b17-d641-49d9-a1ba-fe44ead748db","position":{"commit_sha":"79cd4e60257953d7f10aaf71807507bdd1046805","position":"1787895384032418243-77be6b17-d641-49d9-a1ba-fe44ead748db"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"dab202541e86e5618eae52f2c573ca26b6107a30e7f74af73b26e061c414162c","event_uuid":"47ee76e8-2db0-491b-b2b3-30e3dcb83fb3","position":{"commit_sha":"8713f31c6120507f09950b75f5195d69ab9540d6","position":"1787896082155100484-47ee76e8-2db0-491b-b2b3-30e3dcb83fb3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b6a98ffa659c8b0a5d3ad012f3463443bcdaef07ab185ac72f26248c25c8c50c","event_uuid":"ff070fc5-5a6b-4937-be30-0b82e99c07ab","position":{"commit_sha":"4b9726dd2274015bdacbc78bb0ade9d456c50331","position":"1787896787697763173-ff070fc5-5a6b-4937-be30-0b82e99c07ab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"11729305067d285d633f05f5bd2b86cee3543cafe04806de7ec86bf47c390e68","event_uuid":"922cb3f5-4db3-4680-a14a-fdbd7a0d7b2a","position":{"commit_sha":"6510da648a4092a7d065b03075d2ee962c2d7b0b","position":"1787900010029697001-922cb3f5-4db3-4680-a14a-fdbd7a0d7b2a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b22b3810d637f93f6d72a65016556183f0ed03b3e5e4dec5578a258e759e95db","event_uuid":"64cc4b4d-2a37-4f75-832e-22c223762d08","position":{"commit_sha":"82eb935adb2fd3de8ae21e982ca38362c9b27ba0","position":"1787900293438757001-64cc4b4d-2a37-4f75-832e-22c223762d08"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"99ec4d5b5b84d0a57ed33d8d2949328f9db284203d5917ff9e3d00a6e45b26e1","event_uuid":"32336677-755e-4b1e-aa97-1f2067cfba8c","position":{"commit_sha":"00261e97836c81cf1597d9a6356f74c71ac90d1e","position":"1787900441539604001-32336677-755e-4b1e-aa97-1f2067cfba8c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c4420c54c1c41a30615c4ac06ff38f44827f38ca728c75376b31ca7bc3e6fba0","event_uuid":"00a82c04-7aba-40b9-8f3b-6f7bb96f3479","position":{"commit_sha":"00261e97836c81cf1597d9a6356f74c71ac90d1e","position":"1787900444324822001-00a82c04-7aba-40b9-8f3b-6f7bb96f3479"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-247_agent","claim_remote_session":null,"claimed_session":"41c69740-e628-4506-a328-65f32258a98e","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## FIX IMPLEMENTED — RED→GREEN complete, committed locally, NOT pushed\n\nOperator approved the direction (\"resolve to a SHA at the beginning, and use that to REPLACE THE\nORIGINAL REF ARG before it's threaded through the rest of the process\"). Implemented exactly that\nshape. Worktree `/Users/joeoakhart/rebar-dbg-hydra`, branch `dbg-rookie-fickle-hydra`, commit\n`4087c3ab2418` on top of `origin/main` `6f8a936bb31a`. Not pushed to Gerrit.\n\n### The change — one non-test file, +44/-15\n\n`src/rebar/_commands/transition_close.py`. A new `_pin_completion_ref(ref, repo_root)` normalises\nthe completion target at the close boundary, and `close_ticket` REBINDS the parameter:\n\n    ref = _pin_completion_ref(ref, repo_root)\n\nreplacing the old `if ref is None:` block. This is argument replacement, not cache-and-reuse — the\ndistinction is the whole point. Caching a sha beside a still-symbolic argument would fix today's\ntwo call sites and rely on every future caller remembering to prefer the cache; the next step\nadded that needs the ref would re-resolve it and silently reopen this race. After the boundary\nthere is nothing symbolic left to resolve, and `git rev-parse` on a full sha is idempotent, so\neven a redundant downstream resolution is harmless. Verification, snapshot materialisation, the\ndrift guard and signing never see `origin/main`.\n\n**Two deliberately different failure policies**, per the operator's point 3:\n\n- EXPLICIT ref → **fail early**. `SnapshotRefError` propagates from the boundary. Same\n  fail-closed error the verifier path raises for a bad `--ref` today, just raised *before* a\n  billable verification instead of minutes into one.\n- DEFAULT (`ref is None`) → best-effort, 4de6's lazy-HEAD fallback preserved byte-for-byte.\n\n**Untouched**, so genuine drift is still refused exactly as before: `_material_drifted`, the\ndrift-refusal branch, the `completion_signature` cause vocabulary, the exit codes, and the\noff-by-default atomic path (`commit_completion_bundle` / `_validate_code_ref`).\n\n**Boundary choice, checked rather than assumed.** The pin stays inside\n`if target_status == \"closed\" and current_status != \"idea\":`. Within `close_ticket`, `ref` has\nexactly two consumers — `_completion_precheck` (verify) and `completion_bundle._publish_close`,\nwhich only forwards `ref` when `verified_result is not None` (`completion_bundle.py:101,133-134`),\nreachable only on that guarded path. So the pin is upstream of every consumer. Hoisting it to the\nCLI parser would newly resolve — and now fail early on — a ref for `idea -> closed` rejects and\nplain non-close transitions, where it is meaningless, and would have to be duplicated across\nlibrary / CLI / MCP; `close_ticket` is the single point all three funnel through.\n\n**Surfacing the resolved sha** needed nothing new: it is already stamped into the signed manifest\nas `verified-at-sha:` and readable via `rebar verify-signature <id> --kind completion-verifier`.\n\n### RED → GREEN, with a held-out oracle and a mutation check\n\n`tests/interfaces/lifecycle/test_close_symbolic_ref_pins_3e21.py` — three tests. The race test\nadvances `refs/remotes/origin/main` *inside* the verifier stub (a real mid-operation ref move, not\na static ref), then asserts the ticket lands `certified` with `verified_at_sha` equal to the tree\nactually verified; a second asserts the public payload reads\n`{\"signed\": True, \"cause\": \"signed\", \"error\": \"\"}`; a third guards the quiet case.\n\n- **RED first, for the right reason** — 2 failed / 1 passed before any fix, with the reported\n  stderr reproduced verbatim in shape (\"the code drifted between verify (…) and sign (…)\").\n- **Held out** — the file was moved OUT of the tree before the implementing subagent was launched,\n  and it was told the contract only. GREEN was then verified against an oracle the fixer never saw.\n- **Teeth (defect-seeded mutation, run under `sandbox-exec` with writes denied outside the\n  worktree)** — re-introducing the exact root cause (`return ref` instead of\n  `return resolve_ref(ref, ...)` on the explicit branch) returned it to RED; fix restored.\n- **Refactoring litmus** — assertions are on observable output (the attestation verdict,\n  `verified_at_sha`, the public `transition()` payload). No private names, no source-text greps.\n\n### Replication of the ORIGINAL report — through the real CLI argv path\n\nDrove `transition_cli([story, \"in_progress\", \"closed\", \"--ref\", \"origin/main\", \"--output\",\n\"json\"])` with `origin/main` advancing mid-run:\n\n    CLI exit code       : 0\n    CLI stdout          : {... \"completion_signature\": {\"signed\": true, \"cause\": \"signed\", \"error\": \"\"}}\n    CLI stderr          : (none)\n    attestation verdict : certified\n    verified_at_sha     : d9879e722e68…  == the verified tree A\n    origin/main now     : 72259388af71…  (ADVANCED mid-run)\n\nNo warning, and the attestation binds the tree that was verified. The report no longer reproduces.\n\n### Gates\n\n`make lint` pass (complexity ratchet `active=39 new=0 increased=0 stale=10` — `close_ticket` got\n*simpler* via the extraction, so no baseline edit and none attempted); `make typecheck` clean\n(680 files); `pytest tests/unit/test_module_size_contract.py` 4 passed (`transition_close.py` now\n797 LOC, under the 800 cap); the adjacent suites — `test_close_ref_target_80af.py`,\n`test_close_default_pins_head_4de6.py`, `test_close_drift_message_4de6.py`,\n`test_attested_signing.py`, `test_transition_close.py`, `test_exit_codes.py` — 75 passed; broad\nsweep of `tests/interfaces/lifecycle` + `tests/unit` 14605 passed, 51 skipped, 0 failed.\n\n### Fix-safety audit\n\n- **Restoration, not creation.** Extends an invariant that already exists in this file to the case\n  it was written for. No new entry point, command, artifact, or mutating external call. The one\n  intentional observable change beyond the race fix is that an unresolvable explicit `--ref` now\n  raises at the boundary rather than inside verification — same exception class, same fail-closed\n  outcome, earlier; requested by the operator.\n- **No new dependency.** `resolve_ref` was already imported and used in this file.\n- **No test weakened.** `git show --stat` is two files: the fix and the new test. No pre-existing\n  test edited, skipped, or xfailed.\n- **Caller-dependency sweep.** `ref`'s only consumers inside `close_ticket` are the two named\n  above; neither depends on receiving a symbolic value — both rev-parse it, and both are strictly\n  better handed a sha. Incidental usage only; gate cleared.\n\n### Step 7 sibling sweep — both axes\n\n**Axis 1 (construct: a symbolic ref resolved independently at two points, then compared).** Swept\nall nine `resolve_ref` call sites; **no live sibling**:\n\n- `llm/plan_review/manifest.py:254` — re-resolves the default ref on every *currency* read. Correct\n  by design: it answers \"is this attestation current NOW?\", so a fresh read is the point. Not a\n  verify→sign equality pair.\n- `_commands/close_autoresume.py` (`target_sha = resolve_ref(ref or \"HEAD\", ...)`) — fails closed\n  to a fresh verify on any mismatch. Cannot produce an unsigned close.\n- `_commands/completion_bundle.py:331` (`_validate_code_ref`) — raises an exit-10\n  `ConcurrencyMismatch` *before* the close commits. Loud and safe; also off by default; and it now\n  receives the pinned sha anyway.\n- `_snapshot/{cache,repo_snapshot}.py` — materialisation internals, one resolution per acquire.\n\nNotably the **plan-review gate already implements the fix's discipline structurally**: its\n`verified_at_sha` comes from `llm/gate_context.py:156-168`, which derives the sha from the active\nsnapshot *directory name* (the content-addressed store keys entries by full sha), so it never\nre-resolves a symbolic ref at sign time. The completion close gate was the only gate carrying a\nsymbolic ref past resolution.\n\n**Axis 2 (parity census).** Rule: *a gate operation must bind ONE immutable code sha for its whole\nverify→sign unit.* No MISSING slots:\n\n| surface | where the rule holds |\n|---|---|\n| CLI `rebar transition … closed --ref` | `transition_close.py` `_pin_completion_ref` (this fix) |\n| MCP `transition_ticket(ref=…)` | same core via `_mcp_writes` → library → `close_ticket` |\n| MCP standalone `verify_completion` | N/A — `_record_standalone_completion` signs the verdict directly against its own `verified_at_sha`; no drift guard, no second resolution |\n| library `rebar.transition(ref=…)` | same core |\n| automated caller: op-cert gate service | N/A — `opcert_service/jobs.py:121-123` signs the verdict it just produced through the shared producer; no re-resolution (`_material_drifted` has no user outside `transition_close.py`) |\n| dual direction: plan-review / claim gate | already holds it, `llm/gate_context.py:156-168` |\n\n### Residual risk & prevention\n\n- **The default path's best-effort fallback** (`transition_close.py`, the `except -> None` branch):\n  if `resolve_ref(\"HEAD\", …)` raises, the old lazy double-read of HEAD returns. **Accepted** —\n  deliberate \"never worse than before\" behaviour inherited from 4de6, and it requires a\n  HEAD-resolution failure to reach.\n- **Silence in the CLI's default text output** when a close lands without its attestation.\n  **Ticket filed**: `faulty-floppy-kob` (4c28-0883-bf98-424b), linked `discovered_from` this bug,\n  kept separate per the operator's instruction. `f4cf` already delivered the machine-readable\n  marker to library / `--output json` / MCP and the stderr warning; the residual is the text branch\n  at `_commands/transition.py:641-647`, which never inspects `completion_signature`.\n\n### Not done, and why\n\nThe ticket is left `in_progress`. Per AGENTS.md a ticket is not closed until its change is\n`Verified +1` on Gerrit, and this has not been pushed (operator instruction). When it does close,\nthe close must carry `--class regression --caused-by 80af-c876-5856-4159` — the `caused_by` edge is\nalready recorded, but a close with an empty `--caused-by` re-runs blame auto-derivation and would\nadd a second, guessed edge beside the proven one.\n","timestamp":1787896082155100484}],"created_at":1787891914364322001,"creation_channel":"cli","deps":[{"link_uuid":"ff070fc5-5a6b-4937-be30-0b82e99c07ab","relation":"relates_to","target_id":"6c53-5e6c-34ec-44c6"}],"description":"## Summary\n\n`rebar transition <id> in_progress closed --ref origin/main` resolves the ref MORE THAN ONCE\nduring a close. If `origin/main` advances between the verification step and the signing step,\ncompletion verification PASSES against the first sha and the signer then REFUSES to attest,\nbecause the state it is asked to sign has drifted from the state that was verified.\n\nThe close SUCCEEDS. The ticket reaches `closed` with `class` recorded and no error is printed.\nWhat is silently missing is the completion-verifier attestation.\n\n## Observed\n\nClosing `cutprice-untameable-stork` (326f-595a-088b-40a5):\n\n- verification ran against `6fe5c0d54574`\n- `origin/main` advanced to `d44bd253ee44` mid-run\n- verification PASSED; the signer refused the drifted state\n- result: `status=closed`, `close_class=preexisting`, **no completion-verifier signature**\n\nNothing in the output flags the gap. It is only visible if you go looking for the attestation.\n\n## Why it matters\n\nThe attestation is the durable evidence that a close was earned rather than asserted. A close\nthat passes verification but silently loses its signature is indistinguishable, after the fact,\nfrom one that was never verified — which is precisely the property the gate exists to provide.\n\nThe window is not narrow in practice: a completion-verified close takes 9-11 minutes, and on a\nrepo with active CI and multiple agents `origin/main` moves several times an hour. This session\nalone moved main a dozen times.\n\n## Mechanism (hypothesis — not yet proven)\n\nTwo independent resolutions of the same symbolic ref, with a multi-minute LLM verification\nbetween them. A single resolve-once-then-reuse would remove the race. I have NOT read the close\npath to confirm where the second resolution happens; whoever picks this up should.\n\n## Workaround, and why it is not a fix\n\nPass an immutable sha:\n\n    SHA=$(git rev-parse origin/main)\n    rebar transition <id> in_progress closed --class <c> --ref \"$SHA\"\n\nThat works, but it requires every caller to know the hazard. The documented guidance and the\ntool's own help present `--ref origin/main` as ordinary usage, and the CLI close gate's DEFAULT\n(worktree HEAD) has the same shape — a HEAD that moves mid-run would race identically.\n\n## Acceptance Criteria\n\n- [x] A symbolic `--ref` is resolved ONCE at the close boundary and the resolved sha REPLACES\n      the argument, so verification, snapshot materialisation, the drift guard and signing all\n      see the same immutable commit (`_pin_completion_ref`, `transition_close.py:135`, rebound\n      by the caller at `:618`).\n- [x] If the verified and signing shas ever disagree, the close emits a loud stderr warning\n      naming BOTH shas and the exact remediation, and refuses to attest stale state\n      (`transition_close.py:402-411`).\n      OPERATOR DECISION 2026-08-28: a warning is SUFFICIENT. The close is deliberately NOT\n      required to exit non-zero, because that would change the contract for every existing\n      caller (scripts, the library facade, and the MCP surface all expect exit 0 today). The\n      original wording asked the close to FAIL; it warns and succeeds, and that is accepted.\n      Note the drift branch is now near-unreachable: the pin removes the symbolic-ref split,\n      and 4de6 already pinned the default HEAD target.\n- [x] A close that cannot obtain an attestation says so on stderr, naming the cause and how to\n      certify. The machine-readable `completion_signature` marker is already present on the\n      library, JSON and MCP surfaces. The residual — the default CLI *text* output on stdout\n      not inspecting that marker — is tracked separately as `faulty-floppy-kob`\n      (`4c28-0883-bf98-424b`), filed from this investigation.\n- [x] A regression test drives a close with `--ref` advancing MID-RUN and asserts the close\n      lands SIGNED and bound to the verified tree\n      (`tests/interfaces/lifecycle/test_close_symbolic_ref_pins_3e21.py`); seeding the defect\n      back returns it to RED.\n\n## Found by\n\nA close performed during this session; the missing signature was noticed only because the\nclosing agent checked for it explicitly. Recorded because the failure is silent by construction.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/transition_close.py","reason":"normalise the completion --ref to an immutable sha at the close boundary (_pin_completion_ref), replacing the argument so verify and the pre-sign drift guard bind the same commit"},{"path":"tests/interfaces/lifecycle/test_close_symbolic_ref_pins_3e21.py","reason":"regression test: a close with a symbolic --ref that advances mid-run must still land signed, bound to the verified tree"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","6c53-5e6c-34ec-44c6"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"32336677-755e-4b1e-aa97-1f2067cfba8c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["gates","close","attestation","race"],"ticket_id":"3e21-4c5b-3e0d-4e23","ticket_type":"bug","title":"Close gate races on a moving --ref: verification passes at one sha, signing refuses at another","verify_commands":[]},"source_event_uuids":["77be6b17-d641-49d9-a1ba-fe44ead748db","47ee76e8-2db0-491b-b2b3-30e3dcb83fb3","ff070fc5-5a6b-4937-be30-0b82e99c07ab","922cb3f5-4db3-4680-a14a-fdbd7a0d7b2a","64cc4b4d-2a37-4f75-832e-22c223762d08","32336677-755e-4b1e-aa97-1f2067cfba8c","00a82c04-7aba-40b9-8f3b-6f7bb96f3479"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787900444324822002,"uuid":"a83fffba-bf39-4456-b3ae-3259fac8eaa8"}