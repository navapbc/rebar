c/rebar/_cli/_registry.py\":{\"docs\":[\"module\",\"route_for\"],\"spans\":[[1,17],[32,36],[80,82],[88,90],[414,419],[441,445],[628,637]]}}\"\"\")\nTOKENS=(\"noqa\",\"type:\",\"pyright:\",\"mypy:\",\"ruff:\",\"fmt:\",\"isort:\",\"pragma:\",\"nosec\",\"coverage:\",\"mechanism-ok:\",\"raw-git-ok:\",\"tickets-boundary-ok:\",\"read-via:\",\"repo-root-ok:\")\ndef normalize(src,path):\n    spec=M[path]\n    tree=ast.parse(src,filename=path,type_comments=True)\n    seen=set()\n    def walk(node,qual=\"module\"):\n        current=qual\n        if isinstance(node,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n            current=node.name if qual==\"module\" else f\"{qual}.{node.name}\"\n        body=getattr(node,\"body\",[])\n        if current in spec[\"docs\"] and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n            body[0].value.value=\"__ALLOWLISTED_PROSE__\"\n            seen.add(current)\n        for child in ast.iter_child_nodes(node):\n            walk(child,current)\n    walk(tree)\n    assert seen==set(spec[\"docs\"]),(\"missing allowlisted docstring\",path,sorted(set(spec[\"docs\"])-seen))\n    for node in ast.walk(tree):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n    return ast.dump(tree,include_attributes=False)\ndef directives(src):\n    lines=src.splitlines()\n    found=[]\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        body=tok.string[1:].lstrip()\n        if tok.string.startswith(\"#!\") or any(body.startswith(prefix) for prefix in TOKENS):\n            found.append(lines[tok.start[0]-1])\n    return found\ndef runtime_yaml(src):\n    return [line for line in src.splitlines() if line.strip() and not line.lstrip().startswith(\"#\")]\ndef check_hunks(path):\n    diff=subprocess.check_output([\"git\",\"diff\",\"--unified=0\",B,\"--\",path],text=True)\n    for line in diff.splitlines():\n        if not line.startswith(\"@@\"):\n            continue\n        match=re.match(r\"@@ -(\\d+)(?:,(\\d+))? \\+\\d+(?:,\\d+)? @@\",line)\n        assert match,(\"unparsed hunk\",path,line)\n        start=int(match.group(1)); count=1 if match.group(2) is None else int(match.group(2))\n        assert count>0,(\"addition-only hunk\",path,line)\n        end=start+count-1\n        assert any(start>=a and end<=b for a,b in M[path][\"spans\"]),(\"change outside allowlist\",path,line)\nfor path,spec in M.items():\n    before=subprocess.check_output([\"git\",\"show\",f\"{B}:{path}\"],text=True)\n    final=Path(path).read_text(encoding=\"utf-8\")\n    if spec.get(\"yaml\"):\n        assert runtime_yaml(before)==runtime_yaml(final),(\"YAML runtime drift\",path)\n    else:\n        assert normalize(before,path)==normalize(final,path),(\"AST/runtime drift\",path)\n        assert directives(before)==directives(final),(\"directive/shebang drift\",path)\n    check_hunks(path)'","dd_id":"immutable-prose-only","dd_text":"Only the 65 allowlisted prose blocks may change; normalized base/final Python ASTs and directive lines match, and every zero-context hunk deletes only allowlisted base lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import json, subprocess; expected=set(json.loads(\"\"\"[\"src/rebar/_cli/__init__.py\",\"src/rebar/_cli/_help_route.py\",\"src/rebar/_cli/_init.py\",\"src/rebar/_cli/_jira_onboard.py\",\"src/rebar/_cli/_llm_commands.py\",\"src/rebar/_cli/_parsers/_common.py\",\"src/rebar/_cli/_registry_checks.py\",\"src/rebar/_cli/_registry.py\"]\"\"\")); actual=set(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines()); assert actual==expected,{\"expected\":sorted(expected),\"actual\":sorted(actual)}'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/interfaces/contracts/test_create_help_no_write_b8de.py tests/interfaces/contracts/test_help_overview_coverage.py tests/interfaces/contracts/test_operation_snapshot_authoritative_binding.py tests/interfaces/facades/test_central_mount_gate_ad9f.py tests/unit/test_init_attach_predicate.py tests/unit/test_jira_onboard.py tests/unit/test_llm_commands_render.py tests/unit/test_cli_registry.py tests/unit/test_cli_registry_dispatch.py tests/unit/test_core_cli_parsers.py tests/interfaces/lifecycle/test_exit_codes.py","dd_id":"focused-contracts","dd_text":"Focused tests for every preserved subsystem contract pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_cli/__init__.py src/rebar/_cli/_help_route.py src/rebar/_cli/_init.py src/rebar/_cli/_jira_onboard.py src/rebar/_cli/_llm_commands.py src/rebar/_cli/_parsers/_common.py src/rebar/_cli/_registry_checks.py src/rebar/_cli/_registry.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"VERIFY_COMMANDS","timestamp":1788623767727905678,"uuid":"3e0bfe63-aee5-4d67-b18d-4ddbbe042a6e"}