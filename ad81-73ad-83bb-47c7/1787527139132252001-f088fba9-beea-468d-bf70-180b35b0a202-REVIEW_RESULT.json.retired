5cdbbaae3c1c667d06101384d4cd6ca2ae317edd2be24"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":60631,"output_tokens":3771,"requests":6}}],"version":1},"findings":[{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"- [ ] Correct the AC footer citation: the baseline field dict lives in `outbound_fields._map_local_to_jira_fields` (outbound_fields.py:165-184); `map_local_to_remote` is the delegating wrapper in `backend.py:219`.","cohort":["E4"],"criteria":["E4"],"decision":"advisory","decision_margin":-0.4357,"drop_reason":null,"evidence":["Plan: \"the outbound create path adapters/jira/outbound_fields.py:140-158 (map_local_to_remote) already supplies summary, description, issuetype, priority, assignee, conditionally status+parent\"","search_files: `def map_local_to_remote` is in adapters/jira/backend.py:219 and _backend.py:372, NOT outbound_fields.py","outbound_fields.py:165-184 builds the dict inside a function documented as `_map_local_to_jira_fields` (backend.py:86 calls `outbound_fields._map_local_to_jira_fields`); the baseline field set the plan names is verified at those lines"],"finding":"The AC footer attributes `map_local_to_remote` to `adapters/jira/outbound_fields.py:140-158`, but `map_local_to_remote` is defined in `adapters/jira/backend.py` (line 219, a delegating wrapper); `outbound_fields.py` defines `_map_local_to_jira_fields`, which is the function that actually builds the baseline dict at lines 165-184. The substantive premise (the baseline field set summary/description/issuetype/priority/assignee + conditional status/parent) IS correct at that location, so no work is deleted — this is a function-name citation mismatch only.","group_criteria":null,"group_id":null,"id":"f47708ca3dae88525","impact":0.44,"is_primary":null,"location":"Acceptance Criteria — 'create_defaults' baseline footer","norm_id":"nbdfc37fc994f39bd","priority":0.3143,"reason":"default-advisory","recalled":false,"scenarios":["Implementer opens outbound_fields.py looking for a function named map_local_to_remote and does not find it, briefly doubting the baseline scope"],"severity":"minor","suggested_fix":"Change the footer to: \"the outbound create path `adapters/jira/outbound_fields.py:165-184` (`_map_local_to_jira_fields`, reached via `backend.map_local_to_remote`) already supplies summary, description, issuetype, assignee, and conditionally priority/status/parent\".","tier":"LLM","validity":0.7143,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State explicitly which table header the stdout path emits (`[tool.rebar.mapping]` vs `[mapping]`) and confirm it matches the `[mapping]`-rooted form written to rebar.toml under --write, so AC1's assertion targets a consistent header.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5e"],"criteria":["COH","E1"],"decision":"dropped","decision_margin":-0.501,"drop_reason":null,"evidence":["AC1: 'emits a `[tool.rebar.mapping]` block'","Emit section: 'DEEP-MERGE under data[\"mapping\"][\"projects\"][<KEY>]'","Context: reserved block is '`[mapping]` / `[tool.rebar.mapping]`' — pyproject vs rebar.toml forms","'--write: ... Target via config._discover_project_config → existing rebar.toml ... user pyproject.toml is NEVER edited'"],"finding":"The emitted mapping table name is inconsistent between the stdout path and the --write path: AC1 says the default invocation emits a `[tool.rebar.mapping]` block, but the --write section merges under `data[\"mapping\"][\"projects\"][<KEY>]` into rebar.toml (which uses the bare `[mapping]` form, since pyproject.toml is never edited).","group_criteria":null,"group_id":null,"id":"fd362ff267a7a68c8","impact":0.264,"is_primary":null,"location":"Approach → Emit; AC line test_probe_emits_mapping","norm_id":"n635f9e3282c9d52d","priority":0.099,"reason":"low-validity","recalled":false,"scenarios":["A user runs suggest-mapping, sees `[tool.rebar.mapping]` on stdout, then --write produces `[mapping.projects.KEY]` in rebar.toml — two different header spellings for the 'same' block."],"severity":"minor","suggested_fix":"Clarify that stdout emits the rebar.toml-native `[mapping.projects.KEY]` form (matching the --write target), OR that stdout intentionally shows the pyproject `[tool.rebar.mapping]` form and --write normalizes to `[mapping]`; align AC1's assertion with whichever is chosen.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Document that the live pycontribs method surface is only validated by a manual smoke run (with the exact command/steps), or add a named follow-up/child for the live smoke, so the deferral of E6(f) is explicit and reproducible.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5e"],"criteria":["E6"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'Tests use a FAKE probe port ... fully offline, no live Jira'","'A live smoke run is manual, never a CI gate'","E6(f): a proving command on a mock substitute that BYPASSES the new behavior does not prove the criterion"],"finding":"No acceptance criterion exercises the live pycontribs code path; every AC runs against the FAKE port. The plan cuts over to real jira.JIRA method calls (issue_types/priorities/issue_link_types/statuses/createmeta_*/search_issues/transitions) whose availability across the pinned range `jira>=3.8,<4` is never proven by any in-CI check — only a manual smoke run.","group_criteria":null,"group_id":null,"id":"f5089bebaa0d724c3","impact":0.0,"is_primary":null,"location":"Testing section; Acceptance Criteria","norm_id":"n2c79086473c6e9ab","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["A pycontribs method (e.g. createmeta_issuetypes / createmeta_fieldtypes) is renamed or absent in some 3.8–3.x release; all offline tests stay green while the live probe fails at runtime."],"severity":"none","suggested_fix":"Add a 'Manual smoke' subsection giving the concrete command (`rebar bridge suggest-mapping <KEY>` against a real project) and the pinned-version methods it exercises, framed as the documented rationale for no in-CI live check.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify the probe's whole-failure behavior (unknown project, auth failure, timeout, getter exception): surface the error and exit non-zero without writing, and add an AC exercising a failing fake-port getter.","cohort":["E3","E5","G5","T5b","T6","T9","necessity","project.engine-layer-enforcement","project.portability"],"criteria":["T5b","T6"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'Default port built from build_client_from_settings ... tests inject a FAKE port'","Plan handles hierarchy-absent ('DROPPED empty + note') and transitions ('flagged best-effort') but names no whole-probe failure path (auth/timeout/unknown-project)","No AC exercises a probe failure — all four ACs run against a fake port returning canned data"],"finding":"The plan specifies graceful degradation for two axes (hierarchy dropped-empty when hierarchyLevel absent; transitions best-effort) but never states what happens when the probe as a whole fails: bad/nonexistent PROJECT key, auth failure, network timeout, or a getter raising. A read-only observe command that hits a live external dependency (pycontribs jira.JIRA via build_client_from_settings) needs a defined failure mode — surface the error and exit non-zero, never write.","group_criteria":null,"group_id":null,"id":"fdd7a4d038b067a27","impact":0.0,"is_primary":null,"location":"Approach / Probe (per-axis getters) + Emit section","norm_id":"na2e04bb3cea3167a","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["User runs `rebar bridge suggest-mapping BADKEY` against a real Jira and the createmeta call 404s — unclear whether the command crashes with a stack trace, emits a partial block, or exits cleanly with a diagnostic","A live Jira is slow/unreachable and a getter hangs — no timeout/degraded-mode is specified, so the CLI may hang or throw an unhandled exception"],"severity":"none","suggested_fix":"Add an AC `test_probe_surfaces_probe_failure`: fake port raises on a getter; command prints a diagnostic, exits non-zero, and writes no file even with --write.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Pin the live boundary: either document why each fake-port canned shape is faithful to pycontribs 3.x responses (cite the API), or add a named live/smoke acceptance criterion that exercises the real jira.JIRA getters against a fixture/recorded response.","cohort":["E3","E5","G5","T5b","T6","T9","necessity","project.engine-layer-enforcement","project.portability"],"criteria":["E5"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'Tests use a FAKE probe port returning canned ... data — fully offline'","'A live smoke run is manual, never a CI gate.'","'the vocabulary getters are documented pycontribs 3.x public API' (asserted, vs search_issues/transitions/fields which are 'CONFIRMED in DC adapter')"],"finding":"All four ACs exercise the command SOLELY through a FAKE probe port returning canned issue-type/priority/link-type/status/createmeta/search+transitions data; no automated test ever invokes the real pycontribs jira.JIRA boundary. The vocabulary getters (issue_types, priorities, statuses, issue_link_types, createmeta_issuetypes/fieldtypes) are grounded as 'documented pycontribs 3.x public API' — asserted, not confirmed in-repo — so if a real method name or response shape diverges from the fake port's canned shape, the whole suite goes green while the live command is broken. The plan defers live exercise to a MANUAL smoke run, not a named child ticket.","group_criteria":null,"group_id":null,"id":"facd630a12b486299","impact":0.0,"is_primary":null,"location":"Testing section + Acceptance Criteria (all four use the fake port)","norm_id":"ne031aabd1e4c3bce","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["pycontribs 3.x returns createmeta_fieldtypes in a shape the fake port did not model (e.g. field 'required' nested differently) — offline tests pass, the live command emits wrong-or-empty create_defaults stubs","A getter name assumed public (e.g. issue_link_types) differs from the actual 3.x API — fake-port tests are green, the live command raises AttributeError on first real run"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the create-baseline citation to name `_map_local_to_jira_fields` in `adapters/jira/outbound_fields.py` (or point at `backend.py:map_local_to_remote`), so the cited symbol matches its actual location.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"dropped","decision_margin":-0.0928,"drop_reason":null,"evidence":["Plan: \"the outbound create path adapters/jira/outbound_fields.py:140-158 (map_local_to_remote)\"","outbound_fields.py:117 defines `def _map_local_to_jira_fields(...)`; the baseline fields (summary/description/issuetype/priority/assignee/status/parent) appear in its params at :124-127","`def map_local_to_remote` matches only in backend.py (adapters/jira/backend.py:73,219; _backend.py:372; jira_datacenter/backend.py:145) — never in outbound_fields.py"],"findi