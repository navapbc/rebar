entation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Fix the create-baseline reference: the function at `outbound_fields.py:117` is `_map_local_to_jira_fields` (not `map_local_to_remote`, which lives in `adapters/jira/backend.py`).","cohort":["G1G2"],"criteria":["G1G2"],"decision":"dropped","decision_margin":-0.02,"drop_reason":null,"evidence":["Plan: `adapters/jira/outbound_fields.py:140-158` (`map_local_to_remote`)","Grep: `outbound_fields.py:117 def _map_local_to_jira_fields`; `map_local_to_remote` appears in `adapters/jira/backend.py:73,219` and `_backend.py:372`","The cited line region (140-158) does document parent/priority/assignee baseline behavior, so the location is otherwise accurate"],"finding":"The 'create_defaults baseline' AC footer names `map_local_to_remote` at `adapters/jira/outbound_fields.py:140-158`, but that file's function at that region is `_map_local_to_jira_fields` (def at line 117). `map_local_to_remote` is defined in `adapters/jira/backend.py`, not `outbound_fields.py`.","group_criteria":null,"group_id":null,"id":"fb5978ef2fef7c423","impact":0.85,"is_primary":null,"location":"Acceptance Criteria → create_defaults baseline footer; `adapters/jira/outbound_fields.py`","norm_id":"nb3090432ce723287","priority":0.68,"reason":"veto:cited-reference-inaccurate","recalled":false,"scenarios":["Implementer greps `outbound_fields.py` for `map_local_to_remote`, finds nothing, and mis-locates the create-baseline source."],"severity":"critical","suggested_fix":"Cite `outbound_fields.py:117 _map_local_to_jira_fields` (or the `backend.py` `map_local_to_remote` wrapper) for the create baseline.","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"no","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Resolve the createmeta capability assertion for Data Center: state which createmeta variant (createmeta_issuetypes/createmeta_fieldtypes vs project_issue_fields) the pinned jira>=3.8,<4 client uses on the DC versions the adapter supports, and specify fail-closed handling (drop create_defaults + honest note) for the documented version-gated 'Unsupported JIRA deployment type' failure — mirroring how hierarchy is dropped when hierarchyLevel is absent.","cohort":["T1"],"criteria":["T1"],"decision":"dropped","decision_margin":-0.7,"drop_reason":null,"evidence":["Plan quote: 'create_defaults stubs → jira.JIRA.createmeta_issuetypes(<KEY>) + createmeta_fieldtypes(<KEY>, <id>) (public createmeta API)'","Web (pycontribs/jira client.py, retrieved): \"'createmeta_fieldtypes' is deprecated and will be removed in future releases. Use 'project_issue_fields' instead.\"","Web (pycontribs/jira issue #1907, retrieved): project_issue_fields raises 'Unsupported JIRA deployment type ... version ... Use createmeta instead' — createmeta behavior is deployment/version-gated","Web (pycontribs/jira PR #1527, retrieved): 'Support for the new createmeta API in Jira 8.4+' — variant applies only to Jira >= 8.4","In-repo search for 'createmeta' across adapters returned (no matches) — unlike transitions/search_issues, this axis has no confirmed in-repo anchor"],"finding":"The plan asserts createmeta_issuetypes(<KEY>) and createmeta_fieldtypes(<KEY>, <id>) as a stable 'public createmeta API' for create_defaults stubs, but this capability is unresolved for Jira Data Center: pycontribs's createmeta surface is version-gated (the new variant only applies to Jira 8.4+; older paths differ), createmeta_fieldtypes carries a deprecation warning steering callers to project_issue_fields, and there is a documented failure mode where the client raises 'Unsupported JIRA deployment type ... Use createmeta instead.' create_defaults is the ONLY axis with no in-repo anchor (no existing createmeta usage in the adapters), so unlike transitions/search_issues it is unverified new surface.","group_criteria":null,"group_id":null,"id":"f5c1c4cf47f05a48c","impact":0.0,"is_primary":null,"location":"Approach — Axis grounding, 'create_defaults stubs → jira.JIRA.createmeta_issuetypes(<KEY>) + createmeta_fieldtypes(<KEY>, <id>) (public createmeta API)'; AC footer 'create_defaults baseline (concrete)'","norm_id":"nc62538c166975e34","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["Running suggest-mapping against a Jira DC instance older than 8.4, or a version where the pinned jira>=3.8,<4 client's createmeta variant is unsupported, yielding an exception instead of a create_defaults stub","A future pin bump surfacing the createmeta_fieldtypes deprecation removal"],"severity":"none","suggested_fix":"Add a create_defaults degradation path: wrap the createmeta call so that a version/deployment-gated failure drops create_defaults empty with an explanatory note (as hierarchy already does), and document that create_defaults is best-effort on older DC. Confirm the exact createmeta method available in jira 3.8-3.x for DC and cite it the way transitions/search_issues are anchored in-repo.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"yes","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"8d7277191711d8b8","material_parts":{"children":["647ea2107ca5072f",0],"description":["a0799e28056a32c3",7973],"description_boxes":["2481a63c85a62cf8",4],"file_impact":["49a33cd24421ab2f",10],"ticket_id":["6d6e8c9453bc3b22",19]},"metrics":{"cache_read_tokens":0,"cache_write_tokens":0,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":4186.6,"input_tokens":943378,"llm_calls":28,"llm_ms":338295.4,"output_tokens":39309,"precheck":{"cited_anchor_warning":false},"total_ms":353350.4,"verify_requests":19},"model":"bedrock:us.anthropic.claude-sonnet-4-6","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4-6","anthropic:claude-sonnet-4-6"],"capabilities":{"native_structured_output":true,"prompt_cache_style":"none","supports_temperature":true,"supports_thinking":true,"web_access":"