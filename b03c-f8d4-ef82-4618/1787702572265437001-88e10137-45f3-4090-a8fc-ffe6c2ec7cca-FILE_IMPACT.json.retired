{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"file_impact":[{"path":"docs/adr/0005-snapshot-cache-architecture.md","reason":"Record the lazy ticket OID view and receipt-checked atomic close decision."},{"path":"docs/concurrency.md","reason":"Document stable-read predicates, lock width, retries, and publication boundaries."},{"path":"docs/config.md","reason":"Document the default-off completion_pinned_ticket_view rollout switch."},{"path":"docs/plan-review-gate.md","reason":"Document completion read modes, receipt vocabulary, atomic delivery, and timing fields."},{"path":"src/rebar/_commands/close_autoresume.py","reason":"Reuse one pinned ticket view across verifier auto-resume attempts and avoid incompatible legacy PASS reuse."},{"path":"src/rebar/_commands/close_precheck.py","reason":"Capture one ticket OID before completion checks and route deterministic reads through it."},{"path":"src/rebar/_commands/transition_close.py","reason":"Select and report the receipt-bearing atomic completion bundle."},{"path":"src/rebar/_commands/txn.py","reason":"Prepare a final STATUS event under an existing close transaction lock."},{"path":"src/rebar/_config_schema.py","reason":"Add the typed experimental rollout configuration field."},{"path":"src/rebar/_engine_support/commit_impact.py","reason":"Allow commit-reference resolution against the pinned ticket resolver."},{"path":"src/rebar/_engine_support/reads.py","reason":"Bind the current immutable ticket view and propagate pinned read failures."},{"path":"src/rebar/_reads.py","reason":"Route modeled library reads through the pinned view and reject unsupported live fallbacks."},{"path":"src/rebar/_store/event_append.py","reason":"Add rollback-safe multi-event commit support for callers already holding the store lock."},{"path":"src/rebar/llm/completion.py","reason":"Select the operation read mode, thread the view, and attach the typed completion read basis."},{"path":"src/rebar/llm/completion_child_gate.py","reason":"Evaluate child closure from field-level pinned predicates without widening receipts."},{"path":"src/rebar/llm/completion_sidecar.py","reason":"Persist the read basis and selected ticket-read mode in completion verdict payloads."},{"path":"src/rebar/llm/config.py","reason":"Carry the concrete ticket view through worker dispatch."},{"path":"src/rebar/llm/gate_context.py","reason":"Expose the immutable ticket-view context alongside the code snapshot context."},{"path":"src/rebar/llm/gate_source.py","reason":"Permit code snapshot capture without full ticket-store materialization and bind the lazy view."},{"path":"src/rebar/llm/pai_tools.py","reason":"Serve verifier ticket-tool reads directly from the pinned view."},{"path":"src/rebar/llm/plan_review/relation_snapshot.py","reason":"Compute completion material from pinned field and child-membership predicates."},{"path":"src/rebar/llm/runner.py","reason":"Inject the pinned ticket view into the verifier tool set."},{"path":"src/rebar/llm/workflow/completion_banking.py","reason":"Bind criterion-bank stamps to tickets_oid and propagate pinned read failures."},{"path":"src/rebar/llm/workflow/completion_recovery.py","reason":"Keep recovery manifest reads fail-closed inside pinned sessions."},{"path":"src/rebar/llm/workflow/completion_verdict_cache.py","reason":"Bind cached completion verdicts to tickets_oid and reject cross-revision reuse."},{"path":"src/rebar/signing.py","reason":"Prepare completion certificates before publication and verify pinned attestation records."},{"path":"src/rebar/_commands/completion_bundle.py","reason":"Orchestrate receipt validation, bundle preparation, atomic commit, and delivery."},{"path":"src/rebar/_commands/completion_candidate.py","reason":"Create UUID-private object-sharing sparse repositories for candidate close commits."},{"path":"src/rebar/_commands/completion_delivery.py","reason":"Publish candidates with ordinary fast-forward semantics and receipt-aware race recovery."},{"path":"src/rebar/_commands/completion_txn.py","reason":"Finalize and commit verdict, STATUS, and SIGNATURE as one candidate transaction."},{"path":"src/rebar/_commands/completion_verifier_run.py","reason":"Keep verifier timing, auto-resume threading, and failure shaping on one call-graph seam."},{"path":"src/rebar/_snapshot/ticket_objects.py","reason":"Provide lazy Git object reads plus pinned resolver and inbound-link indexes."},{"path":"src/rebar/_snapshot/ticket_receipt.py","reason":"Define typed code and ticket OIDs, immutable read bases, and descendant receipt replay."},{"path":"src/rebar/_snapshot/ticket_view.py","reason":"Provide demand-reduced immutable ticket reads and receipt predicate capture."},{"path":"tests/unit/test_close_autoresume_b5f8.py","reason":"Cover view identity and mode propagation across auto-resume."},{"path":"tests/unit/test_close_duration_instrumentation.py","reason":"Cover timing collector threading through the new verifier seam."},{"path":"tests/unit/workflow/test_completion_banking.py","reason":"Cover tickets_oid criterion-bank stamp behavior."},{"path":"tests/unit/workflow/test_completion_verdict_cache.py","reason":"Cover ticket-revision-bound completion cache reuse."},{"path":"tests/interfaces/lifecycle/test_atomic_completion_close.py","reason":"Cover atomic commit faults, idempotence, parallel races, and remote delivery outcomes."},{"path":"tests/unit/test_pinned_ticket_view.py","reason":"Cover stable lazy reads, resolver parity, receipt replay, hierarchy, links, and fail-closed errors."},{"path":"docs/env-vars.md","reason":"Refresh the generated env registry after completion config line shifts."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"FILE_IMPACT","timestamp":1787702572265437001,"uuid":"88e10137-45f3-4090-a8fc-ffe6c2ec7cca"}