age":{"dependencies":[],"digest":"19ff5af1d652fe3770b7656ad9cef33498837c1c727ddb47bc0f945af5aaa862"},"namespace_version":1,"reason":null,"unit_id":"agent:G1G2","usage":{"input_tokens":85146,"output_tokens":5418,"requests":8}},{"kind":"success","lineage":{"dependencies":[],"digest":"8a6c855877d056fa74f2d3c4452252d3786368b275e648db1f354575397b321a"},"namespace_version":1,"reason":null,"unit_id":"agent:G6","usage":{"input_tokens":96076,"output_tokens":5433,"requests":7}},{"kind":"success","lineage":{"dependencies":[],"digest":"9b8b10b0c7684a024b2e275ae9069a5ae267e82d07b578e03c273378cb9b2f2c"},"namespace_version":1,"reason":null,"unit_id":"agent:E4","usage":{"input_tokens":119636,"output_tokens":6121,"requests":9}},{"kind":"success","lineage":{"dependencies":[],"digest":"f944aed67a30a3322260f2a929cb2ec768d8b5750be67a7d54201f3462bdd528"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":60905,"output_tokens":2478,"requests":6}},{"kind":"success","lineage":{"dependencies":[],"digest":"949ba2cdb9f569501003d08422a85c6d2d4665d2b3b1fef75d49a5827f26a711"},"namespace_version":1,"reason":null,"unit_id":"agent:project.symbol-reference-completeness","usage":{"input_tokens":26031,"output_tokens":1256,"requests":3}},{"kind":"success","lineage":{"dependencies":[],"digest":"d745914eb6a36c09167701816627ac757cc527d49acbc8479c0fe8bb35cd13fd"},"namespace_version":1,"reason":null,"unit_id":"agent:T5c","usage":{"input_tokens":28681,"output_tokens":1897,"requests":3}},{"kind":"success","lineage":{"dependencies":[],"digest":"9b39282e915fcaf0cd336a090e687670a7e7c82cfc92b4cb7e6aec6f716edd94"},"namespace_version":1,"reason":null,"unit_id":"agent:T1","usage":{"input_tokens":74794,"output_tokens":3145,"requests":7}},{"kind":"success","lineage":{"dependencies":[],"digest":"b9aa47ce78bbe5ee1828f616cde681c0b10ce67d3d8b87d3fdbe8ef0b46bb604"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":70545,"output_tokens":5812,"requests":6}}],"version":1},"findings":[{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"Correct the dispatch-model description: exec_tier returns only AGENT/2-STEP/1-TURN (never CONTAINER); state that G3/G4 return AGENT from exec_tier and are separated into the container path by run_pass1/_resolve_criteria.","cohort":["E4"],"criteria":["E4"],"decision":"block","decision_margin":0.25,"drop_reason":null,"evidence":["Plan: '`registry.exec_tier(crit)` (registry.py:604) returns \"AGENT\" for any id in AGENT_TIER ... or \"CONTAINER\" for G3/G4'","registry.py:604-610: exec_tier returns 'AGENT' / '2-STEP' / '1-TURN' only; no CONTAINER branch","production_batch_runner.py:203: 'the container criteria G3/G4 are pulled out of `agent` by run_pass1 itself'"],"finding":"The plan asserts `registry.exec_tier(crit)` (registry.py:604) 'returns \"CONTAINER\" for G3/G4', but exec_tier (registry.py:604-610) only ever returns \"AGENT\", \"2-STEP\", or \"1-TURN\" — never \"CONTAINER\". G3/G4 are members of AGENT_TIER, so exec_tier returns \"AGENT\" for them; the container fan-out is separated downstream by run_pass1/_resolve_criteria (production_batch_runner.py:203 states the container criteria G3/G4 are pulled out of `agent` by run_pass1 itself), not by exec_tier returning a CONTAINER value.","group_criteria":null,"group_id":null,"id":"f16542b969ede2ef9","impact":1.0,"is_primary":null,"location":"Context / Problem, 'Execution tier is per-criterion' paragraph","norm_id":"ne932fe2935490115","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Single-criterion mode with --criteria G3/G4: the harness routes container fan-out based on the wrong belief that exec_tier signals CONTAINER, so a wrong dispatch/pricing branch is written."],"severity":"critical","suggested_fix":"Rewrite the premise to: `exec_tier(crit)` returns \"AGENT\" for AGENT_TIER ids (including G3/G4); the container fan-out for G3/G4 is separated by run_pass1/_resolve_criteria after exec_tier, not by an exec_tier \"CONTAINER\" return.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"Update the quoted AGENT_TIER set to match registry.py:97-116 (add G7, T1, T3, T8, asserted-capability, evidence-kind, decomp-shape) so the cost model and tier-based AC use the correct agent-tier membership.","cohort":["E4"],"criteria":["E4"],"decision":"block","decision_margin":0.25,"drop_reason":null,"evidence":["Plan: 'AGENT_TIER (`{\"G1G2\",\"E4\",\"A1\",\"G6\",\"T5c\",\"T10\",\"T11\",\"G3\",\"G4\"}`, registry.py:97)'","registry.py:97-116: AGENT_TIER = {G1G2, E4, A1, G6, G3, G4, G7, T1, T3, T5c, T8, T10, T11, asserted-capability, evidence-kind, decomp-shape}"],"finding":"The plan states `AGENT_TIER` = `{\"G1G2\",\"E4\",\"A1\",\"G6\",\"T5c\",\"T10\",\"T11\",\"G3\",\"G4\"}` (registry.py:97), but the actual frozenset (registry.py:97-116) also contains G7, T1, T3, T8, asserted-capability, evidence-kind, and decomp-shape. The quoted set understates which criteria dispatch agentically.","group_criteria":null,"group_id":null,"id":"f5de67a46f37b522f","impact":1.0,"is_primary":null,"location":"Context / Problem, 'Execution tier is per-criterion' paragraph","norm_id":"ne8ac6ff62e8274b4","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Single-criterion mode with --criteria T8 (or G7/T1/T3): the plan's naive cost model would treat it as a cheap single-turn chunk, but it is AGENT-tier and incurs the ~85× agentic cost, blowing the per-sample ceiling used in AC 3."],"severity":"critical","suggested_fix":"Replace the quoted set with the full registry.py:97-116 membership, or reference it symbolically as 'the AGENT_TIER frozenset (registry.py:97)' without an inline enumeration that drifts.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the exec_tier description: it returns AGENT/2-STEP/1-TURN (never \"CONTAINER\"); state that G3/G4 container fan-out is pulled from the agent bucket by run_pass1/_resolve_criteria, and route tier2 container criteria accordingly.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan: 'registry.exec_tier(crit) (registry.py:604) returns \"AGENT\" ... or \"CONTAINER\" for G3/G4'","registry.py:605-610: docstring 'here we return one of AGENT / 2-STEP / 1-TURN'; no \"CONTAINER\" return","production_batch_runner.py:202-204: '_resolve_criteria splits into (single, agent) by exec_tier == \"AGENT\" (the container criteria G3/G4 are pulled out of agent by run_pass1 itself)'"],"finding":"The plan misstates registry.exec_tier's return contract: it says exec_tier(crit) returns \"CONTAINER\" for G3/G4, but exec_tier (registry.py:604-610) only ever returns \"AGENT\"/\"2-STEP\"/\"1-TURN\" — the container fan-out is pulled out of the agent bucket by run_pass1/_resolve_criteria (production_batch_runner.py:202-204), never signalled by an exec_tier==\"CONTAINER\" value. The single-criterion dispatch design references this contract.","group_criteria":null,"group_id":null,"id":"fff2c9f55dfc63ba9","impact":1.0,"is_primary":null,"location":"Context / Problem, 'Execution tier is per-criterion' paragraph","norm_id":"nb1cbefdbd534d93b","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer routes G3/G4 in tier2 single-criterion mode by matching exec_tier(desc)==\"CONTAINER\", which never fires, so container criteria fall into the AGENT bucket unhandled."],"severity":"critical","suggested_fix":"Replace 'or \"CONTAINER\" for G3/G4 (container fan-out via pass1_container)' with 'AGENT for G3/G4 too; run_pass1/_resolve_criteria then pulls G3/G4 out of the agent bucket into pass1_container'.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Update the AGENT_TIER enumeration to match registry.py:97-116 (add G7, T1, T3, T8, asserted-capability, evidence-kind, decomp-shape) or reference it symbolically rather than transcribing a stale subset.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan: 'AGENT_TIER ({\"G1G2\",\"E4\",\"A1\",\"G6\",\"T5c\",\"T10\",\"T11\",\"G3\",\"G4\"}, registry.py:97)'","registry.py:98-115 lists: G1G2,E4,A1,G6,G3,G4,G7,T1,T3,T5c,T8,T10,T11,asserted-capability,evidence-kind,decomp-shape"],"finding":"The plan's inline enumeration of AGENT_TIER is incomplete/inaccurate: it lists {\"G1G2\",\"E4\",\"A1\",\"G6\",\"T5c\",\"T10\",\"T11\",\"G3\",\"G4\"} but the actual frozenset (registry.py:97-116) additionally contains G7, T1, T3, T8, asserted-capability, evidence-kind, and decomp-shape.","group_criteria":null,"group_id":null,"id":"f7de5ad210735496d","impact":1.0,"is_primary":null,"location":"Context / Problem, 'Execution tier is per-criterion' paragraph","norm_id":"naf13bccb0b6eb94b","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A reviewer/implementer relying on the plan's set to reason about which --criteria ids dispatch agentically underestimates the agent-tier surface (e.g. treats T8 or G7 single-criterion runs as cheap single-turn)."],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify how the single-criterion mode actually narrows criteria in a DIRECT runner invocation: either populate `req.criteria` with only the target descriptor, or route through the workflow `assemble_criteria` PROBE MODE (workflow_ops.py:254-263) that reads `ctx.inputs['probe_criteria']` — because `probe_criteria` on `BatchRunRequest.with_inputs` is consumed only by `_project_criteria`, not by `_resolve_criteria(req.criteria)`.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["Plan: \"req.with_inputs['probe_criteria'] = {<id>} on a BatchRunRequest, which _resolve_criteria splits into single/agent/skipped via exec_tier automatically\"","production_batch_runner.py:104 `single, agent, skipped = _resolve_criteria(req.criteria)` — operates on req.criteria, not on probe_criteria","production_batch_runner.py:114-118 `_project_criteria(ctx, {...}, req.with_inputs.get('probe_criteria'))` — probe_criteria is consumed ONLY by the PROJECT-criteria fan-in inside the runner, never to filter the built-in req.criteria","workflow_ops.py:254-263 — PROBE MODE that filters built-in criteria to the allowlist lives in the `assemble_criteria` workflow step (reads `ctx.inputs['probe_criteria']`), which a direct ProductionBatchRunner invocation bypasses"],"finding":"The plan's single-criterion dispatch mechanism will not actually restrict the run to one criterion: setting `req.with_inputs['probe_criteria'] = {<id>}` on a BatchRunRequest does not filter `req.criteria` inside ProductionBatchRunner.","group_criteria":null,"group_id":null,"id":"fab00a5d84eb28d6b","impact":1.0,"is_primary":null,"location":"Approach → 'Single-criterion mode'; Context → 'Single-criterion mode uses production_batch_runner's REAL routing'","norm_id":"n65750e6b7522b74a","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["`tier2 --criteria T5c` invoked directly against ProductionBatchRunner runs the FULL routed criteria set (or whatever req.criteria was populated with), not just T5c — inflating cost far beyond the AC's ≤N×$0.25 ceiling and defeating the cheap per-criterion probe premise"],"severity":"critical","suggested_fix":"Set `req.criteria` to the single resolved registry descriptor for `<id>` (the interpreter's probe filtering happens in the assemble step, upstream of the runner); use `probe_criteria` only if Tier-2 drives the full workflow assemble→batch path rather than calling ProductionBatchRunner.run directly.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Correct the tier-resolution description: `exec_tier` returns AGENT / 2-STEP / 1-TURN (no CONTAINER); G3/G4 resolve into the `agent` bucket and the container fan-out is performed by `run_pass1`, not by `_resolve_criteria` — so derive the container split from run_pass1's behavior, not from a CONTAINER exec_tier or a _resolve_criteria container bucket.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["Plan: \"registry.exec_tier(crit) (registry.py:604) returns \\\"AGENT\\\" ... or \\\"CONTAINER\\\" for G3/G4\"","registry.py:604-610 — exec_tier returns one of AGENT / 2-STEP / 1-TURN; there is no 'CONTAINER' return value","production_batch_runner.py:198-248 — `_resolve_criteria` returns (single, agent, skipped); its docstring (202-204): 'the container criteria G3/G4 are pulled out of `agent` by `run_pass1` itself' — i.e. G3/G4 land in the `agent` bucket, and the container split is NOT performed by _resolve_criteria"],"finding":"The plan mis-describes the tier-resolution API: it claims exec_tier returns 'CONTAINER' for G3/G4 and that _resolve_criteria performs 'single/agent/container dispatch', but the code has no CONTAINER tier and _resolve_criteria does not split out containers.","group_criteria":null,"group_id":null,"id":"fb417008b799bed9c","impact":1.0,"is_primary":null,"location":"Context → 'Execution tier is per-criterion'; Approach → 'Single-criterion mode' ('real single/agent/container dispatch')","norm_id":"ne860fcce98c2432a","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer keys Tier-2's cost-tier accounting off a non-existent exec_tier=='CONTAINER' branch, or expects _resolve_criteria to return a container bucket, producing a KeyError/empty container ledger and mis-attributed costs for G3/G4"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the recited AGENT_TIER set to the full registry.py frozenset (add T1, T3, G7, T8, asserted-capability, evidence-kind, decomp-shape) or derive it programmatically, and state that the single-turn cost ceiling applies ONLY to ids whose resolved exec_tier is 1-TURN.","cohort":["T8"],"criteria":["T8"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan states: AGENT_TIER (`{\"G1G2\",\"E4\",\"A1\",\"G6\",\"T5c\",\"T10\",\"T11\",\"G3\",\"G4\"}`, registry.py:97)","Actual registry.py:97-116 frozenset ALSO contains: G7, T1, T3, T8, asserted-capability, evidence-kind, decomp-shape","The plan's cost model ('single-turn criteria cost ≈ $0.17-0.25/sample' vs 'AGENT/CONTAINER-tier criteria cost their real production rate') and AC 'tier2 --criteria <single-turn-id> costs ≤ N × $0.25' depend on this enumeration being complete"],"finding":"The plan's recital of AGENT_TIER at registry.py:97 is stale/incomplete, omitting T1, T3, G7, T8, asserted-capability, evidence-kind, and decomp-shape from the set that governs single-turn-vs-AGENT dispatch.","group_criteria":null,"group_id":null,"id":"f8697f80846cb5f11","impact":1.0,"is_primary":null,"location":"Context / Problem — 'Execution tier is per-criterion' paragraph; AGENT_TIER recital","norm_id":"nfae9cdfa7f49ccab","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["An operator runs `tier2 --criteria T1` (or T3/G7/T8) expecting a $0.17 single-turn chunk; _resolve_criteria routes it to the agent bucket via exec_tier, costing ~85× and blowing the ceiling assumed by the single-turn AC"],"severity":"critical","suggested_fix":"Have the harness read tier membership from `registry.exec_tier(desc)` at runtime (never a hardcoded id list), and phrase the single-turn AC as 'ids resolving to exec_tier==1-TURN' rather than naming a static set.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the exec_tier return-value description (AGENT / 2-STEP / 1-TURN only) and specify that container (G3/G4) separation is done by run_pass1/pass1_container after exec_tier==AGENT, not via a 'CONTAINER' return value.","cohort":["T8"],"criteria":["T8"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan: 'registry.exec_tier(crit) (registry.py:604) returns \"AGENT\" for any id in AGENT_TIER ... or \"CONTAINER\" for G3/G4 (container fan-out via pass1_container)'","registry.py:604-610: exec_tier returns only 'AGENT', '2-STEP', or '1-TURN'; G3/G4 are in AGENT_TIER so exec_tier returns 'AGENT' for them","_resolve_criteria docstring (production_batch_runner.py:203): 'the container criteria G3/G4 are pulled out of `agent` by `run_pass1` itself' — container-ness is decided downstream of exec_tier, not by an exec_tier return value"],"finding":"The plan asserts exec_tier returns \"CONTAINER\", but exec_tier's actual return vocabulary is AGENT / 2-STEP / 1-TURN — 'CONTAINER' is never a value it yields.","group_criteria":null,"group_id":null,"id":"f5f7a8ac5c68b06b2","impact":1.0,"is_primary":null,"location":"Context / Problem — 'registry.exec_tier(crit) (registry.py:604) returns ... or \"CONTAINER\" for G3/G4'","norm_id":"n14ec052a66cd3a5e","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A tier2.py author branches on `exec_tier(desc) == 'CONTAINER'` to route/price container criteria; the branch is dead because exec_tier returns 'AGENT' for G3/G4, so container fan-out is never separated as the ledger's 'reported separately' AC requires"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an acceptance criterion that verifies the budget pre-flight is computed from `coverage.usage.per_criterion` × current price and refuses (or warns) when the estimate exceeds a stated threshold.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5e","T7"],"criteria":["E1"],"decision":"advisory","decision_margin":-0.2357,"drop_reason":null,"evidence":["Approach lists 'Budget pre-flight from stored per-criterion usage (`coverage.usage.per_criterion`) × current price.'","No AC references a pre-flight estimate; AC3/AC4 only check post-hoc ledger spend, not that the pre-flight exists or refuses over-budget runs."],"finding":"The 'Budget pre-flight from stored per-criterion usage × current price' deliverable in Approach has no covering acceptance criterion — no AC verifies the pre-flight is computed or gates a run.","group_criteria":null,"group_id":null,"id":"f8cc5b1778e3f3b23","impact":1.0,"is_primary":null,"location":"Approach (last bullet: 'Budget pre-flight from stored per-criterion usage (coverage.usage.per_criterion) × current price') vs Acceptance Criteria","norm_id":"nb769cfb503d61059","priority":0.7143,"reason":"default-advisory","recalled":false,"scenarios":["A CONTAINER-tier single-criterion run (G3/G4 fan-out) with no fixed ceiling launches without a pre-flight refusal because no AC required the pre-flight to gate it."],"severity":"critical","suggested_fix":"Add AC: 'A run whose pre-flight estimate exceeds the configured budget is refused before any Bedrock call; checked by a unit test with a stubbed usage record.'","tier":"LLM","validity":0.7143,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Specify the fallback for an unresolved --criteria id (fail loudly / non-zero exit) rather than inheriting _resolve_criteria's silent 'skipped' drop.","cohort":["T8"],"criteria":["T8"],"decision":"advisory","decision_margin":-0.075,"drop_reason":null,"evidence":["production_batch_runner.py:236-243: `desc = by_id.get(cid); if desc is None: skipped.append(cid); logger.warning(...)` — unknown ids are silently dropped, never fatal","Plan sets `probe_criteria={\"T5c\"}` and relies on _resolve_criteria's split, but specifies no behavior for the 'skipped' return value it inherits","ABSENCE: no plan text handles a misspelled/retired --criteria id"],"finding":"The single-criterion mode specifies no fallback when --criteria names an id absent from the registry: _resolve_criteria drops it into the logged-and-ignored 'skipped' bucket, producing an empty run that vacuously satisfies the cost/finding ACs.","group_criteria":null,"group_id":null,"id":"f369082c4525094d1","impact":1.0,"is_primary":null,"location":"Approach — 'Single-criterion mode' bullet; AC 'tier2 --criteria <single-turn-id>'","norm_id":"nef5b3752194e8c99","priority":0.625,"reason":"default-advisory","recalled":false,"scenarios":["Operator runs `tier2 --criteria T5C` (wrong case) or a renamed id; the run resolves to zero criteria, emits no findings, and the ledger shows $0 — appearing to PASS the cost AC while measuring nothing"],"severity":"critical","suggested_fix":"After building the request, assert the requested id appears in `single ∪ agent`; if it is in `skipped` (or produced no resolved criterion), abort with a clear error before spending.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a live acceptance check that a single-criterion `--criteria T5c` (AGENT-tier) run dispatches agentically through the real production_batch_runner against Bedrock Opus and is priced/ledgered at its real production rate, not just the full-mode baseline.","cohort":["E3","E5","F4","G5","T5b","T6","T9","necessity","project.portability"],"criteria":["E5"],"decision":"advisory","decision_margin":-0.4687,"drop_reason":null,"evidence":["Live coverage named is 'one full-mode baseline over the fixed sample' — full mode only.","The AGENT-tier single-criterion behavior is only asserted offline: 'single-criterion mode for an AGENT-tier id (e.g. T5c) dispatches agentically via production_batch_runner and is NOT forced single-turn' via a FakeRunner.","AC line 'An AGENT/CONTAINER-tier --criteria run is priced at its real production rate and reported separately' has no live check that this pricing/dispatch actually holds against the real boundary."],"finding":"Single-criterion mode is the headline capability and the mode with the most novel cost/dispatch behavior (AGENT-tier `T5c` runs agentically at its real production rate), yet it has only offline FakeRunner dispatch-shape tests; the only live acceptance criterion exercises full mode. No live/end-to-end acceptance validates that a `--criteria T5c` single-criterion run actually dispatches agentically through the real production_batch_runner against Bedrock Opus and is priced/ledgered correctly.","group_criteria":null,"group_id":null,"id":"f4af5dd12beea4aa7","impact":0.55,"is_primary":null,"location":"Testing (Live: 'one full-mode baseline over the fixed sample') and Acceptance Criteria (AGENT/CONTAINER-tier --criteria run)","norm_id":"n263a3ce97e0c058b","priority":0.4813,"reason":"default-advisory","recalled":false,"scenarios":["The single-criterion AGENT-tier dispatch/pricing works in the FakeRunner but the real production_batch_runner resolves T5c differently against live Opus; the offline suite is green while the real single-criterion path is broken or mispriced."],"severity":"major","suggested_fix":"","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Define the sample lifecycle: how/when `tier2-sample.json` is regenerated (redraw trigger on corpus/strata drift), what happens when a committed id no longer resolves, and a retention/cleanup policy for accumulated ledger baseline records.","cohort":["E3","E5","F4","G5","T5b","T6","T9","necessity","project.portability"],"criteria":["T9"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'~20 review ids drawn once by the Tier-1 stratified sampler … committed as docs/experiments/plan-review-gate/replay/tier2-sample.json' — creation is defined; retirement/refresh is not.","'a one-time baseline run recorded in the ledger' — the ledger accumulates baseline records over time with no stated retention/cleanup.","Absence: no consumer-staleness handling if a committed sample id no longer resolves in the store, and no defined trigger to redraw the sample when strata assumptions change."],"finding":"The committed `tier2-sample.json` is fixed shared state whose retire/refresh path is unspecified: the plan says it is 'drawn once' and 'committed', but not how or when it is regenerated when the corpus/strata drift (e.g. new stores, changed finding counts), nor how the ledger's baseline records are bounded rather than accumulating indefinitely.","group_criteria":null,"group_id":null,"id":"f941497ace566f646","impact":0.0,"is_primary":null,"location":"Approach → 'Fixed sample: ~20 review ids drawn once by the Tier-1 stratified sampler … committed as docs/.../tier2-sample.json' and baseline-in-ledger","norm_id":"ne60ebdcab272aada","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["A sampled review id is later purged from the store; a Tier-2 run reads the committed sample and fails or silently skips, with no defined refresh path.","Corpus grows and the fixed strata (≥5 containers, ≥8 with ≥10 findings) no longer represent the population, but nothing signals the sample is stale."],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the failure/durability behavior for a budgeted multi-sample Bedrock run: retry/backoff on transient errors, per-sample checkpointing so a failed run can resume without re-spending, and a mid-run budget stop when the ledger approaches the cap.","cohort":["E3","E5","F4","G5","T5b","T6","T9","necessity","project.portability"],"criteria":["T5b"],"decision":"advisory","decision_margin":-0.95,"drop_reason":"novelty","evidence":["The plan adds LLM calls (Opus via Bedrock) and file I/O — the reliability overlay applies.","'Budget pre-flight from stored per-criterion usage (`coverage.usage.per_criterion`) × current price.' — a pre-flight estimate, but no mid-run enforcement or overrun/failure behavior is stated.","Absence: no mention of retry/backoff, per-sample checkpointing, or resume-on-failure; a failure at sample 15 of 20 could force re-spend of the whole batch under a $60 commissioning cap."],"finding":"The plan runs ~20 samples through an expensive Bedrock Opus frontier model under a budget, but specifies no error-handling or partial-run durability for mid-run failures: no retry/backoff on Bedrock call failures, no statement of what happens when the budget pre-flight is wrong and spend is exceeded mid-run, and no resume/idempotency so a failed run doesn't re-spend on already-completed samples.","group_criteria":null,"group_id":null,"id":"f1369d42f641a69a4","impact":0.0,"is_primary":null,"location":"Approach → 'Budget pre-flight from stored per-criterion usage × current price' and Full/Single-criterion mode","norm_id":"n0e409655bc1a2418","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["A Bedrock throttle/transient error mid-run aborts the sweep; without checkpointing the operator re-runs from scratch and re-spends against the ≤$60 cap.","Pre-flight under-estimates cost; without a mid-run budget stop the run silently exceeds the ledger ceiling."],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_reveal