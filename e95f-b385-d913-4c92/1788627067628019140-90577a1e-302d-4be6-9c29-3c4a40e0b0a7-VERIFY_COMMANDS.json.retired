363,366],[416,424],[445,448],[472,487],[523,533],[545,555],[567,573],[600,606],[623,640],[673,683],[698,706],[716,721],[726,730],[740,748],[766,769],[777,785],[13,15],[38,42],[91,96],[108,114],[196,202],[251,270],[273,283],[488,492],[496,499]],\"src/rebar/mcp_server.py\":[[382,388],[426,436],[644,661],[55,66],[359,366],[393,397],[511,515],[545,559],[567,573],[611,623],[676,679],[711,713]],\"src/rebar/mirror_guard.py\":[[58,65],[85,91],[204,210]],\"src/rebar/secret_screen.py\":[[1,34],[121,126],[148,153],[179,186],[194,201],[218,223],[53,55],[58,72],[92,100]],\"src/rebar/signing.py\":[[1,22],[127,145],[171,176],[247,252],[282,291],[301,305],[313,324],[336,339],[395,405],[69,73],[111,114]]}\nPFX = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in DOCS[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                visit(child, f\"{prefix}.{child.name}\" if prefix else child.name)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(src):\n    lines = src.splitlines()\n    out = []\n    for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n        if tok.type == tokenize.COMMENT:\n            body = tok.string[1:].lstrip().lower()\n            if tok.string.startswith(\"#!\") or any(body.startswith(p) for p in PFX):\n                out.append(lines[tok.start[0] - 1])\n    return out\nfor path in DOCS:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(before) == directives(final), (\"directive/shebang drift\", path)\ndiff = subprocess.check_output([\"git\", \"diff\", \"--unified=0\", B, \"--\", *SPANS], text=True)\ncurrent = None\nfor line in diff.splitlines():\n    if line.startswith(\"+++ b/\"):\n        current = line[6:]\n    match = re.match(r\"^@@ -(\\d+)(?:,(\\d+))? \\+\\d+(?:,\\d+)? @@\", line)\n    if match:\n        start = int(match.group(1))\n        count = int(match.group(2) or \"1\")\n        allowed = SPANS[current]\n        if count:\n            assert all(any(lo <= n <= hi for lo, hi in allowed) for n in range(start, start + count)), (\"hunk outside allowlist\", current, start, count)\n        else:\n            assert any(lo <= start <= hi or lo <= start + 1 <= hi for lo, hi in allowed), (\"insertion outside allowlist\", current, start)\n'","dd_id":"immutable-prose-only","dd_text":"Only exact allowlisted prose changes: immutable-base runtime/non-comment structure and protected directives remain exact, and zero-context hunks stay inside base spans."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess\nexpected = set([\"src/rebar/_mcp_serving.py\",\"src/rebar/_mcp_writes.py\",\"src/rebar/_opcert_signing.py\",\"src/rebar/_opcert_verify.py\",\"src/rebar/_operation_config.py\",\"src/rebar/_proc.py\",\"src/rebar/config.py\",\"src/rebar/mcp_server.py\",\"src/rebar/mirror_guard.py\",\"src/rebar/secret_screen.py\",\"src/rebar/signing.py\"])\nactual = set(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\"], text=True).splitlines())\nassert actual == expected, {\"expected\": sorted(expected), \"actual\": sorted(actual)}\n'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/unit/test_mcp*.py tests/unit/test_opcert*.py tests/unit/test_*signing*.py tests/unit/test_secret_screen_e7a9.py tests/unit/test_config*.py tests/unit/test_operation_config_source_kinds.py tests/unit/test_mirror_guard.py tests/interfaces/facades/test_mcp*.py tests/interfaces/lifecycle/test_attested_signing.py","dd_id":"focused-contracts","dd_text":"Focused tests and build checks for every preserved subsystem consumer pass."},{"command":"rtk git diff --check HEAD^..HEAD -- src/rebar/_mcp_serving.py src/rebar/_mcp_writes.py src/rebar/_opcert_signing.py src/rebar/_opcert_verify.py src/rebar/_operation_config.py src/rebar/_proc.py src/rebar/config.py src/rebar/mcp_server.py src/rebar/mirror_guard.py src/rebar/secret_screen.py src/rebar/signing.py","dd_id":"diff-integrity","dd_text":"The path-scoped patch contains no whitespace errors."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"The complete local CI contract passes in the worktree virtualenv; do not apply a timeout."}]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"VERIFY_COMMANDS","timestamp":1788627067628019140,"uuid":"90577a1e-302d-4be6-9c29-3c4a40e0b0a7"}