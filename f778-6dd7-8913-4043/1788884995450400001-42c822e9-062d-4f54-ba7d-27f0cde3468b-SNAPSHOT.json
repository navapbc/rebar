{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788884995450400001,"compiled_state":{"alias":"unaware-subwealthy-pintail","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"d09bfdc154fe825ab0f8865c78f4f2c4f70c4590","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: f778-6dd7-8913-4043","material: 9ad8f32d22840003","material-part: children 647ea2107ca5072f 0","material-part: description 35a8fbbc57276c6b 5284","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact af2d582ce74f0bf1 9","material-part: ticket_id bfd13648be28587e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 7","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1 (d09bfdc154fe8)","regver: aa61189569d34126","verified-at-sha:665d1d0480187380f82e59bd95af1f0c44274732","dep dd2e36675fdfe7f17c35f0380d93120dd9a3b6037632b7d70f2112c6cbf8985c src/rebar/_engine/rebar_reconciler/binding_walk.py","dep 7cef27bc53ff48dff2c8025e228878f7caed0569e7986e2c197a7e5f20a08505 src/rebar/_engine/rebar_reconciler/differ.py","dep bfefcd7d9bcfb15214e3ab7484cbb31158f60d388c8705fd22d6255a83a35d9a src/rebar/_engine/rebar_reconciler/fetch_paging.py","dep 23547643662f33c70d94161ac46a0c555bb65d69591d449996a8c57fc0879198 src/rebar/_engine/rebar_reconciler/fetcher.py","dep 0a1a7ee69b37f87fa975cfd659d00d3d3c2b2ca635ae842f0d3627b550658869 src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py","dep 8af836328b34c9a7df83affeca51a902f7767ecf3fcdf14159ad1f3fd6f8c863 src/rebar/_engine/rebar_reconciler/reconcile_hel