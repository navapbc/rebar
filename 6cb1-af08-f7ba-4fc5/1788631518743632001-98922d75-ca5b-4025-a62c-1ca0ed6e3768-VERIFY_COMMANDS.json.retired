ed_primary_never_leaves_the_operator_model\\\",\\\"runner = _ModelRecordingRunner\\\"]]},\\\"tests/unit/test_predates_gate_guard_parity.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_project_default_provider.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_clean_checkout_resolves_the_bare_cfg_model_to_bedrock_too\\\",\\\"test_project_default_ids_are_byte_equal_to_the_bedrock_overlay\\\"],\\\"comments\\\":[[\\\"test_clean_checkout_resolves_the_bare_cfg_model_to_bedrock_too\\\",\\\"model = LLMConfig.from_env\\\"]]},\\\"tests/unit/test_project_failure_disposition_contract.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_prompt_model_module_seam.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_prompt_repo_root_seam.py\\\":{\\\"docs\\\":[\\\"<module>\\\"],\\\"comments\\\":[]},\\\"tests/unit/test_provider_credentials_hermeticity.py\\\":{\\\"docs\\\":[\\\"<module>\\\",\\\"test_unit_tier_isolates_aws_credential_resolution_from_real_home\\\"],\\\"comments\\\":[]}}\")\nSCOPES=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\ndef source(ref,path):\n    return subprocess.check_output([\"git\",\"show\",ref+\":\"+path],text=True)\ndef normalize(raw,path,require_all):\n    tree=ast.parse(raw,type_comments=True); seen=set(); allowed=set(ALLOWED[path][\"docs\"])\n    def visit(node,owner):\n        if isinstance(node,ast.TypeIgnore):\n            node.lineno=0\n        if isinstance(node,SCOPES):\n            body=node.body\n            if owner in allowed and body and isinstance(body[0],ast.Expr) and isinstance(body[0].value,ast.Constant) and isinstance(body[0].value.value,str):\n                node.body=body[1:]; seen.add(owner)\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                visit(child,name)\n            else:\n                visit(child,owner)\n    visit(tree,\"<module>\")\n    if require_all and seen!=allowed:\n        raise SystemExit(\"missing immutable docstring allowlist: \"+path+\" \"+repr(sorted(allowed-seen)))\n    if not seen<=allowed:\n        raise SystemExit(\"unexpected stripped docstring: \"+path)\n    return ast.dump(tree,include_attributes=False)\ndef comment_state(raw,path):\n    tree=ast.parse(raw,type_comments=True); lines=raw.splitlines(); scopes=[(\"<module>\",1,len(lines))]\n    def walk(node,owner):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):\n                name=child.name if owner==\"<module>\" else owner+\".\"+child.name\n                scopes.append((name,child.lineno,child.end_lineno or child.lineno)); walk(child,name)\n            else:\n                walk(child,owner)\n    walk(tree,\"<module>\"); full={}; inline=[]\n    for tok in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if tok.type!=tokenize.COMMENT:\n            continue\n        row,col=tok.start; left=lines[row-1][:col].rstrip()\n        if left:\n            inline.append((tok.string,left.strip()))\n        else:\n            full[row]=tok.string\n    regions=[]; i=1\n    while i<=len(lines):\n        if i not in full:\n            i+=1; continue\n        comments=[]\n        while i<=len(lines) and (i in full or not lines[i-1].strip()):\n            if i in full:\n                comments.append((i,full[i]))\n            i+=1\n        owner=min((s for s in scopes if s[1]<=comments[0][0]<=s[2]),key=lambda s:s[2]-s[1])[0]\n        while i<=len(lines) and lines[i-1].lstrip().startswith(\"@\"):\n            i+=1\n        anchor=\"<EOF>\" if i>len(lines) else lines[i-1].strip()\n        regions.append((owner,anchor,\"\\n\".join(text for _,text in comments)))\n    rules=ALLOWED[path][\"comments\"]\n    for scope,prefix in rules:\n        if sum(owner==scope and anchor.startswith(prefix) for owner,anchor,_ in regions)>1:\n            raise SystemExit(\"ambiguous comment stable id: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    protected=[r for r in regions if not any(r[0]==scope and r[1].startswith(prefix) for scope,prefix in rules)]\n    return inline,protected,regions\nfor path in sys.argv[1:]:\n    before=source(BASE,path); after=source(\"HEAD\",path)\n    if normalize(before,path,True)!=normalize(after,path,False):\n        raise SystemExit(\"normalized AST changed: \"+path)\n    bi,bp,br=comment_state(before,path); ai,ap,ar=comment_state(after,path)\n    for scope,prefix in ALLOWED[path][\"comments\"]:\n        if sum(o==scope and a.startswith(prefix) for o,a,_ in br)!=1:\n            raise SystemExit(\"missing immutable comment allowlist: \"+path+\"#C:\"+scope+\":before:\"+prefix)\n    if bi!=ai:\n        raise SystemExit(\"inline comment changed: \"+path)\n    if bp!=ap:\n        raise SystemExit(\"non-allowlisted full-line comment changed: \"+path)\n' tests/unit/test_plan_review_evals.py tests/unit/test_plan_review_explain.py tests/unit/test_plan_review_generation_scope.py tests/unit/test_plan_review_retry.py tests/unit/test_plan_review_reuse_replay.py tests/unit/test_plan_review_reuse_type.py tests/unit/test_plan_review_reuse.py tests/unit/test_plan_review_rising_floor.py tests/unit/test_plan_review_type_partition.py tests/unit/test_plan_review_workflow_ops_seam.py tests/unit/test_plan_review_xcheck.py tests/unit/test_plan_review.py tests/unit/test_predates_gate_guard_parity.py tests/unit/test_project_default_provider.py tests/unit/test_project_failure_disposition_contract.py tests/unit/test_prompt_model_module_seam.py tests/unit/test_prompt_repo_root_seam.py tests/unit/test_provider_credentials_hermeticity.py","dd_id":"semantic","dd_text":"Immutable/final Python parses; only allowlisted leading docstrings and full-line comment regions may differ; normalized runtime ASTs match."},{"command":"rtk p