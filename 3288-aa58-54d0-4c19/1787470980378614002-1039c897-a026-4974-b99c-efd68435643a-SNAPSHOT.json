{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787470980378614002,"compiled_state":{"alias":"dandruffy-insolent-goosefish","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"051e920b3b9cb5eca52064be39e55409e5dfc91b","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 3288-aa58-54d0-4c19","material: f38391beff8f7fb8","material-part: children 647ea2107ca5072f 0","material-part: description b10f269ae62dc98e 5770","material-part: description_boxes 2481a63c85a62cf8 4","material-part: file_impact 324babc27974ce75 4","material-part: ticket_id 180e53a0d658ab13 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.12.0 (051e920b3b9-dirty)","regver: aa61189569d34126","verified-at-sha:4b6f0cfca402bec87b93cd54cd90c51b4b71fa35","dep ad39c6a238c4dd7ddf1465ff7a793bd2329c1a5e9ca00841833231cb51610e3a src/rebar/_engine/rebar_reconciler/access_check.py","dep f8a41aa780c9a905ef263ba0aae53e88f0284e4e9077097c6e1ac208e5728af9 src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","dep 6664008a343c1be2f804c44bb3fb99f3a598ac523aaa7066fc27e6b2a3ed1662 tests/integration/test_reconcile_live_e2e.py","dep 81b3c7243ee68789c0bc110c42e052fc2386bd67a59254b9769d3063f995642a tests/unit/rebar_reconciler/test_acli_search_cache_freshness.py","read-set: 13","read-path: src/rebar/_engine/rebar_reconciler/__main__.py","read-path: src/rebar/_engine/rebar_reconciler/_backend_registry.py","read-path: src/rebar/_engine/rebar_reconciler/access_check.py","read-path: src/rebar/_engine/rebar_reco