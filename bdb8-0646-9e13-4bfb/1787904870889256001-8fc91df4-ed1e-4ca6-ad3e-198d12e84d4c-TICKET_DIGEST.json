{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"d1f85d96b1c5a8656350efead33c7527ca19d0712b0ce654985ec086a80318c5","digest":{"component_or_area":"JiraConfig validation and credential security","key_entities":["JiraConfig","ReconcilerConfig","_validate_reconciler_tls","_validate_https_url","InsecureUrlError","jira.url","jira.allow_insecure","REBAR_JIRA_ALLOW_INSECURE","resolve_jira_settings","write_jira_config","src/rebar/_config_schema.py","src/rebar/config.py","src/rebar/adapters/jira/acli_subprocess.py"],"problem_keywords":["insecure url","cleartext credential exposure","https validation","jira config"],"propositions":["JiraConfig accepts non-https jira.url without validation, risking API token/basic-auth exposure in cleartext transit","Three config consumers (resolve_jira_settings, _jira_onboard._detect, write_jira_config) silently swallow ConfigError, allowing cleartext urls to bypass validation and persist","DC's ReconcilerConfig enforces https-only via __post_init__ and _validate_reconciler_tls; Cloud's JiraConfig lacks equivalent validation and __post_init__ method","write_jira_config persists jira.url without scheme validation, enabling the onboarding wizard to silently write cleartext urls to config","A shared _validate_https_url validator with allow_insecure override (defaulting false) must be introduced and applied uniformly to both JiraConfig and the config write path to achieve parity with DC"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787904870889256001,"uuid":"8fc91df4-ed1e-4ca6-ad3e-198d12e84d4c"}