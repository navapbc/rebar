ria":null,"group_id":null,"id":"f69805568e68a852b","impact":1.0,"is_primary":null,"location":"Approach — 'Freshness' and 'Catch-up is synchronous and read-phase'","norm_id":"nf03a5b862b27ab2e","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A second create must surface the ticket created by the first create in the same process/clone; if catch-up only re-hashes dirs it already knows, a brand-new ticket dir created between index-build and this query is never enumerated and never indexed"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State that the newly created ticket's own id is excluded from its `similar_tickets` results, and whether this is enforced by querying before indexing it or by filtering the query id out.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e","T7"],"criteria":["E2"],"decision":"advisory","decision_margin":-0.0975,"drop_reason":null,"evidence":["'Before serving a query, the index reconciles any tickets whose dir hash has changed since it was last built, then answers'","'Query is the new ticket's title plus the first 200 characters of its description'","Absence: no rule excluding the query ticket's own id from results"],"finding":"The plan does not state whether the just-created ticket is excluded from its own `similar_tickets` candidate set. Since catch-up indexes new tickets and the query is the new ticket's own title+description, a naive implementation would return the ticket as its own top match.","group_criteria":null,"group_id":null,"id":"f9f0a6cc72d166054","impact":0.67,"is_primary":null,"location":"Approach 'Catch-up is synchronous and read-phase' + 'Retrieval'","norm_id":"na06f33f426a54c05","priority":0.5025,"reason":"default-advisory","recalled":false,"scenarios":["A create whose ticket is already indexed by catch-up returns itself as the #1 similar ticket, wasting one of the 5 slots and confusing the agent"],"severity":null,"suggested_fix":"Add to the Approach: 'The query ticket's own id is excluded from candidates (filtered from results), so a create never surfaces itself.'","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"easy","silent_vs_self_rev