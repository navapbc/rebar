cket exists to prevent.","group_criteria":null,"group_id":null,"id":"fbbb9d6f5942f3041","impact":0.0,"is_primary":null,"location":"Approach part 2 / Testing 'Failure path'","norm_id":"n332a1a0f3246adf8","priority":0.0,"reason":"default-advisory","scenarios":["Signing key rotates or secret is missing; every 6-hourly run fails to push; nobody notices until logs are huge again","origin/tickets moves faster than the retry loop can merge; sweeps never converge and no one is paged"],"severity":"none","suggested_fix":"Add a line noting that a failed sweep surfaces via GitHub Actions' scheduled-workflow failure notifications (and reference that the reconciler relies on the same), or specify an explicit alert step.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"Specify a timeout-minutes ceiling and a concurrency group (cancel-in-progress: false) for the compact-sweep workflow, mirroring the reconciler.","cohort":["T10"],"criteria":["T10"],"decision":"dropped","decision_margin":-0.9,"drop_reason":null,"evidence":["reconcile-bridge.yml:54-56 (c