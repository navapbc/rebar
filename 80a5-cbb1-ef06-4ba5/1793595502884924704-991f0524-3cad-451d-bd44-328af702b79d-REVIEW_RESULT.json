milar_tickets into — and run retrieval for — identity and session_log creates.","group_criteria":null,"group_id":null,"id":"fa8ebf20ba9d0a2c8","impact":1.0,"is_primary":null,"location":"Approach → 'The advisory seam, and why a per-site fix is the wrong one'; src/rebar/_commands/composer.py:93 (create_core)","norm_id":"n4e954106ed2b06c3","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["rebar create-identity: the identity result dict gains an unexpected similar_tickets field","session-log genesis create: similar-ticket retrieval runs on a session_log create that no AC covers"],"severity":null,"suggested_fix":"Either (a) scope the similar_tickets computation to the create and idea entry points (not inside create_core) so identity/session_log are unaffected, or (b) explicitly acknowledge identity and session_log as in-scope consumers of the generic create_core seam and add coverage for their changed result shape.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Cla