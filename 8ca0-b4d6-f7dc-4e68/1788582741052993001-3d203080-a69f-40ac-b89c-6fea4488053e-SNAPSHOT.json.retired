fc-458b-9057-241b4991b69f","relation":"supersedes","target_id":"1106-236f-0d5b-4e3d"},{"link_uuid":"ec4386b2-5e06-4781-a02b-1fee271eceb0","relation":"supersedes","target_id":"19aa-b5de-627a-48d2"},{"link_uuid":"9f0027fa-2b9e-4669-8cd6-2396ca91e4cb","relation":"supersedes","target_id":"7a25-0543-2218-45c3"},{"link_uuid":"6d117297-b0c8-42e6-9a10-a76dfb300b53","relation":"supersedes","target_id":"47c1-0f36-ff18-4ce8"},{"link_uuid":"4220e82b-0c1d-4797-9d57-f9ed65cfb36b","relation":"supersedes","target_id":"b406-81cf-42cf-46f3"},{"link_uuid":"bee97d9b-4bb1-40bf-9e0c-830cda2212c0","relation":"supersedes","target_id":"3020-167d-b2f9-45b5"},{"link_uuid":"e207109c-d17f-49c2-a4e3-576d32ed215a","relation":"supersedes","target_id":"4a7a-eb5f-bac9-425d"},{"link_uuid":"2b3b3344-b3ab-4618-a0f2-fd6748db0ca1","relation":"supersedes","target_id":"27fa-9a47-0ea1-470a"},{"link_uuid":"5fc4c6ed-1789-4e75-806e-75189c884616","relation":"supersedes","target_id":"eaec-03fa-ba3a-40f5"},{"link_uuid":"9dad1a31-be7b-4602-8b7e-837303ae3e20","relation":"supersedes","target_id":"d07f-34ff-e5ef-405e"}],"description":"## Context / Problem\nThe tests/integration/rebar_reconciler cohort contains audited comments or docstrings that obscure current behavior with repetition, obvious narration, duplicated explanation, or historical detail. The audit is pinned to `9e65567b79ffe872534c3c656ade7b34340d8192`.\n\n## Approach\nEdit explanatory text only in this directory/subsystem cohort. Condense it to current, non-obvious rationale and constraints; retain every file-specific preserve item and consumer contract below. Grouping adjacent files from one subsystem keeps the change reviewable in one session and permits one coherent verification pass without changing executable behavior.\n\n## Scope\n- `tests/integration/rebar_reconciler/conftest.py:29-43` — Preserve required project value, override behavior, and cleanup. Consumer: none found.\n- `tests/integration/rebar_reconciler/jira_contract/_fakes.py:1-19, 33-40, 68-75` — Preserve verbatim captured shapes, deep-copy isolation, matching signatures, and production injection seam. Consumer: none found.\n- `tests/integration/rebar_reconciler/jira_contract/test_jira_fixtures.py:1-19, 86-92` — Preserve complementary secret scrub and top-level-parent presence/falsy oracle. Consumer: none found.\n- `tests/integration/rebar_reconciler/jira_contract/test_roundtrip.py:1-23` — Preserve production-path bidirectional comment/link/parent round trip. Consumer: none found.\n- `tests/integration/rebar_reconciler/jira_contract/test_snapshot_contract.py:1-20, 133-140, 192-200` — Preserve producer-consumer shape contract and discriminating nested-comment/link/parent oracles. Consumer: none found.\n- `tests/integration/rebar_reconciler/jira_contract/test_verified_fake_contract.py:1-23, 57-61` — Preserve shared-contract execution and deliberately divergent-fake negative control. Consumer: none found.\n- `tests/integration/rebar_reconciler/test_leaves_invocable.py:1-7, 35-45` — Preserve distinction between linkage and observable invocability. Consumer: none found.\n- `tests/integration/rebar_reconciler/test_link_sync.py:1-29, 122-131, 165-179` — Preserve desired outbound/inbound relation contracts and representative Jira shape. Consumer: none found.\n- `tests/integration/rebar_reconciler/test_post_deletion_linkage.py:1-11, 30-36, 63-71` — Preserve exact surviving leaf registry and linkage-versus-invocability scope. Consumer: none found.\n- `tests/integration/rebar_reconciler/test_reconcile_idempotency.py:1-19, 357-370, 493-496` — Preserve non-vacuous git-backed setup, lifecycle clock injection, and two-pass zero-write oracle. Consumer: none found.\n- `tests/integration/rebar_reconciler/test_reconcile_roundtrip.py:1-31, 84-90, 207-214, 246-261, 537-543, 561-566` — Preserve chained fixed-point purpose, ADF truncation protection, link direction, and no-churn/no-echo outcomes. Consumer: none found.\n\n## Acceptance Criteria\n- [ ] Every listed location contains only current, non-obvious rationale or constraints after remediation; verified by reviewing the final diff against every Scope row.\n- [ ] Every preserve item and consumer contract in Scope remains explicit and accurate; verified by a row-by-row completion comment and the commands under Verification.\n- [ ] No executable behavior or test assertion changes; verified by the commands under Verification exiting 0.\n\n## Verification\n- `env PATH=\"$PWD/.venv/bin:$PATH\" make lint`\n- `env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py`\n- `env PATH=\"$PWD/.venv/bin:$PATH\" pytest --collect-only tests/integration/rebar_reconciler/conftest.py tests/integration/rebar_reconciler/jira_contract/_fakes.py tests/integration/rebar_reconciler/jira_contract/test_jira_fixtures.py tests/integration/rebar_reconciler/jira_contract/test_roundtrip.py tests/integration/rebar_reconciler/jira_contract/test_snapshot_contract.py tests/integration/rebar_reconciler/jira_contract/test_verified_fake_contract.py tests/integration/rebar_reconciler/test_leaves_invocable.py tests/integration/rebar_reconciler/test_link_sync.py tests/integration/rebar_reconciler/test_post_deletion_linkage.py tests/integration/rebar_reconciler/test_reconcile_idempotency.py tests/integration/rebar_reconciler/test_reconcile_roundtrip.py`\n\nThe row-by-row diff review is authoritative for prose quality; the hygiene guard detects only its narrow deterministic history-token rule.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"tests/integration/rebar_reconciler/conftest.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/jira_contract/_fakes.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/jira_contract/test_jira_fixtures.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/jira_contract/test_roundtrip.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/jira_contract/test_snapshot_contract.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/jira_contract/test_verified_fake_contract.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/test_leaves_invocable.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/test_link_sync.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/test_post_deletion_linkage.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/test_reconcile_idempotency.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"tests/integration/rebar_reconciler/test_reconcile_roundtrip.py","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","2d43-3c39-307e-4450"]],"no_file_impact_reason":"","parent_id":"2d43-3c39-307e-4450","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"8ca0-b4d6-f7dc-4e68","ticket_type":"task","title":"Condense comments in tests/integration/rebar_reconciler","verify_commands":[]},"source_event_uuids":["fae3d05b-6a77-4df1-9bc5-9f7e0604913b","dd74be9e-1369-41fc-a71c-0b81c235c623","3e310719-97d3-432c-a0e5-155042942c17","bd706581-70fc-458b-9057-241b4991b69f","ec4386b2-5e06-4781-a02b-1fee271eceb0","9f0027