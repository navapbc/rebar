{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import ast, subprocess, sys\nBASE=\"ba24f8734c922c9867645f20df35349bed885419\"\nclass StripDocstrings(ast.NodeTransformer):\n    def generic_visit(self, node):\n        node = super().generic_visit(node)\n        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n            if node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n                node.body = node.body[1:]\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n        return node\ndef normalized(raw):\n    return StripDocstrings().visit(ast.parse(raw, type_comments=True))\nfor path in sys.argv[1:]:\n    before = subprocess.check_output([\"git\", \"show\", f\"{BASE}:{path}\"], text=True)\n    after = subprocess.check_output([\"git\", \"show\", f\"HEAD:{path}\"], text=True)\n    if ast.dump(normalized(before), include_attributes=False) != ast.dump(normalized(after), include_attributes=False):\n        raise SystemExit(f\"normalized AST changed: {path}\")' tests/integration/reconciler/conftest.py tests/integration/reconciler/jira_contract/_fakes.py tests/integration/reconciler/jira_contract/test_jira_fixtures.py tests/integration/reconciler/jira_contract/test_roundtrip.py tests/integration/reconciler/jira_contract/test_snapshot_contract.py tests/integration/reconciler/jira_contract/test_verified_fake_contract.py tests/integration/reconciler/test_leaves_invocable.py tests/integration/reconciler/test_link_sync.py tests/integration/reconciler/test_post_deletion_linkage.py tests/integration/reconciler/test_reconcile_idempotency.py tests/integration/reconciler/test_reconcile_roundtrip.py","dd_id":"semantic","dd_text":"All scoped Python files have exactly equal normalized ASTs against the immutable audit basis."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import io, re, subprocess, sys, tokenize\nBASE=\"ba24f8734c922c9867645f20df35349bed885419\"\nPATTERN=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|fmt:|ruff:|pyright:|mypy:)\")\ndef source(ref, path):\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\ndef signatures(raw):\n    lines=raw.splitlines()\n    found=[]\n    for token in tokenize.generate_tokens(io.StringIO(raw).readline):\n        if token.type != tokenize.COMMENT or not PATTERN.match(token.string):\n            continue\n        row, col = token.start\n        left=lines[row - 1][:col].rstrip()\n        anchor=(\"inline\", left) if left else (\"next\", \"<EOF>\")\n        if not left:\n            for line in lines[row:]:\n                stripped=line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    anchor=(\"next\", stripped)\n                    break\n        found.append((token.string, anchor))\n    return found\nfor path in sys.argv[1:]:\n    before=signatures(source(BASE, path))\n    after=signatures(source(\"HEAD\", path))\n    if before != after:\n        raise SystemExit(f\"directive text or attachment changed: {path}: {before!r} != {after!r}\")' tests/integration/reconciler/conftest.py tests/integration/reconciler/jira_contract/_fakes.py tests/integration/reconciler/jira_contract/test_jira_fixtures.py tests/integration/reconciler/jira_contract/test_roundtrip.py tests/integration/reconciler/jira_contract/test_snapshot_contract.py tests/integration/reconciler/jira_contract/test_verified_fake_contract.py tests/integration/reconciler/test_leaves_invocable.py tests/integration/reconciler/test_link_sync.py tests/integration/reconciler/test_post_deletion_linkage.py tests/integration/reconciler/test_reconcile_idempotency.py tests/integration/reconciler/test_reconcile_roundtrip.py","dd_id":"directives","dd_text":"Directive text and attachment remain exact in every scoped Python file."},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\", \"--\", *sys.argv[1:]], text=True).splitlines())\nif actual != expected:\n    raise SystemExit(f\"changed paths differ from file impact: actual={actual!r} expected={expected!r}\")' tests/integration/reconciler/conftest.py tests/integration/reconciler/jira_contract/_fakes.py tests/integration/reconciler/jira_contract/test_jira_fixtures.py tests/integration/reconciler/jira_contract/test_roundtrip.py tests/integration/reconciler/jira_contract/test_snapshot_contract.py tests/integration/reconciler/jira_contract/test_verified_fake_contract.py tests/integration/reconciler/test_leaves_invocable.py tests/integration/reconciler/test_link_sync.py tests/integration/reconciler/test_post_deletion_linkage.py tests/integration/reconciler/test_reconcile_idempotency.py tests/integration/reconciler/test_reconcile_roundtrip.py","dd_id":"paths","dd_text":"The one-commit leaf diff changes exactly the recorded file-impact paths."},{"command":"git diff --check HEAD^ HEAD -- tests/integration/reconciler/conftest.py tests/integration/reconciler/jira_contract/_fakes.py tests/integration/reconciler/jira_contract/test_jira_fixtures.py tests/integration/reconciler/jira_contract/test_roundtrip.py tests/integration/reconciler/jira_contract/test_snapshot_contract.py tests/integration/reconciler/jira_contract/test_verified_fake_contract.py tests/integration/reconciler/test_leaves_invocable.py tests/integration/reconciler/test_link_sync.py tests/integration/reconciler/test_post_deletion_linkage.py tests/integration/reconcile