osition":"1786558335255619001-e29491b4-85cd-4abc-8efb-0d69141e233e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5bf2beddcfa4677fb4f30c10ce71bdb90ed3491e269daec3342f58a8f1c7d77f","event_uuid":"d7a04e34-7c34-4961-8e55-43ca79c99844","position":{"commit_sha":"e12614273b3ad761b7b9cedc86a4a8dcc2e7daa9","position":"1786558383360138001-d7a04e34-7c34-4961-8e55-43ca79c99844"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"880ed1fef9c19f67aa5a6277af46f40f785f61772f4b3516d34236e1f7a68880","event_uuid":"e6165f70-7d52-4fdf-b7de-1b843337ede4","position":{"commit_sha":"da11747846210eab1b48253a6c08826e822ae7e0","position":"1786559106075219001-e6165f70-7d52-4fdf-b7de-1b843337ede4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8f8df4748768b1e4c916517f815e5cb48f71b9a2e810547b3187b9d77095b814","event_uuid":"bf534937-f847-4cbe-84d2-49a8f483ae44","position":{"commit_sha":"ef53e9f5296f13484661e1644e4570083502a6e8","position":"1786559113829270001-bf534937-f847-4cbe-84d2-49a8f483ae44"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed255