-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ac663e2c76df52f9b87505f8941b11c024fcb6add1b9ce3b188e0092b7080e62","event_uuid":"6c60df16-3eec-4599-b4b3-c72cfadb8f81","position":{"commit_sha":"bdfdd2396ee23c79ea21f2726ba59c0493f4301c","position":"1786562792915605072-6c60df16-3eec-4599-b4b3-c72cfadb8f81"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8da95ee3b10b6bf9e067d418282fe83025ef6490931ef3fa67091f8cb54b6fa6","event_uuid":"8f6b38d6-444f-4bda-ae66-98bb94b9e158","position":{"commit_sha":"2313243d96a0df3a2928e9c2cd90a034c2842a26","position":"1786564221459269805-8f6b38d6-444f-4bda-ae66-98bb94b9e158"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b1dbe24f74809d19cb3619339ae3c263086cca62fead1a67e6b0da3fde5f60a9","event_uuid":"3ed4730b-c160-4a9d-8b10-f68fe008973d","position":{"commit_sha":"243f85e25904aeac663526cc02f7824cbb806d10","position":"1786567279852898618-3ed4730b-c160-4a9d-8b10-f68fe008973d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented as change https://rebar.solutions.navateam.com/c/rebar/+/1673 (commit 2e3d3d4e51, stacked on 1669/1662).\n\nPREMISE VERIFIED in origin/main cc69cc1179. close_ticket commits the STATUS event and releases the lock BEFORE the signing tail; the SigningError catch wrote a warning to stderr and fell through to the normal success payload, which carried no field about the signature outcome. Confirmed: exit 0, ticket closed-without-signature, loss undetectable programmatically.\n\nCHANGE. completion_signature {signed, cause, error} on every close where a signature was in play. Closed vocabulary: signed / sign_failed / material_drifted / force_bypassed. Absent for a plain transition and for idea -> closed (transition_close.py excludes that edge from the signing block entirely — a REJECT/DROP is not a completion, so inventing a cause would misreport a deliberate non-event). Threaded through _lib_writes.transition, the CLI --output json branch, the TransitionResult TypedDict and transition_result.schema.json; MCP inherits from the library and is asserted, not assumed.\n\nMESSAGE. Now leads with '<id> IS CLOSED — the close committed. Only the completion signature failed' and tells the reader NOT to re-run the transition. The old text appended the raw signing error, so a lock timeout read as a failed close.\n\nEXIT CODE DELIBERATELY UNCHANGED, and this narrows the ticket's original AC1. docs/exit-codes.md declares the contract frozen as of the 2026-06-09 window, pinned by tests/interfaces/lifecycle/test_exit_codes.py, with the table at :158 fixing transition at 0/1/10. A new code is additive-only in a future window (a release decision). Reusing exit 1 would be actively harmful: agents read 1 as 'the transition failed' and re-run it, which then exits 10 (already closed) — trading a silent loss for a louder wrong answer. The report explicitly sanctioned 'at minimum a machine-readable failure marker', which is what shipped. A test pins exit 0 so the decision is not silently reversed.\n\nSPLIT OUT. The original AC 'detectable by a later reader' is NOT delivered here. The first draft proposed a best-effort audit comment; plan review correctly blocked it, because that comment appends through the SAME event_append -> write_lock path whose 60s timeout causes the bug, so it would be missing in exactly the case it exists for. The sound mechanism records the expectation in the same locked write as the STATUS event — an event-schema change — tracked as mechanical-coherent-wolverine (23b2-1a94-6a01-466b), linked discovered_from this ticket.\n\nCOMPLEXITY RATCHET. The added branches pushed close_ticket past its recorded ceiling (scripts/check_complexity_baseline.py, increased=1). Rather than raise the ceiling on a shrink-only gate, extracted the signing tail to _sign_completion_and_report — drift refusal vs sign vs sign failure is a decision of its own. Gate now increased=0, stale=1.\n\nEVIDENCE. 11 tests in tests/unit/test_transition_close.py + 2 MCP facade tests in tests/interfaces/facades/test_transition_completion_signature_facade.py (13 passed). Wider -k 'transition or close or lock or schema': 1035 passed, 4 skipped. make lint (incl. complexity baseline) and make typecheck (510 files) clean.","timestamp":1786562360994880001}],"created_at":1786531886811186001,"creation_channel":"cli","deps":[{"link_uuid":"3b8724c5-4d89-4287-82a5-b60273dc21f4","relation":"discovered_from","target_id":"10c3-5a33-2e25-4584"},{"link_uuid":"6c60df16-3eec-4599-b4b3-c72cfadb8f81","relation":"relates_to","target_id":"71be-af50-a333-4cfc"},{"link_uuid":"8f6b38d6-444f-4bda-ae66-98bb94b9e158","relation":"relates_to","target_id":"cfaf-2a2b-932e-4b71"},{"link_uuid":"3ed4730b-c160-4a9d-8b10-f68fe008973d","relation":"relates_to","target_id":"6873-7323-7853-4ee6"}],"description":"## Report\n\n`rebar transition <id> in_progress closed` can print an error to stderr **with exit code 0**,\n~60s AFTER the close is durably committed, silently downgrading the ticket to\nclosed-WITHOUT-signature. Seen in the field: an agent reported its final `rebar transition`\nfailed with a lock error; re-reading showed the transition had LANDED.\n\n## Premise verified in current `origin/main` (cc69cc1179)\n\nIn `src/rebar/_commands/transition_close.py`, `close_ticket` (line **263**): the STATUS event\ncommits and releases the lock BEFORE the signing tail runs. Line **433**\ncalls `sign_completion_verdict(...)`, whose append takes a fresh 60s `write_lock` via\n`write_and_push` -> `event_append`. Line **434** catches `_signing.SigningError`; lines\n**439-445** write `Warning: closed <id> WITHOUT a completion signature — <exc.message>` to\nstderr and fall through, so `close_ticket` returns its normal success payload (lines\n**492-498**: `ticket_id`, `from`, `to`, `newly_unblocked`, `noop`) and the command exits\n**0**. That payload carries **no field at all** about the signature outcome, so no library,\nMCP or CLI consumer can detect the loss programmatically. The sibling drift refusal (lines\n**421-429**) lands unsigned the same way, likewise unreported.\n\nThe `except` comment (lines **435-438**) justifies the exit-0 degrade for a *missing\nssh-keygen* — permanent and operator-fixable — which does not transfer to the **transient lock\ntimeout** the field incident hit; the appended `exc.message` (\"flock: could not acquire lock\nafter 60s\") reads as the CLOSE failing when it succeeded. Zebrafish (cc69cc1179) added bounded\nretry there, mitigating frequency but not the reporting shape.\n\n## Direction\n\nMake the loss **machine-readable and honestly worded** for the caller that suffered it,\nwithout changing the process exit code.\n\n1. **Payload marker.** `close_ticket` returns an additional\n   `completion_signature: {\"signed\": bool, \"cause\": str, \"error\": str}`, mirroring the\n   machine-branchable `PlanReviewAttestation.as_dict()` idiom used for this same problem at\n   `src/rebar/llm/plan_review/resign.py:457`, so callers branch on `cause` without parsing\n   English. The `cause` vocabulary is **closed and total** over the close path, and `error` is\n   empty wherever there is no failure text:\n\n   | outcome | `signed` | `cause` | `error` |\n   |---|---|---|---|\n   | signature persisted | `True` | `signed` | `\"\"` |\n   | `SigningError` at line 434 | `False` | `sign_failed` | `exc.message` |\n   | drift refusal at line 421 | `False` | `material_drifted` | `\"\"` |\n   | `--force` close (signing deliberately skipped) | `False` | `force_bypassed` | `\"\"` |\n\n   The key is present only where a completion signature is in play: **absent** for a non-close\n   transition, and absent for `idea -> closed`, which line **325**\n   (`target_status == \"closed\" and current_status != \"idea\"`) excludes from the signing block\n   entirely — a REJECT/DROP of an undesigned idea is not a completion, so it has no signature\n   outcome and inventing a `cause` would misreport a deliberate non-event. Consumers treat the\n   key as optional, absence meaning \"not a completion close\".\n\n   `sign_failed` deliberately covers BOTH the transient lock timeout and the permanent\n   missing-`ssh-keygen` degrade: they differ in remedy but not in the fact reported, and the\n   distinguishing text is carried verbatim in `error`. Splitting it would make this layer\n   classify `SigningError`s it does not construct — that belongs with the signing layer.\n\n   **Consumers that must forward it.** The payload is re-projected field by field at two\n   boundaries that would otherwise silently strip the new key, so both are in the edit set:\n   `src/rebar/_lib_writes.py:414-419` (public `rebar.transition()`) and\n   `src/rebar/_commands/transition.py:580-591` (CLI `--output json`). MCP `transition_ticket`\n   (`src/rebar/_mcp_writes.py:190-195`) forwards the library result and inherits it once\n   `_lib_writes` does — asserted, not assumed. The shared\n   `src/rebar/schemas/transition_result.schema.json` gains `completion_signature` as an\n   OPTIONAL property (out of `required`: `reopen` shares the schema and has no close path);\n   it already sets `additionalProperties: true`, so this is additive. The `TransitionResult`\n   TypedDict at `src/rebar/types.py:205-213` mirrors that schema field by field and is the\n   declared return type of public `transition()`, so it gains the same key as `NotRequired` in\n   this change — otherwise the typed and JSON contracts disagree and mypy rejects the new key\n   at the `_lib_writes` return.\n2. **Honest message.** The stderr text leads with the close having **LANDED** and only the\n   signature having failed, then names the recovery — rather than appending a bare lock error\n   that describes the succeeded operation as failed.\n3. **No durable read-side record here — split out.** The first draft proposed a best-effort\n   audit comment. That is unsound: it appends through the SAME `event_append` -> `write_lock`\n   path whose 60s timeout produced the `SigningError`, so under the contention that causes\n   this bug it fails too, and the record would be missing in exactly the case it exists for.\n\n   The sound mechanism is to record the EXPECTATION at close time in the same locked write\n   that already commits the STATUS event (line **377** `txn.transition_core`, which already\n   carries `close_class` and `force_close_reason`), so a reader can compare \"a signature was\n   expected\" against \"a valid completion attestation exists\". That is an event-schema addition\n   (schema + reducer + `docs/event-schema.md`) — materially more cross-cutting than this\n   reporting fix — so it is tracked as its own bug, **mechanical-coherent-wolverine**\n   (`23b2-1a94-6a01-466b`), linked `discovered_from` this one, rather than hand-waved here.\n\n   This ticket therefore makes the loss visible to the CALLER that suffered it, across all\n   three public surfaces. Making it visible to an unrelated LATER reader is wolverine's job.\n\n### Why NOT a nonzero exit code (deliberate, recorded)\n\nThe report offers \"a nonzero exit **or at minimum** a machine-readable failure marker\"; the\nexit path is rejected here. `docs/exit-codes.md` declares the contract **frozen** as of the\n2026-06-09 window, pinned by `tests/interfaces/lifecycle/test_exit_codes.py`, with the table\nat `docs/exit-codes.md:158` fixing `transition` at 0/1/10 — a NEW code is additive-only in a\nfuture window, a release decision rather than an implementation one. Reusing exit **1** would\nbe actively harmful: agents read 1 as \"the transition failed\" and re-run it, which then exits\n**10** (already closed), trading a silent loss for a louder wrong answer. The marker route\nmeets the reporting need within the frozen contract; a new code is out of scope here.\n\n## Acceptance criteria\n\n- [ ] A close whose signature append raises `SigningError` returns\n      `completion_signature.signed == False` with `cause == \"sign_failed\"` — verified by a\n      test that forces the append to fail\n- [ ] A successful close returns `completion_signature` `{signed: True, cause: \"signed\",\n      error: \"\"}` — verified by a test\n- [ ] A `--force` close returns `signed == False`, `cause == \"force_bypassed\"` — test\n- [ ] The marker survives to all three public consumers: `rebar.transition()` returns it,\n      `rebar transition … --output json` prints it, and MCP `transition_ticket` carries it —\n      verified by a test per surface\n- [ ] The stderr text on that failure states the close LANDED and only the signature did not,\n      and does not present the lock error as the close failing — verified by a test asserting\n      the message text\n- [ ] `idea -> closed` returns no `completion_signature` key — verified by a test\n- [ ] The material-drift refusal path reports `signed == False` with\n      `cause == \"material_drifted\"` — verified by a test\n- [ ] Exit code is unchanged (0) throughout — verified by a test pinning that decision","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/transition_close.py","reason":"completion_signature marker, honest stderr text, best-effort audit comment"},{"path":"src/rebar/_lib_writes.py","reason":"forward completion_signature through public transition()"},{"path":"src/rebar/_commands/transition.py","reason":"forward completion_signature through CLI --output json"},{"path":"src/rebar/types.py","reason":"TransitionResult TypedDict gains the optional key"},{"path":"src/rebar/schemas/transition_result.schema.json","reason":"declare completion_signature as optional property"},{"path":"tests/unit/test_transition_close.py","reason":"tests for marker, cause vocabulary, message, exit code, consumers"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","6873-7323-7853-4ee6"],["relates_to","71be-af50-a333-4cfc"],["relates_to","cfaf-2a2b-932e-4b71"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"9ec5dd2c-27c4-46f5-bb0f-ad0250d1057e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"f4cf-60b2-41c0-4843","ticket_type":"bug","title":"transition close reports a lock error with exit 0 after the close landed, silently dropping the completion signature","verify_commands":[]},"source_event_uuids":["eec0875d-7f1c-4908-a550-9d52df810205","3b8724c5-4d89-4287-82a5-b60273dc21f4","e29491b4-85cd-4abc-8efb-0d69141e233e","d7a04e34-7c34-4961-8e55-43ca79c99844","e6165f70-7d52-4fdf-b7de-1b843337ede4","bf534937-f847-4cbe-84d2-49a8f483ae44","ac1fa5fa-435c-4216-8693-f494353dfe14","8d23904f-2857-471c-87d2-8bface47d0e6","a6a373f9-d0d9-4f14-b1ea-6efeeebe9746","5dd55364-88c0-4c76-b8d2-a19851a063f5","9ec5dd2c-27c4-46f5-bb0f-ad0250d1057e","7793f309-1515-46e3-8f08-044725d234e1","eddd1394-9e24-4533-98fe-7aa970217a08","6c60df16-3eec-4599-b4b3-c72cfadb8f81","8f6b38d6-444f-4bda-ae66-98bb94b9e158","3ed4730b-c160-4a9d-8b10-f68fe008973d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786567279852898619,"uuid":"d027735f-e7ec-4a76-b13e-43079d075346"}