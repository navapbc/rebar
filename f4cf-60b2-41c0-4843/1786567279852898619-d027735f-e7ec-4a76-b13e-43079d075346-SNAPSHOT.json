{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786567279852898619,"compiled_state":{"alias":"silvern-dewy-damselfly","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"308215c67746d42f4de551c7ad9d0986bc2c89b9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: f4cf-60b2-41c0-4843","material: 15a1d1ff290faa26","material-part: children 647ea2107ca5072f 0","material-part: description 825d8e5d729f3266 7998","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact ef2ed7a1786ac846 6","material-part: ticket_id 2d9026717cea6742 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (308215c677-dirty)","regver: 4f90349cd81c4911","verified-at-sha:cc69cc117980e219909306cd094c6c903705c308","dep f84959477b06151fd8b1dd08d9dcbe60dcbcecaf89b9426b3372e5eea1b7a902 src/rebar/_commands/transition.py","dep b411fc1b5ab8289daac485cf728238bd24be08f3f34a8d02bcac9d7a025724b1 src/rebar/_commands/transition_close.py","dep 86be41d7e4fdb9eff537bcf95b8a83f08199d7c2c46a467aaaebeb60cab1e106 src/rebar/_lib_writes.py","dep 42c11aceaa5e2e3b11ce137bc7dcd1ab2d62e83c377e09314400ac43533134b6 src/rebar/schemas/transition_result.schema.json","dep 9a61f15ee067af7c2f7e692549a85c40f74ed1082358f2aaff60780df133ecbb src/rebar/types.py","dep 23dc3ea3b4321b5787af504617976c910e83bd4b8412705d9972602ea12fe88c tests/unit/test_transition_close.py","read-set: 8","read-path: docs/exit-codes.md","read-path: src/rebar/_commands/transition.py","read-path: src/rebar/_commands/tra