art+bot@navapbc.com"},{"content_hash":"be7b0795c2c3a661603e602e148d87b6ee4c2c6f8f090aed9e13291f7eef70c7","event_uuid":"27d259b4-6665-4f79-a91d-9e6cf4caf0ec","position":{"commit_sha":"9a929712a62121358d816bed9b05a2114c02a0bb","position":"1786290707995562001-27d259b4-6665-4f79-a91d-9e6cf4caf0ec"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9f4ec501f8d0c76d7e8c45260cf13c0db03667801c0b3269f36cb5e70b2e06e5","event_uuid":"714dff3e-0787-4708-aede-866abfedcd2a","position":{"commit_sha":"731c4ccc9a4e1f7dd786ee4877585916452170df","position":"1786291214012892909-714dff3e-0787-4708-aede-866abfedcd2a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Joe Oakhart","body":"Verified on current origin/main (1b77c6dad): make lint is GREEN (ruff check + format-check both pass). The immediate fix is present -- passes.py:96 carries '# noqa: F811 (name reused across scopes: kernel re-export vs this Field)'. AC1 (lint green on main) satisfied; AC2 root-cause (merge-skew, per-change-ref CI doesn't validate merged tree) is documented in the ticket body. AC3 (post-merge-CI guard) is a follow-up owned by epic 88ab. No code change needed in this checkout; proposing close as already-resolved.","timestamp":1783274102730969001}],"created_at":1783078766167073001,"creation_channel":"unknown","deps":[],"description":"## Summary\n`make lint` (ruff==0.15.19, the pinned CI/hook version) FAILS on `main`: src/rebar/llm/plan_review/passes.py has an F811 — `impact` is imported as a re-export from review_kernel.decide (line ~54, in a `# noqa: F401` block) AND reused as a nested pydantic Field name `impact` (line ~96). ruff flags the second as a redefinition of the (re-export) first. Because CI runs the identical pinned ruff, the Verified gate fails on ANY change based on current main -> NOTHING can land.\n\n## How it slipped through (root-cause hypothesis)\nClassic MERGE SKEW: the `impact` re-export import landed via 2c93aa3d6 (epic 66ac Pass-3 floor) while the Field named `impact` pre-existed (or vice versa) — each change was green against its OWN change-ref, but the MERGED main is red. CI validates GERRIT_REFSPEC (the per-change patchset), not the post-merge tree, so a name-collision across two independently-green changes is invisible until merged. (Alternative: a ruff-version pin bump exposed a latent shadow.) This is the same semantic-merge-conflict failure mode epic 88ab's two-vote gate + S5 scenario 6 exist to surface.\n\n## Reproduction\n1. git checkout origin/main\n2. make lint  ->  F811 at src/rebar/llm/plan_review/passes.py:96 (\"redefinition of unused 'impact'\")  -> exit 1\n\n## Expected vs Actual\n- Expected: make lint green on main; a name-collision merge skew is caught BEFORE it lands (post-merge validation).\n- Actual: main is lint-red; the collision landed and blocks all subsequent changes.\n\n## Acceptance Criteria\n- [x] make lint passes on main again (immediate fix: a targeted # noqa: F811 on the nested Field, OR de-shadow the name — the two are genuinely different objects across scopes)\n- [x] Root-cause the escape: confirm merge-skew vs ruff-pin bump; if merge-skew, note the gap (per-change-ref CI does not validate the merge result) as evidence for the epic-88ab merge-review / post-merge-CI value\n- [x] (follow-up, if merge-skew) a guard so a name-collision merge skew is caught: e.g. CI on the merge tree, or the 88ab merge-change review path applied to submits","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"75748578-a6d4-4c11-baa6-850f902feedc","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","tags":[],"ticket_id":"a425-71e9-70df-45ac","ticket_type":"bug","title":"main is lint-red: F811 redefinition of 'impact' in plan_review/passes.py (merge-skew / ruff-pin exposure blocking all landings)","verify_commands":[]},"source_event_uuids":["eabf8d3a-defa-415d-8419-e7575d2bb560","0258b2f4-5e05-430f-a651-5e748958e2b4","54dbbaea-eda8-42b2-8571-a416d1eccf91","9df45a23-739c-49f4-8c03-6e0f88f10f6d","151799f0-e22d-4e65-9844-de746d3e7979","75748578-a6d4-4c11-baa6-850f902feedc","344826da-e293-4ca3-b5f0-97cfb5d84486","7d43facb-0260-4315-9c1d-c4c32eeb750b","8229eeca-336b-4581-acb9-317252f908ad","27d259b4-6665-4f79-a91d-9e6cf4caf0ec","714dff3e-0787-4708-aede-866abfedcd2a"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786295104194308001,"uuid":"743e36da-8ab3-4099-9871-be813686f382"}