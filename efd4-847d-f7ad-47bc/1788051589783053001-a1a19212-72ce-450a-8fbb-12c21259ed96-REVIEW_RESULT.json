 candidate'","norm_id":"need9c4c1c687aee6","priority":0.8889,"reason":"default-advisory","recalled":false,"scenarios":["A future config that overlays [llm.model_classes] via project vs user config, or via REBAR_LLM_<CLASS>_MODEL env, is honored by load_class_slots but silently missed by a raw rebar.toml read — the parity guard would pin the wrong id","A Bedrock primary whose id contains a colon is correctly composed by _resolve_target but could be mis-parsed by a bespoke reader"],"severity":"critical","suggested_fix":"State that resolve_pinned_model calls load_class_slots(repo_root) + resolve_class(class_name, slots) for the primary id (dropping fallback == not calling resolve_fallback_chain), then applies the bedrock: check on the resolved string; reuse FRONTIER_CLASS/STANDARD_CLASS for PASS_MODEL_CLASS's values.","tier":"LLM","validity":0.8889,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"high","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple 