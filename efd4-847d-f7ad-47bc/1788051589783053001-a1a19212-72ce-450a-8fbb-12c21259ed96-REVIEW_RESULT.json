ry","recalled":false,"scenarios":["A later ticket folds check_cache_effective's verdict into a report while cache_diagnostics.warn_if_cache_write_never_read fires the opposite way on the same rows — two divergent cache verdicts on one run"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] State whether check_cache_effective reuses / delegates to cache_diagnostics.cache_write_never_read (or explains why its verdict shape must differ), rather than defining an independent cache-effectiveness predicate over the same usage rows.","cohort":["T1"],"criteria":["T1"],"decision":"advisory","decision_margin":-0.7,"drop_reason":null,"evidence":["Plan: 'check_cache_effective(usage_rows) asserts from a list of usage-log row dicts that cache_read_tokens > 0 on at least one row after the first'","Plan Context: 'why cache reads dropped to zero on 2026-08-12 and review cost roughly doubled'","src/rebar/llm/cache_diagnostics.py:140 `def cache_write_never_read(records, *, min_calls=2)` — 'True when a RUN's