5519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787512792474002001,"creation_channel":"cli","deps":[],"description":"## Context\n\n`docs/maintenance-audit-runbook.md` calls the enforced module limit a soft cap and embeds dated tool inventory, machine state, measurements, findings, and capture debris as maintained procedure. The packaged `examples/agent-skills/rebar-janitor/SKILL.md` owns the audit phases. Ticket unafraid-homey-umbrette records the complexity ratchet, and scabby-slur-junk records a prior audit finding.\n\n## Plan\n\n- Rewrite the runbook as a rebar-project adapter to the packaged janitor workflow.\n- Retain project gate commands and the command inputs needed to run them.\n- Require rebar session logs and tickets for durable progress, decisions, and discovered work.\n- State that the module limit is an absolute CI gate sourced from `.github/module-size-limit.txt`.\n- Remove dated observations and capture debris from maintained procedure.\n- Refer to historical tickets when prior findings provide context.\n- Execute the documented read-only commands and run documentation link checks.\n\n## Acceptance Criteria\n\n- [ ] The runbook delegates audit phases to the packaged janitor skill.\n- [ ] Project-specific gate commands remain documented and executable.\n- [ ] Session logs and tickets are required as the durable artifacts for this repository.\n- [ ] The module limit is described as an absolute CI gate sourced from `.github/module-size-limit.txt`.\n- [ ] Dated machine state, measurements, findings, and capture debris are absent from maintained procedure.\n- [ ] Historical context points to tickets instead of restating incident narratives.\n- [ ] Documented read-only commands and documentation link checks pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/maintenance-audit-runbook.md","reason":"Replace the dated snapshot with a maintained project adapter to the janitor workflow."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","b8bf-a5aa-2f4d-44d4"]],"no_file_impact_reason":"","parent_id":"b8bf-a5aa-2f4d-44d4","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","accuracy","f38"],"ticket_id":"74dc-98da-4d2c-40b9","ticket_type":"task","title":"F38 replace the maintenance audit snapshot with a project adapter","verify_commands":[{"command":"python scripts/check_complexity_baseline.py --check","dd_id":"D1","dd_text":"Complexity ratchet"},{"command":"python -m pytest tests/unit/test_module_size_contract.py tests/unit/test_complexity_baseline.py::test_runbook_documents_tokens tests/scripts/test_metrics_docs.py -q","dd_id":"D2","dd_text":"Maintenance documentation contracts"},{"command":"python scripts/check_docs_index.py --check","dd_id":"D3","dd_text":"Documentation links and index"},{"command":"python scripts/check_skill_frontmatter.py","dd_id":"D4","dd_text":"Packaged skill frontmatter"},{"command":"git diff --check","dd_id":"D5","dd_text":"Changed file whitespace"}]},"source_event_uuids":["41954b79-1882-4164-9e3f-91f188b66cfa","2cd10299-a5b3-4a1a-9080-c98dc645b7f5","1eabc982-9bdf-4fbf-b0aa-6e37e785e627"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787519394134343001,"uuid":"2d861c25-bb8e-446a-9537-ceac0ffd580b"}