a75-31842cb918cd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d37317800a86d1c464fd54df4a9b964e2bf9c5329c1c425f4bfd71124211d478","event_uuid":"ed4d11d1-dd56-4e00-b329-933053967e2b","position":{"commit_sha":"e5467dd663f0a4b4d46c391e892b356de03cd473","position":"1788770417034387001-ed4d11d1-dd56-4e00-b329-933053967e2b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"88458ec5fa9e44e1c439451e11551a3e4a78451c021cafa01e631e93d46c1197","event_uuid":"00f25bfc-4a80-47f6-89b9-ef6b241de531","position":{"commit_sha":"4be75eba948cd5f4556c274c1562c9925bfbc9d9","position":"1788770436226073001-00f25bfc-4a80-47f6-89b9-ef6b241de531"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"env_integration","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Operator decision 2026-09-06: APPROVED — isolate test-run gate slots from the host-global production slot dir (per-checkout/per-process override). This is the skua member of the grayfox/skua/ladybird/snail/duck gate-slot cluster.","timestamp":1788761489513919001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review passed; claimed for TDD implementation.","timestamp":1788764072033402001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix pushed for review: Gerrit change 2744. RED oracle added in tests/unit/test_gate_admission_09da.py::test_xdist_worker_gate_slots_do_not_share_operator_slots; targeted gate-admission tests, make check, and full make verify passed before push.","timestamp":1788766938807063001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change 2744 merged to origin/main and this worktree was refreshed to the merged commit. Acceptance criteria updated with completion evidence; closing the ticket now.","timestamp":1788770159386443001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Ticket closed after completion verification passed; classified bug as env_integration.","timestamp":1788770436226073001}],"completion_expectation":"required","created_at":1788670126953020001,"creation_channel":"cli","deps":[{"link_uuid":"7db58537-d336-42b4-9657-aeebc84c5095","relation":"discovered_from","target_id":"94c5-b42e-ac80-4f06"},{"link_uuid":"456d8a8f-246d-4d68-a3c1-f2489de79e5d","relation":"relates_to","target_id":"e474-bf84-d703-4f8a"}],"description":"## Summary\n\n`make verify` — the stated CI contract in `AGENTS.md` — cannot pass on a host\nwhere any other rebar process is running a gate. `make test` runs pytest with\n`-n 4` (four xdist workers), and the gate-admission cap\n(`src/rebar/llm/gate_admission.py:299` `gate_admission`) is **4 slots that are\nHOST-GLOBAL**, not per-repo, per-worktree or per-test-session: `_slot_dir()`\n(`src/rebar/llm/gate_admission.py:210`) puts the slot files under the snapshot\nstore root's `locks/`, i.e. `$TMPDIR/rebar-gate-snapshots/locks/gate-slot-N`.\n\nSo the four test workers must win all four host slots at once. Any other rebar\ngate process on the box takes one and the suite starts failing with\n`GateCongestedError: gate admission refused: all 4 concurrent slots busy`.\n\n## Evidence\n\nThree `make verify` runs in one session on this host, same commit, all green in\nlint + typecheck, all failing only on gate admission — with a DIFFERENT failure\nset each time (15, then 9 on a subset re-run, then 26), which is the signature of\na contended shared resource rather than a code defect:\n\n    FAILED tests/unit/test_plan_review_retry.py::... - GateCongestedError: gate\n      admission refused: all 4 concurrent slots busy\n\nConfirmed holder during one run:\n\n    60942 /Users/joeoakhart/scanner-promote/.venv/bin/rebar review-plan\n          guileless-emeritus-izuthrush\n\n— a DIFFERENT worktree's plan review, holding `gate-slot-0` for its whole run.\nEach affected test passes when its file is run alone, and the same multi-file\nselection passes on unmodified `main`, so the failures track host load, not the\ntree. The same commit that failed locally took `Verified +1` from CI\n(GitHub Actions, an isolated runner with no competing rebar processes).\n\n## Why this matters\n\n`AGENTS.md` makes `make verify` the ONLY local command that lets an agent say \"I\nverified this\" and be right, and warns that three changes were pushed red in one\nweek by people who ran `make lint` instead. On a shared developer box that runs\nthe MCP server and parallel agents — which is exactly how this project is worked\n— `make verify` is instead a coin flip, and its failures look like real test\nfailures. That trains agents to dismiss red `make verify` output, which defeats\nthe whole point of the contract.\n\n## Acceptance criteria\n\n- [x] AC1 The scope mismatch is confirmed: `make test`'s worker count and the\n      gate-admission slot count are shown to contend, with the slot store's\n      host-global location cited.\n- [x] AC2 A test-session gate run cannot be starved by an unrelated rebar\n      process on the same host — e.g. the admission slot store is scoped per\n      test session (or per repo/worktree) rather than per host, or the test\n      suite's gate path does not consume the operator-facing cap at all.\n- [x] AC3 The operator-facing purpose of the cap — bounding concurrent gate\n      memory on one machine — is preserved for real gate runs; the fix must not\n      simply raise or disable the cap.\n- [x] AC4 A test demonstrates the starvation before the fix and its absence\n      after, without depending on wall-clock timing.\n- [x] AC5 `make verify` completes with no `GateCongestedError` on a host that is\n      concurrently running an unrelated `rebar review-plan`.\n\n## Constraints\n\nNever use `--force` or any gate bypass. Do not raise the cap as the fix (AC3).\n\n## Completion evidence\n\n- Confirmed the scope mismatch from the RCA in `src/rebar/llm/gate_admission.py`: production gates use the snapshot store `locks/` slot directory, while `make test` runs four xdist workers against the same host-global cap.\n- Implemented worker-scoped slot namespaces only when `PYTEST_XDIST_WORKER` identifies a pytest-xdist worker; ordinary `rebar review-plan` and `verify-completion` processes still share the operator-facing host cap.\n- Added immutable RED oracle `tests/unit/test_gate_admission_09da.py::test_xdist_worker_gate_slots_do_not_share_operator_slots`, which failed before the production change and passes after it without wall-clock timing.\n- Documented the pytest-xdist isolation behavior in `docs/config.md` and regenerated `docs/env-vars.md` for the new resolver-owned environment read.\n- Verified with the targeted oracle, the full gate-admission unit module, `make check`, full `make verify`, and Gerrit change 2744 (`LLM-Review +1`, `Verified +1`, merged).\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","e474-bf84-d703-4f8a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"26b919a9-dde8-4a15-9a75-31842cb918cd","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"e5eb-ef5e-c10a-4729","ticket_type":"bug","title":"make verify cannot pass on a host running any other rebar gate: 4 xdist workers contend for 4 HOST-GLOBAL admission slots","verify_commands":[]},"source_event_uuids":["232762bb-6ec0-41d0-8850-24682526200b","e29953f1-ba93-454e-a10d-9203587f76cf","84266309-7e36-4cd0-b66a-256a96c51929","88b13c62-5feb-45af-a1f3-826f6bfbe02a","2fa6f942-8004-44d9-8594-2b2db6705328","09ee7ae6-1d5e-4bbb-b805-f67f88959388","456d8a8f-246d-4d68-a3c1-f2489de79e5d","b20ab9f8-b613-4635-89cb-a349e6be7001","ca059af7-db5c-4fdc-804e-09dc74f385bb","26b919a9-dde8-4a15-9a75-31842cb918cd","ed4d11d1-dd56-4e00-b329-933053967e2b","00f25bfc-4a80-47f6-89b9-ef6b241de531"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788774902421927001,"uuid":"0e59e13c-5f26-4acb-98ab-87010a0fed62"}