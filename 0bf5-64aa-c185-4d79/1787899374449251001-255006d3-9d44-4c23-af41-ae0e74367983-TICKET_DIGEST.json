{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"324bb50169fbc52275a3ed8867e142f1cd8cb381e0d66a1eab99d7a9cf19ed9a","digest":{"component_or_area":"review-bot finding publication","key_entities":["src/rebar/review_bot/adapter.py:132","src/rebar/review_bot/voter.py:700","src/rebar/review_bot/finding_publish.py","gerrit_client.py:post_vote","gerrit_client.py:get_revision_files","_summarize()","_translate_findings()","render_findings_block()","parse_anchor()","partition_findings()","build_inline_comments()"],"problem_keywords":["advisory findings invisible","review bot","finding text not rendered","gerrit","llm-review vote","count only message"],"propositions":["Advisory finding text is published nowhere on Gerrit changes; only a count appears in the review message on both PASS and BLOCK paths.","adapter._summarize() PASS branch renders only len(verdict['advisory']) without itemizing findings; the BLOCK branch itemizes only blocking findings and drops advisory text.","_translate_findings() discards each finding's location field, so no file/line anchor ever reaches the Gerrit layer.","Robot comments are disabled on the Gerrit server, making the review message body the only proven rendering surface for advisory findings.","The fix extracts finding enumeration logic into finding_publish.py, renders all advisory findings in the message body on both paths, and posts anchorable findings as inline comments with unresolved=false."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787899374449251001,"uuid":"255006d3-9d44-4c23-af41-ae0e74367983"}