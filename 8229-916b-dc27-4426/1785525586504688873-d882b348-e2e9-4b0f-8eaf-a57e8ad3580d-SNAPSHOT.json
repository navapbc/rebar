n":"1785524312964115001-a124ff27-556c-4409-9870-0df6cd76280d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"67aadf2f2290e4b34e8e4c9f3f8414c894308513187c2c65d077bb97c621a026","event_uuid":"9dbfaa11-6dfc-4812-9132-1ca56a004f77","position":{"commit_sha":"3601b224b9147db515d3c0f9109f6c611eb627b2","position":"1785524944196742001-9dbfaa11-6dfc-4812-9132-1ca56a004f77"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5edad48863c0d8a7aae54e68de315e2416203cc85abaa50ad204c18ed8d12c48","event_uuid":"e00d4f43-6f31-4d54-99ed-1f2a65b5916d","position":{"commit_sha":"1141654c2d84be9fe3702f94ac944b168f1fe713","position":"1785525387209767001-e00d4f43-6f31-4d54-99ed-1f2a65b5916d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4cc4ae1d24a375c5dca7f376edd0e009f91a23641da6ce6716444b39d4db8a26","event_uuid":"89150535-b668-4905-9008-358e1770b163","position":{"commit_sha":"5c2aac2d3d1078c936cdcdf9b9d9dced9600b0ff","position":"1785525478974456001-89150535-b668-4905-9008-358e1770b163"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"441aec9a841ee26e0b05e0c8fe71596daa636db22f094d6ca5034082694451fd","event_uuid":"95da04b8-7b92-4184-9748-52aec019e1ab","position":{"commit_sha":"5c2aac2d3d1078c936cdcdf9b9d9dced9600b0ff","position":"1785525479400580001-95da04b8-7b92-4184-9748-52aec019e1ab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"239030d1d802a5ecbf08f0c04f613ba70f9963267f80aa6cf5b9dc5888339fa9","event_uuid":"5f9406ec-aee0-4b3b-8794-891aea97dcfa","position":{"commit_sha":"a2b36402cb86decf0d61879aa4b5943488074028","position":"1785525586504688872-5f9406ec-aee0-4b3b-8794-891aea97dcfa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"2e857a0a-03b6-414c-b41a-2fd1809c94b8","comments":[],"created_at":1785510703269625001,"creation_channel":"cli","deps":[{"link_uuid":"02ec155b-c98b-48b8-807c-119b6ee68b40","relation":"blocks","target_id":"a49e-3a93-9399-4756"}],"description":"# Extract build_model_settings() and build_usage_limits()\n\nADR 0056 decision 3, SECOND extraction. Sequenced after the except-spine extraction because both edit\nrun(); there is no logical dependency between them.\n\n## Scope\n\n- src/rebar/llm/runner.py -> two plain functions with EXPLICIT parameters:\n      build_model_settings(cfg, req, caps, resolved, cache_settings, *, model_override) -> dict\n      build_usage_limits(cfg, req, UsageLimits) -> tuple[UsageLimits, int, int]\n          returning exactly (usage_limits, req_limit, eff_max_iter)\n  covering max_tokens, timeout, temperature (incl. the withdrawal matrix), max_iterations and the\n  per-run request ceiling.\n- tests/unit/\n- tests/unit/test_structured_run_seam.py  (REQUIRED — see \"the seam guard has no teeth by default\")\n\n### `build_usage_limits` MUST RETURN THE TWO COUNTERS, NOT JUST THE LIMITS OBJECT\n\n`run()` needs `req_limit` AND `eff_max_iter` as independent locals AFTER the call, so a bare\n`-> tuple` leaves the unpacking contract undefined. MEASURED uses at HEAD: both are read at\nrunner.py:542-543 to build `FailureContext(...)` — the carrier task e6bd introduced for\n`interpret_failure` — and again at runner.py:572-573 in the success telemetry log.\n\n`eff_max_iter` CANNOT be recovered from the returned `UsageLimits`: only `max(8, eff_max_iter)` is\nstored there, as `tool_calls_limit` (runner.py:479), and `max()` is not invertible — for any\n`eff_max_iter <= 8` the original value is unrecoverable. `req_limit` happens to equal\n`usage_limits.request_limit`, but reaching back into the object to re-derive one of the two while\nthe other must be returned anyway is worse than returning both.\n\nReturn `(usage_limits, req_limit, eff_max_iter)`.\n\n### `cache_settings` MUST BE A PARAMETER — do not recompute it\n\nMEASURED: the extracted region's FIRST line is\n`model_settings = dict(cache_settings) if cache_settings is not None else {}` (runner.py:408), and\n`cache_settings` is computed 27 lines EARLIER, at runner.py:381, as\n`cache_settings = None if self._model_override else cache_settings_for(caps)`.\n\nSo it is an INPUT to this region, not something the region derives. An implementer given the older\nsignature has only two exits and both are wrong: invent an undocumented parameter, or recompute\n`cache_settings_for(caps)` inside `structured_run`. The recompute is the dangerous one — it drops the\n`self._model_override` guard, silently re-enabling cache settings on the offline TestModel path that\nthis plan (and the comment at runner.py:373) requires to keep them None. It would also re-introduce a\n`cache_settings_for` call site in the leaf module.\n\nPass it in. This makes 5 positional parameters plus one keyword-only; ADR 0056's \"carrier above ~6\"\nthreshold is advisory and is NOT tripped here.\n\nNOTE: the line numbers above were taken BEFORE task e6bd landed in the stack. e6bd removed the except\nspine and tightened comment wording in run(), so re-locate the region by content, not by these\noffsets.\n\n## Destination and its headroom (do not create a new file)\n\nThe themed module already exists: `src/rebar/llm/structured_run.py`. It is the run-execution cluster\nand is where e6bd put `interpret_failure`. MEASURED after e6bd: it is 373 LOC, and\n`tests/unit/test_structured_run_seam.py` asserts `100 <= loc < 500`. So this extraction has roughly\n125 lines of headroom there. If both functions plus their travelling comments would breach 500, split\nalong a real seam into a second themed module at or above the 100-LOC floor — do NOT trim the\ncomments to fit (see \"Honest accounting\").\n\n## THE LEAF-INVARIANT TRAP — build_model_settings must be PURE\n\nMEASURED: `_TEMPERATURE_WITHDRAWN_LOGGED` is defined at `runner.py:64` and mutated inside the\ntemperature block (`if resolved not in _TEMPERATURE_WITHDRAWN_LOGGED:\n_TEMPERATURE_WITHDRAWN_LOGGED.add(resolved)`), which sits INSIDE the region this ticket extracts.\n\n`structured_run.py` is a LEAF, and that is ENFORCED, not conventional:\n`tests/unit/test_structured_run_seam.py::test_structured_run_has_no_runtime_import_from_runner` walks\nthe AST and fails on any runtime `import runner` (only a `TYPE_CHECKING`-guarded annotation import is\nallowed). A naive move therefore has two bad exits:\n\n* move the block but keep referencing the set -> `structured_run` needs a runtime import of `runner`\n  -> the leaf test FAILS;\n* move the SET too -> `runner.py:64`'s own reference breaks, and so does the test-side `.clear()`\n  through the import alias.\n\n**REQUIRED SHAPE: `build_model_settings(...)` returns the computed `model_settings` dict and performs\nNO side effect. The dedup-logging `if ... .add(resolved)` stays INLINE in `run()`, beside the set it\nmutates.** Do not \"solve\" this with a lazy import, a callback parameter, or by relocating the set. The\nextraction is still worth doing without those two lines.\n\n## Explicitly NOT a frozen carrier object\n\nADR 0056 rejects the `ResolvedCall` dataclass an earlier draft proposed. Two of its seven fields\n(model_settings, provenance) are mutated after construction -- task cc33 writes\nprovider_provenance[\"ran_model\"] AFTER the finally block -- so the freeze would be decorative exactly\nwhere it matters, at a cost of ~30-40 lines of replace() ceremony to relocate ~113 lines of code. Use\nexplicit parameters; introduce a carrier only if a signature exceeds ~6 parameters.\n\n## Honest accounting\n\nThis region is 50% comment: ~80 lines is ~36 lines of executable code. The comments TRAVEL WITH the\ncode -- they are the temperature-deprecation matrix and the per-request-vs-config precedence\nrationale, and they are the reason the region is readable at all. Do not strip them to hit a number.\nPer AGENTS.md, do not create a module under 100 LOC by splitting: group these into ONE themed module\nrather than a file per function.\n\nWording MAY be tightened where a sentence carries no fact, but never drop a measured number, a\n`file:line` citation, a bug/story/epic id, a named failure mode, or a stated invariant. Deleting\ndocumentation to satisfy a size guard is the \"raise the cap\" anti-pattern ADR 0056 rejects by name.\n\n## Monkeypatch repoints — measure, do NOT assume zero\n\ne6bd owned ZERO repoints, but that was MEASURED for the except spine specifically and does not\ntransfer. Whichever of `cache_settings_for`, `_pai_model`, `_local_proxy_bypass_base_url` fall inside\nthe settings block this ticket actually moves must be repointed IN THE SAME COMMIT. Re-importing a\nmoved name back into `runner` fixes `from … import` callers but NOT `monkeypatch.setattr` patches,\nwhich rebind `runner`'s global while the extracted function resolves through its own module globals —\nso \"I re-exported it\" is never evidence a repoint was unneeded. Run the full suite and repoint what\nbreaks.\n\n## Testing\n\nUnit tier, no network -- pure given cfg/req/caps.\n\n## Acceptance Criteria\n\n- [ ] a test asserts temperature is WITHDRAWN for a caps record with supports_temperature False and\n      RETAINED when True -- the negative control is what stops a \"withdraw always\" implementation passing\n- [ ] a test asserts a per-request output cap can only RAISE the configured floor, never lower it\n- [ ] a test asserts a per-request step budget likewise only raises\n- [ ] `build_model_settings` performs no side effect: the `_TEMPERATURE_WITHDRAWN_LOGGED` mutation\n      still happens in `run()`, and `test_structured_run_has_no_runtime_import_from_runner` passes\n- [ ] the extracted module is at or above the 100-LOC anti-fragmentation floor, and\n      `structured_run.py` remains under 500 LOC\n- [ ] the durable end-state: `wc -l src/rebar/llm/runner.py` at this commit is under 700. This is\n      machine-enforced, not a promise —\n      `tests/unit/test_structured_run_seam.py::test_runner_regains_real_headroom_under_the_cap`\n      fails otherwise, and `Verified` is cast per patchset\n      (`.github/workflows/gerrit-verify.yaml` checks out `refs/changes/NN/NNNN/P`), so a red\n      ancestor blocks the whole relation chain\n- [ ] the commit message carries the measurement in a GREPPABLE form — two lines matching\n      `runner.py before: <N>` and `runner.py after: <M>`, with M < N and M < 700. Verify with:\n      `git log -1 --format=%B <sha> | grep -E 'runner\\.py (before|after): [0-9]+'`\n      (an outcome a reviewer can check from the artifact, not an unverifiable process step)\n- [ ] the seam guard actually covers the new move: `build_model_settings` and `build_usage_limits`\n      are added to BOTH hardcoded symbol lists in `tests/unit/test_structured_run_seam.py` — the\n      `for name in (...)` tuple in `test_moved_symbols_are_importable_from_the_new_module` and the\n      `defined & {...}` set literal in `test_runner_no_longer_defines_the_moved_symbols`. Without\n      this the guard silently passes while asserting nothing about either new function\n- [ ] `python -c \"from rebar.llm.structured_run import build_model_settings, build_usage_limits\"`\n      succeeds, and neither name is still defined in runner.py (the moved-not-copied contrast)\n- [ ] any monkeypatch target that moved is repointed IN THE SAME COMMIT and named in the message","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/runner.py","reason":"extract the model-settings and usage-limits block out of run()"},{"path":"src/rebar/llm/structured_run.py","reason":"destination for build_model_settings and build_usage_limits"},{"path":"tests/unit/test_structured_run_seam.py","reason":"add both new symbols to the two hardcoded seam-guard lists so the guard has teeth"},{"path":"tests/unit/","reason":"contract tests plus any monkeypatch repoint"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["blocks","a49e-3a93-9399-4756"],["parent","7f86-d935-3742-476a"]],"no_file_impact_reason":"","parent_id":"7f86-d935-3742-476a","parent_status_uuid":"89150535-b668-4905-9008-358e1770b163","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"8229-916b-dc27-4426","ticket_type":"task","title":"Extract build_model_settings() and build_usage_limits()","verify_commands":[]},"source_event_uuids":["b74b39ec-3ef7-4695-ab2d-43f610bec5bf","4d0787e9-e6d1-4d47-91c2-c6066778c445","0e5746fb-be01-4d7a-9a57-93503707d16a","02ec155b-c98b-48b8-807c-119b6ee68b40","791e1224-2f24-48bf-ac47-eed1c06dcea6","a8543b06-db84-4e87-8bef-ee39826cf9c1","69401ae4-8a9a-4627-9b52-8aac99103d19","a124ff27-556c-4409-9870-0df6cd76280d","9dbfaa11-6dfc-4812-9132-1ca56a004f77","e00d4f43-6f31-4d54-99ed-1f2a65b5916d","89150535-b668-4905-9008-358e1770b163","95da04b8-7b92-4184-9748-52aec019e1ab","5f9406ec-aee0-4b3b-8794-891aea97dcfa"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785525586504688873,"uuid":"d882b348-e2e9-4b0f-8eaf-a57e8ad3580d"}