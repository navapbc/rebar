{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, io, re, subprocess, sys, tokenize\nDIRECTIVE = re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|(?:fmt|isort):\\s*(?:on|off|skip)\\b|pyright:|mypy:|ruff:|pylint:|nosec\\b|coding[:=]|[A-Za-z][\\w-]*-ok:)\", re.I)\nOWNERS = (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)\ndef src(ref, path):\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\ndef norm_ast(text):\n    tree = ast.parse(text, type_comments=True)\n    for ti in tree.type_ignores:\n        ti.lineno = 0\n    for node in ast.walk(tree):\n        if isinstance(node, OWNERS) and node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n            node.body = node.body[1:]\n    return ast.dump(tree, include_attributes=False)\ndef directives(text):\n    shebang = text.splitlines()[0] if text.startswith(\"#!\") else \"\"\n    comments = [tok.string for tok in tokenize.generate_tokens(io.StringIO(text).readline) if tok.type == tokenize.COMMENT and DIRECTIVE.search(tok.string)]\n    return shebang, comments\nbad_ast, bad_directives = [], []\nfor path in sys.argv[1:]:\n    before, after = src(\"HEAD^\", path), src(\"HEAD\", path)\n    if norm_ast(before) != norm_ast(after): bad_ast.append(path)\n    if directives(before) != directives(after): bad_directives.append(path)\nassert not bad_ast, f\"non-docstring AST changes: {bad_ast}\"\nassert not bad_directives, f\"directive/shebang changes: {bad_directives}\"' scripts/check_import_walk.py scripts/check_mcp_library_parity.py scripts/check_mechanism_delta.py scripts/check_orphaned_load.py scripts/check_raw_git_writes.py scripts/check_repo_root_from_package.py scripts/check_repo_root_from_tracker.py scripts/check_server_manifest.py scripts/check_shellcheck.py scripts/check_ssm_secret_state.py scripts/check_templatefile_escapes.py scripts/check_tickets_boundary.py scripts/check_uv_pin.py scripts/check_verify_gate_parity.py scripts/dependency_audit.py scripts/gen_env_registry.py scripts/jira_dc_capability_map.py","dd_id":"python-prose-only","dd_text":"Require normalized non-docstring AST equivalence and exact directive/shebang preservation."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess, sys\ndef stable(ref, path):\n    text = subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\n    return [line for line in text.splitlines() if (s := line.lstrip()) and (not s.startswith(\"#\") or s.startswith(\"#!\"))]\nbad = [path for path in sys.argv[1:] if stable(\"HEAD^\", path) != stable(\"HEAD\", path)]\nassert not bad, f\"non-comment shell changes: {bad}\"' scripts/install-gerrit-hook.sh","dd_id":"shell-comment-only","dd_text":"Require the Gerrit hook installer to retain its shebang and all executable lines exactly."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/test_check_import_walk.py tests/unit/test_mcp_library_parity.py tests/unit/test_mechanism_delta.py tests/scripts/test_check_orphaned_load.py tests/unit/test_raw_git_write_lint.py tests/unit/test_repo_root_from_package_guard.py tests/unit/test_repo_root_from_tracker_guard.py tests/scripts/test_check_server_manifest.py tests/unit/test_check_shellcheck.py tests/unit/test_check_ssm_secret_state.py tests/unit/test_check_templatefile_escapes.py tests/unit/test_tickets_boundary_guard.py tests/unit/test_uv_pin_guard.py tests/unit/test_verify_gate_parity.py tests/scripts/test_dependency_audit.py tests/unit/test_dependency_advisory_wiring.py tests/unit/test_gen_env_registry.py tests/unit/test_env_registry_helper_coverage.py tests/unit/test_gerrit_hook_install.py tests/unit/test_jira_dc_capability_map_workflow.py","dd_id":"focused-tool-contracts","dd_text":"Exercise every edited tool's nearest current contract suite."},{"command":"rtk git diff --check HEAD^ HEAD -- scripts/check_import_walk.py scripts/check_mcp_library_parity.py scripts/check_mechanism_delta.py scripts/check_orphaned_load.py scripts/check_raw_git_writes.py scripts/check_repo_root_from_package.py scripts/check_repo_root_from_tracker.py scripts/check_server_manifest.py scripts/check_shellcheck.py scripts/check_ssm_secret_state.py scripts/check_templatefile_escapes.py scripts/check_tickets_boundary.py scripts/check_uv_pin.py scripts/check_verify_gate_parity.py scripts/dependency_audit.py scripts/gen_env_registry.py scripts/jira_dc_capability_map.py scripts/install-gerrit-hook.sh","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in all declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"Run the complete repository verification gate before review."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788607259678905001,"uuid":"6ea886f6-d78f-4a28-83cc-f52100545497"}