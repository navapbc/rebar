{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787430626798801001,"compiled_state":{"alias":"immoderate-luxuriant-caiman","assignee":null,"attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"6a5c88027c59d3e24d3e4269838fb3c591a64240","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 65c9-aba3-c744-483a","material: 6f191e2daaaa5fe9","material-part: children 647ea2107ca5072f 0","material-part: description 5ed7477491de2f57 6602","material-part: description_boxes 56d624e8862ff6a2 0","material-part: file_impact be8e8ac0682bf0b9 35","material-part: ticket_id 5da103f4c9078253 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (6a5c88027c5-dirty)","regver: aa61189569d34126","verified-at-sha:53eaea07aa2fc5baf5898ff2c279ec348b7601fa","dep b4ff5ad2a12171435084235823ad24eefdb153096e70f56fef8a9212e87957b1 docs/cli-reference.md","dep a30fef3252e34628f5765ab2057e3cbfcf077f71965ffa9c432cbffa10188c35 scripts/gen_cli_help.py","dep f7dfc1fcaf38dccb6d8344336e46b41f48b9613f6cdc7a175e4b95913d162e00 scripts/gen_cli_reference.py","dep 9b5e8baa403640768c5c5fd5fa34d05cd8b04a7fb168af191385b9ad3d1b088c src/rebar/_cli/_help_route.py","dep 3beb07280395182ba61bd06ff584019c75723fe804311b73494d164f3ad714bd src/rebar/_cli/_parsers/advanced/certs.py","dep e333a206190f7715bbede08aceaf6f4b8a4cad71e9f122da8e34da7739e0545e src/rebar/_cli/_parsers/advanced/enrich.py","dep 1bebf533784840dc227ad4536361a46e56ceb10fa9e283501103678618aa17bb src/rebar/_cli/_parsers/advanced/identity.py","dep d2f52b5ef2dd7ab81de222228810ab70