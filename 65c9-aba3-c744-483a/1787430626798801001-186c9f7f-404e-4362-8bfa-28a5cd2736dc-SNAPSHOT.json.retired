d-path: src/rebar/_cli/__init__.py","read-path: src/rebar/_cli/_help.py","read-path: src/rebar/_cli/_help_route.py","read-path: src/rebar/_cli/_parsers/advanced/certs.py","read-path: src/rebar/_cli/_parsers/advanced/config.py","read-path: src/rebar/_cli/_parsers/advanced/enrich.py","read-path: src/rebar/_cli/_parsers/advanced/identity.py","read-path: src/rebar/_cli/_parsers/advanced/llm.py","read-path: src/rebar/_cli/_parsers/advanced/reconcile.py","read-path: src/rebar/_cli/_registry.py","read-path: src/rebar/_commands/show_config.py","read-path: src/rebar/_commands/trusted_env_cmd.py","read-path: tests/interfaces/contracts/test_cli_registry_distribution.py","read-path: tests/interfaces/contracts/test_create_help_no_write_b8de.py","read-path: tests/interfaces/contracts/test_help_overview_coverage.py","read-path: tests/interfaces/contracts/test_parser_formatter_pinned.py","read-path: tests/unit/test_gen_cli_help.py","read-path: tests/unit/test_gen_cli_reference.py","currency-basis: file_impact"],"material_fingerprint":"6f191e2daaaa5fe9","merged_log_commit":"53eaea07aa2fc5baf5898ff2c279ec348b7601fa","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787426138097586000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":18,"unsigned":0},"authorship_ledger":[{"content_hash":"cc1de34a407a10ad2a44512fc4ef47f5a0e5c70f6ce1b08e459701b43999abf8","event_uuid":"ad529aa7-d4eb-438f-881b-86ea96439e05","position":{"commit_sha":"0f60fd564a68923291896004d87d8d61aabee727","position":"1787420123375593001-ad529aa7-d4eb-438f-881b-86ea96439e05"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"33ab50c773f801b7476fcad