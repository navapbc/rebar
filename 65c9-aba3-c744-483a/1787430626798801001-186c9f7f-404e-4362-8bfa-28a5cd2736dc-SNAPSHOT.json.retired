\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cfa6059ee2e31a13ef1631002aaeea95102349269aab7a5ed9d76e01b16fbc5d","event_uuid":"b73a1846-a686-4015-9e6c-40b32b7e063a","position":{"commit_sha":"08a7f8702f5177b7c33bdcd68973478ac471a0a5","position":"1787423188463597001-b73a1846-a686-4015-9e6c-40b32b7e063a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2c5b92b59dec0b2520399fd27fe03b1ae214d0b96a0d96dbefd4c2dae6545078","event_uuid":"33434289-e869-4910-91f6-5414ac90a4d0","position":{"commit_sha":"5f9ae0107576ea20c3f08b1e34feb266c593c30e","position":"1787423220530969001-33434289-e869-4910-91f6-5414ac90a4d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2fa83859dad1172ea0387991beff28d5d2f1c8a62340c3fc3da36ae8628de6fe","event_uuid":"9a974581-b8c7-431b-b73b-d8bed6bad952","position":{"commit_sha":"8c20bb8d0759c4566477dd61c4d791dbaecc03da","position":"1787423237257475001-9a974581-b8c7-431b-b73b-d8bed6bad952"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"421927c8c5bf7a7caef4dd304d487f29f047468b1cdae23c60f66086476034ab","event_uuid":"71142e95-b1aa-4904-b1c4-78469a3f96cd","position":{"commit_sha":"9b755e95269715b6547d817612a234cdd7e98c7a","position":"1787425448465238001-71142e95-b1aa-4904-b1c4-78469a3f96cd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7b6d7413bd49683ce2824e899552257f075ff3cd951ab4b7d967b5afd0101fd3","event_uuid":"d7a292d0-d2ef-498f-9446-c1aa0d46c4ee","position":{"commit_sha":"d7a39e20d1e783cd86724fe33d30b3ed2a2d28b7","position":"1787425476909871001-d7a292d0-d2ef-498f-9446-c1aa0d46c4ee"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"50e735be983fd0cf8edcac70e7270aa1703672a682011f50b7c43bcc228bdbcd","event_uuid":"511714e2-5052-4f04-90ae-92fa4eade6fc","position":{"commit_sha":"50aa2985c3e2f5afc021f985e12e71f8397dc8ee","position":"1787426138125514001-511714e2-5052-4f04-90ae-92fa4eade6fc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review remediation for blocking finding fe026a21741d96d81: clarified that existing gen_cli_help rendering applies the version-stable usage/metavar normalization contract, both public help entry points serve the exact same committed bytes, and raw argparse fallthrough ends only for registry-declared top-level help owners. Also replaced the representative-route test with registry-driven coverage of all visible canonical intercept routes. Scope remains the ADR 0100 help-discovery slice; no new router, parser, help source, or writing-policy enforcement was added.","timestamp":1787418428121660001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Second plan-review remediation for findings f7933b1b934bcd188, faa324f55e688c487, f6ce8b8cd4fedff2e, f580040ac6aec2172, and f64cc306b459cc6c2: named the concrete helper move into gen_cli_help, removed the independent reference renderer in favor of committed-byte consumption, enumerated the runtime/generator census seams, pinned the exact no-new-metadata ownership predicate, preserved nested argparse fallthrough, and reconciled the two existing overview exemptions. Acceptance checks were split and now cover the preserved branch. The operator-approved rejection of mechanical writing enforcement and the Markdown-only reduced test policy remains explicit and unchanged.","timestamp":1787419173255642001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Third plan-review remediation for findings f81010e3af4b0c56f, f3b23ede1a6113c69, f7b491a6d405c9916, and f4d3c72907ada4387: enumerated both test consumers, mirrored the routable census, added the four missing route-owned parser summaries, and preserved trusted-env explicit multiline usage by gating `_unwrap_usage` on `parser.usage is None`. Also named the existing 3.11/3.12/3.13 matrix proof, retained the formatter-contract exception, split compound acceptance checks, and kept the no-mechanical-writing-enforcement and Markdown-only reduced-test policies unchanged.","timestamp":1787420142112964001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fourth plan-review remediation for finding fe646dc4830c0e337 and advisory fb2c90d4aae439718: expanded `_NESTED_INTERCEPTS` to the full import-safe set `audit`, `identity`, `llm`, `prompt`, `criteria`, `workflow`; added the fourth inlined help-backed census site; and made the parser-introspective contract test prove runtime membership plus child-help fallthrough. Tightened acceptance criteria below the oversize threshold while retaining the rejection of mechanical writing enforcement and the unchanged Markdown-only reduced test policy.","timestamp":1787420929405321001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Execution preflight found that the remediated plan named parser factories, the CLI reference generator, generated route artifacts, and contract tests that were absent from the recorded file impact. Replaced the seven-path declaration with the complete 35-path planned edit set and expanded verification to cover both generators, focused unit contracts, public help parity, nested-family no-write behavior, formatter scope, lint, and type checking. This material correction intentionally invalidates the earlier attestation. A fresh plan review is required before claim.","timestamp":1787423237257475001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fifth plan-review remediation for blocking finding f81034227578a46fd: added `config` to the exact `_NESTED_INTERCEPTS` set; documented that `config validate` is a handler-dispatched pseudo-subcommand with no populated argparse `_SubParsersAction` and therefore cannot be discovered by parser introspection; and added an explicit `rebar config validate --help` plan and acceptance check proving control reaches `build_validate` and returns validate child help instead of top-level config help. The 35-path material scope remains unchanged, as do the explicit rejection of mechanical writing enforcement and the Markdown-only reduced test policy.","timestamp":1787425476909871001}],"created_at":1787417227306077001,"creation_channel":"cli","deps":[],"description":"## Context\nADR 0100 makes the immutable route registry and parser factories the authority for command identity, grammar, and committed help. Twenty-one visible pure-intercept routes support `rebar <command> --help` but remain absent from overview help and fail under `rebar help <command>`.\n\n## Plan\n- Make the help-backed predicate exactly `not route.hidden and not route.retired` in all four current census sites: `scripts/gen_cli_help.py::_help_backed`, `src/rebar/_cli/_help_route.py::_help_backed`, `tests/interfaces/contracts/test_help_overview_coverage.py::_routable_subcommands`, and `tests/interfaces/contracts/test_create_help_no_write_b8de.py::_help_backed_nested_families`. Do not add Route metadata.\n- Expand the import-safe runtime `_NESTED_INTERCEPTS` set to exactly `audit`, `config`, `identity`, `llm`, `prompt`, `criteria`, and `workflow`. The argparse-backed families own populated subparsers, while `config validate` is a handler-dispatched pseudo-subcommand with no populated `_SubParsersAction`, so `config` cannot be discovered by parser introspection and must be explicit. A non-leading child `--help` must still reach the owning child parser or handler. Keep the bridge-factory derivation in `_NESTED_FAMILY` unchanged.\n- Keep the parameterized nested-family test parser-introspective for argparse-backed families: derive every live help-backed parser with a populated `_SubParsersAction`, assert that population matches `_NESTED_FAMILY`, then prove each `rebar <family> <child> --help` returns child usage. Runtime stays import-isolated while the test detects future membership drift.\n- Add a focused `rebar config validate --help` contract proving the handler-dispatched pseudo-subcommand reaches `build_validate` and returns validate child help rather than the committed top-level `config` artifact; this case is explicit because parser introspection cannot discover it.\n- Add concise parser `description=` values to the four pure-intercept factories that currently lack them: `reconcile.build`, `enrich.build`, `identity.build`, and `certs.build_trusted_env`. These route-owned descriptions supply overview one-liners without registry prose.\n- Move `_unwrap_usage` and `_collapse_metavars` from `scripts/gen_cli_reference.py` into `scripts/gen_cli_help.py`. In `render_route`, apply `_unwrap_usage` only when `route.group == \"intercept\"` and `parser.usage is None`; apply `_collapse_metavars` to intercept option-invocation lines before existing byte normalization.\n- Pin the explicit-usage exception with `trusted-env`: its author-supplied `add` and `revoke` usage forms remain on separate lines. Other pure-intercept artifacts normalize argparse-generated usage across Python versions.\n- Generate one committed `help/<route>.txt` artifact for each newly help-backed intercept route. Existing `_help.py` file lookup, `subcommand_help`, and `known_subcommands` serve those files without a second renderer.\n- Let `_help_route.pre_scan` serve top-level pure-intercept help through the widened predicate. The expanded nested-family set preserves child-help ownership for `audit`, `config`, `identity`, `llm`, `prompt`, `criteria`, `workflow`, plus the existing bridge family.\n- Delete `_render_intercept` from `scripts/gen_cli_reference.py`; make `_syntax_body` require `help_mod.subcommand_help(route.name)` for every documented route.\n- Migrate both direct `_render_intercept` consumers in `tests/unit/test_gen_cli_reference.py` to the committed `review-plan` body. Confirm zero remaining semantic or string references repository-wide.\n- Retain `_OVERVIEW_OMIT` as exactly `bridge-fsck` and `bridge-probe`. Retain the matching test allowlist as exactly `help`, `bridge-fsck`, and `bridge-probe`; no pure-intercept route is exempt.\n- Keep `tests/interfaces/contracts/test_parser_formatter_pinned.py` scoped away from pure-intercept parsers and update its rationale: generator normalization permits those parsers to retain stdlib `HelpFormatter`.\n- Regenerate package help, overview help, and the CLI reference through the existing generators. The existing `_build-and-test.yml` Python 3.11, 3.12, and 3.13 cells each run the help drift check against the same committed bytes.\n- Add registry-driven coverage for all pure-intercept routes, both top-level help surfaces, factory-summary completeness, reference consumption, explicit multiline usage, every derived argparse nested-family fallthrough case, and the explicit handler-dispatched `config validate --help` case.\n- Do not add another router, parser, help source, mechanical writing-policy gate, or change to the Markdown-only reduced test policy.\n\n## Acceptance Criteria\n- [ ] Every live visible route outside the exact documented overview omit set appears exactly once in overview help.\n- [ ] `rebar help <command>` succeeds for every canonical pure-intercept route returned by the registry.\n- [ ] The registry-driven pure-intercept help test proves no command handler executes.\n- [ ] The registry-driven pure-intercept help test proves no ticket store is mounted or created.\n- [ ] `rebar help <command>` returns the exact matching committed artifact bytes.\n- [ ] Top-level `rebar <command> --help` returns the exact matching committed artifact bytes.\n- [ ] Every pure-intercept parser factory supplies a non-blank overview description.\n- [ ] The committed `trusted-env` usage banner preserves separate `add` and `revoke` lines.\n- [ ] Existing Python 3.11, 3.12, 3.13 matrix cells each pass `python scripts/gen_cli_help.py --check`.\n- [ ] Each CLI-reference pure-intercept syntax block equals the matching committed artifact.\n- [ ] A repository-wide semantic-plus-string search reports zero `_render_intercept` references.\n- [ ] All four help-backed census sites use the live-visible predicate.\n- [ ] The exact overview exemptions remain `help`, `bridge-fsck`, `bridge-probe`.\n- [ ] Hidden aliases remain absent from overview discovery.\n- [ ] Retired spellings remain absent from overview discovery.\n- [ ] `_NESTED_INTERCEPTS` equals `audit`, `config`, `identity`, `llm`, `prompt`, `criteria`, `workflow`.\n- [ ] The parameterized nested-family test returns child-parser usage for every parser-introspectable derived member.\n- [ ] `rebar config validate --help` reaches `build_validate` and returns validate child help rather than top-level config help.\n- [ ] The help drift check passes.\n- [ ] The CLI-reference drift check passes.\n- [ ] No competing routing, parser, or help mechanism is introduced.\n- [ ] No mechanical writing enforcement is introduced.\n- [ ] The Markdown-only reduced test policy remains unchanged.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"scripts/gen_cli_help.py","reason":"Generate committed help for every live visible route and normalize intercept usage."},{"path":"scripts/gen_cli_reference.py","reason":"Consume committed help for every documented route and remove the separate intercept renderer."},{"path":"src/rebar/_cli/_help_route.py","reason":"Serve committed help for visible intercept routes while preserving nested-family ownership."},{"path":"src/rebar/_cli/_parsers/advanced/reconcile.py","reason":"Provide the route-owned overview description."},{"path":"src/rebar/_cli/_parsers/advanced/enrich.py","reason":"Provide the route-owned overview description."},{"path":"src/rebar/_cli/_parsers/advanced/identity.py","reason":"Provide the route-owned overview description."},{"path":"src/rebar/_cli/_parsers/advanced/certs.py","reason":"Provide the trusted-env route-owned overview description."},{"path":"src/rebar/_cli/help/overview.txt","reason":"Regenerate the complete top-level command overview."},{"path":"src/rebar/_cli/help/workflow.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/verify-opcert.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/verify-identity.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/verify-completion.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/verify-commit-ticket.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/verify-authorship.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/trusted-env.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/sign-review.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/scan-spec.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/review-plan.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/review-code.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/remote-cert.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/reconcile.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/prompt.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/llm.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/jira-onboard.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/identity.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/explain.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/enrich.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/criteria.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"src/rebar/_cli/help/config.txt","reason":"Add the generated committed help artifact for this live visible route."},{"path":"docs/cli-reference.md","reason":"Regenerate command syntax from committed help artifacts."},{"path":"tests/unit/test_gen_cli_help.py","reason":"Pin complete help generation, summaries, and explicit usage handling."},{"path":"tests/unit/test_gen_cli_reference.py","reason":"Pin committed-help consumption and removal of the intercept renderer."},{"path":"tests/interfaces/contracts/test_help_overview_coverage.py","reason":"Use the live-visible route census for overview and artifact parity."},{"path":"tests/interfaces/contracts/test_create_help_no_write_b8de.py","reason":"Pin all nested-family fallthrough cases under the widened help census."},{"path":"tests/interfaces/contracts/test_parser_formatter_pinned.py","reason":"Align formatter-scope guidance with generator normalization."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","f7e4-4d33-f231-4774"]],"no_file_impact_reason":"","parent_id":"f7e4-4d33-f231-4774","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f12","cli"],"ticket_id":"65c9-aba3-c744-483a","ticket_type":"story","title":"F12 complete ADR 0100 CLI command discovery","verify_commands":[{"command":"python scripts/gen_cli_help.py --check","dd_id":"D1","dd_text":"Committed CLI help is current"},{"command":"python scripts/gen_cli_reference.py --check","dd_id":"D2","dd_text":"Generated CLI reference is current"},{"command":"python -m pytest tests/unit/test_gen_cli_help.py tests/unit/test_gen_cli_reference.py -q","dd_id":"D3","dd_text":"Focused help generators preserve artifact and reference contracts"},{"command":"python -m pytest tests/interfaces/contracts/test_help_overview_coverage.py tests/interfaces/contracts/test_create_help_no_write_b8de.py tests/interfaces/contracts/test_parser_formatter_pinned.py tests/interfaces/facades/test_cli_argparse.py tests/interfaces/facades/test_central_mount_gate_ad9f.py -q","dd_id":"D4","dd_text":"Registry, no-write help, nested-family, formatter, and public help contracts pass"},{"command":"make lint && make typecheck","dd_id":"D5","dd_text":"Source lint and type checks pass"}]},"source_event_uuids":["ad529aa7-d4eb-438f-881b-86ea96439e05","c4e1a3e8-a1eb-4948-8cc8-fb0f8bfc8d0b","d765f749-1683-4bd6-983d-eb5f9334b71f","0eb32967-1c33-4f17-af2a-89633ea1804b","78c88d7c-41a4-4e48-aa72-81689f728e66","b73a1846-a686-4015-9e6c-40b32b7e063a","33434289-e869-4910-91f6-5414ac90a4d0","9a974581-b8c7-431b-b73b-d8bed6bad952","71142e95-b1aa-4904-b1c4-78469a3f96cd","d7a292d0-d2ef-498f-9446-c1aa0d46c4ee","511714e2-5052-4f04-90ae-92fa4eade6fc"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787430626798801001,"uuid":"186c9f7f-404e-4362-8bfa-28a5cd2736dc"}