{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, subprocess, sys\ndef norm(ref, path):\n    src = subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\n    tree = ast.parse(src, type_comments=True)\n    for ti in tree.type_ignores:\n        ti.lineno = 0\n    for node in ast.walk(tree):\n        body = getattr(node, \"body\", None)\n        if isinstance(body, list) and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            node.body = body[1:]\n    return ast.dump(tree, include_attributes=False)\nbad = [p for p in sys.argv[1:] if norm(\"HEAD^\", p) != norm(\"HEAD\", p)]\nassert not bad, f\"non-prose AST changes: {bad}\"' scripts/_backtest/__init__.py scripts/hooks/serena_grep_reminder.py","dd_id":"python-prose-only","dd_text":"Compare Python ASTs after removing docstrings and normalizing TypeIgnore line numbers so only comments/docstrings may differ."},{"command":"rtk git diff --exit-code --ignore-matching-lines=\"^\\([[:space:]]*#[^!].*\\|[[:space:]]*#[[:space:]]*\\|[[:space:]]*;.*\\|[[:space:]]*<!--.*\\|[[:space:]]*.*-->\\|[[:space:]]*\\)$\" HEAD^ HEAD -- scripts/jira-pressure-test/e2e_field_validation_probe.sh scripts/jira-pressure-test/e2e_validation_probe.sh","dd_id":"shell-comment-only","dd_text":"Prove shell probes changed only standalone comments or blank lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_serena_grep_reminder_hook.py tests/scripts/test_jira_pressure_test_preflight.py","dd_id":"focused-tool-tests","dd_text":"Exercise hook parsing/output and pressure-probe opt-in/preflight contracts."},{"command":"rtk git diff --check HEAD^ HEAD -- scripts/_backtest/__init__.py scripts/hooks/serena_grep_reminder.py scripts/jira-pressure-test/e2e_field_validation_probe.sh scripts/jira-pressure-test/e2e_validation_probe.sh","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in all declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make lint","dd_id":"repository-gates","dd_text":"Run repository lint and policy gates."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788606913098379001,"uuid":"47c7cf7f-83c6-4295-884d-8e1d484fa04a"}