1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3e2a30d8b68397cc29019576e13fc99118f6bb7b3fac90e7e4c11b43c6e629ae","event_uuid":"7e70c873-6814-4aee-be96-1b300c719bf9","position":{"commit_sha":"199d075348439d0002e8ff25dccedbf9f598ecd9","position":"1787358829721797001-7e70c873-6814-4aee-be96-1b300c719bf9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Resumed after mid-work cancellation. Found Gerrit change 2031 already MERGED (LLM-Review +1, Verified +1, merged 2026-08-21 23:53 UTC) as commit 0b5356e741 on origin/main. Verified all acceptance criteria against the merged code: pytest tests/unit/test_verdict_provenance.py tests/unit/test_bedrock_provider.py — 85 passed. Precedence unchanged (CLI > REBAR_LLM_BEDROCK_REGION > repo-config, then AWS_DEFAULT_REGION > AWS_REGION); label derived from the same resolution pass via _llm_str_source, carried as LLMConfig.bedrock_region_source, threaded through runner/provenance_for to resolve_bedrock_region. Pure in-process labeling, nothing CI-specific. Checked the AC boxes; closing.","timestamp":1787356970826624001}],"created_at":1787335938152526001,"creation_channel":"cli","deps":[{"link_uuid":"845c6cad-326c-4a78-8364-68cea8101e0c","relation":"discovered_from","target_id":"adb6-4762-90f6-4e30"},{"link_uuid":"6e295ce0-fcb8-4672-b7c4-aa7f3a486194","relation":"relates_to","target_id":"62d3-8e34-6333-486d"},{"link_uuid":"fc9e11be-3aa1-4fd3-843c-7eda008d607f","relation":"relates_to","target_id":"169f-66ab-f39c-4512"}],"description":"## Context / Problem\nSplit out of bug adb6-4762-90f6-4e30 (peach-chemic-hairstreak) by operator ruling (2026-08-21): the fresh-shell fix pins bedrock_region_name = \"us-east-1\" in rebar.toml's [llm] table, but the verdict's provider provenance cannot yet truthfully record that the region came from repo config.\n\nRCA finding (proven statically on the bug ticket, 2026-08-17): LLMConfig.from_env collapses CLI/env/config-file resolution of bedrock_region_name into ONE string via _llm_str (src/rebar/llm/config.py), discarding the value's origin. resolve_bedrock_region (src/rebar/llm/bedrock_model.py) then labels EVERY configured non-empty value as region_source=REBAR_LLM_BEDROCK_REGION — so a rebar.toml pin is mislabeled as the env var in provenance records (pinned today by tests/unit/test_verdict_provenance.py, which asserts region_source == \"REBAR_LLM_BEDROCK_REGION\" for a configured region).\n\n## Approach\nAdd source metadata/plumbing so provenance records region_source truthfully (\"repo-config\" for the config-file table, \"cli\" for `rebar -c llm.bedrock_region_name=…`, and the existing \"REBAR_LLM_BEDROCK_REGION\" / \"AWS_DEFAULT_REGION\" / \"AWS_REGION\" labels), without changing which value wins. The label is derived from the SAME single resolution pass that produced the value (a source-returning variant of _llm_str that _llm_str delegates to), carried on LLMConfig as bedrock_region_source, and threaded to resolve_bedrock_region / provenance_for — never re-derived independently, so record and runtime cannot diverge. Operator caution (recorded on the bug ticket): provenance labeling may interact with config wiring and env-var handling — design to avoid regression there, and maintain portability across diverse environments (no CI-provider-specific trigger; see project.portability).\n\n## File impact\n- src/rebar/llm/config.py — carry the resolved region's origin (do not regress _llm_str precedence: CLI > env > file > default)\n- src/rebar/llm/bedrock_model.py — resolve_bedrock_region labels the configured value by its true source\n- src/rebar/llm/capabilities.py — provenance_for threads the configured source into the resolver\n- src/rebar/llm/runner.py — thread cfg.bedrock_region_source alongside cfg.bedrock_region_name\n- tests/unit/test_verdict_provenance.py, tests/unit/test_bedrock_provider.py — update/extend the pins\n\n## Testing\nRED first: extend `tests/unit/test_bedrock_provider.py` and `tests/unit/test_verdict_provenance.py` with the truthful-label pins (they fail against the current always-REBAR_LLM_BEDROCK_REGION labeling), then implement. Prove with:\n- `pytest tests/unit/test_bedrock_provider.py tests/unit/test_verdict_provenance.py` — the full precedence+label matrix and the provenance record pins.\n- `pytest tests/unit/test_llm_config.py tests/unit/test_llm_model_env_removal.py` (or the nearest config-layer suites) — no regression in the CLI > env > file resolution wiring.\n- `make lint` and `make typecheck` — the complexity ratchet and types stay green.\n\n## Acceptance Criteria\n- [x] A region resolved from the config-file table is recorded in provider provenance as region_source=\"repo-config\", not \"REBAR_LLM_BEDROCK_REGION\" (verified: `pytest tests/unit/test_verdict_provenance.py`).\n- [x] A region resolved from the REBAR_LLM_BEDROCK_REGION env var keeps region_source=\"REBAR_LLM_BEDROCK_REGION\"; AWS_DEFAULT_REGION / AWS_REGION keep their existing labels (verified: `pytest tests/unit/test_verdict_provenance.py tests/unit/test_bedrock_provider.py`).\n- [x] A region resolved from `rebar -c llm.bedrock_region_name=…` is labeled \"cli\" (verified: `pytest tests/unit/test_bedrock_provider.py`).\n- [x] Resolution precedence is unchanged: CLI > REBAR_LLM_BEDROCK_REGION > config file, then AWS_DEFAULT_REGION > AWS_REGION; every source combination's precedence+label pair is pinned (verified: `pytest tests/unit/test_bedrock_provider.py`).\n- [x] The resolved region VALUE and every provider build path are byte-identical for identical inputs — the label is additive metadata only (verified: the existing build-path tests in `tests/unit/test_bedrock_provider.py` pass with no wiring changes).\n- [x] Works with no CI provider present: pure in-process labeling with nothing CI-specific (checked: the diff touches only library code + unit tests, no CI-provider hooks).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/config.py","reason":"carry the resolved bedrock_region_name origin without regressing CLI > env > file precedence"},{"path":"src/rebar/llm/bedrock_model.py","reason":"resolve_bedrock_region labels a configured region by its true source instead of always REBAR_LLM_BEDROCK_REGION"},{"path":"src/rebar/llm/capabilities.py","reason":"provenance_for threads the configured region source into the resolver"},{"path":"src/rebar/llm/runner.py","reason":"thread cfg.bedrock_region_source alongside cfg.bedrock_region_name"},{"path":"scripts/gen_env_registry.py","reason":"env-registry generator entry for the source-labeled region knob"},{"path":"docs/env-vars.md","reason":"regenerated env-vars registry documenting the truthful region_source labels"},{"path":"tests/unit/test_verdict_provenance.py","reason":"update the region_source pins to the truthful labels"},{"path":"tests/unit/test_bedrock_provider.py","reason":"extend the region-resolution pins for the new source labels"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","169f-66ab-f39c-4512"],["relates_to","62d3-8e34-6333-486d"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"92d01124-b2c3-4692-9cd3-6256739101ed","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"cda8-0f27-b324-4446","ticket_type":"task","title":"Label Bedrock region provenance (region_source) accurately when the region comes from repo config","verify_commands":[]},"source_event_uuids":["95774f52-e622-417c-81ae-9ab682eb6292","de70dc08-8ea3-4b64-a912-b189e8c0462c","abebb417-9fa3-4a9a-8cde-ce95dec1e809","448749d3-5b4a-4998-af2d-d80c385d29f8","6e295ce0-fcb8-4672-b7c4-aa7f3a486194","fc9e11be-3aa1-4fd3-843c-7eda008d607f","1cb5647b-848e-48b3-81f1-851d18faab2d","5d425ea0-20a3-42be-926f-68bd86f81c0f","d3f15847-8368-4b8c-b1fb-35145cd36d95","0bfaec7c-70b4-4523-8e73-e8c0de81165b","92d01124-b2c3-4692-9cd3-6256739101ed","7e70c873-6814-4aee-be96-1b300c719bf9"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787361445308666001,"uuid":"8fc95fca-ca07-4fb2-8d3b-3fd28e821e96"}