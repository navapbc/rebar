99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f675028d9151b9fb56a37dc1aeb5e5e0ae61b2597552b766eeaefb60c3ac8a57","event_uuid":"17a63428-f8a2-4f36-9444-e6778a94b715","position":{"commit_sha":"64df16bac674846995446c890523cad073c7791c","position":"1785018361685820001-17a63428-f8a2-4f36-9444-e6778a94b715"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0b4235142f72628bc3dfd8abc2ba514f3d3c0c22236d2f3084ea5dc547408638","event_uuid":"8ce861c7-0d1a-4abd-adc5-db8ba1c532f4","position":{"commit_sha":"d8decd13c9007a03bc7fbac631f7a80c4c845ab4","position":"1785019874850814001-8ce861c7-0d1a-4abd-adc5-db8ba1c532f4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"3ca86ca0-4a66-4c30-b883-1d7f630a49fb","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## HANDOFF — work is COMPLETE and pushed; only the close remains\n\n**State:** implementation done, committed, pushed. Gerrit change **977**\n(https://rebar.solutions.navateam.com/c/rebar/+/977), commit `9bdafc942`, branch\n`impl-ac-collapse` in worktree `~/impl-ac-collapse`.\n\n| gate | state |\n|---|---|\n| `LLM-Review` | **+1** |\n| `Verified` (CI) | **pending at handoff** |\n| unresolved comments | 0 |\n\nLocal full suite `make test` exit 0; `make lint` and `make typecheck` clean.\n\n**To finish this ticket:**\n1. Wait for `Verified +1` on 977 (if `-1`, open the run; comment `recheck` if it is a flake).\n2. Submit 977. It sits on top of already-merged 969/971, so it should submit alone.\n3. `git fetch origin && git reset --hard origin/main` **in the worktree** (Gerrit rebases\n   server-side, so `--ff-only` will refuse; never fast-forward the shared main checkout).\n4. `rebar transition 2aa6-726a-ea56-4d6c in_progress closed`.\n   **Expect the close gate to demand a fresh `rebar review-plan` first** — I amended AC1 and\n   AC3 during implementation (see below), which invalidates the attestation as\n   `stale-material`. That is expected, not a defect.\n5. Closing this unblocks **93d0** and **44c7** (both depend only on 2aa6 + 35bc, and are\n   file-disjoint from each other), then **5f4d** last.\n\n**Two acceptance criteria were amended, with rationale recorded in the description:**\n- **AC1** said the whole `src/rebar/llm/reviewers/` tree must return no SC matches, which\n  contradicted this story's own Scope and AC6. It now permits exactly the three sites Scope\n  deliberately excludes: `plan_review_T2.md` (generic English about a trial's success\n  metrics) and the `dod_uncertifiable` wording in both verifier prompts.\n- **AC3** said the generated criteria guide's SC grep must be empty. Unsatisfiable: the guide\n  is a GENERATED snapshot of the registry and embeds T2's excluded prompt verbatim. Now\n  asserts exactly one match — strictly stronger, since it also proves the phrase survived.\n\n**Verified acceptance criteria at handoff:** AC1 (11 in-scope hits gone, only the 3 excluded\nremain), AC2 (no bare `SC` in G3), AC3 (guide regenerated, banner intact, exactly one\nmatch), AC4 (grandfathering live — the regver suite passes against this checkout), AC5\n(`registry_version` rotation test, both stamps captured at run time), AC6 (T2 keeps its one\nmatch), AC7 (lint/typecheck/suite green).\n\n**TDD:** oracle 10 cases, RED-first; implementer saw only the 2 collapse assertions and never\nthe 3 anti-overreach guards. Held-out validation 9/10 first pass; the single miss was my own\nover-specified AC3 test, not an implementation defect. Mutation: 3/3 killed, including\nwrongly renaming T2's excluded phrase.","timestamp":1785018361685820001}],"created_at":1784944744999925001,"creation_channel":"cli","deps":[{"link_uuid":"c7d383bc-9859-479a-85d2-d1c344544d43","relation":"depends_on","target_id":"1f32-f86e-8a51-4d8e"},{"link_uuid":"8ce861c7-0d1a-4abd-adc5-db8ba1c532f4","relation":"relates_to","target_id":"e7be-b985-c344-46f7"},{"link_uuid":"a4122988-f857-464e-8f15-e80dcfa07a11","relation":"relates_to","target_id":"2cdc-87f4-5282-4e11"}],"description":"## Why\n\nEvery plan-review criterion that mentions the two headings POOLS them and applies ONE bar —\nF1 reads \"each acceptance/success criterion\", G3 \"each parent acceptance/success criterion\",\nG7 fetches \"What/Scope/Success Criteria/Acceptance Criteria\" as one contract. The dual\nvocabulary is therefore noise in the rubrics: it suggests to the reviewing model a distinction\nthe criteria do not implement, and it is the source the generated criteria guide is built from.\nThis story removes it at the source.\n\n## What\n\nRename Success Criteria -> Acceptance Criteria throughout the reviewer prompts and the criteria\nrouting index, then REGENERATE the criteria guide from them.\n\n## Scope\n\nReviewer prompts (`src/rebar/llm/reviewers/`):\n- `plan_review_F1.md:10` — \"each acceptance/success criterion\" -> \"each acceptance criterion\"\n- `plan_review_G3.md:10` and `:12` — line 12 carries BOTH bare-`SC` tokens in the repo:\n  \"THREE SC-CONTRADICTION PATTERNS\" and \"'SC says zero matches, the DD annotates exceptions'\"\n- `plan_review_G5.md:19` (\"a set of unrelated success criteria\" — the decomposition tell,\n  which DOES mean the ticket's criteria), `plan_review_G7.md:12` and `:16`,\n  `plan_review_COH.md:10`, `plan_review_container.md:14`\n- `completion_verifier.md:59` — the Epic bullet naming `## Success Criteria`\n\nRouting index `src/rebar/llm/plan_review/criteria_routing.json` — the `check` strings at\n`:544` (COH), `:830` (G3), `:908` (G7).\n\nRegenerate `docs/plan-review-criteria-guide.md` with\n`python -m rebar.llm.plan_review.registry regenerate-criteria-guide` — it is GENERATED and\ncarries a do-not-hand-edit banner; all 11 of its SC hits are downstream of the files above.\n\nEXPLICITLY EXCLUDED — `plan_review_T2.md:10`. Its phrase is \"a pilot with success metrics ...\nor stated success criteria for a trial\": generic English for the metrics that define whether an\nEXPERIMENT succeeded, not the ticket heading. Renaming it to \"acceptance criteria for a trial\"\nwould change T2's meaning. This is the same false-positive class as `O-RAN-SC`; the site is\nrecorded here so a later sweep does not \"fix\" it.\n\nOUT OF SCOPE: the `dod_uncertifiable` / \"definition-of-done\" wording in\n`plan_review_verifier.md:81`, `plan_review_verifier_agentic.md:87` and\n`review_kernel/verify_models.py:231` — a related but distinct concept, tracked separately.\n\n## Approach\n\nTextual substitution in the listed files only. Two forms appear and both are handled:\nthe phrase \"acceptance/success criteria|criterion\" collapses to \"acceptance criteria|criterion\"\n(not \"acceptance/acceptance\"), and standalone \"Success Criteria\" becomes \"Acceptance Criteria\".\nG3's two bare-`SC` tokens are edited by hand, not by pattern, because `\\bSC\\b` also matches\n`O-RAN-SC` elsewhere in the repo. Their exact replacements are:\n`THREE SC-CONTRADICTION PATTERNS` -> `THREE AC-CONTRADICTION PATTERNS`, and\n`'SC says zero matches, the DD annotates exceptions'` ->\n`'the AC says zero matches, the DD annotates exceptions'`.\n\nEditing `criteria_routing.json` rotates the `regver` criteria-registry stamp, which on TODAY's\n`main` invalidates every outstanding plan-review attestation (632 tickets, ~40\nopen/in_progress) as `stale-regver`. Ticket `1f32-f86e-8a51-4d8e` (ADR 0053) grandfathers that\nat the claim gate, and it HAS now merged — Gerrit change 962 landed as `095c4afef` and the\nticket is closed. This story's `depends_on 1f32-f86e-8a51-4d8e` was a genuine MERGE-ORDER\nconstraint, not a preference: landing this rename first would have stranded ~40 in-flight\nclaims behind a full LLM re-review. That prerequisite is now SATISFIED, so the routing edit\nis safe to make. (Status refreshed during implementation; the plan previously recorded 962\nas still awaiting its votes.)\n\nOnce grandfathering has landed, the rotation is harmless at the claim gate (attestations stay\nvalid and report non-blocking `registry_drift`). It DOES still deny progressive drift-refresh\nreuse, which is correct and expected.\n\n## Testing\n\n- Regenerate the guide and assert it is free of SC vocabulary (the regeneration is itself the\n  check that the generator was run rather than the file hand-edited).\n- `pytest tests/unit -k \"criteria or routing or registry\"` green.\n- A test that captures `registry_version(None)` BEFORE applying the routing edit (from the\n  pre-edit file content) and asserts it differs afterwards, so the rotation is proven by\n  construction rather than compared against a literal that would rot the moment any other\n  change touches `criteria_routing.json`.\n\n## Acceptance Criteria\n\n- [ ] `grep -rniE \"success[ _-]criteri(a|on)\" src/rebar/llm/reviewers/ src/rebar/llm/plan_review/criteria_routing.json` returns matches ONLY at the three sites this\n      story's Scope deliberately excludes, and no others — i.e. all 11 in-scope hits are gone.\n      AMENDED during implementation: as originally written (\"returns no matches\") this criterion\n      contradicted both this story's own Scope and its AC6. The three surviving hits are:\n      `plan_review_T2.md:10` (generic English — \"a pilot with metrics, or stated success criteria\n      for a trial\"; renaming it would change T2's meaning, and AC6 REQUIRES it to survive), and\n      `plan_review_verifier.md:81` + `plan_review_verifier_agentic.md:87`, which are the\n      `dod_uncertifiable` \"definition-of-done / success criterion\" wording that Scope lists as\n      OUT OF SCOPE (and that parent epic 1386 also excludes as a separate concept). Verify with\n      `... | grep -v -e plan_review_T2.md -e plan_review_verifier.md -e plan_review_verifier_agentic.md`\n      returning empty.\n- [ ] `grep -noE \"\\bSCs?\\b\" src/rebar/llm/reviewers/plan_review_G3.md` returns no matches (both\n      bare tokens renamed).\n- [ ] `docs/plan-review-criteria-guide.md` is regenerated by the documented command, still\n      carries its GENERATED banner, and `grep -niE \"success[ _-]criteri(a|on)\"` on it returns\n      EXACTLY ONE match — the T2 criterion's embedded prompt (\"...stated success criteria for a\n      trial\"). AMENDED during implementation: \"is empty\" was unsatisfiable alongside AC6. The\n      guide is a GENERATED snapshot of the registry and embeds each criterion's prompt verbatim,\n      so T2's deliberately-excluded phrase necessarily echoes into it. Asserting exactly one\n      match is strictly stronger than a bare exclusion: it also proves the phrase was carried\n      through rather than silently dropped.\n- [ ] Verified BEFORE the routing edit is made: `rebar.llm.plan_review.attest.compute_validity`\n      no longer returns a blocking `stale-regver` verdict on the branch point (i.e. ticket\n      `1f32-f86e-8a51-4d8e` has merged), asserted by a check against the current checkout rather\n      than assumed.\n- [ ] A test proves `registry_version(None)` computed from the PRE-edit routing content differs\n      from `registry_version(None)` computed after the edit — capturing both values at run time,\n      asserting inequality, and hard-coding neither.\n- [ ] `grep -n \"success criteria\" src/rebar/llm/reviewers/plan_review_T2.md` still returns its\n      one match, proving the deliberately excluded pilot-metrics phrase was left intact.\n- [ ] `make lint`, `make typecheck` and the full pytest suite pass.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/reviewers/plan_review_F1.md","reason":"Collapse acceptance/success criterion wording"},{"path":"src/rebar/llm/reviewers/plan_review_G3.md","reason":"Rename both bare-SC tokens and the pooled phrase"},{"path":"src/rebar/llm/reviewers/plan_review_G5.md","reason":"Rename success criteria phrase"},{"path":"src/rebar/llm/reviewers/plan_review_G7.md","reason":"Rename parent-contract heading list"},{"path":"src/rebar/llm/reviewers/plan_review_T2.md","reason":"Rename success criteria phrase"},{"path":"src/rebar/llm/reviewers/plan_review_COH.md","reason":"Rename cross-section contradiction example"},{"path":"src/rebar/llm/reviewers/plan_review_container.md","reason":"Rename pooled phrase"},{"path":"src/rebar/llm/reviewers/completion_verifier.md","reason":"Drop the Epic Success Criteria bullet"},{"path":"src/rebar/llm/plan_review/criteria_routing.json","reason":"Rename check strings for COH, G3, G7 (rotates regver)"},{"path":"docs/plan-review-criteria-guide.md","reason":"Regenerated from the updated registry"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","1f32-f86e-8a51-4d8e"],["parent","1386-5e7c-391d-4a74"],["relates_to","2cdc-87f4-5282-4e11"],["relates_to","e7be-b985-c344-46f7"]],"no_file_impact_reason":"","parent_id":"1386-5e7c-391d-4a74","parent_status_uuid":"f86e398b-49e5-4442-a353-aa97305a402a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["vocabulary","plan-review"],"ticket_id":"2aa6-726a-ea56-4d6c","ticket_type":"story","title":"Rename Success Criteria to Acceptance Criteria in reviewer prompts and criteria routing","verify_commands":[]},"source_event_uuids":["b719d462-d27b-4402-99b0-c08f01842231","d4c01750-37a6-4462-aaf4-24910d748d75","e1879179-794a-480c-97c6-6bdaa7ab6bad","db1f2911-3645-4c48-af6a-6694769c0429","7439b775-c173-49e9-aee2-7fb1c2ede69e","c7d383bc-9859-479a-85d2-d1c344544d43","21415c62-b946-4337-b856-292b2ca2abe7","dca256ce-8b52-4fd9-9155-39a291c64071","f86e398b-49e5-4442-a353-aa97305a402a","48395f4a-c53e-4034-b6ee-814fc544a981","f8004de7-87f0-4371-9c98-50fe08a83063","9e30f95c-5bfb-426a-8a8a-a797c4673b51","5ffc4cd4-ffdc-425e-b858-84a0e9cfef76","17a63428-f8a2-4f36-9444-e6778a94b715","8ce861c7-0d1a-4abd-adc5-db8ba1c532f4","a4122988-f857-464e-8f15-e80dcfa07a11"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785259056520360450,"uuid":"fb81b5cd-10f8-4d5b-b908-f69cc55f21bb"}