ia":["E6","E2"],"decision":"advisory","decision_margin":-0.325,"drop_reason":null,"evidence":["\"Re-run the 16 affected files under the same `ctypes.CDLL(None)` simulation: 0 failures expected.\"","\"Reproduced on macOS by patching `ctypes.CDLL`\"","Approach keeps the CDLL call on Linux: \"keep the existing `AttributeError`/`OSError` catch for Linux C libraries\""],"finding":"AC3 (16 files report 0 failures under the CDLL(None)-raises-TypeError simulation) only holds on a non-Linux host. On Linux, the fix still calls ctypes.CDLL(None) by design, so the patched TypeError would still escape and the 16 files would still fail. The plan does not pin the host platform or say whether sys.platform is also faked. It also does not give the simulation as a reproducible command and does not list the 16 files.","group_criteria":null,"group_id":null,"id":"fb46658808c52ee08","impact":0.44,"is_primary":null,"location":"Acceptance Criteria, AC3; Testing bullet 2","norm_id":"n6e84e379624e9bb5","priority":0.275,"reason":"default-advisory","recalled":false,"scenarios":["An executor or CI on Linux runs the simulation after the fix and sees the same 47 failures. They conclude the fix is wrong, or they widen the catch to TypeError."],"severity":null,"suggested_fix":"Rewrite AC3 as follows. On a non-Linux host (macOS), or with sys.platform monkeypatched to 'win32', and with ctypes.CDLL patched so CDLL(None) raises TypeError('LoadLibrary() argument 1 must be str, not None') and the _malloc_trim cache cleared, `pytest <list of the 16 files>` reports 0 failures. Also name where the patch lives, for example a throwaway conftest fixture or an env-gated helper used only for this check.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Make the 16-file simulation AC host-independent: patch `sys.platform` to `win32` as well as `ctypes.CDLL`, or state that the simulation must run on a non-Linux host such as macOS.","cohort":["E3","E5","F4","G5","T6","T9","necessity","project.failure-disposition-contract","project.net-mechanism","project.portability"],"criteria":["E5","E3"],"decision":"advisory","decision_margin":-0.675,"drop_reason":null,"evidence":["'Re-run the 16 affected files under the same `ctypes.CDLL(None)` simulation: 0 failures expected.'","'keep the existing `AttributeError`/`OSError` catch for Linux C libraries' — `TypeError` is not caught on Linux","'Reproduced on macOS by patching `ctypes.CDLL`'"],"finding":"The 16-file re-run AC specifies only the `ctypes.CDLL(None)`-raises-`TypeError` simulation, not `sys.platform`. After the fix, the simulation passes on macOS only because the platform check short-circuits. On a Linux host, `sys.platform` starts with 'linux', so `CDLL(None)` is still called and raises the simulated `TypeError`. That error is not in the AttributeError/OSError catch and still escapes. The AC's 0-failure expectation is therefore host-dependent and unspecified.","group_criteria":null,"group_id":null,"id":"f74c5242ad5bd346f","impact":0.44,"is_primary":null,"location":"Acceptance Criteria — 'Under the `ctypes.CDLL(None)`-raises-`TypeError` simulation, the 16 test files ... report 0 failures'","norm_id":"n62d7face9967ad6f","priority":0.275,"reason":"default-advisory","recalled":false,"scenarios":["An implementer or reviewer runs the simulation on a Linux workstation or Linux CI after the fix and still sees ~47 failures, which looks like a regression or makes the AC unverifiable."],"severity":null,"suggested_fix":"Reword the AC: 'Under a simulation that sets `sys.platform` to `win32` and makes `ctypes.CDLL(None)` raise `TypeError` (with the `_malloc_trim` cache cleared), the 16 test files report 0 failures on any host.'","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify that the Windows-shaped test clears the _malloc_trim cache both before and after (fixture teardown), so the faked-platform result never leaks into other tests.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e"],"criteria":["E6","E2"],"decision":"advisory","decision_margin":-0.6,"drop_reason":null,"evidence":["\"and the `_malloc_trim` cache cleared\"","\"Existing Linux tests keep passing (`release_freed_heap()` is `True` on Linux...)\""],"finding":"The new test clears the _malloc_trim cache and then calls it with sys.platform faked to 'win32', which caches None. The plan does not require the cache to be cleared again on teardown. A later test in the same session, such as the Linux 'release_freed_heap() is True' test or the idle-memory test, can then read the cached None and fail depending on test order.","group_criteria":null,"group_id":null,"id":"f3303af74e489a02a","impact":0.0,"is_primary":null,"location":"Testing bullet 1 and bullet 3; Scope tests/unit/test_mcp_idle_heap_release.py","norm_id":"nb033b90760189748","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["pytest runs the Windows-shaped test before the Linux True-assertion test in the same file or process. The Linux test fails because None is cached."],"severity":null,"suggested_fix":"Use a fixture that calls _malloc_trim.cache_clear() before yield and again after yield, with sys.platform and ctypes.CDLL set via monkeypatch so they are restored automatically.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Clear the `_malloc_trim` cache both before and after the Windows-shaped test (e.g. a fixture with `cache_clear()` in setup and teardown) so the cached None never leaks into other tests.","cohort":["E3","E5","F4","G5","T6","T9","necessity","project.failure-disposition-contract","project.net-mechanism","project.portability"],"criteria":["T9","E5"],"decision":"advisory","decision_margin":-0.95,"drop_reason":null,"evidence":["'and the `_malloc_trim` cache cleared' — cache clearing is specified only as setup","'Existing Linux tests keep passing (`release_freed_heap()` is `True` on Linux; the idle-memory test still releases memory)'"],"finding":"The new Windows-shaped test clears the `_malloc_trim` cache before running, but the plan does not restore or clear it afterwards. With the patched `sys.platform=win32`, `_malloc_trim` caches None. Any later test in the same process sees that cached None, e.g. the existing Linux test asserting `release_freed_heap()` is True and the idle-memory release test. That makes the suite order-dependent.","group_criteria":null,"group_id":null,"id":"fc6e93af855120d99","impact":0.0,"is_primary":null,"location":"Testing — 'New test: with `sys.platform` set to `win32` ... and the `_malloc_trim` cache cleared'","norm_id":"nadbd1a27dabd53a3","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["On Linux CI, the Windows-shaped test runs before the existing Linux test in the same worker; the cached None makes `release_freed_heap()` return False and the Linux test fails intermittently depending on ordering."],"severity":null,"suggested_fix":"Wrap the test in a fixture (or try/finally) that calls `_malloc_trim.cache_clear()` before patching and again after `monkeypatch` restores `sys.platform` and `ctypes.CDLL`.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"- [ ] Make the new Windows-shaped test clear `_mcp_health._malloc_trim.cache_clear()` both before and after (e.g. a fixture with teardown) so the cached `None` from the fake `win32` run can't reach the Linux tests.","cohort":["E4"],"criteria":["E4"],"decision":"advisory","decision_margin":-0.75,"drop_reason":null,"evidence":["src/rebar/_mcp_health.py:67-68: `@functools.cache` / `def _malloc_trim()`","tests/unit/test_mcp_idle_heap_release.py:55-56: `assert release_freed_heap() is sys.platform.startswith(\"linux\")` with no cache_clear","Plan: \"and the `_malloc_trim` cache cleared\" (before only); \"Existing Linux tests keep passing\""],"finding":"The claim 'Existing Linux tests keep passing' depends on test order. _malloc_trim has @functools.cache on it, and the new test runs it with sys.platform='win32', which (after the fix) stores None in the cache. The plan only says the cache is cleared before the new test, not after. The existing test_release_freed_heap_reports_availability calls release_freed_heap() without clearing the cache, so if it runs after the new test in the same process it gets False on Linux and fails.","group_criteria":null,"group_id":null,"id":"f46bab2d85523647f","impact":0.0,"is_primary":null,"location":"Testing / tests/unit/test_mcp_idle_heap_release.py (new Windows-shaped test)","norm_id":"n60cfbda7e6a46dea","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["Under random or xdist ordering, the new test runs before test_release_freed_heap_reports_availability in the same worker; the cached None makes it return False on Linux","The idle-memory test then never trims, because the cached None turns release_freed_heap into a no-op"],"severity":null,"suggested_fix":"Add a fixture that calls `_mcp_health._malloc_trim.cache_clear()`, yields, then calls `cache_clear()` again; use it in the new test (monkeypatch's undo restores sys.platform/ctypes.CDLL but not the functools cache).","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] In the new Windows-shaped test, clear `_mcp_health._malloc_trim.cache_clear()` both before faking `sys.platform` and on teardown (fixture/finalizer), so a cached `None` cannot leak into later Linux tests.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.6,"drop_reason":null,"evidence":["Plan: \"with `sys.platform` set to `win32`, ... and the `_malloc_trim` cache cleared\" (says nothing about clearing it again afterwards)","src/rebar/_mcp_health.py:67-68: `@functools.cache` on `def _malloc_trim()`","tests/unit/test_mcp_idle_heap_release.py:55-56 asserts `release_freed_heap() is sys.platform.startswith(\"linux\")`; lines 67-102 depend on a real trim to release memory"],"finding":"`_malloc_trim` is cached with `@functools.cache`, so the platform result is saved after the first call. The new test fakes `sys.platform = \"win32\"` and clears the cache only before it runs. The `None` it computes then stays cached after monkeypatch restores the real platform. Later Linux tests in the same process would see `release_freed_heap()` return False and trim nothing, and which tests break depends on run order.","group_criteria":null,"group_id":null,"id":"f9a96e0ae62d8cc0e","impact":0.0,"is_primary":null,"location":"Testing — new Windows-shaped test; tests/unit/test_mcp_idle_heap_release.py","norm_id":"nd21fd4e6311257bf","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["On Linux CI, pytest-randomly or a reordered file runs the new test before `test_release_freed_heap_reports_availability`. That test fails because the cached value is None.","`test_finished_background_job_does_not_keep_its_memory` runs after the new test. The release never trims, so the idle-RSS assertion fails."],"severity":null,"suggested_fix":"Use a fixture that calls `_mcp_health._malloc_trim.cache_clear()`, yields, then calls `cache_clear()` again after monkeypatch's undo (e.g. `request.addfinalizer(_mcp_health._malloc_trim.cache_clear)` registered before the monkeypatch so it runs after the platform is restored, or simply clear the cache at the start of the Linux-dependent tests too).","tier":"LLM","validity":0.5556,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"d5119d925d3ec36a","material_parts":{"children":["647ea2107ca5072f",0],"description":["639991b16bcd85e7",3107],"description_boxes":["7879981d4f226a8f",0],"file_impact":["ef53fb733080c80a",2],"ticket_id":["205a84df78ed8b4b",19]},"metrics":{"cache_read_tokens":225963,"cache_write_tokens":113947,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":3890.0,"input_tokens":363031,"llm_calls":29,"llm_ms":76270.9,"output_tokens":23377,"precheck":{"cited_anchor_warning":false},"total_ms":87874.7,"verify_requests":2},"model":"bedrock:us.anthropic.claude-sonnet-5-5","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-5-5","anthropic:claude-sonnet-5-5"],"capabilities":{"native_structured_output":false,"prompt_cache_style":"bedrock","supports_temperature":false,"supports_thinking":true,"web_access":"off"},"endpoint_host":null,"model":"bedrock:us.anthropic.claude-sonnet-5-5"