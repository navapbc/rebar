signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"73d5694efd3843c8773037eb0f4a794de1eff567f8562f2eb14f89999da4c329","event_uuid":"df21453b-f287-4906-8221-9e94047fe9b5","position":{"commit_sha":"943b3f278e8d323c70b80e9b5935fa009f55bf49","position":"1786086556449421001-df21453b-f287-4906-8221-9e94047fe9b5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-223_agent","claim_remote_session":null,"claimed_session":"6ff494b3-b67f-4284-9d1e-818a0b7eecfd","comments":[],"created_at":1786046852461260001,"creation_channel":"cli","deps":[{"link_uuid":"1b546356-a2c0-4d4e-828f-0029a9ff0241","relation":"relates_to","target_id":"2be6-03c9-0c3c-4c11"}],"description":"`rebar review-code --ref <sha> --source attested` accepts both values, forwards them through the\nlibrary, and drops them at the shim. This is not merely unimplemented: `CodeReviewRequest` has a\n`source` field (`gate_dispatch.py:297`) that `gate_source.resolve_gate_handle` consumes\n(`gate_dispatch.py:433`), so the caller's request is actively discarded at the seam.\n\n`llm/code_review/shim.py:127-128` declares `ref`/`source`; the `CodeReviewRequest(...)` literal at\n`:146-158` omits them. `shim.py` never imports `gate_source`, and `_verdict_to_review_result`\n(`:79-104`) never stamps `source`/`verified_at_sha` — while `operations.py:242`,\n`completion.py:488`, `plan_review/__init__.py:473` and `spec_scan.py:69` all do.\n\n`_mcp_llm.py:93-96` tells MCP callers that results carry `source`/`verified_at_sha`/`signable`.\nThat is a false promise on the trust boundary that decides whether a code review can be signed:\n`--source attested` silently reviews the dirty working tree and yields an unsignable result,\nindistinguishable from a successful attested run.\n\nHighest-scoring finding of the audit (validity 1.0, impact 0.92). Both remediation proposers\nconverged on this approach independently.\n\n## Acceptance Criteria\n\n- [x] `ref` and `source` are forwarded into the `CodeReviewRequest` literal\n- [x] `_verdict_to_review_result` stamps `source` and `verified_at_sha`, matching the four sibling producers\n- [x] A behavioural test covers each `source` value, not just the signature change\n- [x] `_mcp_llm.py`'s documented promise is true of the returned result","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","b5bc-f4f7-3433-4181"],["relates_to","2be6-03c9-0c3c-4c11"]],"no_file_impact_reason":"","parent_id":"b5bc-f4f7-3433-4181","parent_status_uuid":"845fcbf6-31d7-44d5-a708-55b920cd120e","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["janitor"],"ticket_id":"2d1c-9bf5-2df1-4c86","ticket_type":"bug","title":"Wire code-review provenance: --ref/--source are dropped at the shim","verify_commands":[]},"source_event_uuids":["0ad1467c-ae86-4280-8a16-56b9424cf8ae","845fcbf6-31d7-44d5-a708-55b920cd120e","dfec2c7a-bb5f-4ebf-ba0f-39d835881e02","1b546356-a2c0-4d4e-828f-0029a9ff0241","df21453b-f287-4906-8221-9e94047fe9b5"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786086556449421002,"uuid":"8ca2b5d8-f4fa-4a40-9c17-1d5c56173a6e"}