{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"advisory":[{"agreement":1,"block_threshold":0.5,"blocking_enabled":true,"checklist_item":"- [ ] Distinguish a budget-scope timeout from an unrelated TimeoutError raised by the drive in run_startup_handshake's error reporting.","criteria":["error-handling","correctness"],"decision":"advisory","evidence":["\"except TimeoutError:\" then \"record[\\\"error\\\"] = f\\\"handshake exceeded its {budget_seconds}s budget\\\"\"","anyio.fail_after resolves in-env and raises builtin TimeoutError on cancellation, but so would any other TimeoutError bubbling out of the drive"],"finding":"run_startup_handshake catches bare `TimeoutError` and unconditionally reports it as 'handshake exceeded its Ns budget'. A `TimeoutError` raised by the drive itself for a reason unrelated to the anyio budget scope (e.g. an internal timeout inside handle_request) would be misattributed as a budget overrun in the reported error field.","id":"0","impact":0.0,"location":"src/rebar/_mcp_health.py:483","norm_id":"nfb0d0a4c1051458f","priority":0.0,"reason":"default-advisory","scenarios":[],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.8571,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"yes"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"low","reachable_path_without_automated_coverage":false,"removed_public_symbol":false,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false,"version_signal_present":false}}},{"agreement":1,"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Make handshake_status's not-run record carry the same keys (host, elapsed_ms) as the run record for a stable /health schema.","criteria":["maintainability"],"decision":"advisory","evidence":["handshake_status not-run branch returns `{\"ok\": False, \"status\": None, \"error\": \"startup handshake did not run\"}` (src/rebar/_mcp_health.py:506)","run_startup_handshake record includes `host` and `elapsed_ms` keys (src/rebar/_mcp_health.py:472-476)"],"finding":"The /health `handshake` object has an inconsistent shape: the successful/run record includes `host` and `elapsed_ms`, but the fail-closed not-run record returned by handshake_status omits both keys (only `ok`, `status`, `error`).","id":"1","impact":0.225,"location":"src/rebar/_mcp_health.py:500","norm_id":"n7b5a58efd5328455","priority":0.1928,"reason":"default-advisory","scenarios":[],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.8571,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","res