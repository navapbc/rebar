othing (then page via IncomingLogEvents only after apply) -- the classic flag-level silent-failure class.","group_criteria":null,"group_id":null,"id":"f78069a51cafbce36","impact":0.0,"is_primary":null,"location":"Approach -> Config content; infra/terraform/cwagent/rebar-host.json lines 7-34","norm_id":"nd1d07c052a222502","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["Operator applies; agent installs and starts cleanly but the journald filter keys do not match the schema the shipped agent version expects, so one or more streams collect nothing","init.scope is not accepted as a `units` value, silently dropping the systemd unit-failure stream"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.3,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"no","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"a9f39d38250e29f5","material_parts":{"children":["647ea2107ca5072f",0],"description":["430a52aedf915fec",7138],"description_boxes":["db752c27cda32b44",4],"file_impact":["cbb7e5d509434482",7],"ticket_id":["c87d83212c9044db",19]},"metrics":{"cache_read_tokens":723278,"cache_write_tokens":354428,"claim_path":"