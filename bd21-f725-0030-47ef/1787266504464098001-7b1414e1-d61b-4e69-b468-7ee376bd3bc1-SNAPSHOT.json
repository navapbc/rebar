d\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5bb357307a77a6042eef722708880dc29670cd90d3d8db4df173588170a567e9","event_uuid":"6d375f28-cdaa-48f7-ba5f-b85f41d11c45","position":{"commit_sha":"920c158be3c95d7730f1e1b24df98800b16ca7e6","position":"1787263395295450001-6d375f28-cdaa-48f7-ba5f-b85f41d11c45"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787250756260137001,"creation_channel":"cli","deps":[{"link_uuid":"1547fec4-a2a3-4d3e-a7bc-b6bee33dd740","relation":"depends_on","target_id":"cfdb-8b77-f63d-4c58"},{"link_uuid":"926da829-0866-4e6c-81c1-82f9c066412e","relation":"depends_on","target_id":"054b-790b-d8e8-4aa3"},{"link_uuid":"a13c9fc1-78cd-4fc4-97f0-653d1b8c6c54","relation":"relates_to","target_id":"eb1c-3ca4-34f8-4cfb"},{"link_uuid":"e9f8b0ac-22ce-4068-8221-d7e9dd79595a","relation":"relates_to","target_id":"516b-3230-9e7f-404b"}],"description":"## Context / Problem\n\nThe `concurrency` overlay prompt (prerequisite story) needs registration before it can run: `OVERLAY_IDS` (src/rebar/llm/code_review/registry.py:38) is the closed enum the base reviewer may escalate to; the overlay union is `glob ∪ content ∪ recommend` (src/rebar/llm/code_review/workflow_ops.py:98-110); and `content_triggered_overlays` (registry.py:321) currently fires only `deletion-impact`. Registration is sequenced AFTER the prompt so the workflow can never escalate to a dimension with no reviewer behind it.\n\n## Approach\n\nFive additive edits. (1) Add `\"concurrency\"` to `OVERLAY_IDS` — the base-output schema enum derives via `overlay_id_enum()` (registry.py:73), so no schema file edit; the `overlay_union` step then auto-emits `include_concurrency` (it derives one `include_<overlay>` flag per `OVERLAY_IDS` member via `overlay_flag_key`, workflow_ops.py:117-119), and `overlay_union_output.schema.json` is dynamic-keyed (`patternProperties` on `^include_[a-z0-9_]+$`), so no schema edit there either. (2) Add a committed HIGH-PRECISION cross-stack token tuple and extend `content_triggered_overlays` to scan BOTH added and removed diff lines (file headers excluded) for these literal substrings, returning `concurrency` alongside the existing deletion-impact result. Token list (decided; survey-grounded in Lu et al. ASPLOS'08, Tu et al. ASPLOS'19, the RacerD trigger heuristic, and CodeQL CERT concurrency packs): `Mutex`, `RwLock`, `Lock(`, `Semaphore`, `synchronized`, `volatile`, `@GuardedBy`, `Interlocked.`, `Atomics.`, `pthread_`, `flock`, `fcntl.`, `O_EXCL`, `mkstemp`, `Thread(`, `go func(`, `tokio::spawn`, `Task.Run(`, `worker_threads`, `new Worker(`, `multiprocessing.`, `asyncio.create_task`, `asyncio.gather`, `concurrent.futures`, `os.fork(`, `cluster.fork(`, `sync.WaitGroup`, `sync.Once`, `make(chan `, `atomic.`, `FOR UPDATE`, `SKIP LOCKED`, `SERIALIZABLE`, `advisory_lock`, `NOWAIT`, `BEGIN IMMEDIATE`, `start_new_session`, `compare-and-swap`, `coroutineScope`, `launch {`. Deliberately EXCLUDED as too noisy for the committed tier (decided): the async/await family, bare `fork`, `retry`, `.lock`, `Popen`, `Promise.all(`, `setInterval(`, `select {` — that noisy tier is project-overlay material, delivered by the sibling dogfood story. (3) Add the one-line catalog entry to `src/rebar/llm/reviewers/code-review-base.md`: `concurrency — threads, async tasks, multiprocessing, locks, channels, shared/global mutable state, file/DB locking` (recognition cue only; the base reviewer does no concurrency analysis). (4) Add the routing entry to `src/rebar/llm/code_review/criteria_routing.json`: `exec: AGENT`, `applies_to: []`, `default_posture: advisory`, `block_threshold: 0.95`, `blocking_enabled: false`, with a `_comment` citing the survey and the calibrate-then-flip path. (5) Wire the gate dispatch: `src/rebar/llm/workflow/gates/code-review.yaml` enumerates every overlay explicitly, so add the two dispatch lines — `- { prompt: code-review-concurrency, when: \"${{ steps.triggers.outputs.include_concurrency }}\" }` to the `round_a` batch and the `steps.union.outputs.include_concurrency` twin to the `round_b` batch — following the existing per-overlay pattern (e.g. the `code-review-security` lines at code-review.yaml:94 and :133); without these lines a registered overlay is authored-but-unreachable. Positive rationale: RacerD's production precedent — a single lexical cue flips on the expensive analysis — and the recall-biased list is safe because an over-fire costs one advisory pass, never a wrong verdict. Measured fire rate of this tier on this repo's last 300 main commits: 14% (43/300); recorded here as calibration context.\n\n## Scope\n\n- `src/rebar/llm/code_review/registry.py` — `OVERLAY_IDS`, token tuple, `content_triggered_overlays` extension.\n- `src/rebar/llm/reviewers/code-review-base.md` — catalog line.\n- `src/rebar/llm/code_review/criteria_routing.json` — routing entry.\n- `src/rebar/llm/workflow/gates/code-review.yaml` — the `round_a` + `round_b` dispatch lines.\n- `tests/unit/test_code_review_triggers.py` — trigger and routing cases (module created by the sibling trigger-extension story; if this story lands first, create it here).\n\n## Testing\n\nUnit tier (pure functions; no live boundary). Oracles: returned overlay-id lists and `threshold_for` output.\n\n- Recall, corpus-derived: a diff hunk adding `start_new_session=True` (distilled from 9ad46965bd, the `eclectic-spotted-barb` introducing change) fires `concurrency`.\n- Removal path: a diff REMOVING a `sync.Mutex` line fires (survey consequence: deleting synchronization is concurrency-introducing).\n- Negative controls: a diff containing only `async def`/`await` lines does NOT fire `concurrency`; a token appearing only on a context (unprefixed) line does NOT fire; the existing deletion-impact behavior is unchanged on its current test corpus.\n- Routing: `threshold_for(\"concurrency\")` returns the advisory 0.95 / blocking-disabled posture.\n\n## Acceptance Criteria\n\n- [x] `\"concurrency\"` is in `OVERLAY_IDS` and returned by `overlay_id_enum()`; checked by unit test.\n- [x] `content_triggered_overlays` returns `concurrency` for the corpus-derived added-line hunk AND for a removed `sync.Mutex` line; checked by `pytest tests/unit/test_code_review_triggers.py`.\n- [x] Negative controls pass: `async def`/`await`-only diffs and context-line-only tokens do not fire; deletion-impact results unchanged.\n- [x] `code-review-base.md` lists `concurrency` in the overlay catalog with the one-line cue; checked by grep.\n- [x] `code-review.yaml` carries the `code-review-concurrency` dispatch line in BOTH the `round_a` batch (gated on `steps.triggers.outputs.include_concurrency`) and the `round_b` batch (gated on `steps.union.outputs.include_concurrency`); checked by grep, and the workflow lint (`make lint`) passes over the edited gate.\n- [x] `threshold_for(\"concurrency\")` asserts advisory/0.95/blocking-disabled; checked by unit test.\n- [x] `make lint`, `make typecheck`, and `pytest tests/unit/test_code_review_triggers.py` pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/code_review/registry.py","reason":"OVERLAY_IDS + HP token tuple + content trigger extension"},{"path":"src/rebar/llm/reviewers/code-review-base.md","reason":"overlay catalog line"},{"path":"src/rebar/llm/code_review/criteria_routing.json","reason":"advisory routing entry"},{"path":"src/rebar/llm/workflow/gates/code-review.yaml","reason":"round_a + round_b dispatch lines for code-review-concurrency"},{"path":"tests/unit/test_code_review_triggers.py","reason":"trigger recall/negative-control + threshold_for tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","054b-790b-d8e8-4aa3"],["depends_on","cfdb-8b77-f63d-4c58"],["parent","292f-57d1-e554-486f"],["relates_to","516b-3230-9e7f-404b"],["relates_to","eb1c-3ca4-34f8-4cfb"]],"no_file_impact_reason":"","parent_id":"292f-57d1-e554-486f","parent_status_uuid":"99bb27bd-f6c9-4b3a-b820-0dc214d76433","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"bd21-f725-0030-47ef","ticket_type":"story","title":"Register the concurrency overlay: high-precision content trigger, base catalog, advisory routing","verify_commands":[]},"source_event_uuids":["36f3a880-7a29-488e-b9ed-8a46dae3b03c","72155ff5-8126-4d0e-a7d1-92e90b951766","926da829-0866-4e6c-81c1-82f9c066412e","06e6f3a8-2e46-4f0f-9cde-418f27e99e3d","02cb3b1d-a906-4624-a7b2-81fa3f43bb9a","d9c8cf87-cd17-49a1-8457-2fd61019ccff","700f9a2c-cfbb-48ef-879a-1885db2ef1a8","a13c9fc1-78cd-4fc4-97f0-653d1b8c6c54","e9f8b0ac-22ce-4068-8221-d7e9dd79595a","e8f53aec-6c70-43dc-8db3-cca3e29b7b06","99bb27bd-f6c9-4b3a-b820-0dc214d76433","6d375f28-cdaa-48f7-ba5f-b85f41d11c45"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787266504464098001,"uuid":"7b1414e1-d61b-4e69-b468-7ee376bd3bc1"}