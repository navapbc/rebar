736b2b8f66c8f412943ee1d7fd3e1","event_uuid":"b4582ab2-953a-41b8-af10-06be7125440b","position":{"commit_sha":"e5ad02a87d0e5163a46e4c5f61959f580194c8dc","position":"1787519873603469001-b4582ab2-953a-41b8-af10-06be7125440b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bfb3f204cfd99a49b076e3d1b727d5f6e3e44b6311017787cdd135a8e22143cb","event_uuid":"dd76ac98-2ffc-449b-98d7-e9b79ec1e313","position":{"commit_sha":"0ba4678cfaeeca96f936225450864b229f299299","position":"1787520269180693001-dd76ac98-2ffc-449b-98d7-e9b79ec1e313"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"230ddabbce3ec2c67bdc1712e9ac77b4b61ae1a3bba871e05ee14e217171d60b","event_uuid":"311f0293-c20b-4d9d-ac25-3d3dde333946","position":{"commit_sha":"d98f54a228eb4c26bcce571fd6129ad9f1d47bdd","position":"1787520286189066001-311f0293-c20b-4d9d-ac25-3d3dde333946"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"FORCE_CLOSE: close gate(s) bypassed by user approval — no completion/signature attestation was signed. Reason: \"Change 2101 MERGED with LLM-Review +1 AND Verified +1 (both Gerrit gates green). Docs-only leaf; stale-material is from adding CHANGELOG.md to file_impact to match the actual merged commit (docs/config.md, docs/mapping-seam.md, docs/README.md, CHANGELOG.md). All 4 ACs met: config axis catalog, mapping-seam.md indexed + reuse seam, migration/rollback note, portability statement. make lint clean.\". Session: c3ab8a6e80.","timestamp":1787391842182454001}],"completion_expectation":"required","created_at":1787290338813130001,"creation_channel":"cli","deps":[{"link_uuid":"3d5dce7f-0eb2-4daf-817f-a9e3f77b4335","relation":"depends_on","target_id":"438a-e1d9-29d3-4081"},{"link_uuid":"17cd52b1-99c0-4d00-b35b-bb64c8a585a0","relation":"depends_on","target_id":"a8ea-be28-2394-4f0c"},{"link_uuid":"a6ca64d5-0ecb-4a04-ae06-159887da5f9f","relation":"depends_on","target_id":"1515-bebc-0d91-476b"},{"link_uuid":"24e321bb-8539-40da-846b-b5d4d42ee82e","relation":"depends_on","target_id":"a881-2d9a-16bf-4acb"},{"link_uuid":"65bc9268-4667-468d-8539-ed5c3c10d9fd","relation":"depends_on","target_id":"d458-bb1e-cc63-42a6"},{"link_uuid":"692750a6-d26e-406b-91f5-b61b3d72cb4a","relation":"depends_on","target_id":"2c66-205d-92e1-4419"},{"link_uuid":"85760001-d14f-4392-b705-50e60a9a1f9a","relation":"depends_on","target_id":"ad81-73ad-83bb-47c7"},{"link_uuid":"17a525c5-7c06-4659-82a8-f401fe4837a9","relation":"relates_to","target_id":"8416-438c-1276-4328"}],"description":"# Documentation + portability: mapping seam, provider-neutral reuse, migration safety\n\n## Context / Problem\n\nThe mapping seam (S1–S8) adds a new config surface, new echo-safe behaviors (breadcrumb,\nreplay), and a new probe command. Operators and future integrators need authoritative docs,\nand the plan-review `project.portability` criterion requires that no capability's only\ntrigger is a specific CI provider — the seam must work across environments with diverse or\nno CI. This child closes the documentation and portability story: it documents the seam end\nto end, records the provider-neutral reuse contract for future Linear/GitLab/GitHub-Issues\nintegrations, and states the migration/rollback story (the feature is additive — an absent\n`[tool.rebar.mapping]` section reproduces today's hardcoded behavior exactly).\n\n## Approach\n\nAuthor docs across the surfaces the seam touches:\n- `docs/config.md` — the `[tool.rebar.mapping]` reserved section reference (extends S1's\n  leaf doc): full axis catalog, the three-layer merge, per-project keying, fail-closed\n  validation, and the orthogonality to `.bridge_state/projects.json`.\n- A mapping-seam guide (new `docs/mapping-seam.md`, indexed in `docs/README.md`) covering\n  the provider-neutral core vs Jira-adapter split, the capability descriptor, the\n  skip/drift/collapse decision paths, transition replay, the parent breadcrumb, and the\n  probe workflow — with the explicit statement that the neutral core is the reuse seam for\n  future targets (Linear/GitLab/GitHub-Issues) whose direct support is out of scope now.\n- `CHANGELOG`/migration note — additive, backward-compatible: absent section = current\n  behavior; no store migration; rollback = delete the section.\n- Portability statement: every mapping behavior is exercised by in-process unit tests with\n  injected transports (no live Jira, no specific CI required); the only live touchpoint\n  (the probe) degrades to an offline emit and is never a CI gate.\n\n## Scope\n\n- `docs/config.md`, `docs/mapping-seam.md` (new), `docs/README.md` (index entry).\n- A migration/rollback note in the repo's changelog surface.\n- No source-code change (docs-only child) — file-impact is the doc paths.\n\n## Testing\n\nDocs-only child: no automated test tier. Verification is by review against the acceptance\ncriteria (the plan-review gate defers testing on a docs child to a reviewer-checkable\noutcome). The portability *claim* it documents is substantiated by the unit suites in\nS1–S8 (each names an injected-transport, no-live-Jira tier); this child asserts those exist\nand are referenced, it does not add new behavior to test.\n\n## Acceptance Criteria\n\n- [x] `docs/config.md` documents the full `[tool.rebar.mapping]` axis catalog, merge\n  layers, and per-project keying — verified by reviewer check that each axis (status, type,\n  link, priority, create_defaults) and the merge order appear.\n- [x] `docs/mapping-seam.md` exists, is indexed in `docs/README.md`, and states the\n  provider-neutral core as the reuse seam for future targets — verified by reviewer check\n  for the index entry and the reuse statement.\n- [x] The migration note states the feature is additive with an absent-section = current-\n  behavior guarantee and a delete-the-section rollback — verified by reviewer check.\n- [x] The portability statement records that every mapping behavior is covered by\n  injected-transport unit tests requiring no live Jira and no specific CI provider —\n  verified by reviewer check against the S1–S8 test sections.\n\nTest tier: **none (docs-only)** — the mechanism is documentation; the observable oracle is\nreviewer verification against the four criteria above, which is the correct tier for a\nchild that adds no runtime behavior.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/config.md","reason":"full [mapping] axis catalog + merge model"},{"path":"docs/mapping-seam.md","reason":"new end-to-end mapping seam guide"},{"path":"docs/README.md","reason":"index entry for mapping-seam.md"},{"path":"CHANGELOG.md","reason":"additive migration/rollback note"}],"file_impact_scope":"paths","force_close_reason":"Change 2101 MERGED with LLM-Review +1 AND Verified +1 (both Gerrit gates green). Docs-only leaf; stale-material is from adding CHANGELOG.md to file_impact to match the actual merged commit (docs/config.md, docs/mapping-seam.md, docs/README.md, CHANGELOG.md). All 4 ACs met: config axis catalog, mapping-seam.md indexed + reuse seam, migration/rollback note, portability statement. make lint clean.","keyring":[],"last_reopened_at":1787518158477400001,"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","1515-bebc-0d91-476b"],["depends_on","2c66-205d-92e1-4419"],["depends_on","438a-e1d9-29d3-4081"],["depends_on","a881-2d9a-16bf-4acb"],["depends_on","a8ea-be28-2394-4f0c"],["depends_on","ad81-73ad-83bb-47c7"],["depends_on","d458-bb1e-cc63-42a6"],["parent","3d7a-7795-efde-4df7"],["relates_to","8416-438c-1276-4328"]],"no_file_impact_reason":"","parent_id":"3d7a-7795-efde-4df7","parent_status_uuid":"dd76ac98-2ffc-449b-98d7-e9b79ec1e313","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"14f4-d616-70df-466d","ticket_type":"story","title":"Documentation + portability: mapping seam, provider-neutral reuse, migration safety","verify_commands":[]},"source_event_uuids":["741dd8bc-3edd-427b-ab2f-69459bccbeb4","0e6cc009-9fcc-4b7a-84b5-737c7c466a06","e59f033e-2240-4a05-a7f6-58dafa72264b","f604d59f-53d3-4569-af8e-e4205e76e4bb","17a525c5-7c06-4659-82a8-f401fe4837a9","22de18dc-aeb9-4e61-a0ce-a1ff9daf45d0","d13836dd-3696-4500-8c44-5368bfec7b0c","83228bb5-7d0d-48a5-b39d-d259bced4308","9a6fa611-e37f-4691-903e-33bb9b335a2c","f1d7e2d4-4740-44d3-a7c1-816761ef1c6d","2f2a6efa-c701-488b-9cc7-65a6bfb4e388","b4582ab2-953a-41b8-af10-06be7125440b","dd76ac98-2ffc-449b-98d7-e9b79ec1e313","311f0293-c20b-4d9d-ac25-3d3dde333946"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787527876991269001,"uuid":"f015e2dd-670e-46a4-b044-f7fd62f85f2d"}