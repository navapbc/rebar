est_gate_error_sidecar_heldout.py","read-set: 14","read-path: scripts/check_mechanism_delta.py","read-path: tests/fixtures/dc_wiki_corpus/code_arrow.json","read-path: tests/unit/metrics/test_event_metrics.py","read-path: tests/unit/metrics/test_event_metrics_heldout.py","read-path: tests/unit/metrics/test_registry.py","read-path: tests/unit/metrics/test_registry_heldout.py","read-path: tests/unit/reconciler/diffing/test_canonical_link_diff.py","read-path: tests/unit/reconciler/diffing/test_canonical_link_diff_heldout.py","read-path: tests/unit/reconciler/diffing/test_canonical_outbound_equivalence.py","read-path: tests/unit/reconciler/diffing/test_canonical_outbound_equivalence_heldout.py","read-path: tests/unit/reconciler/state/test_backend_scalar_surface.py","read-path: tests/unit/reconciler/state/test_backend_scalar_surface_heldout.py","read-path: tests/unit/reconciler/test_projects_store_happy.py","read-path: tests/unit/reconciler/test_projects_store_heldout.py","currency-basis: file_impact"],"material_fingerprint":"b55ba3613b7f479f","merged_log_commit":"bd79355895735680809734d038f4a556aaef77c1","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1793490861777285325}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":5,"unsigned":9},"authorship_ledger":[{"content_hash":"8338fb22c396dc01a8c49f12f37a2256c72aaaf2435e06be57eb65662a49c99a","event_uuid":"d7253ce8-eea0-4ca6-b2c7-ef0939d9fb51","position":{"commit_sha":"ce88e81886784529bb63a6469a5cc5108f644a72","position":"1788807830676188816-d7253ce8-eea0-4ca6-b2c7-ef0939d9fb51"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"045d2715d3066bb2e4efa3531f80bb75c1a20b526eb4e048797243d5143744bf","event_uuid":"5b032074-fa2f-4738-97fe-bb7e47cb99e1","position":{"commit_sha":"ab88aa24ed1ec677ea3a3a2b46748c0184205fd0","position":"1793490861777582278-5b032074-fa2f-4738-97fe-bb7e47cb99e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation detail for this story (the description carries the decisions).\n\nPair list for `tests/unit/metrics/`, `tests/unit/workflow/` and `tests/unit/rebar_reconciler/`, filtered from enumeration (2) of the test-suite epic's first comment. Format: `base | heldout LOC | RENAME (differing defs)`; the twin is `<base>_heldout.py`. No test-function name collides in these pairs; definitions that collide with DIFFERENT bodies are named in the RENAME column (rename on merge); every other colliding definition is identical (dedupe: keep the base copy; `pytestmark` counts here). Paths under `tests/unit/rebar_reconciler/` are stated at the current name (origin/main 083620b0); the reconciler epic's rename carries them.\n\n`tests/unit/metrics/` — 13 pairs, 4 renames:\n\n| # | base | heldout LOC | RENAME (differing defs) |\n|---|---|---|---|\n| 1 | `tests/unit/metrics/test_bug_trends.py` | 312 | - |\n| 2 | `tests/unit/metrics/test_code_health_composition.py` | 83 | - |\n| 3 | `tests/unit/metrics/test_event_metrics.py` | 133 | `_write_event` |\n| 4 | `tests/unit/metrics/test_gha_adapter.py` | 67 | - |\n| 5 | `tests/unit/metrics/test_git_metrics.py` | 350 | `_oracle_write_cap` |\n| 6 | `tests/unit/metrics/test_jscpd_dup.py` | 202 | - |\n| 7 | `tests/unit/metrics/test_lizard_complexity.py` | 128 | - |\n| 8 | `tests/unit/metrics/test_metrics_extra_guard.py` | 62 | - |\n| 9 | `tests/unit/metrics/test_registry.py` | 107 | `_spec` |\n| 10 | `tests/unit/metrics/test_scc_loc.py` | 260 | - |\n| 11 | `tests/unit/metrics/test_sidecar_metrics.py` | 148 | `_review`, `_write` |\n| 12 | `tests/unit/metrics/test_snapshot.py` | 83 | - |\n| 13 | `tests/unit/metrics/test_transcript_adapter.py` | 70 | - |\n\n`tests/unit/workflow/` — 3 pairs, 1 rename:\n\n| # | base | heldout LOC | RENAME (differing defs) |\n|---|---|---|---|\n| 14 | `tests/unit/workflow/test_completion_token_recovery.py` | 227 | - (the held-out twin cites bug 9a08 in its docstring; carry that paragraph into the merged docstring) |\n| 15 | `tests/unit/workflow/test_gate_coverage_input_rejected_5f96.py` | 150 | - |\n| 16 | `tests/unit/workflow/test_gate_error_sidecar.py` | 174 | `_OutageRunner`, `_gate_errors` |\n\n`tests/unit/rebar_reconciler/` — 6 pairs, 3 renames:\n\n| # | base | heldout LOC | RENAME (differing defs) |\n|---|---|---|---|\n| 17 | `tests/unit/rebar_reconciler/diffing/test_canonical_link_diff.py` | 128 | fixture `ol` |\n| 18 | `tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py` | 148 | `_StubBindingStore`, `_emit`, `_jira`, `_ticket`, fixtures `backend`, `od` |\n| 19 | `tests/unit/rebar_reconciler/state/test_backend_scalar_surface.py` | 99 | `_backend` (the autouse fixture `_clean` has IDENTICAL bodies — keep the base copy) |\n| 20 | `tests/unit/rebar_reconciler/state/test_get_rotation.py` | 323 | - |\n| 21 | `tests/unit/rebar_reconciler/state/test_richtext_port.py` | 87 | - (the held-out twin cites bug 1bb2-5da5 in its docstring; carry that paragraph into the merged docstring) |\n| 22 | `tests/unit/rebar_reconciler/test_jira_dc_transport.py` | 305 | - |\n\n22 pairs; 8 renames = rows 3, 5, 9, 11, 16, 17, 18, 19.\n\nRename rule: suffix the HELD-OUT definition `_heldout` (e.g. `_load_heldout`, `ol_heldout` for a fixture, `_StubBindingStore_heldout` for a class) and repoint its callers; keep the base copy of identical definitions.\n\nMerge recipe per pair: `cat` the held-out module into the base under a `# ── held-out oracles (merged from <name>_heldout.py) ──` divider; keep the base module docstring and append the held-out docstring's \"what it proves\" paragraph; dedupe identical definitions (incl. `pytestmark`); rename differing definitions with the `_heldout` suffix and repoint callers; `git rm` the held-out file. Record per pair: `pytest --collect-only -q <base> <heldout>` before, `pytest --collect-only -q <base>` after.\n\nMechanism note (enumeration (7)): `autouse_fixture` keys are `autouse_fixture::<path>::<name>`; the merge of row 19 keeps `autouse_fixture::tests/unit/rebar_reconciler/state/test_backend_scalar_surface.py::_clean` and drops the `..._heldout.py::_clean` key, which buckets `stale`. `python scripts/check_mechanism_delta.py --check` exits 0 with `stale>0` (`scripts/check_mechanism_delta.py:51-57`); `--update-stale` is maintenance-only and must not be run.","timestamp":1788807517059386498},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Scope gap: `tests/unit/review_bot/` is unclaimed by any story in this epic\n\nFound while sweeping `361f-0a5c`'s pair census. Recording it here rather than widening that story.\n\nA git pathspec glob is recursive — `git ls-files 'tests/unit/*_heldout.py'` matches across `/` because wildmatch runs without `FNM_PATHNAME` — so the full sweep returns 114 modules where `tests/unit`'s direct children are only 53. The extras live in four subdirectories:\n\n| directory | held-out modules |\n|---|---|\n| `tests/unit/reconciler/` | 36 |\n| `tests/unit/metrics/` | 16 |\n| `tests/unit/workflow/` | 6 |\n| `tests/unit/review_bot/` | 3 |\n\nThis story's scope line names `tests/unit/{metrics,workflow,rebar_reconciler}`. **`review_bot` appears in no story's scope** in epic `6ed2-24e5` — not here, not in `361f-0a5c` (direct children only), not in `7a7a-ceb9` (`tests/scripts`) or `fb5f-54fd` (interfaces/integration). Those 3 modules would survive the epic un-merged, and `b721-6c6d`'s unpaired-rename pass would not catch them either, since they are paired.\n\nTwo things to settle before this story is reviewed, because both change its AC counts:\n\n1. Whether `rebar_reconciler` in the scope line means the `tests/unit/reconciler/` directory measured above. If so the name is stale and the directory census is 36, not what the \"22 pairs\" figure implies.\n2. Whether `review_bot`'s 3 modules join this story's scope or get their own.\n\nFlagging rather than editing: both are the epic author's call, and the counts in this plan's ACs depend on the answer.","timestamp":1793472590682103001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Frozen literals and the anchoring fix\n\nRound-1 review BLOCKed with one finding. It is **correct**, and sweeping the same ground turned up a **second** defect it missed. Both are now fixed in AC1.\n\n### B1 (reviewer, CORRECT) — an unrecorded frozen literal\n\n`tests/fixtures/dc_wiki_corpus/code_arrow.json:16` contains `test_gate_error_sidecar_heldout.py`, and it is neither `.test_durations` nor the `.github/mechanism-baseline.json` row — the only two exclusions AC1 named. AC1's escape clause permits \"any frozen pre-fix literal explicitly recorded on this ticket,\" and this literal was not recorded. The reviewer caught exactly that.\n\n**Recording it now.** The file is a frozen Data Center wiki-render corpus built by `scripts/build_dc_wiki_corpus.py`; the hit sits inside a captured `/rebar-debug` report body stored verbatim as render input. Editing it would corrupt the fixture's purpose, which is to reproduce real DC wiki render inputs byte-for-byte. It is the same class as `.test_durations`: generated, frozen, not a code reference. AC1 now names it explicitly.\n\n### B2 (missed by the review) — AC1's recipe contradicted AC1's own text\n\nAC1 ended with \"each hit attributed to its owning path rather than matched as a substring,\" but prescribed a bare `git grep -F <basename>`, which does nothing of the kind.\n\n`test_registry_heldout.py` is a literal substring of `test_attest_registry_heldout.py`, starting at index 7 and preceded by a word character:\n\n```\ntest_attest_registry_heldout.py\n       ^-- test_registry_heldout.py starts here\n```\n\nS1 `361f` merged that pair and left the source named in two provenance comments, `tests/unit/test_attest_registry.py:14` and `:84`. So after this story deletes `tests/unit/metrics/test_registry_heldout.py`, the unanchored grep still returns 2 hits — permanently, in a file this story does not touch and must not touch. No implementation could have cleared them, so AC1 would have failed at the end regardless of the work. Same failure class as the `new=0` mechanism-delta AC amended across this epic earlier today.\n\n**Fix:** `git grep -nE \"(^|[^A-Za-z0-9_])<basename>\"`. Measured on `bd793558957`: anchored returns **0** hits for `test_registry_heldout.py` (down from 2) and still returns the genuine `code_arrow.json:16` hit for `test_gate_error_sidecar_heldout.py`, so it suppresses only the superstring class.\n\n### Full live-reference census for all 22 basenames at `bd793558957`\n\n| Referencing path | Hits | Disposition |\n|---|---|---|\n| `.test_durations` | 140 | excluded (generated) |\n| `.github/mechanism-baseline.json:61` | 1 | excluded (stale row, named in Testing) |\n| `tests/fixtures/dc_wiki_corpus/code_arrow.json:16` | 1 | excluded (frozen corpus; recorded here) |\n| `tests/unit/test_attest_registry.py:14,:84` | 2 | **not a reference** — substring artifact; 0 under anchoring |\n\n### Pre-sweep of the rest of the plan, at `bd793558957`\n\nPair census confirms **22** exactly: 13 `tests/unit/metrics/` + 3 `tests/unit/workflow/` + 6 across the `tests/unit/reconciler/` tree (1 root, 2 `diffing/`, 3 `state/`). The `_clean` autouse cite `tests/unit/reconciler/state/test_backend_scalar_surface{,_heldout}.py::_clean` resolves exactly. S1's merge touched no file in this stratum, so no before-count recorded in the plan has drifted.","timestamp":1793490619871725001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Frozen literals and the anchoring fix — measured on `757ca4852d7`\n\nThe plan measured its live-reference set on `ce5795c6a5c`. Re-measured on current `origin/main` `757ca4852d7` with the word-anchored form AC1 now mandates, the set is **unchanged** — exactly 2 hits across all 22 basenames:\n\n| Hit | Classification | Action |\n|---|---|---|\n| `.github/mechanism-baseline.json:61` — `autouse_fixture::tests/unit/reconciler/state/test_backend_scalar_surface_heldout.py::_clean` | stale baseline row, named in Testing | none; the two `_clean` fixtures are byte-identical, dedupe keeps the pinned base copy, the twin's key buckets `stale`, `--check` exits 0 |\n| `tests/fixtures/dc_wiki_corpus/code_arrow.json:16` | frozen pre-fix literal — a captured ticket body in a generated wiki-render corpus, naming `test_gate_error_sidecar_heldout.py` | none; recorded here per AC1 |\n\n`scripts/criteria-vocabulary-allowlist.txt` pins none of these 22 paths, as the plan predicted. Confirmed by grep, not assumed.\n\n### The attribution rule AC1's sweep requires\n\nAC1's grep, run naively, also reports 45 hits that are **this change's own provenance records**: the merged docstring line `Held-out oracles merged from <name>_heldout.py: …` and the mandated divider `# ── held-out oracles (merged from <name>_heldout.py) ──`, each sitting in the very base module that absorbed that twin.\n\nThose are not violations, and AC1 says so in its own amendment text, which describes the identical lines S1 `361f` landed as \"the provenance comments at `tests/unit/test_attest_registry.py:14,:84`\" — cited as expected content whose only problem was a substring misattribution. The Testing section states the rule directly: \"Attribute every hit to its owning path before acting on it.\"\n\nSo the sweep is run as: for basename `X_heldout.py`, exclude hits inside `X.py`, the base module that owns that provenance. Everything else must fall in the exception set. Measured that way the sweep returns **exactly the 2 rows above and nothing else**.\n\nWithout that rule AC1 and the Approach contradict each other: the Approach *mandates* a divider naming the deleted file, so no conforming implementation could ever return zero hits.\n\n### Measurements\n\n- 22 pairs merged; **380** top-level definitions in, **380** out (195 base + 236 held − 51 identical dedupes), zero mismatches.\n- **14 renames over 7 pairs**, matching the plan's enumerated set name for name, including `test_canonical_link_diff` correctly carrying **0** renames as the plan's correction states.\n- `git status` shows exactly the 22 base modules modified and the 22 twins deleted — `ruff format` touched nothing else in those 3 directories.\n- `ruff check` clean; `python scripts/check_mechanism_delta.py --check` exits 0.\n\n### One mechanical hazard worth recording\n\nRenaming lengthened 2 lines in `test_canonical_outbound_equivalence.py` past the 100-character limit (`_jira` → `_jira_heldout` adds 8 characters per call), so `ruff check --fix` left 7 E501 errors that only `ruff format` could resolve. A merge pass that runs `--fix` alone and stops will report failures that are not defects in the merge.","timestamp":1793494116077596001}],"created_at":1788807261894085226,"creation_channel":"mcp","deps":[{"link_uuid":"d7253ce8-eea0-4ca6-b2c7-ef0939d9fb51","relation":"depends_on","target_id":"361f-0a5c-bd12-463b"}],"description":"## Context / Problem\n22 modules under `tests/unit/metrics/` (13 pairs), `tests/unit/workflow/` (3 pairs) and `tests/unit/reconciler/` (6 pairs: 2 in `diffing/`, 3 in `state/`, 1 at the package root) have a `<name>_heldout.py` twin. Once both oracles have been reviewed the split only doubles module count, duplicates identical helper definitions, and makes every rename touch two files. Across these 22 pairs no test-function name collides; 7 pairs carry helper/fixture/class definitions with differing bodies (14 definitions in all) and every other colliding definition is identical. The pair list with per-pair rename sets, filtered from enumeration (2) of the test-suite epic's first comment, is itemised in this ticket's first comment. Paths are stated at their post-rename name: the reconciler epic (friended-brainsick-degus) rename has LANDED, so `tests/unit/rebar_reconciler/` no longer exists and the modules live under `tests/unit/reconciler/`. All counts and paths in this plan were re-measured on origin/main ce5795c6a5c by listing `tests/unit/{metrics,workflow,reconciler}/` and AST-diffing every pair's top-level definitions, not sampled.\n\n## Approach\nDirectories: `tests/unit/metrics/`, `tests/unit/workflow/`, `tests/unit/reconciler/` — 22 pairs (13 metrics, 3 workflow, 6 reconciler — 2 in `diffing/`, 3 in `state/`, 1 at the package root). **14 definition renames over 7 pairs**, enumerated so the set does not have to be re-derived: `metrics/test_registry` (`_spec`); `metrics/test_event_metrics` (`_write_event`, `_ticket`); `metrics/test_git_metrics` (`_oracle_write_cap`); `metrics/test_sidecar_metrics` (`_review`, `_write`); `workflow/test_gate_error_sidecar` (`_OutageRunner`, `_gate_errors`); `reconciler/state/test_backend_scalar_surface` (`_backend`); `reconciler/diffing/test_canonical_outbound_equivalence` (`_jira`, `backend`, `_emit`, `_StubBindingStore`, `_ticket`). `reconciler/diffing/test_canonical_link_diff` was previously listed as a rename and is NOT one: its shared definitions are byte-identical, so it dedupes with no rename. For each pair: `cat` the held-out module into the base under a `# ── held-out oracles (merged from <name>_heldout.py) ──` divider; keep the base module docstring and append the held-out docstring's \"what it proves\" paragraph; dedupe identical definitions (`pytestmark` counts here — keep the base copy); rename differing definitions and repoint their callers; `git rm` the held-out file. Rename rule: suffix the HELD-OUT definition `_heldout` (e.g. `_load_heldout`) and repoint its callers; keep the base copy of identical definitions. The autouse fixture `tests/unit/reconciler/state/test_backend_scalar_surface{,_heldout}.py::_clean` has identical bodies: the merge keeps the base copy, so the base mechanism key survives and the held-out key buckets `stale`. No test body changes.\n\n## Scope\nIn scope: the 22 base modules under `tests/unit/metrics/`, `tests/unit/workflow/` and `tests/unit/reconciler/` named in the first comment and their 22 `_heldout` twins. Out of scope: the `tests/unit/` root pairs (S1), `tests/interfaces/` and `tests/integration/` (S3), `tests/scripts/` (S4), the 78 unpaired held-out renames (S5), `.github/mechanism-baseline.json`, every file under `src/`, and any test body change.\n\n`tests/unit/review_bot/` was flagged as possibly unclaimed by any story in this epic. It is not: all 3 of its `_heldout` modules are **unpaired**, so they belong to `b721-6c6d`'s unpaired-rename pass, whose scope claims the 55 unpaired modules under `tests/unit/` *including its subpackages*. Nothing is added to this story.\n\n## Testing\n**Whole-tree deleted-filename sweep, before `make test`.** For each of the 22 removed `_heldout.py` basenames, `git grep -F <basename>` over the whole tree and classify every hit as a live reference (fix), stale prose (fix), or a frozen pre-fix literal (leave, and record it on this ticket). Sweeping only the merged pair is demonstrably insufficient: sibling story 361f-0a5c-bd12-463b broke four guard modules it never edited — a `parametrize` list, a nested-pytest node id, an AST-scan target path and a vocabulary allowlist entry — and its earlier pair-scoped run passed because a merged module never cites a sibling's path.\n\nMeasured on origin/main ce5795c6a5c, the live set for this directory set is **exactly one** hit: the `.github/mechanism-baseline.json` row `autouse_fixture::tests/unit/reconciler/state/test_backend_scalar_surface_heldout.py::_clean`, which the Approach already covers and which needs no edit (the two `_clean` fixtures are byte-identical, so dedupe keeps the already-pinned base copy and the twin's key buckets `stale`; `--check` passes). `scripts/criteria-vocabulary-allowlist.txt` pins none of these 22 paths, so this story does not touch it.\n\n**Match on the whole basename, not a substring.** A bare `git grep -F` over basenames over-reports: `test_attest_registry_heldout.py` contains `test_registry_heldout.py`, so twin `test_registry_heldout.py` appears to own a docstring reference in `tests/unit/test_attest_registry.py` that is in fact sibling 361f's to fix. Attribute every hit to its owning path before acting on it. `.test_durations` hits are excluded: it is a pytest-split sharding profile, tolerant of stale keys and exempt from the vocabulary gate, confirmed by 361f deleting 39 modules keyed in it with no resulting failure.\n\nPer pair: `pytest --collect-only -q <base> <heldout>` before and `pytest --collect-only -q <base>` after — counts equal (both recorded on this ticket); `pytest <base>` green. `make test` green.\n\n## Acceptance Criteria\n- [ ] No deleted filename is still referenced: for each of the 22 removed `_heldout.py` basenames, the WORD-ANCHORED `git grep -nE \"(^|[^A-Za-z0-9_])<basename>\"` returns no hit outside `.test_durations`, the `.github/mechanism-baseline.json` stale row named in Testing, and the one frozen literal recorded in the \"Frozen literals and the anchoring fix\" comment on this ticket (`tests/fixtures/dc_wiki_corpus/code_arrow.json:16`). **AMENDED 2026-10-31 — the original bare `git grep -F <basename>` could not satisfy this AC's own \"rather than matched as a substring\" clause.** `test_registry_heldout.py` is a literal substring of `test_attest_registry_heldout.py` (at index 7), which S1 `361f` left named in the provenance comments at `tests/unit/test_attest_registry.py:14,:84`, so the unanchored grep reports 2 permanent false hits that no implementation of this story could clear. Anchoring returns 0 for that basename while still finding the genuine `code_arrow.json` hit.\n- [ ] `python scripts/check_mechanism_delta.py --check` **exits 0** and `python scripts/check_criteria_vocabulary.py` **exits 0**.\n- [ ] Zero paired twins remain in these directories: for each of the 22 pairs `git ls-files <base>_heldout.py` prints nothing (the unpaired `_heldout` modules in these directories are untouched here and renamed in S5).\n- [ ] Per-pair node counts reconcile: each merged base collects exactly the sum of the two prior counts, from the before/after `pytest --collect-only -q` runs recorded on this ticket.\n- [ ] `python scripts/check_mechanism_delta.py --check` **exits 0**; the held-out `_clean` autouse key of `test_backend_scalar_surface_heldout.py` buckets `stale`, which `--check` accepts (`scripts/check_mechanism_delta.py:51-57`), and `--update-stale` is not run. AMENDED: this criterion previously also required the `--check` summary to report `new=0`, which is unreachable and unrelated to this story's work — `new=N` counts marker-admitted entries, so an already-clean tree reports a nonzero `new` and still exits 0. Exit 0 is the gate's pass signal. Root cause: bug `6f24-3d47-b251-4905`, whose fix has landed in `AGENTS.md` and `rebar explain plan`.\n- [ ] `make verify` green.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"tests/unit/metrics/test_bug_trends.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_bug_trends_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_code_health_composition.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_code_health_composition_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_event_metrics.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_event_metrics_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_gha_adapter.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_gha_adapter_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_git_metrics.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_git_metrics_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_jscpd_dup.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_jscpd_dup_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_lizard_complexity.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_lizard_complexity_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_metrics_extra_guard.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_metrics_extra_guard_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_registry.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_registry_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_scc_loc.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_scc_loc_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_sidecar_metrics.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_sidecar_metrics_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_snapshot.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_snapshot_heldout.py","reason":"delete"},{"path":"tests/unit/metrics/test_transcript_adapter.py","reason":"merge heldout twin"},{"path":"tests/unit/metrics/test_transcript_adapter_heldout.py","reason":"delete"},{"path":"tests/unit/workflow/test_completion_token_recovery.py","reason":"merge heldout twin"},{"path":"tests/unit/workflow/test_completion_token_recovery_heldout.py","reason":"delete"},{"path":"tests/unit/workflow/test_gate_coverage_input_rejected_5f96.py","reason":"merge heldout twin"},{"path":"tests/unit/workflow/test_gate_coverage_input_rejected_5f96_heldout.py","reason":"delete"},{"path":"tests/unit/workflow/test_gate_error_sidecar.py","reason":"merge heldout twin"},{"path":"tests/unit/workflow/test_gate_error_sidecar_heldout.py","reason":"delete"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_link_diff.py","reason":"merge heldout twin"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_link_diff_heldout.py","reason":"delete"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence.py","reason":"merge heldout twin"},{"path":"tests/unit/rebar_reconciler/diffing/test_canonical_outbound_equivalence_heldout.py","reason":"delete"},{"path":"tests/unit/rebar_reconciler/state/test_backend_scalar_surface.py","reason":"merge heldout twin (keeps the base _clean autouse key)"},{"path":"tests/unit/rebar_reconciler/state/test_backend_scalar_surface_heldout.py","reason":"delete (its _clean autouse key buckets stale)"},{"path":"tests/unit/rebar_reconciler/state/test_get_rotation.py","reason":"merge heldout twin"},{"path":"tests/unit/rebar_reconciler/state/test_get_rotation_heldout.py","reason":"delete"},{"path":"tests/unit/rebar_reconciler/state/test_richtext_port.py","reason":"merge heldout twin"},{"path":"tests/unit/rebar_reconciler/state/test_richtext_port_heldout.py","reason":"delete"},{"path":"tests/unit/rebar_reconciler/test_jira_dc_transport.py","reason":"merge heldout twin"},{"path":"tests/unit/rebar_reconciler/test_jira_dc_transport_heldout.py","reason":"delete"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["depends_on","361f-0a5c-bd12-463b"],["parent","6ed2-24e5-6985-4faa"]],"no_file_impact_reason":"","parent_id":"6ed2-24e5-6985-4faa","parent_status_uuid":"25c56b85-e727-479c-9ffe-4bc24839e895","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["complexity-reduction","breaking-pass-4"],"ticket_id":"19c3-0920-8849-49a0","ticket_type":"story","title":"Merge the 22 held-out twin test pairs under tests/unit/metrics, workflow and rebar_reconciler","verify_commands":[]},"source_event_uuids":["d7253ce8-eea0-4ca6-b2c7-ef0939d9fb51","8605b6d1-6842-4b2b-ac44-9aedfd94a955","30ff6077-dc27-421f-84f6-e5f7e2aab68b","cf765455-bd58-40de-8632-c9730224ee2d","7150a11e-7e51-432f-b199-29802744dd60","35b933e5-0e49-4ad7-8aa6-29d059cf3d23","6e1c3244-e0b1-4046-b156-7e3374d84261","5b032074-fa2f-4738-97fe-bb7e47cb99e1","25c56b85-e727-479c-9ffe-4bc24839e895","710fa63c-f4be-45c3-81a5-c7f11e524c6f","7331acd7-a8ce-4b88-aa2f-9978cc31220d"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793499430502965001,"uuid":"78e6469a-b691-4fec-97b9-b55eba0a9e6f"}