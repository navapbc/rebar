{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793499430502965001,"compiled_state":{"alias":"cepevorous-garlicky-leopard","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"3835269d792b7764e0beeca95798250487c78895","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 19c3-0920-8849-49a0","material: b55ba3613b7f479f","material-part: children 647ea2107ca5072f 0","material-part: description 3dbdc3f0439c398b 7797","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact af1730e754682dd4 44","material-part: ticket_id 26f552d67775e138 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.14.0","regver: aa61189569d34126","verified-at-sha:bd79355895735680809734d038f4a556aaef77c1","plan-material-pin: prerequisite 361f-0a5c-bd12-463b 1ca889caec4bca07","dep 4085f5e7078d73a44ece3bb8f9c6cf67a4e4e456c2ee75758c255af36d8b93a5 tests/unit/metrics/test_bug_trends.py","dep 5cc52f16895fb570e8c6dcd7366285215676cece3ff0f398fe8df76bc7c6a521 tests/unit/metrics/test_bug_trends_heldout.py","dep a83211426aff08ef2e8b47290f92fda4c0babdb5e3eae92cd2af258d689536aa tests/unit/metrics/test_code_health_composition.py","dep 0754a8717b25d13a24fe344f0303fa8bf98a05495d5a2386def16953cdebb7cb tests/unit/metrics/test_code_health_composition_heldout.py","dep b7963a58418c66194d442fafe46c67ee4774c6195d7016cfb8a7f672ad4bf313 tests/unit/metrics/test_event_metrics.py","dep 01e50b2a72f2fc9fb916e7451c8106cc265cca6ee9cc1c11e42eaca66fb5e7e6 tests/unit/metrics/test_event_metrics_h