0e89df"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6dfa36ebfc8d73c739606d13949e42aabe13aafc25536f8d78e6bbf0d3fc527e","event_uuid":"184ce5fe-8e42-41df-b796-3323321086ec","position":{"commit_sha":"52b23106dcc4df6f51b50a0441006a1666b35216","position":"1788530402711919001-184ce5fe-8e42-41df-b796-3323321086ec"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"be84e70e4e59f44bb6423fae38f9f744f91fdf5ac559cdefc6c4b15c48f87620","event_uuid":"73600e1b-01b4-43e2-a20e-a413263d4caf","position":{"commit_sha":"a471b86fb172d02c9fd05a70d4792fb3df4e888c","position":"1788530412298925001-73600e1b-01b4-43e2-a20e-a413263d4caf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788318557457874083,"creation_channel":"mcp","deps":[{"link_uuid":"96d617cf-9375-4242-9980-6a8db1b4654d","relation":"relates_to","target_id":"05e9-2c11-2c92-4ab3"},{"link_uuid":"7a37ec23-f2dd-4063-8a28-04e5e20e89df","relation":"relates_to","target_id":"825d-65ec-648f-4b64"}],"description":"## Context / Problem\n\nThe sibling children introduce a protocol with several non-obvious rules that a future\ncontributor cannot infer from the code: which signals are admissible evidence and which are\nnot, why an escaped-defect label is used positively but never negatively, why a fixture must\nreproduce before admission, why fixtures are excluded from the weekly live sweep, and why\nmined fixtures live in this repository rather than shipping as packaged defaults.\n\nADR 0109 is the precedent for exactly this problem. It records that a harness nobody is\nrequired to use changes nothing, and so fixes when each tier is required. The same reasoning\napplies here: an admission bar that is not written down is an admission bar that erodes, and\nthe first contributor to add a fixture by hand will not reproduce rules that exist only as\ncode.\n\n`docs/plan-review-gate.md` is where a contributor already looks for the gate's contributor\nprotocol, so a rule recorded anywhere else will be missed.\n\n## Approach\n\nRecord the protocol as an ADR under `docs/adr/`, following ADR 0109's shape, and reference\nit from `docs/plan-review-gate.md` so it is reachable from the document contributors already\nread. The ADR states the decisions rather than restating the implementation: the admissible\nevidence signals and the positive-only rule for escaped-defect labels; the vintage gate and\nwhy prompt churn makes it necessary; the tiered blocking and advisory admission bars; the\nreproduce-before-admit rule and its reproduction consensus plus epoch-majority bar; the\nchange-triggered execution\nrule and why the fixtures stay off the weekly cron; and the gap-only loop with its\n`unreliable-criterion:` breaker.\n\nThis child lands last because an ADR written before the siblings settle would record\nintentions rather than decisions.\n\n## Scope\n\nOne new ADR file `docs/adr/0113-fixture-mining-and-admission-protocol.md`, and the reference to it from\n`docs/plan-review-gate.md`. Documentation only.\n\n## Non-goals\n\n- Changing any behavior, command, spec, or workflow.\n- Restating the implementation in prose; the ADR records decisions and their rationale.\n- Superseding ADR 0109, which answers a different question (how to measure a proposed\n  change, rather than what asserts a criterion's required behavior).\n\n## Acceptance Criteria\n\n- [x] An ADR file `docs/adr/0113-fixture-mining-and-admission-protocol.md` exists whose body states each of the seven protocol\n      items, verified by `grep -c` returning a non-zero count for a literal anchor per item:\n      admissible evidence (`grep -c \"Admissible evidence\"`), the escaped-defect positive-only\n      rule (`grep -c \"escaped-defect\"`), the vintage gate (`grep -c \"vintage gate\"`), the\n      tiered admission bars (`grep -c \"admission bar\"`), the reproduce-before-admit rule\n      (`grep -c \"reproduction consensus\"`), the change-triggered execution rule\n      (`grep -c \"change-triggered\"`), and the gap-only loop breaker\n      (`grep -c \"unreliable-criterion:\"`).\n- [x] `docs/plan-review-gate.md` references the ADR by filename; verified by\n      `grep -q \"0113-fixture-mining-and-admission-protocol\" docs/plan-review-gate.md`.\n- [x] The ADR names ADR 0109 and states it is extended rather than superseded; verified by\n      `grep -q \"0109\" docs/adr/0113-fixture-mining-and-admission-protocol.md`.\n- [x] The ADR status line records the parent epic id; verified by\n      `grep -q \"65dd-e93b\" docs/adr/0113-fixture-mining-and-admission-protocol.md`.\n\n## Definition of Done\n\n`make lint` passes; the ADR is committed; `docs/plan-review-gate.md` links it.\n\n## Budget\n\n**$0.** Documentation only; no model call.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"docs/adr/","reason":"New ADR recording the fixture mining and admission protocol decisions, following ADR 0109's shape."},{"path":"docs/plan-review-gate.md","reason":"Reference the new ADR from the document contributors already read for the gate's protocol."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","65dd-e93b-666a-4caa"],["relates_to","05e9-2c11-2c92-4ab3"],["relates_to","825d-65ec-648f-4b64"]],"no_file_impact_reason":"","parent_id":"65dd-e93b-666a-4caa","parent_status_uuid":"184ce5fe-8e42-41df-b796-3323321086ec","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["plan-review","evals","docs"],"ticket_id":"a5bf-c1f8-3950-4f87","ticket_type":"task","title":"ADR and docs for the fixture mining and admission protocol","verify_commands":[]},"source_event_uuids":["9919adeb-7fba-4f9d-83a0-e742b63e152b","9f901ffc-c470-4a38-b259-e6484acbbca8","02db3903-5b03-4daa-94b7-6f7834b6445b","9efca867-7d0d-4609-950e-bb35aef3746b","e3f0d9ad-11aa-460e-b5ce-8f942703dddb","685bbb9b-7a0d-470c-a83a-770ba41dd15f","1df32359-339d-49b8-8d9a-4fcaf7508470","96d617cf-9375-4242-9980-6a8db1b4654d","7a37ec23-f2dd-4063-8a28-04e5e20e89df","184ce5fe-8e42-41df-b796-3323321086ec","73600e1b-01b4-43e2-a20e-a413263d4caf"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788542387289637001,"uuid":"f5e90165-e8c0-4501-9f55-018a90086d67"}