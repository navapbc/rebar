bar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"73af51c97f2688b828e492df9f8318b26a583f4eb0b7a87663584ce91c68bb15","event_uuid":"bde47b02-e47f-4081-bdb9-d8ecb3e03da1","position":{"commit_sha":"67f6a4dce83bfef72a1a0171248e2a5e0470a66f","position":"1795278673962747001-bde47b02-e47f-4081-bdb9-d8ecb3e03da1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"11499cfa48194a08c6644bec01d66fe654377c01b6d38006d043e0c6608674f0","event_uuid":"8878bed3-aa92-4f85-b392-f70ffc643468","position":{"commit_sha":"47923bbbaabbb0f431d87fd8fb08cbea46440196","position":"1795279479289722001-8878bed3-aa92-4f85-b392-f70ffc643468"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Review run 1 BLOCKED (9 findings; full log in session scratch). The blocks rested on 3 facts: (a) on Windows _pid_alive always answers alive, (b) _sweep_exited's os.WNOHANG raises AttributeError there, and (c) stop_local_sweep accepts 'unverified-live', so a leftover stamp can make it TerminateProcess a recycled pid. smoking-bereft-boar fixes (a) and (b), so this ticket now depends on it. This plan closes (c): stop_local_sweep never signals off POSIX. It also covers the advisories: the no-op wording in docs/config.md and docs/concurrency.md, and a real Windows detached-spawn test. AC block unchanged. Re-review waits for boar to close.","timestamp":1795263824564007001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Windows validation run 44915738030 (job 136880834548, tmp/b4-uncommon-cleansable-wren at 9f1d006933c): 7 failed, 20515 passed. Of the 13 class tests, 9 pass and 4 still fail with 'no child spawned' (test_compact_trigger x3, test_snapshot_gc_trigger x1). The captured traceback shows the cause: AttributeError: 'types.SimpleNamespace' object has no attribute 'DETACHED_PROCESS'. The tests replace rebar._proc.subprocess with a Popen-only SimpleNamespace, and the now-reached nt branch of _detach_kwargs reads the Windows constants from it. That is a test-fake defect; product detach works (no other error). The plan's scope grows by those 2 test files, using the pattern test_spawn_detached already has. The other failures are out of class: test_git_metrics x2 (cloth-osmophilic-izuthrush) and the env-boundary scan on my new test, already fixed in amend 8fd8d09cb0b.","timestamp":1795278623562545001}],"created_at":1795153764620899001,"creation_channel":"cli","deps":[{"link_uuid":"b324bc78-6b12-452d-aa60-332c01bd309b","relation":"discovered_from","target_id":"8aa0-2120-5ef3-4750"},{"link_uuid":"4c44dc2a-2deb-46ef-a3b2-590535bdd913","relation":"depends_on","target_id":"c7b2-e4ed-37fd-4f60"}],"description":"## Context / Problem\nDepends on smoking-bereft-boar. That bug gives Windows a real pid liveness probe and removes `_sweep_exited`'s Unix-only `os.WNOHANG` call. Without it, the retire and stale-lock paths this change makes reachable on Windows would misjudge every holder as alive.\n\nDiscovered while triaging breezy-hogged-mastiff. The 13 entries of `.github/windows-sweep-deselect/detached-maintenance.args` belong to this bug.\n\n## Root cause (verified at origin/main 1a11014a3a4 against the Windows JUnit of run 44681457334)\n`compact_trigger.maybe_compact` (compact_trigger.py:374) and `gc_trigger.maybe_gc` (gc_trigger.py:180) return immediately when `sys.platform == \"win32\"`. That is a product gap: on Windows a close never folds a ticket, and an attested gate never runs snapshot GC.\n- The stated reason no longer holds. The docstring says the store lock's `fcntl` import would crash the detached child, but `rebar._store.lock_kernel` has had a Windows (`msvcrt`) leg since 035b7371de8.\n- Every module on these paths guards `import fcntl` with a None fallback (`lock_kernel`, `git_locking`, `repo_snapshot`).\n- The worker locks are `stamped_lock.stamped_file_lock` (O_EXCL files, portable).\n- `rebar._proc._detach_kwargs` already returns `DETACHED_PROCESS | CREATE_NO_WINDOW` on nt, but is documented as \"not reached in v1\".\n- All 13 tests fail only because the gate returns first: they observe no inline fold and no spawn (`assert []`, `0 == 1`).\n\n## Approach\n- `src/rebar/_commands/compact_trigger.py`:\n  - Delete the win32 early return in `maybe_compact`, and replace the \"Windows is a v1 no-op\" docstring sentence with the platform statement (detached on every platform via `spawn_detached`).\n  - `stop_local_sweep` returns None without signalling when `os.name != \"posix\"`. On Windows `os.kill(SIGTERM)` is TerminateProcess, and with no process start time the stamp cannot prove the pid is still the sweep, so a recycled pid could be killed.\n  - The retiring server's `finish()` still waits on the store write lock, which the running sweep releases at each ticket boundary. So on Windows a retire lets the sweep run on instead of stopping it. The docstring says so.\n- `src/rebar/_snapshot/gc_trigger.py`: delete the win32 early return in `maybe_gc` and fix its docstring.\n- `src/rebar/_proc.py`: correct the `_detach_kwargs` docstring (the nt branch is now reached). Flags unchanged.\n- Docs that describe the no-op: `docs/config.md` (`compact.trigger` comment) and `docs/concurrency.md` (the I9b trigger paragraph) now say Windows detaches the same way.\n- After smoking-bereft-boar, a sweep or GC worker that died without releasing its stamped worker lock is reclaimed as soon as its dead pid is proven. Without that, it would wait for the 1 h age ceiling.\n- No config key, env var or flag. POSIX behaviour is unchanged.\n- `.github/windows-sweep-deselect/detached-maintenance.args`: remove each line whose test passes in the Windows validation run. If the file ends up empty, delete it and its `@` line in `.github/workflows/test.yml`; `tests/unit/test_windows_sweep_deselect.py` keeps the 2 in step.\n- Test fakes: `tests/unit/test_compact_trigger.py` (2 sites) and `tests/unit/test_snapshot_gc_trigger.py` (1 site) replace `rebar._proc.subprocess` with `SimpleNamespace(Popen=..., DEVNULL=...)`. On Windows `_detach_kwargs` then fails on the missing `DETACHED_PROCESS`, and 4 of the 13 still read 'no child spawned' (Windows run 44915738030). They will use the pattern `test_spawn_detached` already has: the real module's attributes with only `Popen` swapped.\n- New tests in `tests/unit/test_detached_maintenance_windows.py`:\n  - On every host, `stop_local_sweep` sends no signal when `os.name` is patched to \"nt\", even for a stamp naming a live pid.\n  - On Windows only, a real `spawn_detached` child (DETACHED_PROCESS | CREATE_NO_WINDOW) runs after the parent returns and writes a marker file, polled for up to 30 s. That is the end-to-end proof that the nt detach branch works.\n\n## Scope\n- src/rebar/_commands/compact_trigger.py\n- src/rebar/_snapshot/gc_trigger.py\n- src/rebar/_proc.py (docstring only)\n- docs/config.md\n- docs/concurrency.md\n- tests/unit/test_detached_maintenance_windows.py\n- tests/unit/test_compact_trigger.py (subprocess fake only)\n- tests/unit/test_snapshot_gc_trigger.py (subprocess fake only)\n- .github/windows-sweep-deselect/detached-maintenance.args\n- .github/workflows/test.yml (only if the args file is deleted)\n\n## Testing\n- The 13 listed tests are the regression proof. Before the change they fail on Windows (JUnit of run 44681457334: e.g. `the CLI close must spawn exactly one sweep, got []`); after it they must pass.\n- Pre-merge Windows validation: on the exact fixed tree (based on main with smoking-bereft-boar merged) with the lines removed, push `tmp/b4-uncommon-cleansable-wren`, dispatch `gh workflow run 294845723 --ref tmp/b4-uncommon-cleansable-wren`, and record the run id and per-test outcomes in a comment. Then delete the tmp branch.\n- AC1 evidence (\"passed in a `sweep (windows)` run on main after the fix\"): the first scheduled `test.yml` run on main whose head contains the merge commit. Its run id and head SHA go in a comment before the close.\n- `make verify` through verify-slot.sh.\n\n## Acceptance Criteria\n- [ ] Every line removed from `detached-maintenance.args` names a test that passed in a `sweep (windows)` run on main after the fix (run id recorded in a comment).\n- [ ] `detached-maintenance.args` is empty and deleted with its reference in `.github/workflows/test.yml`, or each remaining line names a test recorded on this ticket as intentionally unsupported on Windows with the reason.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_commands/compact_trigger.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"src/rebar/_snapshot/gc_trigger.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"src/rebar/_proc.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"docs/config.md","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"docs/concurrency.md","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"tests/unit/test_detached_maintenance_windows.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"tests/unit/test_compact_trigger.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":"tests/unit/test_snapshot_gc_trigger.py","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":".github/windows-sweep-deselect/detached-maintenance.args","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"},{"path":".github/workflows/test.yml","reason":"uncommon-cleansable-wren: enable detached sweep and GC on Windows"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["depends_on","c7b2-e4ed-37fd-4f60"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"81d0b725-68c4-4c95-a83a-f692618db076","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":["windows","portability"],"ticket_id":"41e5-5e7c-52f5-43c6","ticket_type":"bug","title":"Windows sweep: out-of-band compaction and snapshot GC are a no-op on Windows, so 13 trigger tests see no spawn","verify_commands":[]},"source_event_uuids":["78e1ef92-c4a1-4c2a-be86-6a1628f10f58","1085b48b-4b25-444e-a631-6ce675c9afe2","fba97f70-1b81-4203-a3dc-b42c997df362","b8ae1ea9-92d8-437c-935d-b7960801a153","4c44dc2a-2deb-46ef-a3b2-590535bdd913","f3b73eda-16b5-4c43-a835-854369ebc492","49fa8b31-10e2-48a2-bfdd-64b1d9b3ebe0","81d0b725-68c4-4c95-a83a-f692618db076","be5252f0-f4b9-4a1b-bcd1-ad369ac82e41","7ccab770-c8a2-4100-ac78-99bd31edeb53","7a5c5227-6092-4ad0-91e7-206c51590e19","bde47b02-e47f-4081-bdb9-d8ecb3e03da1","8878bed3-aa92-4f85-b392-f70ffc643468"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795279479289722002,"uuid":"953