 (best-effort stop). A regression that unconditionally backed off (or backed off on the None path) would not be caught.","id":"2","impact":0.3,"location":"src/rebar/_store/push.py:373","norm_id":"nbf57641d6d7cc71f","novelty":1.0,"priority":0.3,"reason":"default-advisory","reviewer_id":"code-review-tests","reviewers":["code-review-tests"],"scenarios":["A merge recovery fails locally (returns False) or the write lock stays busy (returns None) — backoff should be skipped."],"severity":"minor","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","respects_artifact_altitude":"na","severity_claim_justified":"yes"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":false,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"hard_to_reverse_surface":false,"hidden_invariant":false,"implicit_coupling":false,"likelihood":"low","prod_impact":"none","reachable_path_without_automated_coverage":true,"reversibility":"easy","safety_net_removal_without_replacement":false,"security_bypass_not_enforced_elsewhere":false,"silent_failure":false,"silent_wrong_feeding_a_decision":false,"trigger_likelihood":"rare","unversioned_published_contract_break":false}}}],"impact_model_version":"code-v3","indeterminate":[],"model":"bedrock:us.anthropic.claude-opus-4-8","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4-6","anthropic:claude-sonnet-4-6"],"capabilities":{"native_structured_output":true,"prompt_cache_style":"none","supports_temperature":true,"supports_thinking":true,"web_access":"off"},"endpoi