h,BASE)\n    check=python_signatures if path.endswith(\".py\") else text_signatures\n    if check(source(base,path))!=check(source(\"HEAD\",path)):\n        raise SystemExit(\"directive text or attachment changed: \"+path)' 'src/rebar/_commands/__init__.py' 'src/rebar/_commands/_confirm.py' 'src/rebar/_commands/_init_ensures.py' 'src/rebar/_commands/_seam.py' 'src/rebar/_commands/bridge_repair.py' 'src/rebar/_commands/claim.py' 'src/rebar/_commands/close_autoresume.py' 'src/rebar/_commands/close_disposition.py' 'src/rebar/_commands/close_precheck.py' 'src/rebar/_commands/compact_plan.py' 'src/rebar/_commands/compact_rebuild.py' 'src/rebar/_commands/compact_recovery.py' 'src/rebar/_commands/compact_trigger.py' 'src/rebar/_commands/compact_txn.py' 'src/rebar/_commands/compact.py' 'src/rebar/_commands/composer_edit.py' 'src/rebar/_commands/composer.py' 'src/rebar/_commands/doctor_locks.py'","dd_id":"directives","dd_text":"Directive text and attachment remain exact on every owned path."},{"command":"rtk proxy env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python -c 'import subprocess, sys\nexpected=sorted(sys.argv[1:])\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^..HEAD\"],text=True).splitlines())\nif actual!=expected:\n    raise SystemExit(\"one-commit path set mismatch: actual=\"+repr(actual)+\" expected=\"+repr(expected))' 'src/rebar/_commands/__init__.py' 'src/rebar/_commands/_confirm.py' 'src/rebar/_commands/_init_ensures.py' 'src/rebar/_commands/_seam.py' 'src/rebar/_commands/bridge_repair.py' 'src/rebar/_commands/claim.py' 'src/rebar/_commands/close_autoresume.py' 'src/rebar/_commands/close_disposition.py' 'src/rebar/_commands/close_precheck.py' 'src/rebar/_commands/compact_plan.py' 'src/rebar/_commands/compact_rebuild.py' 'src/rebar/_commands/compact_recovery.py' 'src/rebar/_commands/compact_trigger.py' 'src/rebar/_commands/compact_txn.py' 'src/rebar/_commands/compact.py' 'src/rebar/_commands/composer_edit.py' 'src/rebar/_commands