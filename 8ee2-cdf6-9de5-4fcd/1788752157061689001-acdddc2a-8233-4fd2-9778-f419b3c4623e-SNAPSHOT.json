fa80f7-2b50-4a0e-8bd1-bae8b71c38fe"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"41a48260348dc2fe5bd74dcd20e66dbb22b9ac85c30b21e1329ec77ec2507310","event_uuid":"0a8dc61d-5a7d-416d-ba0a-2b6238bc3165","position":{"commit_sha":"c86f82b87fdb83735452e7a52b2597ea1bd8edcd","position":"1788749679893483001-0a8dc61d-5a7d-416d-ba0a-2b6238bc3165"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Starting implementation pass. Read ticket/RCA; proceeding to plan review before claim per workflow.","timestamp":1788748465432291001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review passed; claimed ticket and starting isolated worktree implementation.","timestamp":1788748870289469001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Validated that the fix is already merged on origin/main as 1798b4429135 (Resolve one alias without a whole-store scan), with RED regression coverage in tests/unit/test_single_id_alias_resolve_scan_cache.py. Targeted test passed in isolated worktree fix4-durational: 7 passed.","timestamp":1788749014445274001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC1 non-codebase evidence: the merged commit message for 1798b4429135be7597669622e0fbaf82d441757b records the same-host before/after latency harness results: show_ticket(alias) improved from 7.6-17.8s to 0.166s on the real store, and the ticket RCA records the earlier observed 41.7s/39.9s idle measurements on the full store. This measurement evidence lives in the ticket/commit record rather than as a deterministic repository test; repository coverage for parse-free warm resolution is tests/unit/test_single_id_alias_resolve_scan_cache.py.","timestamp":1788749412743981001}],"completion_expectation":"required","created_at":1788640418453988012,"creation_channel":"mcp","deps":[],"description":"Measured while proving the MCP OOM root cause on witted-invisible-roan (9ea3-7d07-ea55-4496). Not a memory defect — a latency one — but it lands on the same ~60s MCP client deadline whose ambiguous timeout causes duplicate billed gate runs (bug d80d-7be7-1c0a-4231), so it is filed rather than left as an aside.\n\n## Observed\n\nAgainst a local `rebar-mcp` (Streamable-HTTP, readonly) over a full clone of this store (8,879 ticket dirs):\n\n| condition | `show_ticket` latency |\n|---|---|\n| server idle | **41.7s**, then 39.9s warm |\n| while 8 concurrent `ready_tickets` are in flight | **80.5s** |\n\nFor comparison, a whole-store `ready_tickets` compile on the same server is 16.3s. A single-ticket read is therefore ~2.5x more expensive than compiling the entire store.\n\n## Mechanism\n\n`resolve_ticket_id` falls through to `_scan_alias` whenever no prebuilt `alias_index=` is supplied (`src/rebar/_ids.py:458-460`). `_scan_alias` (`src/rebar/_ids.py:312`) does `os.listdir(tracker)` and then calls `_effective_alias_for_dir` for EVERY ticket directory, each of which does its own `listdir` plus a `json.load` of that ticket's CREATE/SNAPSHOT event.\n\nSo resolving one id costs a full-store directory walk and ~8,900 JSON parses. The only caller that supplies a prebuilt index is `commit_impact.py:211/233`, so essentially every MCP tool call that names a ticket pays this — and project policy is to WRITE aliases, which is exactly the input that takes the scan path.\n\n## Why it matters beyond latency\n\n1. The MCP client deadline is ~60s. A 40s idle floor means an ordinary `show_ticket` is already inside the same order of magnitude as the timeout, and 80s under a concurrent read burst is over it. A `-32001` timeout is the ambiguous non-signal that provokes duplicate, double-billed gate re-runs (`AGENTS.md`, \"Long gate ops over MCP\").\n2. It is the dominant allocator churn on the read path (tens of MB of parsed dicts per resolution), feeding the same RSS high-water mechanism proven on 9ea3.\n\n## Acceptance Criteria\n\n- [x] AC1: [non-codebase] `show_ticket` on an idle server against a store of this size completes in a small fraction of its current 40s, measured before and after with the same harness.\n- [x] AC2: id resolution no longer parses every ticket's CREATE/SNAPSHOT to resolve one id — verified by counting `json.load` calls (or file opens) during a single resolution, before and after.\n- [x] AC3: resolution semantics are unchanged across every accepted id form — alias, full canonical id, two-quad short id, legacy single-quad, and Jira key — including the ambiguity and not-found paths, proven by a differential test over the real store comparing old and new resolution for a large sample of ids.\n- [x] AC4: a held-out regression test fails before the fix and returns to failing when the fix is perturbed.\n\n## Notes\n\nThe natural direction is an alias index built once per store revision rather than per call, but the resolver has ordering/shadowing rules (`_effective_alias_for_dir` exists because an alias can be re-pointed), so AC3's differential check over the real store is the load-bearing part, not the index itself.\n\n## Completion evidence\n\nThe fix is already merged on main as 1798b4429135be7597669622e0fbaf82d441757b (`Resolve one alias without a whole-store scan`, Gerrit Change-Id Ifc81914bae526a73ba10a81c1d8622d7ef3d4e40). It added a process-local resolver scan cache and regression coverage in `tests/unit/test_single_id_alias_resolve_scan_cache.py`. Targeted validation in `../fix4-durational` on 2026-09-06: `pytest tests/unit/test_single_id_alias_resolve_scan_cache.py -q` => 7 passed.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"d2fa80f7-2b50-4a0e-8bd1-bae8b71c38fe","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"8ee2-cdf6-9de5-4fcd","ticket_type":"bug","title":"Every ticket-id resolution scans and parses the whole store, so show_ticket takes 40s idle","verify_commands":[]},"source_event_uuids":["54041cc7-ff29-4392-ba15-dd355289aa5d","49cebe41-de8a-44c9-aa95-7a9bc315a0ad","e94792d0-fc9e-4599-820b-06f1284fec89","5becec1e-905a-4afd-9a28-73d5a700a985","608a4323-c078-4b0b-9ca1-6a1666e5eb46","13791ae6-937f-4d5c-b029-8f0e9b53443d","7fb5d997-aff9-44ca-845a-4ed4e708b7b8","d149aac7-56fb-4827-9e69-692efd91db30","fbf0f40e-32d2-4b1e-90ee-68a619ae5ad7","d2fa80f7-2b50-4a0e-8bd1-bae8b71c38fe","0a8dc61d-5a7d-416d-ba0a-2b6238bc3165"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788752157061689001,"uuid":"acdddc2a-8233-4fd2-9778-f419b3c4623e"}