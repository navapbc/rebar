_primary":null,"location":"Testing section + AC7; 'The join key, explicitly' paragraph","norm_id":"n74ce79abde9102e2","priority":0.6667,"reason":"default-advisory","recalled":false,"scenarios":["A bug in group_by_ticket's SUM or files-touched union silently mis-aggregates shape per ticket; the report still reproduces its (wrong) n on re-run, so AC2 passes green","The unjoinable classifier mis-handles an ambiguous 4-quad fragment (counts it as joinable or drops it silently), skewing the correlation with no test to catch it"],"severity":null,"suggested_fix":"Add a small fixture-based test in the script's test module: a handful of commits with known `rebar-ticket:` trailers (including one ambiguous fragment and one missing ticket), asserting the summed non-test LOC, unioned files-touched, and the reported unjoinable count.","tier":"LLM","validity":0.6667,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Name the exact statistic and computation for read (a)'s relationship measurement (e.g. stdlib-only Spearman rank / a bucketed rework-rate t