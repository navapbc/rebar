\"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d86be9892f122332c975e72b3c262d8227e768077bcad370ea80f6a2e7be4782","event_uuid":"e5f2772a-dd5b-4826-a22e-e4843cda84c9","position":{"commit_sha":"e9af1f532d03921fc222548a77ac28bf4bc4007c","position":"1784506562585023001-e5f2772a-dd5b-4826-a22e-e4843cda84c9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-215_agent","claim_remote_session":null,"claimed_session":"5e1736fd-6a46-425f-96e3-3460f9fcb4f7","close_class":"regression","comments":[],"created_at":1784505094845004001,"creation_channel":"cli","deps":[],"description":"Sweep (rebar-debug, sibling of 0e15) found two non-CLI bug-close call sites that never got the ed13 --class requirement, so both now fail to close BUG tickets:\n\n1. src/rebar/_mcp_writes.py:117 — MCP tool transition_ticket() calls rebar.transition(id, current, target) with NO close_class. The library rebar.transition/_lib_writes.transition (line 337) DOES support close_class=. transition_core (txn.py:253) enforces --class unconditionally on any *->closed of a bug (unless current=='idea'), and force/force_close do NOT bypass it. => an agent over MCP CANNOT close any bug ticket (raises 'requires --class'). Regression: MCP could close bugs before ed13. (This is NOT the deliberate no-force policy; close_class is a required classification, not a bypass.)\n\n2. src/rebar/_io/import_ndjson.py:356 — replay closes via transition_compute(local,'open','closed',force=True) with no close_class; force!=force_close and neither bypasses the class guard. Re-materializing a closed BUG from an NDJSON dump is rejected and the per-row fail-open (line 357) leaves the bug OPEN with a warning => import cannot restore closed bugs.\n\nFIX: thread close_class through both. MCP: add a close_class parameter to transition_ticket and pass to rebar.transition (only needed for bug close; empty ok for non-bug). Import: carry the source close event's close_class if present, else default (e.g. 'undetermined'/'duplicate'). RED->GREEN each: MCP tool closes a bug with a valid class; import re-materializes a closed bug. CLI create/close and the canary (Gerrit 853) are handled; probe-rebar closes non-bugs (exempt).","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"86ea9205-9251-4447-9acd-414350ad215f","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"closed","tags":[],"ticket_id":"376d-74f6-8e70-4d12","ticket_type":"bug","title":"ed13 --class requirement not propagated to MCP transition_ticket + NDJSON import bug-close paths","verify_commands":[]},"source_event_uuids":["f53617f6-d7ce-449b-9ef8-62f4652828fa","8ac235d7-64ae-49e6-894e-bd65cb91c075","1af83b2e-c783-4526-9a24-0be005c1df2e","58784ed2-277d-4fc0-b079-eb098cd81def","86ea9205-9251-4447-9acd-414350ad215f","e5f2772a-dd5b-4826-a22e-e4843cda84c9"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659555653305001,"uuid":"a8757591-e263-4a0e-ab54-03d72bc4f8df"}