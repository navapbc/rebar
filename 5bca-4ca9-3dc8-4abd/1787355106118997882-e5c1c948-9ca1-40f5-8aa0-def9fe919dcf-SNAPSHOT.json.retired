{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787355106118997882,"compiled_state":{"alias":"aphidious-florid-grison","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"fe62ecc69b901619b79eea7d54910f832e7d3937","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 5bca-4ca9-3dc8-4abd","material: a5904bb2739bdfc9","material-part: children 647ea2107ca5072f 0","material-part: description 9c65fc526c8eb231 6053","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 565e1d29d83f8efb 3","material-part: ticket_id 5941f42d4df03800 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.12.0 (fe62ecc69b9-dirty)","regver: 362a5dd2d2052826","verified-at-sha:fe62ecc69b901619b79eea7d54910f832e7d3937","dep 0e4645dec535be98e5f3bf2154b71b37d499d3e6bdd90c92c39fe1ccee968fb2 docs/plan-review-criteria-guide.md","dep 003c551e2ecb1e728241c5cccc66706cb94fb8df809dcdf621a89ed6087e2bb8 src/rebar/llm/plan_review/criteria_routing.json","dep 76a277b288a856e05c35ed2c2a482dc78befef0cd2e1a6b27155dfa6b682243f src/rebar/llm/reviewers/plan_review_T13.md","read-set: 12","read-path: docs/experiments/escaped-bug-review-gap-analysis.md","read-path: src/rebar/llm/code_review/criteria_routing.json","read-path: src/rebar/llm/eval_specs/plan-review-finder.eval.yaml","read-path: src/rebar/llm/plan_review/criteria_guide.py","read-path: src/rebar/llm/plan_review/criteria_routing.json","read-path: src/rebar/llm/plan_review/det_gate_rules.py","read-path: src/rebar/llm/p