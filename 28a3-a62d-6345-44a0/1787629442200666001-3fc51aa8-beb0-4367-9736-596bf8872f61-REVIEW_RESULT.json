lution.","group_criteria":null,"group_id":null,"id":"fef89c24bc4db1cd7","impact":0.67,"is_primary":null,"location":"child dd65-54fa-f4c3-4bc9","norm_id":"n01f698cefb8e44d5","priority":0.335,"reason":"default-advisory","recalled":false,"scenarios":["Implementer of T2 introduces an 'endpoint family' grouping concept that the parent explicitly ruled out, keying the provider counter off a family label rather than the (provider, endpoint) identity the parent mandates.","Test authors write provider-fuse boundary tables against 'families' rather than distinct endpoint identities, diverging from the parent's counter-attribution model."],"severity":"major","suggested_fix":"Replace 'two endpoint families' in T2's Outcome and second AC with 'two distinct endpoints of the same provider', and align the child's counter-attribution language with the parent's (provider, endpoint) identity model.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"na","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"insufficient","impact_follows_necessarily":"insufficient","is_verifiable":"no","no_existing_mitigation":"insufficient","no_viable_alternative_explanation":"insufficient","path_reachable":"insufficient","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"insufficient"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State how `retry_not_before` is computed for a deferred plan (clock source, interval/backoff, or whether it inherits a provider Retry-After), so the deferral metadata is deterministic.","cohort":["COH","E1","E2","F1","T2","T4"],"criteria":["E2"],"decision":"dropped","decision_margin":-0.3487,"drop_reason":null,"evidence":["AC: 'Remaining matching work is explicitly deferred with reason/scope/`retry_not_before`'","Step 5: 'defer remaining matching plans with reason/scope/retry metadata'","Thresholds bullet: 'remaining matching plans defer with reason/scope/`retry_not_before`'","ABSENCE: no computation/provenance for the retry_not_before value is stated anywhere in the plan"],"finding":"The plan references `retry_not_before` (and 'retry metadata') as deferral output but never specifies how the retry-not-before timestamp is computed — from what clock, using what backoff/interval, or whether it derives from a provider Retry-After signal.","group_criteria":null,"group_id":null,"id":"fc986dda3748f1243","impact":0.67,"is_primary":null,"location":"Acceptance Criteria (line 5) / Step 5 / Fuse Thresholds bullet","norm_id":"na3e395e8b3a53177","priority":0.2513,"reason":"low-validity","recalled":false,"scenarios":["Executor must emit retry_not_before but has no rule for its value, so two implementers could pick different defaults (fixed delay vs exponential vs Retry-After header)."],"severity":"major","suggested_fix":"","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unveri