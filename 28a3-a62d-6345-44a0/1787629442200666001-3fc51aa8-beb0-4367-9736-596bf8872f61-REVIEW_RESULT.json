G6"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["Plan: 'terminal retryable_deferred (cumulative-sleep cap MAX_CUMULATIVE_SLEEP_MS hit before MAX_INVOCATIONS ...) ... Only the terminal retryable_deferred counts'","adapters/jira_datacenter/summary_executor.py test (test_dc_summary_executor.py:190-191): a transient GET fault ends 'retryable_deferred with request_count=1 and no PUT/read-back' — a fresh first attempt, not an exhausted budget","summary_operation.py:_classify_write_error / classify_rest_error return Disposition.retryable_deferred directly for any transient network class regardless of budget state","retry_budget.py: the terminal defer signal is RetryBudget/plan_next_retry action=='defer' (cumulative-sleep cap) or action=='exhausted' (MAX_INVOCATIONS) — a signal separate from the disposition enum value"],"finding":"The fuse's 'eligible exhausted outcome' cannot be identified from the retryable_deferred disposition alone; adapters emit retryable_deferred on a first-attempt transient fault (request_count=1) before the shared budget retries, so keying the counter off disposition over-counts non-exhausted transients.","group_criteria":null,"group_id":null,"id":"f2a50fa396d6e5ddb","impact":1.0,"is_primary":null,"location":"Fuse scope, eligibility & counter semantics — 'Eligible exhausted outcome' bullet","norm_id":"n3b571fcd71cdb92f","priority":0.8,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A single flaky first GET across 2 tickets on one endpoint yields 3 retryable_deferred outcomes with request_count=1 that never consumed the retry budget; the fuse trips at threshold and defers healthy independent work — a premature stop the plan explicitly forbids"],"severity":"critical","suggested_fix":"Define eligibility off the budget's terminal state (RetryBudget action=='exhausted' → exhausted_transient, or action=='defer' at the MAX_CUMULATIVE_SLEEP_MS cap → terminal retryable_deferred) rather than the disposition enum alone; require the outcome to carry that terminal-budget marker (or invocation/cumulative-sleep evidence) before it can increment an inferred fuse counter.","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P5"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["tests/unit/rebar_reconciler/mutate/test_operation_coordinator.py: 67d4-ecba-cf95-4353 & d0ec-da23-32ba-47c6 (no ordering edge)"],"finding":"Sibling tickets touch the same file(s) with no ordering edge.","group_criteria":null,"group_id":null,"id":"f82524518cbf636a6","impact":0.4,"is_primary":null,"location":"","norm_id":"na0177dc3af65d74f","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Add a depends_on/blocks edge to serialize, or partition the file ownership.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"d