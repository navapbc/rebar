6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"25a562e58da576e96327b4ede87298fc6408422181b2eb62d8eb49ae6c1043e4","event_uuid":"515bd7ca-2704-4b15-8a30-ccdd2e797d32","position":{"commit_sha":"3268f783edb2e67476d2644627ac8dac0eeeae1c","position":"1787348304864222611-515bd7ca-2704-4b15-8a30-ccdd2e797d32"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"da4683d30a5e9676b3e6933f4ddfa1ec1c7aec267dfb1e897465f4c4c6c642f7","event_uuid":"dff94ad3-b232-4766-b40a-ca170aa26154","position":{"commit_sha":"34b71bcb3fb3e475ba64cb56ebf7b9484fa1ec0d","position":"1787350599137522001-dff94ad3-b232-4766-b40a-ca170aa26154"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"ESCALATION — design fork, not proceeding without a recorded decision. This ticket's recorded scope is ambiguous between two mutually exclusive options: (1) add a synthetic-tree test registering a prefixed KNOWN_ENV_HELPERS row and asserting both scanners (gen_env_registry._scan_call and check_config_ownership._helper_access) apply the prefix — cheap, keeps the feature honest; or (2) remove the prefix field from both consumers, simplifying both tables to a bare int — which the ticket itself flags as 'a behaviour-narrowing change and needs its own review'. The AC is written as 'Either … or …', so neither option is the recorded decision. Analysis toward that decision: all 9 live rows declare an empty prefix; the only historical user (_rebar_env with REBAR_) was drained by the RP-04 cutover d361eb28e4; the prefix APPLICATION code is still live in both scanners (grep confirms 'prefix + lit' at gen_env_registry.py _scan_call and check_config_ownership.py _helper_access), so this is an unused-but-wired feature, not dead code — deletion would narrow behaviour, and covering it would preserve optionality at the cost of testing an unused feature. A human/owner should pick option 1 or 2 and record it here (or split option 2 into its own reviewed ticket per the ticket's own note); then implementation is mechanical either way. No code touched under this ticket.","timestamp":1787339950513974001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OPERATOR RULING (recorded by orchestrator): Option 2 — REMOVE the prefix field from both consumers, simplifying both KNOWN_ENV_HELPERS tables to a bare int. Rationale (operator + orchestrator analysis): the feature is unused-but-wired with no live row using a prefix and no honest coverage (the 84c7-era assertion is vacuous with every live prefix empty); repo policy prefers deleting unused code over adding tests for an unused feature; a future prefixed helper can re-add the field with real coverage at that point. Scope: strip the prefix element from the row tuples in scripts/gen_env_registry.py and scripts/check_config_ownership.py, drop the 'prefix + lit' application code in _scan_call and _helper_access, update tuple-shape-touching tests; docs/env-vars.md must be unchanged (no live row used a prefix). This resolves the design fork escalated in the previous comment; description AC will be rewritten to this chosen fork before plan review.","timestamp":1787345637776702001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented per the operator ruling. Removed the prefix element: KNOWN_ENV_HELPERS is now dict[str, int] in gen_env_registry.py (all 9 rows bare ints); _scan_call records the literal directly; _call_key_expr reads the bare int (the third consumer the plan reviewer caught); check_config_ownership._helper_access resolves the bare literal. Tests updated: heldout fixture test destructures the bare int and asserts plain SOME_KNOB; helper-coverage wrong_position map reads registered[name]; ghost-row literal is 0. Also dropped the now-false '(and any name prefix)' clause from the UnregisteredEnvReadHelper message. Behaviour-preserving for every live row (all prefixes were empty): docs/env-vars.md regenerates byte-identical (git status clean for it; gen_env_registry --check exit 0), ownership gate exit 0. Gates: make lint PASS, mypy PASS (620 files), complexity ratchet new=0 increased=0, 61 targeted tests pass.","timestamp":1787348050000879001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"PS1 Verified -1 root cause (not this change): the worktree branched from an origin/main commit (34086d29d8) inside a broken window of main — tests/unit/test_spawn_detached.py::test_the_detached_spawn_signature_appears_only_in_proc failed because rebar/_snapshot/gc_trigger.py leaked the detached-spawn signature; main already fixed it in 7213e082b5 ('Route the snapshot-GC spawn through spawn_detached'). Reproduced locally at the old base (1 failed), remediated by a server-side Gerrit rebase of change 2026 onto current main (PS2) + local rebase; all 69 targeted tests incl. the guard now pass. No retry-until-green: deterministic root cause, environmental to the base, not the diff.","timestamp":1787350599137522001}],"created_at":1787312098916508001,"creation_channel":"cli","deps":[{"link_uuid":"f83f21ed-99cf-4566-ae1e-39e3872d19ef","relation":"discovered_from","target_id":"84c7-486f-9a13-4c3f"},{"link_uuid":"515bd7ca-2704-4b15-8a30-ccdd2e797d32","relation":"relates_to","target_id":"9e45-2584-0edf-49e8"}],"description":"## Observation\nAfter bug 84c7 removed the four ghost rows, **all 9 remaining `KNOWN_ENV_HELPERS` rows\ndeclare an empty prefix**. `_rebar_env: (0, \"REBAR_\")` was the only row that ever used the\nsecond tuple element, and its helper was drained out of the tree by the RP-04 cutover\n(`d361eb28e4`).\n\nThe prefix is still applied at `scripts/gen_env_registry.py` `_scan_call`\n(`reads.setdefault(prefix + lit, ...)`) and at `scripts/check_config_ownership.py`\n`_helper_access` (`return self._resolved_env(node, prefix + lit)`).\n\n## Why it matters\nThe feature has **zero production users and zero live end-to-end coverage**, and its only\nhistorical coverage passed for the wrong reason (see the 84c7 comment correction). An\nunused-but-wired feature in two CI gate scripts is a maintenance hazard: it cannot rot\nvisibly, only silently.\n\n## Decision (operator ruling, recorded in comments)\n**Remove the prefix field from both consumers**, simplifying both tables to a bare int\n(`helper name -> 0-indexed position of the env-name argument`). Rationale: no live row uses\na prefix, the 84c7-era held-out assertion is vacuous with every live prefix empty, and repo\npolicy prefers deleting unused code over testing an unused feature. A future prefixed\nhelper can re-add the field together with real coverage.\n\nScope:\n- `scripts/gen_env_registry.py`: `KNOWN_ENV_HELPERS` becomes `dict[str, int]`; `_scan_call`\n  stops applying a prefix and `_call_key_expr` reads the bare int instead of subscripting\n  `[0]` on the row (the third live consumer of the tuple shape).\n- `scripts/check_config_ownership.py`: `_helper_access` stops applying a prefix.\n- Tests touching the tuple shape updated:\n  `test_known_env_helper_call_resolves_and_fires` in\n  `tests/scripts/test_check_config_ownership_heldout.py` is rewritten fully off the tuple\n  (the line-99 `(pos, prefix)` destructuring becomes a bare-int read, the line-104\n  `prefix + \"SOME_KNOB\"` assertion becomes a plain `\"SOME_KNOB\"` assertion, and the\n  line-96 comment stops describing a prefix); the ghost-row literal `(0, \"\")` in\n  `tests/unit/test_gen_env_registry.py` becomes `0`; the `registered[name][0]`\n  subscripts (lines 106/108) in `tests/unit/test_env_registry_helper_coverage.py` become\n  bare-int reads.\n- `docs/env-vars.md` regenerates byte-identical (no live row used a prefix).\n\n## Acceptance criteria\n- [ ] The prefix field is removed from `KNOWN_ENV_HELPERS` in both consumers and the\n      `prefix + lit` application code is gone from `_scan_call` and `_helper_access`.\n- [ ] `make lint`, `make typecheck` and `make test` stay green.\n- [ ] `docs/env-vars.md` is unchanged by the work (no live row uses a prefix).\n\n## Provenance\nObserved while fixing bug 84c7 (surprised-convincing-gopher); recorded rather than repaired\nthere. The remove-vs-cover design fork was escalated and resolved by operator ruling —\nsee comments.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"scripts/gen_env_registry.py","reason":"KNOWN_ENV_HELPERS becomes dict[str,int]; _scan_call drops prefix application; _call_key_expr reads the bare int"},{"path":"scripts/check_config_ownership.py","reason":"_helper_access drops prefix application"},{"path":"tests/unit/test_gen_env_registry.py","reason":"ghost-row literal loses the tuple shape"},{"path":"tests/scripts/test_check_config_ownership_heldout.py","reason":"held-out fixture test stops destructuring (pos, prefix)"},{"path":"tests/unit/test_env_registry_helper_coverage.py","reason":"registered[name][0] subscripts become bare-int reads"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","9e45-2584-0edf-49e8"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"965ab8ad-ff54-445a-8fb5-7b3b23f13329","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"3a57-82b0-74bb-44e8","ticket_type":"task","title":"KNOWN_ENV_HELPERS prefix field has no live user and no live coverage","verify_commands":[]},"source_event_uuids":["4ee9e263-23c3-470e-9d81-c8bb240badab","c7146430-8ff6-4b29-82b8-6b5c346910d5","3d4d7571-74f4-40bb-a34d-afe6a3c13d5f","bd53bc42-d8e3-4c8d-bff0-2538c436a2dd","b7883fef-d162-4d6c-bfab-8e09f466d8d7","2920468a-f033-4495-9901-51402e714735","2c49dd25-3a1f-4e05-86a5-99beac21c2de","1efdc8bf-8782-4167-ae0f-ce5573125cad","c8fd202c-59db-4930-bde8-19f5f24e243e","965ab8ad-ff54-445a-8fb5-7b3b23f13329","7421d75a-cdd2-46cf-8e4d-2493bba5913d","4c46f2c7-e9a0-4278-b9fe-bdbc53c6444c","515bd7ca-2704-4b15-8a30-ccdd2e797d32","dff94ad3-b232-4766-b40a-ca170aa26154"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787350599137522002,"uuid":"28638cf0-921b-465b-8db1-7f5b37cdc5de"}