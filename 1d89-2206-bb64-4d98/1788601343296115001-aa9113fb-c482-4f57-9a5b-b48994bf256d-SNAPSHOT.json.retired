19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788594869468850001,"creation_channel":"cli","deps":[{"link_uuid":"d6b66461-736d-49cd-8ec9-32656cb9920f","relation":"discovered_from","target_id":"a0f1-b86c-5199-4a42"}],"description":"## Context / Problem\nOn `origin/main` at `c019920390926d543a0813d4c0c8721543d98776`, `docs/gerrit-aws-setup.md:72-74` describes a bare `pip install .[agents,reviewbot]`, while `infra/compose/Dockerfile.reviewbot` uses the locked uv install with `agents,reviewbot,bedrock`. Lines 211-215 describe two compose containers, but the stack now runs Gerrit, review-bot, opcert, and MCP; nginx remains host-side. This gives operators a stale dependency and topology model.\n\n## Approach\nUpdate the operator guide to match the current Dockerfile and compose topology. Leave historical ADR text unchanged.\n\n## Acceptance Criteria\n- [ ] The review-bot installation description matches the locked uv command and current extras in `Dockerfile.reviewbot`.\n- [ ] The deployment topology names all four compose services and distinguishes host-side nginx.\n- [ ] Historical ADR 0007 remains unchanged.\n- [ ] Documentation checks and `make lint` pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/gerrit-aws-setup.md","reason":"Align operator-facing install and deployment topology guidance with current review-bot image and compose services."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"open","tags":["documentation","gerrit","infra","drift"],"ticket_id":"1d89-2206-bb64-4d98","ticket_type":"bug","title":"Update Gerrit AWS setup for locked review-bot install and four-service stack","verify_commands":[]},"source_event_uuids":["9edda117-e7b6-4805-9e34-cb418295d29a","2c58d364-15d7-4025-9a88-596f7a8948cc","d6b66461-736d-49cd-8ec9-32656cb9920f"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788601343296115001,"uuid":"aa9113fb-c482-4f57-9a5b-b48994bf256d"}