a374d1ee12c12642a8c3138ec3b9258ed3b","position":"1786610442356557001-30607021-7da0-4b3b-8917-b43c07004f53"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c2a687ccb2d18135f8ee53846a52106b7d6becdc1697ce0d55d80ec36d2cfdc2","event_uuid":"02596291-8cb4-4c0f-8ff5-24fd5f52c245","position":{"commit_sha":"1992d40f625b86316b600df99b2ec43656b30162","position":"1786610445926675001-02596291-8cb4-4c0f-8ff5-24fd5f52c245"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2c6122a48a17e89a3ae1676f2c04e3c0f2714480a5d82488ca761aeed7f54a4e","event_uuid":"946dd2e0-3fe4-4ae6-88a3-dce8074bba8b","position":{"commit_sha":"89c0e3e717de19f9454f16597c014e34736aa8d3","position":"1786610449749882001-946dd2e0-3fe4-4ae6-88a3-dce8074bba8b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f592283feba751de3c2b0354799ef3ca1e7da0e95b52c7ed7a2693efe86ef193","event_uuid":"f6b1ffef-f9ba-45cd-b33a-67f7daf54325","position":{"commit_sha":"0fd1294d8a5c3f5b4e9772b1e9b76fc8f703c958","position":"1786638492515538001-f6b1ffef-f9ba-45cd-b33a-67f7daf54325"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Premise VALIDATED against current main, with the seam located precisely.\n\n`test_a_missing_epic_field_aborts_provisioning` stubs `/rest/api/2/field` to return a body carrying `Epic Name` but not `Epic Link`, so the readiness poll can only expire. It expires against the real production budget: `scripts/jira_dc_field_readiness.py:114` `FIELD_READY_BUDGET_S = 120.0`, polled at `FIELD_POLL_INTERVAL_S = 1.0` (line 95). `await_required_fields` (line 226) loops request -> `if monotonic() >= deadline: break` -> `sleep(interval)`, so the unit test performs ~120 stub reads and sleeps ~120 real seconds. That matches the filed 120.39-121.03s.\n\nOne correction to the ticket's framing, caught by plan review. The ticket says \"the readiness API already accepts injected sleep and monotonic functions\", which is true of `await_required_fields` — but the caller under test does NOT forward them. `_assert_project_capabilities` (`tests/external/live_jira_dc/conftest.py:580-581`) computes `field_budget = _field_ready_timeout()` and passes `budget=` explicitly, so injection is unreachable from the test without changing a production signature. `_field_ready_timeout()` (line 157) reads `JIRA_DC_FIELD_READY_TIMEOUT` and only falls back to the module constant when it is unset — so monkeypatching `FIELD_READY_BUDGET_S` would ALSO have been silently defeated whenever that variable is set in the ambient environment. The env var is the one seam that is deterministic from the test, and `tests/unit/test_live_jira_dc_conftest.py:296` already uses it.","timestamp":1786605113594373001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fix + measurements.\n\n`monkeypatch.setenv(\"JIRA_DC_FIELD_READY_TIMEOUT\", \"0\")` in the test, plus an assertion that the stub saw exactly ONE `/rest/api/2/field` read.\n\n| | before | after |\n|---|---|---|\n| `test_a_missing_epic_field_aborts_provisioning` call | **120.38s** | **<0.005s** (below the durations floor) |\n| whole test invocation | 121.21s | **0.73s** |\n\n**-120.4s of wall clock**, and it was pure idle — the CPU was asleep.\n\nWhy a zero budget is the right lever rather than merely a small one: `await_required_fields` always makes at least one attempt, then breaks on `monotonic() >= deadline` BEFORE calling `sleep`. So with budget 0 the loop is DETERMINISTIC — exactly one poll, zero sleeps — which is what makes the poll-count assertion a real guard rather than a timing heuristic. Reaching a real sleep requires another lap, and another lap necessarily produces a second field read.\n\nGuard proven live. Changing the injected budget from `0` to `3` (i.e. letting it actually sleep):\n\n    E       AssertionError: expected exactly one field poll, got 4\n    FAILED tests/unit/test_live_jira_dc_provisioning.py::test_a_missing_epic_field_aborts_provisioning\n\nReverted immediately.\n\nAmbient-environment robustness proven. Re-running with `JIRA_DC_FIELD_READY_TIMEOUT=300` already exported: **1 passed in 0.69s** — `setenv` overrides an ambient value rather than being defeated by it. This is exactly the case that would have silently broken a `FIELD_READY_BUDGET_S` monkeypatch, since `_field_ready_timeout()` prefers the env var.\n\nIsolation and production defaults: `tests/unit/test_live_jira_dc_provisioning.py`, `test_live_jira_dc_conftest.py` and `test_jira_dc_capability_map_workflow.py` run together — **58 passed in 4.36s** — so the override did not leak. `git diff --stat origin/main` for `scripts/jira_dc_field_readiness.py` and `tests/external/live_jira_dc/conftest.py` is EMPTY: `FIELD_READY_BUDGET_S` is still 120.0 and no production readiness behaviour changed.\n\nGates: 11 `check_*` scripts pass, `check_wall_clock_asserts` clean (the new assertion is a poll count, not a time budget), complexity `active=59 new=0 increased=0 stale=0`, lint and typecheck clean.","timestamp":1786605792536240001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OSS consensus audit (2026-08-13): APPROVED pattern, already merged as 6f37d9495b.\n\nPopular active projects avoid paying production retry/readiness time in deterministic tests. Kubernetes advances a fake clock in delaying-queue tests instead of waiting (kubernetes/kubernetes@52ba901, staging/src/k8s.io/client-go/util/workqueue/delaying_queue_test.go#L30-L56). Tenacity injects a list.append sleeper and asserts the exact logical schedule [1,2,3,3] (jd/tenacity@26f719d, tests/test_tenacity.py#L590-L604). urllib3 mocks time.sleep when testing Retry-After (urllib3/urllib3@52dfb19, test/test_retry.py#L411-L440).\n\nThis remediation follows that consensus with a zero logical budget and an exact one-poll assertion; it preserves the 120s production default and all failure coverage. Tracker cross-check: related readiness/capability tickets were read during RCA; none rejected logical-time test control. The implementation saved 120.4s for the individual test.","timestamp":1786638492515538001}],"created_at":1786598847621814001,"creation_channel":"cli","deps":[{"link_uuid":"3e8e05fe-6ad4-40cf-b040-fbf74e9df50d","relation":"discovered_from","target_id":"ba7d-a412-bbc0-45cb"},{"link_uuid":"ac31549e-5784-4d26-a41a-93423eb7bb7b","relation":"relates_to","target_id":"feec-dc8b-fc4d-4aed"},{"link_uuid":"946dd2e0-3fe4-4ae6-88a3-dce8074bba8b","relation":"caused_by","target_id":"3fe5-c22e-dc2d-4c9e"}],"description":"## Context / Problem\n\n`tests/unit/test_live_jira_dc_provisioning.py:195`\n(`test_a_missing_epic_field_aborts_provisioning`) stubs `_request` so\n`/rest/api/2/field` returns a body with `Epic Name` but WITHOUT `Epic Link`, then\ncalls `harness._assert_project_capabilities(\"RBTEST\")`. The missing field is\npermanently absent under the stub, so the readiness poll can only expire — and it\nexpires against the real PRODUCTION budget.\n\nThat budget is `scripts/jira_dc_field_readiness.py:114`,\n`FIELD_READY_BUDGET_S = 120.0`, polled every `FIELD_POLL_INTERVAL_S = 1.0`\n(line 95). `await_required_fields` (line 226) loops\n`request` -> `if monotonic() >= deadline: break` -> `sleep(interval)`, so the unit\ntest performs ~120 stub reads and sleeps ~120 real seconds to learn something the\nstub decided up front. That matches the filed 120.39-121.03s.\n\nThe seam is already provided. `_assert_project_capabilities`\n(`tests/external/live_jira_dc/conftest.py:580-581`) does NOT rely on the module\nconstant: it computes `field_budget = _field_ready_timeout()` and passes\n`budget=field_budget` explicitly. `_field_ready_timeout()` (line 157) reads the\n`JIRA_DC_FIELD_READY_TIMEOUT` environment variable and only falls back to\n`FIELD_READY_BUDGET_S` when it is unset. And `await_required_fields` documents\n(line 252) that at least one attempt is always made \"even with a zero or negative\nallowance — the answer must come from an observation, never from arithmetic\".\n\n## Approach\n\nSet the readiness budget to zero for this one test through the environment\nvariable the production code already honours, and assert the resulting poll count.\n\n* `monkeypatch.setenv(\"JIRA_DC_FIELD_READY_TIMEOUT\", \"0\")` inside the test.\n  `monkeypatch` restores the environment at teardown, so no other test and no\n  production path sees it; the committed `FIELD_READY_BUDGET_S` stays `120.0`.\n  Going through the env var rather than rebinding `FIELD_READY_BUDGET_S` is what\n  makes this deterministic: the caller passes `budget=` explicitly, so a constant\n  rebind would be silently defeated whenever `JIRA_DC_FIELD_READY_TIMEOUT` is\n  already set in the ambient environment, whereas `setenv` overrides it either way.\n* With a zero budget the loop is fully DETERMINISTIC rather than merely fast: one\n  attempt is made unconditionally, `monotonic() >= deadline` is then true, and the\n  loop breaks BEFORE `sleep` is ever called. So the test asserts that the stub saw\n  exactly ONE `/rest/api/2/field` read.\n\nThat single assertion is the required guard, and it is stronger than a timing\nbudget: reaching a real sleep is only possible by going round the loop again, which\nnecessarily produces a second field read and fails the count. It contains no\nwall-clock assertion.\n\n`_stub_request` (line 72) already returns its recorded `(method, path, payload)`\nlist, so the poll count is available without new plumbing.\n\nThis is the mechanism the sibling suite already uses —\n`tests/unit/test_live_jira_dc_conftest.py:296` sets the same environment variable\nfor the same reason — so it adds no new pattern to the tree. A fake\n`sleep`/`monotonic` pair was rejected: `await_required_fields` accepts them, but\n`_assert_project_capabilities` does not forward them, so injecting would mean\nchanging a production signature to serve a test.\n\n## Scope\n\n* `tests/unit/test_live_jira_dc_provisioning.py` — set the zero budget and assert the\n  poll count in `test_a_missing_epic_field_aborts_provisioning`; note why in the\n  test docstring.\n\nNo production change: `scripts/jira_dc_field_readiness.py` and\n`tests/external/live_jira_dc/conftest.py` are read but not modified.\n\n## Testing\n\n* Happy path — the test still raises `AssertionError` naming `Epic Link`, i.e. the\n  existing assertion is untouched, and now also pins one field read.\n* Failure/edge path — the guard is proven by seeding: temporarily removing the\n  `setenv` is confirmed to make the poll-count assertion FAIL (many reads), not\n  merely run slowly. Seed reverted, not committed.\n* Ambient-environment check — the test is also run with\n  `JIRA_DC_FIELD_READY_TIMEOUT=300` already exported, confirming the `setenv`\n  overrides an ambient value rather than being defeated by it.\n* Isolation check — the neighbouring readiness tests and the rest of the module\n  still pass in the same session, confirming `monkeypatch` restored the env.\n* Production-default check — `FIELD_READY_BUDGET_S` is still `120.0` in the\n  committed tree, read directly from the source.\n* Whole-suite regression — the CI pytest command is green.\n\nNo wall-clock or timing-budget assertion is added; savings go in ticket comments.\n\n## Acceptance Criteria\n\n- [x] `test_a_missing_epic_field_aborts_provisioning` still raises the same\n      `AssertionError` naming `Epic Link` — verified by the unchanged\n      `pytest.raises` plus substring assertion still passing.\n- [x] The test asserts exactly one `/rest/api/2/field` read, which proves the\n      expiry path ran without reaching `sleep` — verified by the new assertion\n      passing and by the seeded-budget run failing it.\n- [x] The test completes in under 2 seconds where it took ~120s — measured with\n      `pytest --durations` and posted as a before/after ticket comment.\n- [x] `scripts/jira_dc_field_readiness.py` and\n      `tests/external/live_jira_dc/conftest.py` are byte-identical to `origin/main`,\n      confirmed by an empty `git diff --stat origin/main -- <those paths>`, so\n      production readiness defaults are unchanged.\n- [x] The rest of `tests/unit/test_live_jira_dc_provisioning.py` and\n      `tests/unit/test_live_jira_dc_conftest.py` pass in one session, showing the\n      env override did not leak.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_live_jira_dc_provisioning.py","reason":"drive the missing-field readiness poll with a zero logical budget and assert the poll count instead of sleeping the production 120s"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","feec-dc8b-fc4d-4aed"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"30607021-7da0-4b3b-8917-b43c07004f53","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"closed","tags":["ci","performance","tests","jira"],"ticket_id":"e394-9433-c839-4c9f","ticket_type":"bug","title":"Missing-field unit test burns the full 120-second Jira readiness budget","verify_commands":[]},"source_event_uuids":["4a32a226-3943-4590-9007-a072f2415952","3e8e05fe-6ad4-40cf-b040-fbf74e9df50d","c4882712-5a2b-4dcb-8e44-5bcc9699c569","9212cd20-4ed9-4df4-87e8-fc8ba4864a3e","56aea396-4f45-44f6-990f-1e3f551d93b7","96eef37d-590c-4f95-b303-4dfe84a18bde","76ef85a4-89a4-432a-bdc6-3d19bb4673c8","2aa583d6-d287-45bc-9bef-910f3cd7b2c4","88abb21c-451c-457b-a19a-02cab2b1ed84","b74fc0d7-f72a-4aac-966e-60eef1379c05","ac31549e-5784-4d26-a41a-93423eb7bb7b","aea313c1-bb88-49b8-88e6-b774985dbac7","30607021-7da0-4b3b-8917-b43c07004f53","02596291-8cb4-4c0f-8ff5-24fd5f52c245","946dd2e0-3fe4-4ae6-88a3-dce8074bba8b","f6b1ffef-f9ba-45cd-b33a-67f7daf54325"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659685261504001,"uuid":"63c7719e-8638-4070-8d60-fba61c1f8b1b"}