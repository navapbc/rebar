rset, so a degraded identity is diagnosable in steady state; state the disposition in the plan.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5d","T5e","T7"],"criteria":["T5b"],"decision":"advisory","decision_margin":-0.95,"drop_reason":null,"evidence":["'a malformed or over-long hint is dropped (identity degrades to mcp:<principal>), never an error'","Step 1 uses only a 'temporary debug log line reading the hint back' — removed after the probe, so steady state has no instrumentation of drops"],"finding":"A malformed/over-long X-Rebar-Session-Id hint is silently dropped in steady state with no log/metric, leaving no operator signal for why a client's sessions collapse to principal-only identity.","group_criteria":null,"group_id":null,"id":"f26c66e981c13ed53","impact":0.0,"is_primary":null,"location":"Approach — 'Failure disposition' + 'Hint seam'","norm_id":"n5c355975827edc6f","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":["An operator sees a client's sessions all sharing mcp:<principal> and cannot tell whether the header is absent, malformed, or over-long"],"severity":null,"suggested_fix":"Add a single debug-level log line in SessionHintMiddleware when a non-empty header value fails validation (length/charset), distinct from the absent-header case, and note it in docs/mcp-auth.md.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergen