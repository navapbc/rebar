{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787984306189281521,"compiled_state":{"alias":"weaponless-textile-cutworm","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"25ea12c200aea35eee057172c133eddcee2d0aa1","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 879b-9bf0-86fd-4a6b","material: f6a1e6711bcf01a1","material-part: children 647ea2107ca5072f 0","material-part: description ba2dbd4661888f1a 6698","material-part: description_boxes 90a512a5b8a10706 0","material-part: file_impact 0d78022b2ab25aea 3","material-part: ticket_id 825fb4bdbfc7d6f3 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (25ea12c200ae)","regver: aa61189569d34126","verified-at-sha:ec6e11df0a2ec1dc31ce99b7b5551a65cdc0bfc2","dep 25522fdec582617201083b28b705346d9d0196c455fb849c0ad7914e3d65eaaf src/rebar/_mcp_health.py","dep 258803baf6f6d45779c0950aa15c7d2cb9b7db123ff2b5f2586b250474a53af5 src/rebar/_opcert_signing.py","dep e9415dc2a8d853356522dbc36c99912ef4470b681c9ec58754ff4fcb2ff38e3f tests/unit/test_opcert_public_counterpart_guard_879b.py","read-set: 6","read-path: docs/adr/0104-mcp-on-box.md","read-path: src/rebar/_mcp_health.py","read-path: src/rebar/_opcert_binding.py","read-path: src/rebar/_opcert_signing.py","read-path: src/rebar/mcp_server.py","read-path: src/rebar/signing.py","currency-basis: file_impact"],"material_fingerprint":"f6a1e6711bcf01a1","merged_log_commit":"ec6e11df0a2ec1dc31ce99b7b5551a65cdc0bfc2","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787975901384025000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"0b47989e26660773016420e66058db55a874d8bf9943e5fb6940ec98b75833fe","event_uuid":"ea547b11-8d30-4bdf-8f66-dd838335b42a","position":{"commit_sha":"72d720176289c7a6cfaaccacc0e9d4df861358c2","position":"1787961423289163001-ea547b11-8d30-4bdf-8f66-dd838335b42a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c6ab171f9cd614fb67ad426a7f836a40f014a7dcbe1d262d08a8f411d4a492c8","event_uuid":"39847453-9231-416f-872c-f8e59f7b5f0d","position":{"commit_sha":"9cb0ec90fcf0088bcc17342f5fd0f2bbec1b42ce","position":"1787966102263938001-39847453-9231-416f-872c-f8e59f7b5f0d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d7f646c7f7d758593aba335b6eb6cea4aaf5b88292c69db405efdf98d88799e2","event_uuid":"ead4e8ef-d0ae-4eca-9ff7-01c1e8549c2b","position":{"commit_sha":"8d86a769d702d7a6b8173e272025b008d99cc87b","position":"1787971170836189460-ead4e8ef-d0ae-4eca-9ff7-01c1e8549c2b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b971bc54f4ab61aa591bdb690958bde5560420cd17e9c48bd873dacb02885232","event_uuid":"9fa9c2ae-506e-48f1-95d8-368d17e19879","position":{"commit_sha":"c24579a9d9f3842cddeaed4613448f1ce50c20e2","position":"1787973167492687399-9fa9c2ae-506e-48f1-95d8-368d17e19879"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7076b615923ed928b315499f9802ad4107f5534a05f9faa7fece78ee03dafcf2","event_uuid":"0c40578c-fab8-4c18-adf2-e4e439ebb61b","position":{"commit_sha":"816e4a0356c21f9b160fe60ed5d7937a5692a950","position":"1787973507360786001-0c40578c-fab8-4c18-adf2-e4e439ebb61b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"62ba3a7922fbca2e18ae3743d41d79e7de097c472ef9a524c5d1aaec357e4754","event_uuid":"25cee18c-a6ac-4031-a037-ee69e55b7a23","position":{"commit_sha":"c5654949548a7209a949faff632bbc984fd04ad6","position":"1787973560065320001-25cee18c-a6ac-4031-a037-ee69e55b7a23"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"59a6e1e24dc69f23be9017f165c4d2fe7973e00af4ecd1e5c94c3e51f4f565e3","event_uuid":"79209d28-5e1e-4f61-98ef-94dd0657520a","position":{"commit_sha":"b99ca31d9262cb572d1c14fce024973f013f3dbf","position":"1787974430698410001-79209d28-5e1e-4f61-98ef-94dd0657520a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9707b51b69cb5c6ac292b05c4b3904b3279252b028fd3d7ee725213369cd8137","event_uuid":"3dfaca4a-1ba5-4aaf-b686-f9aa1f55af74","position":{"commit_sha":"6b1ac20fedeaa63fbf9b75b8df7b4044fdfc79ca","position":"1787974930662260001-3dfaca4a-1ba5-4aaf-b686-f9aa1f55af74"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"06a9ec7b096ff9a190b642a1f0361671df7903f59d56dbac9d00de48a69fc0a0","event_uuid":"305fc1b8-bb59-4ca0-b218-70a0426ce68f","position":{"commit_sha":"6c1c24eb7d2d0fad487981084eee207a02b987b4","position":"1787975647402614001-305fc1b8-bb59-4ca0-b218-70a0426ce68f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5932cb42dd4de773f944e802c36c44d9f624e576b4615b66a899070f352a26ba","event_uuid":"72ccdb46-7c6c-442d-a74b-ca6485308cf9","position":{"commit_sha":"26afa2e1c41d1a7306b66948ce43eacf56a8d569","position":"1787975901446688001-72ccdb46-7c6c-442d-a74b-ca6485308cf9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e37001605c445403eeb4435e88e5b50f956e67e418d316d135fe370dcc60734b","event_uuid":"fb418985-0e02-4cdc-9e18-64ec6c6354f8","position":{"commit_sha":"e871d4efc25c082aed347230812dae6c42b1cf75","position":"1787976809349009596-fb418985-0e02-4cdc-9e18-64ec6c6354f8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 1 RCA — mechanism proven; classified `incomplete-implementation` (cited); ESCALATED on AC3 design decision\n\nInvestigated under /rebar-debug in a fresh worktree off `origin/main`\n(`565e1856bc9d180876fdbcaa336ccd57ceb8202e`; the 2337 fix `83edf99` is an ancestor).\nStep 0: no duplicate ticket; sole report. Reported-against floor = current `origin/main`.\n\n### Proven mechanism (the guards are genuinely ABSENT — an omission, not broken behaviour)\n\n- **AC1/AC2 (mint-time warning) — absent.** `sign_manifest` → `_sign_manifest_under_lock` →\n  `_prepare_manifest_event` → `mint_opcert_record` (`src/rebar/_opcert_signing.py:293`) resolves\n  the signing key via `ensure_opcert_key`/`_opcert_own_key_paths` and mints, but never invokes the\n  verify-side resolver `_opcert_own_public_keys` to check whether a public counterpart is\n  resolvable. Confirmed statically: `_opcert_own_public_keys` has exactly ONE caller —\n  `verify_opcert_record` (`_opcert_signing.py:550`) — and none on the mint path. So no warning is\n  emitted when the public half is unresolvable.\n- **AC3 (startup/deploy health check) — absent.** No public-counterpart / `_opcert_own_*` /\n  `_read_opcert_pub` check exists anywhere in `mcp_server.py`, `_mcp_health.py`, or\n  `_opcert_binding.py` (grep: zero hits). `compose_startup_opcert_binding` (`mcp_server.py:717`)\n  validates only the PRIVATE key (present / 0600 / Ed25519 / not-encrypted, via `compose_signer`)\n  and aborts startup on an unusable signer — it never checks that a public counterpart is\n  resolvable.\n\nThese are `static` (content) hypotheses, confirmed by source + reference-set inspection; there is\nno runtime failure to reproduce because the whole defect is a SILENCE.\n\n### Legitimacy: `incomplete-implementation` (cited), NOT a fresh feature request\n\nDesign authority establishing these guards were *meant to exist*:\n- Parent bug `d26a-8ffa-97cd-4b2a` (`dire-expectable-terrapin`), closed `plan_defect`, explicitly\n  scoped **AC5 (mint-time WARNING) + AC6 (deploy/startup health check)** and SPLIT them into this\n  ticket as \"additive guards against the class regressing.\" That parent plan passed plan-review.\n- Designed-but-unwired seams already in-repo: the verify-side `_opcert_own_public_keys` resolver\n  (AC1), the `run_startup_store_sweep` startup-warning idiom (AC1), and the fail-closed startup\n  validator `compose_startup_opcert_binding` (AC3).\n\nSo approval is NOT the open question → not a `feature-request`, not `intended-behavior`. This is a\ndeferred, scoped omission = `incomplete-implementation`.\n\n**Attribution (scope-of-work).** This is an omission, so there is no introducing commit that\n\"broke\" it. By scope-of-work it attributes to `d26a-8ffa-97cd-4b2a` — the ticket whose acceptance\ncriteria (AC5/AC6) the missing behaviour falls under, which shipped the key-resolution fix without\nthese deferred guards.\n\n### Why I am ESCALATING rather than auto-fixing (per operator instruction)\n\nThe mint-time warning (AC1/AC2) is cleanly auto-fixable: purely additive, non-refusing, fully\npinned by the cited authority (warn, naming the resolved key path + principal; do not refuse; the\nexisting success path and returned signature are unchanged). Mirrors `run_startup_store_sweep`.\n\n**AC3 is NOT pinned by the cited authority** — it \"requires a design decision\" and \"alters\ndeploy-time behaviour,\" which the operator reserved for themselves. AC3 says the health check\n\"FAILS,\" but the repo contains TWO deliberate, conflicting precedents:\n\n- **(a) Hard-abort startup** — extend the existing fail-closed `compose_startup_opcert_binding`\n  (which already aborts on an unusable signer). Scoped to the on-box signing deploy only (both\n  `REBAR_OPCERT_ENV_ID` + `REBAR_IDENTITY_SIGNING_KEY` set); dev/stdio/genesis returns `None`\n  early and is unaffected; a correctly-configured deploy (post-2337, which derives the public line\n  in-process) still passes. Only a misconfigured signing deploy newly refuses to serve.\n- **(b) Report a degraded field, never abort** — mirror `store_status` / `/health` +\n  blue-green readiness gate. `_mcp_health.py` documents the explicit invariant: \"a health probe\n  that can fail is worse than one that reports a degraded field,\" and `run_startup_store_sweep` is\n  log-and-continue (\"a missing store must not abort boot\"; only `RemovedInputError` fails hard).\n\nThese behave materially differently on a misconfigured deploy (refuse-to-serve vs serve-degraded),\nand the choice is not resolved by the cited authority. Per the operating instruction to escalate\ndesign decisions / behaviour changes, I am handing this call to the operator.\n\n**Recommendation:** proceed on AC1/AC2 as specified; for AC3 adopt **option (a)** (extend\n`compose_startup_opcert_binding`, gated on the on-box signing deploy) — it is the closest existing\nprecedent (\"an unusable signer aborts startup\"), fail-closed matches the parent bug's whole point\n(silently-uncertifiable attestations are worse than a refused boot), and it has zero blast radius\non dev/stdio and on correctly-configured deploys. If the operator prefers non-aborting deploy\nposture, option (b) is the alternative. Awaiting direction before Phase 2 / any Gerrit push.\nNo `--force` or gate bypass was used; no code change pushed.","timestamp":1787961399818854001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 2 complete — fix pushed to Gerrit change 2360.\n\n## Root cause (proven, Phase 1)\nThe op-cert signing subsystem had NO guard surfacing a signing key whose public\ncounterpart the same-environment verify path cannot resolve. `mint_opcert_record`\n(_opcert_signing.py) never consulted `_opcert_own_public_keys` (its sole caller was\nthe verify path, :550), and no counterpart check existed in mcp_server.py /\n_mcp_health.py / _opcert_binding.py. This is the exact divergence class Gerrit 2337\n(parent d26a) fixed — write-side key resolution diverging from verify-side resolution\nso signing succeeds but verify returns `foreign_key` and the claim gate refuses every\nticket — with nothing to surface it. Genuine omission.\n\n## Classification & legitimacy\n`incomplete-implementation` (NOT feature-request): parent d26a-8ffa-97cd-4b2a\n(dire-expectable-terrapin, closed plan_defect) explicitly SPLIT its deferred AC5\n(mint-time warning) + AC6 (startup health check) into THIS ticket as \"additive guards\nagainst the class regressing.\" Design authority cited → completing/wiring the approved\nwork is restoration, not creation.\n\n## Fix (per the operator's reframed AC3)\nTwo additive, NON-REFUSING guards:\n- AC1/AC2 (mint warning): `_warn_if_verify_cannot_resolve` in `mint_opcert_record`\n  logs a WARNING naming key_path + principal when the same-env verify resolver cannot\n  resolve a public counterpart for the key just signed under; still returns the\n  signature. Silent on the healthy path.\n- AC3 (serve-degraded, NEVER abort): `opcert_signing_status` /\n  `opcert_signer_degraded` / `run_startup_opcert_check` in `_mcp_health.py` check the\n  ONE non-redundant condition the derived-key path can't catch: does the bound signer's\n  public key match the pinned `rebar.attest.trusted_env` key for its principal. Exposed\n  as a `/health` \"opcert\" field + a boot warning. `expected` gates strictness like\n  `store_status` (only when `.rebar/trusted_environments.yaml` is present), because\n  required-env binding is advisory today (ADR 0104 dec. 3). Did NOT extend\n  `compose_startup_opcert_binding` to abort; did NOT add a redundant derive probe.\n\n## Test (RED->GREEN, held-out, mutation-checked)\n`tests/unit/test_opcert_public_counterpart_guard_879b.py` (7 tests). Seen RED first\n(AC1 on assertion `[]`; AC3 on AttributeError = capability absent), GREEN after.\nMutation check (sandboxed, sandbox-exec): removing the mint guard -> AC1 RED; forcing\n`opcert_signer_degraded` False -> both AC3 degraded tests RED; restored -> GREEN. Tests\nassert observable output (log messages / dict fields), not private names.\n\n## Scope & safety\n- Caller sweep: production explicit-signer paths run inside `bound_signer(signer)`\n  (jobs.py:91), so the mint guard's resolver won't false-warn. All production\n  environment self-signing funnels through the guarded `mint_opcert_record`.\n- Restoration not creation (cited design authority d26a); no new dependency (all\n  imports pre-existing); no pre-existing test weakened.\n- Regression sweep: 349 passed / 3 skipped across opcert/mcp_health/trusted_env/signing.\n  Lint + typecheck clean. Non-test diff 109 lines (< 150 floor -> no review-plan needed).\n\n## Siblings (Step 7)\n- Axis 1 (construct): the only environment-derivation mint path is `mint_opcert_record`\n  -- covered. No other instances.\n- Axis 2 (parity): `sign_opcert_manifest` (:611) signs an op-cert bypassing the guard,\n  but it takes an EXPLICIT caller-supplied key and has NO production caller (test/remote-\n  cert primitive, keystone e4df) used to sign under deliberately foreign/remote keys.\n  879b's env-derivation divergence cannot arise there, and the same-env warning would\n  false-positive on foreign-key signing -> N/A by design, not MISSING. `/health` is the\n  single health surface; status stashed for both http + stdio.\n\n## Defect origin\nAttributed by scope-of-work to d26a-8ffa-97cd-4b2a (the parent that scoped AC5/AC6 and\ndeferred them into this ticket). Omission -> no introducing commit; will be recorded via\nthe non-gated `--caused-by=d26a-8ffa-97cd-4b2a` on close. `caused_by` link already\nrecorded in Phase 1.\n\n## Replication\nOriginal report (\"no guard surfaces a signing key with no usable public cert\") no longer\nholds: the mint path warns, and `/health` reports a degraded `opcert` field + boot\nwarning on the pinned-key mismatch.\n\n## Gerrit\nChange 2360 — https://rebar.solutions.navateam.com/c/rebar/+/2360 — awaiting\nLLM-Review +1 AND Verified +1 before Submit.","timestamp":1787966102263938001}],"created_at":1787958889453970705,"creation_channel":"mcp","deps":[{"link_uuid":"d4819b83-7682-413f-bf53-2b3769e1a8ec","relation":"discovered_from","target_id":"d26a-8ffa-97cd-4b2a"},{"link_uuid":"ea547b11-8d30-4bdf-8f66-dd838335b42a","provenance":"explicit","relation":"caused_by","target_id":"d26a-8ffa-97cd-4b2a"},{"link_uuid":"ead4e8ef-d0ae-4eca-9ff7-01c1e8549c2b","relation":"relates_to","target_id":"3e6e-7507-b7c7-47a2"},{"link_uuid":"9fa9c2ae-506e-48f1-95d8-368d17e19879","relation":"relates_to","target_id":"e643-c43a-8256-43c7"},{"link_uuid":"fb418985-0e02-4cdc-9e18-64ec6c6354f8","relation":"relates_to","target_id":"d9cb-37fa-76ea-4245"}],"description":"## Context / Problem\nSplit out of `d26a-8ffa-97cd-4b2a` (`dire-expectable-terrapin`), where these were carried as\nits DEFERRED AC5 and AC6. That bug fixed the key-path DIVERGENCE that made the deployed MCP\nserver sign op-certs it could never verify (Gerrit 2337, merged as\n`83edf9972728ae1e0729a39098ec70e4fab4617a`): verification now resolves the public half from the\nsame ordered chain the signing side resolves the private half.\n\nWhat that fix did NOT add is any GUARD. `sign_manifest` still mints a certificate without\nchecking that the environment can resolve a public counterpart for the key it just signed\nunder, and nothing at deploy/startup surfaces it when it cannot. So the CLASS of defect — a\nsilently uncertifiable attestation — can regress the moment a new deployment shape puts the\nsigning key somewhere the resolution chain does not reach. Signing succeeds; only a later\n`verify_signature` (or a refused claim) reveals the problem, potentially long after the\ncertificates were minted.\n\n## Approach\nTwo independent, additive guards, neither of which changes an existing success path:\n\n1. At MINT: after `ensure_opcert_key` resolves the SPECIFIC signing key path used for this\n   mint, read THAT key's own public line with `_read_opcert_pub(key_path)` and check whether it\n   is a MEMBER of the verify-side resolvable set `_opcert_own_public_keys`\n   (`src/rebar/_opcert_signing.py`). Matching is on the key TYPE+BASE64 BODY (comment-\n   insensitive), mirroring ssh `allowed_signers`. The check is membership of the specific\n   signing key's public counterpart, NOT merely the non-emptiness of the aggregate chain — a\n   chain where a DIFFERENT key resolves a pub must NOT satisfy the guard for the key actually\n   signed under. When the specific key's counterpart is absent, emit an explicit WARNING naming\n   the resolved key path and the principal. It must NOT refuse — refusing would break every\n   existing sign flow and is a behaviour change beyond this bug's scope.\n\n   Worked example (specification by example). Own-key chain = [binding-key `K_b`, genesis\n   `K_g`]. `ensure_opcert_key` selects `K_g` for this mint (binding absent), but only `K_b`'s\n   `.pub` is derivable (K_g lives on a path the resolver cannot reach). Aggregate\n   `_opcert_own_public_keys` = {body(K_b)} — NON-EMPTY. A non-emptiness check would stay\n   SILENT (wrong). The specified membership check computes `body(_read_opcert_pub(path_of\n   K_g))` ∉ {body(K_b)} → WARNS (correct), naming `path_of K_g` and the principal.\n\n2. At STARTUP/DEPLOY: the MCP server's existing health surface (`src/rebar/_mcp_health.py`)\n   reports a DEGRADED field and logs a boot WARNING when the bound startup signer's public key\n   is not the pinned trusted-environment key for its principal — the ONE same-environment\n   failure the (derivative) public key cannot otherwise catch. SERVE-DEGRADED, never abort\n   boot (operator ruling; ADR 0104 decision 3 makes required-environment binding advisory\n   today), mirroring `store_status` / `run_startup_store_sweep`.\n\nBoth are in-process checks driven by an operation and by server startup, with no dependency on\nany particular CI provider.\n\n### AC3 reframing (operator ruling, recorded here)\nThe op-cert public key is DERIVATIVE (`_derive_opcert_pub` = `ssh-keygen -y`, re-derivable on\ndemand from the private key), and `compose_startup_opcert_binding` already fails closed on a\nbad/missing/encrypted/non-Ed25519 private key. So a \"can we resolve/derive a public cert?\"\nstartup probe would be REDUNDANT. The one genuinely non-redundant condition is whether the\nbound signer's public key MATCHES the environment's pinned/published trusted-environment key\n(`rebar.attest.trusted_env`) — the key required-environment verify checks against. Even that is\nnon-blocking: those are still valid signed attestations that only fail an advisory\nenvironment-binding check, so AC3 emits a degraded health field + a warning and does NOT refuse\nto serve or abort boot.\n\n## Scope\n- In scope: the mint-time warning and the startup/health serve-degraded surface.\n- Out of scope: the key-resolution chain itself (already fixed by 2337); any change to the\n  cross-environment `foreign_key` verdict, which is documented intended behaviour (ADR 0104),\n  not a defect; extending `compose_startup_opcert_binding` to abort; a redundant derive probe.\n\n## Testing\nUnit tests: a mint under a key whose SPECIFIC public half cannot be resolved (even when another\nchain key's pub resolves) emits the warning and still returns a signature; a mint under a\nresolvable key emits no warning; the startup/health check reports degraded (and warns) for a\nbound signer whose public key is not the pinned key, and is quiet/non-degraded for a matched\nkey, for an unbound signer, and for a deployment that has not opted into pinning; key matching\nis on the key type+base64 body (comment-insensitive); a resolution fault is surfaced as\ndegraded (not swallowed); a `RemovedInputError` fails hard.\n\n## Acceptance Criteria\n- [ ] AC1: `sign_manifest` emits an explicit WARNING — naming the resolved signing key path and the principal — when the SPECIFIC key it just signed under has no public counterpart in the verify-side resolvable set (`_read_opcert_pub(key_path)` body ∉ `_opcert_own_public_keys`), even if a different chain key's pub resolves; it still returns the signature (no refusal, no existing sign flow broken).\n- [ ] AC2: `sign_manifest` emits no such warning when the specific signing key's public counterpart IS resolvable.\n- [ ] AC3: the MCP server's startup/health surface reports a DEGRADED `opcert` field and logs a boot WARNING when the bound signer's public key is not the pinned trusted-environment key for its principal, and is non-degraded/quiet when it matches (or when unbound / pinning not configured). Non-blocking: it NEVER aborts boot (serve-degraded; ADR 0104 decision 3).\n- [ ] AC4: both guards are in-process and operation-linked, with no dependency on a specific CI provider.\n\n## Definition of Done\n- [ ] DD1: AC1 and AC2 covered by a test that is RED before the change and GREEN after it, including the specific-key case where a different chain key's pub resolves (aggregate non-empty) yet the signed key's own counterpart is absent.\n- [ ] DD2: AC3 covered by a test over the startup/health check (degraded, matched, unbound, and not-pinned cases).\n- [ ] DD3: AC4 verified by the observable proxy that both guards execute with no CI-provider environment present — the unit tests exercise mint and startup/health with no CI env vars set and assert the warning/degraded behaviour purely from in-process log/dict output (no network, no CI API), confirming operation/startup-linked triggers.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_opcert_signing.py","reason":"AC1/AC2: mint-time WARNING guard (_warn_if_verify_cannot_resolve) + _ssh_pub_body key-body normalization helper"},{"path":"src/rebar/_mcp_health.py","reason":"AC3: serve-degraded startup/health surface (opcert_signing_status/opcert_signer_degraded/run_startup_opcert_check) + /health opcert field + boot check"},{"path":"tests/unit/test_opcert_public_counterpart_guard_879b.py","reason":"RED->GREEN oracle for AC1-AC3 incl. comment-insensitive match, error-degraded, and RemovedInputError re-raise regressions"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","3e6e-7507-b7c7-47a2"],["relates_to","d9cb-37fa-76ea-4245"],["relates_to","e643-c43a-8256-43c7"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"a4c073d9-7df9-4b0b-8da7-e4dcc9b42b03","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":["opcert","mcp","deploy","attestation"],"ticket_id":"879b-9bf0-86fd-4a6b","ticket_type":"bug","title":"No guard surfaces a signing key with no usable public counterpart: sign_manifest stays silent and startup does not fail","verify_commands":[]},"source_event_uuids":["ea547b11-8d30-4bdf-8f66-dd838335b42a","39847453-9231-416f-872c-f8e59f7b5f0d","ead4e8ef-d0ae-4eca-9ff7-01c1e8549c2b","9fa9c2ae-506e-48f1-95d8-368d17e19879","0c40578c-fab8-4c18-adf2-e4e439ebb61b","25cee18c-a6ac-4031-a037-ee69e55b7a23","79209d28-5e1e-4f61-98ef-94dd0657520a","3dfaca4a-1ba5-4aaf-b686-f9aa1f55af74","305fc1b8-bb59-4ca0-b218-70a0426ce68f","72ccdb46-7c6c-442d-a74b-ca6485308cf9","fb418985-0e02-4cdc-9e18-64ec6c6354f8"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787984306189281521,"uuid":"6d177f9e-a871-4a3d-b8a2-68873befa12b"}