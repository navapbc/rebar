:"b00d2c01133d782a0d77769613057327b9b8555ec98de95d8372ff4ba782d6b9","event_uuid":"200fbe00-89a6-4113-a69e-df64c6e0d9d4","position":{"commit_sha":"913757dcbd66d9c2a9d4b392e1747837c0c5a467","position":"1788400452412724001-200fbe00-89a6-4113-a69e-df64c6e0d9d4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"03db0b3ec9314faaebc515c2bbfb438cf72b87cdaea7cfaf5e09cc0e7952cd57","event_uuid":"8b39777a-c203-436f-9f47-5d2132434fee","position":{"commit_sha":"b5e68df9b54d220f09362046f29f93e781506dc9","position":"1788400467649392001-8b39777a-c203-436f-9f47-5d2132434fee"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7a70a47b5b1652b2fe95a63af7408726fa480d4a69ac084bcf5d5368b8d6f2e3","event_uuid":"8a122d03-6bff-4471-82c6-a2a1d1f43c52","position":{"commit_sha":"b4f7ae95551f72c95e89235d74d20b0ad4dad6ba","position":"1788403852958133001-8a122d03-6bff-4471-82c6-a2a1d1f43c52"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"de8e7e363de1ad2fed1e495c587db4b921d3eb329e6bb748e16d01b5862795d5","event_uuid":"2941ef24-2a80-4eff-a889-99054d1bfb2c","position":{"commit_sha":"20a071c94bbb58aa7a0d4bfd46a8d14aa33a9067","position":"1788403876140258001-2941ef24-2a80-4eff-a889-99054d1bfb2c"},"sig