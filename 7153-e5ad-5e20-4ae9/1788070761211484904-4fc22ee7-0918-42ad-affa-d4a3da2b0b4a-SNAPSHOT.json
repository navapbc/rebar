6f-0cadcda8f9d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e51512677364c035be635f2b1ec19522963e5d6be393e45556827b6a6ee0a579","event_uuid":"2188e6d1-9ee4-4f78-9b36-158a41bb53b0","position":{"commit_sha":"53881620d2e84542e3918ab42e907fd7408f339e","position":"1788068725950722001-2188e6d1-9ee4-4f78-9b36-158a41bb53b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a72831f05655993ffcfbaf0a01a75a17efd120e9f662c150af7716f8d7d229f5","event_uuid":"95f34929-917e-436a-a5ee-44d6b9218cb7","position":{"commit_sha":"f7539798210e0eb272ed9b0c4ef1511152efa395","position":"1788068740619068001-95f34929-917e-436a-a5ee-44d6b9218cb7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Dependency/scope notice: keep this story unchanged and bounded to run_differs.py, outbound_differ.py, and applier.py. New sibling `piscine-bullish-cowbird` separately owns reconcile.py/reconcile_helpers.py. Both follow `scummy-ultrashort-tuatara` and must close before typed implementation; their file impacts are deliberately disjoint.","timestamp":1788055573648937632}],"completion_expectation":"required","created_at":1788033535832514921,"creation_channel":"mcp","deps":[{"link_uuid":"963be9ce-b62c-4ed9-8c84-5fb97a2112c8","relation":"blocks","target_id":"e9d5-c850-d505-4a5a"},{"link_uuid":"f02e6d61-803f-47f1-ac70-9b88e68fdd85","relation":"relates_to","target_id":"7f2f-3e1c-9b02-4944"}],"description":"## Context / Problem\n\nThe typed reconciler payload work (earthborn-statuelike-boutu) introduces a named direction/action payload union threaded through the planner, coordinator, and adapter-projection seam. The modules that build/project those payloads are already within a handful of lines of the hard 800-LOC module-size cap (`.github/module-size-limit.txt` = 800), so that expand would breach the CI module-size gate on first edit:\n\n- `src/rebar/_engine/rebar_reconciler/run_differs.py` = 798\n- `src/rebar/_engine/rebar_reconciler/outbound_differ.py` = 793\n- `src/rebar/_engine/rebar_reconciler/applier.py` = 793\n\nCreate headroom FIRST as a behavior-preserving extraction along existing call-graph seams, so the typed cutover lands without fighting the module-size gate. This story adds no typed-payload logic; it only relocates existing clusters.\n\n## Approach\n\nExtract cohesive, already-clustered helpers into sibling modules (existing call-graph seams only; target 200-500 LOC; never create a module < 100 LOC; never split mechanically):\n\n- `run_differs.py`: move the outbound sub-pass (`_run_differs_outbound` + its alert emitters `_emit_outbound_field_alerts` / `_emit_recovery_failure_alerts`) into a sibling module.\n- `outbound_differ.py`: move the memoized effective-mapping resolvers (`_memoize_effective`, `_effective_status_map_for`, `_effective_type_map_for`, `_effective_priority_map_for`, `_effective_create_defaults_for`, `_effective_link_map_for`, `_effective_excluded_sync_types_for`) into a sibling module.\n- `applier.py`: DEFAULT to the cross-project/drift cluster (`HeadDriftError`, `CrossProjectTargetError`, `_cross_project_targets`, `_recheck_drift`, PLUS the module-level `_JIRA_KEY_RE` regex that `_cross_project_targets` depends on — it moves with the cluster so no back-edge into `applier.py` is needed) — fully self-contained, yields ~793->~723 LOC (comfortably below 800; short of the AC1 700 target, which is a SOFT aim here, not a hard bar — 723 is acceptable given the batch-cluster fallback below is circular-import-prone). Fall back to the batch-execution cluster (`_apply_batch`, `_apply_one`, `_print_batch_recon`) only if that headroom proves insufficient; that cluster instead calls back into applier.py-resident symbols, so choosing it requires re-exporting those back-references too.\n\n**Re-export requirement (load-bearing):** every symbol relocated out of `applier.py` or `run_differs.py` MUST be re-exported back into the ORIGINAL module via a top-level `from <sibling> import <name>  # noqa: F401` (mirroring the pattern already used repeatedly in both files, e.g. `outbound_differ.py`'s `outbound_assignee`/`outbound_comments`/`outbound_labels`/`outbound_links` splits and `applier.py`'s own `apply_base`/`apply_handlers`/`apply_outbound`/`batch_dispatch`/`pass_io`/`rebar_id_audit`/`typed_dispatch` splits). The resident internal caller must keep resolving the symbol via the ORIGINAL module's own globals (a bare-name reference, not a qualified `sibling.name()` call) so it binds to whatever is currently in that module's namespace at call time. Required because:\n\n- Multiple unit tests patch/reference the to-be-moved symbols through the ORIGINAL module namespace by attribute name (found via string-name grep, not LSP structural refs): `tests/unit/rebar_reconciler/mutate/test_apply_batch_drift_tolerance.py` (`pytest.raises(applier.HeadDriftError)`, `applier._apply_batch(...)`); `tests/unit/rebar_reconciler/conflict/test_conflict_filing_deferred.py` (`monkeypatch.setattr(applier, \"_apply_batch\", ...)`); `tests/unit/rebar_reconciler/apply/test_applier_cross_project_guard.py` (`pytest.raises(applier_mod.CrossProjectTargetError)`); `tests/unit/rebar_reconciler/test_live_mode_failure_tally.py` (`monkeypatch.setattr(applier, \"_recheck_drift\", ...)`); and three `run_differs`-module fixtures (`diffing/test_snapshot_differ_stale_local_state.py`, `state/test_run_differs_wires_refresh_scoped_snapshot_79a4.py`, `orchestrate/test_ticket_plan_shadow.py`) all doing `monkeypatch.setattr(run_differs_mod, \"_run_differs_outbound\", ...)`.\n- A production in-package consumer also reads a relocated symbol off the ORIGINAL module by attribute: `batch_dispatch.py` does `applier.HeadDriftError` via its own `lazy_load(\"rebar_reconciler.applier\", \"applier.py\")`. `HeadDriftError` MUST remain resolvable as `applier.HeadDriftError` after relocation.\n- `outbound_mutation_builders.py` imports the five `_effective_*_for` resolvers from `outbound_differ` directly — unaffected by the re-export (still imports from `outbound_differ`, which itself re-exports from the new sibling); named here for inventory completeness.\n- Additional original-namespace consumers, all edit-free via the re-export: `tests/integration/test_reconcile_live_e2e.py` (`run_differs._emit_outbound_field_alerts`); `test_live_mode_failure_tally.py` (`applier.CrossProjectTargetError`, `applier._recheck_drift`); `test_applier_drift.py` (`applier.HeadDriftError`, `applier._drift_is_benign`); `test_applier_cross_project_guard.py` (`applier_mod._cross_project_targets`); `test_outbound_multi_project.py`, `test_run_differs_recovery_no_write.py`, `test_parent_drop_parity_8390.py`, `test_parent_emit_suppression_is_loud_9f26.py`, `test_outbound_field_conflict_and_drop_alerts.py` (`run_differs._emit_outbound_field_alerts` / `_run_differs_outbound` direct calls or fixtures); `test_status_mapping.py`, `test_link_mapping.py` (`outbound_differ._effective_status_map_for` / `_effective_link_map_for`). Scope includes `tests/integration/test_reconcile_live_e2e.py` alongside the unit suites.\n\nPublic entry points and import paths keep working via this re-export; only the IMPLEMENTATION moves, not the original module's namespace resolution.\n\n## Scope\n\n- `src/rebar/_engine/rebar_reconciler/` — extract named clusters into new sibling modules; re-export each relocated symbol back into its original module (top-level import); update imports only elsewhere.\n- `tests/unit/rebar_reconciler/` and `tests/integration/test_reconcile_live_e2e.py` — import-path updates only; no assertion changes. Tests patching the ORIGINAL module namespace (enumerated above) need NO changes — the re-export keeps them resolving.\n\n## Testing\n\nExisting reconciler unit/integration suites pass unchanged, including every string-keyed monkeypatch/patch.object/pytest.raises site enumerated above. Module-size gate + complexity ratchet pass. Lint + typecheck pass. No new CI-provider/network/Docker/Jira dependency.\n\n## Acceptance Criteria\n\n- [x] `run_differs.py`, `outbound_differ.py`, and `applier.py` are each comfortably below 800 LOC (target <= 700), achieved only by extracting existing call-graph clusters into sibling modules.\n- [x] No newly created module is below 100 LOC, and no extraction is mechanical.\n- [x] Every relocated symbol is re-exported back into its original module via a top-level import, and every internal caller in that module resolves it via a bare/module-namespace reference — so `applier.HeadDriftError`/`CrossProjectTargetError`/`_apply_batch` (if chosen)/`_cross_project_targets`/`_recheck_drift`, `run_differs._run_differs_outbound`/`_emit_outbound_field_alerts`/`_emit_recovery_failure_alerts`, and `outbound_differ._effective_status_map_for` (+ siblings)/`_memoize_effective` all keep resolving, and every enumerated monkeypatch/pytest.raises site continues to work with zero assertion changes.\n- [x] `batch_dispatch.py`'s `applier.HeadDriftError` attribute read keeps resolving after the applier.py extraction.\n- [x] Behavior is unchanged: existing reconciler test suites pass with no edits beyond import paths.\n- [x] Module-size gate, per-function complexity ratchet, lint, and typecheck all pass.\n- [x] No production write-route change and no typed-payload/union logic is introduced here; that remains earthborn-statuelike-boutu.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/run_differs.py","reason":"Extract _run_differs_outbound (outbound sub-pass driver) into a sibling to create headroom before the typed cutover; alert emitters stay here for _load-patch compatibility."},{"path":"src/rebar/_engine/rebar_reconciler/outbound_pass.py","reason":"NEW sibling module: extracted _run_differs_outbound from run_differs.py."},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"Extract memoized effective-mapping resolvers into a sibling to create headroom."},{"path":"src/rebar/_engine/rebar_reconciler/outbound_effective_maps.py","reason":"NEW sibling module: extracted the memoized effective-mapping resolvers from outbound_differ.py."},{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"Extract the cross-project/drift cluster into a sibling to create headroom."},{"path":"src/rebar/_engine/rebar_reconciler/applier_drift_guard.py","reason":"NEW sibling module: extracted the cross-project/drift cluster from applier.py."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["blocks","e9d5-c850-d505-4a5a"],["parent","eb64-844b-ab7a-4915"],["relates_to","7f2f-3e1c-9b02-4944"]],"no_file_impact_reason":"","parent_id":"eb64-844b-ab7a-4915","parent_status_uuid":"2188e6d1-9ee4-4f78-9b36-158a41bb53b0","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["reconciler","refactor","module-size"],"ticket_id":"7153-e5ad-5e20-4ae9","ticket_type":"sto