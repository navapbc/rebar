AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3937fea6bbef8d5e78acf694de2d0d4d8f3a5017575416a25d1922ba3ccb0738","event_uuid":"f31c44f8-58c8-4be9-961e-2363daa338f3","position":{"commit_sha":"6f82039208a150cc688e9b8b7461b9e5d1ab8a13","position":"1788444975359742001-f31c44f8-58c8-4be9-961e-2363daa338f3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"51b0deb55bed33db4788274550e2e0a27c4db0f53b314d90eb0d4a2f71e2a7e2","event_uuid":"0dbfa07b-7876-4c3a-9e5b-56bf4b2642f4","position":{"commit_sha":"fa413f5eed218970e9c15f9c15b7fd1187804408","position":"1788445003302473001-0dbfa07b-7876-4c3a-9e5b-56bf4b2642f4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0ab69b796f5a9d0faf14f50e43ff42d3112c3754aceb06f911722ed3e07af31a","event_uuid":"7895ca23-e611-426e-9010-371d1256c7a1","position":{"commit_sha":"fa413f5eed218970e9c15f9c15b7fd1187804408","position":"1788445006085594001-7895ca23-e611-426e-9010-371d1256c7a1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"57475f7aa54e37a9c61843e0e07b9332b3fbaf555631289bc5613290aee362e2","event_uuid":"5cce3bd8-554c-40da-b049-9b4cdf58bc69","position":{"commit_sha":"1a49293392400a55591f8089366d9695e4052976","position":"1788445695632867580-5cce3bd8-554c-40da-b049-9b4cdf58bc69"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Corrected root-cause after plan-review BLOCK (E4). Original premise (current _slim omits norm_id for DET findings) was refuted: sidecar.py:664 emits norm_id unconditionally via norm_id() which never returns None. Actual cause is schema-VINTAGE: commit 314e4191c826 (2026-06-29) added the norm_id field to _slim; REVIEW_RESULT events committed before it lack the key. Scan of _review_findings over the tracker: 1437/79914 findings lack norm_id, ALL with event-ts < 2026-06-29, ZERO after, spanning both tiers (LLM 1299, DET 138). Removed the incorrect bug 884d citation (884d is about the verification block, not norm_id). Fix (defensive .get + skip) unchanged.","timestamp":1788444182852024001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review v2 BLOCKED (G6, impact 1.0, correct): _fire_rows-only fix was incomplete — _author_response_norm_ids -> classify_finding_survival (labels.py:167,169) subscripts f[norm_id] on the same norm-less findings and would still crash. Adopted reviewer's boundary-filter: normalize norm-less findings out once at the select_candidates entry, covering all 6 subscript sites (fixture_selection.py:234 + labels.py:167,169,184,220,221) and both select_candidates + select_from_corpus. Updated Approach/ACs/File-impact accordingly.","timestamp":1788444701329223001}],"created_at":1788443599471530001,"creation_channel":"cli","deps":[{"link_uuid":"80f437fe-6ef0-41aa-a837-9069668f843b","relation":"discovered_from","target_id":"65dd-e93b-666a-4caa"},{"link_uuid":"5cce3bd8-554c-40da-b049-9b4cdf58bc69","relation":"relates_to","target_id":"ab45-98a9-14bb-4eea"}],"description":"## Context\n\n`fixture_selection.select_candidates` groups a criterion's matched findings by `norm_id` and\nalso compares finding `norm_id` sets across a ticket's successive reviews. On the REAL committed\nplan-review corpus these paths raise `KeyError: 'norm_id'`. `select_from_corpus` reconstructs\nfindings from every `REVIEW_RESULT` sidecar event across ALL committed history\n(`_review_findings` -> `corpus._load_ticket_events`, keyed by review-event uuid). The `norm_id`\nfield is emitted by the sidecar `_slim` projection UNCONDITIONALLY — current `_slim`\n(`sidecar.py:664`, `\"norm_id\": norm_id(f)`) writes it for every finding regardless of tier, and\n`norm_id()` (`sidecar.py:311-319`) never returns None. That line was ADDED by commit\n`314e4191c826` (2026-06-29). Sidecar events committed BEFORE that commit predate the field, so\ntheir reconstructed findings carry no `norm_id` key at all — the crash is a schema-VINTAGE gap in\nhistorical records, NOT current `_slim` tier behavior.\n\nEvidence (scan of the tickets tracker via `_review_findings`, recorded here as the\n`[non-codebase]` provenance attestation for this root-cause claim): 1437 of 79914\ncriterion-naming findings lack a `norm_id` key; ALL 1437 have a review-event timestamp before\n2026-06-29 and ZERO are after; they span BOTH tiers (LLM 1299, DET 138). The vintage cutoff\nmatches commit `314e4191c826` exactly. The first such finding aborts the whole\ncandidate-selection pass, so the fixture-mining pipeline (epic 65dd-e93b-666a-4caa) cannot run\nover real history at all — it blocks ticket 67aa's live admission run (AC10).\n\nA norm-less finding is subscripted `finding[\"norm_id\"]` at SIX sites reached from\n`select_candidates`: the `_fire_rows` grouping (`fixture_selection.py:234`) AND — via\n`_author_response_norm_ids` -> `classify_finding_survival` — `labels.py:167,169`, plus\n`_criterion_sets`/churn `labels.py:184,220,221`. A fix scoped to `_fire_rows` alone would leave\nthe `classify_finding_survival` path (reached whenever a ticket has two reviews with differing\n`material_fingerprint`) still crashing.\n\n## Approach\n\nNormalize norm-less findings out ONCE at the `select_candidates` entry — the single point every\neligible review passes through before ANY norm-keyed consumer. At the top of `select_candidates`,\nrebuild each review as `{**review, \"findings\": [f for f in review[\"findings\"] if\nf.get(\"norm_id\") is not None]}`, then proceed unchanged. Because `_eligible_reviews`, `_fire_rows`,\n`_no_fire_rows`, and `_author_response_norm_ids` all derive from this list, the single normalization\ncovers all six subscript sites — and it protects BOTH the public `select_candidates` (direct\ncallers / tests) and `select_from_corpus` (which calls it).\n\nRationale for the entry-boundary normalization over scattered per-consumer defensive reads: a\nfinding with no `norm_id` has no stable cross-review identity, so it cannot participate in ANY\nnorm-keyed operation (reproduction-consensus grouping, author-response survival, or per-criterion\nchurn) — excluding it once at the entry is both the minimal single-point fix and semantically\ncorrect. For every norm-BEARING finding the normalized lists are byte-identical to today, so all\nexisting selection behavior is unchanged. No change to `labels.py` is needed: the boundary keeps\nnorm-less findings from ever reaching it.\n\n## Acceptance Criteria\n\n- [ ] `select_candidates` no longer raises `KeyError: 'norm_id'` when an eligible review's findings\n      include a criterion-naming finding with no `norm_id` key, exercised through BOTH norm-keyed\n      paths: `_fire_rows` grouping AND the `_author_response_norm_ids` -> `classify_finding_survival`\n      survival path (two reviews of one ticket with differing `material_fingerprint`, at least one\n      norm-less finding) — the run returns rows without error (`pytest`).\n- [ ] A finding lacking `norm_id` contributes NO candidate and does not perturb the candidates\n      produced by norm-bearing findings for the same criterion: the emitted rows for an eligible\n      set containing a norm-less finding equal the rows produced when that finding is absent\n      (`pytest`).\n- [ ] Existing norm-bearing selection behavior is unchanged: the module's current\n      `test_fixture_selection` suite still passes (`pytest`).\n- [ ] Selection remains deterministic — two `select_candidates` runs over the same eligible set\n      return byte-identical manifest rows (`pytest`).\n\n## Definition of Done\n\n`make lint` / `make typecheck` / targeted `pytest` pass; the fix lands through Gerrit\n(`LLM-Review +1` and `Verified +1`); the fixture-mining selection pass runs over the real\ncorpus without the `norm_id` KeyError.\n\n## File impact\n\n- `src/rebar/llm/evals/fixture_selection.py` — normalize norm-less findings out at the\n  `select_candidates` entry (single point; covers `_fire_rows` + the `classify_finding_survival`\n  and churn paths in `labels.py`).\n- `tests/unit/test_fixture_selection.py` — held-out regression: a norm-less finding routed\n  through both the fire-grouping and the author-response/survival paths.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/evals/fixture_selection.py","reason":"defensive norm_id read + skip in _fire_rows"},{"path":"tests/unit/test_fixture_selection.py","reason":"held-out regression for norm-less finding"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","ab45-98a9-14bb-4eea"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"0dbfa07b-7876-4c3a-9e5b-56bf4b2642f4","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"57c4-4834-2a7a-4a05","ticket_type":"bug","title":"fixture_selection._fire_rows KeyError on findings without norm_id blocks real-corpus selection","verify_commands":[]},"source_event_uuids":["bf215ea1-6598-42d9-8d91-397118ae3143","80f437fe-6ef0-41aa-a837-9069668f843b","42177dc9-8799-4e26-b593-adf4ea6c717c","2b06a2a6-55bb-432e-85ba-667c879f78e7","de065348-3c7f-4013-992c-6427f8226f3d","c20df1ec-133d-4edc-9ce8-d4d449dbf765","ba5ba79c-155a-4b75-9950-5748f182bd96","f31c44f8-58c8-4be9-961e-2363daa338f3","0dbfa07b-7876-4c3a-9e5b-56bf4b2642f4","7895ca23-e611-426e-9010-371d1256c7a1","5cce3bd8-554c-40da-b049-9b4cdf58bc69"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788445695632867581,"uuid":"bbe643b9-d3f9-4c31-a949-57cd5d01df1e"}