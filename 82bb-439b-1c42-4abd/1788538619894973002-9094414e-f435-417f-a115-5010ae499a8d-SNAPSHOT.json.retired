navapbc.com"},{"content_hash":"fb3a132965c41e6915683e140310218c702941951dd5dd6270bf72133df8cc5f","event_uuid":"1aae0bff-5f62-43c0-86e0-6531470b0af1","position":{"commit_sha":"1fe0c6b515de158df3f86697632cce4f68a737c4","position":"1788534414087115001-1aae0bff-5f62-43c0-86e0-6531470b0af1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"eeace073ca1644b525211de695ac6fe573aec796247f2875b4dd9bbb078de9c3","event_uuid":"1d977312-470d-4ce8-89ae-25cfaa76e49d","position":{"commit_sha":"e9e518cf94e81356a0b6f7d9c30d2dfe85d273da","position":"1788534417832317001-1d977312-470d-4ce8-89ae-25cfaa76e49d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"99f1169b7b6fbc0a3d5cab68aa6920e4dc2ada080288620e2f2f2aa1c971d1b3","event_uuid":"7ef41614-932e-4921-a6ae-1d00014963c8","position":{"commit_sha":"f291fd37ec992da3487f1b3c4f3476d885ca0eb0","position":"1788534518953998001-7ef41614-932e-4921-a6ae-1d00014963c8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2fd32ce24fe11ffd5d44a077a193e21c5f23fb84bb3587543398f636f7d8a3e5","event_uuid":"0aed24dc-a36e-4ca7-9554-c34f6d1c1033","position":{"commit_sha":"0188b90786f3521adf4e3a290b690431215104c7","position":"1788534937471569001-0aed24dc-a36e-4ca7-9554-c34f6d1c1033"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e1a7ea9e0bd02a836d9461fb942609286a6ac1ea590e76795a74c3c9cadebc6a","event_uuid":"a593bb24-dbb5-4bf5-9108-f0697998ce56","position":{"commit_sha":"c68ac7e6c0e21e735374c7588fbc055c4a458488","position":"1788536154168170389-a593bb24-dbb5-4bf5-9108-f0697998ce56"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e3b48c3c8975b1928d36a778f58305af2779127abac5eae394dd3ea71f2e84a3","event_uuid":"6553534c-9fc0-4d15-b55b-4a504fb63e29","position":{"commit_sha":"ebe08b6f213b6957195f6a4a7467cff141753318","position":"1788536240869087001-6553534c-9fc0-4d15-b55b-4a504fb63e29"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e928e3412c8ab2f677c26cb0101a8504db3261c7f1273c3e79bc940695c3b464","event_uuid":"84a7b304-2661-4edd-b27a-09d96dd4d0e7","position":{"commit_sha":"17794474bbe848fb3629fab34c9298a52e4c6324","position":"1788538619894973001-84a7b304-2661-4edd-b27a-09d96dd4d0e7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review RCA (orchestrator, after 7 BLOCK rounds) — the plan premise was WRONG about a load-bearing dependency.\n\nThe plan said: remove Mode.RECONCILE_CHECK from the enum plus its _ORDERED and MODE_CAPS entries, while preserving the _ref_lock pause sentinel gated_mode==\"reconcile-check\" byte-for-byte. Those two are CONTRADICTORY.\n\nEvidence (src):\n- _advisory_lock._mode_blocks() (src/rebar/_engine/rebar_reconciler/_advisory_lock.py:257) reads the pause-gate blob and computes blocking via `gated_mode = mode_mod.Mode.from_str(gated_mode_str)` then `target_mode > gated_mode`. gated_mode_str is the literal \"reconcile-check\".\n- mode.py:_ORDERED (line 21) lists \"reconcile-check\" first; Mode ordering uses _ORDERED.index(value). from_str requires the enum member.\n- So a paused repo (gate blob gated_mode==\"reconcile-check\", written at _ref_lock.py:717) is read BACK through Mode.from_str(\"reconcile-check\"). Remove the enum/_ORDERED entry and from_str raises ValueError -> _mode_blocks logs \"unrecognised mode; treating as no gate\" -> returns False -> THE PAUSE STOPS BLOCKING. Live behavioral regression.\n\nDecision (correctness-driven scope refinement): RETAIN Mode.RECONCILE_CHECK (enum member + _ORDERED entry + MODE_CAPS entry + from_str support) as a load-bearing INTERNAL gate/pause mode. It is NOT unused, so retaining it is consistent with the \"remove deprecated/UNUSED surface\" goal. REMOVE only:\n- the legacy `rebar reconcile --mode reconcile-check` CLI command surface (_cli parser/registry/help),\n- the `--filter-local-ids` CLI surface,\n- `_run_reconcile_check` direct-engine dispatch branch + its .bridge_state/reconcile-check.json writer (__main__.py),\n- the orphaned `reconcile_check.py` discrepancy-report module (and its dedicated tests),\n- the `reconcile_diagnostics` status/model/schema field (last_pass.py reader, _mcp_models.py, bridge_status.schema.json, types.py),\n- repoint _bridge_runner MODE_COMMANDS[\"reconcile-check\"] to `rebar bridge preview`.\n\nConsequence: this SHRINKS test churn. All `Mode.RECONCILE_CHECK` references (test_mode.py, test_reconcile_once.py, test_recovery_write_boundary.py, test_advisory_lock.py, test_orchestrator_wiring.py, ...) STAY VALID because the enum is retained — plan-review finding 3 (migrate advisory_lock tests off the enum) is thereby moot. Only the reconcile_check-module tests (test_reconcile_check*.py) and the filter-CLI test (test_reconcile_filter.py) need deletion/migration.\n\nPlan + file_impact rewritten accordingly.","timestamp":1788533620895546001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Claimed; beginning held-out TDD in worktree janitor-82bb-439b.","timestamp":1788534417832317001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Confirmed existing claim by joeoakhart@navapbc.com; beginning held-out TDD in worktree janitor-82bb-439b after certified plan-review PASS.","timestamp":1788534518953998001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation progress in /Users/joeoakhart/janitor-82bb-439b: removed top-level reconcile route/help/parser, direct --mode reconcile-check path, --filter-local-ids parser surface, reconcile_check writer/module/tests, status reconcile_diagnostics field, repointed bridge-runner reconcile-check profile to bridge preview, and updated authorized docs/probe scripts/tests. Targeted authorized pytest passed (120 tests). Generated docs/types and probe bash syntax checks passed. Blocker: tests/unit/test_gen_cli_reference.py is outside this handoff's authorized scope but now fails 3 stale reconcile-route expectations and must be updated by parent/with expanded scope before full suite can pass.","timestamp":1788536154168170389}],"created_at":1788314420396749001,"creation_channel":"cli","deps":[{"link_uuid":"7a9e5f51-cbba-442e-a5fe-54ff691948d1","relation":"depends_on","target_id":"3b66-615c-fbfb-4b1f"},{"link_uuid":"9899cc80-1d8b-4aad-b93e-45453c22a1e8","relation":"depends_on","target_id":"c195-03cd-fc03-4ae0"}],"description":"## Goal\n\nRemove the legacy `rebar reconcile --mode reconcile-check` CLI/direct-engine command and its `.bridge_state/reconcile-check.json` status artifact without breaking the canonical bridge surfaces that replaced its observables.\n\nReplacement is distributed:\n- `rebar bridge preview` is the live Jira-vs-local differ/proposed-change observable.\n- `rebar bridge fsck --output json` is the offline orphan/unbound/binding-drift audit observable.\n- `rebar bridge status --json` remains the status surface, but no longer reads stale `reconcile-check.json`.\n\nPreserve `_ref_lock.py` pause sentinel `gated_mode == \"reconcile-check\"`: it is read back at runtime via `Mode.from_str` in `_advisory_lock._mode_blocks`, so `Mode.RECONCILE_CHECK` MUST stay in the enum/`_ORDERED` or a paused repo silently stops blocking. Remove only the CLI command, not the internal mode.\n\n## Scope\n\n- `_bridge_runner.py`: repoint retained `reconcile-check` profile to `rebar bridge preview`, not fsck.\n- `_cli/_registry.py`, `_cli/_parsers/advanced/reconcile.py`, `_cli/help/reconcile.txt`: remove top-level `rebar reconcile`, `--mode reconcile-check`, and `--filter-local-ids` CLI surface.\n- `_engine/rebar_reconciler/__main__.py`: delete `_run_reconcile_check`, its JSON writer, dispatch branch, and CLI-only `filter_local_ids` handoff.\n- `_engine/rebar_reconciler/request.py`: remove legacy-route parsing; keep canonical `preview`/`sync`.\n- `_engine/rebar_reconciler/mode.py`: RETAIN `Mode.RECONCILE_CHECK` + its `_ORDERED`/`MODE_CAPS` entries (load-bearing for the advisory-lock pause gate via `Mode.from_str(\"reconcile-check\")`); only revise the docstring wording that describes it as the removed CLI command.\n- `_engine/rebar_reconciler/_preflight.py`: remove reconcile-check no-write logic/wording.\n- `_engine/rebar_reconciler/last_pass.py`: remove `_read_reconcile_diagnostics()` and `snapshot()[\"reconcile_diagnostics\"]`.\n- `_mcp_models.py`, `schemas/bridge_status.schema.json`, `types.py`: remove `reconcile_diagnostics` from BridgeStatus model/schema/types so MCP no longer advertises a producerless field.\n- `_engine/rebar_reconciler/reconcile_check.py`: delete orphaned legacy report module.\n- Update stale reconcile-check wording in `binding_recovery.py`, `binding_walk.py`, `fetcher.py`, `get_rotation.py`, `load_phase.py`, `pass_support.py`, `reconcile_helpers.py`, and `ticket_planner.py`.\n- Update workflow/probe/docs/changelog references that instruct `reconcile-check`, using preview for live discrepancy checks and fsck for offline orphan/unbound audits.\n- Tests (enum retained, so all `Mode.RECONCILE_CHECK` references stay valid — only removed-symbol consumers change): DELETE the `reconcile_check.py`-module tests `tests/unit/rebar_reconciler/orchestrate/test_reconcile_check{,_canonical,_canonical_heldout,_bindings_dict}.py` (they exercise the removed `_run_reconcile_check`/`reconcile_check.reconcile_check()`); migrate `test_reconcile_filter.py` (drop `--filter-local-ids` `main()` parsing; keep engine plumbing). Grep the reconciler test tree for the removed symbols and fix any remaining consumer (leave enum/sentinel references intact). Add BridgeStatus model/schema-parity + preview-probe coverage. `make test` is an AC.\n\n## Design Decisions\n\n1. `bridge fsck` is not the sole replacement: it is offline and exits 1 on findings, whereas legacy reconcile-check exited 0.\n2. `_bridge_runner.MODE_COMMANDS[\"reconcile-check\"]` maps to `rebar bridge preview`, whose canonical route emits JSON on stdout and `BRIDGE_STATE: <state>` on stderr with 0/1/2 exit semantics.\n3. After `_run_reconcile_check` is deleted, no canonical writer refreshes `.bridge_state/reconcile-check.json`; remove all status/model/schema readers instead of creating a new writer.\n4. Remove `BridgeStatusOut.reconcile_diagnostics` in `_mcp_models.py`; schema drift will not catch an extra permissive model field, so add explicit MCP/schema parity coverage.\n5. Pressure probes must stop grepping legacy prose (`0 discrepancies`, `discrepancy`, `mismatch`). Run canonical `preview --only ... --repo-root ...`, preserve the exit code, parse the final stdout JSON, and pass only when `route==\"preview\"`, `mutation_count==0`, and `plan` contains no entry for the probe key/local id.\n6. Keep `_ref_lock.py` pause sentinel `reconcile-check` byte-for-byte, AND keep `Mode.RECONCILE_CHECK` in the enum/`_ORDERED`/`MODE_CAPS`: the sentinel is decoded back through `Mode.from_str` by `_advisory_lock._mode_blocks`, so removing the enum would make `from_str(\"reconcile-check\")` raise and the pause gate fail open.\n7. Do not remove dead internal `filter_local_ids` plumbing beyond CLI surface; follow-up `f8c4-ac9b-42c5-4bb0` owns that.\n\n## Acceptance Criteria\n\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/unit/rebar_reconciler/orchestrate/test_mode.py` proves `Mode.RECONCILE_CHECK` + its `_ORDERED`/`MODE_CAPS` entries are RETAINED and `Mode.from_str(\"reconcile-check\")` still round-trips (pause gate intact); ordering works.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/unit/rebar_reconciler/orchestrate/test_reconcile_main.py` proves `--mode reconcile-check` rejects and `_run_reconcile_check` is not dispatched.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/scripts/test_run_reconcile_bridge.py tests/scripts/test_run_reconcile_bridge_heldout.py tests/unit/workflow/test_bridge_provider_wrappers_heldout.py` proves the retained runner profile invokes `bridge preview`, not fsck, and preserves delivery semantics.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/scripts/bridge/test_bridge_fsck_binding_drift.py` proves orphaned bindings/Jira and unbound local/Jira remain in `bridge fsck --output json`.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/interfaces/facades/test_bridge_status_heldout.py tests/interfaces/facades/test_bridge_status_relocated_store.py tests/interfaces/facades/test_bridge_programmatic_heldout.py tests/interfaces/facades/test_mcp_model_schema_drift_heldout.py` proves BridgeStatus library/MCP/schema/types no longer expose `reconcile_diagnostics`.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/scripts/test_jira_pressure_probe_preview_assertions_heldout.py` proves both pressure probes migrated from legacy prose greps to preview JSON assertions on `route`, `mutation_count`, and absence of probe targets in `plan`.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/interfaces/facades/test_bridge_cli_heldout.py tests/unit/rebar_reconciler/state/test_advisory_lock.py tests/unit/rebar_reconciler/state/test_advisory_lock_ref_backend.py` proves pause documents still preserve `gated_mode == \"reconcile-check\"`.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/interfaces/contracts/test_reconcile_check_cli_removal_heldout.py` proves removed CLI spelling is rejected and remaining `reconcile-check` hits are only pause-sentinel or historical/changelog references.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" make lint` passes.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck` passes.\n- [ ] `env PATH=\"$PWD/.venv/bin:$PATH\" make test` passes.\n\n## Testing\n\nHeld-out oracles: `tests/interfaces/contracts/test_reconcile_check_cli_removal_heldout.py` (CLI-removal + residual-hit audit) and `tests/scripts/test_jira_pressure_probe_preview_assertions_heldout.py` (both probes migrated per Design Decision 5: scoped `preview --only ...` JSON parsing on `route`/`mutation_count`/`plan`, exit code preserved, no legacy prose greps). All proving commands are enumerated under Acceptance Criteria.\n\n## Out of scope\n\n- Do not edit `_lib_ops.py` or `_mcp_reads.py`; c195 already removed Python/MCP `rebar.reconcile(mode=...)`.\n- Do not remove engine `filter_local_ids` plumbing beyond CLI surface; `f8c4-ac9b-42c5-4bb0` owns it.\n- Do not change `_ref_lock.py` pause sentinel bytes/schema.\n- Do not change canonical preview/sync/fsck/status semantics except removing stale status diagnostics.\n- Do not run plan-review, claim, close, or force any ticket for this work.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_bridge_runner.py","reason":"Repoint retained reconcile-check runner profile to canonical rebar bridge preview; do not use bridge fsck because fsck findings exit 1 and break runner delivery semantics."},{"path":"src/rebar/_cli/_registry.py","reason":"Remove legacy top-level rebar reconcile route registration."},{"path":"src/rebar/_cli/_parsers/advanced/reconcile.py","reason":"Remove legacy reconcile parser exposure for --mode reconcile-check and --filter-local-ids CLI surface."},{"path":"src/rebar/_cli/help/reconcile.txt","reason":"Remove static/help output for deleted legacy reconcile CLI flags."},{"path":"src/rebar/_engine/rebar_reconciler/__main__.py","reason":"Delete _run_reconcile_check, its reconcile-check.json writer, the Mode.RECONCILE_CHECK dispatch branch, and CLI-only filter_local_ids handoff."},{"path":"src/rebar/_engine/rebar_reconciler/request.py","reason":"Remove legacy-route --mode reconcile-check parsing and --filter-local-ids CLI parsing while preserving canonical preview/sync normalization."},{"path":"src/rebar/_engine/rebar_reconciler/mode.py","reason":"RETAIN Mode.RECONCILE_CHECK plus its _ORDERED and MODE_CAPS entries (load-bearing: _advisory_lock._mode_blocks decodes the pause sentinel via Mode.from_str('reconcile-check')); only revise the docstring wording that describes it as the removed CLI command."},{"path":"src/rebar/_engine/rebar_reconciler/_preflight.py","reason":"Remove reconcile-check from no-write/preflight logic and documentation after mode removal."},{"path":"src/rebar/_engine/rebar_reconciler/last_pass.py","reason":"Remove stale .bridge_state/reconcile-check.json reader and reconcile_diagnostics surfacing because no canonical writer remains."},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_check.py","reason":"Delete orphaned legacy discrepancy-report module once _run_reconcile_check dispatch is removed; delete its dedicated tests too."},{"path":"src/rebar/_engine/rebar_reconciler/binding_recovery.py","reason":"Remove stale reconcile-check no-write wording; leave behavior unchanged."},{"path":"src/rebar/_engine/rebar_reconciler/binding_walk.py","reason":"Remove stale reconcile-check no-write wording; leave behavior unchanged."},{"path":"src/rebar/_engine/rebar_reconciler/fetcher.py","reason":"Remove stale reconcile-check no-write wording; leave behavior unchanged."},{"path":"src/rebar/_engine/rebar_reconciler/get_rotation.py","reason":"Remove stale reconcile-check read-only wording; leave behavior unchanged."},{"path":"src/rebar/_engine/rebar_reconciler/load_phase.py","reason":"Remove stale reconcile-check cap-0 wording; leave dry-run persistence gating intact."},{"path":"src/rebar/_engine/rebar_reconciler/pass_support.py","reason":"Remove stale reconcile-check cap-0 wording; do not remove filter_local_ids engine plumbing."},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"Remove stale reconcile-check compatibility wording; leave behavior unchanged."},{"path":"src/rebar/_engine/rebar_reconciler/ticket_planner.py","reason":"Remove stale reconcile-check no-write wording after MODE_CAPS no longer contains it."},{"path":"src/rebar/schemas/bridge_status.schema.json","reason":"Remove optional reconcile_diagnostics field that was sourced only from the retired reconcile-check.json artifact."},{"path":"src/rebar/types.py","reason":"Remove BridgeStatus reconcile_diagnostics typing tied to retired legacy artifact."},{"path":"src/rebar/_mcp_models.py","reason":"Remove BridgeStatusOut.reconcile_diagnostics so MCP no longer advertises a field with no producer; explicit parity tests must cover this because drift checking permits extra model fields."},{"path":".github/workflows/reconcile-bridge.yml","reason":"Replace manual reconcile-check workflow profile guidance with canonical bridge preview/fsck/status operations while preserving other bridge profiles."},{"path":"Jenkinsfile","reason":"Remove reconcile-check from bridge operation choices or map it to canonical preview consistently with _bridge_runner."},{"path":"scripts/jira-pressure-test/e2e_field_validation_probe.sh","reason":"Replace direct-engine --mode reconcile-check Phase 7 with scoped bridge preview JSON assertions over the probe keys/local ids; stop grepping legacy discrepancy/mismatch prose."},{"path":"scripts/jira-pressure-test/e2e_validation_probe.sh","reason":"Replace direct-engine --mode reconcile-check Phase 5 with scoped bridge preview JSON assertions for zero proposed plan entries for the probe ticket/key; stop grepping legacy 0 discrepancies prose."},{"path":"docs","reason":"Update operator docs to describe preview/fsck/status distributed replacement and remove instructions to invoke reconcile-check."},{"path":"CHANGELOG.md","reason":"Record pre-1.0 removal and canonical migration path."},{"path":"tests/unit/rebar_reconciler","reason":"Remove/update tests for Mode.RECONCILE_CHECK, _run_reconcile_check, and reconcile_check.py; keep dry-run/preview coverage."},{"path":"tests/scripts","reason":"Update bridge-runner profile tests so reconcile-check maps to bridge preview and not bridge fsck."},{"path":"tests/interfaces","reason":"Add held-out CLI-removal, BridgeStatus model/schema absence, and pause-sentinel regression coverage."},{"path":"tests/scripts/test_jira_pressure_probe_preview_assertions_heldout.py","reason":"New held-out oracle proving both pressure probes assert on bridge preview JSON/exit semantics instead of legacy reconcile-check report text."},{"path":"tests/interfaces/facades/test_bridge_programmatic_heldout.py","reason":"Update MCP/library BridgeStatus contract expectations so reconcile_diagnostics is absent from output schema/model."},{"path":"tests/interfaces/facades/test_mcp_model_schema_drift_heldout.py","reason":"Add explicit guard for BridgeStatusOut not declaring producerless reconcile_diagnostics, since the drift gate does not catch extra permissive model fields."},{"path":"tests/interfaces/facades/test_bridge_status_relocated_store.py","reason":"Replace legacy assertion that bridge_status surfaces reconcile_check summary from configured store with assertion that stale reconcile-check.json is ignored."},{"path":"src/rebar/_cli/help/overview.txt","reason":"Remove the top-level `rebar reconcile` help entry so AC1 (legacy reconcile absent from CLI registration/docs/help) holds."},{"path":"tests/unit/test_gen_cli_reference.py","reason":"Remove stale `rebar reconcile` subcommand-help/usage-rendering expectations after the CLI command is removed; the route-removed omission test already exists."},{"path":"tests/unit/workflow","reason":"Update held-out bridge-primary workflow test that still asserts legacy `rebar reconcile` presence in help/docs; assert canonical bridge preview instead after CLI removal (AC1)."},{"path":"tests/unit/test_child_oracle_fail_open.py","reason":"Meta-oracle loads tests/interfaces/facades/test_cli.py and invokes its reconcile fail-open routing test; keep it consistent with the retained/renamed fail-open coverage after the reconcile CLI is removed."},{"path":".agents/rules/rebar.md","reason":"Update stale integration description that names the removed `rebar reconcile` CLI so legacy reconcile is absent from docs (AC1); point to the canonical bridge command."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","3b66-615c-fbfb-4b1f"],["depends_on","c195-03cd-fc03-4ae0"],["parent","0cfc-e511-8f8a-4c8b"]],"no_file_impact_reason":"","parent_id":"0cfc-e511-8f8a-4c8b","parent_status_uuid":"70e43a60-14e9-4892-9ca5-fe4efad96817","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["janitor","reconciler","cli","breaking-change"],"ticket_id":"82bb-439b-1c42-4abd","ticket_type":"story","title":"Remove legacy reconcile CLI, direct-engine modes, and persisted state","verify_commands":[]},"source_event_uuids":["5628f800-282b-401d-885b-e0a1b8065a1e","bb1dcced-a537-48c5-81fd-16338406e380","ff1ab7bb-2c24-4a18-98c9-4a0b3de86954","3567e1c8-6bc8-46fa-a4f5-d6d88eb3ce82","852291e0-45f4-4312-a21a-9276a4744295","0aee387b-0152-4835-aba1-c0eeb7329058","fc43e39b-2780-4447-b389-ce1bf7c727f6","9899cc80-1d8b-4aad-b93e-45453c22a1e8","255d5548-1d1b-4f2e-9962-8a9d5246d766","ab9fac58-ea59-4432-966c-6bb7724dd907","e8257272-8078-4f64-bba5-6388fb065557","6b097a2b-938b-41f7-86ad-163196bd26eb","cc2c29d1-c8fd-4aa4-9d61-f78f262e3503","24065628-840f-480a-9738-56fe832c7f8e","e53c87a5-7392-459e-960b-564c1284f54c","94872be5-b81b-47d1-a9b1-6624ae255739","bba30933-b01a-4fd4-9051-f4801fa84224","1e40aa68-8a3d-4af4-a892-78a463a8acf4","70e43a60-14e9-4892-9ca5-fe4efad96817","1aae0bff-5f62-43c0-86e0-6531470b0af1","1d977312-470d-4ce8-89ae-25cfaa76e49d","7ef41614-932e-4921-a6ae-1d00014963c8","0aed24dc-a36e-4ca7-9554-c34f6d1c1033","a593bb24-dbb5-4bf5-9108-f0697998ce56","6553534c-9fc0-4d15-b55b-4a504fb63e29","84a7b304-2661-4edd-b27a-09d96dd4d0e7"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788538619894973002,"uuid":"9094414e-f435-417f-a115-5010ae499a8d"}