19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788314420396749001,"creation_channel":"cli","deps":[{"link_uuid":"7a9e5f51-cbba-442e-a5fe-54ff691948d1","relation":"depends_on","target_id":"3b66-615c-fbfb-4b1f"}],"description":"## Context / Problem\n\nLegacy CLI and direct-engine `reconcile` modes still retain defaults, `--filter-local-ids`, exit values, manifest/tally output, and `reconcile-check` persisted state. The canonical bridge diagnostic migration is delivered by nosy-drooly-milksnake [rebar:nosy-drooly-milksnake].\n\n## Approach\n\nAfter that prerequisite is complete, remove all legacy CLI registrations and direct-engine mode values, including `Mode.RECONCILE_CHECK`. Migrate historical `\"reconcile-check\"` state or retain a narrow read decoder until it is safe to retire. Preserve live lock-loss `ReconcileLockLost -> RESCHEDULE`, canonical bridge exit 0, `snapshot_head` drift checks, and store `RebaseGuard` exit 75.\n\n## Scope\n\n- CLI registry/dispatch and direct-engine mode routing\n- persisted ref-lock/report readers and migration/decoder\n- release/docs and reconciliation tests\n\n## Testing\n\nUse pre-migration persisted state, live lock-loss, drift, exit, and canonical bridge behavior controls.\n\n## Acceptance Criteria\n\n- [ ] `reconcile` and `reconcile-check` are absent from CLI registration, direct-engine modes, docs, and help.\n- [ ] Existing persisted reconcile-check state is migrated or decoded safely without reintroducing legacy command vocabulary.\n- [ ] Live lock-loss rescheduling, snapshot drift, canonical bridge exit 0, and store RebaseGuard exit 75 remain unchanged.\n- [ ] Canonical bridge operations cover the migrated diagnostics and focused migration/exit tests pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_cli/_registry.py","reason":"remove reconcile and reconcile-check CLI registrations"},{"path":"src/rebar/_cli/__init__.py","reason":"remove legacy command dispatch"},{"path":"src/rebar/_engine/rebar_reconciler/mode.py","reason":"remove legacy reconcile modes"},{"path":"src/rebar/_engine/rebar_reconciler/__main__.py","reason":"remove direct-engine legacy mode routing"},{"path":"src/rebar/_engine/rebar_reconciler/_ref_lock.py","reason":"migrate or retain decoder for historical reconcile-check state"},{"path":"docs","reason":"remove legacy command/mode documentation and record bridge migration"},{"path":"CHANGELOG.md","reason":"record breaking command/state removal"},{"path":"tests/unit/rebar_reconciler","reason":"prove canonical bridge behavior and state migration"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","3b66-615c-fbfb-4b1f"],["parent","0cfc-e511-8f8a-4c8b"]],"no_file_impact_reason":"","parent_id":"0cfc-e511-8f8a-4c8b","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["janitor","reconciler","cli","breaking-change"],"ticket_id":"82bb-439b-1c42-4abd","ticket_type":"story","title":"Remove legacy reconcile CLI, direct-engine modes, and persisted state","verify_commands":[]},"source_event_uuids":["76654d81-3e90-4d49-9b07-70eaaa74dcfe","827c5ea2-581c-4159-b9f2-e10fd883bb47","7a9e5f51-cbba-442e-a5fe-54ff691948d1"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328065792366001,"uuid":"6a649f04-d191-4af5-b7ca-68c81d147c76"}