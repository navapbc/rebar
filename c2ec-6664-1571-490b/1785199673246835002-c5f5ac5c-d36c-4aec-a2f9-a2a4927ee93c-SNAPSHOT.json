L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"93f8c6cef725bcd880aa6cc4bb01c891389e1364673bcca5ede72a1a93f38965","event_uuid":"f734eb23-0f70-4919-94ab-d48bd9347a9b","position":{"commit_sha":"1c2d3a21ad0570406f8c8f180e77ede2fe198ab9","position":"1785199670480966001-f734eb23-0f70-4919-94ab-d48bd9347a9b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"934a72bd698aaa12233fed6ecf083cde98e2a7dc9a1e5c3c2b4614983724e6ac","event_uuid":"e1cadd10-eeef-4521-8687-4018ce5d8a33","position":{"commit_sha":"e31c738d5f6939a16ae2481f54e5d9fbcb1fbf41","position":"1785199673246835001-e1cadd10-eeef-4521-8687-4018ce5d8a33"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"User corrected the plan: do not add a prose-presence regression assertion because it would be a change-detector test. Removed the test file from scope and will rely on existing guide rendering/packaging checks plus direct review of `rebar explain plan`.","timestamp":1785199262850214001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review PASS signed after one provider-retry cycle. Claimed from fresh worktree `docs-epic-plan-guidance`; implementation scope is the packaged author guide only, with no change-detector test.","timestamp":1785199673246835001}],"created_at":1785199161369161001,"creation_channel":"cli","deps":[{"link_uuid":"c838005b-2fd8-4630-a933-9adf0a197dda","relation":"relates_to","target_id":"0520-5709-e259-490e"}],"description":"## Context / Problem\nClients authoring epic plans can repeat volatile graph metadata by stating the current number of children, and can add a redundant acceptance criterion requiring every child to close. The packaged plan-review author guide at `src/rebar/_guides/writing-a-passing-plan.md` should steer them toward durable epic outcomes and decomposition instead; child closure is already enforced deterministically before parent completion as documented in `docs/llm-framework.md`.\n\n## Approach\nAdd concise container-specific guidance to the canonical packaged guide: do not state the child count in an epic description, and do not add a separate acceptance criterion for all children being closed/completed. Rejected: changing plan-review or completion-verifier behavior, because the request concerns author guidance and the existing deterministic closure guard already supplies the invariant.\n\n## Scope\n- `src/rebar/_guides/writing-a-passing-plan.md`: clarify durable epic description and acceptance-criteria guidance.\n\n## Acceptance Criteria\n- [ ] `rebar explain plan` tells clients not to include the number of children in an epic description; verified by rendering the packaged guide and reviewing the container guidance.\n- [ ] `rebar explain plan` tells clients an epic needs no separate acceptance criterion stating that all children are closed/completed; verified by rendering the packaged guide and reviewing the container guidance.\n- [ ] Existing guide packaging/rendering checks pass from the worktree virtualenv.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_guides/writing-a-passing-plan.md","reason":"clarify epic authoring guidance"}],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","0520-5709-e259-490e"]],"parent_id":null,"parent_status_uuid":"6103c515-82da-409e-aaef-e1fe2af418a3","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["docs","plan-review"],"ticket_id":"c2ec-6664-1571-490b","ticket_type":"task","title":"Clarify epic child guidance in plan review author guide","verify_commands":[]},"source_event_uuids":["df7c834a-00fe-4251-92b6-88dd7a41ec36","53e9e327-e455-4ef8-8043-f47950740b07","af0e5bd7-c7b3-4f0d-883d-fb2d96034746","e06abfe4-741b-4f30-9827-b7be89c17df7","82a442a0-471d-460e-bc99-794bc05b6808","c838005b-2fd8-4630-a933-9adf0a197dda","5c2ac700-23e9-4143-b831-10e4da1387b0","6103c515-82da-409e-aaef-e1fe2af418a3","f734eb23-0f70-4919-94ab-d48bd9347a9b","e1cadd10-eeef-4521-8687-4018ce5d8a33"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785199673246835002,"uuid":"c5f5ac5c-d36c-4aec-a2f9-a2a4927ee93c"}