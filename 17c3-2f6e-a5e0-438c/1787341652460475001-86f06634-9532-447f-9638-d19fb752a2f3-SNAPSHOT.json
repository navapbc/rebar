phase: planning","rebar-version: 0.12.0 (1ab859777a-dirty)","regver: 362a5dd2d2052826","verified-at-sha:1ab859777a95b6d5573bb96aff863a73e97d6098","dep 93a0585bf6268c1cdd7f1b9075a1973f5428e784fe094add4b3fcb168ef5013c src/rebar/_engine/rebar_reconciler/outbound_comments.py","dep 16edd0ccda10e3080f693cdf1013e2cd38f209fc006485469f392a497347511a tests/unit/rebar_reconciler/diffing/test_comment_dedup_key_matches_send_fit.py","read-set: 5","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira/rich_text_codec.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_family/rich_text.py","read-path: src/rebar/_engine/rebar_reconciler/outbound_comments.py","currency-basis: file_impact"],"material_fingerprint":"2f464fca0245658c","merged_log_commit":"1ab859777a95b6d5573bb96aff863a73e97d6098","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787335229408621000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"99b06270280d5dbe2d4d599de7285be0c9829914ff402a05abe08b1c74ed5dc3","event_uuid":"9dd2acc8-3315-4b53-b289-c3fe8b0cd9d0","position":{"commit_sha":"d6109d76990b9df692ad916f8ef3ea27b0e1812f","position":"1787333745672632001-9dd2acc8-3315-4b53-b289-c3fe8b0cd9d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a12ca34330d4b40b07acc8fea614a761b361f715578b71a512ef2d2edd738e61","event_uuid":"a9d2f3c5-a8bb-4af9-94ce-66e2a4c03b81","position":{"commit_sha":"29ea7e10eb04b220384fe9a7cd9e3e2b6f967e70","position":"1787334194323182001-a9d2f3c5-a8bb-4af9-94ce-66e2a4c03b81"},"signature":"{\"payload\": \"\", \"payloa