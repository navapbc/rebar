cf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9c27a28499dc7059bda137a553afe177d1298238a8445eb14029db1aeeb12d6a","event_uuid":"ed163048-8fce-42dc-a840-0e70b5bc3595","position":{"commit_sha":"ac4028974dfa84180dd6661e28bbae792e700c01","position":"1789891436262679505-ed163048-8fce-42dc-a840-0e70b5bc3595"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"70a52a687e63556a5ff63a50e2510029034536e75c2f4f14aebbc6033b5777d8","event_uuid":"fed8011a-029c-4d2f-b365-62d1a380f988","position":{"commit_sha":"af9171cee67dcf1059ff778c73cc45e2be1cc35f","position":"1789891512137411010-fed8011a-029c-4d2f-b365-62d1a380f988"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8ae2dd4297e2e4777f81f0bf9ad7727eaa7bd8c9ae636699d0e0c4fcc0764b51","event_uuid":"c0394742-f463-46a6-adce-dfeefbae8ea4","position":{"commit_sha":"4944915b38b337a6c080915c464f061afdcf8c4e","position":"1789891519892399452-c0394742-f463-46a6-adce-dfeefbae8ea4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"plan_defect","comments":[],"completion_expectation":"required","created_at":1789780332185796454,"creation_channel":"mcp","deps":[{"link_uuid":"b26e6f9b-2492-42fe-9d11-3986659d601c","relation":"discovered_from","target_id":"8d27-d715-0611-48e3"},{"link_uuid":"6d04d0d3-fccf-46fe-8e0f-71338d34a817","relation":"relates_to","target_id":"11c8-79dd-5196-4d6e"}],"description":"## Symptom\n\n`_metered_spend()` in `infra/terraform/bedrock-spend-cap/handler.py` accumulated token spend across regions, but a single CloudWatch `ClientError` discarded totals already collected from healthy regions and returned `None`.\n\n## Design\n\nReturn a frozen `MeteredSpend(total, degraded, failures)` where each `MeteredFailure` records the failed region and exception class. If at least 1 token series contributes, return a degraded `MeteredSpend` carrying the partial total; if a `ClientError` prevents a complete scan before any series contributes, keep the unavailable path and return `None`.\n\nSequenced after `604c-ade8`, which removed the unconditional `metered is None` CE-poll trigger so a metered outage cannot override `CE_MIN_INTERVAL_SECONDS`. This change must not reintroduce that trigger, nor add a `metered.degraded` equivalent. `MeteredSpend.total` is a lower bound, so the near-threshold test can be false while full regional spend would be true; that is handled by carrying `degraded=True` into release safety and operator visibility rather than by polling more often.\n\n## Acceptance Criteria\n\n- [x] `infra/terraform/bedrock-spend-cap/handler.py` defines `MeteredSpend`.\n- [x] `MeteredSpend.total` stores the numeric CloudWatch dollar total.\n- [x] `MeteredSpend.degraded` is `True` when at least 1 region raises `ClientError` during the scan.\n- [x] `MeteredSpend.failures` stores each failed region name.\n- [x] `MeteredSpend.failures` stores each failed exception class.\n- [x] `_metered_spend()` returns a degraded `MeteredSpend` after one region contributes token spend then a later region raises during `list_metrics`.\n- [x] `_metered_spend()` returns a degraded `MeteredSpend` after one region contributes token spend then a later region raises during `get_metric_data`.\n- [x] `_metered_spend()` continues scanning later regions after an earlier region raises `ClientError`.\n- [x] When a CloudWatch `ClientError` prevents a complete scan before any token series contributes, `_metered_spend()` returns `None`.\n- [x] Degraded-region logging includes the failed region name.\n- [x] Degraded-region logging includes the exception class name.\n- [x] The CE-poll gate uses `MeteredSpend.total` for near-threshold arithmetic.\n- [x] A degraded partial below the near-threshold amount does not poll CE before the due interval.\n- [x] A degraded partial at the near-threshold amount polls CE before the due interval.\n- [x] The CE-poll gate contains no unconditional `metered.degraded` trigger.\n- [x] The CE-poll gate contains no unconditional `metered is None` trigger reintroduced by cfe0.\n- [x] `signal_unavailable` is `True` when `MeteredSpend.degraded` is `True`.\n- [x] A degraded partial with `total >= THRESHOLD_USD` attaches the deny policy when it is not attached.\n- [x] A degraded partial with `total < THRESHOLD_USD` leaves an existing deny policy attached.\n- [x] A degraded partial with `total < THRESHOLD_USD` publishes no release notification.\n- [x] Metered log text reports the numeric partial total when `MeteredSpend.degraded` is `True`.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py` extends `FakeAWS.client()` so CloudWatch fakes can vary by `region_name`.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_metered_spend_preserves_partial_total_when_later_region_listing_fails` covers the listing-failure partial.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_metered_spend_preserves_partial_total_when_later_region_data_fails` covers the data-failure partial.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_metered_spend_records_degraded_region_failure` covers region name logging.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_metered_spend_records_degraded_region_failure` covers exception class logging.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_degraded_partial_meter_below_near_threshold_respects_ce_interval` covers the non-due no-poll case.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_degraded_partial_meter_at_near_threshold_polls_ce` covers the near-threshold poll case.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_degraded_partial_meter_can_attach` covers fail-closed attachment.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_degraded_partial_meter_cannot_release` covers release blocking.\n- [x] `tests/infra/test_bedrock_spend_cap_handler.py::test_metered_spend_cloudwatch_failure_before_any_series_reports_unavailable` covers the `None` fallback.\n- [x] `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/infra/test_bedrock_spend_cap_handler.py` exits 0.\n- [x] `env PATH=\"$PWD/.venv/bin:$PATH\" make verify` exits 0.\n\n## Verification evidence\n\nVerified against merged commit `1f338f2c57e` (Gerrit change 2997, tip of `origin/main`) in a throwaway detached worktree.\n\n- `MeteredSpend` at `handler.py:288` with `total` (289), `failures` (291); `MeteredFailure.exception_class` at 284.\n- Degraded construction at `handler.py:371`; the `None` pre-contribution path at `367-368`.\n- Both failure paths log then `continue` (`344-346` listing, `357-359` data), so later regions are still scanned; degraded logging carries region and exception class at `301-303`.\n- CE-poll gate is `if due or near_threshold:` at `handler.py:535`, `near_threshold` derived from `metered.total` at `533-534`. No bare `metered.degraded` and no bare `metered is None` disjunct, so 604c's removal stands.\n- `signal_unavailable` includes `metered.degraded` at `565-568`; attach at `621-623`; release requires `not signal_unavailable` at `608`; numeric partial logged at `570` and `578`.\n- `FakeAWS.client()` varies CloudWatch by `region_name` at `tests/infra/test_bedrock_spend_cap_handler.py:169-186`; all 9 named tests exist and assert the claimed behaviour, at lines 432, 472, 515, 697, 719, 773, 790 and 1389.\n- `pytest tests/infra/test_bedrock_spend_cap_handler.py` -> `61 passed in 16.26s`.\n- `make verify` passed in CI: change 2997 carried `Verified +1`, which runs the gating `ubuntu-latest, py3.13` cell `make verify` mirrors.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/terraform/bedrock-spend-cap/handler.py","reason":"Preserve partial regional CloudWatch token totals, expose degraded metering state, and prevent degraded under-threshold totals from releasing the deny policy."},{"path":"tests/infra/test_bedrock_spend_cap_handler.py","reason":"Add region-specific FakeAWS/FakeCloudWatch unit coverage for partial regional failures, all-region failures, and attach-versus-release behavior under degraded metering."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","11c8-79dd-5196-4d6e"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"fed8011a-029c-4d2f-b365-62d1a380f988","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"cfe0-4b2b-e02d-4df7","ticket_type":"bug","title":"Bedrock spend cap: one region's ClientError discards token totals already collected from healthy regions","verify_commands":[]},"source_event_uuids":["a540f441-c3ad-4fd8-b28d-56b38eaae612","4d215310-1d72-4216-adfa-ff7a16bb043f","c73bb573-45e7-4863-9bb9-5ad807cec7e8","2e7b8c1e-3361-44b8-9f8f-7396b44eac57","4f3727e6-fe64-403d-8fd0-5543f458e4e5","dd849534-627f-4092-84e3-f4f57a9c72fc","73e4eabb-12bd-4bb5-8f9b-37d19f280542","908fad8b-b575-4752-a94f-7fd9b4d0a5bc","6d04d0d3-fccf-46fe-8e0f-71338d34a817","66d4f8f9-ce95-43b6-bc0f-810efc63139f","791185d3-a335-4d68-aa4a-7b1adca1fddd","ed163048-8fce-42dc-a840-0e70b5bc3595","fed8011a-029c-4d2f-b365-62d1a380f988","c0394742-f463-46a6-adce-dfeefbae8ea4"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1789894133029672001,"uuid":"41066a2b-ff5c-45a6-b533-8d413128b1bd"}