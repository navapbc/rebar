"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a7266ec65ea3c13f746d2e1997b13bbf3185c0b076eacbde21ecada0d5c0c0da","event_uuid":"80c95906-666a-4bfd-b6f1-87a848271b05","position":{"commit_sha":"d9de0977f392b3ba0371c0cea6b2df7e58dce981","position":"1787417818801025001-80c95906-666a-4bfd-b6f1-87a848271b05"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d1c2ee1008cac924f93f8a7720136a5be90c35774c3640730c192e1002261e20","event_uuid":"39e620b1-e4ce-493e-ab6f-d34c87c60413","position":{"commit_sha":"c1d8ddc5889a1478e4ee69b65841cd496f243223","position":"1787418717062589001-39e620b1-e4ce-493e-ab6f-d34c87c60413"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787417057878548001,"creation_channel":"cli","deps":[{"link_uuid":"8a6055a9-248c-4f78-b96a-0031521b700e","relation":"relates_to","target_id":"a0c3-b5f9-bdcd-4427"}],"description":"## Context\nThe documentation survey on `minimum-rainy-fawn` and session log `homemade-coltish-donkey` identified seven approved repository recommendations. The operator approved F08A, F08B, F09, F10, F12, F13, and all three F19 units. The operator then added F20 to correct the GitHub About description. Rejected F02, F03, and F04 remain excluded. Deferred F05 remains undecided.\n\n## Plan\n- Correct bounded README workflow and installation facts.\n- Align operation-certificate and import guidance with current implementations and accepted ADRs.\n- Complete ADR 0100 command discovery through the existing route registry.\n- Repair MCP summary generation and transition registrar wording.\n- Correct the generated configuration contract through three bounded F19 children.\n- Update GitHub About metadata to lead with enforceable plan review and signed completion verification.\n- Change generated artifacts only through their canonical sources.\n- Land each repository child as an independently reviewable Gerrit change.\n\n## Acceptance Criteria\n- [ ] F08A documents current claim, relation, unlink, help, and close behavior.\n- [ ] F08B documents current installation dependencies and Git requirements.\n- [ ] F09 distinguishes asymmetric operation certificates from generic and legacy HMAC records.\n- [ ] F10 documents import batching, partial results, rerun behavior, and recovery limits.\n- [ ] F12 makes every visible top-level route discoverable through supported help forms.\n- [ ] F13 emits complete MCP summaries and correct transition semantics.\n- [ ] F19A removes the nonexistent MCP configuration-surface claim.\n- [ ] F19B generates a public description for every emitted typed configuration key.\n- [ ] F19C corrects current configuration history and diagnostic-switch guidance.\n- [ ] F20 updates the GitHub About description without changing repository files, topics, or homepage.\n- [ ] Every repository child passes its applicable local checks and both Gerrit gates before merge.\n- [ ] The GitHub metadata child passes plan review and exact readback verification before close.\n- [ ] The full batch lands on `main` and all descendants close without force.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"README.md","reason":"F08A, F08B, and F09 correct client guidance."},{"path":"docs/manifest-signing.md","reason":"F09 separates signing mechanisms."},{"path":"docs/event-schema.md","reason":"F09 corrects signature event guidance."},{"path":"docs/reuse-surface.md","reason":"F09 corrects reusable signing guidance."},{"path":"docs/repo-snapshot-gates.md","reason":"F09 corrects gate trust guidance."},{"path":"docs/plan-review-gate.md","reason":"F09 corrects gate certificate guidance."},{"path":"docs/sample-ticket-log.jsonl","reason":"F09 aligns the maintained example."},{"path":"src/rebar/_cli/_parsers/core/io.py","reason":"F10 corrects canonical import help."},{"path":"src/rebar/_cli/help/import.txt","reason":"F10 regenerates import help."},{"path":"scripts/gen_cli_help.py","reason":"F12 completes overview generation."},{"path":"src/rebar/_cli/_help.py","reason":"F12 completes help routing."},{"path":"src/rebar/_cli/_help_route.py","reason":"F12 aligns route help ownership."},{"path":"src/rebar/_cli/help/overview.txt","reason":"F12 regenerates overview help."},{"path":"docs/cli-reference.md","reason":"F10 and F12 regenerate CLI reference guidance."},{"path":"docs/import-export.md","reason":"F10 corrects import guidance."},{"path":"scripts/gen_mcp_reference.py","reason":"F13 corrects MCP summary generation."},{"path":"src/rebar/_mcp_writes.py","reason":"F13 corrects transition documentation."},{"path":"docs/mcp-reference.md","reason":"F13 regenerates the MCP reference."},{"path":"src/rebar/_config_schema.py","reason":"F19B adds public setting descriptions."},{"path":"scripts/gen_config_reference.py","reason":"F19A and F19B correct configuration generation."},{"path":"docs/config-reference.md","reason":"F19 children regenerate configuration guidance."},{"path":"docs/config.md","reason":"F19C corrects current configuration guidance."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["relates_to","a0c3-b5f9-bdcd-4427"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","accuracy"],"ticket_id":"f7e4-4d33-f231-4774","ticket_type":"epic","title":"Implement approved documentation accuracy batch F08 through F19","verify_commands":[{"command":"python scripts/check_docs_index.py --check","dd_id":"D1","dd_text":"Documentation index and links remain valid"},{"command":"python scripts/check_readme_quickstart.py","dd_id":"D2","dd_text":"README quickstart remains valid"},{"command":"python scripts/gen_cli_help.py --check && python scripts/gen_cli_reference.py --check","dd_id":"D3","dd_text":"Generated CLI help and reference are current"},{"command":"python scripts/gen_mcp_reference.py --check && python scripts/gen_config_reference.py --check","dd_id":"D4","dd_text":"Generated MCP and configuration references are current"}]},"source_event_uuids":["12d86f82-b36b-4f8b-95d5-a58b0120895b","8a6055a9-248c-4f78-b96a-0031521b700e","f4499df5-3a20-4c4a-94ee-b6daf47ae552","80c95906-666a-4bfd-b6f1-87a848271b05","39e620b1-e4ce-493e-ab6f-d34c87c60413"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787418717062589002,"uuid":"f2939607-62c6-411e-94f6-b0f3b8ef0f4e"}