adType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"829f13bb6cc4c16c6923bb8fe57dd15dcb55103fdb15e9135ba453c84442b7ff","event_uuid":"e37ba68a-8fb2-4f96-a56f-d402124b9835","position":{"commit_sha":"e7e28efead776066e9eaad2c1bf8d7442aa648f8","position":"1785903218901051001-e37ba68a-8fb2-4f96-a56f-d402124b9835"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e2baf069b002bd4e8d5ea826d87405f853ac0b94a6bd8c669f3c55922bd7538f","event_uuid":"cf0018d3-a55e-4162-957b-52752403cc3e","position":{"commit_sha":"bb63655c08eb0733326334045ac29a392a298b5a","position":"1785903244697870001-cf0018d3-a55e-4162-957b-52752403cc3e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-222_agent","claim_remote_session":null,"claimed_session":"4cf58ecd-8513-4de1-a7b6-62b672e02919","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## OPERATOR DECISION 2026-08-05: DECLARE and ENFORCE Git 2.38+\n\nThe operator ruled: document and enforce a Git 2.38+ floor, rather than add a runtime\ncapability guard that skips the test on older clients.\n\nRationale, and it is worth recording because it generalizes: a skip guard means the two-clone\nenrichment regression (added for bug 8185) silently does not run for some contributors. That\nis precisely how a guard goes VACUOUS -- the same rot class as 34c2 (the DC pagination guard\nthat scanned only transport.py and was emptied by a module split) and its sibling\n8a5e-b88e-0c3e-4544 (four more single-file AST guards found vacuous). A test that quietly\ndoes not run is worse than no test, because it reads as coverage.\n\nScope: determine and document the supported Git floor for contributors and CI, enforce it\nwith a clear failure message naming the required version, and verify the 8185 regression\nremains collected and executed on every gating CI environment.","timestamp":1785897201071562001}],"created_at":1785200016036103001,"creation_channel":"cli","deps":[{"link_uuid":"faa56f43-8d69-4010-b2db-11782426e1d2","relation":"discovered_from","target_id":"8185-2d4b-d2bf-4282"},{"link_uuid":"cf0018d3-a55e-4162-957b-52752403cc3e","relation":"relates_to","target_id":"77e2-fa14-9ea7-4670"}],"description":"## Context\n\nThe two-clone enrichment regression added for bug 8185 uses `git merge-tree --write-tree`, available in Git 2.38 and newer. The repository does not currently declare that Git floor or skip the test clearly on older clients.\n\n## Plan\n\n- Determine the supported Git version floor for contributors and CI.\n- Either document/enforce Git 2.38+ or add an explicit capability/version guard that skips with a clear reason on supported older clients.\n- Verify the regression remains collected and executed on every gating CI environment.\n\n## Acceptance Criteria\n\n- [ ] The supported Git version floor is explicit and consistent across contributor docs and CI.\n- [ ] The merge-tree regression fails or skips with a clear diagnostic when the capability is unavailable.\n- [ ] Gating CI still executes the real two-clone merge-tree assertion.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","77e2-fa14-9ea7-4670"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"3b00bab8-da4a-4fb0-8e1f-d2921e0818d0","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"reverts":[],"status":"in_progress","tags":["tests","git","portability"],"ticket_id":"980d-83ac-a6bb-4edb","ticket_type":"task","title":"Declare or guard the Git merge-tree test floor","verify_commands":[]},"source_event_uuids":["d695dfd3-4919-4bec-ad0d-33d2b1d93d77","faa56f43-8d69-4010-b2db-11782426e1d2","4257287a-b312-48b2-9687-1c3e6f0d59b7","a573c4e4-b89b-49fa-846a-4e9b0080ba99","3b00bab8-da4a-4fb0-8e1f-d2921e0818d0","e37ba68a-8fb2-4f96-a56f-d402124b9835","cf0018d3-a55e-4162-957b-52752403cc3e"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785903244697870002,"uuid":"e748ade2-566d-422f-b10e-cbd49e17b466"}