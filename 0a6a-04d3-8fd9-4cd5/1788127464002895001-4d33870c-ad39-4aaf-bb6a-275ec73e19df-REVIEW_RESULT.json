cdb5ff8817cf597cf"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":34494,"output_tokens":1494,"requests":4}}],"version":1},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"State the exact predicate that qualifies a Dockerfile/compose COPY/install/ENTRYPOINT target as a derived deploy-relevant path (e.g. basename matches *.sh / is an ENTRYPOINT|command target), so data/source COPYs are handled deterministically.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E2"],"decision":"advisory","decision_margin":-0.0137,"drop_reason":null,"evidence":["'parse infra/compose/Dockerfile.* + docker-compose.yml for COPY / install -m / ENTRYPOINT script references'","'a reference that resolves to NO repo file ... is discarded' — the only stated filter is resolve-to-real-file, which does not distinguish scripts from data COPYs"],"finding":"The Dockerfile/compose derivation source is described as capturing 'COPY / install -m / ENTRYPOINT script references' but the plan never defines what makes a COPY/install target a *script* reference vs an ordinary data/source COPY. The resolution rule keeps anything that resolves to an existing repo file, which would also capture COPY of source trees, requirements.txt, config, etc. — either the parser filters to scripts (undefined criterion) or it keeps all resolvable COPY targets (then the word 'script' misleads and every COPY target must be manifest-covered).","group_criteria":null,"group_id":null,"id":"f64d2d470f2c3ce7c","impact":0.67,"is_primary":null,"location":"Approach — Derivation sources (1) and Parser resolution rule; AC lines 1-2","norm_id":"nb1ee2c9391e02b30","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["A Dockerfile COPYs requirements.txt or an entire src/ subtree; the parser resolves it to a real file and demands manifest coverage, or silently drops it depending on an undefined 'is-a-script' rule."],"severity":"major","suggested_fix":"Add a sentence: 'A COPY/install target counts as a derived path only when its basename matches a script convention (*.sh) or it is named as an ENTRYPOINT/command executable; bulk source/config COPYs (already covered by directory-prefix manifest entries) are out of the derivation.'","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}}],"impact_model_version":"plan-v5","material_fingerprint":"e8296a0fae465109","material_parts":{"children":["647ea2107ca5072f",0],"description":["0721685999c9daf0",7641],"description_boxes":["670af646a34cdc2a",0],"file_impact":["57585dd72171ed9d",3],"ticket_id":["f0c0a9e0296ca1d0",19]},"metrics":{"cache_read_tokens":354800,"cache_write_tokens":119668,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":2361.4,"input_tokens":492345,"llm_calls":28,"llm_ms":126383.3,"output_tokens":19462,"precheck":{"cited_anchor_warning":false},"total_ms":137687.9,"verify_requests":1},"model":"bedrock:us.anthropic.claude-sonnet-4-6","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4