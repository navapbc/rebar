nflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Constrain the Dockerfile/compose parser to install/COPY SOURCES that resolve to an existing repo file (normalizing container prefixes like /app/ to repo-relative), discarding build-artifact paths such as Dockerfile.mcp's /root/acli-unpack/acli.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.1712,"drop_reason":null,"evidence":["Dockerfile.mcp:64 `&& install -m 0755 /root/acli-unpack/acli /usr/local/bin/acli` — source is a downloaded/unpacked artifact under /root, not a repo file","Dockerfile.mcp:147 `install -m 0755 /app/infra/scripts/mcp-entrypoint.sh ...` — the legitimate repo-sourced case (must map /app/... back to the repo-relative path)"],"finding":"Derivation source (a) parses `install -m` references, but not every `install -m` in the audited Dockerfiles takes a repo-sourced script: Dockerfile.mcp line 64 does `install -m 0755 /root/acli-unpack/acli /usr/local/bin/acli` where the source is a build-time-downloaded tarball artifact, not a committed file. A parser that treats every install/COPY source as an expected repo path will derive a non-repo path (e.g. /root/acli-unpack/acli) that can never appear in a manifest.","group_criteria":null,"group_id":null,"id":"f4acd4545ecbfc4e3","impact":0.536,"is_primary":null,"location":"Approach — Derivation sources, item 1 ('parse ... for COPY / install -m / ENTRYPOINT script references'); AC bullet 1","norm_id":"nab88e85161d64d9e","priority":0.4288,"reason":"default-advisory","recalled":false,"scenarios":["Parser derives '/root/acli-unpack/acli' and reports it as an uncovered deploy path, forcing a spurious exclusion-list entry that dilutes the intentional-exception signal","Parser fails to strip the '/app/' COPY-dest prefix and derives '/app/infra/scripts/mcp-entrypoint.sh' instead of the repo-relative 'infra/scripts/mcp-entrypoint.sh', never matching a manifest"],"severity":"major","suggested_fix":"Add a derivation rule: a parsed source is a candidate only if, after stripping the build-context prefix (/app/, ./), it names a path that exists in the repo; otherwise ignore it (it is a build-time artifact, not a deploy-relevant repo file).","tier":"LLM","validity":0.8,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State the path-normalization/matching rule used to compare a derived path against a *_PATHS entry (e.g. normalize both to repo-relative POSIX paths, match on exact normalized equality), so the cross-reference is unambiguous.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E2"],"decision":"advisory","decision_margin":-0.265,"drop_reason":null,"evidence":["'A derived path absent from every manifest -> fail'","ABSENCE: no statement of whether matching is exact-string, suffix, repo-relative-normalized, or basename — Dockerfile COPY sources and *_PATHS entries may use different path roots."],"finding":"The plan does not state how a derived path (e.g. a Dockerfile COPY source, which is context-relative) is normalized to match the path form stored in autodeploy.sh's *_PATHS manifests, leaving the cross-reference matching semantics implicit.","group_criteria":null,"group_id":null,"id":"f3522075a876ee18a","impact":0.536,"is_primary":null,"location":"Approach — 'cross-references the derived set against the UNION of autodeploy.sh's *_PATHS'","norm_id":"nde95db297cb5cce3","priority":0.335,"reason":"default-advisory","recalled":false,"scenarios":["A COPY source written relative to the build context does not string-match the merged-path form in a *_PATHS entry, producing either a false failure (present-but-unmatched) or a false pass, depending on the unstated matching rule."],"severity":"major","suggested_fix":"Specify: resolve Dockerfile COPY sources relative to the build context to repo-relative POSIX paths, and compare with exact equality against similarly-normalized *_PATHS entries.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an AC that asserts the derivation parser captures every script-reference form actually present in the audited Dockerfiles/compose (e.g. a fixture Dockerfile with multiline COPY / install / ENTRYPOINT that the parser must extract), so a parser blind spot is caught rather than silently passing.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E6"],"decision":"advisory","decision_margin":-0.675,"drop_reason":null,"evidence":["'parse infra/compose/Dockerfile.* + docker-compose.yml for COPY / install -m / ENTRYPOINT script references'","The 'origin/main PASSES after f87719be9999' AC proves the manifest is complete against WHAT THE PARSER CURRENTLY DERIVES, not that the parser derives everything relevant — a parser blind spot passes both RED->GREEN and origin/main.","ABSENCE: no AC asserts the parser captures each COPY/ENTRYPOINT form actually present in the audited Dockerfiles."],"finding":"The Dockerfile/compose derivation parser could silently under-derive (miss a COPY/ENTRYPOINT script ref due to multiline directives, ARG-interpolated paths, or an unmatched syntax), reverting to the same fail-OPEN mode the guard exists to prevent, with no criterion validating parser completeness beyond the current-repo snapshot.","group_criteria":null,"group_id":null,"id":"fce81adad1feb773b","impact":0.55,"is_primary":null,"location":"Approach — Derivation sources (1); AC line 6 (origin/main PASSES)","norm_id":"n80eeeef2cf374d06","priority":0.275,"reason":"default-advisory","recalled":false,"scenarios":["A future Dockerfile.mcp adds a script via a multiline COPY or a COPY of a path built from an ARG; the regex misses it; the guard stays green while the file drifts silently — the recurring class remains unclosed for that shape."],"severity":"major","suggested_fix":"Add a unit-test AC: a synthetic Dockerfile fixture containing each supported directive shape (single-line COPY, multiline COPY, install -m, ENTRYPOINT) asserts the parser yields the expected derived-path set; a missed shape fails the test.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"7d9db07192393722","material_parts":{"children":["647ea2107ca5072f",0],"description":["9718b5521129d54f",4934],"description_boxes":["399141be1d30ac26",0],"file_impact":["57585dd72171ed9d",3],"ticket_id":["f0c0a9e0296ca1d0",19]},"metrics":{"cache_read_tokens":591901,"cache_write_tokens":206720,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":3855.4,"input_tokens":816494,"llm_calls":28,"llm_ms":130307.2,"output_tokens":19827,"precheck":{"cited_anchor_warning":false},"total_ms":145770.6,"verify_requests":7},"model":"bedrock:us.anthropic.claude-sonnet-4-6","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4-6","anthropic:claude-sonnet-4-6"],"capabilities":{"native_structured_output":true,"prompt_cache_style":"bedrock","supports_temperature":true,"su