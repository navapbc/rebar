{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787865418965796857,"compiled_state":{"alias":"fernlike-toothsome-hen","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"269f7b49c44fd87da2bf26f8f5d35ba6d9df6ad0","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 79b2-6ebc-6c1d-4125","material: d3f381c0eaeddc51","material-part: children 647ea2107ca5072f 0","material-part: description 758db738c4f921ba 7990","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 259a0a226ec6908a 4","material-part: ticket_id 96b04aae1abd1487 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.12.0 (269f7b49c44f)","regver: aa61189569d34126","verified-at-sha:f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","dep 5180bef31b6e602a295d45c38db6a008db79f5f17a1ac5cd47b7926659325d94 infra/compose/docker-compose.yml","dep 4c88021a68cd20037a48bf60428fa97a7a653152e1cae14e51d3727558aa6ddb infra/nginx/rebar.conf.template","dep b023e0019483462bd2a3b7d8bbfc76db1e631d753d1056147152781367be2896 tests/interfaces/facades/test_mcp_http_transport.py","dep a2863a97edc9fb807744e8acd3358567bc2d02967f4be0475f93aaa5f306ed10 tests/unit/test_mcp_on_box_infra.py","read-set: 8","read-path: docs/mcp-auth.md","read-path: docs/mcp-client-setup.md","read-path: examples/mcp-clients/codex/config.toml","read-path: infra/compose/docker-compose.yml","read-path: infra/nginx/rebar.conf.template","read-path: src/rebar/_mcp_health.py","read-path: src/rebar/mcp_server.py","read-path: tests/unit/test_mcp_on_box_infra.py","currency-basis: file_impact"],"material_fingerprint":"d3f381c0eaeddc51","merged_log_commit":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787861974293979000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":16,"unsigned":0},"authorship_ledger":[{"content_hash":"c4be453b8f35b6eb84d505020359c2bacb7abd266a920ff04cfe526404010e31","event_uuid":"70d8ce1a-d96e-410e-8c7c-c9e67e227689","position":{"commit_sha":"6110d4ee6fe16c989567dd65edf2842f78e99682","position":"1787856439265243001-70d8ce1a-d96e-410e-8c7c-c9e67e227689"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8cdbe14e89890e20a1df3aca44d57608b3855eca7ce345188df1b44b1c88a742","event_uuid":"c3e8320f-cce9-4746-8654-c6a9e2b7b1d5","position":{"commit_sha":"b003aa97d8446dc925b945305acca99d8fc439f2","position":"1787856459110653001-c3e8320f-cce9-4746-8654-c6a9e2b7b1d5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5a7e85611f74a93c23c99cf249e92d70d91ba4991d24a888cc4c8aac4589a547","event_uuid":"2cfbae19-ad48-46a7-97f3-b7ffce975cc6","position":{"commit_sha":"2e7de68e8b0c59dc1efbd4eae26feb90f7d1a764","position":"1787859079509111071-2cfbae19-ad48-46a7-97f3-b7ffce975cc6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9046e99619d081cf9c882e5a988239034482dd4413a02f085225153f8c747548","event_uuid":"dbf765c0-50b6-47ba-8771-ab1ebec0ca93","position":{"commit_sha":"f7ff8d984ee7a03b50f3bbfdf654803a08e354c6","position":"1787859095180530169-dbf765c0-50b6-47ba-8771-ab1ebec0ca93"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a5e0765dcf7fa4552df6f65b6a730dbda2e6f61fda0a7bb5058124215a437a65","event_uuid":"0dac3568-9719-48d4-a379-023c79b1ef35","position":{"commit_sha":"3b22829521cb407c6b45a8bbebf5054ddb6105d5","position":"1787859099274900961-0dac3568-9719-48d4-a379-023c79b1ef35"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f88873997e47a7510669191f3dfc4ad85c64f5aac7a0f8d5764380197453db16","event_uuid":"eec5b612-d8e7-42c4-bc43-3759366a828b","position":{"commit_sha":"9a97535247752a5af28ae0c196149e78e6bd298b","position":"1787859203445244142-eec5b612-d8e7-42c4-bc43-3759366a828b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d20411c33468bcf9c14a69c0c0d35f130eea2ed15f05d7d9c707b5d564f35428","event_uuid":"20f8bcbb-164f-489a-85bc-c0aed26d0b31","position":{"commit_sha":"66c2e01027b4c877ea06f6f1ca31bf0aa909d873","position":"1787859501766302730-20f8bcbb-164f-489a-85bc-c0aed26d0b31"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"383139bc9dd287ea9bfed3fe0a8c60d89fceae9ec0e4303ee16a15240935373b","event_uuid":"fd7a8653-eeb7-4303-a71f-c74b91788a63","position":{"commit_sha":"bf3e3b2ba2ae4033b800f1afc165d1b90e68dcef","position":"1787859890380419340-fd7a8653-eeb7-4303-a71f-c74b91788a63"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a06972438fbf1934e749330ab8563444855d4aecf021b7626ec0b7c16e35ec1e","event_uuid":"146565aa-8fd2-4167-9c6f-afaed36a5509","position":{"commit_sha":"b56e585f5ccab97361c77bf22f1d17fcca99ae0f","position":"1787860240239944785-146565aa-8fd2-4167-9c6f-afaed36a5509"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d3ed2f21ccf991b419ebb4744a160a3215abfd2b39f1c1d1caa8617bd713a201","event_uuid":"9a0273f7-7dc0-40b5-8011-108e2a984c72","position":{"commit_sha":"465275e5265f74bf0b1582501349c40599abbb81","position":"1787860796290868001-9a0273f7-7dc0-40b5-8011-108e2a984c72"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9c8ba898fc6561bc629233ba34f03ff3cebb595f4f99e7573ec267f75d124535","event_uuid":"f41d68f2-0333-4102-b0c5-0765a21b2ff0","position":{"commit_sha":"29520b01a85af6a8b5c0e51a8d2657342f4c45c6","position":"1787861701398791001-f41d68f2-0333-4102-b0c5-0765a21b2ff0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"03b91b72219fb1aa42d2d47806668b1ef6c47910090fd0b4f775ff0b68f9e480","event_uuid":"45a63c90-4862-4f54-a1cd-46c4c2ffff62","position":{"commit_sha":"afcd3b971e13596fe4f01648de59bdfabf0336e0","position":"1787861974360119001-45a63c90-4862-4f54-a1cd-46c4c2ffff62"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b931b2de588d83d814bbb430ba335ecfd66488600a5678c1ec963aaf3c291e0e","event_uuid":"f3eb2587-4433-4b65-943f-19aae7d7c6fa","position":{"commit_sha":"9a140f65287f92b4ee16b926f28d386464ef3baf","position":"1787862145114660581-f3eb2587-4433-4b65-943f-19aae7d7c6fa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"45ad41ae39939879c0f8b784ab9545d761094135b72d1407cb42228690804b7c","event_uuid":"62244d5d-eb89-4999-9c60-1ed47b0e9624","position":{"commit_sha":"9a140f65287f92b4ee16b926f28d386464ef3baf","position":"1787862145130552187-62244d5d-eb89-4999-9c60-1ed47b0e9624"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"fd88f89a784ce77d6bb5bcd4c78dbf6a9f01b844758045d93c8005ceff118189","event_uuid":"571537e8-ebd8-47fe-961a-95f700c80136","position":{"commit_sha":"384f3d2559034ae57a3d1691f7b5d0b7048695ee","position":"1787862259377019919-571537e8-ebd8-47fe-961a-95f700c80136"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9136b7ae74f8c45a8e60ddb481d3c7d99ecc86dfb645b70bf3c79cd19f40fa74","event_uuid":"a840779a-2173-4204-ba4f-f168a8a1fe99","position":{"commit_sha":"7329f627e377e74d762ea002bc5ed4b75714875e","position":"1787863007038384373-a840779a-2173-4204-ba4f-f168a8a1fe99"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## RCA — confirmed root cause (Phase 1 complete)\n\nReproduced live (unauthenticated, no credential sent), 2026-08-27:\n\n    $ curl -s -o /dev/null -D - https://rebar.solutions.navateam.com/mcp/\n    HTTP/2 307\n    location: http://rebar.solutions.navateam.com/mcp\n\n    $ curl -s -o /dev/null -D - -X POST -d '{}' https://rebar.solutions.navateam.com/mcp\n    HTTP/2 401   (www-authenticate: Bearer ...)\n\nNeither response carried `strict-transport-security`. Symptoms confirmed as reported.\n\n### Two mechanisms, both proven at runtime\n\n**A — why a redirect exists at all.** `infra/nginx/rebar.conf.template:127` is a PREFIX\n`location /mcp` with a URI-preserving `proxy_pass http://rebar_mcp;` (no path). The external\n`/mcp/` therefore reaches the app verbatim as `/mcp/`, while the app mounts its\nStreamable-HTTP endpoint at `http_path = \"/mcp\"` (`src/rebar/mcp_server.py:524`, handed to\n`FastMCP(streamable_http_path=path)` at `src/rebar/mcp_server.py:618-627`). Starlette's router\ndefault `redirect_slashes=True` (set nowhere in this repo) then emits the 307 `/mcp/` -> `/mcp`.\n\nThe redirect is emitted by the APP, not by nginx — nginx emits 301s for its own directory\nredirects, never a 307, and it has no rewrite in that block.\n\n`docs/mcp-auth.md:252-271` already prescribes the correct edge for exactly this asymmetry —\nEXACT-MATCH `location = /mcp/` and `location = /mcp`, both `proxy_pass .../mcp` — and states\nthe reason: \"The external edge is `/mcp/` but the app serves `http_path = \\\"/mcp\\\"`\". The\ncommitted template diverged from its own documented pattern.\n\n**B — why the redirect target is plaintext.** nginx does send `proxy_set_header\nX-Forwarded-Proto https;` (`infra/nginx/rebar.conf.template:132`), yet the production Location\nis `http://`. That live response is direct proof that the forwarded proto is being IGNORED by\nthe app. Mechanism: uvicorn is constructed at `src/rebar/_mcp_health.py:311-317` with no\n`forwarded_allow_ips`; uvicorn then defaults it from the environment —\n`uvicorn/config.py:356-357`, `os.environ.get(\"FORWARDED_ALLOW_IPS\", \"127.0.0.1\")` — and wraps\nthe app in `ProxyHeadersMiddleware(trusted_hosts=...)` at `uvicorn/config.py:527`. The MCP app\nruns INSIDE a container (`docker-compose.yml:337` `REBAR_MCP_HTTP_HOST: \"0.0.0.0\"`, published\n`127.0.0.1:8091:8091`), so nginx's connection arrives from the docker bridge gateway, not\n`127.0.0.1`; the peer is untrusted, `X-Forwarded-Proto` is dropped, `scope[\"scheme\"]` stays\n`http`, and every app-generated absolute URL is built as `http://`. No `FORWARDED_ALLOW_IPS`\nis set anywhere in `infra/`.\n\n**C — no backstop.** A repo-wide grep for `strict-transport` over `infra/ docs/ src/ tests/`\nreturns ZERO hits. The 443 server block (`infra/nginx/rebar.conf.template:77-158`) has no\n`add_header Strict-Transport-Security`.\n\n### The discriminating experiment\n\nIn-process, over the real `streamable_http_app()`, POST `/mcp/` with `follow_redirects=False`:\n\n    E1  bare app                       -> 307  Location: http://127.0.0.1:8000/mcp\n    E2  ProxyHeadersMiddleware(trusted_hosts=\"127.0.0.1\"),\n        peer 172.17.0.1, X-Forwarded-Proto: https\n                                       -> 307  Location: http://127.0.0.1:8000/mcp\n    E3  ProxyHeadersMiddleware(trusted_hosts=\"*\"),\n        peer 172.17.0.1, X-Forwarded-Proto: https\n                                       -> 307  Location: https://127.0.0.1:8000/mcp\n\nE1 confirms mechanism A: the APP emits the 307 (kills \"nginx generated it\").\nE2 reproduces the exact production symptom.\nE2 vs E3 is the discriminator: the ONLY difference is the trusted-peer setting, and it flips\nthe scheme. That kills the alternatives \"the app hardcodes http\", \"nginx rewrote the Location\",\nand \"HTTP/2 stripped the scheme\".\n\n### Defect legitimacy: `defect`\n\nCited authority the behaviour violates:\n- `docs/mcp-auth.md:252-271` — the documented exact-match edge pattern this template does not\n  implement, written specifically to reconcile `/mcp/` with `http_path=/mcp`.\n- `REBAR_MCP_HTTP_TLS_AT_EDGE=true` (`docker-compose.yml:340`; gate at\n  `src/rebar/mcp_server.py:560-566`) is a design invariant that the deployment is https-only\n  with TLS terminating at nginx. A 307 to `http://` on the documented client URL contradicts it.\n- The `static` bearer-PAT auth design: a 307 preserves method and body, and clients differ on\n  retaining `Authorization` across a same-host scheme change.\n\n### Defect origin — `caused_by` fd4a-4e91-f179-4932 (cibophobic-holohedral-esok)\n\n`git blame -w -C -M -L 118,140 -- infra/nginx/rebar.conf.template` puts the `location /mcp` +\n`proxy_pass http://rebar_mcp;` lines on **8297083532a3** (\"Add rebar-mcp HTTP service to the AWS\nbox\"), trailer `rebar-ticket: fd4a-4e91-f179-4932`. That single change introduced BOTH halves:\nthe prefix location that diverges from the doc's exact-match pattern, and the containerised MCP\nservice that never set `FORWARDED_ALLOW_IPS`. Its own AC3 says \"nginx `/mcp/` proxies to a named\n`upstream rebar_mcp`\" and its oracle was a structural parse — which asserted the upstream wiring\nbut nothing about scheme, trailing slash, or redirect behaviour, so the divergence escaped.\n\nDivergence from a whole-file blame majority, recorded per protocol: `git blame` attributes\n`proxy_set_header X-Forwarded-Proto https;` (line 132) to **6cd6f4e1f7c0c** (Iso Tester,\n2026-06-29, the original TLS terminator). That line is CORRECT and is not the defect — the\ndefect is that the containerised consumer added by fd4a never met the obligation to trust it.\nAttributing to 6cd6f4e1 would be the unmet-obligation misattribution the protocol warns about.\n\nThe **HSTS omission (C) is older** than fd4a — it is scope-of-work of the original TLS\nterminator `6cd6f4e1f7c0c` — but fd4a is what created the bearer-PAT-over-plaintext exposure\nthat makes it P1, so the bug attributes to fd4a and the HSTS gap is fixed here as part of the\nsame edge hardening.\n\nPhase 2 (RED -> GREEN) follows. Ticket will NOT be closed in this session.","timestamp":1787859079509111071},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Blast-radius check on root cause B — narrower than feared, stated explicitly\n\nRoot cause B is `forwarded_allow_ips` defaulting to `127.0.0.1` in a container, which makes\nuvicorn distrust EVERY forwarded header from nginx, not just the proto. That is broader than a\nredirect bug in principle, so I checked the two places it would plausibly hurt most rather than\nassuming the redirect was the whole story. Both came back clean, and the honest answer is that\nthe reachable impact is bounded:\n\n**1. RFC 9728 metadata and the `WWW-Authenticate` `resource_metadata` URL — NOT affected.**\nThese are built from the configured `auth_resource_server_url`\n(`src/rebar/mcp_server.py:610`, fed by `REBAR_MCP_AUTH_RESOURCE_SERVER_URL` in\n`docker-compose.yml:347`), not from the request scheme. Confirmed empirically against the live\nbox: the unauthenticated 401 returns\n`resource_metadata=\"https://rebar.solutions.navateam.com/.well-known/oauth-protected-resource/mcp\"`\n— `https`, despite `scope[\"scheme\"]` being `http` at that moment. Config-derived absolute URLs\nare structurally immune to this defect.\n\n**2. Client-IP-keyed logic — none exists in rebar.** A search of `src/rebar/` for\n`request.client`, `scope[\"client\"]`, `remote_addr` and `X-Forwarded-For` consumers returns no\nmatches, so no rebar logging, rate limiting, or audit path keys on the peer address and none is\nsilently recording the docker bridge gateway. (uvicorn's own access log does show the gateway,\nbut that is uvicorn's log line, not rebar logic, and it is corrected by the same\n`FORWARDED_ALLOW_IPS` fix.)\n\n**Conclusion.** The only reachable instance of the defect is a scheme-derived absolute URL, and\nthe slash-redirect `Location` was the one such URL the app actually emits today. So the reported\nbug WAS the blast radius — this is not a redirect symptom of a larger live exposure.\n\n**The residual risk is forward-looking, not current:** any future code that reads\n`request.url`, `request.client`, or builds a URL from the request rather than from config would\nsilently inherit the plaintext scheme. Fixing B here (rather than only patching the edge) is what\nremoves that trap, which is the main reason it is in scope alongside the nginx change.\n\n## Step 7 parity sweep\n\n**Axis 1 (construct sweep): no siblings.** The construct is \"external path with a trailing slash\nproxied URI-preserving to an app mounted at the slash-less path\". `/review/` uses a\nprefix-stripping `proxy_pass .../;` and `/opcert/` preserves a prefix the app genuinely serves,\nso neither has the asymmetry. No other instance in the tree.\n\n**Axis 2 (parity census): three MISSING slots, dispositioned by ticket.** The rule this fix\nenforces — an https request must never receive a Location that downgrades to `http` — now holds\nfor the MCP paths only. `/review/` (`:92`), `/opcert/` (`:107`) and Gerrit's `location /`\n(`:152`) have no equivalent guarantee. I deliberately did NOT hoist `proxy_redirect` to the\nserver level to cover them: it defaults to `default`, derived from each location's own\n`proxy_pass`, so a server-level rule would replace `/review/`'s prefix-stripping rewrite and\ncould break its relative redirects. Filed as\n**a61d-adf9-3725-4847 (enchanting-phantastic-weevil)**, linked `discovered_from` this bug.\n\nHSTS is NOT part of that gap — it is added at the 443 **server** level here, so all four\nsurfaces inherit it immediately.\n","timestamp":1787862259377019919},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Phase 2 complete — fix committed locally (NOT pushed, ticket NOT closed)\n\nLocal commit **e9cec6bad8d1684150f4e8e2769e2d0fe1fa398f** on branch `79b2-mcp-https-redirect`,\nauthored `RebarBotNava <joeoakhart+bot@navapbc.com>`, signed off, `rebar-ticket:` trailer\nverified (`verify-commit-ticket: OK - resolved 79b2-6ebc-6c1d-4125`). 4 files, +280/-7.\n\n### RED -> GREEN, held out\n\nAll 5 new tests were observed RED **before** any fix existed, each failing for its own specific\nmissing artifact (`exact-match location = /mcp/ block not found`, `no add_header\nStrict-Transport-Security \"...\" always;`, `the mcp service must set FORWARDED_ALLOW_IPS...`,\n`KeyError: 'FORWARDED_ALLOW_IPS'`) — not import or fixture errors. The tests were then removed\nfrom the tree entirely (saved as a patch) before the fix subagent was launched, and the agent\nwas told the paths were off-limits. It never saw them. Re-applied afterwards: **60 passed**.\nBroader sweep over the infra/mcp/deploy/opcert suites: **369 passed, 6 skipped**.\n\n### Mutation check — 6 seeded defects, all killed, run under `sandbox-exec`\n\n    RED   M1 drop the exact-match locations          (cause A)\n    RED   M2 drop proxy_redirect                     (edge backstop)\n    RED   M3 drop the HSTS header                    (cause C)\n    RED   M4 drop FORWARDED_ALLOW_IPS  [structural]  (cause B)\n    RED   M4 drop FORWARDED_ALLOW_IPS  [behavioural] (cause B)\n    RED   M5 pin FORWARDED_ALLOW_IPS to 172.17.0.1   (the plausible wrong value)\n\nM5 matters most: it is the fix that *looks* right and silently re-opens the downgrade when the\nbridge address drifts. The sandbox denied writes outside the worktree in a live probe before the\nrun (and twice refused my own backup paths, which is how I know it was actually enforcing).\n\n### The fix\n\n`infra/nginx/rebar.conf.template` — exact-match `location = /mcp/` and `= /mcp`, both\n`proxy_pass http://rebar_mcp/mcp;`, each carrying the full SSE settings and forwarded headers (an\nexact-match location inherits nothing from the prefix one); the prefix `location /mcp` retained\nunchanged for `/mcp/...` sub-paths; `proxy_redirect http://$host/ https://$host/;` plus the\nnamed-upstream form in all three MCP locations; `add_header Strict-Transport-Security\n\"max-age=31536000; includeSubDomains\" always;` at 443 server level.\n\n`infra/compose/docker-compose.yml` — `FORWARDED_ALLOW_IPS: \"*\"` on the `mcp` service. No `src/`\nchange: uvicorn reads the variable natively.\n\n### Verification output\n\n    make lint      EXIT=0\n    make typecheck EXIT=0   (mypy: Success: no issues found in 677 source files)\n\n### Fix-safety audit\n\nNo `src/` change, no docs/examples change, no new dependency, no test weakened. One pre-existing\ntest — `test_nginx_mcp_location_proxies_to_the_named_upstream` — needed its **selector**\ntightened: `location\\s+/mcp\\b[^{]*\\{` matched the words `location /mcp` inside a COMMENT and then\nran forward to the next `{`, capturing an exact-match block. Now anchored to a line-leading\ndirective. All three assertions are byte-identical, and I proved it is a selector fix rather than\na weakening by reverting the config and confirming the tightened test **passes against the\npre-fix template too** — which it must, since the prefix location's behaviour is unchanged.\n\n### EXPECTED_URL decision: unchanged, and now safe\n\n`tests/interfaces/facades/test_mcp_client_configs.py:52` keeps\n`https://rebar.solutions.navateam.com/mcp/`. After the fix that form is served DIRECTLY over\nhttps with no redirect, so the canonical URL is the safe one and stays consistent with the\n`auth_resource_server_url` audience. Its test passes unchanged.\n\n### NOT verified — read this before deploying\n\n- **`nginx -t` was never run.** There is no nginx binary on this host and I did not install one.\n  The config is verified **structurally only** (regex/brace parsing). Syntax validation is the\n  operator's step at deploy time.\n- **The live edge is unchanged.** Nothing was applied to the box; the 307 still reproduces in\n  production right now. The LIVE VALIDATION acceptance criterion is deliberately unticked and\n  requires an operator to deploy and evidence the actual response headers here.\n- **Nothing was pushed.** The branch is local, 1 ahead / 2 behind `origin/main`.\n\n### Residual risk\n\n- Parity gap on `/review/`, `/opcert/` and Gerrit — **filed** as a61d-adf9-3725-4847\n  (enchanting-phantastic-weevil), linked `discovered_from`.\n- Root cause B's forward-looking trap (future code building URLs from the request rather than\n  config) — **fixed in scope** by `FORWARDED_ALLOW_IPS`, which is why B was fixed rather than\n  only the edge.\n- Process note: I used `git stash` in this worktree for the pre-fix/post-fix comparison. The\n  stash stack is repo-global and other sessions had entries on it. Mine was popped and dropped\n  and theirs were verified untouched, but `git diff > patch` + `git checkout --` would have been\n  the correct tool and is what I used for the held-out oracle.\n","timestamp":1787863007038384373}],"created_at":1787856439265243001,"creation_channel":"cli","deps":[{"link_uuid":"c3e8320f-cce9-4746-8654-c6a9e2b7b1d5","relation":"discovered_from","target_id":"71e7-4626-cb19-42d7"},{"link_uuid":"dbf765c0-50b6-47ba-8771-ab1ebec0ca93","provenance":"explicit","relation":"caused_by","target_id":"fd4a-4e91-f179-4932"}],"description":"## Summary\n\nThe MCP client URL every doc and committed example specifies —\n`https://rebar.solutions.navateam.com/mcp/` (WITH the trailing slash) — answers `307` with\n`location: http://rebar.solutions.navateam.com/mcp`: an HTTPS->HTTP downgrade, with no HSTS to\nupgrade it back. The no-slash `/mcp` returns a correct `401`. Re-reproduced 2026-08-27 from\nunauthenticated probes. A 307 preserves method and body, and clients differ on whether they\nretain `Authorization` across a same-host scheme change, so one that retains it puts its bearer\nPAT on the wire in plaintext. The docs point AT the affected form\n(`docs/mcp-client-setup.md:54`, `examples/mcp-clients/codex/config.toml:18`).\n\n## Confirmed root cause\n\nProven at runtime; evidence, the discriminating experiment and the defect attribution\n(caused_by fd4a-4e91-f179-4932) are in the RCA comment. Three changeable artifacts:\n\n**A** `infra/nginx/rebar.conf.template:127` is a PREFIX `location /mcp` with a URI-preserving\n`proxy_pass http://rebar_mcp;`, so external `/mcp/` reaches the app verbatim while the app\nmounts at `http_path = \"/mcp\"` (`src/rebar/mcp_server.py:524,618-627`); Starlette's default\n`redirect_slashes` emits the 307. `docs/mcp-auth.md:252-271` already prescribes EXACT-MATCH\nlocations for this asymmetry and the template diverged from it.\n\n**B** uvicorn is built at `src/rebar/_mcp_health.py:311-317` with no `forwarded_allow_ips`, so\nit defaults to `\"127.0.0.1\"` (`uvicorn/config.py:356-357`). The app runs in a container\n(`docker-compose.yml:337`), so nginx arrives from the bridge gateway; that peer is untrusted,\n`X-Forwarded-Proto https` (`rebar.conf.template:132`) is dropped, and scheme-derived absolute\nURLs become `http://`. Blast radius checked and BOUNDED: RFC 9728 metadata and\n`resource_metadata` come from the configured `auth_resource_server_url`\n(`src/rebar/mcp_server.py:610`) and the live 401 returns them as `https`; no rebar code keys on\nthe peer address.\n\n**C** The 443 server has no `add_header Strict-Transport-Security`.\n\n## Approach\n\n1. **Serve `/mcp/` directly instead of redirecting.** Adopt the documented exact-match pattern\n   (`docs/mcp-auth.md:252-271`) against the named upstream: `location = /mcp/` and\n   `location = /mcp`, both `proxy_pass http://rebar_mcp/mcp;`, keeping the existing SSE\n   settings. An exact-match location with a URI on `proxy_pass` replaces the matched URI, so\n   `/mcp/` arrives at the app as `/mcp`, `redirect_slashes` never fires, and no Location header\n   is produced. The PREFIX `location /mcp` is retained for `/mcp/...` sub-paths.\n2. **Make a plaintext Location structurally impossible.** Add `proxy_redirect http://$host/\n   https://$host/;` plus the named-upstream form to the MCP locations, upgrading any `http://`\n   Location an upstream might emit. Scoped to those locations because `proxy_redirect` defaults\n   to `default` (derived from each location's own `proxy_pass`), so a server-level rule would\n   replace it for `/review/` and `/opcert/` and could break their relative redirects.\n3. **Fix the scheme derivation.** Set `FORWARDED_ALLOW_IPS: \"*\"` on the `mcp` compose service.\n   Verified in installed uvicorn 0.52.1: a programmatically-built `Config` defaults\n   `forwarded_allow_ips=None` then reads `os.environ.get(\"FORWARDED_ALLOW_IPS\", \"127.0.0.1\")`\n   (`uvicorn/config.py:356-357`) and wires `ProxyHeadersMiddleware` (`:527`) — so no code change\n   is needed. `\"*\"` rather than a pinned address: the `mcp` service declares no `networks:`\n   block, so the bridge gateway address is implicit and can drift, and a stale pin would\n   silently re-open the downgrade while local tests passed. Trust-all is bounded because the\n   port is published on host loopback with nginx the sole reachable client, and nginx sets\n   `X-Forwarded-Proto https` as a LITERAL.\n4. **Add HSTS.** `add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\"\n   always;` on the 443 server. `always` is required so it is emitted on error responses — such\n   as the 401 the MCP endpoint returns to an unauthenticated client.\n\nNOT changed: `EXPECTED_URL` in `tests/interfaces/facades/test_mcp_client_configs.py` and the\ndocumented/example URLs — after step 1 the trailing-slash form is served directly over https, so\nit stays canonical and `auth_resource_server_url` stays consistent with it. Production nginx on the live box is\nNOT changed here: this lands the config in the repo and an operator applies it.\n\n## Acceptance Criteria\n\n- [ ] The edge routes `/mcp/` straight to the app's `/mcp`, so no Location header is produced\n      for the documented URL. Verified by a structural parse of `rebar.conf.template` asserting\n      an exact-match `location = /mcp/` whose `proxy_pass` carries the app path `/mcp`.\n- [ ] An HSTS header with `max-age` of at least 31536000 is served on the 443 server, marked\n      `always` so it reaches the unauthenticated 401. Verified by a structural parse asserting\n      `add_header Strict-Transport-Security \"...\" always;` in that server block.\n- [ ] Each MCP location carries a `proxy_redirect` mapping an `http://` upstream Location to\n      `https://`. Verified by a structural parse that fails if it is absent from any.\n- [ ] With the committed `FORWARDED_ALLOW_IPS` in force, a `/mcp/` request through the real\n      `streamable_http_app()` yields a Location whose scheme is `https`. Verified by an\n      in-process ASGI test through uvicorn's `ProxyHeadersMiddleware` with an untrusted-peer\n      negative control asserting `http`, plus a structural assertion that compose sets\n      `FORWARDED_ALLOW_IPS` to exactly `*`.\n- [ ] LIVE VALIDATION — REQUIRED TO CLOSE. `curl -D - https://rebar.solutions.navateam.com/mcp/`\n      emits NO `http://` Location and carries an HSTS header, OBSERVED against the deployed edge\n      and recorded in a ticket comment with the actual response headers. Neither a passing local\n      test nor a merged change satisfies this — it must be deployed and serving — so this\n      depends on an OPERATOR applying the config and must not be ticked on a local render.\n\n## Testing\n\nRED-first; both tiers observed failing before any fix.\n\n- `tests/unit/test_mcp_on_box_infra.py` — structural tests over the committed nginx template\n  (exact-match `/mcp/` and `/mcp` locations, `proxy_redirect` on each, HSTS with `always`) and\n  over `docker-compose.yml` (`FORWARDED_ALLOW_IPS` == `*`). No nginx binary is\n  available here, so these parse committed text, as the existing\n  `test_nginx_mcp_location_proxies_to_the_named_upstream` (`:154`) does. `nginx -t` is the\n  operator's deploy-time check.\n- `tests/interfaces/facades/test_mcp_http_transport.py` — a behavioural test over the real\n  `streamable_http_app()` through uvicorn's `ProxyHeadersMiddleware` configured from the\n  committed compose value, asserting the Location scheme is `https`, with an untrusted-peer\n  negative control asserting `http`. Executable oracle for B.\n\nMutation check: re-introduce each confirmed cause (drop the exact-match locations, the\n`proxy_redirect`, the HSTS header, `FORWARDED_ALLOW_IPS`) and confirm the corresponding test\nreturns to RED, then restore. Run inside an OS sandbox.\n\n## File impact\n\n`infra/nginx/rebar.conf.template`, `infra/compose/docker-compose.yml`,\n`tests/unit/test_mcp_on_box_infra.py`, `tests/interfaces/facades/test_mcp_http_transport.py`.\n\n## Compat / rollback\n\nAdditive: two exact-match locations ahead of the retained prefix location, two directives per\nMCP location, one HSTS header, one compose env var. `/mcp` returns a 401 today and continues to;\n`/mcp/` stops redirecting and starts serving. No caller depends on the 307 — it is the defect.\nRollback is a revert of the four files.\n\n## Portability\n\nCommitted config plus tests that parse committed text. No CI provider is involved: the\nstructural tests run under plain `pytest` and the behavioural test is in-process ASGI with no\ndocker and no network. Applying the nginx change is an operator step, not a CI trigger.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/nginx/rebar.conf.template","reason":"exact-match `location = /mcp/` + `= /mcp` proxying to the app path (removes the slash redirect); `proxy_redirect` upgrading any http:// upstream Location to https://; `add_header Strict-Transport-Security` on the 443 server"},{"path":"infra/compose/docker-compose.yml","reason":"set FORWARDED_ALLOW_IPS on the mcp service so uvicorn's ProxyHeadersMiddleware trusts nginx's X-Forwarded-Proto https and stops building http:// absolute URLs"},{"path":"tests/unit/test_mcp_on_box_infra.py","reason":"RED-first structural tests: no MCP edge path can emit a non-https Location, and HSTS is served; plus the compose FORWARDED_ALLOW_IPS assertion"},{"path":"tests/interfaces/facades/test_mcp_http_transport.py","reason":"RED-first behavioural test over the real streamable_http_app: with the deployed forwarded-proto trust, a /mcp/ request yields an https Location (scheme preservation), and an untrusted peer is the negative control"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f3eb2587-4433-4b65-943f-19aae7d7c6fa","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["mcp","auth","security","nginx","edge"],"ticket_id":"79b2-6ebc-6c1d-4125","ticket_type":"bug","title":"Documented MCP client URL /mcp/ 307-redirects to plaintext http:// with no HSTS","verify_commands":[]},"source_event_uuids":["70d8ce1a-d96e-410e-8c7c-c9e67e227689","c3e8320f-cce9-4746-8654-c6a9e2b7b1d5","2cfbae19-ad48-46a7-97f3-b7ffce975cc6","dbf765c0-50b6-47ba-8771-ab1ebec0ca93","0dac3568-9719-48d4-a379-023c79b1ef35","eec5b612-d8e7-42c4-bc43-3759366a828b","20f8bcbb-164f-489a-85bc-c0aed26d0b31","fd7a8653-eeb7-4303-a71f-c74b91788a63","146565aa-8fd2-4167-9c6f-afaed36a5509","9a0273f7-7dc0-40b5-8011-108e2a984c72","f41d68f2-0333-4102-b0c5-0765a21b2ff0","45a63c90-4862-4f54-a1cd-46c4c2ffff62","f3eb2587-4433-4b65-943f-19aae7d7c6fa","62244d5d-eb89-4999-9c60-1ed47b0e9624","571537e8-ebd8-47fe-961a-95f700c80136","a840779a-2173-4204-ba4f-f168a8a1fe99"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787865418965796857,"uuid":"a16af903-5e95-462a-a9e4-80268de0042d"}