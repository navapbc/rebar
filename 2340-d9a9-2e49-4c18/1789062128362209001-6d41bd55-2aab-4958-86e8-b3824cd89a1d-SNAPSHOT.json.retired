{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1789062128362209001,"compiled_state":{"alias":"lovesick-missing-andeancat","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"685faec793b2b227e79feb9118f21c69d2347f4a","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 2340-d9a9-2e49-4c18","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.13.1 (685faec793b2b)","material: 01e874dd9b8a4c4d","verified-at-sha:685faec793b2b227e79feb9118f21c69d2347f4a"],"material_fingerprint":"01e874dd9b8a4c4d","merged_log_commit":"685faec793b2b227e79feb9118f21c69d2347f4a","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1789047412332929000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"685faec793b2b227e79feb9118f21c69d2347f4a","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 2340-d9a9-2e49-4c18","material: 01e874dd9b8a4c4d","material-part: children 647ea2107ca5072f 0","material-part: description cf615e08f2f12f5b 7563","material-part: description_boxes fc11d6f28e59d3cc 10","material-part: file_impact c740bd94d6389c5e 5","material-part: ticket_id 14fcaa9441d195a2 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1 (685faec793b2b)","regver: aa61189569d34126","verified-at-sha:7ec291928fa1febddccfd97c17668c0b4488fd5c","dep 262c4edb4877626b9b574ba35f59040a2973c8898bd6235027d078c6b98e80e5 src/rebar/llm/eval_specs/**","dep ee7ccfb64f65e229910df145ea4fb459f5aae8d7d10f2dc2575b0a6e47c35fe0 src/rebar/llm/evals/fixture_admission.py","dep 54839bb4d54e03307dff1b5f0aa46621510f15ae7a47458007b2d3e76c5d263e src/rebar/llm/evals/plan_replay/corpus.py","dep 292addee4345e60c3b470586de8415f69fcbed1d369e3b832bb273ebdbe7e3c5 src/rebar/llm/evals/plan_replay/tier2.py","dep 572470835a6d36b166868f1770fb64f9dfebd6f3cd054ba8e26bfe372b6cd954 tests/**","read-set: 10","read-path: infra/terraform/main.tf","read-path: src/rebar/llm/evals/eval_solver.py","read-path: src/rebar/llm/evals/fixture_admission.py","read-path: src/rebar/llm/evals/fixture_mining/heal.py","read-path: src/rebar/llm/evals/fixture_selection.py","read-path: src/rebar/llm/evals/plan_replay/corpus.py","read-path: src/rebar/llm/evals/plan_replay/tier2.py","read-path: src/rebar/llm/plan_review/container_stage.py","read-path: src/rebar/llm/plan_review/context_assembly.py","read-path: src/rebar/llm/plan_review/material_diff.py","currency-basis: file_impact"],"material_fingerprint":"01e874dd9b8a4c4d","merged_log_commit":"7ec291928fa1febddccfd97c17668c0b4488fd5c","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1789046727874317000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":35,"unsigned":0},"authorship_ledger":[{"content_hash":"d90811c6c7c1fe6d52dd00b9ced8dfabe02cf179492b8fae8b604f65cf820935","event_uuid":"ef1f8634-d3b1-42c1-ad96-69e0a0eb8191","position":{"commit_sha":"84419c1ead527376586721f65808e23b2f08cbf6","position":"1789023124958931001-ef1f8634-d3b1-42c1-ad96-69e0a0eb8191"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6e4c4a8e870a02461ef9ed4fd4295308112fecbf3714f13df6a465a8c8193317","event_uuid":"b17a97c8-7abe-4e7d-90eb-8a8929e7061a","position":{"commit_sha":"197a8264540bca8da90107ced7a71efbe46246ba","position":"1789023662224637543-b17a97c8-7abe-4e7d-90eb-8a8929e7061a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"223adcda6b639e981c1103803b5d785dddb463d7a2eca20c6389c4ad7ef8f07c","event_uuid":"e84c9325-f995-4033-9e1a-be41cb313902","position":{"commit_sha":"92ef2a706d5a284bf315ac75ec665ff0c33480e8","position":"1789025485266804001-e84c9325-f995-4033-9e1a-be41cb313902"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"49b916b51e8638409549978976867847af3fb730237778d04e6cb47588b00694","event_uuid":"1a06d628-f689-4a0b-bc5f-350d4d8e772b","position":{"commit_sha":"6db5c0a4ac37ab5975a47165bf61fcd137b7c476","position":"1789027154954568001-1a06d628-f689-4a0b-bc5f-350d4d8e772b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"25ed14a295b412e4575