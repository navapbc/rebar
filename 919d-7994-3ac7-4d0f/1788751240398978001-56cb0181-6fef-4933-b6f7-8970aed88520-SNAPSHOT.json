c-433e-a35b-178132fc6867"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e8f554a4fc343d2fd77f9ce6696ce59af85950aea797160df494a189518180f3","event_uuid":"4f0ff530-da70-40f7-897e-ae024e232f1c","position":{"commit_sha":"37d5ca21c91e98cf9d15b3095b44c413ba539f49","position":"1788744386413647001-4f0ff530-da70-40f7-897e-ae024e232f1c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e0281747c9c0a746b9a07b7a4ac6dea9b8a1fdd53a0592938f2f1b182221742e","event_uuid":"de1c801b-73b1-497a-9013-a01ebe2b6497","position":{"commit_sha":"a272ea95e844ee30c1878d7ca3fd22c6b7a41adc","position":"1788744550134080001-de1c801b-73b1-497a-9013-a01ebe2b6497"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8940e7a6b2970e59c0d7a543c1878b13bbc21f576533ae5f7573dca4fd45af00","event_uuid":"b411a96e-213e-4beb-975d-2ea443f1b0c6","position":{"commit_sha":"759eb491ed22a68786355f790df39387669731be","position":"1788744560519927001-b411a96e-213e-4beb-975d-2ea443f1b0c6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"regression","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OBSERVATION\nThe ticket reports a commit prepared with `git commit -F /tmp/commitmsg.txt` after a concurrent session wrote the same fixed path, so the commit acquired the other session's message. Current guidance (`AGENTS.md`, `CONTRIBUTING.md`) warns about `make amend-msg` preserving Change-Id but does not tell authors where to stage commit-message files. `Makefile:amend-msg` passes `FILE` through to `scripts/amend_commit_message.py`, and `_read_message_file` only checks that the path exists and is non-empty. There is no guard against fixed shared scratch paths. A sweep also found other shared-tmp patterns, e.g. `scripts/install-gerrit-hook.sh` uses `mktemp \"${TMPDIR:-/tmp}/rebar-commit-msg.XXXXXX\"` (unique) while the bad reported path was fixed and non-unique.\n\nHYPOTHESIS\nThe root mechanism is a shared-path TOCTOU/collision, not a Git failure: `git commit -F <path>` reads whatever bytes are at `<path>` at commit time and has no ownership/session provenance check. A fixed path under host-shared scratch is writable by another same-user agent session, so the last writer wins silently; Git exits 0 because the file is valid, even though the message semantically belongs to a different diff.\n\nCONFIRMATION\nI reproduced the mechanism in a scratch directory (not `/tmp`): initialized a repo, staged a change, wrote `Intended message` to a shared `commitmsg.txt`, overwrote that same file with `Other session message` to simulate a second session, and ran `git commit -F <shared-file>`. `git log -1 --format=%B` showed `Other session message`. This would have been disproven if Git captured the first content earlier, detected an external overwrite, or warned about message provenance; it did none of those.\n\nSUGGESTED FIX DIRECTION\nRecord guidance that commit-message bodies and all scratch files must be per-session/per-job unique, never fixed shared paths. Add a low-noise guard in `make amend-msg`/`scripts/amend_commit_message.py` that rejects or warns on fixed shared scratch paths, while allowing repo/session-local files and genuinely unique `mktemp`-style paths. Sweep fixed `/tmp` documentation/scripts separately and classify unique templates vs collision-prone fixed names.","timestamp":1788737324670372001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review PASS. Starting TDD fix in a fresh worktree; RCA sanity-check: fixed shared scratch path is a silent last-writer-wins commit-message collision, so a low-noise unique/per-session path guard and guidance update are appropriate.","timestamp":1788737853721498001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Worktree fix2-gigantic created from origin/main. Beginning RED test for fixed shared commit-message scratch path per RCA.","timestamp":1788737892975975001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RED confirmed: tests/unit/test_amend_msg_change_id.py::test_fixed_tmp_message_file_is_refused_before_git_can_read_it failed because /tmp/commitmsg.txt was accepted as an ordinary missing file. GREEN confirmed after adding the production guard and guidance updates: tests/unit/test_amend_msg_change_id.py passed (11 tests).","timestamp":1788738045334188001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Committed fix in worktree fix2-gigantic: 16b95fd42887. verify-commit-ticket passed. Fixed-/tmp sweep disposition: direct commit-message guard added for files directly under /tmp or /var/tmp; unique mktemp/template and ticket-stamped directories left alone; operational runbooks with fixed /tmp examples are documentation-only and not concurrent agent commit-message helpers.","timestamp":1788738200706176001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Origin/main has not mirrored Gerrit submit yet, but Gerrit reports change 2727 MERGED. Using the merged patch-set ref edc0a75f1e1d3cb4ed9bb601034ddbad48bd0bf5 for completion verification rather than resetting any shared checkout.","timestamp":1788744327234698001}],"completion_expectation":"required","created_at":1788590567613373001,"creation_channel":"cli","deps":[{"link_uuid":"78c99779-15d0-4487-8390-3c6719fe7b5f","relation":"relates_to","target_id":"a43a-dd44-7e24-4785"}],"description":"## The near-miss\n\nAn agent preparing Gerrit change 2665 staged its commit message at the fixed path\n`/tmp/commitmsg.txt`. A concurrent session working in `/Users/joeoakhart/windows-lock-s1` wrote to\n**the same path**. The agent's `git commit -F /tmp/commitmsg.txt` then picked up the OTHER\nsession's message body — \"Give the store write lock a Windows leg\" — and attached it to its own,\ncompletely unrelated diff (EBS mount assertions in `infra/terraform/user_data.sh`).\n\nIt was caught only because the agent read the commit back before pushing. It recovered with\n`make amend-msg` (Change-Id preserved, so no duplicate change) and switched to a `mktemp -d` path.\n\n## Why this is worth a ticket rather than a shrug\n\nHad it not read the commit back, a Gerrit change would have gone up for review carrying a **false\ndescription of what it does**. Reviewers, the `rebar-ticket:` trailer audit, `git log`, and every\nfuture bisect would all have agreed with each other and all been wrong. That is the same defect\nclass this session has spent the night filing — an artefact asserting something that was never\ntrue — except lodged in the permanent commit record rather than in a check.\n\nThe conditions that produced it are not exotic. This host currently runs **eleven active\nworktrees** across several concurrent agent sessions, all as the same OS user, all with `/tmp`\nshared. A fixed filename under `/tmp` is not a race that might happen; it is a collision waiting\nfor two sessions to reach the same step, which on a busy night is minutes apart.\n\nNote the asymmetry that makes it dangerous: the collision is SILENT. `git commit -F` succeeded,\nexit 0, no warning. Nothing distinguishes \"my message\" from \"someone else's message\" at the point\nof use — only a human or agent reading the result back can tell.\n\n## Scope — this is about guidance and tooling, not one agent\n\nThe agent that hit it did the right things (read back, recovered without a duplicate change,\nswitched to `mktemp -d`, disclosed it prominently). The question is why a fixed `/tmp` path was\nreachable at all:\n\n- this session's own operating convention is a per-job scratch directory precisely for this\n  reason, and that convention lives in the harness prompt rather than anywhere an agent working\n  from repo guidance would find it;\n- `CONTRIBUTING.md` / `AGENTS.md` document `make amend-msg` for message rewrites but say nothing\n  about WHERE to stage a message body;\n- nothing in the repo's tooling refuses or warns on a shared-`/tmp` path.\n\n## Acceptance criteria\n\n- [x] Repo guidance states plainly that any scratch file — commit message bodies especially — must\n      go in a per-session directory (`mktemp -d`, or the session's own scratch dir), never a fixed\n      path under `/tmp`, because multiple agent sessions share this host as one OS user.\n- [x] The reasoning is recorded with the guidance, not just the rule: the failure is SILENT and\n      lands in the permanent commit record. A rule without its reason gets optimised away.\n- [x] Consider whether `make amend-msg` and any commit-message helper should reject a path under\n      `/tmp` that is not session-unique, or at minimum warn. Decide either way and record why —\n      a guard is only worth adding if it cannot itself become noise.\n- [x] Sweep the repo's scripts and documented workflows for other fixed `/tmp` paths that two\n      concurrent sessions could collide on, and record each with a disposition. Enumerate the\n      result; do not fix only the commit-message case.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","a43a-dd44-7e24-4785"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"de1c801b-73b1-497a-9013-a01ebe2b6497","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"919d-7994-3ac7-4d0f","ticket_type":"bug","title":"A fixed /tmp path let one session's commit message land on another session's diff: change 2665 nearly went to review carrying a false description, caught only by reading the commit back","verify_commands":[]},"source_event_uuids":["7d7e7494-3ade-423a-b8fe-35929bb0bcc7","93b8eead-604a-4bb6-a9e8-3e0d7a5c8afe","896908c8-7e8a-4b0a-bcb3-e45aca93eddd","0c424659-7e59-4d1d-b0f9-d84b72548dcb","4ba16746-a198-429c-829d-22bec38e0095","a0972752-696b-48d6-b442-b61b179e6fd8","81cb6e3d-d92b-4aa5-8f0e-2f222f8994b1","73a1e066-0a46-459f-8887-d0906552d3b5","78c99779-15d0-4487-8390-3c6719fe7b5f","d08bc3fc-b47c-433e-a35b-178132fc6867","4f0ff530-da70-40f7-897e-ae024e232f1c","de1c801b-73b1-497a-9013-a01ebe2b6497","b411a96e-213e-4beb-975d-2ea443f1b0c6"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788751240398978001,"uuid":"56cb0181-6fef-4933-b6f7-8970aed88520"}