{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"schedule homogeneous outbound create plans before the legacy loop and merge their tally into the pass manifest"},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"surface create-route completion signals on batch create outcomes for the scheduler"},{"path":"src/rebar/_engine/rebar_reconciler/apply_outbound.py","reason":"keep the typed create adapter completion signal surface aligned with the batch route"},{"path":"src/rebar/_engine/rebar_reconciler/batch_dispatch.py","reason":"order outbound creates by dependency, defer blocked children, and preserve pass-tally accounting"},{"path":"src/rebar/_engine/rebar_reconciler/create_route.py","reason":"expose the coordinated create outcome to the batch handler without re-running the route"},{"path":"src/rebar/_engine/rebar_reconciler/mutation_payloads.py","reason":"preserve outbound create prerequisite metadata on the typed payload round trip"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"carry local-id create prerequisites on raw outbound mutations"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py","reason":"derive parent-create prerequisites in local-id space for unbound child creates"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_pass.py","reason":"preserve create prerequisite metadata when converting raw outbound creates to typed mutations"},{"path":"tests/unit/rebar_reconciler/mutate/test_create_live_cutover_heldout.py","reason":"prove batch create scheduling orders parent before child and defers unknown-parent creates without a vendor call"},{"path":"tests/unit/rebar_reconciler/mutate/test_mutation_payloads.py","reason":"prove typed outbound create payloads round-trip prerequisite metadata"},{"path":"tests/unit/rebar_reconciler/mutate/test_outbound_create_binding.py","reason":"prove the create builder emits local-id prerequisites only for unbound parent creates"},{"path":"tests/unit/rebar_reconciler/mutate/test_outbound_pass_typed_payload_cutover.py","reason":"prove create prerequisite metadata survives the typed cutover but stays out of Jira vendor fields"}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"FILE_IMPACT","timestamp":1788452936229558001,"uuid":"3d04f500-6e90-41c7-80d2-0fb6e1741f94"}