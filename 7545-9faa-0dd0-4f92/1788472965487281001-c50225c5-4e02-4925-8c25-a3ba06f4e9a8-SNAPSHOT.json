sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1b57ae9114516f80d086c1916c2075b4c62062388811a6c6f387aca38dc6c15b","event_uuid":"9a32bc8d-accc-4589-99ec-011ccd0be722","position":{"commit_sha":"ad42366ca64291f77e6882484cf2eee5816ee725","position":"1788458639849919579-9a32bc8d-accc-4589-99ec-011ccd0be722"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"43d0b1474dbab3c688f401e807b63cdb8a24a2b6b9f88755b7cf1d5e81e2d4ae","event_uuid":"2113c614-0ec0-4971-92cc-eb9ffa604b64","position":{"commit_sha":"8b672233e46819fc5d028be4b3757076a4110c1e","position":"1788461031366041001-2113c614-0ec0-4971-92cc-eb9ffa604b64"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e7de4a86216f6742d88eb0f753c62f21158983d671be8600d530d3d08969aea3","event_uuid":"fe6a033d-e14a-439c-97f2-3235c2d0dc47","position":{"commit_sha":"b4ae95ca79736d29afcbbbfd545c2c2b6e64fb32","position":"1788461365032751001-fe6a033d-e14a-439c-97f2-3235c2d0dc47"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fb7162e3584bb2f61a3dc2e2de8ef36ba09ee1bad2eb44f3ff28db50b77f11b5","event_uuid":"5e996d97-8a7f-4cb2-ab27-06f798f7c353","position":{"commit_sha":"6633b4fedfea2a9012da791b7958a09f31891a87","position":"1788461372896381001-5e996d97-8a7f-4cb2-ab27-06f798f7c353"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788313665159105001,"creation_channel":"cli","deps":[{"link_uuid":"9a32bc8d-accc-4589-99ec-011ccd0be722","relation":"relates_to","target_id":"dae3-3f07-712c-4d35"}],"description":"## Context / Problem\n\n`ticket_planner.py:74-82,192` recognizes `requires_create` and `requires_parent`, but production outbound CREATEs never carry either value. The current emission path is `_compute_outbound_create_mutation` in `outbound_mutation_builders.py:122-173`, then `outbound_pass.py:257-269`, which converts the raw `OutboundMutation` to a typed `Mutation` whose `target` is `om.local_id`. `OutboundCreatePayload` has no prerequisite fields, so metadata added only to the raw builder would be lost before the planner sees it.\n\nThe planner is not yet authoritative for CREATEs. `batch_dispatch.reroute_migrated_plans` deliberately excludes create actions, and `create_route` coordinates only one create/containment sequence. The live batch consumption point is `apply_handlers.handle_create` (with the sibling typed-create route in `apply_outbound.py`); `create_route.should_hold_dependent` currently has no production caller. Thus ordering requires a new per-pass create scheduler at the batch sequencer, not a claim that the existing single-create coordinator already orders parent and child creates.\n\n## Approach\n\nUse local ticket IDs for all prerequisite and provider identities. An outbound create has `Mutation.target == om.local_id`, which is also its `TicketPlan.identity`; a prerequisite must never name a Jira key for an unbound ticket.\n\nDerive a prerequisite only for a real local parent/create edge in `outbound_mutation_builders`, carry it on `OutboundMutation`, and model it explicitly on `OutboundCreatePayload`. Preserve it in the `outbound_pass` conversion as top-level mapping metadata visible to `ticket_planner._collect_dependencies`. `batch_dispatch._mutation_to_batch_dict` must exclude this scheduler-only metadata from Jira vendor fields.\n\nAdd a focused per-pass create-scheduling seam, owned by the batch application path, for homogeneous outbound-create `TicketPlan`s. It receives the finalized plans and their legacy batch mutations, uses the existing planner dependency order, and dispatches each selected create through the existing `apply_handlers.handle_create` → `create_route` path exactly once. It translates the selected route’s terminal result into a provider outcome: only a confirmed create whose containment releases dependents marks its local ID successful; permanent, `commit_unknown`, budget-deferred, or unconfirmed containment outcomes hold dependents as `dependency_deferred`. It records those outcomes in the existing manifest/tally shape, removes only consumed creates from the following legacy loop, and leaves mixed/non-create plans on their established paths.\n\nRefactor the batch create adapter and the typed `apply_outbound` create adapter to expose the same structured create-route completion signal (`confirmed` / `dependents_released`) without a second Jira call or a second routing selector. This keeps `create_route` the owner of one-create persistence, containment, and rollback selection while the new scheduler owns only inter-create ordering.\n\n## Scope\n\n- `src/rebar/_engine/rebar_reconciler/outbound_differ.py` — raw `OutboundMutation` prerequisite carrier\n- `src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py` — derive parent/create prerequisite local IDs\n- `src/rebar/_engine/rebar_reconciler/outbound_pass.py` and `mutation_payloads.py` — preserve typed payload metadata and its mapping round trip\n- `src/rebar/_engine/rebar_reconciler/ticket_planner.py` — retain/document local-ID dependency and provider semantics\n- a new create-ordering sibling (or equivalent focused existing-seam extraction) plus `applier.py` — schedule eligible create plans before the legacy mutation loop and preserve manifest/tally accounting\n- `apply_handlers.py`, `create_route.py`, and `apply_outbound.py` — expose and consume the single create-route completion signal at both live create consumption points\n- `batch_dispatch.py` — batch projection and removal of scheduler-only metadata from Jira fields\n- focused outbound-payload, planner, create-scheduler, handler/route, and operation-coordinator tests\n\n## Testing\n\nExercise the full builder → typed payload → planner → per-pass create-scheduler → `handle_create`/`create_route` path with parent and child initially unbound. Cover confirmed parent success, permanent failure, `commit_unknown`, budget defer, unconfirmed containment, an already-bound parent, an unknown local parent, unrelated creates, and the vendor-field boundary. Assert local IDs—not Jira keys—at every provider/dependency edge, exactly one create-route execution per selected mutation, and no duplicate dispatch through the legacy loop.\n\n## Acceptance Criteria\n\n- [x] The create builder emits a prerequisite only for a real local parent/create edge, using the parent local ticket ID and never inventing a Jira key for an unbound parent.\n- [x] The raw `OutboundMutation`, `OutboundCreatePayload`, and `outbound_pass` conversion preserve each prerequisite as planner-visible metadata; `_mutation_to_batch_dict` excludes it from Jira vendor fields.\n- [x] Each provider create has `Mutation.target` equal to the local ID advertised to dependents, and planner tests prove that this identity resolves without a local-ID↔Jira-key conversion.\n- [x] The batch sequencer selects eligible homogeneous outbound-create plans, executes them in planner dependency order through `apply_handlers.handle_create` and the single selected `create_route`, then removes only those executed/deferred creates from the legacy loop.\n- [x] A confirmed parent create releases its child only after the parent’s matching local-ID-to-Jira binding and containment are confirmed; the child is dispatched once through the same route.\n- [x] A permanent failure, `commit_unknown`, REST-budget defer, or unconfirmed containment holds the dependent as `dependency_deferred` and makes no child vendor-create call.\n- [x] The batch and typed create adapters expose equivalent `confirmed`/`dependents_released` completion signals without dual-send or a second route selector.\n- [x] An already-bound parent local ID satisfies the dependency without a new parent create; an unknown local parent ID is `dependency_deferred`; unrelated creates retain their existing behavior.\n- [x] Focused payload, planner, scheduler, handler/route, and operation-coordinator suites pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"schedule homogeneous outbound create plans before the legacy loop and merge their tally into the pass manifest"},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"surface create-route completion signals on batch create outcomes for the scheduler"},{"path":"src/rebar/_engine/rebar_reconciler/apply_outbound.py","reason":"keep the typed create adapter completion signal surface aligned with the batch route"},{"path":"src/rebar/_engine/rebar_reconciler/batch_dispatch.py","reason":"order outbound creates by dependency, defer blocked children, and preserve pass-tally accounting"},{"path":"src/rebar/_engine/rebar_reconciler/create_route.py","reason":"expose the coordinated create outcome to the batch handler without re-running the route"},{"path":"src/rebar/_engine/rebar_reconciler/mutation_payloads.py","reason":"preserve outbound create prerequisite metadata on the typed payload round trip"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"carry local-id create prerequisites on raw outbound mutations"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_mutation_builders.py","reason":"derive parent-create prerequisites in local-id space for unbound child creates"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_pass.py","reason":"preserve create prerequisite metadata when converting raw outbound creates to typed mutations"},{"path":"tests/unit/rebar_reconciler/mutate/test_create_live_cutover_heldout.py","reason":"prove batch create scheduling orders parent before child and defers unknown-parent creates without a vendor call"},{"path":"tests/unit/rebar_reconciler/mutate/test_mutation_payloads.py","reason":"prove typed outbound create payloads round-trip prerequisite metadata"},{"path":"tests/unit/rebar_reconciler/mutate/test_outbound_create_binding.py","reason":"prove the create builder emits local-id prerequisites only for unbound parent creates"},{"path":"tests/unit/rebar_reconciler/mutate/test_outbound_pass_typed_payload_cutover.py","reason":"prove create prerequisite metadata survives the typed cutover but stays out of Jira vendor fields"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","78f2-b104-e3c9-4b86"],["relates_to","dae3-3f07-712c-4d35"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"fe6a033d-e14a-439c-97f2-3235c2d0dc47","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"closed","tags":["janitor","reconciler","ordering","rp19"],"ticket_id":"7545-9faa-0dd0-4f92","ticket_type":"story","title":"Emit and enforce reconciliation create-order dependency metadata","verify_commands":[]},"source_event_uuids":["59c42aeb-fe01-4e7f-8d69-cb581fda233c","373e1d5a-a014-434f-bca8-799fb72c4148","9e49b993-b198-4e01-8647-8d5f81c2c7d8","5049ef5d-a4ab-492c-b6bf-711733e41acc","01a70984-c5ec-4ec7-86f7-70c6032fa822","7acb9f1e-2897-42b5-8ea7-7af182946657","f9f996b9-54a2-412f-8ddf-38f6d2448338","3d04f500-6e90-41c7-80d2-0fb6e1741f94","c7ed94fb-fc0e-413e-92fd-75088010c587","9a32bc8d-accc-4589-99ec-011ccd0be722","2113c614-0ec0-4971-92cc-eb9ffa604b64","fe6a033d-e14a-439c-97f2-3235c2d0dc47","5e996d97-8a7f-4cb2-ab27-06f798f7c353"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788472965487281001,"uuid":"c50225c5-4e02-4925-8c25-a3ba06f4e9a8"}