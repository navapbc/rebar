ures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c56cb324e3613275b3112854da508e35390216cc676248f825823757db90bf50","event_uuid":"c81568cd-f09b-4569-b154-948a1ea257df","position":{"commit_sha":"55ea1ce0e34b607a0ba7a6d2e3ec24f793c5351b","position":"1788375728294781870-c81568cd-f09b-4569-b154-948a1ea257df"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f40ecb31e3c82c67be29dc044a5d1ee936d935b07adc222f8e69226068f35308","event_uuid":"dead6d78-c04d-4ebb-b6cc-689f13f05b66","position":{"commit_sha":"e0d5c4827a5552d0dd5916381d84d70e000adc79","position":"1788375728933429537-dead6d78-c04d-4ebb-b6cc-689f13f05b66"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0c9b6b5b8c712743548346da64c8a8bb2e497dac71b7ee530d6b8cc1c1ae1fa1","event_uuid":"715d466a-c049-4c38-9ab0-1bfa54685ed2","position":{"commit_sha":"013f152f5df17e39224c71f4d72a98ce3c66f938","position":"1788375729029853159-715d466a-c049-4c38-9ab0-1bfa54685ed2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"173fa4a1fb9ef61b2635ed1d1261fb7fc14c4c6135ae9265dfacad4fc53f7750","event_uuid":"45735355-0cf8-46d6-adb8-85aa3bdf023a","position":{"commit_sha":"69c982238dbc5b7f244e2f14e988c57ff0860cf8","position":"1788375841849722498-45735355-0cf8-46d6-adb8-85aa3bdf023a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d4cf636e05b95514f54329c0a6c54d60dac8095da8de7dd26d955e33d7b46ef7","event_uuid":"c612b082-9400-49dd-92bf-3f52aa64aaa5","position":{"commit_sha":"2d1c4d98c65b35e1645c09c7dd7ffc131904bcfb","position":"1788375888493354039-c612b082-9400-49dd-92bf-3f52aa64aaa5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d8484b23520d775b0a0cdc61fbd4e87b29ea325be270e1841f7fab4387cabb9d","event_uuid":"41c57153-f0ea-461b-9390-bf7675bdc13a","position":{"commit_sha":"714d5af79d58ecb06b6d06efc8fcefa7df33d637","position":"1788376362610502406-41c57153-f0ea-461b-9390-bf7675bdc13a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788375027121548733,"creation_channel":"mcp","deps":[],"description":"# S3 — Bound journald storage and alarm on journal saturation\n\n## Why\nJournald is a root-volume accumulator because compose services send logs to the host journal. The incident measured journal growth, and aggregate root alarms do not identify journal saturation.\n\n## What\nInstall managed journald configuration such as `/etc/systemd/journald.conf.d/rebar-disk-ceiling.conf` with an explicit persistent journal ceiling (`SystemMaxUse` and, where useful, `SystemKeepFree`). Extend observability to publish journal usage relative to cap and add a dedicated CloudWatch alarm.\n\n## Scope\nIn scope: host journald config installation/reload, observability metric, Terraform alarm, runbook text, and tests. Out of scope: changing compose logging driver, review scratch placement, Docker build-cache cap, `/var/tmp`, and container-layer reaping.\n\n## Grounding\n- Current observability publishes only aggregate data/root disk metrics: `infra/scripts/observability.sh:72-90`.\n- Compose uses journald logging blocks in `infra/compose/docker-compose.yml`.\n- systemd-journald docs: `SystemMaxUse` controls maximum persistent journal disk usage under `/var/log/journal`, and journald respects the smaller of `SystemMaxUse`/`SystemKeepFree`.\n\n## Acceptance Criteria\n- [ ] Managed journald config sets an explicit disk ceiling and installs idempotently on the Gerrit host.\n- [ ] Observability emits a journald usage/cap metric testable without live CloudWatch.\n- [ ] Terraform adds a dedicated journald saturation alarm wired to SNS.\n- [ ] Runbook documents journal cap, alarm, diagnosis (`journalctl --disk-usage` or equivalent), and safe remediation.\n- [ ] Targeted tests cover generated config, metric emission, and alarm wiring.\n- [ ] Portability criterion: uses systemd-journald native config and local shell/Python tests; no provider-specific CI trigger is required.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"infra/scripts/compose-up.sh","reason":"Install managed journald drop-in if common host disk-ceiling installer is not introduced."},{"path":"infra/scripts/install-disk-ceilings.sh","reason":"Potential new host provisioning helper for journald disk ceiling config."},{"path":"infra/scripts/observability.sh","reason":"Publish journald usage/cap metric."},{"path":"infra/terraform/monitoring_autodeploy.tf","reason":"Add journald saturation CloudWatch alarm."},{"path":"infra/runbooks/review-bot-ops.md","reason":"Document journald cap/alarm/remediation."},{"path":"tests/scripts/test_observability_disk_pressure.py","reason":"Cover journald metric emission."},{"path":"tests/unit/test_alarm_actions_terraform.py","reason":"Assert new alarm action wiring."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["blocks","2ba3-bf77-1303-4b2d"],["blocks","7dfa-18ca-9c04-4691"],["blocks","9183-aaae-667d-45e6"],["blocks","aa40-cbda-ee38-481c"],["parent","6202-e1c7-c57f-4897"]],"no_file_impact_reason":"","parent_id":"6202-e1c7-c57f-4897","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"open","tags":["infra","gerrit","disk-ceiling","journald"],"ticket_id":"e956-b1c3-45b9-4016","ticket_type":"story","title":"S3 — Bound journald storage and alarm on journal saturation","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/scripts/test_observability_disk_pressure.py tests/unit/test_alarm_actions_terraform.py","dd_id":"AC2","dd_text":"Journald metric and alarm are covered."},{"command":"terraform -chdir=infra/terraform validate","dd_id":"AC3","dd_text":"Terraform syntax remains valid."}]},"source_event_uuids":["ad24170a-f3a8-4ef9-87e8-1800f5f56423","4b5f8f17-08a5-4bb4-863f-98a9387c516b","ebb69705-e6f6-4b6b-85ab-f3a3dbf81777","f1d66c74-e5db-4a55-b74a-09bb538fb463","8f8ed416-d5f8-446d-9e41-29af14b5bef6","bef6e7b1-7695-42d2-9876-2a72f8c1643c","f0059998-b9ac-4a26-a82b-757841f3be70","2c3d14f6-ccc3-4339-bceb-6be082a4437d","c81568cd-f09b-4569-b154-948a1ea257df","dead6d78-c04d-4ebb-b6cc-689f13f05b66","715d466a-c049-4c38-9ab0-1bfa54685ed2","45735355-0cf8-46d6-adb8-85aa3bdf023a","c612b082-9400-49dd-92bf-3f52aa64aaa5","41c57153-f0ea-461b-9390-bf7675bdc13a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788378927257006001,"uuid":"bf1cd117-1433-44dd-adfc-d6336c71e822"}