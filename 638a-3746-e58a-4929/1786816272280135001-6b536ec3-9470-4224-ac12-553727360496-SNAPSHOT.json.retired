mmit_sha":"b583547ad8621ea884d0fbed7c202d04eec902b0","position":"1786808315626180001-8a54ff8e-5b65-40a3-bf5d-dffcf1e732a5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e741df2dbf5b4b253f2a1c54da459d61e3e9e18d04d5f4625c7fccd98de6e2d4","event_uuid":"b8fba368-a779-4cd6-8299-4d86bd8d7582","position":{"commit_sha":"774dfd0fe813124ee33ec5df7f35e95ef59be4a0","position":"1786808435547542001-b8fba368-a779-4cd6-8299-4d86bd8d7582"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3baa823711c1c75eb937ed83e9d7fac12c5a12a99ef2d61fc22b303f3868a3b7","event_uuid":"77eb020d-085d-4beb-aa20-a38b2f49075b","position":{"commit_sha":"e321947a60604bad5f1ee92143b36eddeab83acc","position":"1786808449243716001-77eb020d-085d-4beb-aa20-a38b2f49075b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"acd2f6d4699a81f4fa0730c4d2ff2ee92e7eb6d5c6b09649871e3378bc0658c5","event_uuid":"c0e14e4d-e489-4d85-8642-acf05dcb4a98","position":{"commit_sha":"a62c11f13238d49575f30d01090ae2b179e8f10c","position":"1786808459508141001-c0e14e4d-e489-4d85-8642-acf05dcb4a98"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1b65939fc591b76386d85ca5d79b40550fb73ce8f81813af8599ba3e82b94dfd","event_uuid":"640d21be-d232-418c-ac81-600b0e7d4158","position":{"commit_sha":"c5b914a9006e8cb09ff64c872073778fc74a254b","position":"1786808464910924001-640d21be-d232-418c-ac81-600b0e7d4158"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3eba1b47509e70da586ece4bc31747a362499ad76be2a45f6568f38d5edec2ff","event_uuid":"ff26d924-8290-498c-a116-607ed0fe3422","position":{"commit_sha":"cea164307c58ad217dd31ec3cc72642075514297","position":"1786808765735495001-ff26d924-8290-498c-a116-607ed0fe3422"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Archaeology (why the existing gate missed these): scripts/check_raw_git_writes.py (policy d37e, commit 6739ea54fa) passes CLEAN on the current tree. Its policy sanctions git_adapter.py/_ref_lock.py at MODULE granularity, so callers composing the exported primitives (git_adapter.add at reconcile_helpers.py:226 + git_adapter.commit at :246 — no lock, no atomic commit+push) are approved call-by-call. Gate enforces the mechanism rule (no raw subprocess git) but not the protocol rule (mutations via the atomic transaction). Fix = R3 composition rule in the EXISTING checker; description rewritten accordingly.","timestamp":1786808315626180001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Sequencing (operator, 2026-08-15): land the R3 gate AFTER the parallel session's remediations land — cubiform-wooden-fruitbat (bridge-state writes) and gnatty-comparable-ynambu (binding-store snapshot + alert_store) — recorded as blocked_by links. Rationale: landing R3 first would require reasoned markers on exactly the sites those tickets are deleting (merge-conflict churn in reconcile_helpers.py and friends); landing after means R3's first run should enumerate ZERO out-of-transaction sites (or only ones with a durable reason), making the gate land clean with no debt baseline. Do not claim until both blockers close.","timestamp":1786808435547542001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Sequencing (operator, 2026-08-15): land the R3 gate AFTER the parallel session's remediations land — cubiform-wooden-fruitbat (bridge-state writes) and gnatty-comparable-ynambu (binding-store snapshot + alert_store) — recorded as depends_on links (blocking). Rationale: landing R3 first would require reasoned markers on exactly the sites those tickets are deleting (merge-conflict churn in reconcile_helpers.py and friends); landing after means R3's first run should enumerate ZERO out-of-transaction sites (or only ones with a durable reason), so the gate lands clean with no debt baseline. Do not claim until both blockers close.","timestamp":1786808464910924001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"R3 dry-run enumeration (2026-08-15, grep sweep of all sanctioned-primitive callers): (1) reconcile_helpers.py:226/246 git_adapter.add+commit — covered by blocker gnatty-comparable-ynambu. (2) bridge-state projects_store + alert_store._atomic_write — covered by blocker cubiform-wooden-fruitbat. (3) ONE additional site NOT covered by either blocker: rebar_reconciler/__main__.py:315-355 legacy .reconciler-* lock-file purge — composes read_tree/rm_cached/write_tree/commit_tree/update_ref in a DETACHED temp index with a CAS ref-advance. Concurrency-safe by construction (never touches worktree/index; CAS makes concurrent writers safe), so it needs NO pre-gate remediation: disposition at implementation time is either a durable reasoned marker (detached-index CAS migration) or promotion into git_adapter as a named transaction helper — or outright deletion if the legacy-lock migration is complete by then. (4) _commands/{txn,compact_txn,compact_recovery,delete,init}.py run_git_write callers are store-seam transaction internals per policy d37e — they join R3's sanctioned entry set, not remediation. (5) Workflows clean: only 'git worktree add' setup lines; zero raw-git-ok markers in .github/workflows or scripts/*.sh.","timestamp":1786808765735495001}],"created_at":1786808157806881001,"creation_channel":"cli","deps":[{"link_uuid":"b8f7bc95-a70e-46c4-96d1-4245e7c80794","relation":"discovered_from","target_id":"6ccc-0577-198c-44fa"},{"link_uuid":"8b9564a4-af02-432f-90b7-5a85f3b591a0","relation":"relates_to","target_id":"e72e-259d-5ee7-4e73"},{"link_uuid":"77eb020d-085d-4beb-aa20-a38b2f49075b","relation":"depends_on","target_id":"fea4-f98c-f1a2-4168"},{"link_uuid":"c0e14e4d-e489-4d85-8642-acf05dcb4a98","relation":"depends_on","target_id":"6454-d06e-7361-4e3d"}],"description":"## Archaeology: the gate EXISTS — the gap is sanction granularity\n`scripts/check_raw_git_writes.py` (policy d37e-4f64-3265-4f30 / empirical-inhuman-urus, landed 6739ea54fa, wired in `_build-and-test.yml:172`) already gates raw git writes: AST layer P over src/+scripts, workflow layer W, inline `# raw-git-ok: <reason>` sanction, fail-closed opaque-argv. It passes CLEAN on the current tree — so the hand-rolled reconciler operations a parallel session found are NOT violations under its policy.\n\nWhy it missed them: the policy sanctions the reconciler seam at MODULE granularity — all of `git_adapter.py` and `_ref_lock.py` are \"write seam internal\". `git_adapter` exports low-level PRIMITIVES (`add`, `commit`, `commit_email`, `commit_tree`) as sanctioned wrappers, so any caller may COMPOSE them into a hand-rolled non-atomic sequence and the gate approves every call. Proven instance: `reconcile_helpers.py:226` (`git_adapter.add`) + `:246` (`git_adapter.commit`) — inline stage+commit against the tickets tracker with no lock and no atomic commit+push transaction. The gate enforces the MECHANISM rule (\"no raw subprocess git\") but not the PROTOCOL rule (\"tracker mutations go through the atomic locked commit+push transaction\"), so bypasses of the atomic seam are invisible to it by design.\n\n## Fix: add a composition rule (R3) to the existing checker — not a new checker\n1. In `check_raw_git_writes.py`, add rule R3: a call to a sanctioned git-wrapper module's MUTATION PRIMITIVES (`add`, `commit`, `commit_email`, `commit_tree`, ref-planting writes) from OUTSIDE the atomic-transaction functions fires, unless the call site carries `# raw-git-ok:` with a reason. The sanctioned entry points become the atomic transaction seams themselves (the locked write-transaction functions in `_store` and the reconciler's `_ref_lock` transaction), not every export of the wrapper modules.\n2. Enumerate today's out-of-transaction composition sites from the new rule's first run; sanction each with an inline reasoned marker referencing the parallel session's remediation ticket, so the debt is visible in-tree and drains as that session lands (marker removed with each fix).\n3. Keep the existing marker/fail-closed semantics — no allowlist file, reason mandatory.\n4. Tests in `tests/unit/test_raw_git_write_lint.py`: composed add+commit outside a transaction fires R3; the same calls inside the sanctioned transaction functions do not; marker-with-reason sanctions; marker-without-reason fails.\n\n## Non-goals\nRemediating the existing composition instances (the parallel session owns those; our markers reference their ticket); changing git_adapter's API; runtime interception.\n\n## Acceptance criteria\n- [ ] R3 exists in `scripts/check_raw_git_writes.py`: out-of-transaction calls to sanctioned wrapper mutation primitives are flagged; sanctioned-transaction internals are not.\n- [ ] Today's composition sites are enumerated by the rule and carry reasoned inline markers referencing the remediation ticket (no silent allowlist).\n- [ ] Unit tests cover: R3 fires on composed add/commit outside a transaction; does not fire inside sanctioned transaction functions; marker semantics (reasoned passes, reasonless fails).\n- [ ] Checker passes on the current tree with the markers in place; CI wiring unchanged (`_build-and-test.yml` already runs it).\n- [ ] `make lint` / `make typecheck` clean; lands via Gerrit (LLM-Review +1, Verified +1).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"scripts/check_raw_git_writes.py","reason":"add composition rule R3"},{"path":"tests/unit/test_raw_git_write_lint.py","reason":"R3 tests"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"inline reasoned markers on existing composition sites"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","6454-d06e-7361-4e3d"],["depends_on","fea4-f98c-f1a2-4168"],["relates_to","e72e-259d-5ee7-4e73"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"638a-3746-e58a-4929","ticket_type":"task","title":"Gate: shrink-only ratchet forbidding tracker git mutations outside the _store seam","verify_commands":[]},"source_event_uuids":["37fec376-eea8-4fa9-ad59-5656c720163b","b8f7bc95-a70e-46c4-96d1-4245e7c80794","8b9564a4-af02-432f-90b7-5a85f3b591a0","67883e5c-eb22-48ec-a19f-6413003a31b2","b85241b9-191f-4712-960a-31b1eeb8f0cd","750ae032-7a7c-4dca-b023-44550ba3ef2a","8a54ff8e-5b65-40a3-bf5d-dffcf1e732a5","b8fba368-a779-4cd6-8299-4d86bd8d7582","77eb020d-085d-4beb-aa20-a38b2f49075b","c0e14e4d-e489-4d85-8642-acf05dcb4a98","640d21be-d232-418c-ac81-600b0e7d4158","ff26d924-8290-498c-a116-607ed0fe3422"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786816272280135001,"uuid":"6b536ec3-9470-4224-ac12-553727360496"}