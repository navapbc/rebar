{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787176615974287002,"compiled_state":{"alias":"forgetful-grusome-puma","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"0b851c81032aa1a2032296848b4e091d171abb34","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 638a-3746-e58a-4929","material: 0ba0adc0a7ed8931","material-part: children 647ea2107ca5072f 0","material-part: description 7f3bc0c8c7db9ee3 7932","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact ea372aaec2b94ae4 3","material-part: ticket_id afc97bb32fbf200b 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (0b851c8103)","regver: 1da3feeb7c09e17f","verified-at-sha:0b851c81032aa1a2032296848b4e091d171abb34","plan-material-pin: prerequisite 6454-d06e-7361-4e3d 06a50605e2ac9327","plan-material-pin: prerequisite fea4-f98c-f1a2-4168 f9dcc9a4f9673e67","dep cd62da470086e695698060bba35a79a9ebf1ef66ad6a11de4bf39624b8838e30 scripts/check_raw_git_writes.py","dep 58e781f71b3bea9a6bc6c3e225a5e113f9b004ec40fa1721ab59c79be51c11a3 src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","dep 09fd847f83fe2189e2763024d6dee29b1d9057bb1355ef99da0d5a2f4eec3908 tests/unit/test_raw_git_write_lint.py","read-set: 10","read-path: .github/workflows/_build-and-test.yml","read-path: scripts/check_raw_git_writes.py","read-path: src/rebar/_engine/rebar_reconciler/__main__.py","read-path: src/rebar/_engine/rebar_reconciler/_advisory_lock.py","read-path: src/rebar/_engine/rebar_reconcil