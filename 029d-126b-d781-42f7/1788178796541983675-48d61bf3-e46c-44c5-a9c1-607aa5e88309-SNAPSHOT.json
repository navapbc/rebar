{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788178796541983675,"compiled_state":{"alias":"byzantine-spinelike-penguin","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"005ecbbcf95f6aec21091f52febe24f60a671b28","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 029d-126b-d781-42f7","material: 5a3ab3042a918d99","material-part: children 647ea2107ca5072f 0","material-part: description 0684e8391e12144b 7888","material-part: description_boxes 4cf0c1012276f46a 8","material-part: file_impact 698c67d44e5fe73c 11","material-part: ticket_id 53b7951f75a2b6dc 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1 (005ecbbcf95f)","regver: aa61189569d34126","verified-at-sha:5697f2e11179a84f3a7ee03ce01c7110e52db8e9","plan-material-pin: prerequisite fc84-a6a6-14c3-4bc8 05ee6bec3d382f4c","dep ad36c8d5d7eed1cb0165a1d297102c4831a82b8bc7ef4aefe4c93db52f63ce2c CHANGELOG.md","dep 141f189e636f22e8dbe20a471004b80aac68375fd8cb04cfb80e28cee08be2cc docs/adr/0108-retire-severity-label.md","dep 3157edf488dffc3009d1d0b07cefd9808fc1955c432e73ee8d977bd19b69ebb7 docs/release-notes.md","dep 415965ed5cecb004de543607ad9f45a770a4e492277f0836ffd52c91ed750e2b src/rebar/llm/code_review/shim.py","dep 53afc85448043aabefb2f0f9fc9ce72a5db3463830dc4d07f921d525ae95d1dc src/rebar/llm/findings.py","dep 4ba65bc7b6ff9b13350f9b1bb96a59878de6a0bba21451af7ff48eca46a8c97a src/rebar/llm/review_kernel/decide.py","dep 7007720849c1ca2aaff3899262be7877e2ecfd5cde78a9b215c