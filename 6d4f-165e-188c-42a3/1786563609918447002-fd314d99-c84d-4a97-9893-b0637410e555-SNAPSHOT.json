{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786563609918447002,"compiled_state":{"alias":"splurgy-witless-flamingo","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"cc69cc117980e219909306cd094c6c903705c308","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6d4f-165e-188c-42a3","material: 49e3d2ecd0ce3475","material-part: children 647ea2107ca5072f 0","material-part: description c7f47c652cde73e4 6060","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact ab4eebe0ee1b4c48 2","material-part: ticket_id 833dd511fb252c19 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.11.0 (cc69cc117-dirty)","regver: 4f90349cd81c4911","verified-at-sha:cc69cc117980e219909306cd094c6c903705c308","dep a1bc043f6c347c888f3ba67e84b07835e45a1e190610806da59a669c39b6a1c4 src/rebar/_engine/rebar_reconciler/_ref_lock.py","dep 19ea90c5312b41ff93dda04fc075a601f30c91827bec74cf29e2c3db7c05a6e5 tests/unit/rebar_reconciler/state/test_ref_lock_push_classification.py","read-set: 3","read-path: src/rebar/_engine/rebar_reconciler/_loader.py","read-path: src/rebar/_engine/rebar_reconciler/_ref_lock.py","read-path: tests/unit/rebar_reconciler/state/test_ref_lock_push_classification.py","currency-basis: file_impact"],"material_fingerprint":"49e3d2ecd0ce3475","merged_log_commit":"cc69cc117980e219909306cd094c6c903705c308","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786558691919090000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":13,"unsigned":0},"authorship_ledger":[{"content_hash":"f716c7f29eebfce1fd51f2925cc5abb41af0f985afbe33ffc261553b2ad19aea","event_uuid":"293d9791-6119-452d-b20b-c81eb22f3eff","position":{"commit_sha":"bed033afac9fbb1d689161c0590cccc65560d2fc","position":"1786528695909395001-293d9791-6119-452d-b20b-c81eb22f3eff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8c0c04c9e10b7325947f95e273ce49d00d0f8e3fd299f8db2f7872f6e3c380a1","event_uuid":"4a6b3daf-7037-4466-aa30-195451ff02ab","position":{"commit_sha":"286481cd8a86d31669cb8dd42ce0f0f92d274374","position":"1786528705691353001-4a6b3daf-7037-4466-aa30-195451ff02ab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e79ca97d8444ef989d3d403f6da9718d7b39ed2b06f62a316aa8ce70d2687206","event_uuid":"99ff71ce-0081-4160-be24-e5d9e799a774","position":{"commit_sha":"d4d817a7ba12fd4fcd94b94c98a5f94985a113ed","position":"1786528717874777001-99ff71ce-0081-4160-be24-e5d9e799a774"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fa3e259856c5ea372e71af602de85bcbce0f6152dd56c69e0511b63352ca22e1","event_uuid":"6142f658-31ce-45db-ad77-376b87ac4602","position":{"commit_sha":"f664da6d1414f65c6aee2f03cb95b54e9aca1339","position":"1786558203417567001-6142f658-31ce-45db-ad77-376b87ac4602"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9d482c0e226869c15ff4884faac87aaea1308737951a49fe83723fa9f05b213a","event_uuid":"7215ea33-3e4e-4a96-93d5-117e2a6bbfe8","position":{"commit_sha":"db23d3250eed3544febf58b78fe6da31e5dfe0ce","position":"1786558501802791001-7215ea33-3e4e-4a96-93d5-117e2a6bbfe8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0b42dbdd14321c2e29702c8d87422b52b59207e6fe7b0f92bffadf2f946d6a2e","event_uuid":"29837ecd-2746-4259-bcf8-01d0b376168f","position":{"commit_sha":"85d5f74ead547586625f73d9afa96d6f2a69210a","position":"1786558691920020001-29837ecd-2746-4259-bcf8-01d0b376168f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8baac3188f3c7bb7e923f28d4efcfdbb855ee87603901709489214df5485d8cc","event_uuid":"e5aacfa8-1116-4de6-947c-3d463b544653","position":{"commit_sha":"3657c70208ba4a7b8517566768a9e35b46a4e8bb","position":"1786558791390231001-e5aacfa8-1116-4de6-947c-3d463b544653"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"