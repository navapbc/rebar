ciler","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["imported:reconciler-bootstrap"],"ticket_id":"jira-reb-3527","ticket_type":"story","title":"Enable MCP on AWS","verify_commands":[]},"source_event_uuids":["71e315ad-c6e2-490a-922b-3dc5b51f3c17"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787486794223524411,"uuid":"861846a7-6dae-423b-9943-f893cc5aef47"}