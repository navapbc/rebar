pplication/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d3f00ec5d4676ac99e6ed08e180df25a82b105c687a7d29b8947096f6b718bbf","event_uuid":"1aeed621-fe62-4606-9407-04a9ea1243ab","position":{"commit_sha":"f1a0487b9223af9f9426031bb4345320cb784250","position":"1786119844299497001-1aeed621-fe62-4606-9407-04a9ea1243ab"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d675b4a96bbeb813b2e57b76e2c3885f2c3df4fa3f68f72c2d68faa0b332924b","event_uuid":"d595524e-760d-4bd5-ad62-bf5338f7a29f","position":{"commit_sha":"f1a0487b9223af9f9426031bb4345320cb784250","position":"1786119845103973001-d595524e-760d-4bd5-ad62-bf5338f7a29f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786052070762961001,"creation_channel":"cli","deps":[{"link_uuid":"63616149-a6a3-4991-ba0d-2ce1e5874c7d","relation":"depends_on","target_id":"723f-c5b2-d83b-43cb"},{"link_uuid":"028de064-9a57-49fd-9ed4-05d87229a118","relation":"relates_to","target_id":"559c-8c79-c988-466c"}],"description":"`rebar transition --help` advertises `[--reason=<text>]` on every transition, but on a plain close\nthe value is parsed, threaded through two call layers, and then discarded. A user closing a ticket\nwith `--reason=\"...\"` reasonably believes the rationale was recorded. It was not.\n\nEvidence:\n\n- `src/rebar/_commands/txn.py:197` — `transition_core(..., close_reason: str = \"\", ...)`. The name\n  appears three times in the file (`:154` is a different symbol, `:197` and `:199` are signatures)\n  and is **never read in any body**.\n- `src/rebar/_commands/transition.py:130-136` parses `--reason`; `:293-294` shows its only live use\n  on a non-force path is `force_reason = (reason or \"(no reason given)\") if force else \"\"`, i.e. it\n  is meaningful **only** under `--force`. `--force-close=<reason>` carries its own separate value.\n\n## Scope: make the flag honest — do NOT add persistence\n\nAn earlier framing of this finding proposed persisting the close reason via the existing comment\nmechanism. That is rejected. `txn.py:253-259` records the governing decision:\n\n> Bug-close CLASS guard (ticket ed13): a bug closing from a non-idea status now REQUIRES a bounded\n> `--class <value>` from the closed vocabulary — REPLACING the old free-text `--reason` (which was\n> validated then discarded).\n\ned13 deliberately replaced free-text close rationale with the bounded `CLOSE_CLASSES` vocabulary,\nwhich IS folded onto the `*->closed` STATUS edge and is single-sourced against\n`common.schema.json#/$defs/close_class`. Re-introducing free text — in any form — reverses a recent,\nintentional move toward machine-readable close data, and no evidence was found that the decision was\nwrong. The \"why this specific ticket\" capability is not missing: `rebar comment <id>` already\nprovides it, it simply is not compulsory, and making it compulsory is what ed13 undid.\n\nRelated, already tracked elsewhere — do not duplicate: `bug_close_reason_ok` (`txn.py:154`) is dead\nwith a docstring falsely claiming two consumers; its deletion is covered by ticket\n`723f-c5b2-d83b-43cb`.\n\n## Acceptance Criteria\n\n- [ ] `close_reason` is removed from `transition_core`'s signature and every call site that passes it\n- [ ] `--reason` is documented as applying to the force paths only, in `transition.txt` help, the\n      `transition.py` usage string, and any overview/docs line that advertises it more broadly\n- [ ] Passing `--reason` on a plain (non-force) close either has a documented effect or is refused —\n      it must not be silently accepted and dropped\n- [ ] No change to `--class` / `CLOSE_CLASSES` behaviour, and no new free-text field on any event\n- [ ] `--force` and `--force-close=<reason>` behaviour is unchanged","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/_commands/txn.py","reason":"remove unread close_reason parameter from transition_core"},{"path":"src/rebar/_commands/transition.py","reason":"scope --reason to force paths; stop silently dropping it on plain close"},{"path":"src/rebar/_cli/help/transition.txt","reason":"correct the advertised scope of --reason"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","723f-c5b2-d83b-43cb"],["parent","b5bc-f4f7-3433-4181"],["relates_to","559c-8c79-c988-466c"]],"no_file_impact_reason":"","parent_id":"b5bc-f4f7-3433-4181","parent_status_uuid":"1aeed621-fe62-4606-9407-04a9ea1243ab","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["janitor"],"ticket_id":"3803-8e04-7c32-4b80","ticket_type":"task","title":"Make transition --reason honest: drop the discarded close_reason, scope the flag to force paths","verify_commands":[]},"source_event_uuids":["c40a386c-713c-4d0b-a083-11cf1a0da1f6","6942fb7a-1240-40de-bd73-3f21808ad58b","63616149-a6a3-4991-ba0d-2ce1e5874c7d","2a5d4abc-ab01-4cb5-90a2-57cdff1bad4a","1aeed621-fe62-4606-9407-04a9ea1243ab","d595524e-760d-4bd5-ad62-bf5338f7a29f","028de064-9a57-49fd-9ed4-05d87229a118"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786122779112165665,"uuid":"dc3d1268-aa35-4e2e-843b-1c777f0acb64"}