idity":0.1429,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"","cohort":null,"criteria":["G6"],"decision":"dropped","drop_reason":null,"evidence":[],"finding":"The plan adopts an optional `--until <duration>` bound on pause but never specifies WHICH component enforces expiry or where the un-pause decision lives (lazy reader-side check vs. an active clear). This is a load-bearing mechanism decision because expiry logic has no counterpart in an OLD binary: a lazy reader-side interpretation of `paused_at + until` un-pauses new binaries at expiry while old binaries stay wedged on the still-present `gated_mode: reconcile-check` blob, silently diverging fleet behaviour the epic is trying to keep uniform.","group_criteria":null,"group_id":null,"id":"f1cff32b0acbef7af","impact":0.0,"is_primary":null,"location":"Design spike findings — final bullet ('offer an optional --until <duration>')","norm_id":"n94903308f285448c","priority":0.0,"reason":"low-validity","scenarios":[],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.1429,"verification":{"binary":{"absence_confirmed_i