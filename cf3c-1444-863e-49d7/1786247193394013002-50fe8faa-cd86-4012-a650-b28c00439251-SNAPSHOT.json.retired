{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786247193394013002,"compiled_state":{"alias":"carnelian-unadored-baboon","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"66cabeb4d5f5100feebbde143b059b991d890c33","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: cf3c-1444-863e-49d7","material: 5f6f4d055f641af7","material-part: children 93a3cbcf63fc8ddd 4","material-part: description 5e642ebed9632c92 5192","material-part: file_impact 003ffa614d5e4a28 0","material-part: file_impact_scope 0cb8c00fffb2ae44 2","material-part: ticket_id cd40e70b7b16a35d 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 5","review-phase: execution","priority-floor: 0.80","rebar-version: 0.11.0 (66cabeb4d5)","regver: 4f90349cd81c4911","verified-at-sha:66cabeb4d5f5100feebbde143b059b991d890c33","plan-material-pin: child 0289-12a7-9890-4a17 7aee1b865c1e7ef0","plan-material-pin: child 2b05-fcb5-7e87-41d9 a504f2772b59f9c7","plan-material-pin: child 8970-40af-1785-4530 3af44121403febbe","plan-material-pin: child b014-1526-16d0-4c3f d5a00bc065f83518","file-scope: none"],"material_fingerprint":"5f6f4d055f641af7","merged_log_commit":"66cabeb4d5f5100feebbde143b059b991d890c33","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1786245827157570000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":10,"unsigned":0},"authorship_ledger":[{"content_hash":"10bae154bf177645244ea1d8244cdd4f480f4d05df4090cf68070d46dcce3b26","event