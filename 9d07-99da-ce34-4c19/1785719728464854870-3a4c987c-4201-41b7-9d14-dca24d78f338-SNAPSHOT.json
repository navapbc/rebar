76dc067","position":"1785711807647338001-934f94ab-bd6d-493f-9a8f-80edc23f2ff4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"02031f92bdc9e7363f10f1d50e9d169be20fabc1c64dca5b3e3376f8498f100a","event_uuid":"33e282e6-ebeb-483b-a588-cdbc94761605","position":{"commit_sha":"6725fbf6f194ec30d4007557497693f0283b68f9","position":"1785713253107515001-33e282e6-ebeb-483b-a588-cdbc94761605"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"44f89321291e1636e59b4f5e8b3ce84a8b505f0459c2d070962f6d44ce8b2604","event_uuid":"e2b3a50d-6b18-4c07-805c-5720bc50aa55","position":{"commit_sha":"6725fbf6f194ec30d4007557497693f0283b68f9","position":"1785713253628892001-e2b3a50d-6b18-4c07-805c-5720bc50aa55"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785640131116002001,"creation_channel":"cli","deps":[{"link_uuid":"3c903538-89c5-4b24-acb6-ca0181a88977","relation":"relates_to","target_id":"19cd-dc21-46aa-4201"}],"description":"## Context / Problem\nnormalize_ci_conclusion.sh is a pure function in shell — trivially portable, currently tested only via a subprocess-driving contract test. Its REAL contract is two-input: f(CONCLUSION, FAILURE_OBSERVED) -> vote in {success, failure, cancelled} (never out-of-domain), consumed by .github/workflows/gerrit-verify.yaml.\n\n## Approach\nPort to a small stdlib-only Python entry point with unit tests; the workflow call site swaps to the Python invocation. The existing contract test tests/scripts/test_normalize_ci_conclusion.py drives the SHELL script via subprocess — it is the porting oracle: first re-point its subprocess invocation at the Python entry point (proving CLI-level behavior parity env-var-for-env-var), keep its full case table, and add direct in-process unit tests of the function. The shell file is deleted in the same change, so no test ever references a missing script. The workflow currently fetches the script via sparse-checkout of exactly 'scripts/normalize_ci_conclusion.sh' (gerrit-verify.yaml:323) and calls it at :340 — update the sparse-checkout path to the new .py file (cone-mode: false so a single-file pattern works) and keep the entry point dependency-free so the single-file checkout still runs without the package installed. Opportunistic priority (lowest tier).\n\n## Scope\n- scripts/normalize_ci_conclusion.sh (deleted) -> new stdlib-only Python entry point\n- tests/scripts/test_normalize_ci_conclusion.py: subprocess target swapped to the Python entry point, case table preserved\n- .github/workflows/gerrit-verify.yaml: sparse-checkout path at :323 AND the run invocation at :340\n- new direct unit tests for the function\n\n## Testing\nThe ported subprocess contract test keeps its full table (env-driven CLI parity). Direct table-driven unit test over f(CONCLUSION, FAILURE_OBSERVED):\n- success -> success; failure -> failure; cancelled -> cancelled (FAILURE_OBSERVED irrelevant for these — assert both values)\n- skipped x FAILURE_OBSERVED=false -> success (benign im-open fallback)\n- skipped x FAILURE_OBSERVED=true -> failure (fail-closed)\n- empty CONCLUSION -> failure; unrecognized value (e.g. 'timed_out') -> failure (fail-closed anomaly rows)\n- FAILURE_OBSERVED unset defaults to false\nOutputs asserted to always be in {success, failure, cancelled}.\n\n## Acceptance Criteria\n- [ ] Python entry point reproduces the shell mapping exactly as f(CONCLUSION, FAILURE_OBSERVED), including skipped-fallback rows and fail-closed empty/unknown rows.\n- [ ] tests/scripts/test_normalize_ci_conclusion.py drives the Python entry point via subprocess with its case table preserved (no orphaned reference to the deleted .sh), plus direct unit tests cover the full contract (both FAILURE_OBSERVED values for pass-through rows included).\n- [ ] gerrit-verify.yaml sparse-checkout fetches the new .py path (cone-mode: false) and the run step invokes it; entry point is stdlib-only so the single-file checkout works; shell file deleted.\n","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"scripts/normalize_ci_conclusion.sh","reason":"port and delete"},{"path":".github/workflows/","reason":"call-site swap"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","2f4c-7e5c-e782-4e97"],["relates_to","19cd-dc21-46aa-4201"]],"no_file_impact_reason":"","parent_id":"2f4c-7e5c-e782-4e97","parent_status_uuid":"33e282e6-ebeb-483b-a588-cdbc94761605","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["shell-migration"],"ticket_id":"9d07-99da-ce34-4c19","ticket_type":"task","title":"Shell-to-Python Tier 1: normalize_ci_conclusion.sh","verify_commands":[]},"source_event_uuids":["ad0cfd58-3eb9-417b-a5be-0356d730bbf6","ab9c0ef2-b1a3-4bb1-ad5c-4e181982ff41","a49aa4bc-b146-4386-971c-063e0262b18a","d161c9e7-ea91-45e0-a60b-3fc43a92602e","934f94ab-bd6d-493f-9a8f-80edc23f2ff4","33e282e6-ebeb-483b-a588-cdbc94761605","e2b3a50d-6b18-4c07-805c-5720bc50aa55","3c903538-89c5-4b24-acb6-ca0181a88977"]},"env_id":"ade0f2ef-51cc-