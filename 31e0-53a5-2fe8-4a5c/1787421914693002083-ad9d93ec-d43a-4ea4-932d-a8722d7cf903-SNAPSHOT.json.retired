sh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"412fd93840842a8a8b5be4fbbc46a9dcfbcec0514fa37a0e05920be71ff077d5","event_uuid":"11b03261-7cdd-4f27-a745-4f7df8c74e10","position":{"commit_sha":"195035cb61895c83894b4a18a6ae649708c65d24","position":"1787417737836712001-11b03261-7cdd-4f27-a745-4f7df8c74e10"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787417145184816001,"creation_channel":"cli","deps":[{"link_uuid":"d30bd846-2a63-4310-b6f0-e2f043776c95","relation":"depends_on","target_id":"65c9-aba3-c744-483a"}],"description":"## Context\nREADME workflow prose conflicts with current claim, graph, help, and close behavior. The dispatcher fix on `chartreuse-interested-viper`, the assignee correction on `weariless-scrapable-mouse`, the quickstart work on `tsunamic-wax-hog`, and ADR 0100 define the historical basis. F12 must complete command discovery before this story finalizes help wording.\n\n## Plan\n- Document default claim assignment and Jira-resolvable explicit overrides.\n- Name all seven relations, including `caused_by`.\n- Document optional relation-scoped unlink.\n- Describe help recognition before `--` while preserving nested `bridge` and `audit` handling.\n- Describe integrated completion verification for task, bug, story, and epic closes.\n- Preserve the tested quickstart and existing README structure.\n- Leave demonstration assets for F16.\n\n## Acceptance Criteria\n- [ ] Generic claim guidance omits an explicit assignee and explains valid overrides.\n- [ ] Link guidance names all seven relations.\n- [ ] Unlink guidance documents omitted and explicit relation behavior.\n- [ ] Help guidance matches leaf and nested command behavior.\n- [ ] Close guidance covers ordinary work-ticket completion verification.\n- [ ] The README quickstart check and targeted documentation checks pass.\n- [ ] No demonstration asset or unrelated README section changes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"README.md","reason":"Correct workflow, relation, help, claim, and close guidance."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","65c9-aba3-c744-483a"],["parent","f7e4-4d33-f231-4774"]],"no_file_impact_reason":"","parent_id":"f7e4-4d33-f231-4774","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f08a"],"ticket_id":"31e0-53a5-2fe8-4a5c","ticket_type":"story","title":"F08A correct README workflow contracts","verify_commands":[{"command":"python scripts/check_docs_index.py --check","dd_id":"D1","dd_text":"README remains indexed and linked"},{"command":"python scripts/check_readme_quickstart.py","dd_id":"D2","dd_text":"README quickstart still executes"},{"command":"python -m pytest tests/scripts/test_check_readme_quickstart.py -q","dd_id":"D3","dd_text":"Quickstart contract tests pass"}]},"source_event_uuids":["276eb756-332f-49bf-95a3-bb229c40955b","b6ac5e00-27e5-4792-944d-ab267e581ccc","d30bd846-2a63-4310-b6f0-e2f043776c95","11b03261-7cdd-4f27-a745-4f7df8c74e10"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787421914693002083,"uuid":"ad9d93ec-d43a-4ea4-932d-a8722d7cf903"}