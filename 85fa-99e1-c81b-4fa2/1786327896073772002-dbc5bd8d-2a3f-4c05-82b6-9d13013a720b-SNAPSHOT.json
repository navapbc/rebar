f1524-8411-4b8b-8ca6-d31a282b20e9","position":{"commit_sha":"067afba91874b9ae97a44a434cac656baee6f0a4","position":"1786327581178887322-97df1524-8411-4b8b-8ca6-d31a282b20e9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a0d5c7045de9cc220c6c2d6730c6e4d9cec1f07a8ce6e99c45d44e00637ddf89","event_uuid":"fad88e29-5aa1-401e-a062-9fdecf72d935","position":{"commit_sha":"a0e951b38305bdde2be4b65297b661e53223adae","position":"1786327756536950001-fad88e29-5aa1-401e-a062-9fdecf72d935"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8d496e6c0121ecc9e9a2bcc49d298f8b8f45abc0e3b9d5614bc310c2f7e5ed39","event_uuid":"6ae928e3-d812-4ee0-a65f-5283d344dc0d","position":{"commit_sha":"bc8b5cef73ebdb8ba9eaf5f067c9c9e4e081097e","position":"1786327851322831001-6ae928e3-d812-4ee0-a65f-5283d344dc0d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"95ae2b261697f9a682c8c463e1655527e205191164c7c5ce0ce3bfdde5475a45","event_uuid":"c3ff8591-c9ca-475e-b963-9401b7268043","position":{"commit_sha":"ea85c74064619dc43e9a1ba7be1ddbb5f2f096b0","position":"1786327896073772001-c3ff8591-c9ca-475e-b963-9401b7268043"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-226_agent","claim_remote_session":null,"claimed_session":"60ba7eab-291a-4d28-9c21-b48311933b7f","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"DIAGNOSIS CORRECTED — it is NOT merge commits.\n\nThis ticket was filed saying plain `git log` skips MERGE commits, so a deletion reaching HEAD\nvia a merge was invisible. That is wrong. Measured on the live store against f130's lost EDIT\n(a440f6d5-6aa1-4669-9908-5fb955ad6a53):\n\n  git log --diff-filter=D -- <tid>/                        -> 0 hits\n  git log --diff-filter=D --full-history -- <tid>/         -> 0 hits\n  git log --diff-filter=D -m -- <tid>/                     -> 0 hits\n  git log --diff-filter=D --diff-merges=first-parent -- .. -> 0 hits\n  git log --all --diff-filter=D -- <tid>/                  -> 0 hits\n  git log --all --diff-filter=D          (no pathspec)     -> 0 hits\n  git log --diff-filter=D -- <tid>/*<uuid>*                -> 1 hit\n\nEvery merge-diff flag and --all changes nothing; ONLY narrowing the pathspec from the\nDIRECTORY to the FILE (or a per-uuid glob) finds it. So it is a pathspec-SCOPE effect under\ngit's path history simplification, not merge-diff display and not reachability. The fix the\noriginal ACs implied (add a diff-merges mode) would have shipped without fixing anything.\n\nFIX PUSHED: keep the cheap directory pass, add a per-uuid glob fallback bounded to the uuids\nthe snapshot still cites as absent (the glob walks full history per uuid and is much slower).\nThe restore cluster also moves to a new fsck_restore leaf because fsck_repair was at its\nmodule-size cap.","timestamp":1786326663964868001}],"created_at":1786296594295519001,"creation_channel":"cli","deps":[{"link_uuid":"97df1524-8411-4b8b-8ca6-d31a282b20e9","relation":"relates_to","target_id":"f7c8-b0b5-a804-4f3a"}],"description":"# restore_deleted_sources misses deletions a PATH-scoped walk would find\n\n## Corrected diagnosis (the original filing was wrong)\nThis bug was filed claiming plain `git log` skips MERGE commits, so a deletion reaching HEAD\nthrough a merge was invisible. That is FALSE. Measured on the live store against ticket f130's\nlost EDIT (a440f6d5-6aa1-4669-9908-5fb955ad6a53, which carried that ticket's 2719-char\ndescription):\n\n    git log --diff-filter=D -- <tid>/                          -> 0 hits\n    git log --diff-filter=D --full-history -- <tid>/           -> 0 hits\n    git log --diff-filter=D -m -- <tid>/                       -> 0 hits\n    git log --diff-filter=D --diff-merges=first-parent -- ...  -> 0 hits\n    git log --all --diff-filter=D -- <tid>/                    -> 0 hits\n    git log --all --diff-filter=D        (no pathspec)         -> 0 hits\n    git log --diff-filter=D -- <tid>/*<uuid>*                  -> 1 hit\n\nEvery merge-diff mode and `--all` changes nothing. ONLY narrowing the pathspec from the\nDIRECTORY to the FILE (or a per-uuid glob) finds it. So this is a pathspec-SCOPE effect under\ngit's path history simplification — not merge-diff display, and not reachability. The fix the\noriginal acceptance criteria implied (add a diff-merges mode) would have shipped without\nfixing anything.\n\n## Impact\n`restore_deleted_sources` enumerates deletions with ONE ticket-scoped\n`git log --diff-filter=D --name-only -- <tid>/` pass. Anything that walk misses stays\nunrecoverable and the ticket keeps a SNAPSHOT_MISSING_SOURCES finding permanently. Observed on\nf130 during the b636 remediation; recovered by hand at the time.\n\n## Acceptance criteria\n- [x] A targeted per-uuid fallback (`git log --diff-filter=D -- <tid>/*<uuid>*`) recovers\n      sources the directory-scoped walk misses.\n- [x] The fallback is BOUNDED to the uuids the snapshot still cites as absent after the cheap\n      pass — a glob pathspec walks full history per uuid and is markedly slower (one probe\n      command timed out at 10 minutes).\n- [x] NEWEST-deletion-wins is preserved in the fallback (git streams newest-first, first hit\n      wins), matching `_deleted_history`.\n- [x] Held-out test: the fallback recovers an event when the directory-scoped walk is stubbed\n      empty. Verified RED (fails with the fallback call removed) then GREEN.\n- [x] Module-size: `fsck_repair` was at its 800-line cap, so the restore cluster\n      (`_deleted_history`, `_deleted_path_for_uuid`, `_uuid_fallback`,\n      `restore_deleted_sources`, `rebuild_with_restore`) moves to a new `fsck_restore` leaf —\n      633/204 lines, both inside the 100-800 band. `fsck_repair` owns snapshot-source\n      ACCOUNTING and the repair decision; `fsck_restore` owns recovering the bytes.\n      `fsck_repair` re-exports the public names; `fsck_restore` imports\n      `snapshot_missing_sources` lazily so the two do not form a cycle. Neither moved function\n      carries a complexity-baseline entry, so the split adds none.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","f7c8-b0b5-a804-4f3a"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"de756bcf-990a-451a-b6de-510ff3174a2a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"85fa-99e1-c81b-4fa2","ticket_type":"bug","title":"restore_deleted_sources misses events deleted in a merge commit (git log --diff-filter=D skips merges)","verify_commands":[]},"source_event_uuids":["8d7ab1d1-d6a6-44c2-a1a1-d0be5af127f4","de756bcf-990a-451a-b6de-510ff3174a2a","2bc33cbc-c10f-48d0-8666-4e502f20dbf7","5aa20780-2f65-4f84-b29d-1d2c0633f5c9","97df1524-8411-4b8b-8ca6-d31a282b20e9","fad88e29-5aa1-401e-a062-9fdecf72d935","6ae928e3-d812-4ee0-a65f-5283d344dc0d","c3ff8591-c9ca-475e-b963-9401b7268043"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786327896073772002,"uuid":"dbc5bd8d-2a3f-4c05-82b6-9d13013a720b"}