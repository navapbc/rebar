{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788064644272604230,"compiled_state":{"alias":"celestine-treasonous-ewe","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4516b3773c0a415e31cd570288a9ce94cb858e35","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 471c-f71f-342c-45ed","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (4516b3773c0a)","material: fe60dd2eb3738df2","verified-at-sha:4516b3773c0a415e31cd570288a9ce94cb858e35"],"material_fingerprint":"fe60dd2eb3738df2","merged_log_commit":"4516b3773c0a415e31cd570288a9ce94cb858e35","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788059006081117000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4516b3773c0a415e31cd570288a9ce94cb858e35","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 471c-f71f-342c-45ed","material: fe60dd2eb3738df2","material-part: children 647ea2107ca5072f 0","material-part: description d2ad125b9a56ac10 6687","material-part: description_boxes eaf16bc07968e013 5","material-part: file_impact 4a9144b9992d46ff 5","material-part: ticket_id 1a02f9dfde7da11e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: