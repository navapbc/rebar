{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787339663813732002,"compiled_state":{"alias":"community-sediment-snipe","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"46575522d6e8c65e4216e52530759f77cc33fbdc","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b9b4-f460-2d54-4872","material: b39b592f67eec8df","material-part: children 647ea2107ca5072f 0","material-part: description c50963d47db18531 5975","material-part: description_boxes b7fb217694ae2d30 6","material-part: file_impact d548ec387d94dfd2 15","material-part: ticket_id 4a853550d93f1773 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (46575522d6)","regver: 362a5dd2d2052826","verified-at-sha:4fbeb05607a07d6db40b6be04fffe3958f517f52","dep 9df07ddfbab06847cb415af8588d17479eede3e0230c902ed6a8cbb81b5ebd5f src/rebar/_engine/rebar_reconciler/_backend.py","dep 6af10adf6d5f38a9c6f35f70bc4a8a1beb2f1ae9302d4e56e63adc0795e8d7d2 src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","dep e033a2d669cf20c658ede96533b21513c7004651a3aff29ff988b0eceb69d73a src/rebar/_engine/rebar_reconciler/adapters/jira/acli_cli_ops.py","dep c97b62a77b59de98b94da21f6b7183ef6b973519a788a51d608bc5c2190465a4 src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","dep 37c755c8b55ffd013004ae5a3a44a9b33bf7d754c5aea97639145db1a6a59542 src/rebar/_engine/rebar_reconciler/adapters/jira/jira_fields.py","dep 4d8d45159da309d140ed31405a115c1fef8bb3f44a2de9df972b4db16803aafb src/rebar/_engine