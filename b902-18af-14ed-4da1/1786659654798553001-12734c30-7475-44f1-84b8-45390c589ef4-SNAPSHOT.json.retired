{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786659654798553001,"compiled_state":{"alias":"childsafe-bizarre-lorikeet","assignee":null,"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":17,"unsigned":0},"authorship_ledger":[{"content_hash":"25fe8788b53d3ce53d0e7bc46fe7d113e8e00d58c496379abc3c2a95dbc8b623","event_uuid":"cf857966-1a39-4f0a-be5e-5d8dbfcb562a","position":{"commit_sha":"2453a71ad8108e84927640e2f56e02d2d343b2f9","position":"1786426084120149001-cf857966-1a39-4f0a-be5e-5d8dbfcb562a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3ba58bb32bc43312ed7ab907b34cd990fc1001d1a3adc52abb2ee968a45d7ec0","event_uuid":"bc6e592d-1bf2-4f97-91df-ba7e4db7ef11","position":{"commit_sha":"878aa89f3a43265e95ea22e855d304613c11e43a","position":"1786461567404530001-bc6e592d-1bf2-4f97-91df-ba7e4db7ef11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0803f14b1741bcfe43371184e0ac3319f37340bbdb86f4c72d25ad2388621632","event_uuid":"3f975c15-26c5-434a-8563-c6b48b32936c","position":{"commit_sha":"af2cb7182adb55bca141afecd5eca2fd1788260e","position":"1786469063267107001-3f975c15-26c5-434a-8563-c6b48b32936c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3318b339f256265d7bd536527fc901c8fc8b3a019fa2b966416b3604c6bd2338","event_uuid":"5ed00726-4998-4abe-b966-b8d08cb0b1ba","position":{"commit_sha":"2510fad64b340ed2714233b64f66944e4a11e960","position":"1786474792137526001-5ed00726-4998-4abe-b966-b8d08cb0b1ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cd8d7e7289de012de5fe054962210e116207602e94d31726a72cbef9c1f9be1e","event_uuid":"49f6951e-c7fe-4a41-bf25-192ea5e7980c","position":{"commit_sha":"d2f4d3b65e39a54f0e049c291f65eaf33cb6159e","position":"1786478474191880001-49f6951e-c7fe-4a41-bf25-192ea5e7980c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"88bdd14a8eac0ea438e2d75b96b2c743ef4abf82988b71f8b7dd8f13ad6c8fde","event_uuid":"4eb6d662-43a7-4242-ad99-93de17cc54f1","position":{"commit_sha":"72eb697ebbcabc81d3304498afa9e6e71fb6cec5","position":"1786484751808672001-4eb6d662-43a7-4242-ad99-93de17cc54f1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8987d54ad09360d14bf53ac66581165420d6145c646c560e0fcacbab43e066ea","event_uuid":"cb8fe475-a467-4b4c-9862-0fabaa75d251","position":{"commit_sha":"2b4bc5e975750dc167babe3ab6854f4343b99072","position":"1786490424697788001-cb8fe475-a467-4b4c-9862-0fabaa75d251"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1e2bbe122f8aa0d1321c03f8f7359c1388eb319ea72cef16549dd1ace9033247","event_uuid":"ed79beea-177e-4d76-9bcc-c944db3b0837","position":{"commit_sha":"23a3dd2086be2a469809cca1eefbb3e73b416af7","position":"1786505861795496001-ed79beea-177e-4d76-9bcc-c944db3b0837"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c09d83a280d9c8382eaec584bce3e2e0ef6589432b4c4b0093f611d55ee62fea","event_uuid":"f5938b67-fddb-465d-8ca2-e93804f1d20a","position":{"commit_sha":"afd996a870ff2398bc3e07525679f9b4a896fe8f","position":"1786508817364527001-f5938b67-fddb-465d-8ca2-e93804f1d20a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"16606298f4e35ef2634fb696f85fde3cd4d6a0a55e0deb16bf124b28f803a52e","event_uuid":"c91db495-2b5d-4fe9-b1d6-4c0451111d9e","position":{"commit_sha":"78498f04d24277df393e6d30c3c01dac189fe898","position":"1786508947183814001-c91db495-2b5d-4fe9-b1d6-4c0451111d9e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f75a42af68ca4263e75cfec54aa5ebc548a96dc5eb2bd0ce5242ec4229d50562","event_uuid":"f7c3db7f-9744-481e-b9ba-817db1dd379f","position":{"commit_sha":"3e1fc460e3052190ab960970acb9768b28c24b5e","position":"1786509285425231001-f7c3db7f-9744-481e-b9ba-817db1dd379f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6c25927c9d04ba69d70a6b7c438a3bc4369f0e355fd2aad38362f81921c80c42","event_uuid":"c520a3b8-ea35-495b-a93e-bdd07698a0f7","position":{"commit_sha":"82a5d7a88906bceb308599c170f2e5921c2df621","position":"1786509588725122001-c520a3b8-ea35-495b-a93e-bdd07698a0f7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"49f1a5a4a712e920691b364e75286ab15a47c079f1da1ab566943bf2455abc3e","event_uuid":"d447604d-e543-4582-8ed2-15a7af0ff944","position":{"commit_sha":"6b56b3f9a00e3e29b00f51eb351380ac3aea7c4f","position":"1786532129700991001-d447604d-e543-4582-8ed2-15a7af0ff944"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2e3fb7f6d43a52a8b34cc6bfe95bea366c8d6b4b3ead5d87b214e5f8ac75f5b3","event_uuid":"2a596cd6-02a7-4fe6-8c33-a49fa578bd27","position":{"commit_sha":"0c981398fc3c748f099baee6fd0cc779baf873ab","position":"1786565507315994001-2a596cd6-02a7-4fe6-8c33-a49fa578bd27"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d9b0806ebb4e375dba5d77421401f1089d8a20403e3300c66cc611a6d025ba25","event_uuid":"383a25a2-5faf-415e-9eef-0be5b15a81e1","position":{"commit_sha":"26d61af2c2b97a768b9cbc7ae316cb9f4bece45e","position":"1786574909504428001-383a25a2-5faf-415e-9eef-0be5b15a81e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4fd45b95f4f8eb4f9967eca4b21e85e28271f60d91e575abf0bea95268e3fc72","event_uuid":"6711ceb7-00ee-41d7-9029-c5a7a777c0d8","position":{"commit_sha":"2457150f1acd568b3db94928f338154ab770efb5","position":"1786576977056432001-6711ceb7-00ee-41d7-9029-c5a7a777c0d8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c3dfdb7707f4e91449f11b07f27d8e2e2d68e24b28c78e354e66bd641e72c594","event_uuid":"9d17fcec-352c-4a04-9520-ff960b9b50ba","position":{"commit_sha":"95c3d7f78fc48b5be773b15ed8bd635471477917","position":"1786588815138840001-9d17fcec-352c-4a04-9520-ff960b9b50ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Follow-up experiments complete (total Bedrock spend $91.15/$100). Exp A — Nova Pro as frontier slot, end-to-end review-plan replays in an isolated copy: 5/5 comparable tickets matched recorded verdicts (4 PASS, 1 BLOCK incl. same blocking finding), finder-slot cost $0.07-0.09 vs $2.31-3.00 recorded (~30-40x); agentic tool-looping works with a MODEL_MAX_OUTPUT_TOKENS entry (10k) and ~7% retryable tool_call flake; the agentic Pass-2 verifier runs on the STANDARD slot so a frontier swap does not touch it; overlap-judge 48k bug reproduced again (live). Exp B — completion-verifier gold set (differential vs Sonnet baseline 16/22 incl. 3-case fixture artifact): Haiku 16/22 zero false-accepts; Nova 2 Lite 14/22 zero false-accepts (over-strict on injection case); Nova Pro DISQUALIFIED (3 false-accept epochs on operator-attestation cases). Banked-run median cost: sonnet $1.20 → haiku $0.40 → nova-2-lite $0.027. Per-AC splitting is strictly dominated (~4.5x at any tier; already built+measured+deleted per 2948) — swap the model inside the banked design instead. Full data: reports/llm-gate-cost-2026-08-11/.","timestamp":1786461567404530001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Round 2 complete (~$90/$150 cumulative). (1) Sonnet-as-Opus frontier swap: NOT viable as configured — 0/3 hard-ticket replays completed (Bedrock-Sonnet web-search tool errors abort runs on T1; agentic finders burn full 125-request budgets at ~$15-20/ticket, echoing the recorded 'sonnet fan-out false economy' finding). Nova Pro: 8/8 verdict agreement incl. a 12-child container epic and two blocking-heavy tickets at ~$0.10/run, but blocking-criteria recall only ~50-57% (verdict-safe, finding-lossy). p99 giant tickets are no longer replayable — today's desc-cap gate 7cf80009d9 DET-blocks that class pre-LLM. (2) CV 6/22 answered: harness artifact of the experiment runner (verifier searched the real repo, not the fixture); fixture-rooted Sonnet = 22/22, no prompt remediation needed. Ranking: Sonnet 22/22 > Haiku 19/22 (0 false-accepts, over-strict from shallow search; ~$0.75/run vs $2.24 cache-aware) > Nova 2 Lite 14/22 > Nova Pro 13/22 with 3 false-accepts (disqualified). Haiku window: ~6% of calls / 18% of completion spend would exceed 200k peak and ladder back to Sonnet. (3) Loop audit: overlap-judge fix 7fa8102477 bounded judge_batch but NOT judge_one (volume site) — extend the same 3 bounds there (~97% failure-cost cut); CV runaways fixed into bounded budget-exhaustions still costing $20-30/day — next lever is a cumulative-cost ceiling per attempt. Pricing note: pydantic-ai input_tokens is cache-inclusive and Opus 4.8 is $5/$25 — all round-1 report figures stand; round-1 experiment-spend table was overstated (true ~$13). Data: reports/llm-gate-cost-2026-08-11/round2/.","timestamp":1786469063267107001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Round 3 results. (1) Haiku CV parity via prompt remediation: NOT achieved — two accuracy-tightening rules (state-not-provenance; trace-inferred-defects) kept Sonnet at 22/22 but Haiku only moved 86%→87% with complete-bugfix false-FAILing 3/3 epochs (over-literal evidence entailment — capability, not prompt). Zero false-accepts, but 2-3/11 pass-cases would false-block completed work. Keep Sonnet; patch preserved in worktree ../cv-prompt-remediation. (2) AC long tail: 48% of 3,054 historical ACs are hard-verification (30% absence/negative, 14% universal quantifiers); 93% of tickets have ≥1 hard AC — gold parity would understate production risk. (3) overlap-judge: no change needed — plan-review G6 correctly refuted my judge_one diagnosis (ticket 3939 closed not_a_bug); 48k rows were stale pre-fix checkouts; current failures are bounded $0.02 abstains. (4) Nova ceilings: change 1597 (ticket e800) LLM-Review +1, awaiting Verified. (5) Dependency sourcing for model limits: not available in pydantic-ai; genai-prices has context_window only; filed idea unrelaxed-trachyte-dipper.","timestamp":1786474792137526001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Historical audit of incremental re-review (lever: carry forward per-criterion verdicts): REJECTED by the data. 894 BLOCK→re-review transitions: 37% block on ≥1 criterion NOT in the original block (18% entirely-new criteria); the most common new criteria (G1G2, G6, E4, COH, E6) are cross-cutting whole-plan criteria that a changed-sections-only design would carry forward. Control: same-material re-runs produce 0% all-new-criteria blocks (15% mixed = nondeterminism floor), so new-criteria blocks on revised material are real revision-induced defects. Skipping unchanged criteria would have missed blocking findings in ~2 of 5 re-reviews. Companion finding: 307/1,457 full-LLM re-reviews (21%) ran on IDENTICAL material fingerprints — 171 triggered by base-sha drift alone — the cleanest remaining quality-neutral savings target. Analysis script + output in reports/llm-gate-cost-2026-08-11/round2/.","timestamp":1786478474191880001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Round 5 — design questions answered with data. (Q3) BLOCK→PASS flip attribution: 8% of all flips (31/404) happened with NO material change (pure flap); revised-material cited-text attribution is unrecoverable historically (SNAPSHOT compaction dropped old descriptions) — recommend recording cited-anchor hashes in the sidecar going forward. Staged re-review (re-run blocked criteria first) modeled NEGATIVE: 45% of re-reviews PASS and would each pay an extra serial stage-0 call; the mixed bucket (19%) converts one review into two author rounds; only the 13% persisting-only bucket wins — net ≈ break-even before latency, negative after. The DET cited-anchor pre-check captures the same win with zero LLM calls. (Q4) Overlap drain ROI: 0 of 2,093 plan reviews ever surfaced an overlap finding — the drain (~$165/5-days local + its failure storms) is not accomplishing its goal; recommend overlap_drain=off (config kill switch exists) pending redesign, or gate to ticket-creation only. (Q5) Cache TTL cliff CONFIRMED (read-share 68.7% at <5min gaps → 0.0% at >5min) but small: ~5% of consecutive calls are cold ≈ 2-3% recoverable — deprioritize. Analyses in reports/llm-gate-cost-2026-08-11/round2/.","timestamp":1786484751808672001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Round 6 closeout. Q1 (approved a+b): ticket regional-lamproite-flee created; two revision rounds absorbed gate findings (read-set must live in the SIGNED manifest; integrate with ADR-0002's content-hash machinery rather than a parallel trigger; concrete blast-radius paths) — still open with 4 remaining implementation-level findings (read-set normalization protocol, glob→concrete-path expansion for the ADR-0002 seam) for the implementing session. Q2: ticket brickred-hapless-dromedary (attach-commits on CLI+lib+MCP with validation in the shared seam, docs, and the DET file-impact-vs-diff close check with owned exemption globs and defined path semantics; CV-diff use explicitly out of scope per operator) — open with 1 remaining finding on the referencing-scan's descendant scope. Q3: material_parts decomposition shows 98% of revised-material re-review pairs moved the plan text (deps-only moves are rare), so the 37%-new-criteria audit stands; but same-fp flips are genuine flap, so any cited-anchor pre-check must warn/decline-with---force (mirroring BLOCK-verdict-reuse), never hard-block. Q4: root cause found and ticketed — overlap has surfaced 0 findings ever because (1) batch-path verdicts carry confidence=0.0 (live-probed: even a blatant near-duplicate judges abstain/0.0 with no exception), below the 0.7 conjunction bar, likely fatal since batching (c403); (2) since 7fa8102477 the flat 1024 output cap truncates real batches → whole-batch abstains. Repair bug cumbersome-littlish-koalabear PASSED plan-review and is signed/claimable (fix confidence contract + scale output budget from _CANDIDATES_PER_CALL + live calibration case). Cumulative experiment spend ≈ $124/$150.","timestamp":1786490424697788001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## CloudWatch quantification of the Bedrock error blast radius from the 2026-08-10/11 model-comparison runs\n\nAn automated ops error sweep pulled AWS/Bedrock metrics (account 896586841071, us-east-1) for 2026-08-05T00:00Z -> 2026-08-12T04:00Z. Posting the numbers here because the errors are **attributable to the model-comparison experiments run under this ticket**, and because they are now fully explained by [rebar:e800-c107-d4ac-463b] (Nova 10k output ceilings), which has since closed and landed on main as f7e684c300.\n\n**InvocationClientErrors by ModelId — the spike:**\n\n| ModelId | 08-10 21:00 PDT | 08-10 22:00 PDT | 08-11 07:00 PDT |\n|---|---|---|---|\n| us.amazon.nova-pro-v1:0 | 2 | **50** | **16** |\n| us.amazon.nova-2-lite-v1:0 | - | 6 | - |\n| us.amazon.nova-premier-v1:0 | - | 1 | - |\n| us.deepseek.r1-v1:0 | - | 2 | - |\n\nRoughly **77 client errors**, ~94% of them on the Nova family, in a two-hour concentration plus one follow-on hour. This matches e800's account precisely: every Nova call riding the raise-to-model-max seam was rejected with `ValidationException: The maximum tokens you requested exceeds the model limit of 10000` before it ran.\n\n**Two things worth carrying forward for the cost analysis:**\n\n1. **The Claude ladder was essentially untouched** — 1-3 client errors each across the whole week for the opus/sonnet/haiku slots. The `rebar-bedrock-invoke-client-errors` alarm is dimensioned on those three slots only, so it correctly stayed OK throughout. That is the alarm behaving as designed, but it also means **a cheap-model experiment can fail wholesale without any alarm noticing** — worth knowing before this ticket recommends routing real gate traffic to a cheap model.\n2. **us.deepseek.r1-v1:0 took 2 client errors and is NOT covered by e800's fix**, which added ceilings for nova-pro / nova-2-lite / nova-lite / nova-micro only. If DeepSeek stays in the candidate set for the lever option book, it likely needs its own ceiling entry. Two errors is thin evidence, so treat this as a flag to check rather than a finding.\n\n**Separately, InvocationServerErrors** (5xx, i.e. Bedrock-side not request-side): 1 on 08-05, 1 on 08-07, then **17 clustered on 2026-08-11 10:00-12:00 PDT**. These are not explained by e800 and are not a rebar defect — but a cost/latency model built from that window should know the provider had a bad two hours in it.\n\nFor scale: total Invocations peaked at 48,780 on 2026-08-10, so even the worst error hour is a fraction of a percent of traffic.\n\nReported by an automated ops error sweep; read-only AWS calls, no code changed.","timestamp":1786505861795496001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Closing the analysis record at session compaction. All deliverables shipped: cost analysis rounds 1-6 (reports/llm-gate-cost-2026-08-11/ + artifact 725e8b52), experiments (~$105/$150), overlap repair + drift scoping + Nova ceilings landed on main, ordinal-migration plan written with plan-v5 batch in flight, bug-bash coordination handed to session log indicolite-whited-cheetah (9367-7110-f0ea-4040). Pending operator items recorded there.","timestamp":1786508817364527001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Close deferred at compaction: two plan-review rounds spent on record-ticket hygiene is enough — this is exactly the doomed-re-review spend pattern this ticket's own analysis measured. The ticket stays OPEN (claimed) as the durable analysis record; its deliverables are all shipped and independently verifiable (see AC verify commands). Successor session may close it after a passing review or leave it as-is. State handoff lives in session log indicolite-whited-cheetah (9367-7110-f0ea-4040).","timestamp":1786509588725122001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"# Why the code-review severity axes are inert — root cause, zero-LLM (2026-08-12)\n\nOperator question before approving Phase 3: *\"consider why they're inert before acting on this.\nwe see very few code review findings.\"* Answer: **the axes are inert because the block decision\ndoes not read them for 98.5% of findings — not because they are uninformative, and not because\nthe reviewer finds little.** The ≤0.77% level-collapse flip rate recorded above is a *confounded*\nmeasurement. Corpus: all 1,545 `code_review` sidecar events in the tracker (3,839 findings),\nre-scored offline through the shipped `rebar.llm.review_kernel.decide.impact`.\n\n## 1. Distribution headline\n\n| metric | value |\n|---|---|\n| code-review runs | 1,545 |\n| findings | 3,839 — advisory 2,852 / dropped 913 / indeterminate 34 / **blocking 40** |\n| verdicts | PASS 1,500 (97.1%) · BLOCK 39 (2.5%) · INDETERMINATE 6 |\n| reviews with **0 blocking** | 1,506 / 1,545 = **97.5%** |\n| reviews with **0 findings at all** | 470 / 1,545 = 30.4% |\n| findings per review | median **2**, mean 2.48 (mode: 0, then 2, then 1) |\n| tier | LLM 3,772 · DET 59 |\n| **blocking by tier** | **DET 30 · LLM 2 · untiered 8** |\n\nThe operator's \"0–2 advisory non-blocking\" observation is exactly right and is the *normal* mode.\nBut the reviewer is **not** quiet: it emits 2.48 findings/run and self-labels **183 of them\n`major` or `critical`** (159 major + 24 critical). **Every one of those 183 landed in `advisory`\nexcept 2.** The LLM's total contribution to the block decision across the whole corpus is\n**2 findings in 1,545 reviews (0.13%)**. Blocking is effectively a *deterministic* gate:\n`bugfix-size-attestation` (27) + `sec`/`security` (10) + `secret-detection` (3).\n\nTop advisory criteria: tests 1,399 · maintainability 672 · correctness 617 · edge-cases 415 ·\nregression 284 · error-handling 172. Top dropped: docs 328 · tests 169 · maintainability 145.\n\n## 2. Root cause — two structural AND-gates, neither of which is severity\n\n**(i) Blocking is criterion-routed, not severity-routed.** Cross-tab of\n`block_threshold` × `blocking_enabled` × `tier`:\n\n```\n(0.95, False, LLM)  3353     <- 98.2% of scored findings: blocking DISABLED\n(0.54, True,  LLM)    51     <- the ONLY blocking-enabled criterion: `security`\n(0.90, False, LLM)    10     <- project.review-phase-boundaries, also disabled\n(None, None,  DET)    59     <- deterministic, no axes at all\n```\n\nOnly `security` (51 findings, 1.3%) is blocking-enabled. For the other 3,363, the severity axes\nare graded, serialized, and then discarded — the decision was fixed by routing before `impact()`\nwas consulted.\n\n**(ii) For those 3,363, the 0.95 threshold is functionally unreachable.** `impact()` is\n`(max(prod,debt) + blast + likelihood + reversibility) / 4`, each term ∈ {0.33, 0.67, 1.0}.\nExhaustive enumeration of all 432 attribute combinations:\n\n- **7 / 432 combos (1.6%) reach ≥ 0.95**, and **all 7 require the exact conjunction\n  `blast_radius=system` AND `likelihood=high` AND `reversibility=hard`** (plus prod or debt =\n  high). The threshold is not a severity dial — it is a hard 3-way AND on the rarest level of\n  three axes.\n- The next attainable score below 0.95 is **0.9175**. There is a **dead zone**: no finding can\n  ever score in (0.9175, 0.95).\n\nObserved marginals over 3,738 graded findings: `blast_radius=system` **92** · `likelihood=high`\n**246** · `reversibility=hard` **7** · **all-three conjunction: 0 (zero) occurrences.**\n\nEmpirical impact distribution: p50 **0.30**, p90 0.32, p99 0.60, **max 0.90**. Median gap to\nthreshold **0.65**; only 12 of 3,414 findings land within 0.10 of their threshold. The axes are\nnever exercised anywhere near the decision boundary because **the boundary is outside the\nobserved — and nearly outside the attainable — range.**\n\n**(iii) Even the one live path is degenerate.** All 7 findings that ever met their threshold\nscored *exactly* 0.54 (= the threshold), and only **2** became blocking: blocking on `security`\nadditionally requires `validity == 1.0`. Findings at impact 0.54 with validity 0.857 or 0.714\nstayed advisory. On that path `impact` behaves as a **binary** (0.54 fires vs ~0.30 doesn't),\nand the real discriminator is validity, not the ordinal ladder.\n\n## 3. Hypotheses adjudicated\n\n- **(a) \"few findings, mostly advisory — axes never exercised near the threshold\"** —\n  **TRUE but it is the symptom, not the cause.** Median gap-to-threshold 0.65 confirms the\n  non-exercise; §2 explains why it is structural, not a volume artifact. Adding 10x the findings\n  would not move it.\n- **(b) \"threshold/aggregation crushes variance — mean-of-attributes dilution\"\n  (idea `neat-sooty-termite`)** — **CONFIRMED, and the ticket understates it.** It is not merely\n  that the mean dilutes a high-severity axis; it is that mean-of-4 against a 0.95 cut collapses\n  the whole 5-axis ordinal space into a 3-way AND satisfied 0 times in 3,738 gradings, with a\n  0.9175→0.95 dead zone. **This is the root cause.**\n- **(c) \"reviewer genuinely finds little (fleet effect: clean changes)\"** — **REFUTED as the\n  primary cause.** 3,839 findings, 2.48/run, only 30% zero-finding runs, 183 self-labeled\n  major/critical. The reviewer finds plenty; what is rare is *blocking*, not *finding*. (A\n  fleet effect may well contribute to severity being mostly `minor` — 2,161 of 3,839 — but it\n  cannot explain 183 major/critical findings passing.)\n- **(d) \"reviewer under-reports (prompt/calibration reluctance)\"** — **REFUTED for severity\n  labelling.** The model applies `critical`/`major` freely and its labels are simply not\n  consulted by the gate. The weekly series shows **no reporting decay**: advisory/run runs\n  2.91 (W28), 2.07, 1.10, 1.73, 2.01, 2.20 (W33) — stationary, no step-down after any\n  calibration/prompt/routing commit. The rise in blocking (W32: 21, W33: 10, vs 0–8 before) is\n  fully attributable to the **DET** criteria `secret-detection` and `bugfix-size-attestation`\n  first appearing in W32 (commit `1920dc9fe5` \"Escalate big bug fixes to real review\") — i.e.\n  the gate got teeth from *deterministic* checks, not from LLM severity.\n  A separate *recall* question remains open (round-2 measured Nova Pro at ~50–57% blocking-\n  criteria recall on plan-review), but under-reporting is **not** why the axes are inert.\n\n**Verdict: (b) is the cause; (a) is its symptom; (c) and (d) are refuted as primary.**\n\n## 4. Recommendation on Phase 3 — do NOT proceed as scoped\n\nThe migration plan's post-audit note concludes \"Phase 3 is UNBLOCKED and LOW-RISK: code-review's\nordinal ladder carries almost no decision weight … so its migration or simplification can\nproceed.\" **That inference does not hold on this evidence.** The ≤0.77% flip rate measures a\nladder wired to a decision that is switched off — it is evidence of *disconnection*, not of\n*uninformativeness*. You cannot conclude an instrument is uncalibrated by reading it while it\nis unplugged. Migrating ordinals→kind-sets under that measurement would:\n\n1. **Bake in the defect.** A kind-set reconstruction validated against \"flips ≤0.77%\" is\n   validated against a constant function. Any kind set — including a random one — passes.\n2. **Spend the change budget on the wrong layer.** The ordinal encoding is not what makes\n   code-review pass everything; routing (`blocking_enabled=False` on 98.2%) and an unreachable\n   0.95 cut are.\n3. **Make the real defect harder to see later**, by rewriting the very fields that currently\n   document it.\n\n**Sequence instead:**\n\n- **P3.0 (zero-LLM, do first) — fix the threshold/aggregation, then re-measure.** Either lower\n  the non-security cut into the attainable range (the corpus p99 is 0.60; the 0.9175 ceiling\n  means anything above ~0.92 is a no-op), or replace mean-of-4 with a max/floor rule so one\n  `high`+`system` axis is not averaged away by three `easy`/`local` ones. Decide separately\n  and deliberately **which criteria should be blocking-enabled** — today it is exactly one.\n  This is a policy question for the operator, not a modelling one.\n- **P3.1 — re-run `code_decisiveness.py` against the corrected decision rule.** Only then does\n  the flip rate mean anything. If the axes still flip <1% *with a live threshold*, the\n  ordinal→kind-set migration is justified and cheap. If they flip materially, Phase 2's\n  \"reconstruct levels deterministically\" discipline applies here too.\n- **Phase 3 as currently written: hold.** Not \"pointless\" — **premature and, on the current\n  justification, actively wrong.**\n\nCheap intermediate sanity check, zero-LLM: replay the 183 existing `major`/`critical` LLM\nfindings through a candidate decision rule and inspect how many *should* have blocked. No new\ninference calls; the findings and their axes are already recorded.\n\n## 5. If you still want an under-reporting probe (not needed for Phase 3)\n\nUnder-reporting is refuted for *labelling*, but *recall* is untested for code-review. Cheapest\nconfirmation: replay N historically-defective changes through `review-code` and count catches.\nSourcing gold: commits that were later reverted, or whose ticket has a `discovered_from` child\nfiled as a bug against them. At the measured **$1.42/run** code-review cost, **N=20 ≈ $28**,\n**N=30 ≈ $43** (single epoch; double for 2-epoch stability). Recommend **N=20, one epoch, ~$28**\n— and only *after* P3.0, since a recall probe against a gate that cannot block measures the\nfinder in isolation and tells you nothing about the gate. **Not run; approval required.**\n\n*(Analysis-only. Zero LLM calls. Scripts are ad-hoc re-scores through the shipped `impact()`;\nmethod matches round2/code_decisiveness.py with the field-shape correction applied.)*","timestamp":1786532129700991001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"DEPRECATION REMOVAL-READINESS SURVEY (2026-08-12) — analysis only, no code change, no claim.\n\nScope: \"what was deprecated in prior releases that we can now remove?\" Surveyed rebar._deprecations (the central registry), docs/ + CHANGELOG.md + docs/release-notes.md + docs/api-stability.md + docs/migrations.md, ADR 0050, the tracker, and live origin/tickets store data (81,840 commits; 1,884 active SNAPSHOT blobs audited).\n\n== HEADLINE ==\nNOTHING with a recorded removal condition has met it. rebar is at 0.11.0 (tag v0.11.0, 2026-08-06); EVERY scheduled deprecation in the registry carries remove_in=\"v1.0.0\" (_deprecations.py:47, _MAJOR), and v1.0.0 has not shipped. docs/api-stability.md:30 adds an independent floor: an alias survives at least one minor release AFTER its replacement ships. The two headline candidates shipped their deprecation IN v0.11.0, six days ago, so even that minimum floor is unmet — earliest legal removal is v0.12.0.\n\nThe one real lever is precedent, not schedule: docs/release-notes.md:226 and :249 record TWO completed \"pre-1.0 breaking\" passes (DE7, and ticket 5899's sibling pass) that removed scheduled shims EARLY, by operator ruling rather than at v1.0.0. So the actionable question for the operator is not \"which deprecations expired?\" (none) but \"do we open a third pre-1.0 breaking window, and what goes in it?\"\n\n== TIER 1 — READY TO REMOVE NOW (no policy conflict) ==\n\n1. The retired .gitattributes migration arm. src/rebar/_commands/init.py:600-616 + _RETIRED_GITATTRIBUTES_LINES at init.py:69 strips the retired \".reconciler-* merge=ours\" line. Introduced bbfa1c1d9b (2026-07-05). This store ALREADY ran it: git log origin/tickets -- .gitattributes shows exactly two commits, the second being 826d5ae379 \"drop retired .reconciler-* merge=ours\"; the live blob contains only \".bridge_state/* merge=ours\". The arm is permanently unreachable here.\n   Size: ~15 LOC, one file. Risk: LOW but not zero — it is a convergence unit, so it still matters for any clone that has not swept since 2026-07-05. Verdict: READY, conditional on confirming no unswept pre-2026-07-05 clone. This is the only genuinely expired, genuinely dead thing found.\n\n== TIER 2 — REMOVABLE ONLY IN A NEW PRE-1.0 BREAKING WINDOW (operator call) ==\n\n2. The single-pass review surfaces (story 316a, alias common-middle-yearling, CLOSED). Three registry rows, _deprecations.py:112-114: CLI \"rebar review\", lib \"rebar.llm.review_ticket\", MCP \"review_ticket\". Deprecated 31f352d535 (2026-08-04); shipped in v0.11.0 (CHANGELOG.md:128-129 \"The deprecated single-pass rebar review operation was retired in favor of review-plan, verify-completion, and review-code\"). Recorded condition: remove_in=v1.0.0; docs/cli-reference.md:557 states \"Deprecated (story 316a; removal in v1.0.0)\".\n   IMPORTANT SCOPING FINDING: this is much smaller than it looks. The single-pass ENGINE _review_ticket_impl must STAY — it has three live internal consumers: src/rebar/_mcp_llm.py:92-95, src/rebar/llm/review_workflows.py:86, src/rebar/llm/evals/eval_solver.py:348. So removal deletes only three thin public entry points (the warn-and-delegate wrapper at llm/operations.py:135-183, the CLI intercept at _cli/__init__.py:513 + _llm_commands.py:133, and the MCP tool at _mcp_llm.py:61). schemas/review_result.schema.json also STAYS (still the engine's output contract).\n   Size: MODERATE — 42 non-impl refs in src, 24 in docs, 19 test files. Risk: LOW internally; the only real exposure is an external importer of rebar.llm.review_ticket, which is exactly why 316a chose announce-then-remove.\n   Verdict: NOT YET on policy (deprecation is 8 days old and shipped in the current release). Strongest candidate for the next breaking window.\n\n3. REBAR_LLM_MODEL / llm.model. _deprecations.py:101, deprecated 1fbfb5c691 (2026-08-01), also in v0.11.0. A SUPERSESSION (not a rename) by the [tool.rebar.llm.model_classes] slots, which landed 2026-07-31 (4559258b98). Condition recorded by the parent story (eb58, alias fiendish-communal-cuttlefish, CLOSED): \"DEPRECATED with a migration window rather than kept as a permanent alias\", remove_in=v1.0.0. docs/env-vars.md:66 and docs/config.md:317 both state the window.\n   Size: SMALL (one registry row, the alias resolver in config.py, llm/config.py, llm/model_classes.py). Risk: LOW.\n   Verdict: NOT YET — 11 days old, shipped in the current release. Second candidate for the window.\n\n== TIER 3 — NOT YET, BLOCKED ON A NAMED CONDITION ==\n\n4. The resolved_statuses keys. Deprecation landed TODAY (72a57c30ab / 77cdff2cdd, 2026-08-12). CRITICAL DISTINCTION — there are TWO keys and only one is inert:\n   - reconciler.resolved_statuses (_config_schema.py:465) is LIVE, read by the Jira Data Center adapter (adapters/jira_datacenter/settings.py:101 -> backend.py:303). NOT a removal candidate. The \"inert\" language in docs/user-guide.md:498 does NOT apply to it.\n   - jira.resolved_statuses (_config_schema.py:490) is the inert one; its only consumer (adapters/jira/probe.py) was deleted with the dormant inbound absence-probe port (task f020, commit b95c097fd4 2026-08-12).\n   Decision ticket restful-chaseable-macaw (549c-032f-6cb0-4258, task, in_progress): \"DECISION: deprecate (option 1), do NOT remove now\". Hard-removal follow-up salted-growable-murrelet (f408-64ad-ee41-46b6, task, open) is \"deliberately BLOCKED ON OPERATOR SIGN-OFF\", first AC \"operator sign-off for the removal is recorded on this ticket\" — unchecked, ticket has zero comments.\n   Verdict: NOT YET — approval-gated AND release-gated, deprecated hours ago.\n\n5. fastmcp / mcp 2.0 (epic bared-nickel-insect, 732b-51df-acf2-477b, status idea). Correcting the premise: the standalone fastmcp package is NOT a dependency at all. rebar uses the BUNDLED mcp.server.fastmcp from the official SDK, pinned mcp>=1.28.1,<2 (uv.lock resolves 1.29.0), and only as the optional [mcp] extra. It is not deprecated in-repo — the opposite: ADR 0050 (docs/adr/0050-mcp-optional-auth-resource-server.md:25-30) explicitly evaluated and REJECTED the standalone fastmcp auth stack (\"semver-exempt and has its own CVE history\"). That is a recent Accepted decision, not drift.\n   Real risk to record: in mcp 2.0.0 the mcp.server.fastmcp path is REMOVED (FastMCP renamed to MCPServer under mcp.server.mcpserver). The <2 cap fences it off today, but all six import sites (mcp_server.py:578, scripts/gen_mcp_reference.py:79, and 4 tests) are hard blockers for a future 2.x bump.\n   Ticket's recorded condition: \"stay on mcp>=1.28.1,<2 for now; execute this ticket once mcp 2.0.x has a patch release or two rather than migrating on a .0\" (2.0.0 shipped 2026-07-28).\n   Verdict: NOT YET — upstream-maturity gated, and nothing here is a removal anyway; it is a forward migration.\n\n6. Event-schema / reducer compat folds — NOT REMOVABLE, essentially permanently. Audited all 1,884 active snapshot blobs. Live old shapes persist in immutable history:\n   - creation_channel re-inference (_processors.py:756-769, :147-175): 1,118 / 1,884 active snapshots hold creation_channel \"unknown\". Very hot.\n   - FILE_IMPACT tri-state (_processors.py:689-694): 265 / 1,884 lack file_impact_scope.\n   - plan_review_phase bootstrap (_processors.py:696-709): 155 / 1,884 lack it.\n   - Legacy-Jira envelope fingerprint (_version.py:146-147): the only provenance signal for pre-2026-07-17 Jira imports.\n   - 19-digit-ns filename ordering (_store/hlc.py:20-23, reducer/_sort.py:4): the earliest live event filename is 1780980854246350000-..., so every pre-2026-06-17 name is that shape. Permanent.\n   - frame_key -> step_id fallback, EDIT.tags whole-field handling: v1 events are immutable.\n   These read append-only git blobs on origin/tickets that will never be rewritten; and compaction deliberately never deletes a superseded SNAPSHOT (.retired is retained, docs/event-schema.md:159-161, _replay.py:191), so old-shape snapshots persist regardless. Removing any of these would silently mis-project ~1,100 tickets. Verdict: NOT REMOVABLE.\n   One narrow exception worth naming: the attestations fold-in inner body (_processors.py:727-735, duplicated at reducer/_cache.py:99-106) is COLD — 588 snapshots enter the branch but ZERO carry a signature dict to fold, because task 352b hardcoded the mirror-strip in compact.py. docs/migrations.md:257-260 already anticipates this and deliberately KEEPS it: safe to remove \"only once no snapshot predating the attestations map remains in ANY store\" — unverifiable for foreign clones. Verdict: NOT YET, and cheap to keep.\n\n7. Ensure-registry: NO retirable migration shims. Six units (env-id, gc-config, merge-ours, gitattributes, gitignore, store-compat). It is School B — convergent desired-state, no version ledger (docs/migrations.md:10-13) — so \"target state is now universal\" means a unit reports ok, NOT that it is deletable. env-id / gc-config / merge-ours write per-clone local state and can never be no-ops. Only the gitattributes strip ARM is dead (item 1 above).\n\n== TIER 4 — NEEDS OPERATOR DECISION (deprecated by policy, no recorded condition) ==\n\n8. 4-digit / two-quad short-ID acceptance (_ids.py:53 _SHORT_ID_RE, resolution at :256). Operator policy is \"aliases preferred, don't break, don't advertise\" — there is NO registry row, NO removal condition, and no tracker ticket (searched: \"short id\", \"4-digit\"). Usage evidence: all 60 most-recent commit trailers use the FULL 19-char canonical id; zero short-form; 1 of 40 recent subjects used a 4-hex prefix. So the path is effectively unexercised in identity-sensitive artifacts but remains a convenience input for CLI resolution. Verdict: NEEDS OPERATOR DECISION — removing it is a user-visible input break with no announced window, which would contradict the announce-then-remove precedent.\n\n9. Undocumented CLI compat aliases with no registry row and no window: verify-authorship (back-compat alias for verify-identity, _cli/__init__.py:565, documented in docs/exit-codes.md:191) and bridge-status (hidden alias, _cli/__init__.py:121-122, docs/user-guide.md:394). Neither is registered, so neither has a scheduled removal. Verdict: NEEDS OPERATOR DECISION — if we want these gone they must first be REGISTERED and announced, not silently deleted.\n\n== EXPLICIT NON-CANDIDATES (do not remove) ==\n- The 8 PERMANENT registry rows (_deprecations.py:81-91): REBAR_NO_SYNC, COMPACT_THRESHOLD, SCRATCH_BASE_DIR, REBAR_ACLI_TIMEOUT, RECONCILER_ABSENT_GET_BUDGET, REBAR_ID_GUARD_MODE, REBAR_VERIFY_OVERLAP_ENABLED, verify.overlap_enabled. These are ergonomic RENAMES kept forever by design; removing them buys nothing.\n- The tombstone registry (_deprecations.py:203-236): already-removed inputs kept as fail-loud migration errors. Deleting a tombstone would re-silence a removed load-bearing input. Keep.\n- _store/compat.py: FORWARD-compat (refuses to mutate a store written by a newer binary). Not backward-compat cruft.\n- reducer forward-compat unknown-event skip (_replay.py:188-195): protects against newer clones. Structural.\n\n== REGISTRY HYGIENE (a positive finding) ==\nThe deprecation registry is complete and trustworthy. warn_deprecated raises KeyError on an unregistered surface, and tests/unit/test_deprecation_registry.py source-scans for raw emissions bypassing it. Independent verification: the only warnings.warn in src/rebar outside _deprecations.py is llm/prompting/prompts_frontmatter.py:172, which is an unknown-frontmatter-key warning, not a deprecation. docs/env-vars.md (generated) likewise lists exactly one deprecated env with a window. So this survey's registry-derived inventory can be treated as exhaustive for signalled surfaces.\n\n== RECOMMENDATION ==\nRemove now: item 1 only (tiny). Everything else is a scheduling decision. If the operator wants to bank the cleanup, the cheapest high-value move is to open a third pre-1.0 breaking window at v0.12.0 carrying items 2 and 3 together (both are v1.0.0-scheduled supersessions, both are small once you know _review_ticket_impl stays, and both would then satisfy the one-minor-release floor). Items 4-7 should not be touched; items 8-9 need an announce step before they are removable at all.","timestamp":1786565507315994001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AWS alarm sweep 2026-08-12T04:00Z → 22:45Z (read-only; CloudWatch describe/get + SSM read-only journalctl on i-00880b2c7f13527c5; nothing mutated in AWS or on the box).\n\nSCOPE. 14 metric alarms, 0 composite alarms; all 14 are OK right now. describe-alarm-history (StateUpdate) over the window returns 8 items, of which 3 are transitions INTO ALarm. The other 5 are recoveries and the two INSUFFICIENT_DATA→OK settles of the newly-created reason-scoped pair.\n\nFIRINGS.\n\n(1) rebar-autodeploy-review-interrupts [LEGACY alarm, deleted ~11:40Z] — ALARM 04:01:26Z, recovered 04:16:26Z. Driving datapoint 03:46Z bucket Sum=1. Journal marker 2026-08-12T03:59:33Z: reason=bound-exceeded, in_flight=1, deferred_for=1820s, bound=1800s, target=57d19254. TRUE POSITIVE. Boundary case: the underlying event is at 03:59:33Z, inside the greasy-plucky-piranha window that closed ~04:00Z, so this is the tail of the 4 already-triaged-and-accepted firings; only the alarm evaluation landed 86s after the baseline. Alarm behavior correct, keep as-is.\n\n(2) rebar-autodeploy-review-interrupts [LEGACY] — ALARM 08:27:26Z, recovered 08:42:26Z. Datapoint 08:12Z bucket Sum=1. Journal marker 08:26:14Z: reason=bound-exceeded, in_flight=1, deferred_for=1810s, bound=1800s, target=1791436c. TRUE POSITIVE, genuinely new since baseline. Same class as the accepted piranha findings: the drain check WORKED, DEPLOY_DEFER_MAX was spent with a review still in flight, deploy proceeded and killed it. Alarm behavior correct, keep as-is.\n\n(3) rebar-autodeploy-review-interrupts-bound-exceeded [NEW alarm, junco/1650] — ALARM 19:38:49Z, recovered 19:53:49Z. Datapoint 19:23Z bucket Sum=1. Journal marker 19:34:44Z: reason=bound-exceeded, in_flight=1, deferred_for=1930s, bound=1800s, target=f6f31dfd. TRUE POSITIVE, genuinely new. First real firing of the replacement alarm; it fired for the right reason with the right reason-scoped attribution. Alarm behavior correct, keep as-is.\n\nNo other alarm changed state in the window. rebar-autodeploy-review-interrupts-signal-unavailable never fired (it settled INSUFFICIENT_DATA→OK at 11:42:21Z and has stayed OK).\n\nNEAR-MISS / NEW DEFECT (no firing, but a fabricated metric emission).\nAt 09:48:03Z the observability probe published in ONE run: review_interrupts_bound_exceeded=7 and review_interrupts_signal_unavailable=1. Both landed in the single minute 09:48Z (period-60 query confirms). No matching events occurred then. Evidence: journal retention reaches back to 2026-07-03T19:50:40Z, so nothing rotated away; full-journal totals are bound-exceeded=8 and signal-unavailable=1; the ONLY signal-unavailable marker in the entire journal is 2026-08-04T00:36:41Z, i.e. 5.5 days older than the run that published it as 'new this interval'.\nMechanism: infra/scripts/observability.sh publish_autodeploy_marker_delta() converts a cumulative full-journal grep -c into a per-interval delta via a persisted offset file, with prev defaulting to 0 when the file is absent. The reason-scoped counters were brand new, so their first run computed new = total = all retained history. The helper already clamps the OPPOSITE direction (negative delta / lost history, per bug 2dc7-31b7-ecbb-4cd2 and the 1648 rotation double-count clamp); the cold-start case (offset ABSENT rather than journal SHRUNK) is the complementary gap and is unguarded.\nWhy it did not page: the two alarms were created at 11:40:58Z, ~2h AFTER the 09:48:03Z probe run. That ordering is luck. Under the usual terraform-then-deploy order both 1-datapoint latches would have fired instantly off stale history — including the signal-unavailable alarm, whose own description calls it 'the URGENT one ... EVERY deploy is running blind', from a single already-resolved 2026-08-04 event.\nClassified FALSE-POSITIVE-GENERATING metric defect, not an alarm-threshold problem: the alarm predicate is right to fire on a nonzero count, the count was fabricated. Filed as bug widespread-zealous-narwhal (e2a6-9ee4-8d5c-4290), open/unclaimed, file impact infra/scripts/observability.sh. Latent for every future counter added to the shared helper and for any offset-file loss (fresh /var/lib/rebar, host rebuild, disk restore); the same open-coded shape exists in sections 3 (replication_errors), 4 (voter_errors) and 4b (g2p_dispatch_errors).\n\nNOISE RATE for the piranha 'accepted, retune only if pager noise becomes a problem' disposition, so it can be revisited with data rather than quietly loosened:\n  Aug 1–11 (11 days): 6 review-interrupt firings — 08-04T00:09:45Z, 00:38:45Z, 01:45:45Z, 08-07T11:33:14Z, 12:55:14Z, 08-12T03:08:26Z ≈ 0.55/day.\n  Aug 12 alone (00:00–22:45Z): 4 firings — 03:08:26Z, 04:01:26Z, 08:27:26Z, 19:38:49Z ≈ 10x the preceding rate, matching the 60+-merge landing burst.\nAll four Aug-12 journal markers cleared the bound by a hair: deferred_for 1810s / 1820s / 1810s / 1930s against bound=1800s, i.e. 10s, 20s, 10s and 130s over. Every one of them was a review that finished (or would have) shortly after the deferral budget expired. That points at DEPLOY_DEFER_MAX being marginally undersized for current review durations, NOT at the alarm being too sensitive — a bound raise is a fix to the true-positive CAUSE, not a threshold loosening, and would plausibly have prevented all four interrupts.\n\nCORRELATION WITH KNOWN CONTEXT.\n  - JIRA_API_TOKEN expiry (until ~18:30Z, healthy run 18:34Z): produced ZERO alarm firings. rebar/host:voter_errors was 0 across the entire window, and the rebar/host namespace has no reconcile/bridge counter at all (19 metric names, none bridge-related). So bridge auth failure is currently invisible to CloudWatch. Coverage gap — recommendation only, no change made.\n  - Alarm replacement (junco/1650): confirmed. Both reason-scoped alarms carry AlarmConfigurationUpdatedTimestamp 2026-08-12T11:40:58Z and settled out of INSUFFICIENT_DATA at 11:41:49Z / 11:42:21Z. The legacy rolled-up alarm is gone from describe-alarms; its metric review_interrupts is still published (offset 9 = 8 bound + 1 signal), so pre-split history stays readable as designed.\n  - Rotation double-count clamp (1648): not implicated in any firing; it is the sibling guard to the cold-start gap that IS implicated.\n  - Heavy overnight CI/agent activity: consistent with the 10x interrupt rate; no load-metric alarm (disk, EC2 checks, bedrock, g2p, replication, mirror, merge-change) moved at all.\n\nBOTTOM LINE: 3 firings, all TRUE POSITIVES of the same known bound-exceeded behavior — no alarm should be tuned for any of them. 1 new latent false-positive defect in metric emission, filed. 2 operator decisions surfaced: whether to raise DEPLOY_DEFER_MAX, and whether to add bridge/reconcile alarm coverage.","timestamp":1786574909504428001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"ADDENDUM — follow-up firing pair triaged, 2026-08-12T23:07Z (read-only throughout).\n\nFIRINGS (4) and (5).\n  rebar-gerrit-voter-errors            ALARM 23:07:07Z -> OK 23:13:07Z, datapoint 23:06Z Sum=1\n  rebar-review-bot-merge-change-errors ALARM 23:07:18Z -> OK 23:13:18Z, datapoint 23:06Z Sum=1\n\nBOTH ARE FALSE POSITIVES. No voter error and no merge-change error occurred. Both counts trace to a\nSINGLE journal line at 2026-08-12T23:02:26Z (CONTAINER_NAME=compose-review-bot-1) which is the\nreview-bot's own LLM code-review analysis prose, verbatim:\n\n    ...mits matching markers for every target (VOTER_ERROR, MERGE_CHANGE_ERROR, AUTODEPLOY_ERROR,\n    AUTODEPLOY_DEFERRED, gerrit_to_platform error, both interrupt reasons) and REPL_LOG is\n    populated. The rolled-up review_interrupts per_interval=2 arithmetic is consistent\n    (total 14 seeded, next run +2)\n\nNothing redacted; the line contains no secret. The reviewer was reviewing a change to\ninfra/scripts/observability.sh ITSELF — the cold-start seeding fix for widespread-zealous-narwhal\nfiled earlier in this same sweep — so it enumerated the marker vocabulary as prose, and the probe\ncounted that prose as two errors.\n\nMECHANISM. observability.sh sections 4 and 4c count markers with an UNANCHORED grep over the\nreview-bot container journal (grep -cE 'VOTER_ERROR' / 'MERGE_CHANGE_ERROR'). The review-bot writes\nits LLM output to that same stream, so the probe cannot distinguish its own alarm vocabulary from an\nactual error.\n\nPROOF IT IS NOT A REAL MARKER (full-journal counts; real markers are line-start under -o cat):\n  VOTER_ERROR        line-start real: 221   substring-anywhere: 222   offset file: 222\n  MERGE_CHANGE_ERROR line-start real:   0   substring-anywhere:   1   offset file:   1\nExactly one of the 222 voter counts is the false match. The merge-change counter has NEVER recorded\na real error in the entire retained journal — its ONLY count in history is this false positive, and\nthat is what fired its alarm.\n\nCOORDINATOR HYPOTHESIS REFUTED. The proposed cause (a patchset superseding a mid-review change 409ing\nthe bot's vote or merge call, amid the 1684-1688 push/review activity) does not hold: there is no\n409, no conflict and no Gerrit 4xx/5xx of any kind in 22:45-23:20Z. The trigger was textual, not a\nGerrit interaction.\n\nRECOVERY / STATE. Nothing was left in a bad state and nothing needed retrying, because nothing\nfailed. The review-bot voted normally before, during and after the alarm window — voter_voted at\n23:05:08Z, 23:13:04Z, 23:19:38Z. The counters 'self-cleared' only because the offset absorbed the\none-time count; that is arithmetic, not recovery. Side effect: the offset files are now permanently\ninflated by the false count (voter offset 222 vs 221 real markers).\n\nCLASSIFICATION: NEW DEFECT, and the alarms are NOT at fault — both are correct to fire on a nonzero\ncount; the count was fabricated. Do not tune either alarm. Filed as colossal-slothful-grouse\n(8c2f-8377-5044-4650), open/unclaimed, file impact infra/scripts/observability.sh.\n\nRELATION TO widespread-zealous-narwhal: same false-positive FAMILY (probe publishes counts for\nnon-events) but a DISTINCT mechanism — narwhal is an absent-offset cold start, grouse is an\nover-broad pattern matching the token as data. Both in observability.sh.\n\nRECURRENCE RISK IS ACTIVE AND SELF-REFERENTIAL. The trigger is any review that discusses\nobservability.sh or the marker vocabulary, and the fleet is landing observability.sh changes right\nnow (the narwhal fix is in review — its review text is literally what fired this). Expect these two\nalarms to re-fire on each further review of that file until grouse is fixed.\n\nRUNNING TALLY for this sweep: 5 firings since the 04:00Z baseline — 3 true-positive bound-exceeded\nreview interrupts (no tuning warranted) and 2 false positives from probe-side defects; 2 new bugs\nfiled (widespread-zealous-narwhal, colossal-slothful-grouse), both in infra/scripts/observability.sh.","timestamp":1786576977056432001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RECORD-PLACEMENT INDEX + operator anti-pattern ruling (2026-08-12). No comment deleted — the store is append-only and the originals stay exactly where they are; this comment redirects future readers to the durable home of each record.\n\nOPERATOR RULING. This ticket accumulated cross-cutting ops and analysis records that had nothing to do with its own deliverable. Verbatim: \"why are we storing this information in a scratchpad ticket rather than in a rebar session log or in the tickets we are using to actually complete the work? this smells like an anti-pattern.\" It is an anti-pattern, and future sessions must not repeat it. The rule going forward: a session-scoped investigation belongs in a `rebar session-log`; a record that informs a specific piece of work belongs as a comment on the ticket doing that work; a work ticket's comments are for ITS deliverable only.\n\nWHERE EACH RECORD NOW LIVES. Session log for this bug-bash session's ops/analysis records: cosey-vinegarish-mouflon (d0d8-9dfe-f2d8-4364).\n\n- Comment 10 (2026-08-12T10:55:29Z) — \"Why the code-review severity axes are inert\", zero-LLM root cause over 1,545 code_review sidecars. Class: session-scoped analysis. -> session log entry 1 (full copy). Pointer also posted on fixable-angular-caribou, the ordinal->kind-set migration story, because the pending P3.0 blocking-lane decision (which criteria should be blocking-enabled, and the threshold/aggregation fix) references this analysis; it has no better single owning ticket than the session log.\n- Comment 11 (2026-08-12T20:11:47Z) — deprecation removal-readiness survey. Class: session-scoped analysis with per-item work owners. -> session log entry 2 (summary, with the Tier 1-4 findings preserved). Per-item cross-reference comments posted on the tickets that acted on it: checked-unhelpful-tanager (Tier 1 gitattributes arm), priceless-charred-fruitbat (single-pass review surfaces, incl. the finding that _review_ticket_impl must STAY), slowmotion-stricken-mare (REBAR_LLM_MODEL supersession), and salted-growable-murrelet (the LIVE reconciler.resolved_statuses vs inert jira.resolved_statuses distinction, for its pending operator sign-off).\n- Comment 12 (2026-08-12T22:48:29Z) — AWS alarm sweep 04:00Z->22:45Z. Class: ops investigation. -> session log entry 3 (full copy) + substantive cross-reference on greasy-plucky-piranha (the alarm family's diagnostic home), with the acting tickets cross-referenced: unskillful-supportive-lion (the deferred_for 1810/1820/1810/1930s vs bound=1800s data supporting the bound raise) and unheedful-unfair-sloth (the JIRA_API_TOKEN expiry producing zero alarms — the bridge coverage gap).\n- Comment 13 (2026-08-12T23:22:57Z) — alarm sweep addendum, the 23:07Z false-positive firing pair. Class: ops investigation. -> session log entry 4 (full copy) + covered in the greasy-plucky-piranha cross-reference. Bugs already filed at the time: widespread-zealous-narwhal (e2a6-9ee4-8d5c-4290) and colossal-slothful-grouse (8c2f-8377-5044-4650), both in infra/scripts/observability.sh.\n\nWHAT CORRECTLY STAYS HERE (this ticket's own deliverable): comments 1-6, the cost-analysis experiment rounds 1-6; comment 7, the CloudWatch quantification of the Bedrock error blast radius — ops-flavored but explicitly attributable to the model-comparison experiments run UNDER this ticket and carried forward into the lever option book (the cheap-model-fails-silently alarm observation and the DeepSeek ceiling flag); and comments 8-9, the closeout and the recorded close-deferral disposition.\n\nSTATUS UNCHANGED. This ticket remains OPEN per comment 9's disposition, and its description was not edited (attestation currency).","timestamp":1786588815138840001}],"created_at":1786426084120149001,"creation_channel":"cli","deps":[],"description":"Analysis record (no code change). Measured gate economics 2026-08-03→08-11 from attested sidecars + usage logs; brainstormed and evaluated cost levers against history, OSS/academic research, and $52.70 of Bedrock experiments. Deliverables: reports/llm-gate-cost-2026-08-11/ (README + full HTML report + experiment arm outputs) and artifact https://claude.ai/code/artifact/a59a29df-f641-4c3f-b7b0-c6333314935f. Headline: plan-review $3.02/run (median $2.27), code-review $1.42/run, completion $2.24/run; $11.85 mean per ticket completed (2.1 plan + ~1.75 code + 1.2 completion runs); ~20% of spend on terminally-failed calls (overlap-judge 48k output overruns; completion-verifier ~190-request loop deaths). Top levers as initially assessed: fix the two failure pathologies (~15-20%, zero quality risk); the 696a AGENT→1-TURN demotion (proposed 15-30%, later determined RESOLVED-NO by 696a's own closing ledger and rejected by the operator as a quality decrease); per-criterion incremental re-review (proposed 15-25%, later REJECTED by the 894-pair historical audit); Nova pilot for single-turn ops (Nova Pro 29/30 gold, Nova 2 Lite 27/28 with zero gold-regressing flips vs committed Opus/Sonnet arms). Refuted: Haiku for agentic ops (5 false-accepts + loop runaway → cost 6x Nova Pro); Sonnet-for-code-review (2 gold-regressing over-blocks).\n\nLater rounds (recorded in comments + the report artifact) extended the analysis to the ordinal-migration question: the zero-LLM decisiveness analysis over 22,503 plan findings and 3,230 code-review findings, the level-collapse sensitivity result, and the phased ordinal→binary migration plan now recorded at reports/llm-gate-cost-2026-08-11/ordinal-migration-plan.md (AC3).\n\n## Acceptance Criteria\n\n- [x] Cost analysis published with per-gate and per-ticket figures. Verify:  exits 0.\n- [x] Experiment arm outputs recorded. Verify: reports/llm-gate-cost-2026-08-11/round2/cv2_haiku-4-5-20251001.json exits 0.\n- [x] Ordinal-migration plan recorded. Verify:  exits 0.\n\n## Verification\n\nThe deliverables are committed report files; each AC names its proving command. Analysis-only ticket: no code change, no file_impact.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"open","tags":[],"ticket_id":"b902-18af-14ed-4da1","ticket_type":"task","title":"LLM gate cost analysis since Bedrock switch: per-run/per-ticket costs, lever option book, cheap-model experiments (2026-08-11)","verify_commands":[]},"source_event_uuids":["cf857966-1a39-4f0a-be5e-5d8dbfcb562a","bc6e592d-1bf2-4f97-91df-ba7e4db7ef11","3f975c15-26c5-434a-8563-c6b48b32936c","5ed00726-4998-4abe-b966-b8d08cb0b1ba","49f6951e-c7fe-4a41-bf25-192ea5e7980c","4eb6d662-43a7-4242-ad99-93de17cc54f1","cb8fe475-a467-4b4c-9862-0fabaa75d251","ed79beea-177e-4d76-9bcc-c944db3b0837","f5938b67-fddb-465d-8ca2-e93804f1d20a","c91db495-2b5d-4fe9-b1d6-4c0451111d9e","f7c3db7f-9744-481e-b9ba-817db1dd379f","c520a3b8-ea35-495b-a93e-bdd07698a0f7","d447604d-e543-4582-8ed2-15a7af0ff944","2a596cd6-02a7-4fe6-8c33-a49fa578bd27","383a25a2-5faf-415e-9eef-0be5b15a81e1","6711ceb7-00ee-41d7-9029-c5a7a777c0d8","9d17fcec-352c-4a04-9520-ff960b9b50ba"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659654798553001,"uuid":"12734c30-7475-44f1-84b8-45390c589ef4"}