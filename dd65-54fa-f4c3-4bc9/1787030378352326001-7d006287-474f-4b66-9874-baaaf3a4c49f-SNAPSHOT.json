d25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f4fa27e740919c8bd903e6dcc9923233db2a2d0359435b8192fc4ec845214b1c","event_uuid":"b4ecb834-9a64-4e3a-85c1-c58a67cbdb58","position":{"commit_sha":"cfe690f19ce2188e1b3dcb7823198e36159dd8f5","position":"1787028232709841001-b4ecb834-9a64-4e3a-85c1-c58a67cbdb58"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787028210057535001,"creation_channel":"cli","deps":[{"link_uuid":"b4ecb834-9a64-4e3a-85c1-c58a67cbdb58","relation":"depends_on","target_id":"d0ec-da23-32ba-47c6"}],"description":"## Context\nThe rolling 5-of-10 breaker counts low-level noise and cannot distinguish an exhausted logical operation from its physical attempts. The approved replacement must stop only demonstrably unhealthy scopes without terminating work that historical jobs completed.\n\n## Outcome\nImplement an endpoint/provider finite-pass fuse over normalized coordinator outcomes. Endpoint opens after three consecutive eligible exhausted logical outcomes across at least two tickets; provider additionally requires two endpoint families. Matching success resets consecutive state.\n\n## Plan\n1. Count only exhausted logical outcomes eligible under the failure policy. Never count physical attempts, recovered warnings, permanent failures, ticket-local 404s, or opaque diagnostic text.\n2. Track endpoint consecutive outcomes and distinct tickets. Track provider scope only when failures span two endpoint families.\n3. Reset matching consecutive state on success; independent scopes retain their own state and continue.\n4. Preserve direct authoritative credential, configuration, quota, rate, issue, endpoint, tenant, provider, and global stop/defer behavior without inferring scope from text.\n5. When open, return explicit scope/reason/`retry_not_before` metadata; do not execute matching remaining plans.\n\n## Testing\nSequence tables pin threshold boundaries, exclusions, reset, two-ticket/two-family requirements, and independent scopes.\n\n## Acceptance Criteria\n- [ ] Endpoint fuse opens only after three consecutive eligible exhausted outcomes across at least two tickets.\n- [ ] Provider fuse additionally requires two endpoint families.\n- [ ] A matching success resets the consecutive state.\n- [ ] Physical attempts, recovered warnings, permanent failures, ticket-local 404s, and opaque diagnostics never increment inferred counters.\n- [ ] Independent scopes continue when another scope opens.\n- [ ] Open-fuse outcomes include exact scope, reason, and `retry_not_before`.\n\n## Out of scope\nProduction routing, batch tallies, and historical replay integration.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/pass_fuse.py","reason":"Endpoint/provider finite-pass fuse state and decisions."},{"path":"src/rebar/_engine/rebar_reconciler/failure_policy.py","reason":"Declare fuse-eligible normalized outcomes and authoritative scopes."},{"path":"tests/unit/rebar_reconciler/mutate/test_scoped_pass_fuse.py","reason":"Threshold, diversity, reset, exclusion, and isolation sequences."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","d0ec-da23-32ba-47c6"],["parent","28a3-a62d-6345-44a0"]],"no_file_impact_reason":"","parent_id":"28a3-a62d-6345-44a0","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp03","fuse","retry","tdd"],"ticket_id":"dd65-54fa-f4c3-4bc9","ticket_type":"task","title":"RP-03 S3 T2 — Implement the scoped finite-pass fuse","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/mutate/test_scoped_pass_fuse.py","dd_id":"AC1-AC6","dd_text":"Endpoint/provider thresholds, reset, exclusions, independent scope, and deferral metadata"}]},"source_event_uuids":["4ecdda90-bf70-4227-b9bc-1af55f7d7b20","bf359a9f-298f-40e0-8845-90c098685741","1c184c2c-e3b3-463d-911c-05200bea988c","b4ecb834-9a64-4e3a-85c1-c58a67cbdb58"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787030378352326001,"uuid":"7d006287-474f-4b66-9874-baaaf3a4c49f"}