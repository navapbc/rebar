 parent having been present at ENTER time, not at teardown time when the fresh import has definitely loaded it.","ABSENCE: no re-fetch of `sys.modules.get(parent_name)` in the finally to cover the parent-loaded-by-the-body case."],"finding":"_reimportable captures the parent package via sys.modules.get(parent_name) BEFORE the body imports the submodule; if the parent package is not already in sys.modules on enter, `parent` is None and the finally's `setattr(parent, attr, restored)` is skipped even though the body's fresh import loaded the parent and rebound its attribute to the fresh module — leaving the exact duplicate the context manager exists to prevent.","id":"0","impact":0.225,"location":"tests/unit/test_ensures_late_binding.py:55","norm_id":"n5890b9268a42daa3","priority":0.0643,"reason":"low-validity","scenarios":["A future caller uses _reimportable for a submodule whose parent package is not pre-imported when the CM enters; the body's fresh import rebinds the parent attribute, and teardown leaves the duplicate."],"severity":"none","suggested_fix":"In the finally block, replace the enter-time `parent` with a fresh lookup: `parent = sys.modules.get(parent_name)` before the `if parent is not None: setattr(...)`.","tier":"LLM","validity":0.2857,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","respects_artifact_altitude":"na","severity_claim_justified":"no"},"severity_attributes":{"blast_radius":"local","capability_degraded":false,"churn90":0,"contract_drift":true,"data_loss_without_recovery":false,"dead_code":false,"debt_impact":"low","escapes_automation":true,"forbids_contract_allowed_state":false,"hard_to_reverse_surface":false,"