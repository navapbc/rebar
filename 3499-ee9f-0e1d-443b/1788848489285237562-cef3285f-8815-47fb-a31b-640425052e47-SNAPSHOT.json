64e","position":"1788834585334568001-9ccfb855-ce61-4fe4-b659-5e2ba53e3e30"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"180ebce51146127ce10c717e4180bbd9605467b767c7b43f64ccc400cc0e3e61","event_uuid":"0edd1575-c1ff-462c-82d7-76cdd3d70fef","position":{"commit_sha":"87f35015ac869bfd463afbf4da7cd6f3151aa3ca","position":"1788835148854925001-0edd1575-c1ff-462c-82d7-76cdd3d70fef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"df232b74fb92fd380c2c7695ab63aeacad79f008f8fdb5780900cc0d1b1ff872","event_uuid":"8f4f22d7-cb42-44f1-8392-e4fcfc68bc7d","position":{"commit_sha":"f9a70542e72b7c8ae8075b0b15732b1da824cf31","position":"1788835175068628001-8f4f22d7-cb42-44f1-8392-e4fcfc68bc7d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan update/design decision: retain only the subject plus direct child/prerequisite rows in PlanRelationSnapshot.ticket_states_by_id after the transient whole-store relation discovery. Rationale follows common active OSS compiler/indexer practice: broad transient scan for discovery, minimal retained dependency slice for long-lived objects. This preserves consumers that only read prerequisite title/description plus generation/signing metadata, while removing unrelated ticket body retention.","timestamp":1788822018950136001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation evidence: consumer inventory is recorded in the plan description. RED test was tests/unit/test_plan_relation_snapshot.py::test_retained_snapshot_states_do_not_scale_with_unrelated_store; it failed before the production change because unrelated store rows remained in ticket_states_by_id, and passes after retaining only subject/direct child/prerequisite rows. Real-store measurement on this checkout (9,081 tickets) with comparable tracemalloc/deep-size probes: legacy retained all-state map 256,646,460 bytes with 257,578,139-byte peak; new collect peak 259,876,851 bytes (transient compile unchanged) and retained snapshot 37,046 bytes across 1 retained row for this ticket. Focused consumer tests passed: 58 passed across plan relation snapshot, production batch runner, sidecar, generation scope, and sign transaction. make verify reached the known Copilot GIT_CONFIG repo-isolation artifact only; rerun solo with injected GIT_CONFIG_* unset passed.","timestamp":1788825730077806001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Parked pending external review-bot gate: Gerrit change 2807 has Verified+1 and no unresolved comments, but LLM-Review remains 0 after the allowed rerun-llm-review trigger comment. No code finding is available to remediate. Leaving the change unmerged/unclosed until the bot casts LLM-Review+1; proceeding to the next requested ticket rather than force or self-approve.","timestamp":1788830085336103001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change 2807 now has Verified +1 and LLM-Review +1 with no unresolved comments. Submitted successfully; closing against merged revision 94c42343c1ba4546537e023f80d019ccfcd25014.","timestamp":1788834072907336001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Checked acceptance criteria before close: AC1 consumer inventory is in the implementation-plan inventory and preserved by tests; AC2 real-store measurement was recorded during implementation (legacy retained 256,646,460 bytes; new retained 37,046 bytes on 9,081-ticket store, peak unchanged transiently); AC3 RED/green regression is tests/unit/test_plan_relation_snapshot.py::test_retained_snapshot_states_do_not_scale_with_unrelated_store; AC4 focused relation-snapshot/generation/signing/sidecar tests passed, with make verify failing only the known Copilot GIT_CONFIG_* repo-isolation artifact confirmed by solo rerun.","timestamp":1788834585334568001}],"completion_expectation":"required","created_at":1788638948988719763,"creation_channel":"mcp","deps":[{"link_uuid":"678dbd7f-4cd4-4e4d-9805-dda4ba1d68e5","relation":"discovered_from","target_id":"9ea3-7d07-ea55-4496"},{"link_uuid":"4050d0f8-41a9-491e-a2d9-922bff833c51","relation":"relates_to","target_id":"83e8-2405-914c-425b"}],"description":"Discovered while proving the MCP OOM root cause on witted-invisible-roan (9ea3-7d07-ea55-4496). Shares that bug's root cause — whole-store materialization — but is a DIFFERENT and worse retention profile, and its contribution was NOT separately measured, so it is filed rather than folded into that fix.\n\n## Observed\n\n`build_plan_relation_snapshot` calls `reduce_all_tickets` with all three filters OFF — the MAXIMAL compile, including verbose `session_log` and `code_review` bodies:\n\n- `src/rebar/llm/plan_review/relation_snapshot.py:257-262` — `exclude_archived=False, exclude_deleted=False, exclude_session_logs=False`.\n- The result is fanned into `states: dict[str, dict]` (`relation_snapshot.py:268`) and returned as `PlanRelationSnapshot.ticket_states_by_id` (frozen dataclass field, `relation_snapshot.py:65`).\n- That snapshot is held by `PlanReviewGeneration.relation_snapshot` (`src/rebar/llm/plan_review/generation.py:48`) and threaded through the whole multi-pass review, captured by the fan-out closures (`plan_review/pass1.py:434`, `plan_review/container_stage.py:259`, `plan_review/generation.py:154`).\n\n## Why this is worse than the read-path case\n\nOn the read path the whole-store compile is a TRANSIENT — measured 243.4 MB on this store (8,879 tickets), released as soon as the call returns. Here it is **retained for the full duration of a plan review**, which `AGENTS.md` documents as 15-20 minutes. Concurrent reviews therefore stack: N overlapping reviews hold N copies simultaneously, and on the 7.6 GiB box the MCP container shares the host with Gerrit, the review-bot and opcert.\n\nMeasured on the real store for the equivalent compile: 243.4 MB per snapshot held. Ten to nineteen overlapping reviews reproduces the reported 368 MiB -> 4.5-4.8 GiB curve on its own, which is consistent with the reported busy window (\"six changes under review, several agents pushing patchsets\").\n\n## Why it is not fixed by the 9ea3 change\n\nThe fix landing on 9ea3 adds an `omit_fields` projection applied INSIDE `reduce_all_tickets`' per-ticket loop, and uses it from `list_states` and `find_ready_tickets`. It deliberately does NOT touch this call site: unlike the discovery reads, the plan reviewer may genuinely consume the bodies and signature material of related tickets, so which fields (if any) are droppable here needs its own analysis and its own measurement.\n\n## Implementation Plan\n\nUse the documented best-practice default for this small design fork: retain only the subject and\nits directly material related tickets in the long-lived `PlanRelationSnapshot.ticket_states_by_id`\nmap, and drop unrelated whole-store states before the snapshot is returned. This mirrors common\nactive OSS compiler/indexer practice: build a broad transient index when discovery needs it, then\nstore only the minimal dependency slice in the durable/long-lived object handed to later phases.\nIt preserves review behavior because the broad `states` map remains available inside\n`collect_plan_relation_snapshot` while resolving aliases, enumerating children/prerequisites, and\ncomputing material pins; only the returned retention payload changes.\n\nConsumer/field inventory to preserve:\n\n- `generation.from_snapshot` reads `subject_state`, `child_ids`, `related_material`, and\n  `ticket_store_revision`; it carries `relation_snapshot` but does not read unrelated rows from\n  `ticket_states_by_id`.\n- `plan_review.__init__` builds prerequisite review blocks from\n  `ticket_states_by_id[prerequisite_id].title` and `.description`.\n- `production_batch_runner.ProductionBatchRunner.run` consumes preloaded relation snapshots for\n  prerequisite focused review and reads `ticket_states_by_id[prerequisite_id].description`.\n- signing/resign/sidecar paths inspect the snapshot object or its related-material pins; they do\n  not require unrelated ticket states.\n\nFile impact is limited to the relation snapshot collection path and focused unit tests that pin\nretention scaling and consumer compatibility.\n\n## Acceptance Criteria\n\n- [x] AC1: every consumer of `PlanRelationSnapshot.ticket_states_by_id` is enumerated with citations,\n      and the set of fields each actually reads is recorded.\n- [x] AC2: peak and retained memory of a plan-review generation is measured on a real-sized store,\n      before and after, under comparable load; the contribution of THIS site is established\n      separately rather than bundled with the 9ea3 read-path fix.\n- [x] AC3: a held-out regression test asserts the retained snapshot does not scale with whole-store\n      size, verified RED before the fix and RED again when the fix is perturbed.\n- [x] AC4: `rebar review-plan` verdicts are unchanged; fixture review/prompt consumers keep the same\n      subject, child, prerequisite, and material-pin inputs before and after.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/plan_review/relation_snapshot.py","reason":"Drop unrelated whole-store states from the retained PlanRelationSnapshot after relation discovery and material-pin computation."},{"path":"tests/unit/test_plan_relation_snapshot.py","reason":"Pin the snapshot retention contract, consumer fields, and unrelated-store scaling regression."},{"path":"tests/unit/workflow/test_production_batch_runner.py","reason":"If needed, preserve focused prerequisite-review behavior with the trimmed snapshot."},{"path":"tests/unit/test_plan_review_sidecar_heldout.py","reason":"If needed, keep full-review sidecar/generation snapshot compatibility pinned."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","83e8-2405-914c-425b"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"0edd1575-c1ff-462c-82d7-76cdd3d70fef","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"3499-ee9f-0e1d-443b","ticket_type":"bug","title":"Plan-review holds a maximal whole-store compile for the entire 15-20 minute review","verify_commands":[]},"source_event_uuids":["d57f2b26-05f2-46d0-a208-0951560d8d62","25c00069-c790-4661-98a9-f99713e134c1","c9fca74d-a4ec-47e4-8d15-b681b0f40b2b","d001c8a8-74d7-45e4-85e5-d5cbd2afe1cf","5ed5de0e-4a59-405d-b296-2ced6b1159be","085261f0-7940-4c46-b61b-f8459049fbf9","b8c6e36f-784d-4e69-af9f-553e88d7f345","150f5962-fef6-4ee5-9aa9-4a0b95b901ce","4050d0f8-41a9-491e-a2d9-922bff833c51","e4567ed3-ddf6-48fa-95a8-7984e12fcb15","bacf02ab-92e5-49c3-ae44-1719477d9039","9ccfb855-ce61-4fe4-b659-5e2ba53e3e30","0edd1575-c1ff-462c-82d7-76cdd3d70fef","8f4f22d7-cb42-44f1-8392-e4fcfc68bc7d"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788848489285237562,"uuid":"cef3285f-8815-47fb-a31b-640425052e47"}