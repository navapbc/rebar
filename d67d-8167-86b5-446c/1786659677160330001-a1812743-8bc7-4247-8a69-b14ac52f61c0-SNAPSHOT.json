 Acceptance Criteria\n- [ ] `.github/workflows/compact-store.yml` exists with a daily cron and runs `rebar compact`.\n- [ ] Compaction runs unattended once a day, verified by the workflow's run history.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/compact-store.yml","reason":"new scheduled workflow"},{"path":"src/rebar/_store/compact.py","reason":"compaction entry point"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"4ba4756e-ae4d-4c8c-8e7d-c6dc192b722e","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"idea","tags":[],"ticket_id":"d67d-8167-86b5-446c","ticket_type":"task","title":"Scratch: scheduled store compaction","verify_commands":[]},"source_event_uuids":["f548d660-4acf-4b7c-ba73-283f538dc2b3","ebaa3727-4952-48c1-ad75-f0cf5e5fca25","4ba4756e-ae4d-4c8c-8e7d-c6dc192b722e","fe950b1d-37dc-48fc-a29d-0b3a2de8eb0b"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659677160330001,"uuid":"a1812743-8bc7-4247-8a69-b14ac52f61c0"}