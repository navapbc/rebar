_calls":1,"output_tokens":4302.0,"requests":5},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1545.0,"llm_calls":1,"output_tokens":120.11111111111111,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1545.0,"llm_calls":1,"output_tokens":120.11111111111111,"requests":1},"project.engine-layer-enforcement":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1545.0,"llm_calls":1,"output_tokens":120.11111111111111,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1545.0,"llm_calls":1,"output_tokens":120.11111111111111,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":7398.0,"llm_calls":1,"output_tokens":289.0,"requests":1}}}},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Scope the colon check so it flags only prohibited in-sentence/narration colons rather than all colons, or state that colon hits are triaged by manual review against the list/label exception.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["E6"],"decision":"advisory","decision_margin":-0.2,"drop_reason":null,"evidence":["Standard: 'A colon may introduce a list of items or act as a structural label. Spoken narration must contain no colon.'","Pattern includes bare `\\x3a` with no context anchoring, matching all colons","The AC pairs the regex with 'plus manual diction review', which mitigates but does not resolve the over-broad automated screen"],"finding":"The final-conformance verification pattern `\\x{2014}|\\x{2013}|\\x20\\x2d\\x20|\\x3b|\\x3a` flags EVERY colon (`\\x3a`), but the audit standards explicitly permit a colon that introduces a list of items or acts as a structural label. Applied literally, the screen produces false positives on conformant colons (and on structural Markdown colons), so a passing/ failing regex result does not track the stated standard.","group_criteria":null,"group_id":null,"id":"fa8fab200d3340b0b","impact":1.0,"is_primary":null,"location":"Acceptance Criteria — 'The final proposal text conforms to the audit standards ... Verification applies the pattern set ...'","norm_id":"neefd642ff64efc13","priority":0.75,"reason":"default-advisory","recalled":false,"scenarios":["A conformant list-introducing colon triggers a regex hit and is wrongly counted as a violation, or reviewers learn to ignore colon hits and miss a genuine narration colon"],"severity":"critical","suggested_fix":"Replace the bare colon alternative with a context-anchored check (for example flag a colon followed by a lowercase word inside a sentence, exempting list-introducers and label colons), and document that colon hits are adjudicated against the list/label exception during manual diction review.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate the closed value set for the proposal 'documentation type' field (e.g. ticket, ADR, internal documentation, external documentation, shipped help, comment) and the 'audience' field (developers/agents, clients), co-located with the classification-field AC.","cohort":["T8"],"criteria":["T8"],"decision":"dropped","decision_margin":-0.59,"drop_reason":null,"evidence":["AC line: 'Every proposal names one target documentation type plus its audience. Verification uses the proposal classification fields.'","Audit standards enumerate six categories in prose (Tickets, ADRs, Internal project documentation, External documentation, Shipped help, Comments) but never present them as the closed value set for the 'documentation type' field","ABSENCE: no line binds the taxonomy categories or the two audiences to the classification field as its permitted values"],"finding":"The proposal classification field ('one target documentation type plus its audience') references an enum vocabulary that is never enumerated as a closed value set the agent must choose from. The standards describe the taxonomy (ticket, ADR, internal documentation, external documentation, shipped help, comment) and audiences (developers/agents vs clients) only in descriptive prose, not as the bound vocabulary for the classification field.","group_criteria":null,"group_id":null,"id":"f9e4f74be8db5ae54","impact":0.44,"is_primary":null,"location":"Acceptance Criteria: 'Every proposal names one target documentation type plus its audience.'; Approach 'Each agent returns a structured report'","norm_id":"nbd546c44817a7cbf","priority":0.11,"reason":"veto:absence-refuted","recalled":false,"scenarios":["An exploration or filtering agent classifies a mixed file and cannot determine whether the valid type values are the six standards categories or the three shard labels (A/B/C)","Two agents label the same surface with divergent type strings because no controlled vocabulary is fixed"],"severity":"minor","suggested_fix":"Add a line binding the classification field to a fixed vocabulary: documentation type in {ticket, ADR, internal documentation, external documentation, shipped help, comment} and audience in {developers/agents, clients}, matching the standards taxonomy.","tier":"LLM","validity":0.25,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Specify the fallback when a surface matches no shard (default owner) and when an exploration or filtering agent returns an incomplete or failed report (re-run, escalate to root, or mark the coverage-table row unresolved).","cohort":["T8"],"criteria":["T8"],"decision":"dropped","decision_margin":-0.601,"drop_reason":null,"evidence":["Precedence rule text resolves overlap ('A client-facing string belongs to shard B ... so mixed files do not create overlapping review responsibility') but is silent on the no-owner case","ABSENCE: no rule for a surface fitting none of shards A/B/C, nor for an agent whose shard/challenge report is missing or partial","AC 'Exploration agents inspect the three shard definitions. Verification uses one session log report for each shard.' presumes every shard report exists but defines no remediation if one is absent"],"finding":"The precedence rule specifies conflict resolution for surfaces claimed by more than one shard, but no fallback is specified for a surface that matches NO shard, or for an exploration/filtering agent that returns an incomplete or failed report. The processing protocol for an incomplete sub-step is undefined.","group_criteria":null,"group_id":null,"id":"f9fb2a380f452aaef","impact":0.264,"is_primary":null,"location":"Exploration shard map: 'Precedence rule'; Filtering pass; Acceptance Criteria coverage-table and per-shard report criteria","norm_id":"n022a5bc02000baee","priority":0.099,"reason":"veto:absence-refuted","recalled":false,"scenarios":["A newly added surface type (for example a binary asset with embedded prose) matches no shard and is silently dropped from the coverage table","An exploration agent fails to return a report and the root proceeds to filtering with a coverage gap that the completeness challenge cannot detect because no baseline enumerates the missing shard"],"severity":"minor","suggested_fix":"Add a fallback clause: a surface matching no shard defaults to shard A (durable records) and is flagged in the coverage table for root review; a missing or partial shard/challenge report blocks consolidation until re-run or explicitly recorded as an unresolved coverage gap.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low"