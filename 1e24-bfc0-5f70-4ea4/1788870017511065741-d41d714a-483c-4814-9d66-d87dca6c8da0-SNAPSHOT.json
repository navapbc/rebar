{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788870017511065741,"compiled_state":{"alias":"ergophobic-harassed-peacock","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"2a93f18044c19410f97c2b3d998ffd8c1149ea41","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 1e24-bfc0-5f70-4ea4","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.13.1 (2a93f18044c19)","material: 168915bbab6701dd","verified-at-sha:2a93f18044c19410f97c2b3d998ffd8c1149ea41"],"material_fingerprint":"168915bbab6701dd","merged_log_commit":"2a93f18044c19410f97c2b3d998ffd8c1149ea41","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788851957526659000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"710a606b6d38bafc0f2c6684711b08811d26529e","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1e24-bfc0-5f70-4ea4","material: 65ad4f764826fdfa","material-part: children 647ea2107ca5072f 0","material-part: description d53ab27f6aef95fd 4711","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: ticket_id 46c8ed23f06f5d78 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","r