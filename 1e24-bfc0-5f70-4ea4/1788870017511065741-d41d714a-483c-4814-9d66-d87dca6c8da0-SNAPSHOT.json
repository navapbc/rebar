d":"4659c71b-89a0-4a39-84fc-ffb7c9e15674","position":{"commit_sha":"2d76d0003739d736883bb80b70931e5d54adeb5a","position":"1788838258719216001-4659c71b-89a0-4a39-84fc-ffb7c9e15674"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"43a340a7089046765ca6e30417a08c2d149088eb9eafcd0811cba998d513061a","event_uuid":"80a0ad56-697d-4179-a0a2-374a95174cfa","position":{"commit_sha":"7c9cae11de862d5243ce39945129dcb911a6d4f4","position":"1788845868171898001-80a0ad56-697d-4179-a0a2-374a95174cfa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"605552474ad79f1a52dd0285352ab15bbd8ac6183b613e45beb61a326534a2e7","event_uuid":"4de058f3-27f2-48e8-b524-bc18ecd3e24c","position":{"commit_sha":"bac491d4b24ef7920daa5b309b2d2693bbd68952","position":"1788849678313638344-4de058f3-27f2-48e8-b524-bc18ecd3e24c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"7fdb80d30fabb035d3a39601adfd556d0cc3837ea65956b19b49b865776a10c2","event_uuid":"eb92069f-76d8-40b4-a192-f0871bfd2bcf","position":{"commit_sha":"c0bdf1684bde6fc867e41109ce9481c340d8b2c5","position":"1788851412153486001-eb92069f-76d8-40b4-a192-f0871bfd2bcf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d5e1bd643c5b87c308d2a480b58ef5e46c2f405d8eb142bf4d28197ec978f729","event_uuid":"0a24c423-0d32-4832-87a1-5ab8d092ff6d","position":{"commit_sha":"ed3a1d58509c872b6508a136573c1cf300265176","position":"1788851938271604001-0a24c423-0d32-4832-87a1-5ab8d092ff6d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a1e365f7df979f5912518bb8b2fac8e7fb6a95787a9aaccb8ad65edabd7fa7ed","event_uuid":"46c66b93-cf7c-4a3a-aef3-b50cc7dd66ed","position":{"commit_sha":"0e62589253725a1f863badd0707fbc192625241f","position":"1788851957528199001-46c66b93-cf7c-4a3a-aef3-b50cc7dd66ed"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e575211d8d720cba5367c70460c09a6414c97e8f5346c436870fb6316f3cbf90","event_uuid":"270e5c8d-17c9-4379-85c9-5ae86d2f8df3","position":{"commit_sha":"ff9bfb30cd453b4fda7949b0437deca627dae014","position":"1788859497260866001-270e5c8d-17c9-4379-85c9-5ae86d2f8df3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"env_integration","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Natural experiment from another session: four merges to `main` inside 50 minutes, with `voter_errors` correlating tightly. Offering this as CORRELATION with its caveats stated, not as proof of this ticket's mechanism.\n\n**What happened.** Between roughly 09:00 and 09:50 UTC on 2026-09-05, four changes merged to `main`: 2668 (another session's, \"Remove simple CLI compatibility aliases\"), then 2669, 2670 and 2671 which I submitted at approximately 09:10, 09:33 and 09:50 UTC.\n\n**`voter_errors` over the three hours to 09:50 UTC** — namespace `rebar/host`, 300s period, Maximum. Thirty datapoints, of which SIX are non-zero, and every one falls inside the merge window:\n\n    09:05Z = 1\n    09:10Z = 1\n    09:15Z = 5      <- largest, ~5 min after 2669 merged\n    09:25Z = 1\n    09:30Z = 1\n    09:45Z = 1\n\nThe two hours preceding 09:05 are **flat zero**. The first non-zero point at 09:05 sits just after 2668 merged, and the 5-error spike at 09:15 follows 2669's merge by about five minutes. Each subsequent merge is followed by further non-zero readings.\n\n**Why this is suggestive rather than conclusive.** n is four merges in one window, all on one morning, and I did not instrument the autodeploy itself — I inferred the deploys from the merges rather than observing them. A confounder I cannot exclude: this window is also when CI and the review-bot were busiest on those same changes, so \"merge\" and \"load\" are not separated here. The discriminating measurement, for whoever picks this up, is whether `voter_errors` tracks autodeploy START timestamps specifically, versus merge timestamps or general review load — those three coincide in my data and would not have to.\n\n**Severity, stated honestly so this is not over-read.** The degradation is real but MILD in this sample. Errors are 1-5 per period and self-clear; every one of my three `POST /submit` calls returned HTTP 200 with `submit_records` CLOSED, and Gerrit remained usable throughout. So this window is evidence for \"degrades\", not for an outage. `deploy_errors` stayed 0 across the whole window, and `deploy_deferrals` showed a single 15 at the window's start and 0 thereafter.\n\n**Why it is worth recording anyway.** The alarm this trips (`rebar-gerrit-voter-errors`, threshold 0, `datapoints_to_alarm=3` of `evaluation_periods=5`) is currently the ONLY one of the seven live host alarms carrying a genuine breach — the other four that fired this morning were the spurious publish-gap artifacts documented on `illbred-sour-alpaca`. So this is a real signal sitting in a noisy alarm surface, which is exactly how a true positive gets trained away. If this ticket's mechanism is the cause, the alarm is doing its job and pointing at it.","timestamp":1788601865737445172},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA (PARTIAL — mechanism not experimentally proven; investigation only)\n\nOBSERVATION\nThe ticket evidence shows three unrelated Gerrit changes (2648/2652/2656) taking Verified -1 in ~75s because checkout-gerrit-change-action failed before patchset code ran: `git fetch https://rebar.solutions.navateam.com/rebar refs/changes/...` returned HTTP 504 after the action's ~60s fetch window. The recorded host state minutes later had `rebar-autodeploy.service` active, a freshly rebuilt `rebar-mcp-*` container, high 15-minute load, light Gerrit HTTP still healthy, and no memory exhaustion. A later natural experiment comment recorded `voter_errors` non-zero only during a four-merge window, but correctly labels that as correlation.\n\nHYPOTHESIS\nThe likely mechanism is host-local CPU/IO contention, not patchset content: `.github/workflows/gerrit-verify.yaml` and `_build-and-test.yml` rely on `lfreleng-actions/checkout-gerrit-change-action` against the live Gerrit refspec, while `infra/systemd/rebar-autodeploy.service` runs `/opt/rebar/infra/scripts/autodeploy.sh` on the same box every timer tick. `infra/scripts/autodeploy.sh:deploy_review_bot` runs `docker compose build ... && docker compose up`, and the MCP path runs `docker compose build mcp` plus `docker run`/nginx cutover. Even though the service now has `Nice=10` and `IOSchedulingClass=idle`, the heavy Docker daemon/build workload is still co-resident with Gerrit and can plausibly starve large pack generation/fetches while light HTTP remains OK.\n\nCONFIRMATION\nPartial only. I confirmed the static code path and the shared-host contention shape: Gerrit Verified jobs perform live Gerrit patchset checkouts, and autodeploy performs local Docker rebuild/redeploy work on the Gerrit host. I did NOT deliberately trigger an autodeploy or run load against production Gerrit, per the safety rule. The experiment needed for complete proof is a read-only/off-box timing harness that measures `git fetch refs/changes/*` latency across an observed autodeploy start/end window versus an idle window; the hypothesis is disproven if fetch latency/error rate does not rise during autodeploy while controlling for general review/CI load.\n\nSUGGESTED FIX DIRECTION\nTreat this as a design/ops fix, not a code-only patch: add safe instrumentation first (autodeploy start/end, Docker build duration, Gerrit fetch latency, voter_errors correlation), then choose between stronger resource isolation/cgroups for Docker builds, moving builds off-host, deferring deploy during Gerrit checkout pressure, and/or a narrow CI retry on Gerrit 5xx as symptom mitigation only.","timestamp":1788737380337887001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA/update: I confirmed the false-Verified path is the Gerrit patchset checkout step in the Verified lane: the job has to fetch refs/changes/* from Gerrit before any patchset code runs, and a transient 5xx/transport failure there currently terminates the job before code is evaluated. I honored the recorded/operator ruling against Verified-0 and CI-level concurrency groups by implementing in-job step-level retry around every Gerrit patchset checkout operation used by the Verified route. The retry is local to the transport operation (15s then 45s backoff); a transient autodeploy/Gerrit contention window can recover inside the same job so the final vote reflects actual code status rather than the first transport blip. RED test added first: tests/unit/test_gerrit_checkout_retry.py failed on main because checkout steps had no retry attempts; it now passes and covers exact inputs plus three attempts across gerrit-verify and all reusable Verified-lane workflows. Targeted workflow tests pass; lint/typecheck/ratchets pass. Full make verify hit the known GIT_CONFIG artifact in tests/interfaces/test_rebar_repo_isolation.py; the required solo confirmation with all GIT_CONFIG_* variables unset passes (13 passed). I will rerun make verify with those vars unset before push.","timestamp":1788845868171898001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Final disposition: implemented and merged as Gerrit change 2823. RCA: the false Verified -1 path was the single-attempt Gerrit patchset checkout in the Verified route; when Gerrit/autodeploy contention caused a transient fetch 5xx/RPC failure, CI had not evaluated patchset code but the route still failed. Following the operator ruling, I did not use Verified-0 or CI concurrency groups and did not touch Terraform; instead every Gerrit patchset checkout in gerrit-verify and its reusable Verified-lane workflows now retries in-job (15s, then 45s). RED: tests/unit/test_gerrit_checkout_retry.py failed on the old one-attempt workflow shape. Validation: targeted workflow tests passed; lint/typecheck/module-size/complexity/mechanism ratchets passed; full make verify passed with GIT_CONFIG_* unset; Gerrit 2823 passed LLM-Review+1 and Verified+1 and was submitted. Closed as env_integration.","timestamp":1788859497260866001}],"completion_expectation":"required","created_at":1788578494438570001,"creation_channel":"cli","deps":[{"link_uuid":"9bb9cf28-d648-4741-921f-62907090000b","relation":"relates_to","target_id":"9ea3-7d07-ea55-4496"},{"link_uuid":"55c57284-4e3d-4e01-8030-e08d85b4e569","relation":"relates_to","target_id":"5bba-45dd-3bfc-42f1"},{"link_uuid":"4de058f3-27f2-48e8-b524-bc18ecd3e24c","relation":"relates_to","target_id":"5c85-0775-b7aa-41f5"}],"description":"## Summary\n\nGerrit Verified jobs fetch the exact patchset from Gerrit before any patchset code runs. During autodeploy/Gerrit contention windows this checkout can fail with a transient transport error (for example HTTP 504), and the old workflow let that first transport failure terminate the job. The resulting Verified -1 was a false code verdict because CI had not evaluated the change.\n\nOperator ruling recorded 2026-09-06/07 rejected Verified-0-on-fault and CI concurrency groups. The approved mitigation is in-job step-level retry for transport operations so transient Gerrit/autodeploy faults recover inside the same CI job and the final vote reflects real code status.\n\n## RCA\n\nThe failure is in the Gerrit patchset checkout operation, not in repository code. The affected workflows use `lfreleng-actions/checkout-gerrit-change-action` to fetch `refs/changes/*`; a transport failure there aborts the route before lint, tests, mutation, or other gates run. Retrying the checkout step locally in the job is the narrow portable seam: it targets the observable transport operation, avoids queue-wide serialization, and does not let patchset code influence vote logic.\n\n## Acceptance criteria\n\n- [x] Every Gerrit Verified-lane patchset checkout has three in-job attempts: initial checkout, a 15 second retry, and a final 45 second retry.\n- [x] Retry attempts preserve the exact Gerrit inputs (`gerrit-refspec`, `gerrit-project`, `gerrit-url`) so the gate still checks out the requested patchset and does not replace it with a destructive manual ref operation.\n- [x] The retry is implemented inside the job step sequence rather than by casting Verified 0, adding CI concurrency groups, or touching infrastructure/Terraform.\n- [x] The retry mechanism is covered by a structural regression test that failed on the previous workflow shape and passes after the fix.\n- [x] Validation evidence exists: targeted workflow tests pass, lint/typecheck/mechanism/complexity ratchets pass, the known GIT_CONFIG isolation artifact passes solo with GIT_CONFIG_* unset, and full `make verify` passes with GIT_CONFIG_* unset.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":".github/workflows/gerrit-verify.yaml","reason":"retry Gerrit patchset checkouts in Verified jobs"},{"path":".github/workflows/_build-and-test.yml","reason":"retry reusable Verified lane checkout"},{"path":".github/workflows/_optionality.yml","reason":"retry reusable Verified lane checkouts"},{"path":".github/workflows/_artifact-probe.yml","reason":"retry reusable Verified lane checkout"},{"path":".github/workflows/_eval-discipline.yml","reason":"retry reusable Verified lane checkout"},{"path":".github/workflows/_mutation.yml","reason":"retry reusable Verified lane checkouts"},{"path":".github/workflows/_scanner-integration.yml","reason":"retry reusable Verified lane checkout"},{"path":"tests/unit/test_gerrit_checkout_retry.py","reason":"structural regression test for in-job retry"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","5bba-45dd-3bfc-42f1"],["relates_to","5c85-0775-b7aa-41f5"],["relates_to","9ea3-7d07-ea55-4496"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"0a24c423-0d32-4832-87a1-5ab8d092ff6d","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"1e24-bfc0-5f70-4ea4","ticket_type":"bug","title":"A merge to main triggers an autodeploy that degrades Gerrit enough to 504 CI's change-ref checkout, failing unrelated in-flight changes: three Verified -1s in one window, all before any patchset content ran","verify_commands":[]},"source_event_uuids":["2aa1e54e-281b-47e1-b53c-0283d3de7aa4","55c57284-4e3d-4e01-8030-e08d85b4e569","a0d12b93-64e7-42fa-84ec-d685dbccc3cd","ddad192c-5201-4ad6-8582-c0d60c41f590","6b3fe015-1089-4749-8d9d-3dc2c5a5bbc3","92aadcbe-58ea-4340-8ebe-53476a7da837","4659c71b-89a0-4a39-84fc-ffb7c9e15674","80a0ad56-697d-4179-a0a2-374a95174cfa","4de058f3-27f2-48e8-b524-bc18ecd3e24c","eb92069f-76d8-40b4-a192-f0871bfd2bcf","0a24c423-0d32-4832-87a1-5ab8d092ff6d","46c66b93-cf7c-4a3a-aef3-b50cc7dd66ed","270e5c8d-17c9-4379-85c9-5ae86d2f8df3"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788870017511065741,"uuid":"d41d714a-483c-4814-9d66-d87dca6c8da0"}