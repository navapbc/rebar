f-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"91e8f303e8bcb989065b59127568c3e271d2e930574b2a03efe05cabca10374d","event_uuid":"41e510cc-fe3e-484a-a3a3-281be97926fa","position":{"commit_sha":"2f30c14c8b80959f0b2f5307907f7aa952cd5847","position":"1784781178295249001-41e510cc-fe3e-484a-a3a3-281be97926fa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"148f0cfa0de03e51920f365f464f807c7d07e07691e84bf4e34bad78a89df5a1","event_uuid":"cb76ca93-ad37-49a2-889d-35b7bfca1427","position":{"commit_sha":"855d8c8b07e31a5a6daa487c1726e823f18bacd8","position":"1784781417688126139-cb76ca93-ad37-49a2-889d-35b7bfca1427"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-218_agent","claim_remote_session":null,"claimed_session":"b07d4e18-e059-4f55-821a-9c0f549cbca9","close_class":"duplicate","comments":[{"author":"Joe Oakhart","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Investigated at runtime: the silent-swallow described in the report does NOT reproduce on v0.10.0. The signable-PASS-that-fails-to-sign path already exits 11 with an explicit stderr message ('plan review PASSED but the attestation could not be persisted: ...; re-run to retry'), landed by 998cb442c (2026-07-11, in v0.10.0). Confirmed via a driven CLI repro of _review_plan with a PASS+signature.signed=False+error result -> exit 11, not 0. The report's baseline was v0.9.1 (pre-fix). No code change needed; superseded by 998cb442c.","timestamp":1784781056242631001}],"created_at":1784780691079623001,"creation_channel":"cli","deps":[],"description":"## Problem\nRun in a backgrounded shell whose cwd is reset away from the repo, 'rebar review-plan' can complete the review but resolve repo/tracker root from the transient cwd, then fail to persist an attestation WITHOUT surfacing an error to the caller — a workflow that backgrounds gate runs appears to succeed while signing nothing.\n\n## Investigation target\nTrace review-plan repo/tracker-root resolution and the sign step's error handling for a silently-swallowed failure when cwd != repo root. Reproduce at runtime before fixing.\n\n## Fix (report ask)\nFail loudly when signing cannot persist, and resolve repo/tracker root independently of the transient cwd (or require an explicit root and error if unresolved).\n\n## Acceptance criteria\n- A review-plan sign that cannot persist surfaces a non-zero exit / explicit error to the caller (never a silent no-op success).\n- Root resolution does not silently depend on a cwd that differs from the ticket's repo.\n\n## Verification\nRuntime repro of the cwd-reset scenario + a regression test asserting the loud failure.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"53266ab0-966d-4664-b719-c901b1d0b2cb","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"closed","tags":[],"ticket_id":"3a17-1f9e-ccfb-4419","ticket_type":"bug","title":"review-plan from a cwd-reset/background shell can sign nothing with no error surfaced","verify_commands":[]},"source_event_uuids":["c8b4fac6-f589-4c93-ae00-0fcf4cd2f422","677f7402-06e3-468b-a9dd-28afb9541964","3a2680f8-7549-4f7e-b581-bc20abfbd882","3137182a-c7a0-42ad-b926-e5338cf08275","53266ab0-966d-4664-b719-c901b1d0b2cb","41e510cc-fe3e-484a-a3a3-281be97926fa","cb76ca93-ad37-49a2-889d-35b7bfca1427"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659556981933001,"uuid":"7a6e95c0-f098-4aec-afea-103533c4b926"}