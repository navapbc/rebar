ecovery.py\":\"py\"}\nPFX = (\"noqa\", \"type:\", \"pyright:\", \"mypy:\", \"ruff:\", \"fmt:\", \"isort:\", \"pragma:\", \"nosec\", \"coverage:\", \"mechanism-ok:\", \"raw-git-ok:\", \"tickets-boundary-ok:\", \"read-via:\")\ndef normalize(src, path):\n    tree = ast.parse(src, filename=path, type_comments=True)\n    def visit(node, prefix=\"\"):\n        owner = \"module\" if isinstance(node, ast.Module) else prefix\n        body = getattr(node, \"body\", [])\n        if owner in DOCS[path] and body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str):\n            body[0].value.value = \"__ALLOWLISTED_PROSE__\"\n        for child in body:\n            if isinstance(child, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):\n                visit(child, f\"{prefix}.{child.name}\" if prefix else child.name)\n    visit(tree)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.TypeIgnore):\n            node.lineno = 0\n    return ast.dump(tree, include_attributes=False)\ndef directives(path, src):\n    lines = src.splitlines()\n    if KINDS[path] == \"py\":\n        out = []\n        for tok in tokenize.generate_tokens(io.StringIO(src).readline):\n            if tok.type == tokenize.COMMENT:\n                body = tok.string[1:].lstrip().lower()\n                if tok.string.startswith(\"#!\") or any(body.startswith(p) for p in PFX):\n                    out.append(lines[tok.start[0] - 1])\n        return out\n    if KINDS[path] == \"yaml\":\n        return [line for line in lines if line.lstrip().startswith(\"#\") and line.lstrip()[1:].lstrip().lower().startswith((\"yaml-language-server:\", \"yamllint\", \"prettier\", \"eslint\"))]\n    needles = (\"eslint-disable\", \"prettier-ignore\", \"@ts-ignore\", \"@ts-expect-error\", \"istanbul ignore\", \"c8 ignore\")\n    return [line for line in lines if any(n in line.lower() for n in needles)]\nbefore_map = {}\nfinal_map = {}\nfor path in SPANS:\n    before = subprocess.check_output([\"git\", \"show\", f\"{B}:{path}\"], text=True)\n    final = Path(path).read_text(encoding=\"utf-8\")\n    before_map[path] = before\n    final_map[path] = final\n    if KINDS[path] == \"py\":\n        assert normalize(before, path) == normalize(final, path), (\"AST/runtime drift\", path)\n    assert directives(path, before) == directives(path, final), (\"directive/shebang drift\", path)\nfor path in SPANS:\n    if KINDS[path] == \"yaml\":\n        base_code = [line for line in before_map[path].splitlines() if line.strip() and not line.lstrip().startswith(\"#\")]\n        final_code = [line for line in final_map[path].splitlines() if line.strip() and not line.lstrip().startswith(\"#\")]\n        assert base_code == final_code, (\"YAML non-comment drift\", path)\ndiff = subprocess.check_output([\"git\", \"diff\", \"--unified=0\", B, \"--\", *SPANS], text=True)\ncurrent = None\nkind = None\nfor line in diff.splitlines():\n    if line.startswith(\"+++ b/\"):\n        current = line[6:]\n        kind = KINDS[current]\n        continue\n    match = re.match(r\"^@@ -(\\d+)(?:,(\\d+))? \\+\\d+(?:,\\d+)? @@\", line)\n    if match:\n        start = int(match.group(1))\n        count = int(match.group(2) or \"1\")\n        allowed = SPANS[current]\n        if count:\n            assert all(any(lo <= n <= hi for lo, hi in allowed) for n in range(start, start + count)), (\"hunk outside allowlist\", current, start, count)\n        else:\n            assert any(lo <= start <= hi or lo <= start + 1 <= hi for lo, hi in allowed), (\"insertion outside allowlist\", current, start)\n        continue\n    if line.startswith(\"+\") and not line.startswith(\"+++\"):\n        value = line[1:].strip()\n        if kind == \"yaml\":\n            assert not value or value.startswith(\"#\"), (\"YAML addition is not comment-only\", current, value)\n        if kind == \"js\":\n            assert not value or value.startswith((\"//\", \"/*\", \"*\", \"*/\", \"{/*\")), (\"JS addition is not comment-only\", current, value)\n'","dd_id":"immutable-prose-only","dd_text":"Only exact allowlisted prose changes: immutable-base runtime/non-comment structure and protected directives remain exact, and zero-context hunks stay inside base spans."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess\nexpected = set([\"src/rebar/llm/workflow/criterion_preview.py\",\"src/rebar/llm/workflow/editor_assets/src/configValidation.js\",\"src/rebar/llm/workflow/editor_assets/src/index.js\",\"src/rebar/llm/workflow/editor_assets/src/insertionProvider.js\",\"src/rebar/llm/workflow/editor_assets/src/promptLibrary.js\",\"src/rebar/llm/workflow/editor_assets/src/rebarProvider.jsx\",\"src/rebar/llm/workflow/examples/review_skeleton.yaml\",\"src/rebar/llm/workflow/executor.py\",\"src/rebar/llm/workflow/gates/code-review.yaml\",\"src/rebar/llm/workflow/gates/plan-review.yaml\",\"src/rebar/llm/workflow/plan_review_recovery.py\"])\nactual = set(subprocess.check_output([\"git\", \"diff\", \"--name-only\", \"HEAD^..HEAD\"], text=True).splitlines())\nassert actual == expected, {\"expected\": sorted(expected), \"actual\": sorted(actual)}\n'","dd_id":"exact-leaf-paths","dd_text":"The single ticket commit changes exactly the declared file-impact set."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"The repository comment-hygiene policy passes."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest -q tests/unit/test_criterion_preview.py tests/unit/workflow/test_editor.py tests/unit/workflow/test_editor_validate.py tests/unit/workflow/test_editor_batch.py tests/unit/workflow/test_editor_roundtrip.py tests/unit/workflow/test_editor_effective_policy.py tests/unit/workflow/test_executor.py tests/unit/workflow/test_executor_c3.py tests/unit/workflow/test_executor_tripwire.py tests/unit/workflow/test_review_skeleton.py tests/unit/workflow