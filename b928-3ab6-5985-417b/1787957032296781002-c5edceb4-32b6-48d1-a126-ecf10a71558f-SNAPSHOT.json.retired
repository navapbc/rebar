{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787957032296781002,"compiled_state":{"alias":"cibophobic-moist-guineafowl","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"82a0d5cd328f6a7c5d34e8f1ab0ea77de2c6337e","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b928-3ab6-5985-417b","material: a4c4547f0e34e1ef","material-part: children 647ea2107ca5072f 0","material-part: description 37cf8dee14d4f808 5739","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: ticket_id 2abbed72ce71b21e 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (3e89287abe0c-dirty)","regver: aa61189569d34126","verified-at-sha:ae203145fa39a153c21b6cba8b25cb5679849ec9","currency-basis: fail-safe"],"material_fingerprint":"a4c4547f0e34e1ef","merged_log_commit":"ae203145fa39a153c21b6cba8b25cb5679849ec9","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787954152322803000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"bebae1f1a9d1d9794382102b6b2f911c98613e1ce10bb8a17100a6d204bec2a8","event_uuid":"f2eab529-0bfd-4e39-9406-69616a79ecaa","position":{"commit_sha":"b81cc09b8ab7a14aae889ae6f80fd07ce037828f","position":"1787898266430943963-f2eab529-0bfd-4e39-9406-69616a79ecaa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"bc6c5920def9e73c8fdf1bab111377e58d96a260dd6ba0a82496f1d9a36cda6d","event_uuid":"70b295c2-eeba-4c2c-b60e-fbd753ae453c","position":{"commit_sha":"4d5b4767c52b5ff6d34a662ca460f2e8e5dfb338","position":"1787902359625444163-70b295c2-eeba-4c2c-b60e-fbd753ae453c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4f7294c1a6ffe8c165c5999f9163f647f4d9b1e122a83f5302882f0a85d655ba","event_uuid":"97e23f72-945b-402d-aada-41c8c068e309","position":{"commit_sha":"e4315c59e75d33f32866e543c66fa71f29d604e1","position":"1787952416712122688-97e23f72-945b-402d-aada-41c8c068e309"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"df747d64ad936fe49fc40e7341182b98c00b718b49fb523604683cfc72c06324","event_uuid":"4615ff7c-010e-4982-b923-f4486a0f701c","position":{"commit_sha":"bf73420f9375b9675e27e264790af47dcb1a9d30","position":"1787953549484326001-4615ff7c-010e-4982-b923-f4486a0f701c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"da5b7584df5fb3a0fba8f749054d5c929c5561464ac879743882f457b1ce7709","event_uuid":"d29422a3-7330-4708-b35d-bf3182cb6766","position":{"commit_sha":"99b9f27fdec35bfc6d823507f62c0f955429e661","position":"1787954152333381001-d29422a3-7330-4708-b35d-bf3182cb6766"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6b2164ae69f81037b34f910e1ca935d97f36f5ab7ab89ce8ea06bcd86b4d689a","event_uuid":"b02425cb-4bd7-40f6-9074-9c92e3b90a51","position":{"commit_sha":"a96e37ccb211495bc71bb176d48fbce1b44caa51","position":"1787954336907823001-b02425cb-4bd7-40f6-9074-9c92e3b90a51"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"56c8ed54a57b9d5498eccd3b4a80f322ae56eee30c9312729676d526cdefa094","event_uuid":"ec41742e-f4c5-41d7-989f-6bdf29913d63","position":{"commit_sha":"a96e37ccb211495bc71bb176d48fbce1b44caa51","position":"1787954342138183001-ec41742e-f4c5-41d7-989f-6bdf29913d63"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"49fbfb77f8ef852a3842ad3f192ee24d3cb954b4f9c7094bd0260b83f928ffd9","event_uuid":"56bb3b74-a4a3-42b2-8c30-d247f5a2cc66","position":{"commit_sha":"285d920e8bade7ab50d3095b952c082012c9825a","position":"1787954350128615001-56bb3b74-a4a3-42b2-8c30-d247f5a2cc66"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d19f57c9d502e26ebbdde6e8c84e035ddfcdf31e38f355800435e3d871a4e92d","event_uuid":"8604752b-64c8-4be0-82a9-7d8c73ea3608","position":{"commit_sha":"a905e56bf93f45e089794c7b707edc22a95bf9c6","position":"1787954444139217001-8604752b-64c8-4be0-82a9-7d8c73ea3608"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1cf39b78dfe6bf7b9db72057c3293ceb3f070b2f97a3d4078eca31525776f5c5","event_uuid":"966affed-edd2-4afd-be13-4fcd8db63ea4","position":{"commit_sha":"db27b2e3f9095656aed2efb1c09507fc8cf178e7","position":"1787954545363927001-966affed-edd2-4afd-be13-4fcd8db63ea4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c605ca080f5d805e367d83435addfe5fc6db5f7438c8a4aeca01dc543bc77261","event_uuid":"6d986e19-e30c-43e0-889a-0f439d88499a","position":{"commit_sha":"18f5287fdcb540e3ffe8c03a006d084f781d9858","position":"1787954856182711001-6d986e19-e30c-43e0-889a-0f439d88499a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5fcd8a0115370cc45d7e92efc6248d1788484a82b036d39339e5eda54543c221","event_uuid":"d6d25698-f8e9-4a11-b395-1eae121185fd","position":{"commit_sha":"1a8280bb0d6c91bdc34b43b79c42c35fda853052","position":"1787955630948766795-d6d25698-f8e9-4a11-b395-1eae121185fd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d29800dfc9b71c98cdbf93c7e0f3093878dacd5d0b4b5ffd542a67a327f9c52e","event_uuid":"e79e6e51-2218-467b-bf07-e11062e04704","position":{"commit_sha":"6439e5cefcd472627d1fbee136d41889dce6bf95","position":"1787956210644205001-e79e6e51-2218-467b-bf07-e11062e04704"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2a92698fb15d2a2ac5e7ecdd23cd76f925279251076d5119314d855ff9dc97fe","event_uuid":"b20ea538-3977-436d-b8d4-35494b7bfcfc","position":{"commit_sha":"ef6294a2846e0ad0c8efd90745744534a178f6a9","position":"1787957032296781001-b20ea538-3977-436d-b8d4-35494b7bfcfc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-247_agent","claim_remote_session":null,"claimed_session":"41c69740-e628-4506-a328-65f32258a98e","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## RCA — RE-POSTED (the original write was stranded by this very bug)\n\nA `/rebar-debug` investigation on 2026-08-28 proved the root cause and posted it here. That\ncomment never reached the shared store — this ticket showed **zero comments**. The analysis of\nthe stranded-writes bug was itself stranded. Re-recording it durably.\n\n## Root cause: STARVATION, not a wedged store\n\nRecovery works; the store is healthy. `origin/tickets` was receiving a push every **2-4s\n(median 3s)** from the enrichment pipeline, while one fetch->merge->push recovery cycle costs\n**>= 2.4s, rising to >= 4.2s** as `_cas_backoff` escalates. The quiet window a recovering writer\nneeds is >= the interval between competing pushes, so the race is *structurally* unwinnable.\n\n### Decisive evidence\n\n**1. Recovery runs; every merge succeeds.** The container's reflog showed `fetch ...\nfast-forward` every 3-6s, each followed by a clean `ort` merge. No lock timeouts. Rules out\n\"recovery never runs\".\n\n**2. 84% of the backlog was recovery's OWN merge commits:**\n\n    150  merge commits (\"Merge origin/tickets (auto-reconcile during push retry)\")\n     28  real ticket events\n\n150/28 = **5.4 merges per event** = `_MAX_RETRIES = 5` (`src/rebar/_store/push_classify.py:62`)\nplus the terminal push. **Every write exhausted its budget and lost.** Oldest local-only commit\nwas ~4h old, ~168 consecutive attempts, zero successes.\n\nThis inverts the naive reading: monotone growth is the PREDICTED signature of persistent\nrace-loss, because recovery inflates the backlog it is draining by ~6 commits per failed write.\nMeasured 178 -> 196 in 61s.\n\n**3. Why it cannot be won** (timed read-only in-container): `git ls-remote` 509ms (network RTT\nfloor) + `git status` 885ms (27.5 MB index, 169,843 files) + `git push --dry-run` 742ms +\n`_cas_backoff` 250/500/1000/2000ms = a **2.4-4.2s** window against a 2-4s competing-push\ninterval.\n\n**4. Load-regime change.** `origin/tickets` went from ~20-90 commits/hour to **~1000-1400 at\n2026-08-27 21:00 UTC**. Driver: the enrichment queue auto-pushed a separate commit per queue\ntransition (ENQUEUE -> CLAIM -> DIGEST -> DONE, ~4 pushed commits/ticket,\n`src/rebar/llm/overlap/queue.py:99,107`), sweeping 491 distinct tickets in 3h.\n\n**5. Winner-takes-all.** After a success your ref IS origin's tip, so the next push is a bare\nfast-forward (~0.7s, no fetch, no merge). Fall behind ONCE and you pay the 2.4-4.2s merge window\nforever.\n\n**6. `_cas_backoff` is inverted for this failure mode.** `src/rebar/_store/push_recovery.py:405-410`\nsleeps AFTER the merge and BEFORE the push with **no re-fetch between**, on an unjittered\nschedule — so each retry is strictly staler than the last and all starved writers retry in\nlockstep.\n\n### Rivals ruled out\n\n- **Stale build** — REJECTED (`git merge-base --is-ancestor 7be0edb7132d 6fe5c0d54574` -> true).\n- **Credential asymmetry** — REJECTED: `push --dry-run` authenticates and reaches a ref-level\n  `! [rejected] ... (fetch first)`; a permission failure would be 403/denied.\n- **Not genuinely non-fast-forward** — REJECTED: `ls-remote` returned a sha `cat-file -e` could\n  not resolve locally.\n- **Container-specific** — REJECTED, the strongest discriminator: the developer-side store showed\n  the identical failure concurrently (397 ahead, 306 of them merges).\n\n## Mitigation applied 2026-08-28 and its measured effect\n\nOperator-directed: the opportunistic write-path enrichment drain was turned OFF via\n`overlap_drain = \"off\"` in the `[llm]` table. (Note `[tool.rebar.llm]` is NOT parsed — a\ndocumentation defect fixed separately in `eyeable-intimate-marmoset`.) Effect: the local store\nwent from **619 unpushed to ahead=0 behind=0**. Contention fell far enough that pushes win.\n\n## AC2 CONTRADICTS A STANDING OPERATOR DECISION\n\nAC2 requires a write that cannot reach the shared store to \"FAIL LOUDLY to the caller rather\nthan returning success\". That is the opposite of **operator decision B4**, recorded on closed bug\n`e1ed-b700-c442-4d0c` (`vapoury-attack-lamb`) under \"## Approved remedy (operator decision B4)\":\n\n> \"The remedy must be a SIGNAL, never an exception or a non-zero exit.\"\n> \"OUT of scope: changing CLI behaviour or any exit code, raising on the default path ...\"\n\nPinned in `docs/concurrency.md:551,594` and `src/rebar/_store/push_classify.py:40`. B4's remedy\nalready SHIPPED and works: every MCP write returns `push_status: final-push-rejected`. The honest\nreframing is **\"the signal is present and being ignored\"**, not \"the signal is missing\".\n\n**AC2 should be rewritten, not implemented.** Escalated to the operator.","timestamp":1787952416712122688},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC2 rewritten + gate-level freshness assertion implemented (2026-08-28)\n\n**AC2 was REWRITTEN, not implemented.** The original wording demanded a write that cannot\nreach the shared store \"FAIL LOUDLY to the caller\", the exact opposite of standing operator\ndecision B4 on `e1ed-b700-c442-4d0c`. The scope change is recorded INLINE in the criterion\n(original wording quoted, B4 named as superseding, dated and marked operator-approved) so a\nfuture reader sees a decision rather than a criterion that always read that way.\n\n## What shipped\n\nA new READ-side module `src/rebar/_store/freshness.py`. Three gate paths refuse before\nconsulting an attestation, each reporting the distinct verdict `stale-store`:\n\n1. `llm/plan_review/attest_gate.claim_gate_check` — the claim gate. Chosen because it is the\n   single verdict function behind `claim`, `transition open in_progress` AND\n   `plan_review_status`, so one insertion covers the write gate and its read-only sibling\n   with no new call sites. Placed BEFORE `signing.verify_signature`, since on a stale store\n   that read is precisely what returns the wrong answer.\n2. `_commands/gates.close_plan_review_gate_check` — the plan-review close gate. Same harm,\n   same placement.\n3. `_commands/close_precheck._completion_precheck` — the completion close gate, immediately\n   after the gate-state/force resolution so a stale store never spends a billable LLM run.\n\n`signing.verify_signature` was deliberately EXCLUDED. It authorizes nothing; it reports.\nRefusing there would remove the very tool used to diagnose a stale store, and annotating its\nresult would churn a schema-pinned MCP read contract for information the gates already carry\nin their refusal. Read-side visibility instead comes through `plan_review_status`, which\nwraps `claim_gate_check` and therefore now reports `stale-store` for free.\n\n## Staleness definition (local, no network)\n\nA gate must not acquire a dependency on the remote being reachable, and every signal is\nalready on disk: the durable `rebar-push-pending` marker (`push-pending`), or HEAD\nbehind/diverged from the ALREADY-FETCHED remote-tracking ref (`behind` / `diverged`). Note\n`fsck` deliberately stays silent on *merely behind* because a writer ff-adopts on its next\npush — a gate is a pure reader and never triggers that adoption, so for certification it is\nthe sharpest available signal.\n\n## Refuse vs warn\n\nREFUSE. A gate that cannot trust its input has no business certifying with it. The refusal\nnames the condition with its count and gives the recovery, including the local-CLI fallback\n(the point being that the surface which went stale is a shared MCP server the caller cannot\nrestart). The probe itself fails OPEN — a broken diagnostic must not convince a healthy\nstore it is broken — while a PROVEN stale verdict fails CLOSED.\n\n## B4 is not violated\n\nThe change is confined to gate READ paths. `push_tickets_branch` still ALWAYS returns None\nand never raises, pinned by\n`test_a_stale_store_does_not_make_an_ordinary_write_raise`. Blanket write-refusal stays\nrejected: it would have write-blocked every session during the four-hour starvation window.\n\n## Verification\n\nRED-first, mutation-checked: 7/7 mutants killed (each production edit reverted individually;\nthe paired test failed every time). The decisive tests stub a CERTIFIED, VALID attestation\nand still require a refusal on a stale store, so only the freshness assertion can produce it.\nGates green: `make lint`, `make typecheck`, module-size contract, complexity ratchet\n(`new=0 increased=0`). The starvation fixes remain OUT of scope and escalated.","timestamp":1787954444139217001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change **2346** — \"Refuse gate certification on a stale store\"\n(https://rebar.solutions.navateam.com/c/rebar/+/2346), commit `59093c891328`, pushed for\nreview (NOT submitted). Mutation check re-run on the final tree: **8/8 mutants killed**\n(each production edit reverted individually — including the `diverged` classifier branch,\nwhose first mutant SURVIVED and exposed a missing test, now added).","timestamp":1787954856182711001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Full local suite green on the pushed tree: **16417 passed, 61 skipped, 0 failures**\n(`tests/unit` + `tests/interfaces`, 22m37s). Gates: `make lint`, `make typecheck`,\nmodule-size contract (close_precheck.py at 797/800 — deliberately compact insertion),\ncomplexity ratchet `new=0 increased=0`. Ticket stays **in_progress**: the change is on\nGerrit awaiting `LLM-Review +1` / `Verified +1` and has NOT been submitted.","timestamp":1787956210644205001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"AC2 satisfied and landed: Gerrit change 2346 (\"Refuse gate certification on a stale store\") merged as 2598909d25ae12d52b6db62be1660920fc09580e with LLM-Review +1 and Verified +1.\n\nThe three gate read paths now assert store freshness and refuse with the distinct verdict `stale-store` rather than certifying against a view other readers do not have: `claim_gate_check` (covering claim, transition open->in_progress, and plan_review_status), `close_plan_review_gate_check`, and `_completion_precheck` (placed before the billable verifier run). Staleness is defined locally with no network -- the durable rebar-push-pending marker, or HEAD behind/diverged from the already-fetched remote-tracking ref. The probe fails OPEN, the gate fails CLOSED. 8/8 mutants killed.\n\nCLOSE ATTEMPTED AND CORRECTLY REFUSED. The completion gate reports four still-unchecked criteria, all of them live-server work that this change does not touch: the deployed store pushing to origin/tickets, backlog reconciliation without event loss, ENV_ID_MISMATCH resolution-or-acceptance, and the LIVE VALIDATION item. No --force was used and the ticket stays in_progress. Those four remain the outstanding work.","timestamp":1787957032296781001}],"created_at":1787891949367268001,"creation_channel":"cli","deps":[{"link_uuid":"f2eab529-0bfd-4e39-9406-69616a79ecaa","relation":"relates_to","target_id":"62ab-c11e-30c2-40be"},{"link_uuid":"d6d25698-f8e9-4a11-b395-1eae121185fd","relation":"relates_to","target_id":"5019-6f15-4ad5-4128"}],"description":"## Summary\n\nThe rebar MCP server on the box writes ticket events into a clone whose `tickets` branch cannot\npush to `origin/tickets`. Every write through the MCP tracker surface — comments, edits,\n`set_file_impact`, links, transitions — is committed locally in that container and **never\nreaches the shared store**. The tool call returns success.\n\nAny agent following AGENTS.md's mandate to 'route tracker ops through the MCP server' is therefore\nwriting to a store nobody else can see, including the gates, which read the CLI-side store.\n\n## Observed independently by three agents this session\n\n- `push_status: final-push-rejected` (\"fetch first\") on every MCP write.\n- The unpushed count CLIMBS across calls, so it is not a transient losing one race:\n  50 -> 69 in one session, 56 -> 63 in another, and `fsck` on the container reported the local\n  `tickets` branch **84 commits ahead** of `origin/tickets`.\n- Two agents independently found their MCP-written `set_file_impact` and comments stranded, and\n  had to re-issue them through the local CLI store before the gates could see them.\n\n## Why the local CLI store is healthy and this one is not\n\nThe developer-side store reconciles a non-fast-forward by MERGING `origin/tickets`\n(`src/rebar/_store/push.py:7-9` — merge, never rebase). That path demonstrably works: the local\nstore went from 141 unpushed to 0 without intervention during this session. The container's store\nis not recovering the same way, so either that recovery path is not running there, or it is\nrunning and failing for a reason the CLI store does not hit.\n\nTwo candidate contributors, both worth checking before assuming:\n\n1. **The deployed build may predate the fix.** Commit `7be0edb7132d` (\"re-clone an unusable\n   tickets store\") suggests exactly this class of wedged store was addressed; the container may\n   be older than it, or the store may have been created before it and never re-cloned.\n2. **Credential/permission asymmetry.** The container pushes with `MCP_TICKETS_PAT` (or its\n   documented fallback to `reviewbot-tickets-pat`), a different identity from the developer's.\n   A rejection that reads as 'fetch first' is not necessarily non-fast-forward — verify what the\n   remote actually returns rather than trusting the message.\n\n## Also present on that store\n\n`fsck` reports `ENV_ID_MISMATCH` naming multiple other environment ids — the signature of a\nre-clone that did not carry over its git-ignored local state (`.env-id`, `.opcert-key`). Op-cert\nattestations signed under those identities verify as `foreign_key` at the claim/close gates and\nmust be re-earned. That may be the same underlying event as the wedged store.\n\n## Impact\n\nSilent data loss on the mandated write path. Nothing surfaces to the caller: the MCP tool reports\nsuccess, and the divergence is only visible by running `fsck` against the container's own store.\n\n## Acceptance Criteria\n\n- [ ] The deployed MCP server's tickets store pushes successfully to `origin/tickets`, or\n      recovers by merge the way the CLI store does.\n- [ ] AC2 (REWRITTEN 2026-08-28, operator-approved) — **the gate-critical READ paths must not\n      certify against a stale store.** A gate that answers from a clone which never received a\n      write returns a WRONG verdict, not merely a late one: on 2026-08-28 a ticket carrying a\n      valid `completion-verifier` attestation read as `unsigned` through the deployed MCP server.\n      So the claim gate, the plan-review close gate and the completion-verification close gate\n      must assert store freshness and REFUSE — naming the condition and the local-CLI fallback —\n      rather than certify against a view other readers do not have. Staleness is defined LOCALLY\n      (no network): the durable `rebar-push-pending` marker, or HEAD behind/diverged from the\n      already-fetched remote-tracking ref. The probe itself fails OPEN (a broken diagnostic must\n      not block a healthy gate); a PROVEN stale verdict fails CLOSED.\n\n      **Scope change, recorded here rather than silently applied.** This criterion originally\n      read:\n\n      > \"A tracker write that cannot reach the shared store FAILS LOUDLY to the caller rather\n      > than returning success — silent stranding is the part that makes this dangerous.\"\n\n      That is the OPPOSITE of standing **operator decision B4**, recorded on closed bug\n      `e1ed-b700-c442-4d0c` (`vapoury-attack-lamb`) under \"## Approved remedy (operator decision\n      B4)\": \"The remedy must be a SIGNAL, never an exception or a non-zero exit\", with \"raising\n      on the default path\" explicitly OUT of scope. B4 is pinned in `docs/concurrency.md:551,594`\n      and `src/rebar/_store/push_classify.py:40`, and it already SHIPPED and works — every MCP\n      write returns `push_status: final-push-rejected` and records the durable marker. The signal\n      is therefore present and being IGNORED; it was never missing. Blanket write-refusal was\n      also considered and REJECTED by the operator: during the 2026-08-28 four-hour starvation\n      window it would have write-blocked every session, converting a degraded-but-usable system\n      into an outage. This wording supersedes the original as of 2026-08-28, operator-approved.\n- [ ] The existing backlog on the container is reconciled without losing events (the store is\n      append-only, so a merge should preserve them — verify rather than assume).\n- [ ] `ENV_ID_MISMATCH` on that store is resolved or explicitly accepted with its consequence\n      for attestations recorded.\n- [ ] LIVE VALIDATION — REQUIRED TO CLOSE: a comment written through the deployed MCP server is\n      observed on `origin/tickets` from a different machine, with the tool response and the\n      resulting commit recorded here.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_store/freshness.py","reason":"new: the local staleness definition + the gate refusal message"},{"path":"src/rebar/llm/plan_review/attest_gate.py","reason":"claim gate refuses on a stale store before reading the attestation"},{"path":"src/rebar/_commands/gates.py","reason":"plan-review close gate refuses on a stale store"},{"path":"src/rebar/_commands/close_precheck.py","reason":"completion close gate refuses before the billable verifier"},{"path":"src/rebar/schemas/plan_review_status.schema.json","reason":"admit the new stale-store verdict to the schema enum"},{"path":"src/rebar/_mcp_reads.py","reason":"name stale-store in the plan_review_status tool description"},{"path":"tests/unit/test_gate_store_freshness.py","reason":"new: RED-first gate-refusal tests + the B4 non-regression guard"},{"path":"docs/concurrency.md","reason":"document the gate-side freshness assertion beside the B4 push-pending marker"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","5019-6f15-4ad5-4128"],["relates_to","62ab-c11e-30c2-40be"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"b02425cb-4bd7-40f6-9074-9c92e3b90a51","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["mcp","tracker","data-integrity","deploy"],"ticket_id":"b928-3ab6-5985-417b","ticket_type":"bug","title":"Deployed MCP server's tickets store cannot push: every tracker write is silently stranded in the container","verify_commands":[]},"source_event_uuids":["f2eab529-0bfd-4e39-9406-69616a79ecaa","70b295c2-eeba-4c2c-b60e-fbd753ae453c","97e23f72-945b-402d-aada-41c8c068e309","4615ff7c-010e-4982-b923-f4486a0f701c","d29422a3-7330-4708-b35d-bf3182cb6766","b02425cb-4bd7-40f6-9074-9c92e3b90a51","ec41742e-f4c5-41d7-989f-6bdf29913d63","56bb3b74-a4a3-42b2-8c30-d247f5a2cc66","8604752b-64c8-4be0-82a9-7d8c73ea3608","966affed-edd2-4afd-be13-4fcd8db63ea4","6d986e19-e30c-43e0-889a-0f439d88499a","d6d25698-f8e9-4a11-b395-1eae121185fd","e79e6e51-2218-467b-bf07-e11062e04704","b20ea538-3977-436d-b8d4-35494b7bfcfc"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787957032296781002,"uuid":"c5edceb4-32b6-48d1-a126-ecf10a71558f"}