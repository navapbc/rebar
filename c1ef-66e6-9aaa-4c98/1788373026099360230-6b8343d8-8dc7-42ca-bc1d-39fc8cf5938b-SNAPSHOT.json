594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"12146060c56920fe87e97c01ac816d2dafa46b23fc8e7db4daa038b9cfe5482d","event_uuid":"2839c1d3-bfe4-495c-b257-1c253bf7a296","position":{"commit_sha":"7461775e3a79f345968f209e8d8dcc392e1e2ef6","position":"1788365885735965001-2839c1d3-bfe4-495c-b257-1c253bf7a296"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5151602a1574e04da81357ec4c1a336aa94292ea34756a807a96dd68026faed9","event_uuid":"659f55e4-6049-48b1-9229-e8933d6c17ac","position":{"commit_sha":"fbfee1f97052fcf0d59709e136c0ca96cb83e869","position":"1788365888903102001-659f55e4-6049-48b1-9229-e8933d6c17ac"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"plan_defect","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA (Phase 1) confirmed before repair.\n\nStep 0(a): duplicate/similar sweep found this ticket as the active report; related closed bug 05cb-f7af-2d85-4d60 fixed `show` visibility for inbound blockers but not `next_batch` scheduling. Open/in-progress bug list confirms c1ef-66e6-9aaa-4c98 is the active scheduling defect.\nStep 0(b): no explicit reported build in the report; created_at 1788332604923951551 gives floor a85cb4781845ccf0d8c0375adce9a01391ba4bc8. Suspect paths had no commits between that floor and current origin/main.\nStep 0(c): debug worktree is current at 384ca0dc2d7ceaabe2f27575dac2936c3a1e86cd (= origin/main).\n\nDesign-decision check: no ADR found that intentionally gives `next_batch` looser readiness than `deps`/`ready`. Authoritative docs say `ready` lists tickets ready to work when all blockers are closed, and `ticket-model.md` states the hierarchy is what `ready`/`next-batch` operate on and that a ticket's blocked-ness is an inbound `blocks` or outgoing `depends_on`, consistent with what `ready`/`next-batch` compute. So the two views should agree; fixing `next_batch` to honor documented blocking-edge semantics is a defect fix, not a design change.\n\nMechanism: `src/rebar/_engine_support/next_batch.py::compute` builds ready candidates and `_blocked_ids` by inspecting only each ticket's outgoing `depends_on` edges. A prerequisite recorded as `A blocks B` is stored as an outbound edge on A and an inbound edge on B, so B has no outgoing `depends_on` and is incorrectly admitted to `next_batch`. `ticket_deps` reaches `src/rebar/graph/_blockers.py::_find_direct_blockers`, which combines B's own outgoing `depends_on` with other tickets' outbound `blocks` targeting B, so it correctly reports B as blocked.\n\nDiscriminating local reproduction: a constructed store with epic/story/blocker/blocked and one LINK on blocker (`relation=blocks`, `target_id=blocked`) produced `ticket_deps('blocked') = blockers:['blocker'], ready_to_work:false` while `next_batch('epic')` returned `['blocker','blocked']` in batch. The same store using `blocked depends_on blocker` excluded `blocked` from `next_batch`, isolating the divergence to inbound `blocks` handling rather than status filtering, descendants, or file-overlap scheduling.\n\nDefect origin: attribution is scope-of-work/omission in the next-batch Python port ticket `sure-beech-taunt` / `1ff3-a12e-f99a-4b07`. The current faulty lines mostly blame to commit 92caa823ae17e (`feat(next-batch): port to Python behind REBAR_COMPUTE (Tier C, sure-beech-taunt)`), which faithfully carried the earlier bash selector's outgoing-only `depends_on` filter. That ticket's acceptance/port parity work should have covered the documented `blocks`/`depends_on` equivalence and the `deps`/`next_batch` readiness invariant. The commit predates the trailer convention (`verify-commit-ticket --rev 92caa823ae17e` finds no resolvable ticket), so I will record the origin explicitly on close with `--caused-by=1ff3-a12e-f99a-4b07` rather than relying on blame auto-derivation.","timestamp":1788338030107191920}],"completion_expectation":"required","created_at":1788332604923951551,"creation_channel":"mcp","deps":[{"link_uuid":"019d7250-8295-4bc1-94f2-462760056f2f","relation":"discovered_from","target_id":"65dd-e93b-666a-4caa"},{"link_uuid":"f119d2a2-f490-4eeb-849d-a0a25c396a93","relation":"relates_to","target_id":"5333-697c-c4a8-4daa"},{"link_uuid":"659f55e4-6049-48b1-9229-e8933d6c17ac","provenance":"explicit","relation":"caused_by","target_id":"1ff3-a12e-f99a-4b07"}],"description":"## Context / Problem\n\n`next_batch` returns a ticket as available for work while `ticket_deps` reports that same\nticket has open blockers and `ready_to_work: false`. The two readiness answers disagree, and\n`next_batch` is the one agents are told to use to pick work, so an agent following it can\nclaim a ticket whose prerequisites have not landed.\n\n## Reproduction\n\nObserved 2026-09-01 on the live store, epic `spin-cub-usher` (`65dd-e93b-666a-4caa`).\n\nThe epic's ADR child `eaved-lighted-hedgehog` (`a5bf-c1f8-3950-4f87`) was linked with two\nprerequisite edges recorded from the prerequisite side:\n\n```\nlink modern-loathful-snake        eaved-lighted-hedgehog blocks\nlink divinatory-offensive-groundhog eaved-lighted-hedgehog blocks\n```\n\nBoth prerequisites are open. Then:\n\n- `ticket_deps eaved-lighted-hedgehog` returns\n  `{\"deps\": [], \"blockers\": [\"1cef-7fbc-e402-467c\", \"5169-ab69-9c23-4f8b\"], \"ready_to_work\": false}`\n- `next_batch spin-cub-usher` returns that same `a5bf-c1f8-3950-4f87` inside `batch`, with\n  `available_pool: 2`, and does not list it under any `skipped_*` key.\n\nExpected: a ticket with an open blocker is excluded from `batch` (it belongs in a skipped\nbucket). Actual: it is offered as available work.\n\n## Root cause\n\n`src/rebar/_engine_support/next_batch.py` derives readiness solely from a ticket's OUTGOING\n`depends_on` relations. At `next_batch.py:176-182` it builds `open_depends_on` by filtering\nthat ticket's own `deps` for `relation == \"depends_on\"` and skips the ticket only when that\nlist is non-empty; the blocked-id set at `next_batch.py:220-228` applies the same\noutgoing-`depends_on` test.\n\nA `blocks` edge recorded from the prerequisite (`A blocks B`) leaves B with an INBOUND edge\nand no outgoing `depends_on`, so B passes both filters. `ticket_deps` computes `blockers`\nfrom the inbound direction and therefore disagrees.\n\nThis matters because both link directions are sanctioned: `AGENTS.md` documents `blocks` and\n`depends_on` as two of the canonical relations, and the brainstorm/authoring guidance tells\nauthors to \"record their parent and prerequisite relationships with `blocks` or\n`depends_on`\". Only one of those two spellings is honored by the scheduler.\n\n## Scope\n\n`src/rebar/_engine_support/next_batch.py` readiness derivation, plus its tests. The fix is to\ntreat an open inbound `blocks` edge as blocking, exactly as `ticket_deps` already does — not\nto change the link vocabulary or the recorded edges.\n\n## Non-goals\n\n- Changing `ticket_deps`, which is the surface that already answers correctly.\n- Altering blocking-link promotion or the link relation vocabulary.\n- Reworking the file-impact conflict scheduling in the same module.\n\n## Compatibility and rollback\n\nBehavior-narrowing: tickets that were previously offered while blocked stop being offered.\nNo stored data or event shape changes, so back-out is reverting the readiness predicate.\nAny consumer relying on the current over-permissive batch would have been scheduling\nunclaimable work.\n\n## Testing\n\nUnit tests against the real `next_batch_state` over a temporary store seeded with a\nprerequisite pair, covering both edge spellings and the symmetry with `ticket_deps`.\n\n## Acceptance Criteria\n\n- [x] A ticket whose only prerequisite edge is an inbound `blocks` from an OPEN ticket is\n      absent from `batch` and present in a skipped bucket; verified by `pytest` over a\n      seeded temporary store asserting the returned `batch` ids.\n- [x] The same ticket becomes available once that prerequisite closes; verified by `pytest`\n      asserting it appears in `batch` after the blocker transitions to closed.\n- [x] `next_batch` and `ticket_deps` agree for every child of a seeded epic: no id appears in\n      `batch` while `ticket_deps` reports `ready_to_work: false`; verified by `pytest`\n      asserting the intersection is empty.\n- [x] The existing outgoing-`depends_on` behavior is unchanged; verified by `pytest` over a\n      seeded pair using `depends_on`, asserting the same exclusion as before.\n\n## Definition of Done\n\n`make lint`, `make typecheck` and `make test` pass; the live reproduction above no longer\noffers `a5bf-c1f8-3950-4f87` while its blockers are open.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_engine_support/next_batch.py","reason":"next_batch readiness and blocked-story filtering must use canonical blocker semantics for outgoing depends_on and inbound blocks edges."},{"path":"tests/interfaces/queries/test_next_batch_behavior.py","reason":"Regression tests seed inbound blocks and outgoing depends_on edges and assert next_batch agrees with ticket_deps readiness."},{"path":"tests/interfaces/queries/test_next_batch_compute.py","reason":"JSON shape contract includes the new skipped_blocked bucket."},{"path":"src/rebar/schemas/next_batch.schema.json","reason":"Public next_batch JSON schema declares skipped_blocked."},{"path":"src/rebar/schemas/common.schema.json","reason":"Shared skipped_item schema allows the blocker field used by skipped_blocked entries."},{"path":"src/rebar/types.py","reason":"Public TypedDicts expose skipped_blocked and the blocker field."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","5333-697c-c4a8-4daa"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"2ca24da1-f4c3-4b9f-90f7-875848904f54","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["next-batch","scheduling","concurrency"],"ticket_id":"c1ef-66e6-9aaa-4c98","ticket_type":"bug","title":"next_batch schedules a blocked ticket: readiness ignores inbound blocks edges","verify_commands":[]},"source_event_uuids":["7a977944-7722-4e55-b521-ec37c40a886a","bf74c446-b5dd-4e9a-b956-2e11eba814b0","3f56a100-b6bd-44c9-9eaf-a85d5c3c58cb","0a406644-a4e2-43e7-90ca-df8caeb7253b","f119d2a2-f490-4eeb-849d-a0a25c396a93","fd6ed29f-229d-4dfb-b838-8cdcddbad1a3","3a117b20-a06b-41da-9395-025542ec8a9f","071c2353-e3c5-454d-8e85-2370f6c6afad","2ca24da1-f4c3-4b9f-90f7-875848904f54","2839c1d3-bfe4-495c-b257-1c253bf7a296","659f55e4-6049-48b1-9229-e8933d6c17ac"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1788373026099360230,"uuid":"6b8343d8-8dc7-42ca-bc1d-39fc8cf5938b"}