4c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f9e69f5575d21ae24183cb709617883c5290cffb524a7ea7d9fd5cbd20cf76cd","event_uuid":"99f08eb5-8379-4a25-ae50-a9629e95b6cb","position":{"commit_sha":"e56c188db10f4aa727251125ade09cc2837e51d8","position":"1788494315766102972-99f08eb5-8379-4a25-ae50-a9629e95b6cb"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Claimed; beginning held-out TDD in worktree janitor-21de-f9d9.","timestamp":1788468938187799480},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Blocked after held-out TDD implementation validation in worktree janitor-21de-f9d9. Plan-review PASS, claimed successfully. RED oracle failed for missing module_size_trend/cap_change_events; implementation now passes held-out GREEN and sandboxed mutation check. Targeted in-scope metric tests pass (34 passed), make lint passes, make typecheck passes. However the existing out-of-scope test tests/unit/metrics/test_dead_values_heldout_7504.py still expects module_size_trend to be unclaimed and now fails. That file is not in the dispatch's declared file_impact, so I stopped per protocol instead of editing it or proceeding to commit/Gerrit.","timestamp":1788479905616880010},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Progress update: implemented and pushed Gerrit change 2602. Plan-review was re-run after including the directly-coupled freed-ID heldout file and passed. Targeted tests pass (38 passed); lint and typecheck pass. Full local `make test` is too long serially for this leaf session, but a local xdist run only failed unrelated timeout-budget tests because xdist leaked into nested timeout assertions; the ticket-targeted suite is green. Gerrit PS2 and PS3 got LLM-Review +1; Verified is currently -1 because Ubuntu py3.11/py3.13 both report only an xdist worker crash in unrelated tests/e2e/test_editor_e2e.py::test_emitted_bpmn_has_no_illegal_ids, no assertion/traceback, while Ubuntu py3.12 and macOS py3.13 passed. I verified that e2e test passes locally both direct and with xdist. Continuing with CI recheck as an environmental worker-crash failure, not changing unrelated editor code.","timestamp":1788493316477346329}],"created_at":1788314108474764001,"creation_channel":"cli","deps":[{"link_uuid":"29b94438-52d1-4ca4-a698-c95bac5afdd9","relation":"relates_to","target_id":"c93f-9d90-3c8d-49ec"},{"link_uuid":"a319c1f5-9ac0-4968-aec8-54ce710d67b4","relation":"relates_to","target_id":"b0be-3a75-5a0a-4499"},{"link_uuid":"6a311cf3-026b-431c-a544-f97e947335c4","relation":"relates_to","target_id":"a7d7-86ce-3c90-4d7c"},{"link_uuid":"99f08eb5-8379-4a25-ae50-a9629e95b6cb","relation":"relates_to","target_id":"efcc-44d8-1400-478f"}],"description":"## Context / Problem\n\n`docs/user-guide.md:423-440` advertises module-size trend and cap-change metrics, but `src/rebar/metrics/git_metrics.py` currently registers neither ID. Janitor is now a concrete read-only consumer, changing the prior no-consumer decision that removed the placeholder specs. The existing generic registry, CLI, and metrics schema already accept registered metrics without per-ID code; this work must add real computations rather than reintroduce always-unavailable seeds.\n\n## Computation contract\n\nBoth metrics walk commits reachable from `HEAD`, collect each commit SHA and committer ISO timestamp, filter inclusively by the existing `--since`/`--until` date semantics, then sort by `(committer_timestamp, SHA)` for deterministic oldest-to-newest history. A qualified revision has a positive integer `.github/module-size-limit.txt` blob and at least one tracked `src/rebar/**/*.py` blob. The metric requires at least two qualified revisions; fewer than two returns the standard `Unavailable` result with a specific reason, never a zero or empty placeholder. Git execution failure, a non-Git repository, a missing/unparseable cap blob, or absent qualifying Python modules likewise return `Unavailable`.\n\nTo bound cost and output, retain every qualified revision when there are at most 50; otherwise take 50 evenly spaced index samples including the first and last, and report the total qualified-revision count. For each retained revision, measure each module exactly as the CI cap does: count newline characters in that revision’s tracked blob (the `wc -l` equivalent), not working-tree files or analyzer `Code` lines. `module_size_trend` returns the ordered samples, each containing SHA, timestamp, historical cap, module count, and maximum module LOC. The cap is read from the same revision, so a later cap change cannot reinterpret older samples.\n\n`cap_change_events` compares the historical cap values of every adjacent qualified revision before sampling; it returns the ordered list of changed pairs (`from`, `to`, SHA, timestamp) plus the qualified-revision count. A sufficiently evidenced history with no changes reports an empty event list, not `Unavailable`.\n\n## Approach\n\nImplement the shared Git-history reader and both registry specs in `git_metrics.py`, with `lens=code_health`, `source=git`, and `confidence=high`. Update documentation with the bounded sampling and unavailable semantics. The generic CLI/schema need no code or schema change because their metric map is intentionally open and registry-driven.\n\nReplace obsolete non-registration expectations with implementation expectations: `test_cap_change_events_deregistered` becomes a live-registration/provenance/shape test, and the held-out freed-ID parametrization drops only `module_size_trend` while retaining `commit_cadence_trend` as the still-unclaimed ID. Add fixture histories for growth/shrink, more-than-50 deterministic sampling, cap changes, no cap change, insufficient history, invalid/missing cap, no qualifying modules, no Git, and Git command failure.\n\n## Scope\n\n- `src/rebar/metrics/git_metrics.py` — bounded historical blob reader and the two real specs\n- `docs/user-guide.md` and `docs/maintenance-audit-runbook.md` — computation, sampling, and unavailable semantics\n- `tests/unit/metrics/test_git_metrics.py` and `tests/unit/metrics/test_git_metrics_heldout.py` — value, boundary, and unavailable fixtures\n- `tests/interfaces/test_metrics_cli.py` — replace the cap-change deregistration assertion with registered metric coverage\n- `tests/unit/metrics/test_dead_values_heldout_7504.py` — retain the freed-ID guard only for `commit_cadence_trend`\n\n## Testing\n\nUse temporary Git repositories with committed blobs and fixed committer timestamps. Assert exact ordered samples, raw newline LOC, historical caps, event pairs, 50-sample endpoint inclusion, and `Unavailable` reasons. Exercise the public `rebar metrics --output json` result for provenance and metric presence.\n\n## Acceptance Criteria\n\n- [ ] `module_size_trend` walks the deterministically ordered, date-filtered reachable history, requires at least two qualified revisions, and reports total qualified-revision count plus at most 50 evenly spaced endpoint-inclusive samples.\n- [ ] Each module-size sample contains its commit SHA, committer timestamp, cap read from that commit, module count, and maximum LOC computed by newline count from tracked `src/rebar/**/*.py` blobs.\n- [ ] `cap_change_events` compares every adjacent qualified revision before sampling and returns ordered `{from, to, sha, timestamp}` events; a qualifying history with no change returns an empty event list.\n- [ ] Fewer than two qualified revisions, Git failure/non-Git state, missing or invalid cap data, and absence of qualifying modules produce structured `Unavailable` with a specific reason rather than a zero or placeholder.\n- [ ] Both specs register once with `code_health` / `git` / `high` provenance and are rendered by the existing open metrics CLI/schema without a per-ID schema change.\n- [ ] The interface deregistration assertion becomes live cap-change metric coverage, and the held-out freed-ID parameterization retains only `commit_cadence_trend`.\n- [ ] Focused Git-history, unavailable-path, registry, and CLI tests pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/metrics/git_metrics.py","reason":"implement Git-derived historical metrics"},{"path":"src/rebar/metrics/registry.py","reason":"registry contract preserved"},{"path":"src/rebar/_commands/metrics.py","reason":"existing command composition preserved"},{"path":"src/rebar/schemas/metrics.schema.json","reason":"structured output contract preserved"},{"path":"docs/user-guide.md","reason":"document implemented metric behavior"},{"path":"docs/maintenance-audit-runbook.md","reason":"document Janitor/audit use"},{"path":"tests/unit/metrics/test_git_metrics.py","reason":"prove Git-history metric values"},{"path":"tests/unit/metrics/test_git_metrics_heldout.py","reason":"prove unavailable and edge controls"},{"path":"tests/interfaces/test_metrics_cli.py","reason":"verify CLI/registry exposure"},{"path":"tests/unit/metrics/test_dead_values_heldout_7504.py","reason":"update freed-ID guard now that module_size_trend is intentionally claimed by this ticket"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["parent","78f2-b104-e3c9-4b86"],["relates_to","a7d7-86ce-3c90-4d7c"],["relates_to","b0be-3a75-5a0a-4499"],["relates_to","c93f-9d90-3c8d-49ec"],["relates_to","efcc-44d8-1400-478f"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"2ed1fd87-1e6f-4998-8494-66aa7a84d233","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["janitor","metrics","git","rp35"],"ticket_id":"21de-f9d9-475f-414c","ticket_type":"story","title":"Implement Git-backed module-size trend and cap-change metrics","verify_commands":[]},"source_event_uuids":["9b86f932-eb6c-4143-b5b1-9f434a387c34","8f802677-e8d3-48fe-9c1d-381db9c67ba5","6fb03ed3-5569-4b5d-837d-c4c505f48d75","2ed1fd87-1e6f-4998-8494-66aa7a84d233","b8ee9222-a82a-4ca2-98c5-7cb5e10c0c08","c24f0a12-e132-4fd9-b696-87a2fb58c41c","d48453c8-43d1-437e-8b0d-413813cf23b8","50c56007-596c-4dfa-b82c-c888dfb159f6","f2e8b621-b301-4ef1-901f-275eaa757b05","29b94438-52d1-4ca4-a698-c95bac5afdd9","a319c1f5-9ac0-4968-aec8-54ce710d67b4","6a311cf3-026b-431c-a544-f97e947335c4","7466f00f-7a82-4a50-8780-ae8896f1ab16","99f08eb5-8379-4a25-ae50-a9629e95b6cb"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788496554410026001,"uuid":"c5812cbe-b1f0-4768-912b-f6a3e6425b91"}