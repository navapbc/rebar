4e0-97ab-b61787d75db4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"290ab892d490ef93e7b3c6ff449a3870209a2b2ec299bfbcb2091377a5aebc54","event_uuid":"abe323bf-46bd-48b7-9b8b-929e53205b6c","position":{"commit_sha":"bd12c77140f5188592a41e43193dbf0c9dac6cf3","position":"1788409496569757865-abe323bf-46bd-48b7-9b8b-929e53205b6c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788318381961839586,"creation_channel":"mcp","deps":[{"link_uuid":"0065e5b9-d735-4a7a-83e8-607b61bff6f7","relation":"blocks","target_id":"092c-a664-2477-4d83"},{"link_uuid":"e7af2471-1b3c-4d07-b468-713f3d4ad557","relation":"relates_to","target_id":"818c-5b41-7fa1-4328"},{"link_uuid":"058fd4e6-7b28-4915-a8ce-bfc898b081de","relation":"relates_to","target_id":"33a3-f342-6432-4c85"},{"link_uuid":"1c812b66-63ec-4237-8244-b787621001fd","relation":"relates_to","target_id":"378f-5d65-2a8c-473e"},{"link_uuid":"29404dd2-eb68-44e0-97ab-b61787d75db4","relation":"relates_to","target_id":"9e0e-e355-08a6-4416"},{"link_uuid":"abe323bf-46bd-48b7-9b8b-929e53205b6c","relation":"relates_to","target_id":"bf2d-be38-4c5d-42ff"}],"description":"## Context / Problem\n\nMost plan-review criteria have no eval fixture, so a rubric edit ships with no behavioral\noracle. The selector must decide which reviews are trustworthy evidence of a criterion's\nbehavior — the corpus records what the reviewer SAID, not what was true. Two\nhazards make naive selection wrong. Reviewer noise: 551 byte-identical-material review pairs\nflipped verdict 208 times, so one observation is not a label. Prompt vintage: rubrics were\nrewritten inside the corpus window, so a finding from a retired rubric does not describe\ntoday's criterion (`regver`, `manifest.py:139-185`, hashes routing and ids, not rubric bytes).\n`corpus.py` reconstructs at-review plan text (`corpus.py:270-288`) over 6,482 committed rows.\n\n## Approach\n\nAn offline selector writing a LABELED CANDIDATE MANIFEST — per criterion, each candidate with\nits direction, tier, signals and rank, plus a zero-candidate row (with reason) for every\ncriterion that produced none. The manifest is JSONL: one JSON object per line, keys sorted,\nrows in the rank order below — a byte-stable contract for the diff AC and the emitter. No YAML,\nno model call.\n\n**Candidate key and signal join.** A FIRE candidate is keyed `(criterion, norm_id)`\n(`sidecar.py:656,663`); signals join on that key, which is load-bearing because they live on\ndifferent pair relationships: `finding_survival` over consecutive DIFFERING-material pairs,\nreproduction consensus over EQUAL-`material_fingerprint` pairs. A key in one relationship gets\nthat signal alone.\n\n**Vintage gate.** A review is eligible for criterion C only when `review_event_ts`\n(`corpus.py:273`) postdates the last commit touching C's rubric file. With\n`pid = criterion_prompt_id(C)` the path resolves by `get_prompt`'s override-wins ordering\n(`prompts.py:187-198`): `.rebar/prompts/<pid>.md` if present, else `reviewers/` joined to\n`prompts.get_prompt(pid).fallback_file` (`prompts.py:196`). History is read\nby `git log` against the gate's configured base ref (`gate_source.default_ref`, `origin/main`\nby default); when that ref is absent (shallow clone, differently-named remote) or git errs, C\nfails closed to a zero-candidate `no-committed-prompt-history` row rather than crashing — the\nsame row a criterion with no committed rubric history (an uncommitted override, or a post-freeze\nrubric) records. The gate keys on git history alone, never on C's name.\n\nBoth label signals are Pass-1 finder observations from the historical sidecar, not Pass-2\nverifier output, so only the criterion's own rubric vintage gates them; no\n`plan-review-verifier` sub-gate applies.\n\n**Label signals**, offline and independent of the reviewer's own verdict:\n- *Reproduction consensus* — a key that fired, or stayed absent, consistently across two or\n  more equal-`material_fingerprint` reviews. The only signal valid no-fire.\n- *Author response* — `finding_survival == \"resolved_by_author\"` (`labels.py:158-171`), the\n  only per-finding label the labels module produces. Fire direction only.\n\n**No-fire admission.** A no-fire candidate has no fired finding and therefore no `norm_id`, so\nit is keyed `(C, norm_id=None)` and admitted ONLY under the parent epic's predicate: C is in\nthe `cohort` set of some finding on that plan (`sidecar.py:667-672`, proving C was ROUTED) AND\nno finding cites C; a missing-`cohort` row is skipped, never read as empty. Reproduction\nconsensus then RAISES an admitted no-fire candidate to ADVISORY — it is the ranking signal, not\nthe admission gate; absence-consensus alone never admits what the parent's predicate forbids.\n\n**Escaped defect is a PRIORITY signal, not a label.** `escaped_defect` (`labels.py:70-73`) is\na per-TICKET bool with no criterion attribution, so as a label it would misattribute a\nmust-fire candidate; it only raises a review's rank. Its absence never evidences correct\nsilence, so `clean_close` (`labels.py:43`) is not a no-fire source.\n\n**Tiered bar.** The vintage gate is a precondition of BOTH tiers: a failing candidate is\nexcluded, not downgraded. Among those passing, a FIRE candidate is BLOCKING only when all three\nhold: reproduction consensus, author-response corroboration, and `abs(decision_margin)`\n(`sidecar.py:344-360`) at or above `MIN_MARGIN = 0.15`. `decision_margin` is `None` (never\n0.0) when either side was unrecorded, and a `None` margin never qualifies. Margin and\nauthor-response are per-finding and fire-direction only, so a NO-FIRE candidate reaches at most\nADVISORY on consensus alone. Any single signal proposes ADVISORY.\n\n**Rank order.** BLOCKING before ADVISORY, then escaped-defect priority, then descending\n`abs(decision_margin)` with `None` margins sorting last, then ascending `review_event_uuid` as\na deterministic tie-break; the emitter then takes a fixed number per side.\n\n**Skip list.** A criterion with an open `unreliable-criterion: <id>` ticket is skipped,\nrecorded as a zero-candidate row with that reason.\n\n## Scope\n\nA new module under `src/rebar/llm/evals/` holding the selector, its predicates and the JSONL\nmanifest writer, over `plan_replay/corpus.py` and `labels.py`. It covers only criteria\n`criteria.effective_routing('.', gate_key='plan_review')` reports with no spec in\n`.rebar/evals/` or `src/rebar/llm/eval_specs/`.\n\n## Non-goals\n\n- Writing any `.eval.yaml` or admitting a candidate (the emitter and admission runner own\n  those); any model call; per-finding true/false-positive labelling and human adjudication.\n\n## Testing\n\nUnit tests over the predicates on synthetic corpus rows, plus one integration test over the\nreal corpus with no model; all assertions deterministic.\n\n## Acceptance Criteria\n\n- [ ] A review predating its criterion's resolved rubric commit is excluded, an\n      otherwise-identical later one included; `pytest` asserts the manifest holds only the\n      second row's id.\n- [ ] The gate git-logs `.rebar/prompts/<pid>.md` for a criterion with an override and the\n      packaged `fallback_file` for one without; `pytest` over the path.\n- [ ] A criterion excluded for either reason — no committed rubric history (incl. an\n      unresolvable base ref) or an open `unreliable-criterion: <id>` ticket — carries a\n      zero-candidate row naming it; parameterized `pytest` over an uncommitted override, an\n      absent base ref, and a stubbed listing.\n- [ ] A fire candidate failing the vintage gate yields no row, not an advisory one; `pytest`\n      asserts its absence.\n- [ ] Removing each of reproduction consensus, author-response and margin in turn downgrades a\n      fire candidate to `advisory`, all three present yields `blocking`, and a `None` margin\n      never yields `blocking`; parameterized `pytest` over the recorded tier.\n- [ ] A no-fire candidate is admitted only when C is in some finding's `cohort` on the plan and\n      no finding cites C (missing-cohort skipped), keyed `norm_id=None`, and never `blocking`;\n      parameterized `pytest`: a routed-and-silent key is `advisory`, a missing-cohort key and a\n      cited key are both absent.\n- [ ] A candidate whose only signal is `escaped_defect` appears in no direction; one carrying\n      it outranks an equal-signal peer; `pytest` over the list and ranks.\n- [ ] A key present only in equal-fingerprint pairs records reproduction consensus and no\n      author-response signal; `pytest` asserts the recorded signal set.\n- [ ] Given 6 candidates on one side with distinct margins plus one `None` margin, the recorded\n      ranks follow the stated order with `None` last; `pytest` over the ranks.\n- [ ] Two consecutive real runs over the committed corpus emit a byte-identical JSONL manifest\n      under the repository's network guard; `diff` of the two files exits 0 with the guard\n      active.\n\n## Definition of Done\n\n`make lint`, `make typecheck` and `make test` pass; the real-corpus run writes a manifest row\nper uncovered criterion; `.rebar/evals/` is untouched.\n\n## Budget\n\n**$0.** Selection is a pure function of the corpus and git metadata.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/evals/fixture_mining/select.py","reason":"The candidate selector: signal join on (criterion, norm_id), the vintage gate, the tiered bar and the rank order."},{"path":"src/rebar/llm/evals/fixture_mining/manifest.py","reason":"Writer for the labeled candidate manifest the sibling emitter consumes."},{"path":"tests/unit/test_fixture_selection.py","reason":"Unit tests for the vintage boundary, the signal join, the four blocking conjuncts, the escaped-defect priority rule, the rank order and the skip list."},{"path":"tests/integration/test_fixture_selection_corpus.py","reason":"Determinism run of the selector over the real committed corpus with no model configured."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["blocks","092c-a664-2477-4d83"],["blocks","67aa-eb04-8814-4975"],["parent","65dd-e93b-666a-4caa"],["relates_to","33a3-f342-6432-4c85"],["relates_to","378f-5d65-2a8c-473e"],["relates_to","818c-5b41-7fa1-4328"],["relates_to","9e0e-e355-08a6-4416"],["relates_to","bf2d-be38-4c5d-42ff"]],"no_file_impact_reason":"","parent_id":"65dd-e93b-666a-4caa","parent_status_uuid":"c4d1aaec-ccdd-46d3-bd38-79e8af2fa844","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["plan-review","evals","fixtures"],"ticket_id":"549b-9cc5-940e-46c3","ticket_type":"story","title":"Select and label per-criterion fixture candidates from the plan-review sidecar corpus","verify_commands":[]},"source_event_uuids":["cde21c6b-c47b-4e28-877d-52daa305dfa0","741ac649-1cad-4634-8bec-f4c5fa634fed","3bd07319-afc7-422f-908e-8e4a6c8f8072","5bbe3bbf-5ddf-45b2-8b9f-3cb16705d184","e0a760c7-98b3-4f7d-badc-6cdb144b16bd","c4d1aaec-ccdd-46d3-bd38-79e8af2fa844","a8dd3149-cdd8-4954-b8d2-f20abc8406e0","e7af2471-1b3c-4d07-b468-713f3d4ad557","058fd4e6-7b28-4915-a8ce-bfc898b081de","1c812b66-63ec-4237-8244-b787621001fd","29404dd2-eb68-44e0-97ab-b61787d75db4","abe323bf-46bd-48b7-9b8b-929e53205b6c"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788409496569757866,"uuid":"46ca4d2c-4d5c-4eb9-ba20-1818fe3253ca"}