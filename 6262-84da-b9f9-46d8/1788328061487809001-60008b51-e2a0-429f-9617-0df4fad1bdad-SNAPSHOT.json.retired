BEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1e7d97eaba00d618cbca4161b1d5e106abdfdf109c054ad4883f5c858cb87e15","event_uuid":"5f7a735c-648c-45f7-abb3-571b88ec8acc","position":{"commit_sha":"06188de87786ed88ce9f9c92668a15042309121a","position":"1788316237203014001-5f7a735c-648c-45f7-abb3-571b88ec8acc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788313738201246001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n\nIndependent validation confirmed stale rollout headers at `mapping_config.py:1-22`, adapter headers, and `apply_outbound.py:80-88`; arbitration prose conflicts with `outbound_differ.py:234`; `OutboundDiffConfig` documents five values despite nine at `outbound_differ.py:217-262,511-524`; and `docs/env-vars.md:149,153` omits rollback semantics.\n\n## Approach\n\nCorrect the maintained source headers and authoritative operator material to reflect current behavior. Treat `docs/env-vars.md` as generated: update its source metadata or provide an authoritative operator page plus generated link, never hand-edit generated output. Document the verified five-field baseline arbitration and consumer-specific legacy create-route effects.\n\n## Scope\n\n- reconciler module headers and outbound configuration documentation\n- authoritative rollback/config documentation and generated env-var output/source\n- documentation tests or generation checks\n\n## Testing\n\nRegenerate affected documentation, run its drift check, and verify the stated examples against focused arbitration/create-route tests.\n\n## Acceptance Criteria\n\n- [ ] Rollout headers describe active mappings, Cloud/DC transport, and create/update paths.\n- [ ] Documentation states that the five inbound-mirrored fields suppress outbound write only when local equals stored baseline; local changes, conflicts, non-arbitrated fields, and incomplete baselines retain local behavior.\n- [ ] All nine `OutboundDiffConfig` fields and explicit `mapping=`/`repo_root=` precedence over config values are documented.\n- [ ] Rollback documentation gives accepted values, defaults, and consumer-specific effects without claiming `legacy` always deletes.\n- [ ] Generated env-var documentation is regenerated from an authoritative source and its drift check passes.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/mapping_config.py","reason":"correct stale rollout header"},{"path":"src/rebar/_engine/rebar_reconciler/adapters/__init__.py","reason":"correct adapter rollout header"},{"path":"src/rebar/_engine/rebar_reconciler/apply_outbound.py","reason":"correct active outbound path header"},{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"document current arbitration and all config fields"},{"path":"src/rebar/_engine/rebar_reconciler/create_route.py","reason":"source for rollback semantics"},{"path":"src/rebar/_engine/rebar_reconciler/reconcile_helpers.py","reason":"source for rollback defaults/effects"},{"path":"docs/env-vars.md","reason":"regenerated operator-facing environment documentation"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","78f2-b104-e3c9-4b86"]],"no_file_impact_reason":"","parent_id":"78f2-b104-e3c9-4b86","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["janitor","documentation","reconciler","rp20"],"ticket_id":"6262-84da-b9f9-46d8","ticket_type":"task","title":"Correct reconciler rollout, arbitration, config, and rollback documentation","verify_commands":[]},"source_event_uuids":["652d2fc4-2d0e-4986-b9c0-fa9f4019209e","e576b01d-bc61-422e-b1d9-5bfbe95e2b24","5f7a735c-648c-45f7-abb3-571b88ec8acc"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788328061487809001,"uuid":"60008b51-e2a0-429f-9617-0df4fad1bdad"}