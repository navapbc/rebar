3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"70b955ba3846ccc61efb1e12e4e880c4b2dd0ec4cf74e883a4c80084b513a405","event_uuid":"66e3ec56-65a2-401e-b111-2caf8863d68b","position":{"commit_sha":"ce09bba299599caee9d201772a2042cc3d08e767","position":"1788744802360225001-66e3ec56-65a2-401e-b111-2caf8863d68b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"40b7bfbb95fa6b15378e0fe312fa8e3578aa5e05d26e79e285c98ec88d5ba6b9","event_uuid":"c506b061-3627-4756-b759-73e92ab29769","position":{"commit_sha":"3849fb55a594127d601cb9416edbb68fb3758eca","position":"1788744816240974001-c506b061-3627-4756-b759-73e92ab29769"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"regression","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"OBSERVATION\nRCA complete. The pause-state writer still persists the retired vocabulary. Current code has src/rebar/_engine/rebar_reconciler/_ref_lock.py:_decode_pause requiring doc['gated_mode'] == 'reconcile-check' and set_pause constructing {'gated_mode': 'reconcile-check', ...}. I reproduced in a scratch git repo outside the worktree: set_pause(... reason='maintenance' ...) wrote a gate blob whose raw JSON was {'gated_mode':'reconcile-check','paused':true,...}, and read_pause returned the same retired value.\n\nHYPOTHESIS\nThe bug is a compatibility sentinel that was intentionally retained but also kept as the new-write value: _ref_lock.set_pause uses the legacy string directly instead of writing a current canonical gate/pause vocabulary, while _decode_pause only accepts that legacy string. Because both sides are coupled, the retired value continues to be produced indefinitely rather than being read-only migration compatibility.\n\nCONFIRMATION\nThe deterministic scratch experiment confirmed the writer path without touching the checkout. Evidence that would have disproved this would be set_pause writing a current value while _decode_pause only accepted reconcile-check for old blobs; instead the new blob itself contains reconcile-check. Working comparison: mode/request retirement paths reject direct --mode reconcile-check while retaining narrow compatibility, but pause persistence still uses the legacy value on new writes.\n\nSUGGESTED FIX DIRECTION\nDesign-free fix-wave candidate: split write vocabulary from read compatibility. Make set_pause write a current sentinel, keep a narrow legacy decoder or migration for existing blobs, and add paired tests for old-read/new-write plus a fresh whole-tree sweep.","timestamp":1788737905749950001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Starting plan review for implementation. Will follow withheld-oracle TDD: add the old-read/new-write failing test first, keep the test immutable, then change only production code.","timestamp":1788738215037542001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review PASS (advisory only: grep command observability and missing file_impact). Claimed for implementation; proceeding in fresh worktree fix3-beaver.","timestamp":1788738621654117001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RED/GREEN targeted cycle complete in fix3-beaver. Immutable oracle changed existing ref-backend tests to require new pause writes to use dry-run while manually seeding an old reconcile-check pause blob to prove legacy reads still work. Targeted test file now passes (16 passed).","timestamp":1788738729918113001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"File impact recorded. Whole-tree sweep rerun in fix3-beaver; surviving reconcile-check/reconcile_check hits are expected compatibility alias/rejection text, narrow _ref_lock legacy read constant, unrelated review_bot log key, ADR prose, frozen eval fixtures, and tests that seed/verify legacy compatibility.","timestamp":1788738832223834001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"make verify passed in fix3-beaver on commit 72ef1256d828 (lint, typecheck, and full non-integration/non-external pytest suite). Pushing to Gerrit for LLM-Review and Verified gates.","timestamp":1788742902095751001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change 2728 reached LLM-Review+1 and Verified+1 with no unresolved comments and was submitted/merged. Closing as regression from vocabulary retirement.","timestamp":1788744497478305001}],"completion_expectation":"required","created_at":1788658798179781530,"creation_channel":"mcp","deps":[{"link_uuid":"19361aad-bbde-4d69-bb30-ac381ff031cd","relation":"discovered_from","target_id":"0cfc-e511-8f8a-4c8b"},{"link_uuid":"10067f98-0013-4b05-a56e-14746dd04ad7","relation":"relates_to","target_id":"7d87-995f-0970-4ff1"}],"description":"## Summary\n\nThe `reconcile-check` vocabulary was retired by `mechanical-bitter-basenji`\n(`0cfc-e511-8f8a-4c8b`, merged as `8e14d667da28`), but one **live state path** still writes it.\nThis is a deliberate, operator-directed carve-out from that story — filed here so it is tracked\ndebt rather than an unexplained residual.\n\n## The residual\n\n`src/rebar/_engine/rebar_reconciler/_ref_lock.py`\n\n- **`:717`** — the pause **writer** still persists `gated_mode=\"reconcile-check\"`.\n- **`:658`** — the matching **decoder**.\n\nEverything else in the retired family is clean. A whole-tree sweep\n(`grep -rn \"reconcile-check\\|reconcile_check\\|RECONCILE_CHECK\"`) at `12a10f3ab4ef` found\n`.github/`, `Jenkinsfile`, `scripts/` and `src/rebar/schemas/` free of it, and the remaining hits\nare all explained:\n\n- `src/rebar/_engine/rebar_reconciler/mode.py:57` — the **intentional** narrow decode alias\n  retained by 0cfc's AC3: it maps only the persisted sentinel to `DRY_RUN`, is not an enum member,\n  and is absent from `MODE_CAPS`.\n- `src/rebar/_engine/rebar_reconciler/request.py:102-104` — the retirement **rejection message**,\n  which must name the retired vocabulary in order to route users to `preview` / `fsck` / `status`.\n- `docs/adr/0092`, `docs/adr/0099`, `docs/adr/0083` — ADR prose. Historical records of decisions\n  taken when the vocabulary was live; rewriting them would falsify the record.\n- `src/rebar/review_bot/reconcile.py:350` — the `\"reconcile_check_error\"` log key. **Unrelated\n  subsystem** (the review-bot's Gerrit vote-reconcile loop). A name collision, not a residual.\n- `docs/experiments/plan-review-gate/...` — frozen eval fixtures and corpora.\n\nSo `_ref_lock.py:658/717` is the only genuine live-state survivor.\n\n## Why it was left\n\n0cfc's description carries a \"Final AC2 Option B execution note\" recording that **the operator\nexplicitly directed that pass not to edit** the pause-state decoder/writer at those lines. That is\na description-level carve-out, not a comment-level one, so it was a deliberate scope decision\nrather than an omission. It does mean 0cfc's AC2 (\"no live route/mode/state path retains the\nvocabulary\") cannot be satisfied on a literal reading, which is why that ticket's AC2 now points\nhere.\n\n## Why it is low priority but not zero\n\nThe value is persisted pause state, and the decoder that reads it is present and correct, so\nnothing is broken today. The cost is that a retired name survives in written state: any future\nreader of a pause record sees vocabulary the codebase otherwise says does not exist, and a later\ncleanup that removes the decoder without migrating the writer would strand existing pause records.\nThe two lines must therefore move together.\n\n## Acceptance criteria\n\n- [x] AC1 The pause **writer** at `_ref_lock.py:717` persists a current-vocabulary value instead of\n      `\"reconcile-check\"`.\n- [x] AC2 Existing persisted pause records written with the old sentinel are **still readable** —\n      either migrated, or read by a narrowly-retained decoder in the same shape as the one AC3 of\n      0cfc already sanctions in `mode.py:57`. Dropping the decoder in the same change that changes\n      the writer is the failure mode this AC exists to prevent.\n- [x] AC3 A test writes a pause record with the OLD sentinel and asserts it still decodes correctly\n      after the change, and a second test asserts new writes use the new value. Both directions, so\n      the migration cannot silently break old records.\n- [x] AC4 The whole-tree sweep for `reconcile-check|reconcile_check|RECONCILE_CHECK` is re-run and\n      its output recorded here, with every surviving hit individually explained (the categories\n      above are the expected survivors: the intentional decode alias, the rejection message, ADR\n      prose, the unrelated review-bot log key, and frozen eval fixtures).\n- [x] AC5 `0cfc-e511-8f8a-4c8b`'s AC2 disposition is updated to note the residual is discharged.\n\n## Constraints\n\nNever use `--force` or any gate bypass. `timeout` does not exist on this macOS host (it exits 127,\na silent no-op) — bound with `perl -e 'alarm N; exec @ARGV'`. Do not touch the shared main\ncheckout; do not `git stash` anywhere.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/_ref_lock.py","reason":"Change pause writer to current dry-run vocabulary while retaining legacy decoder."},{"path":"tests/unit/rebar_reconciler/state/test_advisory_lock_ref_backend.py","reason":"Withheld oracle covering legacy pause read and current new pause writes."},{"path":"tests/interfaces/facades/test_bridge_cli_heldout.py","reason":"CLI pause round-trip expectations for current pause vocabulary."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","7d87-995f-0970-4ff1"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"66e3ec56-65a2-401e-b111-2caf8863d68b","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"d433-782d-e74d-4b27","ticket_type":"bug","title":"Reconciler pause state still persists gated_mode=\"reconcile-check\" after the vocabulary was retired","verify_commands":[]},"source_event_uuids":["c81a2057-e379-4ff0-b898-0e3f0c06096e","1edef024-91d0-47d9-a8e3-d8ad22655a2f","8f8de696-9a7f-4e8e-b73f-ef63b2e8d94c","eb2e4845-52f7-475c-8988-2ec927b9c74e","091dd53e-1b8d-4ebe-a6ef-1823f1029fe8","5c846f10-9434-40d4-85fe-eb6f13b590c6","ec8dd8f2-16b0-40c4-a3c1-7fcd4a73f4f3","78909bce-78bd-49d0-83c2-6975072a10c1","4e31a472-6661-4ce3-a3c0-aa211dd60603","e3578508-db9b-4b02-9f2b-c8b451891f3d","10067f98-0013-4b05-a56e-14746dd04ad7","7e3c192a-d7fb-4b42-a7b0-10ed4ca743db","4f1d1a1b-31ae-42ee-b84f-e24e28fa8cba","66e3ec56-65a2-401e-b111-2caf8863d68b","c506b061-3627-4756-b759-73e92ab29769"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788751242363065001,"uuid":"9e95f31c-fdba-4bfe-91af-d27818e56474"}