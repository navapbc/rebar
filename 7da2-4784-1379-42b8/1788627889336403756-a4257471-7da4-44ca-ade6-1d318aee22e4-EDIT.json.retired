erraform_corroborator.py\nrtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py\nrtk git diff --check HEAD^..HEAD -- \"${paths[@]}\"\nrtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify\n~~~\n"}},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"EDIT","timestamp":1788627889336403756,"uuid":"a4257471-7da4-44ca-ade6-1d318aee22e4"}