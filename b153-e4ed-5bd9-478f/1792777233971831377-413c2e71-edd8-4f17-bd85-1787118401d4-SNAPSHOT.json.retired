nary markers."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_artifact_probe_workflow.py tests/unit/test_dependency_advisory_wiring.py tests/unit/test_compact_all_selection.py tests/unit/test_external_canary.py tests/unit/test_external_integration_cloud_mutation_workflow.py","dd_id":"workflow-contracts-core","dd_text":"Exercise artifact, advisory, compaction, external-provider, and cloud-mutation workflow contracts."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_gerrit_docs_only.py tests/unit/test_gerrit_verify_run_name.py tests/unit/test_gerrit_verify_triage_comment.py tests/scripts/test_classify_gerrit_verify_change.py tests/scripts/test_normalize_ci_conclusion_port.py","dd_id":"workflow-contracts-gerrit","dd_text":"Exercise Gerrit route, run identity, triage, and conclusion-normalization contracts."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_jira_dc_capability_map_workflow.py tests/unit/test_jira_dc_exact_patchset_workflow.py tests/unit/reconciler/test_jira_dc_harness_shape.py","dd_id":"workflow-contracts-jira-dc","dd_text":"Exercise Jira DC harness, capability-map, and exact-patchset contracts."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_canary_bridge_wiring.py tests/unit/test_reconcile_bridge_canary_class.py tests/scripts/test_canary_bridge.py tests/scripts/test_reconcile_bridge_push_retry.py","dd_id":"workflow-contracts-canary","dd_text":"Exercise bridge-canary wiring, classification, and push retry."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_ci_workflow_parity.py tests/unit/test_workflow_names.py tests/unit/test_ci_main_push_policy.py tests/unit/test_core_optionality.py tests/unit/test_eval_scorers.py tests/unit/grounding/test_terraform_corroborator.py","dd_id":"workflow-contracts-parity","dd_text":"Exercise workflow parity, names, trigger policy, optionality, evaluation, and the Terraform corrobor