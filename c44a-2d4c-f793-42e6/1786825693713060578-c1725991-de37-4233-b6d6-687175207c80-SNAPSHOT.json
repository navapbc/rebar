{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786825693713060578,"compiled_state":{"alias":"paralytic-yester-needletail","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"cddc460463634055fb25511bbc24bc6d302a3b3d","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: c44a-2d4c-f793-42e6","material: 46d80daf539bd4fa","material-part: children 647ea2107ca5072f 0","material-part: description f4abdc56116f2782 7566","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact 662b6805e50657bd 2","material-part: ticket_id a15d93bf5807bbae 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: execution","priority-floor: 0.80","rebar-version: 0.11.0 (cddc460463-dirty)","regver: 4f90349cd81c4911","verified-at-sha:80a69b096716ba4e3dab4f5ca7531ea94f7104e9","dep d12cd5f6ff37d3d3bc936e474608d58fea4edbe0852d6da7a7fb6d11cc3479f6 .github/dependabot.yml","dep 6d81861033a3276ff0863d1f0b14cd8f6f99981786cce2391c74219defc152d6 uv.lock","read-set: 6","read-path: .github/dependabot.yml","read-path: pyproject.toml","read-path: src/rebar/llm/structured.py","read-path: src/rebar/llm/usage_log.py","read-path: tests/unit/test_llm_capabilities.py","read-path: tests/unit/test_usage_log_pricing_qualified_2ca9.py","currency-basis: file_impact"],"material_fingerprint":"46d80daf539bd4fa","merged_log_commit":"80a69b096716ba4e3dab4f5ca7531ea94f7104e9","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1786825315546875000}},"author":"RebarBotNava","author_email":"joe