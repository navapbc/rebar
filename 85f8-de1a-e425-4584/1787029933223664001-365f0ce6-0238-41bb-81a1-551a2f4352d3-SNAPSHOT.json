9 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"54ac7e11cad968e352eb6e79077cb699ef9d0106a5e9407e6a4e54468f8a573b","event_uuid":"6b2fb6c7-5267-40ad-b7e8-e1cfa2dcad19","position":{"commit_sha":"ef21b46abe18c0580d1be85b1770d4f107442085","position":"1787028090984562001-6b2fb6c7-5267-40ad-b7e8-e1cfa2dcad19"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787028064503928001,"creation_channel":"cli","deps":[{"link_uuid":"6b2fb6c7-5267-40ad-b7e8-e1cfa2dcad19","relation":"depends_on","target_id":"0ad4-9f1c-09f6-4760"}],"description":"## Context\nPure mutation plans still need to represent binding lifecycle decisions and prerequisite ordering without performing effects. Selection, filters, mode caps, and safety limits must exclude work before intents are eligible.\n\n## Outcome\nAdd versioned lifecycle intents and explicit inter-ticket dependencies to `TicketPlan`, and apply every global selection/limit before any lifecycle or remote effect.\n\n## Plan\n1. Model bind, confirm, re-key, retire, baseline, and comment-identity changes as versioned intents only.\n2. Encode create-before-link and parent-before-child prerequisites. A blocked prerequisite yields deferred disposition and emits no out-of-order mutation.\n3. Move selection, filter, mode cap, and global safety limit decisions into pre-effect planning.\n4. Cover tombstones, pending/index lag, moved keys, impossible links, partial snapshots, and filtered passes with ticket-sourced tables.\n\n## Testing\nPure tables assert exact intent/dependency/disposition values and poison repository/provider writes. Ordering tests vary each limit independently.\n\n## Acceptance Criteria\n- [ ] Every named binding change is represented as a versioned lifecycle intent and performs no write during planning.\n- [ ] Create-before-link and parent-before-child prerequisites are explicit plan dependencies.\n- [ ] Blocked prerequisites produce deferred plans and no out-of-order mutation.\n- [ ] Selection, filter, mode cap, and global safety limits exclude work before any intent or remote effect is eligible.\n- [ ] Ticket-sourced tombstone, index-lag, move, link, partial-snapshot, and filtered cases have deterministic dispositions.\n\n## Out of scope\nPreview output and production coordinator execution.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/ticket_plan.py","reason":"Add lifecycle intent and dependency value types."},{"path":"src/rebar/_engine/rebar_reconciler/ticket_planner.py","reason":"Produce intents, dependencies, and deferred dispositions."},{"path":"src/rebar/_engine/rebar_reconciler/apply_planning.py","reason":"Apply selection, filters, caps, and limits before effects."},{"path":"tests/unit/rebar_reconciler/orchestrate/test_ticket_plan_shadow.py","reason":"Lifecycle, dependency, and ticket-sourced planning tables."},{"path":"tests/unit/rebar_reconciler/orchestrate/test_mode_cap_enforcement.py","reason":"Pre-effect cap and exclusion regressions."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","0ad4-9f1c-09f6-4760"],["parent","f828-6f5e-3b15-41f5"]],"no_file_impact_reason":"","parent_id":"f828-6f5e-3b15-41f5","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp03","planner","tdd"],"ticket_id":"85f8-de1a-e425-4584","ticket_type":"task","title":"RP-03 S2 T2 — Plan lifecycle intents, dependencies, and pre-effect limits","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/orchestrate/test_ticket_plan_shadow.py tests/unit/rebar_reconciler/orchestrate/test_mode_cap_enforcement.py","dd_id":"AC1-AC5","dd_text":"Lifecycle intents, dependencies, deferral, pre-effect limits, and ticket-sourced cases"}]},"source_event_uuids":["7110ad24-0ef4-4605-aae4-49b8ca32ed4f","beb3a07a-7a34-4539-ac79-3b052a968f98","d4030353-ea14-45df-b908-b130178e4398","6b2fb6c7-5267-40ad-b7e8-e1cfa2dcad19"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029933223664001,"uuid":"365f0ce6-0238-41bb-81a1-551a2f4352d3"}