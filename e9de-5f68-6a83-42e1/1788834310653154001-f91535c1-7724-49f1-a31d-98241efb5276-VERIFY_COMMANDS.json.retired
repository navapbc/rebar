{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast,io,re,subprocess,sys,tokenize\nBASE=\"665d1d0480187380f82e59bd95af1f0c44274732\"\nALLOWED={\"tests/external/live_jira_cloud_mutation/_cloud_mutation_support.py\":[\"<module>\"],\"tests/external/live_jira_cloud_mutation/conftest.py\":[\"<module>\"],\"tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py\":[\"<module>\"]}\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nclass Strip(ast.NodeTransformer):\n def __init__(self,allowed): self.allowed=allowed;self.stack=[]\n def enter(self,node,q):\n  self.stack.append(q)\n  if q in self.allowed and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str): node.body.pop(0)\n  node=self.generic_visit(node);self.stack.pop();return node\n def visit_Module(self,node): return self.enter(node,\"<module>\")\n def named(self,node):\n  parent=self.stack[-1] if self.stack else \"<module>\";q=node.name if parent==\"<module>\" else parent+\".\"+node.name;return self.enter(node,q)\n def visit_ClassDef(self,node): return self.named(node)\n def visit_FunctionDef(self,node): return self.named(node)\n def visit_AsyncFunctionDef(self,node): return self.named(node)\ndef src(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(text,path):\n tree=Strip(set(ALLOWED.get(path,[]))).visit(ast.parse(text,filename=path,type_comments=True))\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(text):\n lines=text.splitlines()\n chosen=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),chosen\nbad_ast=[];bad_protected=[]\nfor path in sys.argv[1:]:\n before=src(BASE,path);after=src(\"HEAD\",path)\n if norm(before,path)!=norm(after,path): bad_ast.append(path)\n if protected(before)!=protected(after): bad_protected.append(path)\nassert not bad_ast,f\"non-allowlisted-docstring or executable AST/runtime changes: {bad_ast}\"\nassert not bad_protected,f\"directive/shebang changes: {bad_protected}\"' tests/external/live_jira_cloud_mutation/_cloud_mutation_support.py tests/external/live_jira_cloud_mutation/conftest.py tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py","dd_id":"immutable-prose-only","dd_text":"Compare 665d1d0480187380f82e59bd95af1f0c44274732 target blobs with the final commit; strip only allowlisted qualified-owner docstrings and preserve all other docstrings, executable AST/runtime strings, and exact directive/shebang lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nexpected=sorted(sys.argv[1:])\nassert actual==expected,f\"changed paths differ: actual={actual}, expected={expected}\"' tests/external/live_jira_cloud_mutation/_cloud_mutation_support.py tests/external/live_jira_cloud_mutation/conftest.py tests/external/live_jira_cloud_mutation/test_cloud_coordinator_lifecycle.py","dd_id":"exact-leaf-paths","dd_text":"Require the leaf commit changed-path set to equal the declared file-impact set exactly."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py",