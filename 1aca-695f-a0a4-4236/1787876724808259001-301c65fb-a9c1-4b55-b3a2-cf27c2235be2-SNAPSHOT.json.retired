-a321-124a09f33843","position":{"commit_sha":"653fc98ebfe73a41d0a85f75e12f4236a12f348a","position":"1787866195650114468-c4f23fd6-a3e7-4757-a321-124a09f33843"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"072fad6f57bda331d82ed6502a0645a2368c91bb5a0ab36f8c9ff0532f66cd36","event_uuid":"862764f6-ee27-48b3-b22c-004611a57f4f","position":{"commit_sha":"4d60b06275b26cffc43a33df4ede8905eb6af1e8","position":"1787868917864299001-862764f6-ee27-48b3-b22c-004611a57f4f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4270fcff546187e5a20c8dac3d402b0907a4ff0f408fe21ce1aa1497483f09af","event_uuid":"dc93ee77-7c03-4f0f-ae7e-1077eb22e1d7","position":{"commit_sha":"778531f6c540fb2218f9be9cf776442daa0dafe6","position":"1787869470256781001-dc93ee77-7c03-4f0f-ae7e-1077eb22e1d7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ab36d59afa311430789a32e879b561acc314cbb459ecfd2fc15d61bbf60f8048","event_uuid":"5677f228-54a7-416c-8bd3-ec59a7183768","position":{"commit_sha":"e6dd754b46a90a39b2be1ed55dcd5561edd84df8","position":"1787869684799350001-5677f228-54a7-416c-8bd3-ec59a7183768"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3ff011a4f07ea72642c4bdefde47b42927b4f941befb151170a0cd91d168dbb6","event_uuid":"cf6b8f3c-207c-4fcf-91a1-00f6a39d7447","position":{"commit_sha":"e6dd754b46a90a39b2be1ed55dcd5561edd84df8","position":"1787869686670418001-cf6b8f3c-207c-4fcf-91a1-00f6a39d7447"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787866195650114468,"creation_channel":"mcp","deps":[{"link_uuid":"862764f6-ee27-48b3-b22c-004611a57f4f","relation":"relates_to","target_id":"524d-22a5-1a21-49d7"}],"description":"## Context / Problem\n\nrebar stamps the claiming coding-agent session onto a ticket's `open -> in_progress`\nclaim edge (`claimed_session`, plus `claim_harness` / `claim_remote_session`) — see\n`docs/event-schema.md` §\"Session provenance (`claimed_session`)\" and the reducer fold\n`_fold_claimed_session` (`src/rebar/reducer/_processors_status.py:25`). Because `claim`\nis a *soft* lock and events merge as a union (`docs/concurrency.md`), a second agent\n**session** can freely operate on a ticket a first session is actively working —\ncomment, edit, tag, transition, or even just `show` it. Parallel agents commonly run\nunder the **same assignee** but **different session ids**, so assignee cannot\ndistinguish them. Today there is no signal when session B touches a ticket session A\nholds `in_progress`, so B can unknowingly step onto A's in-flight work.\n\nThis epic adds a **non-blocking warning** surfaced on all three surfaces (CLI, MCP,\nlibrary) whenever an operation that targets **one specific ticket** is performed by a\nsession different from the one that currently holds the ticket `in_progress`. It also\ntightens ownership semantics so \"held\" means exactly \"currently `in_progress` by\nsession X\": the claim-session provenance is **cleared on every exit from\n`in_progress`**.\n\nDeliberate design decisions (settled during brainstorm):\n- Ownership is by **session id** (`claimed_session`), never assignee.\n- **Warn, do not block** — the permissive event-union model is unchanged.\n- Fires **only on single-ticket-targeted operations** (single-ticket reads like `show`\n  plus single-ticket mutations); **bulk reads never warn** (`list` / `search` /\n  `ready` / `next-batch`), because those exist precisely to hand parallel agents *other*\n  tickets and would emit a wall of warnings.\n- **Silent when the acting session id is unknown** (`resolve_session_id()` is `None` —\n  the common un-shimmed case), documented as an **evidence-revisitable** choice.\n- Gated by a **config toggle**, default **on**.\n- Accepted known limitation: a session id is not stable across `--resume` / fork /\n  subagents (`docs/session-id-shims.md` gotcha G1), so the same agent can present a new\n  id and warn about \"its own\" ticket; the toggle is the escape hatch.\n\n## Acceptance Criteria\n\n- [ ] `claimed_session`, `claim_harness`, and `claim_remote_session` are cleared on\n  every `in_progress -> {open,blocked,closed,idea}` transition, so a non-`in_progress`\n  ticket never reports a stale holder — delivered by the reducer-clearing story;\n  proxy: its reducer tests assert the cleared state.\n- [ ] A single shared detector decides when to warn — warns exactly when the toggle is\n  on, the acting session id is known, and it differs from a *live* `claimed_session`;\n  silent otherwise — delivered by the detector+config story; proxy: its unit matrix\n  passes.\n- [ ] The warning is surfaced for single-ticket-targeted operations on **CLI** (stderr\n  line), **MCP** (structured response field), and **library** (`warnings.warn`), and\n  never on bulk reads — delivered by the three per-surface stories; proxy: each\n  surface's tests assert warn-on-mismatch and silence on same-session / bulk / unset-id.\n\n## Child decomposition\n\n- **Reducer clearing** — clear the three claim-session fields on every exit from\n  `in_progress` (reducer + `docs/event-schema.md`). Foundation for \"live holder\"\n  semantics; every other child depends on it.\n- **Detector + config toggle** — the pure `cross_session_warning` helper and the\n  `warnings.cross_session` config key (default true), plus `docs/config-reference.md`.\n  Depends on reducer clearing.\n- **CLI surface** — emit a `WARN:` stderr line for single-ticket CLI commands. Depends\n  on the detector.\n- **MCP surface** — carry the warning in single-ticket MCP tool responses (mirroring\n  the existing `description_warning` field). Depends on the detector.\n- **Library surface** — `warnings.warn` a dedicated warning category from single-ticket\n  library functions. Depends on the detector.\n\nEach child owns a distinct, non-overlapping seam (reducer state, pure detector+config,\nCLI rendering, MCP model/schema, library warnings channel).","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","524d-22a5-1a21-49d7"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5677f228-54a7-416c-8bd3-ec59a7183768","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"1aca-695f-a0a4-4236","ticket_type":"epic","title":"Cross-session operation warning + clear claim-session on exit from in_progress","verify_commands":[]},"source_event_uuids":["c4f23fd6-a3e7-4757-a321-124a09f33843","862764f6-ee27-48b3-b22c-004611a57f4f","dc93ee77-7c03-4f0f-ae7e-1077eb22e1d7","5677f228-54a7-416c-8bd3-ec59a7183768","cf6b8f3c-207c-4fcf-91a1-00f6a39d7447"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787876724808259001,"uuid":"301c65fb-a9c1-4b55-b3a2-cf27c2235be2"}