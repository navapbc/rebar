kens":0.0,"input_tokens":1615.7777777777778,"llm_calls":1,"output_tokens":193.22222222222223,"requests":1},"project.measurement-provenance":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":35514.0,"llm_calls":1,"output_tokens":1002.0,"requests":3},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1615.7777777777778,"llm_calls":1,"output_tokens":193.22222222222223,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":121795.0,"llm_calls":1,"output_tokens":4364.0,"requests":6}}}},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Extend Step 4's binding-threading to the plan-review producer path (plan_review/generation.sign_manifest -> signing._sign_manifest_under_lock, called from plan_review/attest.py), so generation.sign_manifest accepts+forwards the OpcertSigner binding just as sign_completion_verdict does, and add a signer-seam test that a plan-review job signs from the injected binding (not env/genesis).","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["jobs.py VALID_KINDS = ('completion-verifier', 'plan-review'); _dispatch_plan_review (jobs.py:120-127) 'signs internally on a non-blocking PASS'","plan-review sign path: plan_review/attest.py:202 generation.sign_manifest -> generation.py:334 signing._sign_manifest_under_lock — NOT via sign_completion_verdict","keyprov.provisioned_signing_key wraps the WHOLE dispatch (jobs.py:89), so it currently binds the key for plan-review too; Step 4 removes this env patching","Plan step 4: 'removing keyprov.py's os.environ patching cannot silently break signing' — relies on the seam always forwarding the binding, but the plan-review producer generation.sign_manifest is not converted to accept+forward it"],"finding":"Step 4's signer-binding threading enumerates only the completion-verifier chain (sign_completion_verdict -> sign_manifest -> _sign_manifest_under_lock) but omits the plan-review producer path, which reaches _sign_manifest_under_lock via a DIFFERENT intermediate (generation.sign_manifest at generation.py:334, called from attest.py:202). Since the opcert service runs plan-review jobs and keyprov's os.environ patching (which currently binds the key for BOTH kinds) is being removed, a plan-review job would reach signing with no binding forwarded and silently fall back to env/genesis (a fresh local key), breaking the plan's stated invariant that removal 'cannot silently break signing.'","group_criteria":null,"group_id":null,"id":"fb5d3676840aeef45","impact":1.0,"is_primary":null,"location":"Plan step 4 / AC line 4 (out-of-opcert_service signing seam)","norm_id":"n591e33f7fa1ee90d","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A hosted opcert-service plan-review job PASSes; signing falls through to ensure_opcert_key with REBAR_OPCERT_KEY_PATH unset, minting/using a genesis .opcert-key under the tracker instead of the startup-bound deployment key — wrong principal / unverifiable envelope"],"severity":"critical","suggested_fix":"In Step 4, name generation.sign_manifest (src/rebar/llm/plan_review/generation.py:261, calling _sign_manifest_under_lock at :334) alongside sign_completion_verdict as a producer that must accept and forward the context-local signer binding; the service's plan-review dispatch must supply the same startup-bound signer it supplies to the completion path.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] Re-derive the `_sign_manifest_under_lock` caller inventory via `find_referencing_symbols` and add the plan-review producer path (`rebar.llm.plan_review.generation.sign_manifest` at generation.py:334 and its caller `attest.py:202`) to Step 4's conversion set, so the startup signer binding is forwarded for opcert-service `plan-review` jobs after keyprov's os.environ patching is removed.","cohort":["project.symbol-reference-completeness"],"criteria":["project.symbol-reference-completeness"],"decision":"advisory","decision_margin":0.1,"drop_reason":null,"evidence":["Plan step 4: \"via the public seam `rebar.signing.sign_manifest` (`signing.py:587`) and its private delegate `_sign_manifest_under_lock` (`signing.py:528` … the actual `mint_opcert_record` caller at L567), reached from the service through `src/rebar/_commands/transition_close.py:sign_completion_verdict`\"","grep of `_sign_manifest_under_lock` finds a second caller not in the inventory: src/rebar/llm/plan_review/generation.py:334 `return signing._sign_manifest_under_lock(ticket_id, manifest, kind=\"plan-review\", …)`, invoked from src/rebar/llm/plan_review/attest.py:202 `generation.sign_manifest(...)`","opcert_service/jobs.py:38 `VALID_KINDS = (\"completion-verifier\", \"plan-review\")`; jobs.py:120-127 `_dispatch_plan_review` \"signs internally on a non-blocking PASS\"; keyprov `provisioned_signing_key` wraps the whole dispatch at jobs.py:89, currently binding the key for plan-review too — and Step 4 removes that env patching"],"finding":"Step 4's signer-threading inventory converts `signing._sign_manifest_under_lock` to accept+forward the binding but enumerates only the completion-verifier caller chain (`sign_completion_verdict` -> `sign_manifest` -> `_sign_manifest_under_lock`). It omits the second structural caller of `_sign_manifest_under_lock`: `rebar.llm.plan_review.generation.sign_manifest` (generation.py:334), the plan-review producer path invoked from attest.py:202. The opcert service dispatches plan-review jobs (jobs.py:38 VALID_KINDS; _dispatch_plan_review jobs.py:120-127), so with keyprov's os.environ patching removed, a plan-review job reaches signing through an un-converted intermediate that never forwards the startup binding.","group_criteria":null,"group_id":null,"id":"fd45146cda9fd772f","impact":1.0,"is_primary":null,"location":"Plan step 4 (\"Convert these (incl. `sign_manifest` AND `_sign_manifest_under_lock`, which must accept+forward the binding)\") and AC line 4","norm_id":"n73139368c4ccdc2e","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["src/rebar/llm/plan_review/generation.py:334 (`generation.sign_manifest` calling `_sign_manifest_under_lock`) is an unpatched call site: it does not accept or forward the OpcertSigner binding, so a hosted opcert-service plan-review PASS signs via `ensure_opcert_key`/`opcert_principal` env-fallback (fresh genesis `.opcert-key`) instead of the startup-bound deployment key — wrong principal / unverifiable envelope.","src/rebar/llm/plan_review/attest.py:202 (`generation.sign_manifest(...)`) is a caller that must be updated to thread the binding; omitting it means the plan-review producer chain is silently unbound after keyprov's os.environ patching is removed.","Signer-seam tests that exercise only the completion-verifier chain (`sign_completion_verdict`) will pass while the plan-review path remains broken, so the gap is invisible to the plan's stated test."],"severity":"critical","suggested_fix":"In Step 4, add `rebar.llm.plan_review.generation.sign_manifest` (generation.py:334) — and its caller `attest.py:202` — to the list of symbols converted to accept+forward the optional OpcertSigner binding, since it is the second caller of `_sign_manifest_under_lock` and is the plan-review producer path the opcert service dispatches. Extend the signer-seam test to prove a plan-review job signs from the injected binding (not env/genesis) with `REBAR_OPCERT_KEY_PATH`/`REBAR_OPCERT_ENV_ID` unset.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["5 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable).","AC item '[operator-attested] Hosted signing/restart/tmpfs canaries pass with the required' is [operator-attested] but its provenance declaration is incomplete (environment is missing (no provenance dec