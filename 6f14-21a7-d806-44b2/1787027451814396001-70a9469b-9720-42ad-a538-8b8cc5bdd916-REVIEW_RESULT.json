.2222222222222,"llm_calls":1,"output_tokens":173.22222222222223,"requests":1},"T7":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1172.7,"llm_calls":1,"output_tokens":105.1,"requests":1},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1597.2222222222222,"llm_calls":1,"output_tokens":173.22222222222223,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1597.2222222222222,"llm_calls":1,"output_tokens":173.22222222222223,"requests":1},"prerequisite-consistency":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":6748.0,"llm_calls":1,"output_tokens":77.0,"requests":1},"project.engine-layer-enforcement":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1597.2222222222222,"llm_calls":1,"output_tokens":173.22222222222223,"requests":1},"project.measurement-provenance":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":33029.0,"llm_calls":1,"output_tokens":932.0,"requests":2},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1597.2222222222222,"llm_calls":1,"output_tokens":173.22222222222223,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":230667.0,"llm_calls":1,"output_tokens":4282.0,"requests":7}}}},"findings":[{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Add `rebar.signing.sign_manifest` (the intermediary that `sign_completion_verdict` calls and that invokes `mint_opcert_record`) to Step 4's signer-seam patch inventory so the optional binding parameter is threaded through it.","cohort":["G1G2"],"criteria":["G1G2"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["transition_close.py:169 `return _signing.sign_manifest(ticket_id, manifest, kind=\"completion-verifier\", repo_root=repo_root)`","signing.py:567 `record = mint_opcert_record(resolved, steps, kind=kind, repo_root=repo_root)` — sign_manifest is the sole intermediary calling mint_opcert_record on this path","Step 4 enumerates `ensure_opcert_key`/`opcert_principal`/`mint_opcert_record`/`sign_opcert_manifest` and `sign_completion_verdict` but not `sign_manifest`"],"finding":"Step 4's signer-seam patch-site inventory omits the intermediary `rebar.signing.sign_manifest`, which sits directly on the completion-verifier threading path. `sign_completion_verdict` (transition_close.py:169) calls `_signing.sign_manifest(...)`, and `sign_manifest` (signing.py:529-567) is what calls `mint_opcert_record`. To thread the optional context-local signer binding from the service caller down to `mint_opcert_record`/`ensure_opcert_key`/`opcert_principal`, `sign_manifest` must also accept and forward that parameter, but Step 4 names only sign_completion_verdict, mint_opcert_record, sign_opcert_manifest, ensure_opcert_key, and opcert_principal.","group_criteria":null,"group_id":null,"id":"f2c68acedbd068039","impact":1.0,"is_primary":null,"location":"Plan step 4 (signer-seam threading)","norm_id":"nf403ce43bc330f2d","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Service supplies a context-local signer binding but sign_manifest, lacking the parameter, silently drops it and mint_opcert_record still resolves the key/principal from os.environ"],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] Add `rebar.signing.sign_manifest` and `rebar.signing._sign_manifest_under_lock` to Step 4's signer-seam patch-site inventory (they sit on the `sign_completion_verdict` -> `mint_opcert_record` chain) and re-derive the full inventory via `find_referencing_symbols`/`find_symbol` plus a name-string grep sweep so every intermediary that must forward the binding is enumerated.","cohort":["project.symbol-reference-completeness"],"criteria":["project.symbol-reference-completeness"],"decision":"advisory","decision_margin":0.1,"drop_reason":null,"evidence":["Plan Step 4: 'callers mint_opcert_record/sign_opcert_manifest — reached from the service via src/rebar/_commands/transition_close.py:sign_completion_verdict (called from opcert_service/jobs.py). Convert these to accept an explicit signer-key-handle + principal'","transition_close.py:169: `return _signing.sign_manifest(ticket_id, manifest, kind=\"completion-verifier\", repo_root=repo_root)`","signing.py:595: `return _sign_manifest_under_lock(ticket_id, manifest, kind=kind, repo_root=repo_root)`","signing.py:567: `record = mint_opcert_record(resolved, steps, kind=kind, repo_root=repo_root)`"],"finding":"Step 4's signer-seam patch-site inventory for threading the explicit signer-key-handle + principal binding omits the two intermediary functions that sit on the actual `sign_completion_verdict` -> `mint_opcert_record` call chain: `rebar.signing.sign_manifest` (signing.py:587) and `rebar.signing._sign_manifest_under_lock` (signing.py:528). `sign_completion_verdict` (transition_close.py:169) does not call `mint_opcert_record` directly — it calls `_signing.sign_manifest`, which delegates to `_sign_manifest_under_lock`, which calls `mint_opcert_record` (signing.py:567). The plan names `sign_completion_verdict`, `mint_opcert_record`, `sign_opcert_manifest`, `ensure_opcert_key`, `opcert_principal` but never these two intermediaries, so the binding cannot flow from the service to `mint_opcert_record` unless both also accept and forward the parameter.","group_criteria":null,"group_id":null,"id":"fbb2c132fc9abca05","impact":1.0,"is_primary":null,"location":"Step 4 (\"Convert these to accept an explicit signer-key-handle + principal ... reached from the service via ... transition_close.py:sign_completion_verdict\") and Testing 'Signer-seam tests' bullet","norm_id":"nbd516072b704ed54","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["`rebar.signing.sign_manifest` (signing.py:587-595): its keyword-only signature (`kind`, `repo_root`) has no way to carry the injected binding, so `sign_completion_verdict`'s bound signer is dropped before it can reach the producer — the service would silently sign with the env/genesis default, defeating the whole cutover.","`rebar.signing._sign_manifest_under_lock` (signing.py:528-567): the function that actually invokes `mint_opcert_record(resolved, steps, kind=kind, repo_root=repo_root)` cannot pass a binding it never received; an unpatched intermediary here means `mint_opcert_record`'s new binding parameter is never populated on the locked write path.","The 'Signer-seam tests' bullet asserts the seam signs from the passed context-local binding while `REBAR_OPCERT_KEY_PATH`/`REBAR_OPCERT_ENV_ID` are unset; with `sign_manifest`/`_sign_manifest_under_lock` unthreaded that test cannot pass because no binding reaches the producer."],"severity":"critical","suggested_fix":"Thread the optional binding through both intermediaries: add the signer-key-handle + principal (optional `OpcertSigner`) parameter to `sign_manifest` and `_sign_manifest_under_lock`, forwarding it into `mint_opcert_record`, and list both in Step 4's enumeration and the signer-seam test scope.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"omits_required_site","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Specify the opcert compose wiring for the materialized key: the read-only bind-mount of the 0600 host file into the container and REBAR_OPCERT_KEY_PATH set to the CONTAINER mount target (per the review-bot REBAR_IDENTITY_SIGNING_KEY/beb1 precedent), keeping host and container paths in sync.","cohort":["T10"],"criteria":["T10"],"decision":"advisory","decision_margin":-0.4812,"drop_reason":null,"evidence":["Plan: 'materialize ADR 0049's SSM value into the process file/value startup contract BEFORE the app starts, OUTSIDE the application (infra/scripts/fetch-secrets.sh)'","docker-compose.yml review-bot beb1 comment: 'fetch-secrets.sh materializes the key on the HOST and exports that HOST path ... that path does not exist in this container's namespace, so rebar silently wrote every event unsigned. Override with the mount target below; keep the two in sync.'","opcert service currently has no key-file bind-mount volume, only env_file: .env"],"finding":"Step 5 specifies materializing the op-cert key to the 'process file/value startup contract' in fetch-secrets.sh but does not specify the corresponding opcert compose-service wiring: the read-only bind-mount of the materialized 0600 host file into the container and the REBAR_OPCERT_KEY_PATH env pointing at the CONTAINER mount target (not the host path). The review-bot precedent in docker-compose.yml (REBAR_IDENTITY_SIGNING_KEY + './rebar-bot-signing-key:/run/secrets/...:ro') documents exactly this host-path-vs-container-path desync trap (bug beb1: 'that path does not exist in this container's namespace, so rebar silently wrote every event unsigned').","group_criteria":null,"group_id":null,"id":"f67cd857094bc3c6f","impact":0.67,"is_primary":null,"location":"Plan step 5; Testing structural assertions; infra/compose/docker-compose.yml opcert service","norm_id":"n39c37f74ddce7213","priority":0.4188,"reason":"default-advisory","recalled":false,"scenarios":["Key materialized to a host path but REBAR_OPCERT_KEY_PATH resolves to a non-existent path inside the opcert container, or the file is not mounted, so startup validation fails or (worse) silently mis-binds"],"severity":"major","suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementatio