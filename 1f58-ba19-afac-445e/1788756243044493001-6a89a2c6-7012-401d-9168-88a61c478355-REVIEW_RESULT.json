 repository exact required version'","norm_id":"n604b0c7035818f7f","priority":0.1613,"reason":"default-advisory","recalled":false,"scenarios":["The chosen version-query command prints a token like `uv 0.12.9 (<hash> <date>)`; a naive equality check against `0.12.7`/`==0.12.7` fails to normalize and the preflight misfires or false-passes."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.6111,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"insufficient","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"9ac37e5f86eb4ef4","material_parts":{"children":["647ea2107ca5072f",0],"description":["839c34da40707207",2017],"description_boxes":["7879981d4f226a8f",0],"file_impact":["512a456aadad0cd6",2],"ticket_id":["01baa95cbbe5419d",19]},"metrics":{"cache_read_tokens":482616,"cache_write_tokens":194875,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":12048.5,"input_tokens":699656,"llm_calls":27,"llm_ms":217014.3,"output_tokens":20724,"precheck":{"cited_anchor_warning":false},"total_ms":253655.3,"verify_requests":15},"model":"bedrock:us.anthropic.claude-sonnet-4-6","prov