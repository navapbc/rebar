{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787548146698676001,"compiled_state":{"alias":"panphobic-prickly-xenarthra","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4051942c87dc13a2f8ac6305ddebc0b1ec27b3bf","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: 52b0-6a6a-c66b-4c59","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","rebar-version: 0.12.0 (4051942c87-dirty)","material: 83f2de26fc98831d","verified-at-sha:4051942c87dc13a2f8ac6305ddebc0b1ec27b3bf"],"material_fingerprint":"83f2de26fc98831d","merged_log_commit":"4051942c87dc13a2f8ac6305ddebc0b1ec27b3bf","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787522788920139000},"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4051942c87dc13a2f8ac6305ddebc0b1ec27b3bf","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 52b0-6a6a-c66b-4c59","material: 83f2de26fc98831d","material-part: children 647ea2107ca5072f 0","material-part: description 234c0872f7d9bc0c 7990","material-part: description_boxes b7fb217694ae2d30 6","material-part: file_impact d5e297a86b2c7cc5 4","material-part: ticket_id 297f2969fb7ae9ac 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 0","review-phase: planning","rebar-version: 0.12.0 (4051942c87-dirty)","regver: aa61189569d34126","verified-at-sha:3d41015574baa18a6ee6a25c7271be87fde1a3a5","plan-material-pin: prerequisite ad81-73ad-83bb-47c7 8d7277191711d8b8","plan-material-pin: prerequisite bfe7-0900-c3d1-4141 2814cef81e53ef63","dep 4cadc7594748b14182bfbf687f0d278a64e66247e635cfcdfe5d0a88db3026a8 docs/user-guide.md","dep ba2ccab1049b9e034bf292180ca702e3cf3e32ab62614eae512108f54b1eff0f src/rebar/_commands/doctor.py","dep a56860848e1c05b3b81b9a4c1a7c028dc6453e43a818bba49842984371129a75 src/rebar/_commands/doctor_mapping.py","dep 67dc140267af1023b3461d8538b154266e2620d7ca3e27df7ec6200bc3b33710 tests/unit/test_doctor_mapping.py","read-set: 11","read-path: docs/user-guide.md","read-path: src/rebar/_capabilities.py","read-path: src/rebar/_commands/doctor.py","read-path: src/rebar/_commands/doctor_mapping.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/settings.py","read-path: src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/transport.py","read-path: src/rebar/_engine/rebar_reconciler/config.py","read-path: src/rebar/_engine/rebar_reconciler/mapping_probe.py","read-path: src/rebar/_optional.py","read-path: src/rebar/llm/workflow/criterion_preview.py","read-path: tests/unit/test_doctor_mapping.py","currency-basis: file_impact"],"material_fingerprint":"83f2de26fc98831d","merged_log_commit":"3d41015574baa18a6ee6a25c7271be87fde1a3a5","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787522166580530000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":27,"unsigned":0},"authorship_ledger":[{"content_hash":"3c7f2f9ca3709de282bd4278d67121502872cdc554da334d44a3e0a95e3a0c52","event_uuid":"df72fc98-8d5a-45d6-98bf-dca677afac46","position":{"commit_sha":"5209858924c186de119792b8ad1372717690f9be","position":"1787398828691899647-df72fc98-8d5a-45d6-98bf-dca677afac46"},"signature":"