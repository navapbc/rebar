ite-consistency"],"input_tokens":11088,"output_tokens":119,"requests":1}],"per_criterion":{"prerequisite-consistency":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":11088.0,"llm_calls":1,"output_tokens":119.0,"requests":1}}}},"findings":[{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"- [ ] Reconcile the empty-PAT degradation cause with build_probe's actual behavior: build_client_from_settings raises BackendEnvError on empty/whitespace PAT (transport.py:183), so either detect PAT emptiness BEFORE calling build_probe (via resolve_jira_datacenter_settings directly) or fold BackendEnvError into the caught degradation exceptions, and state the correct mechanism in the plan.","cohort":["E4"],"criteria":["E4"],"decision":"advisory","decision_margin":-0.155,"drop_reason":null,"evidence":["settings.py:106 `pat = os.environ.get(\"JIRA_PAT\", \"\")` and comment: 'the missing-PAT guard deliberately does NOT live here … the guard lives at client construction — see build_client_from_settings'","transport.py:183-193 `if not (settings.pat or \"\").strip(): raise BackendEnvError(...)` inside build_client_from_settings","mapping_probe.py:209-211 build_probe calls resolve_jira_datacenter_settings() then build_client_from_settings(settings) — so empty PAT raises inside build_probe","The plan enumerates 'empty resolved PAT' and 'the probe transport raises' as SEPARATE degradation causes, implying doctor detects pat=='' independently of the probe call"],"finding":"The plan asserts the empty-PAT degradation cause is that resolve_jira_datacenter_settings returns pat='' (JIRA_PAT unset), treated as a cause distinct from 'the probe transport raises'. But the reused mapping_probe.build_probe calls build_client_from_settings, which RAISES BackendEnvError on an empty/whitespace PAT before any transport call — so via the named build_probe reuse the empty-PAT case surfaces as an exception inside build_probe, not as an inspectable pat='' settings value.","group_criteria":null,"group_id":null,"id":"f166b57ed39d4f8d2","impact":0.85,"is_primary":null,"location":"Approach — Live-drift check ('the resolved PAT is empty (JIRA_PAT unset — resolve_jira_datacenter_settings returns pat=\"\")')","norm_id":"n5a8b5de6e8895d09","priority":0.595,"reason":"default-advisory","recalled":false,"scenarios":["JIRA_PAT unset with the jira-datacenter extra installed: the plan's stated flow (inspect resolved pat=='') never fires because build_probe raises BackendEnvError first","A degradation-cause test that expects the empty-PAT branch to be reached by a pat=='' check rather than by catching BackendEnvError"],"severity":"critical","suggested_fix":"Amend the Approach and AC to note that empty PAT surfaces as a BackendEnvError raised inside build_client_from_settings (invoked by build_probe); either check resolve_jira_datacenter_settings().pat=='' before the probe call or include BackendEnvError in the exception set that folds into the single 'unavailable' finding.","tier":"LLM","validity":0.7,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"contradicts_reality","dod_uncertifiable":"none","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify the live-drift diff precisely: state that the configured side is each effective axis map's RESOLVED Jira target values (status/type/link) and the observed side is the probe's GLOBAL vocabulary sets (statuses()/issue_types()/issue_link_types()), and that a finding fires when a resolved target value is absent from the corresponding observed set.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.1533,"drop_reason":null,"evidence":["mapping_probe.build_probe returns a ProbePort of raw getters; observed vocabulary must be gathered from statuses()/issue_types()/issue_link_types()","mapping_probe docstring: 'statuses() is the GLOBAL status set — pycontribs exposes no per-project status list publicly'","effective_status_map/effective_type_map/effective_link_map return per-project local->Jira maps (config.py); the drift-relevant token is the resolved Jira VALUE, not the local key","plan phrase 'a configured value absent from Jira's set' does not disambiguate local key vs resolved target value, nor global vs per-project observed set"],"finding":"The live-drift diff mechanism is under-specified: build_probe() yields a raw-getter ProbePort (statuses()/issue_types()/issue_link_types() are GLOBAL sets, not per-project), while the configured side is a per-project EFFECTIVE axis map of local->Jira values; the plan does not state which configured token is checked for absence against which observed set.","group_criteria":null,"group_id":null,"id":"ff7206eba2bb1274b","impact":0.67,"is_primary":null,"location":"Approach → Live-drift check bullet ('diff configured vs observed vocabulary, one finding per divergence ... a configured value absent from Jira's set')","norm_id":"nccee7665cedd1555","priority":0.4467,"reason":"default-advisory","recalled":false,"scenarios":["An operator remaps a local status to a valid global Jira status used by another project — correct behaviour depends on diffing the resolved Jira VALUE against the GLOBAL status set, which the plan never states","The live-drift-tier test needs a precise oracle ('naming the axis + absent value') but the plan leaves the compared token ambiguous"],"severity":"major","suggested_fix":"","tier":"LLM","validity":0.6667,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}}],"impact_model_version":"plan-v5","material_fingerprint":"d3b3f466e8c9a687","material_parts":{"children":["647ea2107ca5072f",0],"description":["234c0872f7d9bc0c",7990],"description_boxes":["399141be1d30ac26",0],"file_impact":["6ab6b236391b8bd5",3],"ticket_id":["297f2969fb7ae9ac",19]},"metrics":{"cache_read_tokens":0,"cache_write_tokens":0,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":2422.9,"input_tokens":11088,"llm_calls":28,"llm_ms":124212.3,"output_tokens":119,"precheck":{"cited_anchor_warning":false},"total_ms":132539.7,"verify_requests":11},"model":"bedrock:us.anthropic.claude-sonnet-4-6","provider_provenance":{"candidates":["bedrock:us.anthropic.claude-sonnet-4-6","anthropic:claude-sonnet-4-6"],"capabilities":{"native_structured_output":true,"pro