,"cache_write_tokens":0.0,"input_tokens":42071.0,"llm_calls":1,"output_tokens":1288.0,"requests":4},"T5e":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1176.7,"llm_calls":1,"output_tokens":184.0,"requests":1},"T6":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1606.888888888889,"llm_calls":1,"output_tokens":127.66666666666667,"requests":1},"T7":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1176.7,"llm_calls":1,"output_tokens":184.0,"requests":1},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1606.888888888889,"llm_calls":1,"output_tokens":127.66666666666667,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1606.888888888889,"llm_calls":1,"output_tokens":127.66666666666667,"requests":1},"prerequisite-consistency":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":11041.0,"llm_calls":1,"output_tokens":109.0,"requests":1},"project.engine-layer-enforcement":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1606.888888888889,"llm_calls":1,"output_tokens":127.66666666666667,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1606.888888888889,"llm_calls":1,"output_tokens":127.66666666666667,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":50782.0,"llm_calls":1,"output_tokens":2176.0,"requests":5}}}},"findings":[{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"Specify how the offline check detects a capability-absent axis reference — the named resolvers only gate capability via effective_link_map's Capability(has_link_types=True), which is fully-capable and never fires; inject a capability-limited Capability (or drop this error class from the offline scope).","cohort":["E4"],"criteria":["E4"],"decision":"block","decision_margin":0.25,"drop_reason":null,"evidence":["Plan: 'Any MappingConfigError (… capability-absent reference …) → an error finding'","src/rebar/_engine/rebar_reconciler/config.py:254 effective_link_map calls mc.validate(resolved, mc.Capability(has_link_types=True))","src/rebar/_engine/rebar_reconciler/mapping_config.py:70-82 Capability defaults every axis to True, so Capability(has_link_types=True) is fully capable and _check_capability never fires","effective_status_map (config.py:95-100) and effective_type_map (config.py:154-159) never call validate()"],"finding":"The Approach claims the offline check surfaces a 'capability-absent axis reference' as a MappingConfigError by running effective_status_map/effective_type_map/assert_type_decisions_complete/effective_link_map, but capability gating only fires inside mapping_config.validate() via an injected Capability, and the only listed resolver that calls validate() (effective_link_map) passes Capability(has_link_types=True) whose remaining flags all default to True (a fully-capable target). None of the four named resolvers inject a capability-limited Capability, so a capability-absent axis reference is structurally undetectable through them.","group_criteria":null,"group_id":null,"id":"ff5066fa20ac6232f","impact":1.0,"is_primary":null,"location":"Approach → Offline checks bullet ('capability-absent reference')","norm_id":"n7ca60d058d36d6c6","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A [mapping] block references a type_map/priority_map/hierarchy against a target lacking that axis; running the four named resolvers raises no MappingConfigError, so doctor emits no error finding for it."],"severity":"critical","suggested_fix":"","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State whether the probe call has a bounded timeout (or that S8's build_probe already enforces one), so a slow/hanging Jira degrades to the `unavailable` finding rather than hanging doctor.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["T5b"],"decision":"advisory","decision_margin":-0.3637,"drop_reason":null,"evidence":["Plan enumerates degradation causes as extra-absent / empty-PAT / ConfigError / 'the probe transport raises' — a hang is none of these","No timeout/deadline mentioned for the read-only probe call"],"finding":"The live-drift degradation handles causes that RAISE (transport error, ConfigError) or return empty (PAT), but does not address a slow/hanging Jira probe connection that neither raises nor returns promptly — doctor could hang indefinitely against a slow Data Center host, undermining the portability/fast-diagnostic intent.","group_criteria":null,"group_id":null,"id":"fc5fe217cd054c403","impact":0.67,"is_primary":null,"location":"Approach — Live-drift check bullet ('OR the probe transport raises, emit a single unavailable finding')","norm_id":"nfc4995794f4a6a54","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["Jira Data Center host is reachable but slow/unresponsive; the probe TCP connect or read blocks with no deadline","A developer runs `rebar doctor` in CI expecting a fast result and it hangs"],"severity":"major","suggested_fix":"Add a sentence: the probe call runs under a bounded timeout (delegated to S8's build_probe transport, or wrapped here), and a timeout folds into the single `unavailable` finding like any other transport failure.","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] State that the offline check enumerates every configured key in MappingConfig.projects (and the default block) and runs the resolvers/validation per key, so per-project errors and the empty-projects.<KEY> warning are actually reached and named.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.0789,"drop_reason":null,"evidence":["config.py: effective_status_map/effective_type_map/effective_link_map/assert_type_decisions_complete each take a required `project_key` argument","mapping_config.MappingConfig.projects is `Mapping[str, MappingLayer]` — a per-KEY overlay map","resolve_for_project merges builtin<-default<-projects[project_key]; errors in a specific projects.<KEY> only surface when that key is resolved","Plan text names no iteration over configured keys, only 'against the loaded config' and 'inspecting the loaded MappingConfig structurally'"],"finding":"The offline resolvers are all per-project_key, but the plan never states which project key(s) the offline check iterates. Without iterating MappingConfig.projects (plus the default block) the per-project error findings cannot be triggered/named and the empty-`projects.<KEY>` warning cannot be located.","group_criteria":null,"group_id":null,"id":"f2a0a77c3f3ad25f0","impact":0.67,"is_primary":null,"location":"Approach → Offline checks ('run the ... resolvers ... against the loaded config'); AC line 3 (empty projects.<KEY>)","norm_id":"n440049eba7bf1f78","priority":0.5211,"reason":"default-advisory","recalled":false,"scenarios":["Config defines an out-of-vocab or unmapped-type problem only under [mapping.projects.PROJ2] while doctor resolves for a single (or the DC-configured) key — PROJ2's error is missed","An all-empty projects.STUB block cannot be named as a warning if the check never enumerates projects keys"],"severity":"major","suggested_fix":"Load the MappingConfig once, then iterate `config.projects` keys (union with the default layer) running the resolvers/validate per key; use the same iteration to find the all-empty projects.<KEY> stub warning.","tier":"LLM","validity":0.7778,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.75,"blocking_enabled":true,"checklist_item":"Correct the offline-check description to note that out-of-vocabulary status/type detection comes from effective_link_map's validate() call (which checks all axis vocab), not from effective_status_map/effective_type_map — or add an explicit validate() call so each axis is validated independently.","cohort":["E4"],"criteria":["E4"],"decision":"dropped","decision_margin":-0.5545,"drop_reason":null,"evidence":["src/rebar/_engine/rebar_reconciler/config.py:95-100 effective_status_map has no validate() call","config.py:154-159 effective_type_map has no validate() call","config.py:254 only effective_link_map calls validate(); mapping_config.py:357-359 validate() _check_vocab on status_map, type_map, link_map"],"finding":"The Approach lists effective_status_map and effective_type_map among the resolvers that surface out-of-vocabulary status/type values, but neither calls mapping_config.validate() — they only resolve and drop SKIP. Out-of-vocabulary status/type detection actually rides solely on effective_link_map, whose validate() call happens to check status_map/type_map/link_map vocab. The plan's generic attribution to 'the resolvers' misstates where this coverage comes from.","group_criteria":null,"group_id":null,"id":"f41448a93700f7f56","impact":0.44,"is_primary":null,"location":"Approach → Offline checks bullet ('out-of-vocabulary status/type/link value')","norm_id":"n90667bbe84b9a5cb","priority":0.1955,"reason":"low-validity","recalled":false,"scenarios":["If a future refactor stops running effective_link_map (e.g. because no link vocabulary is declared), out-of-vocab status/type values silently stop being validated, contrary to the plan's stated per-resolver coverage."],"severity":"minor","suggested_fix":"","tier":"LLM","validity":0.4444,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"incomplete_enumeration","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify that the offline check calls mc.validate(resolved, Capability(...)) directly (or an equivalent) for status/type axes — effective_status_map/effective_type_map do NOT validate vocabulary, so out-of-vocabulary status/type values will not surface via those resolvers alone.","cohort":["G6"],"criteria":["G6"],"decision":"dropped","decision_margin":-0.4533,"drop_reason":null,"evidence":["config.py effective_status_map: returns `{k: v ... if v != mc.SKIP}` with NO mc.validate call","config.py effective_type_map: same — no mc.validate call","config.py effective_link_map: the ONLY resolver calling `mc.validate(resolved, mc.Capability(has_link_types=True))`","mapping_config.load_mapping_config only parses shape (_parse_layer); vocab checks live in the separate validate()/_check_vocab which the status/type resolvers never invoke","Plan: 'an out-of-vocabulary status/type/link value ... fail in the rebar_reconciler.config resolvers'"],"finding":"The plan claims running the resolvers effective_status_map/effective_type_map surfaces an out-of-vocabulary STATUS or TYPE value as an error, but in config.py only effective_link_map calls mc.validate(); the status/type resolvers just drop SKIP and never validate, and load_mapping_config does not validate vocabulary. Out-of-vocabulary status/type values would therefore go undetected by the stated mechanism.","group_criteria":null,"group_id":null,"id":"f956f911e01b3a398","impact":0.44,"is_primary":null,"location":"Approach → Offline checks; AC line 2 ('out-of-vocabulary value')","norm_id":"n2281ebb0b1241731","priority":0.1467,"reason":"low-validity","recalled":false,"scenarios":["Operator declares `[mapping.projects.KEY.statuses]` and a status_map value outside it, or an issue_types vocab with a type_map value outside it — doctor reports clean instead of an error"],"severity":"minor","suggested_fix":"For each configured project key, resolve the layer and call mapping_config.validate(resolved, Capability(has_types=True, has_link_types=True, has_priorities=True, has_hierarchy=True)) so the status/type/link _check_vocab and capability checks all fire; keep effective_link_map/assert_type_decisions_complete for the link-vocab and completeness gates they already own.","tier":"LLM","validity":0.3333,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"no","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects