ZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e13a7c843ff194c9070884ad40233dd9513839271706575131832f6c34e00ee2","event_uuid":"fac094a4-9321-4c97-89a5-514741125b35","position":{"commit_sha":"20d34cb42ff777a4c88d65d662a4da9b38332d91","position":"1787651470478233001-fac094a4-9321-4c97-89a5-514741125b35"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"67a39f136901056379e12f21de3b75e987110454d77dcf163a5e9609673c2ed9","event_uuid":"e7bc36b8-08af-4fbd-9836-15eadfb37710","position":{"commit_sha":"eb8b55c8ee8ed5587124de16ce049f75eccacead","position":"1787651490405677001-e7bc36b8-08af-4fbd-9836-15eadfb37710"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"CONSUMER SCAN (new-prohibition: route rebar TRACKER ops through the MCP server; carve-out = local-code ops). Enumerated every guidance/workflow instruction that runs 'rebar <verb>' for a tracker op and its reconciliation disposition:\n\nRECONCILED HERE (this ticket, AGENTS.md):\n- AGENTS.md 'Record your work' + 'parallel-agent workflow' (claim/transition/create/comment/link/reopen/search/list/show/ready/next-batch) and the review-plan/verify-completion gate ops -> covered by the new umbrella section 'Drive the tracker through the MCP server (local-code ops are the carve-out)'. It defines a 'rebar <verb>' for a tracker op as the operation to invoke through MCP when configured, and names the downstream surfaces it governs.\n- AGENTS.md rebar review-plan <id> --status (read-only currency check), rebar review-code preview, rebar verify-commit-ticket, rebar explain, running tests/git -> explicit LOCAL-CODE CARVE-OUT (stay local).\n- AGENTS.md rebar transition ... closed --ref <sha> (close) -> umbrella-covered tracker write.\n\nUMBRELLA-COVERED BY REFERENCE + queued for a per-file textual sweep (follow-up ticket abeyant-upstanding-limpet cc73-e1c8, linked discovered_from):\n- .agents/rules/rebar.md:21-24 (claim/transition/link/review-plan)\n- templates/AGENTS.md:46,48,50,81 and templates/rebar-usage.md:22,24,26,57 (claim/link/transition/review-plan)\n- src/rebar/_guides/writing-a-passing-plan.md:15,20,106,304 and passing-code-review.md:127-128,143,157 (review-plan)\n- examples/agent-skills/rebar-implement/SKILL.md:167,198,358; rebar-brainstorm/SKILL.md:140,144; rebar-debug/SKILL.md:588,668,884 (claim/transition/review-plan)\n\nREFERENCE DOCS (describe ops, not agent 'run-locally' mandates; umbrella-covered): docs/concurrency.md, docs/plan-review-gate.md, docs/user-guide.md, docs/repo-snapshot-gates.md.\n\nOUTCOME: no surviving instruction contradicts the new rule. Every tracker-op mention is either (a) the operation-name-via-MCP semantics set by the AGENTS.md umbrella, (b) an explicit local-code carve-out, or (c) queued for the mechanical per-file follow-up (cc73-e1c8) while already semantically reconciled. Scope of this docs leaf stays AGENTS.md + docs per the ticket.","timestamp":1787645155532711001}],"completion_expectation":"required","created_at":1787594504225041001,"creation_channel":"cli","deps":[{"link_uuid":"bfdf89c0-2a3b-4c21-b943-c8d694322b0a","relation":"depends_on","target_id":"a45f-bd45-513a-49cb"},{"link_uuid":"cc09c36a-9282-4278-b2df-7e1db8cb7ea3","relation":"depends_on","target_id":"b173-e50a-4b93-455f"},{"link_uuid":"4140e860-8af5-462c-908c-f006526c1846","relation":"depends_on","target_id":"14f5-ca81-b70d-4550"},{"link_uuid":"7369de06-3cc8-4ee9-bd47-88ef8951c0d5","relation":"relates_to","target_id":"47ad-53e3-945e-4a3f"},{"link_uuid":"d29ed146-cf16-4752-84de-e5c1186371b5","relation":"relates_to","target_id":"925b-c54f-7289-4168"},{"link_uuid":"9a3cffc3-39d5-446e-811f-fae62c3301cd","relation":"relates_to","target_id":"78e6-b9a9-8404-4edc"}],"description":"Update AGENTS.md + docs (epic items 6–7) once the ADR (deft-evolutive-mosasaur) and trusted-env\nregistration land: require using the MCP server for all rebar operations EXCEPT operations that need\nlocal code (testing, investigation, debugging, validation), and state the certified-op policy\ncorrectly. Single concern: guidance + user-facing docs — no server/infra behavior here.\n\n## Scope + rationale\n1. **AGENTS.md MCP-required policy**: a rule that rebar tracker operations go through the MCP server,\n   with the explicit carve-out for local-code ops (test/investigate/debug/validate). Because this\n   introduces a new prohibition (\"don't drive the tracker by ad-hoc local CLI when MCP is\n   available\"), do the new-prohibition **consumer scan**: enumerate the existing guidance/workflows\n   that tell agents to run `rebar ...` tracker ops locally and reconcile each. The rule is written in\n   AGENTS.md (rebar's canonical cross-vendor guidance) as an **umbrella** that explicitly governs the\n   downstream guidance surfaces (`docs/`, `templates/`, `.agents/rules/`, packaged `rebar explain`\n   guides, example skills): a `rebar <verb>` shown for a tracker op names the operation and routes\n   through the MCP server when configured, so those surfaces are reconciled by reference rather than\n   individually rewritten. The non-doc surfaces (templates/packaged-guides/vendor-rules/skills) get a\n   per-file textual sweep under a linked follow-up ticket; this leaf edits AGENTS.md + docs only.\n2. **Certified-op wording correction**: certified **plan-review** and **completion-verifier** ops\n   (the only two op-cert kinds, ADR 0049) route through the MCP server and are enforceable because\n   the box is a registered trusted signing environment (the trusted-env slice). **Code review is the\n   Gerrit `LLM-Review` vote, NOT an op-cert** — record the code-review-vs-op-cert correction (the\n   epic's item-7 \"code review ... certified through the MCP server\" phrasing) per **ADR 0104**\n   (deft-evolutive-mosasaur, decision 3), so guidance doesn't imply a nonexistent code-review\n   op-cert. Enforcement of the certified ops is **enableable but deferred**: describe them as\n   enforceable-when-enabled via the trusted-env mechanism, and cite the operator flip runbook\n   (`infra/runbooks/mcp-opcert-enforcement-flip.md`) — do NOT claim enforcement is live.\n3. **docs/mcp-auth.md**: fill the §7 \"AWS-specific deployment\" gap with the ADR-decided recipe\n   (nginx `/mcp/` TLS edge + `static` verifier + per-client bearer). Surface the client-connection\n   guide (copilot/codex/claude config shapes from olm's `docs/mcp-client-setup.md`) from\n   docs/mcp-auth.md, which currently lacks the link.\n\n## Prior-art / doc-drift check (blocking prior-art overlay)\nGit history shows the hand-authored MCP docs carry modest recurring upkeep; keep the AWS recipe and\nclient guide close to the single-sourced config keys the ADR names so they don't drift. Match the\nexisting docs/mcp-auth.md structure rather than inventing a parallel doc; reference the already-landed\n`docs/mcp-client-setup.md` and `infra/runbooks/*` rather than duplicating them.\n\n## Testing / Verification\nDocs-only leaf: no behavioral tests. Each acceptance criterion below carries its proof (a recorded\ntracker artifact or a greppable command). Run the greppable oracles plus `make lint` before pushing.\n\n## Acceptance Criteria\n- [x] AGENTS.md states the MCP-required rule + the local-code carve-out, written as an umbrella that\n  names the downstream guidance surfaces it governs\n  (checked: `grep -niE 'MCP server|local-code|carve-out' AGENTS.md` shows the rule + carve-out).\n- [x] The consumer scan is recorded as the primary oracle: `rebar show inadequate-hydrated-starling`\n  carries a comment enumerating each pre-existing tracker-op \"run rebar locally\" instruction surface\n  and its reconciliation disposition (umbrella-covered / carve-out / follow-up ticket). A supporting\n  `grep -rniE 'rebar (claim|transition|link|review-plan)' AGENTS.md docs/ .agents/ templates/`\n  lists the candidate lines the reviewer confirms are each covered — the comment, not the grep, is\n  the pass/fail record.\n- [x] A follow-up ticket for the per-file reconciliation sweep of the non-doc surfaces\n  (templates/, packaged `rebar explain` guides, `.agents/rules/`, example skills) is created and\n  linked `discovered_from` this ticket (checked: `rebar show inadequate-hydrated-starling` lists an\n  inbound `discovered_from` child).\n- [x] The certified-op section names plan-review + completion-verifier as MCP-routed/enforceable-via\n  trusted-env and code-review as the Gerrit vote (NOT an op-cert)\n  (checked: `grep -niE 'plan-review|completion-verifier|LLM-Review' AGENTS.md` shows both op-cert\n  kinds plus the Gerrit vote framing).\n- [x] No reference asserting a code-review op-cert survives in guidance\n  (checked: `grep -rniE 'code[- ]review.{0,40}op-?cert|code[- ]review.{0,40}certif' AGENTS.md docs/`\n  returns only the ADR 0104 correction record, never an assertion that one exists).\n- [x] Guidance describes certified-op enforcement as deferred/enableable, not live\n  (checked: `grep -niE 'enforcement.*(defer|enable)|mcp-opcert-enforcement-flip' AGENTS.md` shows the\n  deferred framing + runbook citation).\n- [x] docs/mcp-auth.md §7 contains the AWS deploy recipe with the ADR-named config keys\n  (checked: `grep -niE 'AWS|http_tls_at_edge|auth_static_tokens_file|auth_strategies' docs/mcp-auth.md`\n  shows the recipe with the keys).\n- [x] A client-connection guide documenting the three client config shapes is reachable from\n  docs/mcp-auth.md (checked: `grep -ni 'mcp-client-setup' docs/mcp-auth.md` links the guide, which\n  documents the copilot/codex/claude shapes).\n\n## Compat / rollback\nDocs-only; rollback = revert the doc edits. No behavior change.\n\nDepends on: deft-evolutive-mosasaur (ADR 0104 decides routing/auth), and the trusted-env registration\nslice (guidance claims certified ops are enforceable via MCP, which is only true once the box is a\ntrusted env).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"AGENTS.md","reason":"add MCP-required tracker-op rule + local-code carve-out; correct certified-op wording"},{"path":"docs/mcp-auth.md","reason":"fill §7 AWS deploy recipe + surface client-connection guide"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","14f5-ca81-b70d-4550"],["depends_on","a45f-bd45-513a-49cb"],["depends_on","b173-e50a-4b93-455f"],["parent","jira-reb-3527"],["relates_to","47ad-53e3-945e-4a3f"],["relates_to","78e6-b9a9-8404-4edc"],["relates_to","925b-c54f-7289-4168"]],"no_file_impact_reason":"","parent_id":"jira-reb-3527","parent_status_uuid":"fac094a4-9321-4c97-89a5-514741125b35","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"aa0b-92f6-c132-4c23","ticket_type":"task","title":"Guidance: require the MCP server for rebar ops (except local-code ops); document certified-op routing","verify_commands":[]},"source_event_uuids":["4140e860-8af5-462c-908c-f006526c1846","40dc6ac6-8b6b-4f6c-b58c-027fae4a1f4d","f306ef80-797a-4f25-b3cc-9ab6f0eccfd7","ef34cefd-3d9b-4c60-a764-7d8a9ccd1dc4","28a2c296-7604-4efe-9c9e-7b05b3894cd4","13c6322d-f31c-4c81-8ac0-66f22617e276","6ea32096-55f4-486f-a946-a4f2ee1f0e12","a9bf74f5-da1f-488f-bfca-6ba2957103e0","7369de06-3cc8-4ee9-bd47-88ef8951c0d5","d29ed146-cf16-4752-84de-e5c1186371b5","9a3cffc3-39d5-446e-811f-fae62c3301cd","46ed4cab-a3b5-4603-b40f-07fb0bdba43f","fac094a4-9321-4c97-89a5-514741125b35","e7bc36b8-08af-4fbd-9836-15eadfb37710"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787659779234946727,"uuid":"7a40de97-5033-4972-8d59-29ec1800a260"}