ens":42068,"output_tokens":1501,"requests":4}},{"kind":"success","lineage":{"dependencies":[],"digest":"dfb1bd59abf953a1ea3205ff224a8b8add85bd7d93b76979a2b3793b304e2dd6"},"namespace_version":1,"reason":null,"unit_id":"agent:T5c","usage":{"input_tokens":30244,"output_tokens":1225,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"17270d0e75926ae0aea8dda50f52058b75684226827f9675b95a2c5350972051"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":110093,"output_tokens":2378,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"7abbc4e406b6acea98dc57c5e2ccc0b7a01087c631f5862f368425d5441066b6"},"namespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":142263,"output_tokens":2733,"requests":5}}],"version":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Restate AC5 so its pass/fail record is an explicit reviewer confirmation (as done for the consumer-scan AC) that each grep hit is the ADR 0104 correction and NOT an assertion — the grep is a candidate-line aid, not the verdict.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5e","T7"],"criteria":["E6"],"decision":"advisory","decision_margin":-0.4687,"drop_reason":null,"evidence":["'checked: grep -rniE 'code[- ]review.{0,40}op-?cert|code[- ]review.{0,40}certif' AGENTS.md docs/ returns only the ADR 0104 correction record, never an assertion that one exists'","The pattern matches both the correction sentence and any surviving assertion; the 'only the correction record' disposition is a human judgment the grep cannot make."],"finding":"AC5's grep oracle cannot distinguish the intended pass state ('only the ADR 0104 correction record') from the fail state ('an assertion that a code-review op-cert exists') — the regex `code[- ]review.{0,40}(op-?cert|certif)` matches BOTH the correction record and any lingering assertion, so a green grep does not prove the criterion.","group_criteria":null,"group_id