ble":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"missing_oracle","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify the cursor+total on-disk encoding and assert that OLD (rolled-back) code reading a new-format file reseeds/publishes 0 rather than parsing a fabricated total — e.g. ensure the file's first line is not a lone integer.","cohort":["T11"],"criteria":["T11"],"decision":"advisory","decision_margin":-0.4475,"drop_reason":null,"evidence":["'Each counter persists a journald cursor beside its total'","Existing reader guard at observability.sh:888 `case \"$prev\" in '' | *[!0-9]*) prev=$total ;;` treats non-numeric file content as a reseed","ABSENCE: no AC and no repair text asserts the post-rollback state — what old code does when it cat's a file now containing a cursor+total instead of a bare integer"],"finding":"The plan does not specify the on-disk ENCODING of the new cursor+total pair, and does not assert how the old code interprets the new-format state file after a rollback. Since R1 can be reverted (Terraform/script rollback) while the new-format files persist on the host, the post-rollback interpretation is load-bearing but unstated.","group_criteria":null,"group_id":null,"id":"f47afd089cc191666","impact":0.67,"is_primary":null,"location":"Repair R1, 'Cursor and total are persisted TOGETHER in one state file'","norm_id":"nd78c22dc80ef12d6","priority":0.5025,"reason":"default-advisory","recalled":false,"scenarios":["R1 is deployed, writes cursor+total files, is then rolled back to the prior script which reads the same paths expecting a bare integer total"],"severity":null,"suggested_fix":"Encode the new format so its content is non-numeric to the old reader (e.g. a leading key=value/JSON line), guaranteeing the old code's `*[!0-9]*` guard reseeds instead of fabricating a delta after rollback; add an AC asserting this.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State whether markers emitted in the cutover window (between old code's last scan and the new code's first-run tail seed) are acceptably dropped, or seed the new cursor from a position derivable from the carried-forward total rather than the bare tail so no marker is lost across the upgrade.","cohort":["T11"],"criteria":["T11"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'seed from the tail and publish 0 for that run — so the first post-deploy run neither retro-counts the retention window nor performs one last full scan. The existing total is carried forward unchanged'","AC3 asserts 'each marker is counted into exactly one interval's delta across three consecutive runs' — steady state only, not across the upgrade boundary","ABSENCE: the plan does not acknowledge markers emitted between the last old-format run and the first new-format tail-seed, which fall outside both the carried total and the new cursor"],"finding":"The Upgrade transition leaves an uncounted marker window: old code's last scan established a total covering up to some journal position, but the new code's first run seeds the cursor from the current journal TAIL. Markers emitted in the interval between old code's final run and the new code's first run are neither reflected in the carried-forward total nor after the new tail cursor, so they are permanently uncounted.","group_criteria":null,"group_id":null,"id":"f120cc3d5f8103c01","impact":0.0,"is_primary":null,"location":"Repair R1, 'Upgrade' state-transition bullet","norm_id":"nbb737fc24a0df40b","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["A deploy occurs and emits AUTODEPLOY_DEFERRED / review-interrupt markers in the ~minutes between the old probe's last scan and the first run of the upgraded probe"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] State the rollback/back-out behavior for the new state-file format (e.g. write the total in a position old code still reads, or document that a revert requires deleting the state file so old code cold-starts).","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5b","T5e"],"criteria":["T4"],"decision":"advisory","decision_margin":-0.4525,"drop_reason":"novelty","evidence":["'an existing old-format file holding a bare total and no cursor ... treated exactly like a cold start' handles OLD->NEW only","Constraint: 'Terraform may be written and validated, never applied. The live host is not touched.' — implies redeploy path, so a revert leaves new-format state on-host","No statement of how reverted (old) code tolerates a new-format state file"],"finding":"R1 changes the persisted state-file format (adds a journald cursor beside the total). The forward Upgrade leg is specified, but the reverse case is not: if the repair commit is reverted after deploy, the running host's state file will hold the new cursor+total pair while the old code expects a bare total. No rollback/back-out behavior for the state file is stated.","group_criteria":null,"group_id":null,"id":"f7916a631619c88f3","impact":0.33,"is_primary":null,"location":"R1 — state transitions / Upgrade leg","norm_id":"n06cd863ddd1156f0","priority":0.2475,"reason":"default-advisory","recalled":false,"scenarios":["Repair is deployed then rolled back; old observability.sh reads a state file now containing cursor+total and mis-parses the total, fabricating a wrong delta — the exact 'plausible wrong number' the plan elsewhere forbids"],"severity":null,"suggested_fix":"Add a one-line note: on revert, the state file must be removed (or is ignored by old code because the new format is written under a distinct filename/key) so the downgraded code cold-starts rather than mis-parsing the cursor+total pair.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"low","likelihood":"low","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the rollback path: confirm the pre-change script tolerates (or ignores/reseeds from) a new-format state file, or delete/rename the state file on revert, so undo is clean without manual data cleanup.","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["T12"],"decision":"advisory","decision_margin":-0.7025,"drop_reason":"novelty","evidence":["R1: 'Cursor and total are persisted TOGETHER in one state file written temp-file-then-rename'","AC6 handles forward upgrade (old-format bare total -> new format) but no reverse case is described","No rollback statement anywhere in the plan"],"finding":"The plan changes the persisted state-file format (adds a journald cursor beside the bare total) and forward-handles the old->new upgrade (AC6), but never states the rollback path: if the change is reverted, the OLD script would read a NEW-format state file it does not understand. Rollback semantics for the on-disk state and the systemd unit files are unspecified.","group_criteria":null,"group_id":null,"id":"f9502ab1ca74d3caa","impact":0.33,"is_primary":null,"location":"R1 state-file format; Constraints ('Terraform may be written and validated, never applied')","norm_id":"n27860ef9b15de88a","priority":0.2475,"reason":"default-advisory","recalled":false,"scenarios":[],"severity":null,"suggested_fix":"Add a one-line rollback note: on revert, the reverted script treats the new-format file as an unparseable/old file and reseeds from tail (matching the cold-start leg), or the state file is removed as part of revert.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"low","likelihood":"low","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an acceptance criterion that a write interrupted mid-update (simulating R2's SIGKILL between temp-file write and rename) leaves the previously-committed cursor+total pair intact and consistent.","cohort":["E3","E5","G5","T12","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["E5"],"decision":"advisory","decision_margin":-0.95,"drop_reason":"novelty","evidence":["R1: 'written temp-file-then-rename, so the SIGKILL that R2 introduces cannot leave the pair inconsistent and produce exactly the plausible wrong number this repair rejects'","AC5: 'Such a scan also leaves the counter's persisted state byte-identical' — covers scan-cannot-complete, not interrupted write"],"finding":"R1 introduces atomic temp-file-then-rename specifically so R2's SIGKILL cannot leave cursor/total inconsistent, but no acceptance criterion exercises a SIGKILL (or crash) mid-write. AC5 only asserts byte-identical state after a scan that 'cannot complete' (a graceful failure/timeout), not after an interruption during the write of the state pair.","group_criteria":null,"group_id":null,"id":"ffb78a4753ee6ff9b","impact":0.0,"is_primary":null,"location":"R1 ('temp-file-then-rename ... the SIGKILL that R2 introduces cannot leave the pair inconsistent'); AC5","norm_id":"n274bf4702bf66bbf","priority":0.0,"reason":"default-advisory","recalled":false,"scenarios":[],"severity":null,"suggested_fix":"Add AC: injecting a failure between temp-file creation and rename leaves the prior state file readable and consistent (old cursor+total), never a partial pair.","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"