c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8e1336eb37d0576bf4107e95dd21499df351683c541b2acb102afa3378f40cf3","event_uuid":"2b77c88e-2784-4c92-a906-c275a5df2610","position":{"commit_sha":"48ca4026d5c05e3045f8f8a786c020bbe693cc92","position":"1787750727421885001-2b77c88e-2784-4c92-a906-c275a5df2610"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"877e15e59bf479886859925311c418bf6d8e354e626f51634b6eb40c2152f22c","event_uuid":"f34f3c80-7386-46d6-a6f2-e9cb52639087","position":{"commit_sha":"7dccd429e73c9e2105ef5d696311fabe79b46c3b","position":"1787750746260829001-f34f3c80-7386-46d6-a6f2-e9cb52639087"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"S5 story completion evidence (all children closed certified: T1 b81b, T2 0f5d, T3 a735). AC1-AC2 route census: test_coordinator_route_census.py 9 passed. AC3-AC4 versioned output/state/pass-outcome: preview_lifecycle_intents + live_mode_failure_tally + bridge_canonical_manifest 37 passed. AC5 portable verified-fake Cloud/DC E2E: relocated test_reconciler_coordinator.py + _taxonomy.py 14 passed. AC6 ADR/docs index: check_docs_index + check_adr_numbers 24 passed. Inherited repair-boundary invariant: test_recovery_write_boundary.py 21 passed (ordering oracle intact). file_impact + AC5 verify_command corrected to relocated tests/unit/rebar_reconciler/mutate/ path.","timestamp":1787749678019826001}],"completion_expectation":"required","created_at":1787022636066935001,"creation_channel":"cli","deps":[{"link_uuid":"992726ed-8aa3-4f37-9ee8-3eda1e5e1054","relation":"depends_on","target_id":"59b0-d1b9-ad94-4339"},{"link_uuid":"4bdc7e42-d97e-4422-aac2-bb5d59bc31da","relation":"depends_on","target_id":"f5ac-6373-5e33-4374"},{"link_uuid":"9efbdb35-cad2-4402-9995-9bbfcf35529b","relation":"relates_to","target_id":"d7b9-ac42-ad6f-4608"},{"link_uuid":"51896fca-f65d-4a2c-82d3-12c82b283d1c","relation":"relates_to","target_id":"f5ca-8725-7eee-4770"}],"description":"## Context / Problem\nAfter operation-family cutovers, leaving generic `_call_with_retry`, `_best_effort`, duck-typed production dispatch, or legacy write routes active would preserve retry multiplication and allow future code to bypass the coordinator. Preview/log consumers also need a stable versioned contract for lifecycle and deferred outcomes before expand can contract.\n\n## Outcome\nFinish the expand/contract migration: route every supported live mutation through typed plans/coordinator/adapters, remove obsolete physical-retry and write fallbacks, fail loudly for unsupported production paths, and seal manifests, logs, pass cursor/tallies, documentation, and local verified-fake validation. Preserve existing mutation shape while making lifecycle/retry/fuse outcomes explicit and observable.\n\n## Plan\n1. Inventory every Cloud/DC mutation leaf and prove it reaches the typed coordinator. Remove generic whole-operation retry, `_best_effort` write swallowing, production class-name/duck fallbacks, and duplicate SDK/adapter retry owners.\n2. Keep compatibility only at serialized/public read boundaries. An unsupported live action raises a typed pre-effect error; tests may use explicit fakes implementing the declared protocol.\n3. Finalize versioned preview/manifest sections for lifecycle intents, logical/physical attempts, delay source/value, budgets, scope, disposition, `retry_not_before`, fuse state, and exact per-ticket/pass outcomes. Redact secrets and bound diagnostic size.\n4. Advance cursor/baseline/binding state only for proven postconditions. Deferred, failed, skipped, and commit-unknown work remains eligible for later re-observation and is never reported as applied.\n5. Add ADR/docs for retry ownership, failure taxonomy, scoped fuse, label-first create containment, explicit behavior deltas, expand/contract rollback, and future adapter obligations. Run portable verified-fake Cloud/DC end-to-end tests; retain bounded live probes as optional operator evidence.\n\n## Testing (RED → GREEN)\n- A dispatch census test enumerates every `MutationDirection`/`MutationAction` and provider route, asserting one typed owner or an intentional pre-effect unsupported error.\n- End-to-end fake Cloud/DC passes cover mixed success, transient recovery, long-delay deferral, permanent ticket failure, auth/provider stop, fuse open/reset, create containment, restart, and delivery failure.\n- Golden preview/log/manifest tests pin existing mutation fields plus additive versioned sections, redaction, bounded diagnostics, and exact tally/exit semantics.\n- Static/string and runtime poison tests fail if removed legacy helpers or hidden retries are reachable from production.\n\n## Compatibility / rollback\nContract only after shadow parity and each family cutover test passes. A pre-contract release can revert per-family routing; after removal, rollback is a code revert that re-observes remote state and never compensates by deleting successful Jira work. Stored ticket/binding/event formats are unchanged; additive manifest fields are versioned and ignorable.\n\n## Acceptance Criteria\n- [x] A route census proves every supported Cloud/DC mutation uses exactly one typed coordinator/adapter path and no hidden SDK, generic wrapper, `_best_effort`, or duck-typed production fallback remains reachable.\n- [x] Unsupported production actions fail before local/remote effects with a typed provider-neutral error.\n- [x] Preview, manifest, and logs preserve existing mutation fields and add versioned redacted logical-attempt, lifecycle, delay/budget, disposition, fuse, and `retry_not_before` data.\n- [x] Cursor, baseline, and binding state advance only for proven postconditions; deferred/failed/skipped/commit-unknown work is never counted as applied and remains recoverable next pass.\n- [x] Portable verified-fake Cloud/DC end-to-end suites cover the approved taxonomy, retry envelope, fuse, create containment, restart, and partial-outcome behavior without external credentials.\n- [x] ADR and operator docs record ownership, intentional behavior changes, future adapter contract, no-dual-write cutover, and rollback that never deletes successful Jira work.\n\n## Inherited invariant — pre-observation repair boundary (folded in from insectile-modest-martin, 2026-08-19)\n\nOperator decision: `insectile-modest-martin` (d7b9-ac42) is CLOSED and its requirement now lives\nhere. This ticket edits `reconcile.py`, which sits at **799 of the 800-line cap**, so it must\nperform a behaviour-preserving extraction (extract along an existing call-graph seam; NEVER raise\nthe limit). That extraction must preserve one specific ordering invariant that is easy to break\nsilently.\n\n**The invariant.** The call\n`binding_store.repair_at_write_boundary(persist=persist, scoped=bool(scoped_ids))` must remain:\n\n- **AFTER** the under-lock staleness validation (`ensure_selection_current`) — a pass whose\n  selection is stale has not established that its view is current and has no standing to repair; and\n- **BEFORE** the pass's first remote issue fetch (`fetcher.fetch_snapshot` / `compute_snapshot`).\n\nThe pre-observation half is the one with teeth. A durable tombstone is authoritative retirement\nintent. A pass that fetched first could observe the retired issue answer 200 and then complete that\nissue's retirement in the same breath as fresh evidence that it is alive; repairing first keeps the\nrecorded decision from racing a later observation. **Move the call after the fetch and the repair\nstill runs, still writes correct-looking bytes, and is silently wrong.**\n\n`run_differs.py` is specifically NOT an alternative home: `reconcile._load_snapshots` performs the\nfirst remote fetch inside itself, and both `bind_operation_runtime` and `run_differs()` run after it\nreturns, so no position inside `run_differs.py` can precede remote observation. Recorded in ADR 0099.\n\n**The two tests that are the only guard** (both drive or name `_load_snapshots` directly, so an\nextraction that renames or re-splits that phase WILL force someone to touch them) — in\n`tests/unit/rebar_reconciler/orchestrate/test_recovery_write_boundary.py`:\n\n- `test_repair_runs_before_the_first_remote_observation` — the behavioural oracle; drives the real\n  load phase with an event recorder and asserts the repair event precedes the fetch event.\n- `test_the_repair_is_invoked_from_reconcile_and_not_from_run_differs` — a structural anchor.\n\nThe tempting shortcut under time pressure is to relax the assertion rather than re-anchor it.\n**Relaxing it is the thing to avoid.**\n\n### Additional acceptance criteria (inherited)\n- [x] After this change to `reconcile.py`, the repair call still runs after the under-lock staleness\n      gate and before the pass's first remote issue fetch.\n- [x] `test_repair_runs_before_the_first_remote_observation` still fails when the call is moved to a\n      post-fetch position — demonstrated by SEEDING that move and observing RED, not merely by the\n      suite being green.\n- [x] If the load phase is renamed or re-split, the boundary tests are RE-ANCHORED to the new\n      structure rather than relaxed, and the ordering assertion survives in a form that still\n      discriminates.\n- [x] `reconcile.py` remains within the 800-line cap without raising the limit.\n- [x] ADR 0099's invocation-boundary section is updated if the realized position changes shape.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/applier.py","reason":"Remove legacy generic retry and write dispatch fallbacks."},{"path":"src/rebar/_engine/rebar_reconciler/batch_dispatch.py","reason":"Remove obsolete whole-operation retry routes."},{"path":"src/rebar/_engine/rebar_reconciler/manifest_renderer.py","reason":"Seal versioned lifecycle, retry, fuse, and outcome output."},{"path":"src/rebar/_engine/rebar_reconciler/reconcile.py","reason":"Make coordinator results authoritative for state advancement and exit status."},{"path":"src/rebar/_engine/rebar_reconciler/last_pass.py","reason":"Persist exact deferred/failed/recovered pass outcome semantics."},{"path":"docs/adr/0103-reconciler-operation-coordination.md","reason":"Record retry ownership, taxonomy, fuse, containment, and cutover decisions."},{"path":"docs/adr/README.md","reason":"Index the operation-coordination ADR."},{"path":"docs/architecture.md","reason":"Document the planner/coordinator/adapter dependency direction."},{"path":"tests/unit/rebar_reconciler/mutate/test_coordinator_route_census.py","reason":"Prove one typed owner or fail-loud unsupported behavior for every route."},{"path":"tests/unit/rebar_reconciler/mutate/test_reconciler_coordinator.py","reason":"Portable verified-fake Cloud/DC end-to-end validation (scenarios 1-6)."},{"path":"tests/unit/rebar_reconciler/mutate/test_reconciler_coordinator_taxonomy.py","reason":"Portable verified-fake Cloud/DC end-to-end validation (taxonomy scenarios 7-10)."},{"path":"tests/unit/rebar_reconciler/mutate/_coordinator_harness.py","reason":"Shared credential-free coordinator E2E harness."}],"file_impact_scope":"paths","keyring":[]