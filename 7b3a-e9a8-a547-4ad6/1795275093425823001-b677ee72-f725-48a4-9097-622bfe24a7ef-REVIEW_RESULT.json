 run.","group_criteria":null,"group_id":null,"id":"f7c3468a1c17ae645","impact":0.0,"is_primary":null,"location":"Testing section (temp-branch dispatch)","norm_id":"n3f82d805d5d5000e","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["The implementer lacks direct push rights to the GitHub mirror, or a gh token with actions:write, so the AC is blocked","The implementer records the push-event run, which has no Windows job, instead of the workflow_dispatch run"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.3889,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"insufficient","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"78d49543fc7217b7","material_parts":{"children":["647ea2107ca5072f",0],"description":["efb7b75b0aab7bc3",2298],"description_boxes":["0aad7da77d2ed59c",0],"file_impact":["0eb293b241660af9",1],"ticket_id":["b203705faa8515f4",19]},"metrics":{"cache_read_tokens":282539,"cache_write_tokens":134534,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":11815.5,"input_tokens":439455,"llm_calls":27,"llm_ms":86035.1,"output_tokens":2228