c","position":"1785445409716816001-6175c4b8-fa4b-4f5e-a082-a56d38563661"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1e7128682a4627b4b1de15eb4a23948e0399abc51ad0a7be41fb03aa3d939a53","event_uuid":"6c5d1de6-2ebe-460c-8606-0948a4a3a891","position":{"commit_sha":"1740a257e18f1a8539c4785910fc584afe37cccc","position":"1785445661948758001-6c5d1de6-2ebe-460c-8606-0948a4a3a891"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e826c4365cc1e0f2457cac8e5b1bd12adc4519143eb9e930d491fa84e0e2cec0","event_uuid":"474a7312-996a-48f8-a3da-ee42815d955a","position":{"commit_sha":"4986618defb10fcabd107c30525e3348f46d07fb","position":"1785445831042308001-474a7312-996a-48f8-a3da-ee42815d955a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d6180723a61731e597dea3c10bf4334e89f1a4cdcac46b0161f3f4db1c3cbe01","event_uuid":"fb439f54-7d8e-4207-9442-2723d6e03df5","position":{"commit_sha":"4986618defb10fcabd107c30525e3348f46d07fb","position":"1785445831562936001-fb439f54-7d8e-4207-9442-2723d6e03df5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0ad85c984a60eccd082b8ca2791d2917b854630831631a9e9a32c8a7901d58cd","event_uuid":"0e2c14ed-f703-4578-b495-79748308ee3c","position":{"commit_sha":"cc7a5b87400b6eadc644be34e272cff846bcbb05","position":"1785446184959956851-0e2c14ed-f703-4578-b495-79748308ee3c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-220_agent","claim_remote_session":null,"claimed_session":"bdce800f-7053-4bf7-8ccb-afaa9acb1d55","comments":[],"created_at":1785444730150939001,"creation_channel":"cli","deps":[{"link_uuid":"fac7de0a-d157-45e2-b41a-e393858d6b1f","relation":"discovered_from","target_id":"fec5-d8bb-86cd-453e"},{"link_uuid":"02c52f79-18e8-4510-bdab-ae0103721dcf","relation":"relates_to","target_id":"5f7c-7f7d-d48a-45d7"}],"description":"## Context / Problem\n\nChanging a ticket's type silently carries forward a plan-review verdict computed under different criteria. Re-run `review-plan` after the change and it reports `runner: reused`, `source: attested`, `model: None` — no LLM runs, and the stored verdict is replayed as if it still applied.\n\nType is not cosmetic to the review: it gates scoring in four places.\n\n- `src/rebar/llm/plan_review/orchestrator.py:364` — `bug_tier = ctx.ticket_type == \"bug\"`\n- `src/rebar/llm/plan_review/orchestrator.py:642` — exempts `bug` / `session_log` / `code_review` / `identity`\n- `src/rebar/llm/plan_review/workflow_ops.py:167` — `session_log` / `code_review` / `identity` are gate-exempt\n- `src/rebar/llm/plan_review/workflow_ops.py:183` — a distinct `bug` branch\n\nSo a plan that PASSES as a `bug` — exempt from several criteria — keeps that PASS when retyped to `task`, which is not exempt.\n\nObserved on ticket fec5-d8bb-86cd-453e: created as a `bug`, reviewed PASS, retyped to `task`, re-reviewed → replayed the stored PASS. A forced re-review of the SAME plan then returned BLOCK with 3 findings. The reuse was not merely stale; it was wrong for the ticket's current type.\n\n## Root cause\n\nBoth reuse paths in `src/rebar/llm/plan_review/reuse.py` gate on the material fingerprint and never compare type:\n\n- `idempotent_reuse` (`:33`, the PASS path) delegates validity to `claim_gate_check`, which binds the material fingerprint, the reviewed code SHA and the registry stamp — none of which move when only the type changes.\n- `verdict_reuse` (`:84`, the BLOCK path) compares `base_material` and `base_sha` explicitly (`:111-118`) and stops there.\n\n`material_fingerprint` (`src/rebar/llm/plan_review/pass1.py:715`) hashes `ticket_id`, `description`, `file_impact`, `children` and conditionally `file_impact_scope` (`:719-730`). `ticket_type` is absent, even though the value is available at the call site (`attest.py:778` builds the `PlanContext` with it).\n\n## Approach\n\nCompare the stored type against the current one in both reuse paths, and FAIL OPEN when the stored value is absent.\n\nThe stored REVIEW_RESULT sidecar already records `ticket_type` (confirmed on a live sidecar: its keys include `ticket_type`, `material_fingerprint`, `verified_at_sha`, `regver`), so this needs no schema change and no new field — the data is already written, just never read for this decision.\n\nThe predicate, in both functions:\n\n    if base_type and current_type and base_type != current_type:\n        return None   # type changed → run the full review\n\nBoth operands must be truthy. A sidecar written before this lands, or one whose type is empty, leaves reuse untouched — existing certifications keep working and are re-earned naturally the next time the plan changes.\n\n- `verdict_reuse` already reads `prior = sidecar.latest_review_result(...)` and guards `base_material` / `base_sha` in the same style at `:111-118`, so the check sits directly beside them.\n- `idempotent_reuse` does not currently read the sidecar; it must read `latest_review_result` for the stored type alone, keeping `claim_gate_check` as the authority for everything else.\n\nRejected — add `ticket_type` to the `material_fingerprint` basis. One line, and it invalidates EVERY existing attestation, because the basis is hashed as a whole: every certified ticket would need a fresh `review-plan` before its next claim or close. It would also break two hardcoded fingerprint assertions in `tests/unit/test_plan_review.py:1023-1024`. Operator decision: failing open is preferred to a mass invalidation, so the fingerprint is deliberately left alone.\n\nRejected — clear the attestation in the `edit` command when `--ticket_type` changes. That covers the CLI only; the library `rebar.edit` and the MCP `edit_ticket` tool would still leave a stale attestation. The reuse functions are the chokepoint every caller flows through.\n\n## Scope\n\n- `src/rebar/llm/plan_review/reuse.py` — the type comparison in `idempotent_reuse` (`:33`) and `verdict_reuse` (`:84`). `material_fingerprint` and the attestation schema are NOT touched.\n- `tests/unit/test_plan_review_reuse_type.py` — new module. Kept separate from `tests/unit/test_plan_review_reuse.py`, which was red on main within the last day (fixed by change 1044) and whose fixtures are tuned to the DET-floor short-circuit; a new module avoids destabilising it.\n\n## Testing\n\n- Failure (the defect): a sidecar stored with `ticket_type: \"bug\"` and a current context of `task`, identical in every other respect, does NOT reuse — both paths return `None`. This fails against the current implementation and is the regression oracle.\n- Happy path: identical stored and current type still reuses, so the change introduces no spurious re-reviews.\n- FAIL OPEN: a sidecar with `ticket_type` absent, or empty, still reuses. This is the property the operator chose over mass invalidation and is the one most likely to regress under a later \"tighten the guard\" edit.\n- Regression: `material_fingerprint` output is unchanged — the two hardcoded SHAs at `tests/unit/test_plan_review.py:1023-1024` still pass, proving the fingerprint was not touched.\n\n## Acceptance Criteria\n\n- [ ] `verdict_reuse` returns `None` when the stored sidecar type differs from the current context type, and a reuse payload when they match; verified by the two cases in `tests/unit/test_plan_review_reuse_type.py`.\n- [ ] `idempotent_reuse` returns `None` on the same mismatch; verified by its case in the same module.\n- [ ] Both paths STILL reuse when the stored type is absent or empty — the fail-open property; verified by the two fail-open cases in the same module, asserting a reuse payload is returned rather than `None`.\n- [ ] `material_fingerprint` is unchanged: `pytest tests/unit/test_plan_review.py -k fingerprint` passes without editing the hardcoded SHAs at `:1023-1024`; verified by running it and by `git diff` showing that file untouched.\n- [ ] End to end: on a scratch ticket certified as a `bug`, `rebar edit <id> --ticket_type=task` followed by `rebar review-plan <id>` reports a `runner` other than `reused`; verified by running `rebar review-plan <id> --output json | jq -r .runner` and recording the value on this ticket.\n- [ ] `make lint`, `make typecheck` and `pytest tests/unit/test_plan_review_reuse_type.py tests/unit/test_plan_review_reuse.py` all pass; verified by running each.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/plan_review/reuse.py","reason":"type comparison in idempotent_reuse (:33) and verdict_reuse (:84), failing open when the stored type is absent; material_fingerprint is deliberately NOT touched"},{"path":"tests/unit/test_plan_review_reuse_type.py","reason":"new module, kept separate from test_plan_review_reuse.py which was recently red on main and whose fixtures are tuned to the DET short-circuit"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","5f7c-7f7d-d48a-45d7"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"474a7312-996a-48f8-a3da-ee42815d955a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"6e4f-cad1-aa39-446a","ticket_type":"task","title":"Changing ticket_type must invalidate the plan-review attestation","verify_commands":[]},"source_event_uuids":["20e5c98d-38e8-485f-b832-685deb067c59","e059b38a-f3d5-47d7-ad28-660cae59de69","fac7de0a-d157-45e2-b41a-e393858d6b1f","46f81748-0217-46c0-b961-e01e059c36b4","6175c4b8-fa4b-4f5e-a082-a56d38563661","6c5d1de6-2ebe-460c-8606-0948a4a3a891","474a7312-996a-48f8-a3da-ee42815d955a","fb439f54-7d8e-4207-9442-2723d6e03df5","0e2c14ed-f703-4578-b495-79748308ee3c","02c52f79-18e8-4510-bdab-ae0103721dcf"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785446270712164376,"uuid":"0dca4dc4-f4cc-4f19-a234-f5fda53875b0"}