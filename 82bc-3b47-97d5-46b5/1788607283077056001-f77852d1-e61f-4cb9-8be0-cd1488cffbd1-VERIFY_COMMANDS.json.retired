{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast, io, re, subprocess, sys, tokenize\nDIRECTIVE = re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|(?:fmt|isort):\\s*(?:on|off|skip)\\b|pyright:|mypy:|ruff:|pylint:|nosec\\b|coding[:=]|[A-Za-z][\\w-]*-ok:)\", re.I)\nOWNERS = (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)\ndef src(ref, path):\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], text=True)\ndef norm_ast(text):\n    tree = ast.parse(text, type_comments=True)\n    for ti in tree.type_ignores:\n        ti.lineno = 0\n    for node in ast.walk(tree):\n        if isinstance(node, OWNERS) and node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):\n            node.body = node.body[1:]\n    return ast.dump(tree, include_attributes=False)\ndef directives(text):\n    shebang = text.splitlines()[0] if text.startswith(\"#!\") else \"\"\n    comments = [tok.string for tok in tokenize.generate_tokens(io.StringIO(text).readline) if tok.type == tokenize.COMMENT and DIRECTIVE.search(tok.string)]\n    return shebang, comments\nbad_ast, bad_directives = [], []\nfor path in sys.argv[1:]:\n    before, after = src(\"HEAD^\", path), src(\"HEAD\", path)\n    if norm_ast(before) != norm_ast(after): bad_ast.append(path)\n    if directives(before) != directives(after): bad_directives.append(path)\nassert not bad_ast, f\"non-docstring AST changes: {bad_ast}\"\nassert not bad_directives, f\"directive/shebang changes: {bad_directives}\"' scripts/_mechanism_delta/__init__.py scripts/_mechanism_delta/compare.py scripts/_mechanism_delta/detect_ci.py scripts/_mechanism_delta/detect_code.py scripts/_mechanism_delta/detect_config.py scripts/_mechanism_delta/markers.py","dd_id":"python-prose-only","dd_text":"Require normalized non-docstring AST equivalence and exact directive/shebang preservation."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" pytest -q tests/unit/test_mechanism_delta.py --deselect tests/unit/test_mechanism_delta.py::test_the_reported_selection_passes_standalone","dd_id":"focused-mechanism-contracts","dd_text":"Exercise the cohesive mechanism-delta contract suite without its slow standalone import-isolation node."},{"command":"rtk git diff --check HEAD^ HEAD -- scripts/_mechanism_delta/__init__.py scripts/_mechanism_delta/compare.py scripts/_mechanism_delta/detect_ci.py scripts/_mechanism_delta/detect_code.py scripts/_mechanism_delta/detect_config.py scripts/_mechanism_delta/markers.py","dd_id":"diff-integrity","dd_text":"Reject whitespace errors in all declared paths."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" make verify","dd_id":"repository-gates","dd_text":"Run the complete repository verification gate before review."}]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"VERIFY_COMMANDS","timestamp":1788607283077056001,"uuid":"f77852d1-e61f-4cb9-8be0-cd1488cffbd1"}