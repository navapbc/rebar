atures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3f3835dfdb33e846d3b53771f9638bb21a411a360017c8fa21e1daaa0ce752f4","event_uuid":"1882e62a-967e-45f6-be44-e1d909a48d48","position":{"commit_sha":"6fd9e23ad44a3d68dd18f3d4db07e3b60d828ace","position":"1788578431678866001-1882e62a-967e-45f6-be44-e1d909a48d48"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788570617504139089,"creation_channel":"mcp","deps":[{"link_uuid":"f4bcda50-5054-45a6-b182-cbd393a3805d","relation":"supersedes","target_id":"77c3-236d-a3c2-4282"},{"link_uuid":"772de46a-282c-40aa-bb63-91f7b91d5e26","relation":"supersedes","target_id":"672b-7584-c413-4c45"},{"link_uuid":"71d59591-16a0-4c5f-a91a-4b8ff4a5072b","relation":"supersedes","target_id":"e105-8914-08fd-4cbc"},{"link_uuid":"2c4786f7-9c91-4a4a-a22f-eaec3d66879a","relation":"supersedes","target_id":"562d-9507-c8b2-4b83"},{"link_uuid":"14513f85-d8fb-4899-8d46-81e7cf83f6fa","relation":"supersedes","target_id":"d270-4669-e300-4a94"},{"link_uuid":"1882e62a-967e-45f6-be44-e1d909a48d48","relation":"supersedes","target_id":"cac9-f60c-8125-408d"}],"description":"## Context / Problem\nThe scripts/_mechanism_delta cohort contains audited comments or docstrings that obscure current behavior with repetition, obvious narration, duplicated explanation, or historical detail. The audit is pinned to `9e65567b79ffe872534c3c656ade7b34340d8192`.\n\n## Approach\nEdit explanatory text only in this directory/subsystem cohort. Condense it to current, non-obvious rationale and constraints; retain every file-specific preserve item and consumer contract below. Grouping adjacent files from one subsystem keeps the change reviewable in one session and permits one coherent verification pass without changing executable behavior.\n\n## Scope\n- `scripts/_mechanism_delta/__init__.py:1–17` — Preserve detector grouping and standalone-import constraint. Consumer: none found.\n- `scripts/_mechanism_delta/compare.py:1–19` — Preserve four buckets, stale-is-allowed, pure evaluation. Consumer: none found.\n- `scripts/_mechanism_delta/detect_ci.py:1–23` — Preserve shapes, naming, marker placement, PyYAML requirement. Consumer: none found.\n- `scripts/_mechanism_delta/detect_code.py:1–23` — Preserve scan roots, parse-failure policy, lock/autouse definitions. Consumer: none found.\n- `scripts/_mechanism_delta/detect_config.py:1–26` — Preserve canonical registries, boolean partition, section-qualified names. Consumer: none found.\n- `scripts/_mechanism_delta/markers.py:1–28, 40–47, 52–58` — Preserve exact syntax, separator rule, placement. Consumer: none found.\n\n## Acceptance Criteria\n- [ ] Every listed location contains only current, non-obvious rationale or constraints after remediation; verified by reviewing the final diff against every Scope row.\n- [ ] Every preserve item and consumer contract in Scope remains explicit and accurate; verified by a row-by-row completion comment and the commands under Verification.\n- [ ] No executable behavior or test assertion changes; verified by the commands under Verification exiting 0.\n\n## Verification\n- `env PATH=\"$PWD/.venv/bin:$PATH\" make lint`\n- `env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/python scripts/check_comment_hygiene.py`\n\nThe row-by-row diff review is authoritative for prose quality; the hygiene guard detects only its narrow deterministic history-token rule.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"scripts/_mechanism_delta/__init__.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/_mechanism_delta/compare.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/_mechanism_delta/detect_ci.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/_mechanism_delta/detect_code.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/_mechanism_delta/detect_config.py","reason":"Condense comments/docstrings while preserving the scoped contract."},{"path":"scripts/_mechanism_delta/markers.py","reason":"Condense comments/docstrings while preserving the scoped contract."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","3de8-31a0-25ef-456d"]],"no_file_impact_reason":"","parent_id":"3de8-31a0-25ef-456d","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":["rebar"],"reverts":[],"status":"open","tags":["comments","documentation","maintainability","grouped-remediation"],"ticket_id":"82bc-3b47-97d5-46b5","ticket_type":"task","title":"Condense comments in scripts/_mechanism_delta","verify_commands":[]},"source_event_uuids":["170328b6-280e-42fe-bb11-cc24c514c682","15759ba2-096f-451b-80b1-4e9e179d7450","f4bcda50-5054-45a6-b182-cbd393a3805d","772de46a-282c-40aa-bb63-91f7b91d5e26","71d59591-16a0-4c5f-a91a-4b8ff4a5072b","2c4786f7-9c91-4a4a-a22f-eaec3d66879a","14513f85-d8fb-4899-8d46-81e7cf83f6fa","1882e62a-967e-45f6-be44-e1d909a48d48"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788582705471076001,"uuid":"9a8c29b4-6967-440c-b81a-bcc9d54ff7f5"}