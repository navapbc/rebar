a4bb0b93a667d024c700c65d07ad30463548e","position":"1786500831752275001-17897d68-ccc5-4e11-aa82-cf027ba3d000"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-227_agent","claim_remote_session":null,"claimed_session":"6f8df6b5-44f6-4ea4-b224-1eac4c95b0a7","comments":[],"created_at":1785275193008510001,"creation_channel":"cli","deps":[{"link_uuid":"09072eba-c1b6-4cfe-af85-44de58116188","relation":"discovered_from","target_id":"5f4d-c673-9913-4c6d"}],"description":"## Context\nIndependent review of ticket 5f4d found two non-blocking hardening gaps in\nscripts/check_criteria_vocabulary.py. A file containing invalid UTF-8 is skipped wholesale\n(`except UnicodeDecodeError: continue`), so a source file can evade the guard by carrying one\nbad byte. Separately, an unallowlisted match prints the complete raw source line, so a very\nlong line or embedded control characters land unescaped in CI logs.\n\n## Plan\n- Define a source-ish text extension set (`.py`, `.md`, `.json`, `.yaml`/`.yml`, `.toml`) that\n  must FAIL CLOSED on a decode error, while every other extension stays tolerated so genuine\n  binaries do not produce false positives.\n- Bound and escape diagnostic excerpts: escape non-printable characters and cap the escaped excerpt at\n  200 characters (`MAX_EXCERPT_CHARS = 200`), with an explicit truncation marker.\n- Add behavioral tests for invalid-byte source input, invalid-byte binary input, and\n  hostile (long / control-character) matching lines.\n\n## Testing\n- `python -m pytest tests/unit/test_check_criteria_vocabulary.py -q` — new cases: an\n  undecodable `.py` exits 1 naming the file, an undecodable `.bin` exits 0, and a long\n  control-character line is emitted escaped and truncated.\n- `make lint` and `make typecheck` — the guard is itself part of the `make lint` gate, so a\n  clean run proves the real repository still scans clean.\n\n## Acceptance Criteria\n- [ ] Known text files cannot evade the vocabulary guard by containing an invalid UTF-8 byte:\n      verified by a test asserting exit 1 and the offending path in stderr.\n- [ ] Binary files remain safely ignored without false positives: verified by a test asserting\n      exit 0 for an undecodable non-source extension.\n- [ ] Diagnostics escape control characters and cap source excerpts at 200 characters: verified by a test asserting no raw control byte and a truncation marker in stderr.\n- [ ] `python -m pytest tests/unit/test_check_criteria_vocabulary.py -q` and `make lint` pass.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"scripts/check_criteria_vocabulary.py","reason":"Decode policy and bounded escaped diagnostics"},{"path":"tests/unit/test_check_criteria_vocabulary.py","reason":"Invalid-byte, binary, and hostile-line behavioral coverage"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"515975dd-f577-4748-bcce-b0469efd5441","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"reverts":[],"status":"in_progress","tags":["vocabulary","security","follow-up"],"ticket_id":"8b6c-7583-3e65-4834","ticket_type":"task","title":"Harden vocabulary guard decoding and diagnostics","verify_commands":[]},"source_event_uuids":["d07da293-56bb-465d-b65d-20a3292a60b6","b8b5eae5-5d38-4bd4-a306-0c44c8a74657","09072eba-c1b6-4cfe-af85-44de58116188","deaa9db7-40b4-4ead-b3d5-45944ffdb1d7","088dd1e0-07f2-4331-bdb6-6e49a5cc738b","a3feb126-1c14-439f-98b8-65bf8de0fa74","515975dd-f577-4748-bcce-b0469efd5441","17897d68-ccc5-4e11-aa82-cf027ba3d000"]},"env_id":"b8a354e0-12c3-4cf2-bbf