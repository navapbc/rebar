29590067643857-062ac3b7-9301-4388-9287-5d29af29f110"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c90e775864469e7c591ac528d486e251be29c88661935b636befb4f20c8e3c30","event_uuid":"fafe50d4-054c-4997-b962-5cd17e862536","position":{"commit_sha":"d9b3668493a1a93a9cc0a192d6b6867d1769a0e2","position":"1788130826343302110-fafe50d4-054c-4997-b962-5cd17e862536"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d3bba906f12d0ba80c1ba3d34742cced497edd608ee5932554fd612d38f497db","event_uuid":"e27c388e-1f96-4b61-adce-f5a1a35f9d89","position":{"commit_sha":"8ec8bbda4471b6a4b285263a16c6fc63b0c4141c","position":"1788130973022675001-e27c388e-1f96-4b61-adce-f5a1a35f9d89"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fbb939e7d945e7edd65f78251e0dbe2dc8b455bfa30c84a7d45117b5f1311265","event_uuid":"3b5e0ce5-f08a-4fb8-8610-159b1eda3cd7","position":{"commit_sha":"9aa63fc1b43a350495091c8dc0e042338680683d","position":"1788131001437769001-3b5e0ce5-f08a-4fb8-8610-159b1eda3cd7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788112384643776064,"creation_channel":"mcp","deps":[{"link_uuid":"b5a19ab7-390f-48e8-b44c-0a46cc246263","relation":"depends_on","target_id":"e0d5-2b29-2814-4421"},{"link_uuid":"062ac3b7-9301-4388-9287-5d29af29f110","relation":"relates_to","target_id":"558d-ab1b-b266-439e"}],"description":"## Problem\n`shim.py::_to_common_finding` (the translation feeding `review_code()`'s public `review_result`\noutput -- the `rebar review-code` CLI and the `review_code` MCP tool) carries `severity`\nforward from each kernel-shaped finding but drops the numeric `priority` (`validity x impact`)\ncomputed by `pass3_decide`. A caller of `review_code()` -- the live, real consumer of this\ntranslation -- sees only the impact-only severity label, never the priority the kernel itself\ndecided BLOCK/ADVISORY with.\n\nCORRECTION to the epic's original problem statement: `aggregate.py::aggregate_findings` (the\n\"cross-finding aggregation/dedup picks the highest-severity representative\" consumer named in\nthe epic) is confirmed DEAD CODE -- it has no caller anywhere in `src/rebar/` (grep confirms\nzero call sites outside its own definition and the `__init__.py` re-export), orphaned since\nADR 0075 retired the single-pass code-review route that used to feed it. The CURRENT four-pass\npipeline's real cross-finding dedup (`_cluster_findings` in `code_review/workflow_ops.py:149`,\nplus `dedup_key`/`suppress_and_dedup` in `review_kernel/decide.py:252`) picks a representative\nby first-in-stable-order, NOT by severity or priority -- so there is no live severity-based\nmisranking bug in the current dedup step, and `aggregate.py` needs no change in this epic.\n(Separately, the Gerrit review-bot comment already reads `priority` directly off the kernel\nverdict via `adapter.py::_translate_findings`, bypassing `shim.py` entirely -- so this ticket's\nfix is specifically for the `review_result`/`review_code()` consumer, not the Gerrit path,\nwhich the sibling ticket patriotic-abdicative-arrowana covers separately.)\n\n## Approach\nThread `priority` AND `decision` through `code_review/shim.py`'s `_to_common_finding` so the\n`review_result` shape `review_code()` returns carries the numeric priority and the\nblock/advisory decision already computed by `pass3_decide` (or set on DET-tier findings by the\nsibling priority-backfill ticket), alongside the existing `severity` field (which is not\nremoved by this ticket -- see the epic's expand-contract sequencing).\n\n## Acceptance Criteria\n- [x] `shim.py::_to_common_finding` includes `priority` AND `decision` in its output dict for\n  every finding, alongside the unchanged existing `severity` key.\n- [x] `pytest tests/unit/test_code_review_ws4.py -k test_shim_translates_kernel_findings_to_common_findings`\n  passes, strengthened with an assertion that the translated common finding carries the same\n  `priority` and `decision` values as the source kernel finding.\n- [x] `src/rebar/llm/aggregate.py` and `src/rebar/llm/spec_scan.py` have zero diff from this\n  ticket (`git diff --stat src/rebar/llm/aggregate.py src/rebar/llm/spec_scan.py` is empty) --\n  both are out of scope (the former is dead code, the latter is a sibling ticket).\n\n## Testing\nTier: in-process unit test against the real `shim.py::_to_common_finding` translation function,\nfed a production-shaped kernel finding dict (contract test: real producer shape -> real\nconsumer). Oracle: the exact `priority`/`decision` values on the translated common finding,\nasserted alongside the existing `severity` assertion. `test_shim_translates_kernel_findings_to_common_findings`\n(test_code_review_ws4.py:180) is the RED oracle to strengthen.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/code_review/shim.py","reason":"thread priority and decision through _to_common_finding for the review_result/review_code() consumer"},{"path":"tests/unit/test_code_review_ws4.py","reason":"strengthen translation test to assert priority/decision"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","e0d5-2b29-2814-4421"],["parent","c4c8-317a-85ca-4b08"],["relates_to","558d-ab1b-b266-439e"]],"no_file_impact_reason":"","parent_id":"c4c8-317a-85ca-4b08","parent_status_uuid":"e27c388e-1f96-4b61-adce-f5a1a35f9d89","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"closed","tags":[],"ticket_id":"ce15-28c5-80e0-49c2","ticket_type":"task","title":"Rank aggregation by priority instead of severity","verify_commands":[]},"source_event_uuids":["1d86ad39-0c90-4066-891e-25f718acc5d5","f74d6c86-de7c-4186-8515-56704c7d65fb","8ee7aa84-f3dd-4e13-95d9-f9ef97b9210f","8dbe545b-73c7-4ae2-8c57-6825cd721e0d","af4c8ca2-d349-4629-8270-3f5192ac21eb","240e5348-3a17-4d07-add6-1badbe2fdc9c","a3475714-f630-47fd-8371-29a142b6a26b","d4abb6ce-62ec-4e8d-927b-4fadb0a57979","f941aacc-50ea-42dd-8183-b32be481249b","062ac3b7-9301-4388-9287-5d29af29f110","fafe50d4-054c-4997-b962-5cd17e862536","e27c388e-1f96-4b61-adce-f5a1a35f9d89","3b5e0ce5-f08a-4fb8-8610-159b1eda3cd7"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788133519310805001,"uuid":"f66efca0-4160-4204-bc5a-c78e815a1247"}