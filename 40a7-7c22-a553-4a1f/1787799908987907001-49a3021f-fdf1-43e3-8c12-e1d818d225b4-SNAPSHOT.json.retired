150e3f2","position":{"commit_sha":"a4dac72e5304e26cbfd9f1ab29f94052de827291","position":"1787770784021672001-8cefba3e-3bfe-4af4-8b1d-8aebe150e3f2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ff15b297e38bcb0deee4092b9d491e8558386478cef2b732d4bd8f98273e5fe9","event_uuid":"7ca2393d-a53e-4381-befc-e06ebd909d5a","position":{"commit_sha":"bbfd61e4b81f172ac3436103cb404ad2fc5c85f9","position":"1787771772410005001-7ca2393d-a53e-4381-befc-e06ebd909d5a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"62773142ce677eae4264641f068c45773637652e61103538c4feb0f49b3c5d0c","event_uuid":"c73aac72-a9f5-4854-bd43-b3eab056d814","position":{"commit_sha":"1dedf7bc316b8057decf8f1723d172c136384d5d","position":"1787771803614991001-c73aac72-a9f5-4854-bd43-b3eab056d814"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d44539eeed32d9652ba1039e491cc3f1a528d1e9f101518c920dcd6ee42e3784","event_uuid":"4957ed4c-f808-4b6d-8429-aa67d2f61053","position":{"commit_sha":"3253e1ebaea01a0174178fca353734e4d7d92116","position":"1787771825462091001-4957ed4c-f808-4b6d-8429-aa67d2f61053"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b809a8ac62853368c9f9c2ecac88ef6faf94fad90f0e3e6f8d8bd4d438ef7beb","event_uuid":"3154d9d3-98df-4ff4-afe7-d93540b5d888","position":{"commit_sha":"8890a62fcbf84f1dbcd955b2d368aad2ca5f135e","position":"1787771880746834001-3154d9d3-98df-4ff4-afe7-d93540b5d888"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"bdda2f3c6c286be5eca16492ce19d2140ed097191b76f32ca3e78723fcb026a8","event_uuid":"921d2f6d-6bb6-4598-b170-f78d5e9ed79c","position":{"commit_sha":"77736ed9afdb1e21af548e243800d52c6278697c","position":"1787771888501664001-921d2f6d-6bb6-4598-b170-f78d5e9ed79c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"not_a_bug","close_reason":"not_a_bug","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Closed not_a_bug by operator decision\n\nThe operator reviewed the investigation and dispositioned this **not a bug**. Closing on that\ndecision, not on new evidence.\n\n**The technical findings in the description are unchanged and were not retracted**, so a future\nreader is not misled about what the code does:\n\n- `_mcp_health.py:217` couples uvicorn's `timeout_graceful_shutdown` to the certified-op grace\n  (1200s), and the runtime experiment (gauge == 0 in both arms; 0.18s with no open stream vs\n  5.39s — the full timeout — with one) shows an open idle stream, not the gauge, pins shutdown.\n- Production matched that prediction to the second: stop at 18:25:08, `die` at 18:45:09 = 1200s.\n- Consequence: an mcp retirement holds one of the two blue/green ports for the full 20 minutes,\n  so a second mcp deploy inside that window hits `AUTODEPLOY_MCP_RETIRE_CAP port-exhausted`\n  (`autodeploy.sh:670-674`) and backs off. It fails SAFE — no collision, live backend untouched.\n\nWhat the not_a_bug disposition settles is the **legitimacy** question the RCA left genuinely\nopen, and which I flagged as the weakest part of the analysis: the comment\n`MCP_STOP_GRACE (1260) >= _mcp_health grace (1200) + margin` shows the author budgeted for a\nfull-length drain, so waiting out an open client session is defensible as intended conservative\nbehaviour rather than a defect. That is an operator/design call, and it has been made.\n\nPractical consequence to be aware of rather than surprised by: mcp deploys are effectively\ncapped at roughly one per 20 minutes whenever a client holds a session. If that ceiling ever\nbecomes a problem in practice, reopen this ticket — the mechanism and its proof are already\nrecorded above, so no re-investigation is needed.\n\nThe originally-reported symptom (\"container Up 2 hours (unhealthy)\") was separately confirmed\nNOT a defect: `docker ps` \"Up\" is uptime since creation, that container was the live backend\nuntil the 18:25 cutover, and the retire completed normally in 21 minutes.","timestamp":1787771772410005001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Removed the `caused_by` -> fd4a-4e91-f179-4932 edge on closing not_a_bug.\n\n`metrics.bug_trends.caused_by_fan_in` counts caused_by links across ALL bugs with no\nclose_class filter, so leaving the edge in place would have counted a not_a_bug ticket as an\nescaped defect against that story and inflated its fan-in. The attribution was correct while\nthis was believed to be a defect; with that verdict reversed it is wrong data.\n\nThe evidence trail is unaffected — the introducing commit (8297083532a3, \"Add rebar-mcp HTTP\nservice to the AWS box\") is still named in the RCA above, so the origin is recoverable by\nreading rather than by a metric edge. If this ticket is ever reopened as a defect, restore the\nlink with: rebar link surreal-horsy-skimmer fd4a-4e91-f179-4932 caused_by","timestamp":1787771888501664001}],"completion_expectation":"disposition","created_at":1787770756746979001,"creation_channel":"cli","deps":[],"description":"## Summary\n\n`run_http_with_grace` sets uvicorn's `timeout_graceful_shutdown` to the SAME value as the\ncertified-op drain grace (`_mcp_health.py:217`, `timeout_graceful_shutdown=int(grace_seconds)`,\n`DEFAULT_SHUTDOWN_GRACE_SECONDS = 1200`). Its own docstring calls that timeout \"a backstop\" —\nbut for a Streamable-HTTP MCP server it is the OPERATIVE timer on every retirement, because a\nconnected MCP client holds a long-lived stream that never closes on its own. uvicorn's graceful\nshutdown waits for that stream until the timeout expires.\n\nThe result: a retiring mcp container ALWAYS takes the full 1200s to exit whenever any client\nholds a session — which, for a dogfooding server that agents connect to, is the normal steady\nstate. The gauge-driven early exit that the design is built around never fires.\n\n## Why this defeats the documented design\n\nThe intended model is explicit in the code:\n\n- `drain_then_exit` (`_mcp_health.py:134-150`): \"Wait (bounded by `grace_seconds`) for the gauge\n  to reach 0 ... **Returns immediately when the gauge is already idle.**\"\n- `make_sigterm_handler` (`:153-178`): stop intake first, \"keeps a newly-arriving op from\n  extending the drain window indefinitely\".\n- `run_http_with_grace` (`:195`): \"`timeout_graceful_shutdown` bounds uvicorn's own drain **as a\n  backstop**.\"\n\nSo the gauge is meant to be the primary bound and uvicorn's timeout the safety net. In practice\nthe safety net governs 100% of the time and the entire gauge apparatus (`InFlightGauge`,\n`instrument_certified_tools`, the `/health` `in_flight` field, `drain_then_exit`'s early return)\nhas no effect on when the process exits.\n\n## Runtime proof (discriminating experiment)\n\nA minimal uvicorn app with `timeout_graceful_shutdown=5`, an endless streaming route, and\n**gauge == 0 in both arms** (no certified op anywhere):\n\n```\nNO open stream   -> exited in   0.18s\nONE open stream  -> exited in   5.39s     <- the full timeout\nuvicorn: \"Cancel 1 running task(s), timeout graceful shutdown exceeded\"\n```\n\nThis discriminates against the rival hypothesis (a leaked in-flight gauge): the gauge was zero\nand the wait happened anyway. It is the open connection, not the gauge, that pins the shutdown.\n\n## Production evidence, matching the prediction to the second\n\nContainer `rebar-mcp-1efc5ebb57dd-8092` on `i-00880b2c7f13527c5` (2026-08-26):\n\n| event | time |\n|---|---|\n| first `docker stop --time 1260` issued | 18:25:08 |\n| container `die` | 18:45:09 |\n| reaped by the next tick | 18:46:24 |\n\n18:45:09 - 18:25:08 = **1200s exactly** = `DEFAULT_SHUTDOWN_GRACE_SECONDS`, not the 1260s docker\ndeadline. The process burned its own full grace and exited a second after it expired.\n\nCorroborating: `docker events` shows SIGTERM (`signal=15`) delivered **7 times**, once per\n~2-minute autodeploy tick (deltas 130/129/121/120/121/129s) — each tick re-issues the stop via\n`mcp_retire_graceful` with no already-stopping guard. These are harmless (each merely re-sets\n`should_exit`) and notably did NOT reset the drain deadline, which is what pins the cause to the\nfirst SIGTERM's uvicorn timeout rather than to handler re-entry.\n\n## Impact: a hard ceiling of ~one mcp deploy per 20 minutes\n\nThe blue/green pool is exactly two host ports (`autodeploy.sh:129`, 8092/8093; 8091 reserved).\nThe live container permanently holds one. A retiring container now holds the other for a full\n20 minutes. So a second mcp deploy inside that window finds no free port:\n\n`autodeploy.sh:670-674` — `mcp_free_port` returns empty, and the deploy emits\n`AUTODEPLOY_MCP_RETIRE_CAP port-exhausted`, records backoff, and exits 1.\n\nIt fails SAFE (no port collision, live backend untouched), so this is a throughput defect, not a\ncorrectness or availability one. But it caps mcp deploys at roughly one per 20 minutes, and it\ndoes so for a wait that the design intended to be near-instant when no certified op is running.\n\n## Not the reported symptom\n\nFiled after investigating \"container Up 2 hours (unhealthy)\". That framing was wrong and is NOT\na defect: `docker ps` \"Up\" reports total uptime since creation, and that container was the LIVE\nbackend for ~1h45m before the 18:25 cutover. The \"unhealthy\" flag is also expected — SIGTERM\nstops intake, so the healthcheck is refused for the rest of the drain. Only the 1200s-always\ndrain underneath is a real defect.\n\n## Acceptance criteria\n\n- [ ] A retiring mcp process with `gauge == 0` exits promptly (seconds, not the full grace) even\n      while a client holds an open streamable-HTTP session.\n- [ ] An in-flight CERTIFIED op still delays exit up to the grace bound — the drain guarantee\n      that `mcp_retire_graceful` and ADR 0079 depend on is preserved, not traded away.\n- [ ] A regression test pins the distinction (open-but-idle stream => prompt exit; in-flight\n      certified op => waits), failing if `timeout_graceful_shutdown` is re-coupled to\n      `grace_seconds`.\n- [ ] Deploying mcp twice inside one drain window no longer emits `port-exhausted`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"c73aac72-a9f5-4854-bd43-b3eab056d814","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"40a7-7c22-a553-4a1f","ticket_type":"bug","title":"mcp retirement always burns the full 1200s drain: uvicorn timeout_graceful_shutdown is coupled to the certified-op grace","verify_commands":[]},"source_event_uuids":["a1c27567-22fa-4c93-b79c-439c472e9eea","8cefba3e-3bfe-4af4-8b1d-8aebe150e3f2","7ca2393d-a53e-4381-befc-e06ebd909d5a","c73aac72-a9f5-4854-bd43-b3eab056d814","4957ed4c-f808-4b6d-8429-aa67d2f61053","3154d9d3-98df-4ff4-afe7-d93540b5d888","921d2f6d-6bb6-4598-b170-f78d5e9ed79c"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787799908987907001,"uuid":"49a3021f-fdf1-43e3-8c12-e1d818d225b4"}