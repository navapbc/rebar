6b-8478-4420-8b64-289afcc9f493","position":{"commit_sha":"7489061544c585f5b4dcddca7c0cdb4f5f814d5f","position":"1788287459520767669-8c2cbb6b-8478-4420-8b64-289afcc9f493"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3d18c07d0d6e653e7e3823c27956eef179e9de99ca4eb34a6fbc848d8ec3b75a","event_uuid":"1b9db500-4e4f-465e-8c07-4146075d5874","position":{"commit_sha":"4dddfb66530e1a0bc54a6512a9155fb8fd8aeb73","position":"1788288894742345353-1b9db500-4e4f-465e-8c07-4146075d5874"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"34233f67550478175d2cd39baf34b1d4922ec5f4d3329d64617cd3460460119d","event_uuid":"5c6d9743-2da0-4311-8e88-4a8b81f03e1f","position":{"commit_sha":"1d09daef6752d8087c359a655098e5b821b8872d","position":"1788290568555900518-5c6d9743-2da0-4311-8e88-4a8b81f03e1f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a1fc4bef85b4b42093074115b82ec9d698e8f1dc9a511cc77989cbf00260275d","event_uuid":"7bd1b5b0-a420-4a94-9b78-74f18dcb830f","position":{"commit_sha":"410ed1091d2d477e882cca7fb5b7b90afb140db0","position":"1788294354379155878-7bd1b5b0-a420-4a94-9b78-74f18dcb830f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ca68d8cf3929b4dc7a39df9cc9e0a6d2059480f6fa114e599aa5f1bd7e690ae2","event_uuid":"f7f67a11-1d47-4262-b4b0-46d0d301ef35","position":{"commit_sha":"40eb7978e17b3593a241dfb2c1e37728edf0ecf4","position":"1788296099023837021-f7f67a11-1d47-4262-b4b0-46d0d301ef35"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ba40948088a2a71e1ad979cb1c8017cb0f6b2203d9775e39a4d46513df1ac58e","event_uuid":"ceaafe96-d5db-44bc-a286-1caeb3e82210","position":{"commit_sha":"0e334a3a3775d2c7e9f1459dd5985dff4e3b76ec","position":"1788296716672603912-ceaafe96-d5db-44bc-a286-1caeb3e82210"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d841c9506128eaa9e1c4726e6a0d46b82a0822927d91bb205cc6c8792b9a787c","event_uuid":"75d02090-0dc7-48df-b32a-820aa8c7fd3a","position":{"commit_sha":"0e334a3a3775d2c7e9f1459dd5985dff4e3b76ec","position":"1788296716783016432-75d02090-0dc7-48df-b32a-820aa8c7fd3a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"not_a_bug","close_reason":"not_a_bug","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Closed not_a_bug by operator decision\n\nThe operator reviewed the investigation and dispositioned this **not a bug**. Closing on that\ndecision, not on new evidence.\n\n**The technical findings in the description are unchanged and were not retracted**, so a future\nreader is not misled about what the code does:\n\n- `_mcp_health.py:217` couples uvicorn's `timeout_graceful_shutdown` to the certified-op grace\n  (1200s), and the runtime experiment (gauge == 0 in both arms; 0.18s with no open stream vs\n  5.39s — the full timeout — with one) shows an open idle stream, not the gauge, pins shutdown.\n- Production matched that prediction to the second: stop at 18:25:08, `die` at 18:45:09 = 1200s.\n- Consequence: an mcp retirement holds one of the two blue/green ports for the full 20 minutes,\n  so a second mcp deploy inside that window hits `AUTODEPLOY_MCP_RETIRE_CAP port-exhausted`\n  (`autodeploy.sh:670-674`) and backs off. It fails SAFE — no collision, live backend untouched.\n\nWhat the not_a_bug disposition settles is the **legitimacy** question the RCA left genuinely\nopen, and which I flagged as the weakest part of the analysis: the comment\n`MCP_STOP_GRACE (1260) >= _mcp_health grace (1200) + margin` shows the author budgeted for a\nfull-length drain, so waiting out an open client session is defensible as intended conservative\nbehaviour rather than a defect. That is an operator/design call, and it has been made.\n\nPractical consequence to be aware of rather than surprised by: mcp deploys are effectively\ncapped at roughly one per 20 minutes whenever a client holds a session. If that ceiling ever\nbecomes a problem in practice, reopen this ticket — the mechanism and its proof are already\nrecorded above, so no re-investigation is needed.\n\nThe originally-reported symptom (\"container Up 2 hours (unhealthy)\") was separately confirmed\nNOT a defect: `docker ps` \"Up\" is uptime since creation, that container was the live backend\nuntil the 18:25 cutover, and the retire completed normally in 21 minutes.","timestamp":1787771772410005001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Removed the `caused_by` -> fd4a-4e91-f179-4932 edge on closing not_a_bug.\n\n`metrics.bug_trends.caused_by_fan_in` counts caused_by links across ALL bugs with no\nclose_class filter, so leaving the edge in place would have counted a not_a_bug ticket as an\nescaped defect against that story and inflated its fan-in. The attribution was correct while\nthis was believed to be a defect; with that verdict reversed it is wrong data.\n\nThe evidence trail is unaffected — the introducing commit (8297083532a3, \"Add rebar-mcp HTTP\nservice to the AWS box\") is still named in the RCA above, so the origin is recoverable by\nreading rather than by a metric edge. If this ticket is ever reopened as a defect, restore the\nlink with: rebar link surreal-horsy-skimmer fd4a-4e91-f179-4932 caused_by","timestamp":1787771888501664001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Reopened (operator-approved 2026-08-30): the documented reopen condition (\"reopen if the 2-port/long-drain ceiling ever becomes a problem in practice\") is now proven met by incident 2f46 (`beton-naval-eyas`). In-window: deploy_errors ×11 + mcp-retire-cap ×11 from a landing burst (14 MCP + 142 bot redeploys) hitting port-exhaustion, because uvicorn `timeout_graceful_shutdown` is coupled to the 1200s certified-op grace (`_mcp_health.py:743`) so a retiring MCP container holds a rotation port ~20 min even at 0 in-flight, and there are only 2 ports.\n\nRemediation approved (fixes 1+3; capacity Option 2 deferred): (1) decouple graceful-shutdown from the certified-op grace so a container fast-drains at 0 in-flight; (3) distinguish \"bot mid-redeploy\" from \"bot wedged\" before the drain-gate fail-opens (mechanism 2: `bot_in_flight_reviews()` returned -1 on an unreachable /health during the bot's own redeploy). The fix is being driven under bug 2f46 (proven Phase-1; relates_to this ticket). This ticket tracks the design-limitation record.","timestamp":1788144304859095413},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## DECISION NEEDED — decouple uvicorn's shutdown timeout from the 1200s certified-op drain grace\n\n**The coupling.** `run_http_with_grace` sets uvicorn's `timeout_graceful_shutdown` to the SAME value as the certified-op drain grace (`_mcp_health.py:217`, `= int(grace_seconds)`, `DEFAULT_SHUTDOWN_GRACE_SECONDS = 1200`). For a Streamable-HTTP MCP server a connected client holds a long-lived stream that never closes on its own, so uvicorn waits the full **1200s on every retirement** — and the gauge-driven early exit (`drain_then_exit`, \"returns immediately when the gauge is idle\", `:134-150`) never fires. The entire `InFlightGauge` apparatus (ADR 0068) is dead in practice.\n\n**The design already intends two separate roles.** The code comments call the gauge the \"primary bound\" and uvicorn's timeout \"a backstop\" (`:195`); **ADR 0067 (review-bot-bounded-shutdown)** and **ADR 0069 (bounded-deferral)** establish stop-intake + bounded drain as the model, not one long timer.\n\n**OSS grounding.** Kubernetes separates `terminationGracePeriodSeconds` (a hard backstop that force-kills) from the `preStop` drain hook (the app's own, usually shorter, deadline); uvicorn's own docs describe `timeout_graceful_shutdown` as a backstop, not the primary drain.\n\n**Recommendation:** Give uvicorn a short backstop (e.g. 30-60s) and keep 1200s as the certified-op drain deadline enforced by `drain_then_exit`; have the SIGTERM handler stop intake and proactively close IDLE streams so the gauge — not the transport — drives exit. Net: an idle-gauge retirement exits in seconds; a busy one still gets the full certified-op grace. Behavior change → your ruling before I dispatch it.","timestamp":1788226557873741001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Resume state after connection restore (2026-09-01 13:24 PT): worktree `/Users/joeoakhart/impl-40a7-drain` is clean at `origin/main` (`1c8232b0ee4e Batch enrichment finalize writes`), no code WIP to commit, ticket remains `open` and unclaimed, plan-review attestation is currently unsigned, no Gerrit change has been pushed for 40a7 yet, and therefore no LLM-Review/Verified votes exist for this change yet. Continuing with plan-review gate, claim, implementation, Gerrit landing, then close. No force used.","timestamp":1788294354379155878}],"completion_expectation":"disposition","created_at":1787770756746979001,"creation_channel":"cli","deps":[{"link_uuid":"c18bee65-75fc-4977-980e-bac7a24eff87","relation":"relates_to","target_id":"2f46-6871-796f-41c9"},{"link_uuid":"48d84c8b-e566-4ba6-bc78-aeb4a3bbe850","relation":"relates_to","target_id":"59a7-cb88-f2f9-4148"}],"description":"## Summary\n\nCurrent `origin/main` already contains the bug-2f46 core decoupling: `run_http_with_grace` drives certified-op drain through `InFlightGauge`/`drain_then_exit` and gives uvicorn a separate short graceful-shutdown timeout. This ticket closes the approved 2026-09-01 DECISION by making that separation explicit and durable for the parentless 40a7 bug: name the uvicorn timer as a transport backstop, set its concrete default to 30 seconds, preserve compatibility for existing callers, and add direct tests for the two shutdown directions the incident requires.\n\nThe certified-op drain grace remains `DEFAULT_SHUTDOWN_GRACE_SECONDS = 1200`. That value is the primary drain deadline for in-flight certified ops and is enforced by `drain_then_exit`; it is not uvicorn's `timeout_graceful_shutdown`.\n\nDeadline-elapse disposition: if the certified-op drain deadline expires while the gauge is still busy, the retiring process sets `server.should_exit`; uvicorn begins graceful shutdown and the in-flight client receives the terminal shutdown/connection disposition from the transport. That is distinct from the idle path, where `should_exit` is set only after the gauge is already idle and uvicorn's short backstop sweeps idle held-open streams.\n\n## Acceptance Criteria\n\n- [ ] `src/rebar/_mcp_health.py` exports `DEFAULT_UVICORN_BACKSTOP_SECONDS = 30` as the named uvicorn transport backstop.\n- [ ] Existing imports of `DEFAULT_UVICORN_GRACEFUL_SECONDS` remain compatible as an alias for the new backstop constant.\n- [ ] `run_http_with_grace` passes uvicorn `timeout_graceful_shutdown=int(uvicorn_backstop_seconds)` instead of using the certified-op `grace_seconds` value.\n- [ ] `run_http_with_grace` preserves the existing keyword `uvicorn_graceful_seconds` as a backward-compatible override for callers while documenting `uvicorn_backstop_seconds` as the preferred name.\n- [ ] `drain_then_exit` still uses `grace_seconds` as the certified-op drain deadline.\n- [ ] The SIGTERM handler calls `gauge.begin_draining()` immediately when retirement starts.\n- [ ] The SIGTERM handler sets `server.should_exit` only after the gauge is idle or the certified-op drain deadline elapses.\n- [ ] An idle-gauge retirement test proves `server.should_exit` is set immediately/quickly with `grace_seconds=1200`, demonstrating the early-exit path is well under the certified-op grace.\n- [ ] A busy-gauge retirement test injects a small `grace_seconds` and a shorter uvicorn backstop value and proves `server.should_exit` is not set until the gauge drains or the injected certified-op deadline elapses, so the short uvicorn backstop does not cut short an in-flight certified op.\n- [ ] The change is self-contained in in-process MCP shutdown logic and does not depend on any CI provider or deployment-specific external service.\n\n## Testing\n\n- Focused: `env PATH=\"$PWD/.venv/bin:$PATH\" pytest tests/interfaces/facades/test_mcp_http_transport.py -k \"mcp_retirement or run_http_with_grace or drain_then_exit or sigterm\"`\n- Lint: `env PATH=\"$PWD/.venv/bin:$PATH\" make lint`\n- Typecheck: `env PATH=\"$PWD/.venv/bin:$PATH\" make typecheck`\n- Gerrit: land only after `LLM-Review +1`, `Verified +1`, and no unresolved comments.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_mcp_health.py","reason":"Holds exported shutdown constants and public re-exports for the MCP HTTP drain/backstop behavior."},{"path":"src/rebar/_mcp_serving.py","reason":"Contains run_http_with_grace, make_sigterm_handler, and drain_then_exit shutdown wiring."},{"path":"tests/interfaces/facades/test_mcp_http_transport.py","reason":"Adds/updates held-out behavioral tests for idle fast exit and busy full certified-op drain semantics."}],"file_impact_scope":"paths","keyring":[],"last_reopened_at":1788144260090475656,"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","2f46-6871-796f-41c9"],["relates_to","59a7-cb88-f2f9-4148"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ceaafe96-d5db-44bc-a286-1caeb3e82210","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"40a7-7c22-a553-4a1f","ticket_type":"bug","title":"mcp retirement should codify a short uvicorn backstop separate from certified-op drain grace","verify_commands":[]},"source_event_uuids":["c18bee65-75fc-4977-980e-bac7a24eff87","7718d0fc-6083-4832-aed2-86b3c35f7cff","38ae9454-ca55-440e-92df-1186f1f73595","190018a9-50ce-4ecd-830a-40014c6751fd","48d84c8b-e566-4ba6-bc78-aeb4a3bbe850","f74688e6-0a04-47c8-838d-574442005932","8c2cbb6b-8478-4420-8b64-289afcc9f493","1b9db500-4e4f-465e-8c07-4146075d5874","5c6d9743-2da0-4311-8e88-4a8b81f03e1f","7bd1b5b0-a420-4a94-9b78-74f18dcb830f","f7f67a11-1d47-4262-b4b0-46d0d301ef35","ceaafe96-d5db-44bc-a286-1caeb3e82210","75d02090-0dc7-48df-b32a-820aa8c7fd3a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788306197601179001,"uuid":"d6168341-69b1-44b1-880c-e11f4d52c803"}