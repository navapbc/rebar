{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788306197601179001,"compiled_state":{"alias":"surreal-horsy-skimmer","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"4f953e7c3b935f3b9ed213dbb388eaf4f3a9e964","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: DISPOSITION not_a_bug","disposition: not_a_bug reason: not_a_bug","ticket: 40a7-7c22-a553-4a1f","model: none (deterministic disposition)","runner: close_disposition","rebar-version: 0.12.0 (4f953e7c3b93-dirty)","material: fc9de2e3831ed899"],"material_fingerprint":"fc9de2e3831ed899","merged_log_commit":"4f953e7c3b935f3b9ed213dbb388eaf4f3a9e964","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787771825444655000},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65\", \"sig\": \"\"}]}","head_sha":"f1dd41a8f09967dd60c7aefb5e43c6f62fa119af","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 40a7-7c22-a553-4a1f","material: 816c198e16400787","material-part: children 647ea2107ca5072f 0","material-part: description 735688fbb76091e4 3202","material-part: description_boxes e91772ccb5e6ce5f 0","material-part: file_impact 7e9d6479a5435c3b 3","material-part: ticket_id 0e1b8f796aa93c5c 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 5","review-phase: planning","rebar-version: 0.13.1","regver: aa61189569d34126","verified-at-sha:1c8232b0ee4e943f021cb51b63d16656e7f4df0e","dep b0ecd3536fe6a2c925f9e115d96cb96dd0de01d786a5cf23fb4752d8a9492f38 src/rebar/_mcp_health.py","dep a5f223db8d459c48b3086d1b7a49bc6510f4dce25a542590d4a60591ad491126 src/rebar/_mcp_serving.py","dep 97880fef0520555ee28355679aad6f8910318883630cd499c5ad9a8cfe9c7923 tests/interfaces/facades/test_mcp_http_transport.py","read-set: 3","read-path: src/rebar/_mcp_health.py","read-path: src/rebar/_mcp_serving.py","read-path: tests/interfaces/facades/test_mcp_http_transport.py","currency-basis: file_impact"],"material_fingerprint":"816c198e16400787","merged_log_commit":"1c8232b0ee4e943f021cb51b63d16656e7f4df0e","principal":"9f1c8e42-7a3b-4d5e-b6c1-2f0a9d8e7c65","signature":null,"signed_at":1788296099020439268}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":20,"unsigned":0},"authorship_ledger":[{"content_hash":"5d4ac129edad10901948f5869c24475e7c90bf42f17f20d44a0a0eabfe300c14","event_uuid":"c18bee65-75fc-4977-980e-bac7a24eff87","position":{"commit_sha":"3593d80b1a644199eeeaac66b1cd526a54ff33f6","position":"1788143570078995964-c18bee65-75fc-4977-980e-bac7a24eff87"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d6f58f09a02e7c12d6b8a63f97a51da33e5a7eea9749dce2b015560bdfb2ba3a","event_uuid":"7718d0fc-6083-4832-aed2-86b3c35f7cff","position":{"commit_sha":"9461503f9e400679906fb41d2e1ea66ffa73d448","position":"1788144260090475656-7718d0fc-6083-4832-aed2-86b3c35f7cff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a2a92b89402aa645b9fe8010f8d220c981df0efd24469faef51a99c5f