{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787393669470078001,"compiled_state":{"alias":"tireless-convenable-canvasback","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"f9bf9dee0fd6ceeb95c63f299f6190810e3c6d7c","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 4144-75d3-6af1-47d3","material: ccc34f0853b817a6","material-part: children 647ea2107ca5072f 0","material-part: description a83a672d332daa11 7261","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact 002e60d6bfd22f9a 2","material-part: ticket_id e3df23c52e8d8c89 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (f9bf9dee0f-dirty)","regver: aa61189569d34126","verified-at-sha:8e0340a24da14a4b4bef7fe6000ba720d6f5f56b","dep bd3f0805dfc309ef30f3c191c871b8c3d19459283400dd4bd609dc753d187a48 src/rebar/llm/overlap/queue.py","dep 48f38363a2857cd178cd128b1435c1b18edb6593e2793834a994ea934b16ac48 tests/unit/test_enrich_queue.py","read-set: 2","read-path: src/rebar/llm/overlap/queue.py","read-path: tests/unit/test_enrich_queue.py","currency-basis: file_impact"],"material_fingerprint":"ccc34f0853b817a6","merged_log_commit":"8e0340a24da14a4b4bef7fe6000ba720d6f5f56b","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787389626524651000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"642086c36354ccc1a7711191a860d55616af29c4aa01992b530f4ee029a53c99","event_uuid":"62bc0e17-d6f8-491a-9933-6c25447d6897","position":{"commit_sha":"325887ff9ef62fff7e418ac3a060e237b59ad2c0","position":"1787333906180406001-62bc0e17-d6f8-491a-9933-6c25447d6897"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2fc022dae1c65d728248f8a2e3eb925074c8d91203f054275fd5a08b37599b95","event_uuid":"553fde60-09aa-4ae9-b0ac-ada746885973","position":{"commit_sha":"e6e01225a3df6ac0e33120787ead68f48220b7fd","position":"1787333914594658001-553fde60-09aa-4ae9-b0ac-ada746885973"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"497023880d2485e2ebbb0190d5ae844c9e2751cb58700d3f14b36fb0d0323ba2","event_uuid":"735cc319-d9ee-42fb-80de-8afe91b745af","position":{"commit_sha":"f1a8d4e88ba287efd2003ce1105cbfc45dbf0116","position":"1787386033319849001-735cc319-d9ee-42fb-80de-8afe91b745af"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"758889c59b65b0a76eb2f48ee03f4307a0c9bb104f344daeb0df9bbf56173134","event_uuid":"b225f86f-0cb3-428c-b3ab-c1712cfe7527","position":{"commit_sha":"be88acbed49ce24a95237ac3e8ba23668b1c211c","position":"1787386053099315001-b225f86f-0cb3-428c-b3ab-c1712cfe7527"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"9d5892002abba97b6135c5e3983961d77b7fc5bec4c324bdad4ecc7a954758f4","event_uuid":"6fe30587-7dd6-4717-90ce-be72cfc8f747","position":{"commit_sha":"d65a313a40adbe25afe340d56150540f34875411","position":"1787387677939764001-6fe30587-7dd6-4717-90ce-be72cfc8f747"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ca63491c84c95a35b01cca1d0dc61a3428c8adee441cbd20e51ea506da1fb5bc","event_uuid":"60d74b2b-5866-484b-ad75-e12b0585ba11","position":{"commit_sha":"5c5a330171a3925e2219fd17a34b1caa1613875f","position":"1787387702817941001-60d74b2b-5866-484b-ad75-e12b0585ba11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"31c94b68a0c8e519cf06e4b2cb0631cc7091da25b51cd90b5547f348465c0840","event_uuid":"1752c59d-792a-4659-9ce0-5688e20448a7","position":{"commit_sha":"ef3a15acadc78997df73141fe494acb71e00ba31","position":"1787388521619524001-1752c59d-792a-4659-9ce0-5688e20448a7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2886662f44285ac9f1aabf9b088c9c7f313bf04f97af4f09dcb0a826a50a4e99","event_uuid":"3401784a-e4bf-4079-b636-d090865f206c","position":{"commit_sha":"bb700a43c337a2dca82d3bf08182aaa7444cf0ad","position":"1787389066886095001-3401784a-e4bf-4079-b636-d090865f206c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6b55db2446d473c036c07c4b677382fc7abbb100fb6709dd68620609723474d9","event_uuid":"cfc77a35-f78f-4b8b-98c2-10122003a518","position":{"commit_sha":"8a49a4ffbf70c0dceaf4517fcb53c85eb55f6bb0","position":"1787389626687977001-cfc77a35-f78f-4b8b-98c2-10122003a518"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"33b25316b3aec83e029a70ddbe1dc05ea9abef3fa66c01a0f9e18539e3af5f70","event_uuid":"f9a8381e-ab38-4c3e-9d6e-ceb3c8020128","position":{"commit_sha":"584f008b6b1f0123e7350185a3d10136c230022d","position":"1787389677341073001-f9a8381e-ab38-4c3e-9d6e-ceb3c8020128"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"34d094310f048aa0cb1442e8c489c6df3d5059d9ba735ad044c4de2e8a79b42f","event_uuid":"ccf5e5d3-ed68-49ae-baf9-192b2f6bbfb0","position":{"commit_sha":"584f008b6b1f0123e7350185a3d10136c230022d","position":"1787389682873033001-ccf5e5d3-ed68-49ae-baf9-192b2f6bbfb0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"aa4cac462b92099100eb072a13555222ee8b6720cef2cc14ce3fc5d553e6ff01","event_uuid":"badfb698-2dd1-4321-af68-5da16a2b716a","position":{"commit_sha":"50188271067fa9bcbf95d313da9121c4af239857","position":"1787391078173621001-badfb698-2dd1-4321-af68-5da16a2b716a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Reclassified bug -> task: self-conceded cost/design improvement, not a violated contract\n\nThis ticket's own scope note concedes the classification: story `c1de-d6a0-6cef-4135`'s AC scopes the 20 ms budget to the QUIET case (\"`maybe_drain` no-ops with no spawn **when nothing soaked**, within `DRAIN_GATE_BUDGET_MS` (20 ms)\"), and the ticket text itself concludes \"A gate that finds a real backlog is not on that no-op path, so this is a **cost/design** improvement, not a violated contract — size it accordingly.\" The marker's all-or-nothing write is also exactly what f400's open question #3 sketches as a DESIGN change wanting a plan and review, not a drive-by patch.\n\nNo documented contract is violated by the current behaviour, so this is task-shaped work (a designed improvement with a plan-review), not a defect. The measurements and ACs remain valid and unchanged. Type changed bug -> task; nothing else edited.","timestamp":1787333914594658001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Narration moved out of the description for review admission (P4 oversize):\n\n## Why this is filed separately\n\nFound while debugging `f400-987f-45f6-419a` (\"deep enrichment backlog starves late entries\").\nThat bug's mechanism is the **selection order** (an id-sorted prefix); this one is the **marker's\nall-or-nothing design**. They share a precondition (a non-empty pending set) but are distinct\nmechanisms, proven by the table above: fixing fairness lets *that* store's backlog drain to\nempty, which restores the marker there, but it does not help any store that keeps one entry\npending. Folding a marker redesign into a bug fix would exceed that bug's authorised scope, so\nit is recorded here instead.\n\n## Scope note (read before implementing)\n\n`958e`'s own block comment (`queue.py:232-254`) enumerates three accepted failure modes and all\nthree are the marker wrongly saying *quiet*. The branch that never writes the marker at all is\nimplemented but discussed nowhere — not in the comment, not in the commit message, and not in\nany of the 9 marker tests, every one of which seeds a store whose pending set becomes empty.\n\nNote also that story `c1de-d6a0-6cef-4135`'s AC scopes the budget to the quiet case: *\"`maybe_drain`\nno-ops with no spawn **when nothing soaked**, within `DRAIN_GATE_BUDGET_MS` (20 ms)\"*. A gate that\nfinds a real backlog is not on that no-op path, so this is a **cost/design** improvement, not a\nviolated contract — size it accordingly.\n\n`f400`'s open question #3 sketches the candidate direction: record \"nothing pending BEFORE\nindex N\" rather than all-or-nothing. That is a **design change**, so it wants a plan and a\nreview, not a drive-by patch.","timestamp":1787387677939764001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented the live-set marker: the full scan now ALWAYS writes .rebar/enrich-gate.json, adding a 'live' field (ids with an enqueued, not-DONE entry). A TTL-fresh marker that cannot prove quiet scopes the walk to reducing only the live entries (O(backlog), not O(store)); scoped probes never rewrite the marker so the TTL still counts from the last FULL walk. The scan loop incl. the f400 (not_before_ns, id) service-order sort is extracted into one _scan_pending helper shared by both paths; _gate_marker_says_quiet was inlined into pending_enrichment and deleted (no other callers, grep-confirmed). Honesty rules preserved: marker only asserts absence (whole-store or outside-live-set); every append still clears it; wrong-typed live distrusts the whole marker. 6 new tests (RED-first: standing-backlog syscall pin at store sizes 4/40, new-enqueue visibility, TTL non-refresh, live-field validation, soak-expiry via scoped path, service-order parity); all 34 queue tests + 237 enrich/drain/overlap tests pass; make lint, typecheck, complexity ratchet (new=0 increased=0) green. queue.py at 492 LOC.","timestamp":1787391078173621001}],"created_at":1787312653860522001,"creation_channel":"cli","deps":[{"link_uuid":"2a892a1e-7c7a-4ed4-b434-bc77a1bee77d","relation":"discovered_from","target_id":"f400-987f-45f6-419a"},{"link_uuid":"8f40ecdb-2174-46f2-ad6b-6fa4e18f061f","relation":"relates_to","target_id":"958e-f4b3-275c-4154"}],"description":"## Context / Problem\n\n`958e-f4b3-275c-4154` made the write-path drain gate O(1) on a **quiet** store by caching\n\"nothing can be pending before T\" in `.rebar/enrich-gate.json`. The marker is only ever\n*written* on a scan that found nothing:\n\n```python\n# src/rebar/llm/overlap/queue.py:374-377\nif out:\n    _clear_gate_marker(tracker)\nelse:\n    _write_gate_marker(tracker, now_ns, soonest)\n```\n\nSo a **single** pending entry is enough to disable the fast path for the entire store, and every\nsubsequent write pays a full walk of every ticket directory until the pending set empties again.\n\n## Measured (2026-08-21, synthetic stores, marker forced cold)\n\n| store size | pending | gate ms |\n|---|---|---|\n| 1000 | 1 | 116.9 |\n| 1000 | 500 | 157.1 |\n| 1000 | 1000 | 206.5 |\n| 4000 | 1 | 560.3 |\n| 4000 | 500 | 572.3 |\n| 4000 | 0 | cold 525.7, **warm 0.110** |\n\n- Cost is **linear in store size** (x4 tickets -> x3.6-4.8) and only weakly sensitive to backlog\n  depth (x500 depth -> x1.34; x1000 -> x1.77).\n- **Depth 1 already costs the full scan.** The trigger is binary, not proportional.\n- The marker, when it engages, is ~4,800x faster (0.110 ms vs 525.7 ms).\n\nOn the live 4,938-ticket store this is 1,200-1,330 ms per write.\n\n## Approach\n\nGeneralize the gate marker from \"the whole store is quiet\" to \"everything OUTSIDE this\nrecorded live set is quiet\" — the set-valued form of f400's open question #3 (\"nothing\npending before index N\", but keyed on the queue's real membership rather than a sort\nboundary). Concretely:\n\n- `_write_gate_marker` records a third field, `live`: the ticket ids that had a live queue\n  entry (enqueued, no later DONE) when the full scan ran. The full scan now ALWAYS writes\n  the marker — the `if out: _clear_gate_marker(...)` branch (queue.py:374-377) goes away.\n  With a non-empty pending set, `next_eligible_ns` is <= now by construction (a pending\n  entry's eligible instant is its soak deadline, already past), so the marker never claims\n  quiet for a noisy store.\n- `_read_gate_marker` validates `live` (a list of strings, or absent/None from an older\n  marker) and reports the whole marker untrusted on any wrong type, exactly like the\n  existing fields — untrusted degrades to the full scan, the pre-existing behaviour.\n- `pending_enrichment` gains a middle path: a TTL-fresh, non-future marker that does not\n  prove quiet but carries a `live` list scopes the walk to reducing ONLY those tickets\n  (`reduce_ticket` per live id — real per-entry reductions, so time-driven transitions:\n  soak deadlines passing and leases expiring are still answered honestly). The full\n  `os.listdir` walk remains the fallback for no/untrusted/expired markers. The per-entry\n  scan loop — including the f400 `(not_before_ns, ticket id)` service-order sort — is\n  extracted into ONE helper that both the full walk and the scoped walk call, so the scoped\n  path returns exactly the order the full walk would for the same store state (the sort key\n  IS the drain service order; f400's starvation fix must hold in precisely this backlog\n  regime), and no function crosses the McCabe ceiling.\n- Scoped probes do NOT rewrite the marker. Within a marker's lifetime the live set cannot\n  grow (every queue append still clears the marker — rule 2 unchanged), and NOT refreshing\n  `written_ns` preserves rule 3: the TTL still bounds the time since the last FULL walk, so\n  the accepted append-during-scan race keeps exactly today's bound.\n\nHonesty analysis (rule 1): the marker still only ever asserts ABSENCE of pending work — a\nquiet store, or quiet-outside-the-live-set. Pending verdicts always come from reducing real\nqueue events; a stale or wrong marker can defer a drain (TTL-bounded, as today) but can\nnever manufacture a pending ticket. The three-rule block comment (queue.py:232-254) is\nupdated to document the live-set form and the previously undocumented never-writes branch's\nreplacement.\n\nCost: a probe on a store with a standing backlog drops from O(store) (full walk, ~1.2 s at\n4,938 tickets) to O(live set) reductions; the quiet fast path stays O(1). This preserves\nc1de's quiet-case 20 ms budget scope; the noisy-case cost now scales with the backlog, not\nthe store.\n\n## Scope\n\n- `src/rebar/llm/overlap/queue.py` — marker read/write/validation (`_read_gate_marker`'s\n  widened return tuple, updating its other caller `_gate_marker_says_quiet`'s unpack),\n  `pending_enrichment` scoped-scan path + extracted scan helper, block-comment update.\n- `tests/unit/test_enrich_queue.py` — new tests below; the 9 existing marker tests must\n  pass unchanged (they pin the quiet path, TTL, invalidation, and corruption handling).\n\nNo other module changes: `enrich_drain.maybe_drain` and `drain` consume\n`pending_enrichment` unchanged; the marker file name, location (`.rebar` sidecar via\n`StorePaths`), TTL constant, and clear-on-append call sites are untouched.\n\n## Testing\n\nRED first (fails on current code), all counted by instrumenting `reduce_ticket`\n(`_count_reductions`), never wall clock (`check_wall_clock_asserts`):\n\n- A store with a PERMANENTLY non-empty pending set (one eligible entry that is never\n  claimed or done), parametrized over store sizes 4 and 40: after one cold scan, a repeat\n  probe reduces exactly the live entries (1), independent of store size, and still returns\n  the pending id. (RED: current code clears the marker and reduces all N every probe.)\n- New-enqueue visibility through the scoped path: with a backlog marker standing, enqueue a\n  second ticket with soak 0 — the append clears the marker, and the next probe returns both\n  ids (never hides the newcomer behind the live set).\n- TTL still bounds the scoped path: scoped probes do not refresh `written_ns` — a probe\n  past the TTL performs a full walk again (reduction count == store size, and the marker is\n  re-established by that walk).\n- `live`-field validation: a marker whose `live` is wrong-typed (a string; a list with a\n  non-string) is untrusted and degrades to the full scan, still returning the pending id.\n- Time-driven transitions through the scoped path: a soaking live entry becomes pending\n  once its deadline passes, and a claimed live entry becomes reclaimable at lease expiry,\n  both answered from scoped reductions without a full walk.\n- Ordering parity: on a store with several pending entries with distinct `not_before_ns`,\n  the scoped-path result equals the full-walk result for the same store state — same ids,\n  same `(not_before_ns, id)` order (the f400 service-order contract).\n\n## Acceptance Criteria\n- [ ] A store with a standing non-empty pending set does not pay a full store walk on every write.\n- [ ] The marker still only ever asserts absence of pending work (for the whole store or for\n      everything outside its recorded live set); a pending verdict always comes from reducing\n      real queue events.\n- [ ] Every queue append still invalidates the marker.\n- [ ] The marker is still TTL-bounded, with the TTL measured from the last full walk (scoped\n      probes never refresh it).\n- [ ] A test seeds a store with a **permanently non-empty** pending set and pins the gate cost\n      (by probe/syscall count, not wall clock — `check_wall_clock_asserts`).\n- [ ] `make lint`, `make typecheck`, and the unit sweep are green.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/overlap/queue.py","reason":"gate marker live-set + scoped scan"},{"path":"tests/unit/test_enrich_queue.py","reason":"scoped-marker tests"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","958e-f4b3-275c-4154"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f9a8381e-ab38-4c3e-9d6e-ceb3c8020128","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"4144-75d3-6af1-47d3","ticket_type":"task","title":"enrich gate marker is all-or-nothing: one pending entry disables the O(1) fast path store-wide","verify_commands":[]},"source_event_uuids":["62bc0e17-d6f8-491a-9933-6c25447d6897","553fde60-09aa-4ae9-b0ac-ada746885973","735cc319-d9ee-42fb-80de-8afe91b745af","b225f86f-0cb3-428c-b3ab-c1712cfe7527","6fe30587-7dd6-4717-90ce-be72cfc8f747","60d74b2b-5866-484b-ad75-e12b0585ba11","1752c59d-792a-4659-9ce0-5688e20448a7","3401784a-e4bf-4079-b636-d090865f206c","cfc77a35-f78f-4b8b-98c2-10122003a518","f9a8381e-ab38-4c3e-9d6e-ceb3c8020128","ccf5e5d3-ed68-49ae-baf9-192b2f6bbfb0","badfb698-2dd1-4321-af68-5da16a2b716a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787393669470078001,"uuid":"a576d771-a77a-43fe-aeba-14414199608f"}