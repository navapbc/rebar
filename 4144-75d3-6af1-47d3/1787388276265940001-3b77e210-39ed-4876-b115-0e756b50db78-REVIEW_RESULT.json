 full walk and the scoped walk return `sorted(out)` by (not_before_ns, id), and add a test asserting scoped-path output order matches the full-walk order for the same store state.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] Add _gate_marker_says_quiet (queue.py:308-322, the second caller that unpacks _read_gate_marker's return at line 315) to the Scope's affected-symbol inventory and specify how the new `live` field flows through it without breaking the tuple unpack.","cohort":["project.symbol-reference-completeness"],"criteria":["project.symbol-reference-completeness"],"decision":"advisory","decision_margin":-0.05,"drop_reason":null,"evidence":["Plan: '_read_gate_marker validates live ... and reports the whole marker untrusted on any wrong type'","Plan: 'pending_enrichment gains a middle path: a TTL-fresh, non-future marker ... carries a live list'","queue.py:312 `marker = _read_gate_marker(tracker)` and queue.py:315 `next_eligible, written = marker` inside _gate_marker_says_quiet — a 2-tuple 