94c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5f6d04908868fc0ba3a8b0aeb8b85a89692b4fd868f8bc24693d9d286af555c7","event_uuid":"bce84c59-e9af-49bc-996a-88b58e1803bf","position":{"commit_sha":"426dfd5b1bd28b54f6c76b6955caeedc9e160504","position":"1787207556737790001-bce84c59-e9af-49bc-996a-88b58e1803bf"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"368247297977cb0ddaffab0c08cb73def72ee6d174d2f7fb91530cb79dc315da","event_uuid":"eca64082-4f2d-49d4-92c4-69f91e4af138","position":{"commit_sha":"71ac816dcb3790ba598d59c1da27d103eae08f14","position":"1787209275972828001-eca64082-4f2d-49d4-92c4-69f91e4af138"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ec4c6c55351d99e36f5631c6ae0994bd3e89e45afa8e535979c1047b05caf0fe","event_uuid":"ee1ccec3-9f99-496f-9b7a-f8293300a340","position":{"commit_sha":"9baf02079859723032492f829855cc46b3254e42","position":"1787209281257277001-ee1ccec3-9f99-496f-9b7a-f8293300a340"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-235_agent","claim_remote_session":null,"claimed_session":"eff19c3d-071a-47b5-bae6-8b48a3343a8c","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Premise verified before editing, and it held.\n\nLive read-only evidence (2026-08-19):\n- GET /repos/navapbc/rebar/environments/pypi -> required_reviewers rule with reviewer_count=1 (the user JoeOakhartNava, this project's configured release identity), prevent_self_review=false; environment can_admins_bypass=true.\n- GET /repos/navapbc/rebar/actions/runs/31916566035/approvals -> state 'approved' cast by JoeOakhartNava with comment 'release 0.12.0 - approved per release process (ticket grassgreen-unfearful-quoll)'.\n\nWhat the docs said: docs/releasing.md described the required-reviewers rule as 'the second human approval on every publish' and told the operator to 'approve the `pypi` deployment when prompted'. .github/workflows/release.yml:294 repeated the claim as 'the second human gate on every publish'.\n\nWhat the mechanism actually does: it holds the publish job, and the environment-scoped OIDC token with it, until an identity on the environment's reviewer list approves that specific run. That is identity + ref control over who can release the publish job. It is NOT a second pair of eyes and not an interactive checkpoint: one configured reviewer, self-review permitted, admin bypass available, and the approval is an ordinary REST call routinely made non-interactively. The 'published source was reviewed' property comes from releasing only from Gerrit-reviewed main, which the doc already stated correctly and which the rewrite now points at explicitly.\n\nScope note on AC4: the repo-wide grep is clean across docs/, CONTRIBUTING.md, AGENTS.md and .github/. The single remaining hit anywhere in the tree is the string 'explicit human approval token' inside docs/experiments/plan-review-gate/runs/exp1_substance.jsonl - frozen captured LLM output from a plan-review experiment, unrelated to the release gate. Not edited: it is recorded experimental data, not release documentation.\n\nCONTRIBUTING.md and AGENTS.md were swept and contain no occurrence, so neither needed an edit.\n\nGates (whole tree, worktree venv): make lint PASS (ruff check + format, complexity ratchet active=49 new=0 increased=0 stale=0, config-ownership, config-reads, DCO identity, criteria vocabulary, skill frontmatter, zizmor on release.yml clean, actionlint all workflows). make typecheck PASS (mypy, 581 source files, no issues). python scripts/check_complexity_baseline.py --check run directly: new=0 increased=0 stale=0. scripts/check_docs_index.py exit 0. pytest tests/unit/test_release_workflow_pins.py tests/unit/test_release_guards.py: 40 passed.\n\nGerrit change: https://rebar.solutions.navateam.com/c/rebar/+/1949","timestamp":1787205214282461001}],"created_at":1786840110366047001,"creation_channel":"cli","deps":[{"link_uuid":"a1f78269-7fc8-44ee-9abd-70152001e68a","relation":"discovered_from","target_id":"4dd2-4217-318a-4613"},{"link_uuid":"7408e87b-931c-4c44-a803-bd3c65dd4bdf","relation":"relates_to","target_id":"4841-b4f2-bf37-4eea"}],"description":"## Context / Problem\n\n`docs/releasing.md` tells a release operator that the `pypi` GitHub environment's\nrequired-reviewers rule is \"the second human approval on every publish\" (line 76-77) and that\nstep 2 finishes by approving \"the `pypi` deployment when prompted\" (lines 82-83, 325). Both\noverstate the control. Verified read-only against the live GitHub API on 2026-08-19:\n\n- `GET /repos/navapbc/rebar/environments/pypi` returns a `required_reviewers` rule whose\n  `reviewers` list holds exactly **one** entry — the user `JoeOakhartNava`, which is this\n  project's configured release identity — with `prevent_self_review: false`, and the\n  environment itself has `can_admins_bypass: true`.\n- `GET /repos/navapbc/rebar/actions/runs/31916566035/approvals` (the 0.12.0 release) shows\n  `state: \"approved\"` cast by `JoeOakhartNava` — granted non-interactively through the\n  pending-deployments REST API, not by a person answering a UI prompt.\n\nSo the gate is neither a *second* approval (the sole required reviewer is the same identity\nthat dispatches the run, and self-review is permitted) nor an *interactive human* one. A\nrunbook that says otherwise teaches an operator to wait for a prompt that never arrives, or to\nbelieve a second party reviewed a release that in fact nobody but the dispatcher touched.\n\n## Approach\n\nCorrect the three passages in `docs/releasing.md` so they describe the mechanism that exists,\nwithout replacing one overstated claim with another. The corrected text must state:\n\n- **What the gate does guarantee** — the `publish` job, and therefore the environment-scoped\n  OIDC token that Trusted Publishing mints, is held until an identity on the `pypi`\n  environment's required-reviewers list explicitly approves that specific run. Combined with\n  the `main`-only deployment-branch policy and the `authorize` job's ref/ancestry guards, no\n  run from another ref and no run lacking that identity's approval can reach PyPI.\n- **What it does not guarantee** — it is not independent second-party review. The sole\n  required reviewer is the configured release identity, `prevent_self_review` is off (so the\n  dispatcher approves their own run), and repository admins can bypass the environment\n  (`can_admins_bypass: true`). The \"the published source was reviewed\" property comes from\n  releasing only from Gerrit-reviewed `main`, which the doc already states correctly — the\n  environment rule adds identity control over *who can release the publish job*, not a\n  content review.\n- **How to approve non-interactively**, since that is the path actually used: a complete\n  `gh api --method POST .../pending_deployments` invocation carrying its required body\n  (`environment_ids`, `state`, `comment`), plus the companion `GET .../pending_deployments`\n  that discovers the environment id. The bare path with no body returns 422. The body is\n  supplied with `--input -` and an explicit JSON document, **not** with `-f`/`-F` field flags:\n  `environment_ids` must serialize as a JSON array of integers, and `gh api -f\n  environment_ids=<n>` sends a string while `-F environment_ids='[<n>]'` sends the literal\n  string `[<n>]` — both are rejected by the API. An explicit JSON body removes that\n  flag-typing hazard from the runbook entirely.\n\nKeep the env-preflight description load-bearing and unchanged in substance: `release_guards.py`\nstill fails the release closed when the required-reviewers rule or the `main`-only branch\npolicy is missing. What changes is the description of who approves and how, never the guard.\n\n**Sweep decision (explicit).** `CONTRIBUTING.md` and `AGENTS.md` were grepped and contain\n**no** occurrence of this framing, so neither needs an edit; `CONTRIBUTING.md` stays in the\nfile-impact list only to record that the sweep covered it. `.github/workflows/release.yml`\nline 294 carries the identical claim in a comment (\"the second human gate on every publish\")\nand **is** in scope: leaving it would let the workflow source contradict the corrected runbook\none grep away. It is a comment-only edit; no test asserts that line.\n\n## Scope\n\n- `docs/releasing.md` — rewrite the \"Release-source authorization\" closing paragraph and\n  step 2's approval sentence; add the non-interactive approval recipe.\n- `.github/workflows/release.yml` — correct the line-294 `publish`-job comment to match.\n- `CONTRIBUTING.md` — swept, no occurrence found; no edit expected.\n\n## Testing\n\nDocumentation-only correction; it adds no testable behavior, so no new test is written. The\nexisting `tests/unit/test_release_workflow_pins.py` drift assertions over `docs/releasing.md`\nand `release.yml` are the regression oracle and must keep passing.\n\n## Acceptance Criteria\n\n- [x] `docs/releasing.md` step 2 documents approving the pypi pending deployment as the\n      configured release identity and includes a complete, runnable REST form whose request\n      body types `environment_ids` as a JSON array of integers. Checked:\n      `grep -n \"pending_deployments\" docs/releasing.md` returns a hit, and\n      `grep -nE '\"environment_ids\": *\\[' docs/releasing.md` and\n      `grep -n '\"state\": \"approved\"' docs/releasing.md` each return a hit, while\n      `grep -nE '\\-f +environment_ids|\\-F +environment_ids' docs/releasing.md` returns\n      nothing (no string-typed field flag for the array).\n- [x] The runbook also shows the companion read that discovers the environment id, so an\n      operator can fill the body without guessing. Checked:\n      `grep -n \"pending_deployments\" docs/releasing.md` returns at least one line that is a\n      `GET`/read invocation (`gh api repos/navapbc/rebar/actions/runs/.../pending_deployments`)\n      distinct from the `--method POST` line.\n- [x] The \"Release-source authorization\" section no longer calls the environment rule a human\n      or second approval, and instead names both the guarantee (only a listed reviewer can\n      release the publish job for a run) and its limits (single configured reviewer,\n      self-review permitted, admin bypass). Checked:\n      `grep -nEi \"second human|human approval\" docs/releasing.md` returns nothing, and\n      `grep -nEi \"prevent.self.review|self-review|admin\" docs/releasing.md` returns a hit.\n- [x] The env-preflight remains documented as load-bearing and fail-closed. Checked:\n      `grep -n \"fails closed\\|fail the release closed\\|fails the release closed\" docs/releasing.md`\n      still returns a hit, and `grep -n \"required_reviewers\" docs/releasing.md` still does.\n- [x] No file in the repository retains the interactive-human-approval framing. Checked:\n      `grep -rnEi \"second human|human approval|approve the .?\\`?pypi\\`?. deployment when prompted\" docs/ CONTRIBUTING.md AGENTS.md .github/workflows/release.yml`\n      returns no matches. (The earlier literal `approve the pypi deployment` never matched:\n      the real text is backticked, `approve the \\`pypi\\` deployment`, so the pattern is\n      backtick-agnostic.)\n- [x] Gates pass on the whole tree: `make lint`, `make typecheck`,\n      `python scripts/check_complexity_baseline.py --check` reporting `new=0 increased=0\n      stale=0`, and `pytest tests/unit/test_release_workflow_pins.py`.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/releasing.md","reason":"Correct the pypi approval passages: who approves, how, and the precise guarantee and its limits."},{"path":".github/workflows/release.yml","reason":"Comment-only fix to line 294, which repeats the same second-human-gate claim the docs correction removes."},{"path":"CONTRIBUTING.md","reason":"Swept for the same phrasing; recorded in scope so the sweep is auditable even though no occurrence was found."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","4841-b4f2-bf37-4eea"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"eca64082-4f2d-49d4-92c4-69f91e4af138","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"da5e-13f1-9aad-4cc9","ticket_type":"task","title":"docs/releasing.md: pypi environment approval is executed by the configured release identity, not an interactive human prompt","verify_commands":[]},"source_event_uuids":["39aa44c9-f3f6-4e80-b1b4-82c8aac736b7","c583a7a3-ed4f-43a4-81d8-b9d2560fc638","2ac37770-1009-4586-a27f-f23309e9ad24","dc219af4-626a-4c25-aa79-4b7721e91adb","69feac46-3334-4436-b698-da8111185f80","9d62c4f9-671b-4798-9a08-a7cd4f9f830e","d27aaa2b-03bb-4b7e-aa31-54d2ae0ac454","6bdedd54-4cf5-4382-8f89-24abf8d0a000","7408e87b-931c-4c44-a803-bd3c65dd4bdf","bce84c59-e9af-49bc-996a-88b58