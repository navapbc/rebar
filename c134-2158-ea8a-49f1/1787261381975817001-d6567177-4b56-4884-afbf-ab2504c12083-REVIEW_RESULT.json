ut_tokens":1420.125,"llm_calls":1,"output_tokens":164.125,"requests":1},"T5c":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":14643.0,"llm_calls":1,"output_tokens":722.0,"requests":2},"T5d":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1054.4444444444443,"llm_calls":1,"output_tokens":163.44444444444446,"requests":1},"T5e":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1054.4444444444443,"llm_calls":1,"output_tokens":163.44444444444446,"requests":1},"T6":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1420.125,"llm_calls":1,"output_tokens":164.125,"requests":1},"T8":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":110026.0,"llm_calls":1,"output_tokens":3588.0,"requests":7},"T9":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1420.125,"llm_calls":1,"output_tokens":164.125,"requests":1},"necessity":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1420.125,"llm_calls":1,"output_tokens":164.125,"requests":1},"prerequisite-consistency":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":4853.0,"llm_calls":1,"output_tokens":490.0,"requests":1},"project.portability":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":1420.125,"llm_calls":1,"output_tokens":164.125,"requests":1},"project.symbol-reference-completeness":{"cache_read_tokens":0.0,"cache_write_tokens":0.0,"input_tokens":6227.0,"llm_calls":1,"output_tokens":293.0,"requests":1}}}},"findings":[{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Replace the 'coverage_threshold tolerates R3' mechanism with one the framework actually supports: either (a) give R3 an `expect` value outside FIRE_EXPECTS so `code_review_recall` returns NA for it (R3 becomes a non-gating documented probe, not a gating recall case), or (b) score R3 via a report-only llm-judge scorer; then correct AC #4 to match the chosen mechanism.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.4,"drop_reason":null,"evidence":["eval.py run_eval L684-686: `scored = sum(1 for _, o in outputs if o is not None)` then `epoch_ok = coverage_ok(spec, scored, len(dataset))` — coverage counts non-None outputs, not scorer passes","eval.py _gating_results L595-598 docstring: 'The scorer PASSES the epoch iff every APPLICABLE case passes it' — a single failed applicable case fails the scorer for that epoch","eval_scorers.py _recall L221-226: applicable to every case whose expect ∈ FIRE_EXPECTS ({finding,fail}); returns passed=fired — R3 (expect:finding) is a gating recall case, not exempt","eval.py L636-637: 'an epoch passes iff coverage clears the threshold AND every gating scorer passes' — coverage and per-case recall are ANDed, so coverage_threshold cannot buy tolerance for a recall miss","No per-case-optional / stretch / report-only-for-one-case knob exists in the framework (searched 'stretch', 'optional')"],"finding":"The plan's R3 'stretch' mechanism — 'the scorer coverage threshold is set so R3 alone failing does not fail the spec/gate' — is not achievable in this eval framework: coverage_threshold measures the fraction of cases producing a non-None (non-crashing) output, not the fraction passing their scorer, so a recall MISS on R3 is still 'covered'. Meanwhile code_review_recall (_recall) is a gating scorer and _gating_results fails the whole epoch if ANY applicable expect:finding case fails; run_eval's epoch_ok = coverage_ok(...) AND all gating scorers pass. Therefore R3 failing recall fails the epoch regardless of coverage_threshold. The only per-run tolerance is at_least(2)/3 epochs (a flaky WHOLE epoch), not a persistent per-case R3 miss.","group_criteria":null,"group_id":null,"id":"fa11c2ae101997a35","impact":1.0,"is_primary":null,"location":"Approach § RECALL R3 bullet ('The scorer coverage threshold is set so R3 alone failing does not fail the spec'); Acceptance Criteria #4","norm_id":"n1ca9a9c15503f389","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["R3 (fail-open guard) reproducibly does not fire across all 3 epochs: code_review_recall fails every epoch → gate fails, even with coverage_threshold lowered","Author sets coverage_threshold below 1.0 expecting it to tolerate the R3 miss; because R3 still yields a non-None output, coverage stays high and the gate still fails on the recall scorer"],"severity":"critical","suggested_fix":"Since coverage_threshold only forgives crashed/unparseable outputs (scored = non-None outputs) and code_review_recall fails an epoch on any failing applicable expect:finding case, drop the coverage_threshold framing for R3. Preferred: keep R1/R2 as gating expect:finding recall cases and demote R3 to a NON-gating probe — mark it with a spec comment as the known-hard stretch target and give it an expect that _recall treats as NA (so it runs and is visible in output but never gates), or attach a report-only llm-judge scorer for it. Update the Approach bullet and AC #4 to state 'R3 is present as a non-gating stretch probe (excluded from the gating recall scorer)', which is achievable and verifiable in the passing run.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"contradicts_reality","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"high","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.7,"blocking_enabled":true,"checklist_item":"- [ ] Correct the R3 non-gating mechanism: coverage_threshold measures score-ability (scored/total), not pass-rate, so a failing R3 is still counted — specify the real mechanism (e.g. mark R3 as non-gating/advisory, exclude it from the gating recall scorer, or size the recall pass-rate tolerance) by which a failing R3 does not fail the gate, and align AC4 with it.","cohort":["T8"],"criteria":["T8"],"decision":"block","decision_margin":0.3,"drop_reason":null,"evidence":["Plan: 'The scorer coverage threshold is set so R3 alone failing does not fail the spec'","Plan AC4: 'the coverage threshold is set so R3 alone failing does not fail the gate'","eval.py:331-337 — coverage(scored,total)=scored/total; coverage_ok compares to coverage_threshold; docstring 'Fraction of dataset samples that produced a usable score.'","eval_scorers.py:221-226 — _recall returns ScoreResult(True, fired, ...): a recall miss is applicable=True, passed=False, i.e. still scored/counted in coverage","gate is separate: at_least_passes (eval.py:326-328) over epochs governs per-epoch pass/fail"],"finding":"The plan's stated mechanism for making R3 a non-gating stretch entry — 'the coverage_threshold is set so R3 alone failing does not fail the gate' — is mis-specified against the eval harness. coverage() (eval.py:331-337) is scored/total: the fraction of dataset samples that produce a USABLE (applicable, non-NA) score, not the fraction that PASS. A recall miss on R3 still returns ScoreResult(applicable=True, passed=False) (eval_scorers.py _recall, line 221-226), so R3 remains 'scored' and counts fully toward coverage. Lowering coverage_threshold therefore does not tolerate a failing R3; it only tolerates an UNSCORABLE sample. The per-epoch pass/fail is instead governed by the gating s