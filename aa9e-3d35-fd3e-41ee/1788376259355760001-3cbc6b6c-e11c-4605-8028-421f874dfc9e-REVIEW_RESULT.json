eady-installed deps can either fail hash-resolution or conflict with rebar's [agents] runtime that the Dockerfile isolation was created to avoid.","group_criteria":null,"group_id":null,"id":"f1256c248827959f4","impact":0.536,"is_primary":null,"location":"Approach / AC line 3 ('the installer uses pip --require-hashes')","norm_id":"n8f4c8220050f63d3","priority":0.268,"reason":"default-advisory","recalled":false,"scenarios":["Verified lane runs the native-binary target on a runner where rebar is already installed; --require-hashes rejects an un-hashed transitive dep already present, or semgrep pins conflict with rebar deps"],"severity":"major","suggested_fix":"In the Approach, specify the provisioning helper creates a dedicated venv for the hash-locked Semgrep install (mirroring /opt/semgrep) and exposes it on PATH, so require-hashes resolves only against the Semgrep lock and never touches rebar's runtime environment.","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Confirm (against gitleaks release docs/assets) that bo