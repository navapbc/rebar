16163,"output_tokens":741,"requests":2}},{"kind":"success","lineage":{"dependencies":[],"digest":"dbd9090c02ff86fec00aa18253991638ecebb24396a2a9170105b940a2b65197"},"namespace_version":1,"reason":null,"unit_id":"agent:T5c","usage":{"input_tokens":90408,"output_tokens":1936,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"368f6de096c0f1f9d5400fe9c7030f2f2f63643c543f6bdcb0e13fd676304b3e"},"namespace_version":1,"reason":null,"unit_id":"agent:T1","usage":{"input_tokens":158941,"output_tokens":2959,"requests":7}},{"kind":"success","lineage":{"dependencies":[],"digest":"6747590739d3ea242d313e9c1a1e5f40690070fdebe147f1bdfe4499f95db86d"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":95220,"output_tokens":2097,"requests":5}},{"kind":"success","lineage":{"dependencies":[],"digest":"1828c0cb8d0aee49c844617f893af8d4797e97c92b987cbb88cdae427f89b6d7"},"namespace_version":1,"reason":null,"unit_id":"agent:G7","usage":{"input_tokens":503459,"output_tokens":4383,"requests":11}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] State explicitly that the advisory scanner lane must be a SEPARATE workflow file (not a job in gerrit-verify.yaml), or otherwise be provably invisible to the vote job's `im-open/workflow-conclusion` all-jobs snapshot, so a scanner failure cannot coerce WORKFLOW_CONCLUSION and cast Verified -1; add an AC/RED test asserting a failing advisory scanner run still yields Verified +1 when the required lanes are green.","cohort":["G6"],"criteria":["G6"],"decision":"block","decision_margin":0.2,"drop_reason":null,"evidence":["Plan: 'it must not be listed in the `vote` job's `needs`, must not be part of the `cast Verified` decision, and must not otherwise affect the required `Verified` aggregate'","gerrit-verify.yaml:439 'that snapshot (im-open/workflow-conclusion, a REST list-jobs read ... folds the reusable workflow's job conclusions into WORKFLOW_CONCLUSION'","gerrit-verify.yaml:504 CONCLUSION = `( <required jobs all success> ) && env.WORKFLOW_CONCLUSION || 'failure'` — WORKFLOW_CONCLUSION reflects ALL run jobs, so an in-file advisory job's failure coerces the vote to failure","jira-dc-exact-patchset.yml:20–25 shows the codebase's advisory pattern lives in a SEPARATE workflow ('does not gate Verified and is not invoked by gerrit-verify.yaml') — the mechanism the plan relies on but never states"],"finding":"The advisory constraint pins only `vote.needs` membership, but gerrit-verify.yaml casts Verified from `im-open/workflow-conclusion`, which the file's own comments describe as a REST 'list-jobs read' that snapshots ALL of this run's jobs (not just vote.needs). A scanner-integration job added INSIDE gerrit-verify.yaml would set WORKFLOW_CONCLUSION=failure on scanner failure; that value flows into the vote job's CONCLUSION expression (`... && env.WORKFLOW_CONCLUSION || 'failure'`) and casts Verified -1 even with all required lanes green — reproducing the 90c7 self-lock the plan aims to avoid. The plan does not require the advisory scanner lane to live in a SEPARATE workflow (as jira-dc-exact-patchset.yml does to stay out of the vote), so 'outside vote.needs' is necessary but insufficient.","group_criteria":null,"group_id":null,"id":"f425b3d42cd6fa445","impact":1.0,"is_primary":null,"location":"Plan 'Advisory wiring constraint' section; AC lines 8–9; vs .github/workflows/gerrit-verify.yaml:437–504","norm_id":"n9a98eb31d1dc6efb","priority":1.0,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["Implementer adds a scanner-integration job to gerrit-verify.yaml, keeps it out of vote.needs, but the scanner fails on a full-route change — im-open sees the failed job, WORKFLOW_CONCLUSION=failure, vote casts Verified -1, re-creating the self-lock incident 90c7","A future revert of a broken scanner cannot earn Verified +1 because the still-broken advisory job is in the same run's job list"],"severity":null,"suggested_fix":"Require the Gerrit advisory scanner lane to be its own workflow dispatched like jira-dc-exact-patchset.yml (own file, own concurrency group, never invoked by gerrit-verify.yaml), and add a held-out test proving that an injected scanner-lane failure does not change the vote job's normalized vote-type when all required lanes succeed.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"system","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"high","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["8 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.85,"blocking_enabled":true,"checklist_item":"- [ ] Realign parent epic 78f2 AC [RP14/T07] to ADR 0114's advisory-first staging (e.g., 'pinned scanners run in a portable direct-binary parallel ADVISORY lane; promotion into the Verified vote aggregate is a separate later change') so the leaf's advisory-only scope is a faithful subset of an up-to-date parent clause.","cohort":["G7"],"criteria":["G7"],"decision":"advisory","decision_margin":-0.652,"drop_reason":null,"evidence":["Parent AC RP14/T07: 'Pinned deployed Semgrep and Gitleaks integrations run in a portable direct-binary parallel Verified lane.'","Leaf: 'The recreated scanner-integration Gerrit job must be advisory only ... must not be listed in the vote job's needs, must not be part of the cast Verified decision ... Do not promote scanner integration into the voting path in this change.'","ADR 0114 (accepted 2026-09-04) mandates advisory-first before any new check enters the required Verified vote aggregate; incident 90c7 showed the prior in-aggregate wiring caused a self-referential Verified lock.","The leaf still delivers the portable, parallel, direct-binary, pinned-scanner aspects of RP14, so the parent's underlying goal (scanners actually running in a parallel lane) is intact; only the vote-casting attribute is narrowed/deferred — a wording-level mismatch, not a broken parent goal."],"finding":"The leaf redefines one attribute of parent AC RP14/T07: the parent requires the pinned scanner integrations to run 'in a ... Verified lane' (i.e., inside the required Verified vote aggregate), while the leaf deliberately delivers a non-voting ADVISORY lane and defers promotion into the Verified voting path to a separate future change (per ADR 0114 / incident 90c7). The parent epic (in_progress) has not updated RP14's wording to reflect this advisory-first staging.","group_criteria":null,"group_id":null,"id":"f9fde22f93e5f86d7","impact":0.264,"is_primary":null,"location":"Parent epic 78f2-b104-e3c9-4b86 AC '[RP14/T07]'; leaf 'Advisory wiring constraint' section and AC 'The scanner lane is wired as advisory for Gerrit'","norm_id":"nc41736a7949ccd5b","priority":0.198,"reason":"default-advisory","recalled":false,"scenarios":["A reviewer reads parent AC RP14/T07 literally, expects the scanner lane inside the Verified vote aggregate, and flags the advisory-only leaf as under-delivering.","The epic is closed on the leaf's completion while RP14's 'Verified lane' wording still implies voting wiring the leaf intentionally did not build."],"severity":null,"suggested_fix":"Update the parent epic's RP14/T07 acceptance criterion to describe an advisory (non-voting) parallel scanner lane with promotion into the Verified aggregate explicitly deferred, citing ADR 0114; then the leaf's advisory-only delivery is consistent narrowing rather than a redefinition of the parent's 'Verified lane' wording.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the installer's behavior when the Gitleaks release host or PyPI is slow/unreachable (a bounded download timeout and whether it retries or fails the advisory lane promptly), so the lane fails fast rather than hanging on a transient external-dependency stall.","cohort":["E3","E5","G5","T5b","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["T5b"],"decision":"advisory","decision_margin":-0.785,"drop_reason":null,"evidence":["Plan lists rejections for 'an unsupported platform, a missing scanner, the wrong Gitleaks version/digest, and invalid Semgrep requirement hashes' — all correctness checks, none address transient network failure/timeout on the download itself.","Installer uses 'pip install --require-hashes' and downloads a Gitleaks URL — both are external dependencies with no stated timeout/retry.","The advisory design keeps Verified voting up on failure (good blast-radius containment), but a hung download still consumes runner-minutes without surfacing a prompt failure."],"finding":"The scanner installer performs external network downloads (Gitleaks release binary + pip package downloads) but the plan specifies only correctness rejection (checksum/hash/version) — it does not state a timeout or retry/degraded-mode behavior when the release host or PyPI is slow or unreachable, so the advisory lane could hang rather than fail promptly.","group_criteria":null,"group_id":null,"id":"fc653ef0496325188","impact":0.264,"is_primary":null,"location":"Scope: 'scanner provisioning helper'; AC: installer rejection criteria","norm_id":"n4457f28fe0501015","priority":0.165,"reason":"default-advisory","recalled":false,"scenarios":["A Gerrit/CI full-route run where the Gitleaks release asset or PyPI is transiently slow: the advisory lane blocks on the download with no timeout, consuming the documented 1.5-3 runner-minute budget (or more) before any failure is surfaced."],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Enumerate the 18 file paths that constitute the allowed file impact (or link the exact revert diff of change 2612) so the 'no editing outside 18 paths' AC is checkable from the plan itself.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5a","T5e","T7"],"criteria":["E2"],"decision":"dropped","decision_margin":-0.6743,"drop_reason":null,"evidence":["'The reverted scanner artifacts are recreated and adapted against current origin/main without editing outside the recorded 18-path file impact.'","The Scope section lists artifact categories but not an explicit 18-path list; the count '18' is asserted without the enumeration."],"finding":"The acceptance criterion constrains edits to 'the recorded 18-path file impact' but the plan never enumerates those 18 paths, forcing the executor to reconstruct them from the reverted change 2612.","group_criteria":null,"group_id":null,"id":"fd513b8e4bc825afc","impact":0.44,"is_primary":null,"location":"Acceptance Criteria, first bullet ('without editing outside the recorded 18-path file impact')