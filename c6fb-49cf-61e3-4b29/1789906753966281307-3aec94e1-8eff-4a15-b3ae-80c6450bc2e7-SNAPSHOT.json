n":"1789891708305100799-6ab3054c-c1ea-4194-8962-f8737c4ead21"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"32d1cc5ec3fd9a5e3be8764c548b9dadadc8d778aec9f7c220b950649565bffe","event_uuid":"714cb40c-08de-4d19-a06d-67377f9de258","position":{"commit_sha":"e17a59a7c856bba758a8cea2e51f531709751e32","position":"1789893887287735039-714cb40c-08de-4d19-a06d-67377f9de258"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"68e32a375e5d15c9e8a3c486929ff41d530b1ad44c026937d8946ebdab4fe80c","event_uuid":"47a0173d-8e08-4dbe-bf85-3d7ef85f2e79","position":{"commit_sha":"5463b945a6d84c420af4ec576f9b4c4fc26afcb3","position":"1789893894625585529-47a0173d-8e08-4dbe-bf85-3d7ef85f2e79"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5f1a41ad40db61feab56cd1ce7c7e80ace951d10514340e4e4d4ef2e34a79844","event_uuid":"4d5a6209-a1d3-4608-b801-f0e8311f22d0","position":{"commit_sha":"5348f537d2d506dd4125d4dc6fb6906fe415c3ca","position":"1789894338524978261-4d5a6209-a1d3-4608-b801-f0e8311f22d0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d43ef884dee9d4259fbfce83abae3133335fb66b7ac52760acb111f32a2ca62f","event_uuid":"e33f2d5b-87ce-45f0-8660-51c398e4f0f5","position":{"commit_sha":"3c9822559ff0d4a5e73de760d4a9f5120ae42a22","position":"1789894503814105377-e33f2d5b-87ce-45f0-8660-51c398e4f0f5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authors