25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"48cf3aa1b99226e94366bdd1c82bd42d1257ba945a5343992a6a5e5510f4e6d7","event_uuid":"bc461463-8166-41f7-957c-eb55d46e0fa0","position":{"commit_sha":"42d7332fdc552bc33ea7beb2e0c35094dd3296ae","position":"1787027630954407001-bc461463-8166-41f7-957c-eb55d46e0fa0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027604828265001,"creation_channel":"cli","deps":[{"link_uuid":"bc461463-8166-41f7-957c-eb55d46e0fa0","relation":"depends_on","target_id":"f59b-56c1-596d-422a"}],"description":"## Context\nProduction rich-text convergence mutates a binding entry reached through shallow `all_bindings()`, bypassing lifecycle policy. The public shallow query must remain compatible, but production needs a named mutation seam.\n\n## Outcome\nAdd `BindingStore.note_rich_emit(local_id, wire)` or an equivalently narrow operation that owns hash/counter/save behavior and returns the current nonfatal missing-binding result. Do not cut over `apply_handlers.py` yet.\n\n## Plan\n1. Capture the current production sequence in a failing comparison test, including changed/unchanged wire hashes, counters, dirty/save gating, and missing binding.\n2. Implement the operation through facade -> lifecycle -> repository while retaining the original dictionaries.\n3. Keep `all_bindings()` copy depth and public signatures unchanged, but document the new method as the supported mutation seam.\n4. Add a boundary test proving adapters and reconciler callers cannot obtain direct writable repository/lifecycle objects.\n\n## Testing\nCompare new-operation results and persisted bytes with the legacy mutation sequence for changed, unchanged, and missing cases.\n\n## Acceptance Criteria\n- [ ] Changed rich-emission wire data produces the same hash, counter, dirty state, and saved bytes as the legacy sequence.\n- [ ] Unchanged data performs no save.\n- [ ] Missing bindings remain nonfatal with the current result.\n- [ ] `all_bindings()` remains shallow and every existing facade signature remains unchanged.\n- [ ] No production adapter receives direct repository or lifecycle mutation access.\n\n## Out of scope\n`apply_handlers.py` cutover belongs to RP-02 S3 after its RP-04 coordination condition.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_lifecycle.py","reason":"Own rich-emission hash/counter policy."},{"path":"src/rebar/_engine/rebar_reconciler/binding_store.py","reason":"Expose the narrow facade mutation operation."},{"path":"tests/unit/rebar_reconciler/state/test_rich_reemit_state.py","reason":"Compare narrow-operation behavior with the legacy sequence."},{"path":"tests/unit/rebar_reconciler/state/test_binding_lifecycle.py","reason":"Prove lifecycle/repository encapsulation and dirty gating."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","f59b-56c1-596d-422a"],["parent","fc1c-1b08-70c2-4afb"]],"no_file_impact_reason":"","parent_id":"fc1c-1b08-70c2-4afb","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp02","binding-lifecycle","tdd"],"ticket_id":"2419-2804-c181-4bc0","ticket_type":"task","title":"RP-02 S2 T3 — Add the narrow rich-emission facade operation","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_rich_reemit_state.py tests/unit/rebar_reconciler/state/test_binding_lifecycle.py","dd_id":"AC1-AC5","dd_text":"Rich-emission compatibility, unchanged and missing cases, shallow query, and encapsulation"}]},"source_event_uuids":["3fcc54e0-e6d5-4fed-a3f2-b4cbf0856cc9","f786e0f2-43c0-47fe-bb93-9f03e672e9b2","2905709f-b5e3-4049-aeae-f94e62fcbf0c","bc461463-8166-41f7-957c-eb55d46e0fa0"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029930361720001,"uuid":"83c5742e-75a7-40cb-bfef-195cee51d406"}