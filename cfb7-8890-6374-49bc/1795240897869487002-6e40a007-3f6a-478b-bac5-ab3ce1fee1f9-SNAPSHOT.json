{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795240897869487002,"compiled_state":{"alias":"childproof-adrenal-macaw","assignee":"joeoakhart@navapbc.com","attestations":{"completion-verifier":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"ebd2a68a451314a2e09ab88d343833178d15e9dc","key_id":null,"kind":"completion-verifier","manifest":["completion-verifier: PASS","ticket: cfb7-8890-6374-49bc","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","rebar-version: 0.16.0 (ebd2a68a451)","material: c3e8136c612b25c0","verified-at-sha:fed3d35d08f00c7960cdd3d4f8bf5d0cf84b1913"],"material_fingerprint":"c3e8136c612b25c0","merged_log_commit":"fed3d35d08f00c7960cdd3d4f8bf5d0cf84b1913","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1795240897868715000},"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"459ad3874dd044038e49b807241173cc0773b25f","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: cfb7-8890-6374-49bc","material: c3e8136c612b25c0","material-part: children 647ea2107ca5072f 0","material-part: description 7de8f4f252887628 6182","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact ffd7a810cc6e2f15 7","material-part: ticket_id 8d0969d7f12974b0 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 5","review-phase: planning","re