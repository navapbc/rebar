input_tokens":519255,"output_tokens":6673,"requests":13}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] State explicitly that an indexed verify_completion job attaches NO `findings` block (findings is plan-review-only), and add a regression asserting its absence.","cohort":["T8"],"criteria":["T8"],"decision":"advisory","decision_margin":-0.2137,"drop_reason":null,"evidence":["gate_runs.gate_run_status handles gate_type in (_PLAN_REVIEW, _VERIFY_COMPLETION) for the durable field","Disposition covers only: 'no findings block when the job is unknown' and 'For indexed plan-review jobs, findings.sidecar_type is always REVIEW_RESULT'","No sentence states the completion-job disposition, and no AC line exercises a verify_completion job's findings block"],"finding":"The findings-block disposition does not specify what an indexed verify_completion job reports. gate_run_status serves BOTH plan_review and verify_completion gate types, but step 6 attaches `findings` 'for plan-review jobs' and the Disposition only enumerates dispositions for unknown and indexed plan-review jobs — it never states that an indexed completion job receives NO findings block (or some other disposition).","group_criteria":null,"group_id":null,"id":"fcc07110af440283a","impact":0.67,"is_primary":null,"location":"Fix plan step 6 ('gate_status(job_id) adds findings for plan-review jobs') + Disposition paragraph","norm_id":"nf6ff266b5a90d7fb","priority":0.5863,"reason":"default-advisory","recalled":false,"scenarios":["A caller polls gate_status on a verify_completion *_start job and inspects for a findings block","Executor writes the branch guard in gate_runs.py and must decide whether gate_type=='verify_completion' skips findings entirely"],"severity":null,"suggested_fix":"Add to the Disposition: 'For an indexed verify_completion job no findings block is attached (findings is REVIEW_RESULT/plan-review-only); only plan_review gate_type jobs receive it.'","tier":"LLM","validity":0.875,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] State the exact predicate that separates `sidecar-not-emitted` (record HAS `sidecar_emitted` key == false) from `review-result-generation-unknown` (record has NO `sidecar_emitted`/`sidecar_reviewed_at` keys at all) in the gate_runs findings decision rule.","cohort":["T8"],"criteria":["T8"],"decision":"advisory","decision_margin":-0.3812,"drop_reason":null,"evidence":["Disposition: 'sidecar-not-emitted is a new record with sidecar_emitted=false and no receipt; review-result-generation-unknown is a legacy terminal record with no receipt fields'","plan_review_verdict.schema.json defines sidecar_emitted as a boolean property (always present on fresh verdicts; reuse.py sets sidecar_emitted=False on both reuse paths)","A legacy record has NO sidecar_emitted key; a new sidecar_emitted=false record has the key set to false — but the plan never states 'key absent' vs 'key present-and-false' as the selection predicate"],"finding":"The reason-selection decision rule does not state the predicate that distinguishes `sidecar-not-emitted` from `review-result-generation-unknown`. Both are terminal records with no `sidecar_reviewed_at` receipt, so the only disambiguator is whether the `sidecar_emitted` key is PRESENT (a new record always carries the bool; a legacy record predates the field). The plan describes the two states in prose but never names the field-presence predicate the executor must implement, and it drives two distinct AC-tested reason values.","group_criteria":null,"group_id":null,"id":"f72903f65f39ffc1b","impact":0.67,"is_primary":null,"location":"Fix plan step 6/7 + Disposition paragraph ('sidecar-not-emitted is a new record with sidecar_emitted=false and no receipt; review-result-generation-unknown is a legacy terminal record with no receipt fields')","norm_id":"n3c9fbd9249ad2333","priority":0.4188,"reason":"default-advisory","recalled":false,"scenarios":["Executor implements gate_runs.py findings block and must map a terminal record with no sidecar_reviewed_at to exactly one of two reason codes","A legacy .rebar/gate_runs entry (pre-feature) is polled and must report review-result-generation-unknown, not sidecar-not-emitted"],"severity":null,"suggested_fix":"Add to step 7 / Disposition: select `sidecar-not-emitted` when the terminal record CONTAINS a `sidecar_emitted` key equal to false and no `sidecar_reviewed_at`; select `review-result-generation-unknown` only when the record contains NEITHER `sidecar_emitted` NOR `sidecar_reviewed_at` (a pre-feature legacy index entry).","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["3 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add an acceptance criterion asserting that a `run-stale-running` (crashed-leader) job reports `findings.readable=false`, `reason=\"run-stale-running\"`, and `reviewed_at=null`.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T7"],"criteria":["E1"],"decision":"dropped","decision_margin":-0.785,"drop_reason":null,"evidence":["Disposition: 'run-stale-running is a crashed-leader unavailable state.'","AC: 'Assert non-terminal plan-review runs report findings.readable=false, reason=\"run-<status>\", and reviewed_at=null.'","No AC names run-stale-running specifically, so its readability/reviewed_at contract is only implicitly covered."],"finding":"The `run-stale-running` reason code is defined in the Disposition paragraph ('a crashed-leader unavailable state') but no acceptance criterion explicitly asserts it; the closest AC covers non-terminal runs with reason `run-<status>` and `reviewed_at=null`, which may not cleanly cover a crashed-leader state that is neither cleanly running nor terminal.","group_criteria":null,"group_id":null,"id":"f2e91b8ae24763472","impact":0.44,"is_primary":null,"location":"Fix plan disposition paragraph vs Acceptance Criteria (AC 'non-terminal plan-review runs report ... reason=run-<status>')","norm_id":"nebe884b8e209aff6","priority":0.165,"reason":"veto:absence-refuted","recalled":false,"scenarios":["A leader crashes mid-run and gate_status is polled; the exact findings.readable/reason contract for that state is unverified by any AC."],"severity":null,"suggested_fix":"Add: 'Assert a crashed-leader run-stale-running job reports findings.readable=false, reason=\"run-stale-running\", reviewed_at=null.' — or explicitly state that run-stale-running is subsumed by the run-<status> AC.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the RETIRE/cleanup story for accumulating per-run REVIEW_RESULT sidecars (or explicitly declare retirement out of scope and why it is safe given the newest-by-ticket / exact-prefix scans).","cohort":["E3","E5","G5","T6","T9","necessity","project.engine-layer-enforcement","project.failure-disposition-contract","project.portability"],"criteria":["T9"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["'sidecar.latest_review_result(ticket) is newest-by-ticket'","'Seed an old REVIEW_RESULT, record a terminal newer run ... omit that sidecar'","ABSENCE: no step, non-goal, or AC states who cleans up / retires stale per-run REVIEW_RESULT sidecars; they accumulate per run"],"finding":"The plan introduces/relies on per-run REVIEW_RESULT sidecar files as job-scoped shared state (receipt identity via sidecar_reviewed_at prefix) and reads newest-by-ticket via latest_review_result / all_review_results, yet defines no RETIRE/cleanup path for the accumulating per-run sidecars. The lifecycle covers CREATE (emit), UPDATE (receipt into run index), and CONSUME (findings.readable, staleness-tolerant), but not retirement — prior-run files (as in the 2026-09-01 repro) persist indefinitely.","group_criteria":null,"group_id":null,"id":"f90cc66e6bcc07292","impact":0.0,"is_primary":null,"location":"Root cause / actual layer + Fix plan step 7 (exact-prefix scan of sidecar files) and 'seed an old REVIEW_RESULT' ACs","norm_id":"n30e6a411006430e0","priority":0.0,"reason":"veto:absence-refuted","recalled":false,"scenarios":["Long-lived ticket with many review runs accumulates unbounded REVIEW_RESULT sidecars; the newest-by-ticket scan and exact-prefix search operate over a growing directory","Prior-run sidecars (the repro's stale file) are never garbage-collected, so latest_reviewed_at diagnostics drift and the directory grows without bound"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.25,"verification":{"binary":{"absence_confirmed_in_context":"no","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"no","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"none","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Specify that reuse.idempotent_reuse/verdict_reuse stamp sidecar_reviewed_at from the reviewed_at of the SAME payload latest_review_result returned (e.g. all_review_results()[0]['reviewed_at']), not latest_review_timestamp/newest filename, so a corrupt newer sidecar cannot make the reused verdict report readable=false.","cohort":["G6"],"criteria":["G6"],"decision":"dropped","decision_margin":-0.6763,"drop_reason":null,"evidence":["Item 4: 'set sidecar_reviewed_at from the reused sidecar's filename timestamp'","Scope note: 'reuse reads exact payload timestamps from existing all_review_results()'","sidecar.latest_review_result walks newest->oldest and 'returns the first usable plan_review_result_v1/v2 payload (a malformed file is logged)'; latest_review_timestamp returns files[-1] prefix (the newest file, which may be the corrupt one that latest_review_result skipped)","all_review_results stamps payload['reviewed_at']=int(fname.split('-',1)[0]) per usable file, newest-first, skipping corrupt/foreign files"],"finding":"On the reuse short-circuits, the receipt must be the reviewed_at of the EXACT payload reused (the one latest_review_result returned after walking back over a corrupt/foreign newest file), not the newest sidecar's filename timestamp; otherwise a corrupt newest file makes gate_status prefix-match the wrong file and report findings.readable=false for a valid reused verdict.","group_criteria":null,"group_id":null,"id":"fb736a9d2395b93df","impact":0.33,"is_primary":null,"location":"Fix plan item 4 (reuse.idempotent_reuse / reuse.verdict_reuse) and Scope: src/rebar/llm/plan_review/reuse.py","norm_id":"n56de5a681644d419","priority":0.1237,"reason":"low-validity","recalled":false,"scenarios":["A mid-emit crash leaves a corrupt newest REVIEW_RESULT; the BLOCK verdict_reuse path reuses the older valid payload but stamps sidecar_reviewed_at from the corrupt newest filename; gate_status then reports readable=false / review-result-sidecar-missing even though a valid reused sidecar exists"],"severity":null,"suggested_fix":"Have the reuse paths obtain the receipt and the payload from one source: use all_review_results()[0] (its reviewed_at is the filename prefix of the first USABLE payload, matching latest_review_result's walk-back) and stamp sidecar_reviewed_at from that entry's reviewed_at; add an AC asserting reuse over a corrupt-newest sidecar still reports findings.readable=true for the exact reused file.","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverif