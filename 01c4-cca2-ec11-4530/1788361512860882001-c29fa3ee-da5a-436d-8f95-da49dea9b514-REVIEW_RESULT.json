amespace_version":1,"reason":null,"unit_id":"agent:T8","usage":{"input_tokens":58198,"output_tokens":3735,"requests":5}}],"version":1},"findings":[{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Specify how the daemon binds `sidecar_reviewed_at` to the exact sidecar review_plan()/emit() wrote (e.g. have emit()/build_payload return the written filename or ns timestamp, or capture the newest-timestamp before and after emit and record only the newly-appended file) rather than recording an unqualified newest-timestamp read that can attribute another run's sidecar to this job.","cohort":["T8"],"criteria":["T8"],"decision":"block","decision_margin":0.1,"drop_reason":null,"evidence":["Fix step 1: 'sidecar_reviewed_at: <ns timestamp> ... the daemon can read the newest REVIEW_RESULT timestamp after work() returns'","AC3: 'Do not infer freshness from \"latest timestamp after job start\"; that could falsely attribute a later unrelated sidecar to a legacy job.'","sidecar.emit() (src/rebar/llm/plan_review/sidecar.py:60-107) returns only a bool; build_payload/append_event do not surface the written filename or ns timestamp back to the caller, so the daemon has no per-run receipt to record other than a newest-timestamp read","latest_review_result / all_review_results derive `reviewed_at` from the filename's ns-epoch prefix (sidecar.py:250), i.e. a latest read, not a write receipt"],"finding":"The mechanism that records `sidecar_reviewed_at` (fix step 1: read the newest REVIEW_RESULT timestamp after work() returns) is not tied to the specific sidecar review_plan()/emit() actually wrote, so it can record a later unrelated run's timestamp — the same latest-timestamp misattribution AC3 explicitly forbids for the readability decision.","group_criteria":null,"group_id":null,"id":"f6885e279a76be89e","impact":1.0,"is_primary":null,"location":"Fix plan step 1 (sidecar_reviewed_at recording) vs. Acceptance Criterion 3","norm_id":"n107d7a1a12766bf7","priority":0.9,"reason":"high-priority+criterion-opted-in","recalled":false,"scenarios":["A remediation re-run's emit() lands; before the daemon's post-work read completes, a concurrent or immediately-following review's sidecar for the same ticket is written, so the daemon records the newer file's timestamp as this job's sidecar_reviewed_at","Two async plan-review runs for the same ticket overlap; each records the other's newest sidecar timestamp"],"severity":null,"suggested_fix":"Have sidecar.emit()/build_payload return the ns timestamp (or full filename) of the appended REVIEW_RESULT and thread that value into review_plan()'s verdict; the daemon records THAT value as sidecar_reviewed_at instead of re-reading the newest sidecar after work().","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"high","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] State the emit conditions for `reason=review-result-generation-unknown` (legacy record with no per-run receipt) and `reason=run-<status>` (non-terminal poll), and add an acceptance criterion asserting a legacy terminal record reports `findings.readable=false` with `reason=review-result-generation-unknown` and only `job_started_at` for diagnostics.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5e","T7"],"criteria":["E1","E6"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["Step 2 lists reason values: \"'current-review-result-sidecar' | 'review-result-sidecar-missing' | 'sidecar-not-emitted' | 'review-result-generation-unknown' | 'run-<status>'\"","Step 3 mentions legacy jobs (\"could falsely attribute a later unrelated sidecar to a legacy job\") and step 2 mentions `job_started_at` \"only for legacy records with no receipt\", but neither states these produce `reason=review-result-generation-unknown`","The five ACs cover current/missing/sidecar-not-emitted/poll-then-read/daemon-receipt but none asserts `reason=review-result-generation-unknown` (legacy record) or `reason=run-<status>` (non-terminal)"],"finding":"The `findings.reason` enum includes `review-result-generation-unknown` and `run-<status>`, but the fix plan never states the conditions under which these two values are emitted, and no acceptance criterion exercises them.","group_criteria":null,"group_id":null,"id":"f407926ebcc4e0330","impact":1.0,"is_primary":null,"location":"Fix plan step 2 (reason enum) and Acceptance Criteria","norm_id":"n7b6af34ef63323f7","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["A legacy terminal run index with no sidecar receipt is polled","gate_status is called on a job that is not yet terminal"],"severity":null,"suggested_fix":"Add to the fix plan: \"Emit reason=review-result-generation-unknown when a terminal run index lacks a sidecar_reviewed_at receipt (legacy record); emit reason=run-<status> when the job is not yet terminal.\" Add an AC that seeds a legacy terminal index without a receipt and asserts readable=false, reason=review-result-generation-unknown, and latest_reviewed_at is not attributed as this run's findings.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"missing_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"high"}}},{"block_threshold":0.9,"blocking_enabled":false,"checklist_item":"- [ ] State the disposition for the sidecar_emitted=true-but-file-missing arm: is 'review-result-sidecar-missing' transient (keep polling) or does it become a permanent unavailable-findings condition after a bound, so a poll-then-read caller cannot loop forever?","cohort":["E3","E5","G5","T5b","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["project.failure-disposition-contract"],"decision":"advisory","decision_margin":0.1,"drop_reason":null,"evidence":["Step 4 only defines permanence for sidecar_emitted=false: 'if sidecar_emitted is false, ... returns findings.readable=false and reason=\"sidecar-not-emitted\". A poll-then-read caller must stop treating findings as pending'","Step 2 lists reason 'review-result-sidecar-missing' but never says whether that arm is transient (retry/keep polling) or eventually fatal when sidecar_emitted=true","No bound/deadline is stated for how long a caller polls a missing-but-expected sidecar before surfacing it as unavailable"],"finding":"The plan gives 'sidecar-not-emitted' an explicit permanent disposition (caller stops looping) but does not state the terminal disposition for the emitted=true-but-exact-file-never-appears arm ('review-result-sidecar-missing' with sidecar_emitted=true). A poll-then-read caller cannot tell whether this state is transient (keep waiting) or permanently stuck, so it could loop forever if the promised sidecar file never materializes despite sidecar_emitted=true.","group_criteria":null,"group_id":null,"id":"ffcbf6c747b9f0e6d","impact":1.0,"is_primary":null,"location":"Fix plan step 2 (reason=\"review-result-sidecar-missing\") and step 4 (Permanent failure disposition)","norm_id":"nc77ed7240c92b412","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["sidecar_emitted=true recorded, but the exact sidecar_reviewed_at file is deleted/never persisted by a downstream failure — the poller keeps seeing readable=false reason=review-result-sidecar-missing and loops indefinitely with no permanent-failure exit"],"severity":null,"suggested_fix":"Add a disposition clause: reason=\"review-result-sidecar-missing\" is transient while the run is fresh, but once sidecar_emitted=true and a stated deadline/attempt bound elapses without the exact file, gate_status surfaces it as a permanent unavailable-findings condition (mirroring the sidecar-not-emitted stop-looping contract).","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"missing_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.8,"blocking_enabled":true,"checklist_item":"- [ ] Close the receipt-capture race: obtain the emitted sidecar's exact identity from review_plan()/emit() (return its timestamp/filename or stamp the job_id into the payload) instead of inferring 'newest REVIEW_RESULT after work() returns', so a concurrent same-ticket emit cannot be misattributed as this job's sidecar_reviewed_at.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.197,"drop_reason":null,"evidence":["Plan: 'sidecar_reviewed_at: <ns timestamp> when review_plan() emitted a sidecar and the daemon can read the newest REVIEW_RESULT timestamp after work() returns'","sidecar.emit signature is `-> bool` (sidecar.py:71); __init__.py:564 stores only verdict['sidecar_emitted'] — no timestamp/filename receipt is returned to the daemon","Plan step 3 explicitly guards against attributing 'a later unrelated sidecar' to legacy jobs, but the same misattribution can occur in the receipt-capture path via a same-ticket concurrent emit","latest_review_result / all_review_results resolve newest-by-filename-timestamp per TICKET, not per job (sidecar.py:148,207) — nothing ties a sidecar to the emitting job"],"finding":"Step 1b derives the per-run sidecar receipt by reading the newest REVIEW_RESULT timestamp after work() returns, but emit() returns only a bool and no filename/timestamp; a concurrent plan-review for the SAME ticket that emits between this run's emit() and the daemon's post-work read would misattribute a different run's sidecar as this job's sidecar_reviewed_at.","group_criteria":null,"group_id":null,"id":"fb41ea176cc00b0d7","impact":0.67,"is_primary":null,"location":"Fix plan step 1 (sidecar_reviewed_at capture) / _mcp_llm.py daemon _bg finally","norm_id":"nf60b1ad648e769c9","priority":0.603,"reason":"default-advisory","recalled":false,"scenarios":["Two plan-review runs for the same ticket overlap; run A's daemon reads 'newest timestamp' after A's work() returns but run B has already emitted a newer sidecar, so A records B's timestamp as its own receipt","A drift-refresh re-review starts while a prior async run is finishing on the same ticket"],"severity":null,"suggested_fix":"Have sidecar.emit() (and review_plan()) surface the written event's timestamp/filename so the daemon records that exact value as sidecar_reviewed_at; or stamp the job_id into the sidecar payload and match findings.readable on job_id rather than on a newest-timestamp inference.","tier":"LLM","validity":0.9,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"medium","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,