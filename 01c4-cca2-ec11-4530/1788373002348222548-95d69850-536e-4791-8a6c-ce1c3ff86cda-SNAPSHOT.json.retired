{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788373002348222548,"compiled_state":{"alias":"beige-acute-bobolink","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"b5aad2979d72f6ad549d42af3b985e69007f3c08","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 01c4-cca2-ec11-4530","material: 2b6623c37e06041a","material-part: children 647ea2107ca5072f 0","material-part: description 9bbb44dd1b9c9faf 6987","material-part: description_boxes 38efaf2b16858416 0","material-part: file_impact b9cdac663c5092c8 3","material-part: ticket_id 11d6d2ae40b5c43a 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: execution","priority-floor: 0.80","rebar-version: 0.13.1 (b5aad2979d72-dirty)","regver: aa61189569d34126","verified-at-sha:952f0825321c755f41edce412ad1fe9f1db9268d","dep ba2402338b7faec8e9eb5e7d4238a4456d2a470e61d9ff83cd501ea974462804 src/rebar/_mcp_reads.py","dep e66e6ac1ebb8300842ab22cc2c44caf3fc22c67d1d5436c60b92e1fed6b33cd4 src/rebar/llm/gate_runs.py","dep absent tests/unit/test_gate_status_sidecar_visibility.py","read-set: 16","read-path: src/rebar/_commands/_seam.py","read-path: src/rebar/_mcp_llm.py","read-path: src/rebar/_mcp_models.py","read-path: src/rebar/_mcp_reads.py","read-path: src/rebar/_store/event_append.py","read-path: src/rebar/_store/event_prepare.py","read-path: src/rebar/_store/hlc.py","read-path: src/rebar/_store/staging.py","read-path: src/rebar/llm/gate_runs.py","read-path: src/rebar/llm/plan_review/__init__.py","read-path: src/rebar/llm/plan_review/reuse.py","read-path: src/rebar/llm/plan_review/sidecar.py","read-path: src/rebar/schemas/check_mcp_models.py","read-path: src/rebar/schemas/plan_review_verdict.schema.json","read-path: tests/interfaces/store/test_sidecar_reader.py","read-path: tests/unit/test_mcp_gate_async.py","currency-basis: file_impact"],"material_fingerprint":"2b6623c37e06041a","merged_log_commit":"952f0825321c755f41edce412ad1fe9f1db9268d","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1788370955730884000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":19,"unsigned":0},"authorship_ledger":[{"content_hash":"44d82e9d9ed2d41b9416d066257e92a79e3c47459d047f86e2e0b2d2a241d737","event_uuid":"c13933c3-1107-48c8-bf9a-442af79b16d9","position":{"commit_sha":"db4fb6c887684823d8d3b0cfbd46b031e5409069","position":"1788336840914294511-c13933c3-1107-48c8-bf9a-442af79b16d9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"ae4139c36e1231864c2d892b3679386a978d3ec62313973053f3c7bd27b97b89","event_uuid":"6ee419c7-1546-409f-846b-c99c1a3d3cd8","position":{"commit_sha":"db4fb6c887684823d8d3b0cfbd46b031e5409069","position":"1788336841249979844-6ee419c7-1546-409f-846b-c99c1a3d3cd8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"87c5cecfd71e23defd578806d7e4a06f8d1bd38a935e2434c99ed7b57a8f0149","event_uuid":"badd10d7-da6e-434d-88e1-4fc45ac608d8","position":{"commit_sha":"209f8c4c0d4d0697489f555a3a3e04a42aea2c77","position":"1788337912181097467-badd10d7-da6e-434d-88e1-4fc45ac608d8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"f4f876aa3d2f7b67ab80b72dd255a34e235111b9b3154398b692a80cb395b65a","event_uuid":"b9e0f400-89b4-4204-aae3-effa7545551f","position":{"commit_sha":"36901733692cb7b9c5177bbd2d8bcd48e1a9be9b","position":"1788358192055117001-b9e0f400-89b4-4204-aae3-effa7545551f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e5eb20edb4546a60f42fd84e8fc8e0fc24d3460b47dca69a71233e69dd1bd022","event_uuid":"8cd42dd2-6860-4b6a-8357-7502318963c3","position":{"commit_sha":"99ab528805195f4460d9cdca309d9f31241f6583","position":"1788358662381185090-8cd42dd2-6860-4b6a-8357-7502318963c3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2689b6b3e2d75389ba9d04a5a75a7b4e3cc2db18f74845c9e0a1e932d421b33e","event_uuid":"4a0034a2-9bd0-4a72-bb4c-6d75b6442c25","position":{"commit_sha":"6bb7eec0638c39b6d63704df10e409102870df20","position":"1788361026051788001-4a0034a2-9bd0-4a72-bb4c-6d75b6442c25"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"cd243c2c9368b7e4d5e21ca654c43ceb0e6cf0d8627ae46fa17e3212abd20a41","event_uuid":"0fe53288-22e4-4d08-b1bd-f166b4d9a118","position":{"commit_sha":"c8673cd455b5bbaa10773078f98dce63119d