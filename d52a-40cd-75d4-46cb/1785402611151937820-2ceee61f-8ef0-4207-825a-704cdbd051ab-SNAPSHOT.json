{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1785402611151937820,"compiled_state":{"alias":"fragrant-tainted-lice","assignee":"","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"7fc96b2772dee382da3714c5cf0f582927ebe6e9","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: d52a-40cd-75d4-46cb","material: 4e85bc775d6e329c","model: claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 10","review-phase: planning","rebar-version: 0.10.1 (7fc96b277-dirty)","regver: f9bb73223e5d6715","verified-at-sha:36411da47406367750c82abd4fbf57bdc767cb95","dep af1bf328c5d571f832f6310a5b870514fcda1db801228e266378a2607e4c3188 src/rebar/llm/evals/eval_solver.py","dep f54780c0651f2040ba4967977745ae52cfe58cfc054b1e33994105f93387828a src/rebar/llm/plan_review/fidelity_spot_eval.py","dep 7fc951c6bb7d39e86d50478b0dc92281a55115a983c535fb3713876487bee20f src/rebar/llm/plan_review/pass1.py","dep 4e7fc7f3247bc8b2d99b6bd644d024bd5361cebb84176d08542ede4e0d694ec1 src/rebar/llm/plan_review/passes.py","dep d13dfb8a9b81b557209ccf1a5cdbccadd7157ae33f2fa91deb7a5dc072f73cd5 src/rebar/llm/plan_review/prerequisites.py","dep 63a3e53155ebd3285f2b6f87ec1864ad569c288fe02077022af1feab8eb07608 src/rebar/llm/plan_review/production_batch_runner.py","dep de35895bb8af98df0abdbd0d5d52473089647d7d82d0eb780319d12877c2e346 src/rebar/llm/plan_review/sidecar.py","dep 2df9866406e8c86eb42d0ab2cd18dbf943ca779c2a1996c9e0c33ec1150a162f src/rebar/llm/plan_review/sizing.py","dep 4f693d09eb6619c4788aebbfb304045b0f5667020a1e52504c8b74f79468ba6f src/rebar/llm/workflow/criterion_preview.py","dep 1c6120102afb2a23b459faae04099cd51f