{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787107240725663330,"compiled_state":{"alias":"churlish-fruited-dassie","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"8cd6e6ec03d301eeced8141e194e95f412e3b59c","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: fd48-7a80-33e9-4400","material: 010398b5a7b1a339","material-part: children 647ea2107ca5072f 0","material-part: description 757b820b5e8d89b4 7985","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact a8f3648957849301 2","material-part: ticket_id fc34c4784a7683d5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (8cd6e6ec03)","regver: 1da3feeb7c09e17f","verified-at-sha:8cd6e6ec03d301eeced8141e194e95f412e3b59c","plan-material-pin: prerequisite 73b2-6194-c430-45ab dfc72871a2d53f4b","dep 6561a5b610c332cf9d55e21108144f788cdca154bb74242ff2f7da0f4a0cd1b3 src/rebar/_commands/claim.py","dep f0254426ac28e7028e87ea78341df2f569ef56ac90b4324bb7366b4b27da1e3c src/rebar/_commands/transition.py","read-set: 7","read-path: src/rebar/_cli/__init__.py","read-path: src/rebar/_commands/claim.py","read-path: src/rebar/_commands/transition.py","read-path: tests/interfaces/facades/test_cli_argparse.py","read-path: tests/interfaces/lifecycle/test_close_ref_target_80af.py","read-path: tests/scripts/test_dependency_audit.py","read-path: tests/unit/test_transition_force_flag_24f7.py","currency-basis: file_impact"],"material_fingerprint":"010398b5a7b1a339","merged_log_commit":"8cd6e6ec03d301eeced8141e194e95f412e3b59c","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787104824109303000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":19,"unsigned":0},"authorship_ledger":[{"content_hash":"08a64d6a101d56c08a876cdd5daf4b15456649778f05636ee314a4f9627444e4","event_uuid":"9871db77-246a-476c-90be-31da90295b16","position":{"commit_sha":"0d1b76541cc133663ca23e5c76bcf73bdb74993b","position":"1787088868798723001-9871db77-246a-476c-90be-31da90295b16"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fd074cb6ea68df62d3272306667d4496acb796ac22dd292f869aafc0e35b7166","event_uuid":"936415bf-4705-4b58-8a92-4a1eac88ead1","position":{"commit_sha":"86af54c48578bbedb5730c8b410571b6aba5853b","position":"1787088875573158001-936415bf-4705-4b58-8a92-4a1eac88ead1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5e079601efc5e6354b0caa35fa8d31dc01bacdea7350fc9bad4fe48e0c3663a4","event_uuid":"62f48512-d273-421e-a960-8a2e4a6db700","position":{"commit_sha":"351eb434d16cf1a8392c5e6e164510b1fb163498","position":"1787089835802237001-62f48512-d273-421e-a960-8a2e4a6db700"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b reb