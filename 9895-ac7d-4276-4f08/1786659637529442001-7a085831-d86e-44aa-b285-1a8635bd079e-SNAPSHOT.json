sh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c3f6df7648f85a7af6c6bde2100192268745af297df9be67090f878f9cce2444","event_uuid":"110f9a3a-32ff-4dac-ad52-6c19f175503e","position":{"commit_sha":"bce887cf98959cbb61d11d5fa5415ec73bb542e9","position":"1786550408077790815-110f9a3a-32ff-4dac-ad52-6c19f175503e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785010497576298001,"creation_channel":"cli","deps":[{"link_uuid":"a3a4865a-69de-4cd0-9ba2-092142003190","relation":"relates_to","target_id":"e369-a449-4773-48fb"}],"description":"# Live-validate the Jira Data Center adapter against the real client instance\n\n## Context / Problem\n\nEpic `e369` verifies the Data Center adapter against a Dockerized Jira from the Atlassian SDK, because\nAtlassian stopped issuing DC trial licenses on 30 March 2026 and publishes no official DC OpenAPI spec. That\nharness proves REST v2 semantics, but it cannot prove behavior specific to the client's actual deployment:\ntheir Jira version, workflow/transition names, custom fields, permission scheme, link types, and user-directory\nconfiguration.\n\n## Approach\n\nWhen sandbox access to the real self-hosted instance exists (a scratch project on the client's Jira, or a\ndeveloper license generated from their existing commercial license via my.atlassian.com), run rebar's\nlive-validation harness pattern from ADR 0037 — guaranteed bilateral teardown, deterministic matrix — against\nit, and record the deltas from the Dockerized baseline.\n\nThis is filed as an idea rather than a child story of `e369` because its precondition is access rebar does not\ncontrol, and a ticket that cannot be finished in-session would fail the plan-review gate's measurability\ncriterion. Promote it to a story once access is confirmed.\n\n## Acceptance Criteria\n\n- [ ] a scratch project on the real instance is reachable and its Jira version recorded\n- [ ] the reconcile convergence + idempotence pass from `e369` runs green against it\n- [ ] every delta from the Dockerized baseline (transition names, custom fields, permission errors, link types)\n      is recorded as a comment and, where it changes behavior, filed as a follow-up ticket","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"reconciler","managed_refs":[["relates_to","e369-a449-4773-48fb"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"110f9a3a-32ff-4dac-ad52-6c19f175503e","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"reverts":[],"status":"closed","tags":[],"ticket_id":"9895-ac7d-4276-4f08","ticket_type":"task","title":"Live-validate the Jira Data Center adapter against the real client instance","verify_commands":[]},"source_event_uuids":["6ebf0d21-30dc-4454-9fc4-6e3e15a186a0","a3a4865a-69de-4cd0-9ba2-092142003190","94863a4a-a53f-4cb1-96b7-be4c0527da8c","110f9a3a-32ff-4dac-ad52-6c19f175503e"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659637529442001,"uuid":"7a085831-d86e-44aa-b285-1a8635bd079e"}