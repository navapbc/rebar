bullet (`failure.sanitize_diagnostic({\"exception_type\": type(exc).__name__, **dict(getattr(exc, \"diagnostic\", {}) or {})})`) and the budget-diagnostic test bullet","norm_id":"n5c6d3001143de3f7","priority":0.3667,"reason":"default-advisory","recalled":false,"scenarios":["exception_type is not in _ALLOWED_FIELDS → every failed agentic verdict's diagnostic loses the exception type, and the new test still passes"],"severity":null,"suggested_fix":"Add the `exception_type` assertion to the budget test. Place `exception_type` after the `**exc.diagnostic` spread so the exception's own diagnostic cannot override it.","tier":"LLM","validity":0.6667,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"na","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Parametrize the diagnostic-propagation test over both `LLMBudgetExhaustedError` and `RunawayToolLoopError` so both failure paths are shown to preserve `requests`/`tool_calls`.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e","T9"],"criteria":["E6","E1"],"decision":"dropped","decision_margin":-0.7437,"drop_reason":null,"evidence":["Context: \