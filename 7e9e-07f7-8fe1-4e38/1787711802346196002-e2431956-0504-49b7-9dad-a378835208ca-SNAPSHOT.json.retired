05aaa5839ddf2a0442048e6de7a593ea352dd60094e3298d35d4075068d0a3 src/rebar/llm/structured_run.py","dep 9f4927a7764791947ec5cf6db4fc2c37c464f85ee66354741e64fb82974dd247 src/rebar/llm/workflow/gate_dispatch.py","dep absent tests/unit/test_header_delivery.py","dep absent tests/unit/test_llm_headers.py","dep absent tests/unit/test_run_correlation.py","read-set: 8","read-path: src/rebar/llm/anthropic_model.py","read-path: src/rebar/llm/providers.py","read-path: src/rebar/llm/runner.py","read-path: src/rebar/llm/spec_scan.py","read-path: src/rebar/llm/structured_run.py","read-path: src/rebar/llm/tracing.py","read-path: src/rebar/schemas/completion_verdict.schema.json","read-path: src/rebar/schemas/review_result.schema.json","currency-basis: file_impact"],"material_fingerprint":"0b5a1defb9207248","merged_log_commit":"95387192861c7ab4e411937d81debcefd3a2e2a8","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787711802312986000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":5,"unsigned":0},"authorship_ledger":[{"content_hash":"dbcd3a0c3ad78c0d576394e6a35f7ec6ae068d8a26b8ccd6963afa9b93be40aa","event_uuid":"16980469-c7a8-43c9-a9f7-e0c81a9862ef","position":{"commit_sha":"02603f26142c11d8ccffc2a75ac0d77c4294f017","position":"1787705146183189001-16980469-c7a8-43c9-a9f7-e0c81a9862ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4f3dfa7772239b9932f7c2cb7bf30dafffcbffd4fa884cdd677d2dd77a7eac44","event_uuid":"be5fe873-4902-4f79-9a9b-b1c3ea2664a0","position":{"commit_sha":"92a8eeac20a96eb201a221dc243d10e779cbac5e","position":"1787705397604704001-be5fe873-4902-4f79-9a9b-b1c3ea2664a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"70f004d92dc6094d4b88a2e9473570b1c439336df8c4092f2dfec53e5a36fbc9","event_uuid":"4e2a6237-6501-4e7b-858e-b81c0e9a79a7","position":{"commit_sha":"fb54f18cdd16d550d7174e6ce2f2b687ff148972","position":"1787705580177913001-4e2a6237-6501-4e7b-858e-b81c0e9a79a7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"382aae63d406efdc7f9c9a0778b9c61f750745b420ba827983f944c489fca057","event_uuid":"1395c03a-5d89-4fde-8da6-9eeb71c9ef11","position":{"commit_sha":"d0c59832bf7e173575e7b74f890c0e081a7dcc4a","position":"1787706515039057001-1395c03a-5d89-4fde-8da6-9eeb71c9ef11"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f0bfe7505cb2c1edf55fa5cda409d71644dfe3884d116db55096a9f07f9a39ee","event_uuid":"9d2d676d-707b-4545-86f0-64e5b9b22aae","position":{"commit_sha":"6b20e33dd0c03f9c30cc7d3ee13f3a8c7543aae0","position":"1787711802346196001-9d2d676d-707b-4545-86f0-64e5b9b22aae"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787705146183189001,"creation_channel":"cli","deps":[{"link_uuid":"4e2a6237-6501-4e7b-858e-b81c0e9a79a7","relation":"relates_to","target_id":"b2a3-c8cb-cdda-4c70"}],"description":"## Context / Problem\n\nOperators who run rebar's gate operations through an OpenAI-compatible gateway (set via\n`llm.base_url`) have that gateway reporting to an observability backend such as Langfuse.\nrebar sends no request metadata, so every gate call arrives anonymous: it cannot be\nattributed to rebar, grouped into one trace per gate run, or tied back to the ticket and\nsigned verdict that produced it.\n\nrebar already reserved the field for this. `src/rebar/schemas/review_result.schema.json` and\n`src/rebar/schemas/completion_verdict.schema.json` each declare `trace_id` as\n`[\"string\",\"null\"]`, described as \"Langfuse trace id when tracing is enabled; null\notherwise\", while `src/rebar/llm/runner.py:259` and `:719` pass `trace_id=None`\nunconditionally. The correlation identity was specified and never implemented.\n\nThe existing OTLP path (`src/rebar/llm/tracing.py:196`, `setup_tracing`) is a different\nmechanism and is unchanged by this epic: it exports rebar's own spans directly to Langfuse.\nThis epic serves the deployment where the gateway, not rebar, feeds the backend.\n\n## Approach\n\nAdd one generic, operator-configured request-header surface on `LLMConfig`, delivered\nthrough pydantic-ai's `ModelSettings.extra_headers`, whose values may interpolate\nenvironment variables (`${env:VAR}`) and rebar-supplied per-run values (`${run:trace_id}`,\n`${run:ticket_id}`, `${run:operation}`).\n\nRationale for this shape:\n\n- **One generic dict beats named per-vendor knobs.** A dedicated \"trace header name\" field\n  would force rebar to ship a vendor default, hard-coding one gateway's dialect. A generic\n  dict with substitution carries LiteLLM's `x-litellm-trace-id`, Helicone's\n  `Helicone-Session-Id`, or an internal gateway's own names equally well. rebar ships no\n  vendor header name in code or defaults; vendor names appear only as documentation\n  examples, keeping the feature portable across supported client shapes.\n- **`ModelSettings.extra_headers` beats patching httpx clients.** It is upstream-supported\n  (`pydantic_ai/settings.py`, documented for OpenAI, Anthropic, Bedrock, Google and others)\n  and rebar already has a pure assembly seam at `src/rebar/llm/structured_run.py:338`\n  (`build_model_settings`) feeding `src/rebar/llm/runner.py:567`. Patching transport instead\n  would require touching two separate httpx constructions\n  (`src/rebar/llm/providers.py:295` and `src/rebar/llm/anthropic_model.py:155`) and would\n  still miss non-httpx providers.\n- **Static and per-run headers are one feature, not two.** A constant header is a dict entry\n  without a placeholder; per-run correlation is a dict entry with one. One code path, one\n  test surface.\n\nHeader values are a credential-bearing surface: both vendor SDKs merge caller headers last,\nso a caller-supplied `Authorization` silently displaces the real key. Validation and\nredaction are therefore delivered scope, not follow-on work.\n\n## Out of scope\n\nNo rebar-owned root span, no unification of rebar's own OTLP spans with the gateway's\nrecords, and no W3C `traceparent` injection. The 32-hex lowercase id format is chosen so\nlater work can carry a real OTel trace id without a schema or format migration.\n\n## Acceptance Criteria\n\n- [ ] An operator can configure arbitrary request headers for gate LLM calls without editing\n      rebar source, and no gateway vendor's header name appears in rebar's shipped code or\n      defaults; checked by a test asserting the shipped default is empty and by a test\n      asserting no vendor header-name constant exists under `src/rebar/llm/`.\n- [ ] A header value can reference an environment variable so a gateway credential is never\n      required in a committed config file; checked by a test resolving `${env:VAR}` from a\n      monkeypatched environment.\n- [ ] All LLM calls within one gate run carry the same correlation value, and two runs carry\n      different ones; checked by a test capturing headers across the calls of one simulated\n      run.\n- [ ] A produced gate verdict names the correlation value in its existing `trace_id` field\n      instead of `null`; checked by asserting `trace_id` on a produced verdict and validating\n      it against `review_result.schema.json`.\n- [ ] A configured header value never appears in logs, diagnostics, or the\n      `provider_provenance` record written into verdicts and sidecars; checked by a test\n      asserting a sentinel value is absent from captured log output and from the serialized\n      provenance record.\n- [ ] Header names and values that could forge authentication or inject protocol bytes are\n      rejected at config resolution with a named error; checked by parametrized tests over\n      the rejected set.\n\n## Child decomposition\n\n- A **configuration** child owns the `headers` field, its resolution across the CLI, env and\n  file layers, `${env:...}` interpolation, and the name/value validation that rejects\n  authentication and protocol-injection headers. It delivers criteria 1, 2 and 6.\n- A **run-correlation** child owns minting the per-run identity at the gate run boundaries\n  and populating the verdict `trace_id` field. It delivers criterion 4.\n- A **delivery** child owns `${run:...}` interpolation and placing resolved headers on the\n  wire through `extra_headers`, gated on a configured `base_url`, together with the\n  redaction guarantee at every emission point. It delivers criteria 3 and 5, and depends on\n  both children above.\n- A **documentation** child records the operator-facing recipe and security guidance, and\n  depends on the delivery child.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/headers.py","reason":"the new header module the epic delivers"},{"path":"src/rebar/llm/config.py","reason":"the configuration surface"},{"path":"src/rebar/llm/structured_run.py","reason":"the delivery seam"},{"path":"docs/config.md","reason":"the operator-facing documentation"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["relates_to","b2a3-c8cb-cdda-4c70"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"7e9e-07f7-8fe1-4e38","ticket_type":"epic","title":"Configurable LLM request headers with per-run correlation for gateway observability","verify_commands":[]},"source_event_uuids":["16980469-c7a8-43c9-a9f7-e0c81a9862ef","be5fe873-4902-4f79-9a9b-b1c3ea2664a0","4e2a6237-6501-4e7b-858e-b81c0e9a79a7","1395c03a-5d89-4fde-8da6-9eeb71c9ef11","9d2d676d-707b-4545-86f0-64e5b9b22aae"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787711802346196002,"uuid":"e2431956-0504-49b7-9dad-a378835208ca"}