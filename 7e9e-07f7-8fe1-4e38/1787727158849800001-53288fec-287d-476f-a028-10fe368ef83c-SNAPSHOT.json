{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787727158849800001,"compiled_state":{"alias":"mercurial-fascinated-canvasback","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"537456586d45ab68476671f156a1786c265dc937","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 7e9e-07f7-8fe1-4e38","material: 3cc014b66b4fbe5e","material-part: children 44db75ab22b819b2 4","material-part: description f79a8f4c6dfdbcaf 7749","material-part: description_boxes 8b6fa01313ce51af 0","material-part: file_impact 838b2913f26a3569 4","material-part: ticket_id d7c7c2e197cf39e5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (537456586d45)","regver: aa61189569d34126","verified-at-sha:5a6f1be02ad3a864912b449990f1ab22b85f7c6c","plan-material-pin: child 26ae-041f-dcc4-4279 5821242ab8609516","plan-material-pin: child 6cd0-0786-4de8-415e 947ea0459139d6a7","plan-material-pin: child 98b6-efa8-bf15-4760 0f90d725fdf444a4","plan-material-pin: child ee8a-6355-2e8f-4da3 26b2a95bb01b175d","dep 8a25a4d9f1a4c1af0d1c29192b84b6f7291f8a48a3607c746ec88c12551f3c67 docs/config.md","dep 181d8f4db89457aec25b9720cb2f790d9aa48d0b1b057fd88b5fae9787bffbb1 docs/llm-framework.md","dep c90f094a008ee21b8d44d9b0489b587c6790f37e6beb58f49875c7f5cd4ec406 src/rebar/llm/capabilities.py","dep 82871f6d02df80876871d86d68fb0f33b6e9b24db1b99b9adaf03ed9faff3a43 src/rebar/llm/config.py","dep absent src/rebar/llm/headers.py","dep 80b9512dec12684e22c73f9aa8cd840c48ace4dcf19975be1b90659316bc5264 src/rebar/ll