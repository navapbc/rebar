keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"505e0fec002528969e30694648adf07e6106d67bd0781b61706a88c0dd30c4b5","event_uuid":"00d5a9a1-9781-4e62-b95d-2a37ab0d0bda","position":{"commit_sha":"87dc7db0f857a79e2d9c77e2501b2e2565a40540","position":"1787724873085399001-00d5a9a1-9781-4e62-b95d-2a37ab0d0bda"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f5bff7ad8b8cfcd843f36793ba3dd7ebfa45812a3cc21569fe8e8cd6c6c8a49d","event_uuid":"32066a13-dbbb-4124-96c8-911a0a53a490","position":{"commit_sha":"87dc7db0f857a79e2d9c77e2501b2e2565a40540","position":"1787724877855700001-32066a13-dbbb-4124-96c8-911a0a53a490"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-240_agent","claim_remote_session":null,"claimed_session":"06f3f99e-d9f9-40f8-a094-ac8d1c624cfd","comments":[],"created_at":1787705146183189001,"creation_channel":"cli","deps":[{"link_uuid":"4e2a6237-6501-4e7b-858e-b81c0e9a79a7","relation":"relates_to","target_id":"b2a3-c8cb-cdda-4c70"}],"description":"## Context / Problem\n\nOperators who run rebar's gate operations through an OpenAI-compatible gateway (set via\n`llm.base_url`) have that gateway reporting to an observability backend such as Langfuse.\nrebar sends no request metadata, so every gate call arrives anonymous: it cannot be attributed\nto rebar, grouped into one trace per gate run, or tied back to the ticket and signed verdict\nthat produced it.\n\nrebar already reserved the field. `src/rebar/schemas/review_result.schema.json` and\n`src/rebar/schemas/completion_verdict.schema.json` each declare `trace_id` as\n`[\"string\",\"null\"]`, described as \"Langfuse trace id when tracing is enabled\", while\n`src/rebar/llm/runner.py` hardcodes `None` at every site emitting it. The correlation identity\nwas specified and never implemented.\n\n## Approach\n\nAdd one generic, operator-configured request-header surface on `LLMConfig`, delivered through\npydantic-ai's `ModelSettings.extra_headers`, whose values may interpolate environment variables\n(`${env:VAR}`) and rebar-supplied per-run values (`${run:trace_id}`, `${run:ticket_id}`,\n`${run:operation}`). `${run:operation}` resolves to exactly one of the two canonical rebar\nidentifiers that open a gate scope — `review-plan` or `verify-completion`. `review-code` is\ndeliberately absent: it opens no gate scope, which is why the omit-on-absent rule exists.\n\n- **One generic dict beats named per-vendor knobs.** A dedicated \"trace header name\" field\n  would force a vendor default, hard-coding one gateway's dialect. A generic dict with\n  substitution carries LiteLLM's `x-litellm-trace-id`, Helicone's `Helicone-Session-Id`, or an\n  internal gateway's names equally well. rebar ships no vendor header name in code or defaults;\n  vendor names appear only as documentation examples, keeping the feature portable.\n- **`ModelSettings.extra_headers` beats patching httpx clients.** One insertion at rebar's\n  existing pure assembly seam (`structured_run.py:338`, `build_model_settings`, feeding\n  `runner.py:567`) covers every provider that supports the field. Patching transport would need\n  edits at both `providers.py:295` and `anthropic_model.py:155` and still miss non-httpx\n  providers. Headers are inert on Bedrock at the pinned 1.107.2 — its model module references\n  `extra_headers` zero times despite `settings.py` listing it — a limitation the `base_url`\n  gate already excludes and the documentation records.\n- **Static and per-run headers are one feature.** A constant header is a dict entry without a\n  placeholder; per-run correlation is a dict entry with one. One code path, one test surface.\n\n**The load-bearing capability is verified, not assumed.** Against the pinned pydantic-ai\n1.107.2: `extra_headers` is declared `dict[str, str]` in `pydantic_ai/settings.py`, and\n`models/openai.py` reads it at `:1001` and forwards it at `:1034`. A throwaway spike drove\nrebar's own `ProviderSession.model_for(\"openai:gpt-4o\")` with `base_url` set, through\n`_build_openai` and `_RebarOpenAICompatibleProvider`, intercepting at the\n`httpx.AsyncHTTPTransport` seam `providers.py` documents: the request reached\n`<base_url>/chat/completions` carrying both supplied headers verbatim, with the provider's own\n`Authorization` intact. The mechanism reaches the wire on the exact path `llm.base_url`\nselects, and adding headers does not displace provider auth.\n\nHeader values are credential-bearing: both vendor SDKs merge caller headers last, so a supplied\n`Authorization` silently displaces the real key. Validation and redaction are delivered scope.\n\n## Out of scope\n\nNo rebar-owned root span per gate run, and no W3C `traceparent` injection.\n\nThe correlation id is read from the active OpenTelemetry span when one is recording at the gate\nboundary, and minted otherwise. Be precise about what that does and does not buy: rebar opens\nno root span, so at that boundary nothing is normally recording and the value IS minted. The\nspans `tracing.py` exports are the per-candidate ones, opened later inside each model request,\neach its own trace root. **This epic therefore does not make the gateway header share a trace\nwith rebar's own exported spans** — that alignment requires the run-level root span, which is\nthe deferred follow-on. Reading an existing span costs nothing and is correct whenever an\nenclosing span does exist, today from a caller-owned span and later from a rebar-owned one.\n\n## Acceptance Criteria\n\n- [ ] An operator can configure arbitrary request headers for gate LLM calls without editing\n      rebar source, and no gateway vendor's header name appears in shipped code or defaults;\n      checked by a test asserting the shipped default is empty and a test asserting no vendor\n      header-name constant exists under `src/rebar/llm/`.\n- [ ] A header value can reference an environment variable so a gateway credential is never\n      required in a committed config file; checked by a test resolving `${env:VAR}` from a\n      monkeypatched environment.\n- [ ] All LLM calls within one gate run carry the same correlation value, and two runs carry\n      different ones; checked by a test capturing headers across the calls of one run.\n- [ ] A produced gate verdict names the correlation value in its `trace_id` field instead of\n      `null`, on both gate surfaces; checked by asserting `trace_id` on a plan-review verdict\n      validated against `review_result.schema.json` and on a completion verdict validated\n      against `completion_verdict.schema.json`.\n- [ ] A configured header value never appears in logs, diagnostics, or the\n      `provider_provenance` record written into verdicts and sidecars; checked by a test\n      asserting a sentinel is absent from captured log output and the serialized record.\n- [ ] The header names `authorization`, `x-api-key`, `cookie`, `host` and\n      `proxy-authorization` (case-insensitive) and any value containing CR, LF or NUL are\n      rejected at config resolution with a single named error; checked by parametrized tests\n      over exactly those names and those three characters.\n- [ ] A header whose `${run:...}` substituend is absent — any operation outside a gate run,\n      including `review-code`, which opens no gate scope and has no ticket — is omitted\n      entirely rather than sent empty; checked by a test asserting the header is absent from a\n      standalone op's resolved headers.\n- [ ] The operator-facing surface is documented: the config key with its three layers and\n      precedence, the `${env:...}`/`${run:...}` grammar and its closed vocabulary, the rejected\n      header names, and a gateway recipe covering at least two distinct gateways so no vendor\n      reads as the supported one; checked by grep-based parity assertions over `docs/config.md`\n      and `docs/llm-framework.md`.\n\n## Child decomposition\n\n- A **configuration** child owns the `headers` field, its resolution across the CLI, env and\n  file layers, `${env:...}` interpolation, and the name/value validation that rejects\n  authentication and protocol-injection headers. It delivers criteria 1, 2 and 6.\n- A **run-correlation** child owns the per-run identity at the gate run boundaries — read from\n  the active OTel span when recording, else minted — and populates the verdict `trace_id`. It\n  delivers criterion 4.\n- A **delivery** child owns `${run:...}` interpolation and placing resolved headers on the wire\n  through `extra_headers`, gated on a configured `base_url`, with the redaction guarantee at\n  every emission point and the omit-on-absent rule. It delivers criteria 3, 5 and 7, and\n  depends on both children above.\n- A **documentation** child records the operator-facing recipe, the provider limitation and the\n  security guidance. It delivers criterion 8 and depends on the delivery child.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/llm/headers.py","reason":"the new header module the epic delivers"},{"path":"src/rebar/llm/config.py","reason":"the configuration surface"},{"path":"src/rebar/llm/structured_run.py","reason":"the delivery seam"},{"path":"docs/config.md","reason":"the operator-facing documentation"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","b2a3-c8cb-cdda-4c70"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"00d5a9a1-9781-4e62-b95d-2a37ab0d0bda","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"7e9e-07f7-8fe1-4e38","ticket_type":"epic","title":"Configurable LLM request headers with per-run correlation for gateway observability","verify_commands":[]},"source_event_uuids":["31d51d3d-8a81-4605-9aac-ca7a7b3e6db5","9138b2b1-fb9e-4fde-b52e-5778a8e0e309","069089c6-46fe-414f-9b14-15c9d074d123","cc79ba1a-352a-461d-9e04-01321c8c45d1","b5cb9e57-0698-499e-b3c6-3a32306c0551","636daa45-d80a-4c6c-b5dc-676d2e282202","0673d44f-2a27-4dcd-96d8-d1cf4df9ae59","efb5e46a-04ed-436f-8c6c-526c5d79e4f4","3da06e75-7b75-4173-84f8-9e0729da0ee6","4fa5ee2e-d980-4c2a-8e10-fb9a44b9dd7c","9591525e-6425-4b90-a31a-ace8b1ce2d1e","f7c27237-3da1-417b-87a5-15d10a12e648","00d5a9a1-9781-4e62-b95d-2a37ab0d0bda","32066a13-dbbb-4124-96c8-911a0a53a490"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787727158849800001,"uuid":"53288fec-287d-476f-a028-10fe368ef83c"}