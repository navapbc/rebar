35fa","impact":0.67,"is_primary":null,"location":"Outcome ('Run selection, filter, mode cap, and global safety limits before any lifecycle or remote effect'); Plan step 5; AC line 2 and AC line 5","norm_id":"n967f870724097551","priority":0.469,"reason":"default-advisory","recalled":true,"scenarios":[],"severity":"major","suggested_fix":"Have the planner emit the full pre-cap mutation/disposition set for the shadow comparison against legacy's pre-cap compute_mutations output, and represent the cap as a separate deterministic partition step that reuses the existing _mode_sort_key ordering — so cap-before-lifecycle-eligibility holds without changing the mutation SET the shadow compares.","tier":"LLM","validity":0.7,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"yes","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"no","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"low","reversibility":"moderate","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P5"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["src/rebar/_engine/rebar_reconciler/run_differs.py: 0ad4-9f1c-09f6-4760 & 7bd6-3aa1-dbeb-42c5 (no ordering edge)","src/rebar/_engine/rebar_reconc