rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"56c8352d9444edaa49296f5a36cd7482ce52a0513e0477e9c3fe3cb4ba87ab05","event_uuid":"99ed116d-4e1f-4907-850b-79ca7a6da583","position":{"commit_sha":"8f88939e3f65550f8b2ef959594d0878e5daaa9f","position":"1788417792113720001-99ed116d-4e1f-4907-850b-79ca7a6da583"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ff4fa32cbd9eb2b9fbbaf10fa7925a44f2d8f88ec7cb34a021adbad89050146d","event_uuid":"df35ea11-dd2a-4dd8-a584-e97930357ed9","position":{"commit_sha":"5c6cb0da20bfed9d994a1500ef4ccc1ef788c430","position":"1788418023966852001-df35ea11-dd2a-4dd8-a584-e97930357ed9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"771c228b0f907467dabe44996cb5a250361e54c7187a2f00695305a9f6382a01","event_uuid":"d753943c-6d2c-4e8c-9440-c483307a316d","position":{"commit_sha":"f1502a1fc10b14055c2b1ec8201a634ddc85dcd2","position":"1788418033123134001-d753943c-6d2c-4e8c-9440-c483307a316d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"completion_expectation":"required","created_at":1788321940311525834,"creation_channel":"mcp","deps":[{"link_uuid":"da681990-420d-482a-a1e9-3f45f49c0140","relation":"blocks","target_id":"67aa-eb04-8814-4975"},{"link_uuid":"64ced4ae-7126-4a2a-bb96-e760a031b146","relation":"relates_to","target_id":"66bb-05f4-7561-445f"},{"link_uuid":"1ee42baa-22a9-4f28-b018-5e70939f2dfc","relation":"relates_to","target_id":"735e-26d2-672b-4fd8"}],"description":"## Context / Problem\n\nThe sibling selector writes a labeled candidate manifest — per criterion, the candidates\nwith their direction, tier, supporting signals and rank. Nothing yet turns that into files\nthe eval runner can consume, and the format is not free-form: `validate_eval_spec(strict=True)`\nrejects a spec lacking an explicit `epochs`, a satisfiable `at_least(k)` gate, a\n`coverage_threshold` in [0, 1], a non-empty `scorers` list with a registered deterministic\nscorer, a balanced dataset, or a non-empty `gold_set` whose entries each carry `input` and\n`label` (`eval.py:252-272`, `eval.py:288-300`). Each dataset case must also carry a payload\nfield beyond the metadata keys (`eval.py:249-250`).\n\nTwo constraints cannot be met by transcription. A criterion may yield candidates on only one\nside of the fire/no-fire axis, failing the balance rule (`eval.py:252-255`); and a stale file\nfrom an earlier run would survive for a now-skipped criterion, keeping a retired assertion in\nthe suite.\n\n## Approach\n\nAn emitter that reads the manifest and writes one `.eval.yaml` per criterion into a working\ndirectory for the sibling admission runner. It issues no model call and reads NOTHING beyond\nthe manifest — a pure, deterministic function of the manifest rows.\n\n**Case payloads are DERIVED, not transcribed.** The selector's candidate row\n(`fixture_selection.py:33-38`) carries only `criterion`, `direction`, `norm_id`, `tier`,\n`rank`, `signals`, `escaped_defect`, `abs_margin`, `review_event_uuid` — no plan prose, no\n`expect`, no `corpus`, no case `id`, no gold material. The emitter derives every emitted field\nfrom those row fields by a fixed rule, with no model call:\n\n- `expect` (dataset) and `label` (gold) come from the row's `direction`: `fire` → `finding`,\n  `no_fire` → `pass`. This is the only fire/no-fire → validator-axis mapping.\n- `id` is `<prompt_id>-<direction>-<rank>`, `prompt_id` =\n  `criteria.ids.criterion_prompt_id(criterion)`; unique because fire/no_fire ranks are\n  namespaced by direction.\n- `corpus` is the constant `rebar`; `criterion` is the row's `criterion`.\n- `input` is a deterministic, model-free provenance descriptor rendered from the row's stable\n  fields (its `criterion`, `direction`, `tier`, sorted `signals`, and `norm_id` (fire) or\n  `review_event_uuid` (no_fire) and `rank`). It is NOT authored prose and NOT resolved from any\n  store; it satisfies the validator's payload-field requirement and gives the gold entry a\n  stable, unique reference.\n- `gold_set` is one `{input, label}` entry per emitted case (same `input`, `label` = the case's\n  `expect`), so gold material exists precisely when a criterion contributes dataset cases.\n\n**Emitted spec fields.** Each file carries the field set of the committed\n`.rebar/evals/plan-review-project-portability.eval.yaml`: `prompt`, `model`, `epochs: 3`,\n`gate: at_least(2)`, `coverage_threshold: 1.0`, a `scorers` list holding the registered\ndeterministic scorer `emits_valid_findings`, a `dataset` of `{id, corpus, criterion, expect,\ninput}` cases, and a `gold_set` of `{input, label}` entries. `epochs: 3` with `at_least(2)`\nmatches every shipped spec.\n\n**Case selection.** At most 8 cases per criterion, at most 4 per side, taken in the manifest's\nrecorded rank order, so the output is a deterministic function of the manifest.\n\n**Balance guarantee.** A criterion that cannot supply at least one candidate row on EACH side\nemits NO file and is counted `skipped-unbalanced`. Because dataset cases and their gold entries\nboth derive from candidate rows, a one-sided criterion — and equally a criterion present only\nas a `zero_candidate` row — yields no balanced dataset and no gold material, so it never reaches\nthe validator. The sibling self-healing loop counts `skipped-unbalanced` as a failed attempt,\nso a persistently unbalanced criterion is recorded by that child's `unreliable-criterion:`\nbreaker rather than vanishing silently.\n\n**Output lifecycle.** Each run writes a fresh temporary tree and atomically replaces the\nworking directory, so no file survives for a criterion that has become skipped or already has\na spec.\n\n## Scope\n\nThe emitter module under `src/rebar/llm/evals/`, its YAML serialization, the deterministic\nper-field derivation above, the per-side case selection, the balance refusal and the emitter\nreport. It reads the manifest and writes only into its own working directory.\n\n## Non-goals\n\n- Deciding which candidates qualify, their tier, or their rank; the selector owns that.\n- Writing into `.rebar/evals/` or admitting a spec; the admission runner owns both.\n- Any model call, or any read of the ticket store, git, or the review corpus.\n- Emitting for a criterion that already has a spec (`eval.py:69-78` resolves a project spec as\n  a replacement, so a mined file would delete the packaged cases).\n\n## Testing\n\nUnit tests over the serializer and the balance refusal using synthetic manifests, invoking the\nreal `validate_eval_spec(spec, strict=True)` on every emitted file rather than asserting on YAML\ntext. Every assertion is deterministic because no model is involved.\n\n## Acceptance Criteria\n\n- [x] Every emitted spec returns zero errors from `validate_eval_spec(spec, strict=True)`;\n      verified by `pytest` invoking the real validator over each emitted file.\n- [x] An emitted spec carries `epochs: 3`, `gate: at_least(2)`, `coverage_threshold: 1.0`;\n      verified by `pytest` asserting those three values on a spec from a synthetic manifest.\n- [x] An emitted spec's `scorers` list holds an entry naming `emits_valid_findings`; verified\n      by `pytest` asserting that scorer name is present.\n- [x] Each dataset case's `expect` is `finding` for a `fire` candidate, `pass` for a `no_fire`\n      candidate; verified by `pytest` asserting the mapping on a mixed-direction manifest.\n- [x] Each gold_set entry's `label` equals its case's `expect`; verified by `pytest` asserting\n      label equality on the same spec.\n- [x] A criterion whose manifest holds candidates on only one side emits no file and is counted\n      `skipped-unbalanced`; verified by `pytest` asserting the path is absent and the report\n      names the criterion.\n- [x] A criterion present with no candidate row on either side (e.g. only a `zero_candidate`\n      row) emits no file and is counted `skipped-unbalanced`; verified by `pytest` asserting the\n      path is absent and the report names the criterion.\n- [x] Given a manifest with 6 ranked candidates on one side (the other side non-empty), the\n      emitted dataset holds the first 4 in rank order; verified by `pytest` asserting the case\n      ids and order.\n- [x] A file from a previous run for a criterion absent from the current manifest does not\n      survive the next run; verified by `pytest` asserting the path is absent after the second\n      run.\n- [x] Two consecutive runs over the same manifest emit byte-identical output; verified by\n      `diff -r` of the two output trees exiting 0.\n- [x] The emitter completes with the repository's network guard active; verified by `pytest`\n      running it under that guard.\n\n## Definition of Done\n\n`make lint`, `make typecheck`, `make test` pass; a run over the real manifest emits specs that\nall pass the strict validator; the diff touches nothing under `.rebar/evals/` or\n`src/rebar/llm/reviewers/`.\n\n## Budget\n\n**$0.** Emission is a pure, model-free function of the manifest.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/evals/fixture_emit.py","reason":"Emitter: reads the labeled candidate JSONL manifest and writes one strict-valid .eval.yaml per balanced criterion into a working tree it atomically replaces; per-side case selection (<=8/criterion, <=4/side, manifest rank order), balance refusal counted skipped-unbalanced, and the emitter report. Flat sibling of fixture_selection.py (the evals/ package has no fixture_mining/ subpackage; a split would create <100-LOC files banned by module policy)."},{"path":"tests/unit/test_fixture_emit.py","reason":"Happy-path oracle: a balanced synthetic manifest emits one file that passes validate_eval_spec(strict=True) with the standard field set."},{"path":"tests/unit/test_fixture_emit_heldout.py","reason":"Held-out oracle: strict-validator over emitted files, balance/gold refusal -> skipped-unbalanced, per-side cap in rank order, stale-file removal across runs, byte-identical idempotence, and network-guard execution."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["blocks","67aa-eb04-8814-4975"],["parent","65dd-e93b-666a-4caa"],["relates_to","66bb-05f4-7561-445f"],["relates_to","735e-26d2-672b-4fd8"]],"no_file_impact_reason":"","parent_id":"65dd-e93b-666a-4caa","parent_status_uuid":"df35ea11-dd2a-4dd8-a584-e97930357ed9","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["plan-review","evals","fixtures"],"ticket_id":"092c-a664-2477-4d83","ticket_type":"story","title":"Emit validated per-criterion eval specs from the labeled candidate manifest","verify_commands":[]},"source_event_uuids":["5cdc49c9-427d-463d-92a3-9b0b807f80f7","5886c583-f46b-4ddc-84f5-60e367237403","20cc6d0c-ad01-40d2-b293-e26f8e4cd70e","898b8f5d-310f-478c-80fa-8022fd67d31d","636708c2-b71c-429a-bdc7-25695e72a23d","2a0ae45f-b7dc-4883-afd9-8c97e5faf4b7","9338e549-e166-4c45-bcac-60d1dc4bf021","64ced4ae-7126-4a2a-bb96-e760a031b146","1ee42baa-22a9-4f28-b018-5e70939f2dfc","99ed116d-4e1f-4907-850b-79ca7a6da583","df35ea11-dd2a-4dd8-a584-e97930357ed9","d753943c-6d2c-4e8c-9440-c483307a316d"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788424606307726001,"uuid":"ebb1d5ee-8d23-414a-84c8-0f9db1dd6581"}