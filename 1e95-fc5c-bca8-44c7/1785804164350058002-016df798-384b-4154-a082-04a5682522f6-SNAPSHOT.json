p.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"018cc6f004a6f3321d450895c4731c4d73b4a525ce3d8ecde9cabf7ee973af73","event_uuid":"93bf8f4f-42f2-4031-980e-d98b5a2d2cb4","position":{"commit_sha":"4418d233dc9460bbaf8255a9fb891ce1bfaaae4d","position":"1785804163744263001-93bf8f4f-42f2-4031-980e-d98b5a2d2cb4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"afa288f10d531dabeb2b818caabd0722a0d5d1e89f82b632a69a5139caa0a8db","event_uuid":"22466254-a5cf-4efd-901f-5af856e62c85","position":{"commit_sha":"4418d233dc9460bbaf8255a9fb891ce1bfaaae4d","position":"1785804164350058001-22466254-a5cf-4efd-901f-5af856e62c85"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785640057899916001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\nUpper-bound wall-clock assertions in tests are the proven CI flake class under runner contention (19d7, 5e94, edfe, 85c3). 15 sites scanned: 13 upper-bound in scope, 2 lower-bound out of scope; 11 currently unescaped. Detector prototype (regex + escapes) caught all, 0 FPs, and found one site manual scan missed (test_lock_stale_reclaim.py:127).\n\n## Approach\nDET BLOCKING code-review criterion scanning tests/** for upper-bound wall-clock asserts. Escapes: '# timing: hang-guard — <reason>' line marker, or the existing perf-lane CI-exclusion guard '@pytest.mark.skipif(os.environ.get(\"CI\") == \"true\", ...)' on the test (the idiom the benchmark tests in tests/scripts/reducer/test_reducer_cache.py:245-249 already use — NOTE: the '@pytest.mark.benchmark' marker alone is NOT an escape — it is registered (pyproject.toml, informational) but no CI invocation filters it out (the suite runs -m 'not integration and not external'), so a benchmark-marked test still executes on CI; the skipif(CI) guard is what actually removes runner-contention flake risk). Migrations (proven by experiment): tests/unit/test_config_perf.py:201 -> spy config._ordered_layers, the miss-path filesystem walk load_config only calls on a _RESULT_CACHE miss (reset_config_cache seam; regression sim caught 10/10); tests/unit/test_enrich_drain.py:261 -> exactly one pending_enrichment call + zero drain/spawn. Remaining 9 sites get markers with reasons. Optional follow-on: migrate reducer benchmarks to _api.replay_events spy to restore CI coverage (currently benchmark-skipped). Seed implementation from /tmp/exp4_detector.py; proxy rule: spy the MISS-PATH function, never tomllib (warm TOML cache evades parse spies). Self-exclusion: the detector's own unit-test file carries live upper-bound asserts as RED fixtures, so it is structurally excluded via the sibling guards' EXCLUDED_FILES idiom (scripts/check_comment_hygiene.py:57 — the exact failure b047 recorded when its fixtures self-tripped the comment-hygiene guard).\n\n## Scope\n- detector as DET code-review criterion (review-bot checkout) or CI lint per gate conventions\n- tests/unit/test_config_perf.py:201, tests/unit/test_enrich_drain.py:261 migrations\n- markers on the 9 hang-guard sites\n\n## Testing\nDetector unit tests: unescaped upper-bound assert -> finding; hang-guard marker escape -> silent; skipif(CI) guard escape -> silent (bare '@pytest.mark.benchmark' without the skipif guard -> still a finding); lower-bound assert -> silent. Migrated tests: regression simulation goes RED (cache cleared per call / drain forced), warm path GREEN.\n\n## Acceptance Criteria\n- [ ] Detector blocks new unescaped upper-bound wall-clock asserts in tests/** with a teaching message naming both escapes (hang-guard marker; skipif-CI perf-lane guard).\n- [ ] Both migration sites assert counting proxies (miss-path spies), proven RED under regression simulation.\n- [ ] All remaining in-scope sites carry reasoned markers; detector run on the tree is clean.\n- [ ] Detector has unit tests covering fire, both escapes (marker; skipif-CI guard — and bare benchmark marker NOT escaping), and lower-bound exclusion.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"scripts/","reason":"wall-clock test detector"},{"path":"src/rebar/config.py","reason":"_resolve miss-path spy seam"},{"path":"src/rebar/llm/enrich_drain.py","reason":"pending_enrichment call seam"},{"path":"tests/","reason":"migrate two slow suites"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","2f4c-7e5c-e782-4e97"]],"no_file_impact_reason":"","parent_id":"2f4c-7e5c-e782-4e97","parent_status_uuid":"93bf8f4f-42f2-4031-980e-d98b5a2d2cb4","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["gates","flakes"],"ticket_id":"1e95-fc5c-bca8-44c7","ticket_type":"story","title":"Wall-clock upper-bound assert detector (DET blocking code-review criterion) + 2 site migrations","verify_commands":[]},"source_event_uuids":["cd60e209-822d-4d41-9e1a-525b3fe2811e","86eb1e42-2812-49e0-9320-68654b0b34b7","08752847-be77-44a4-a279-d6c49ba26085","2e19bb29-9798-4d9c-abf2-2ed909aed441","f8407651-73a6-4aac-8a60-052d4377aff4","ac793990-d2ec-4909-8fec-a255919c7fe4","700ef2b0-b89f-42a7-aebb-d7e3a1b605c5","e880840e-04bc-4a45-b9