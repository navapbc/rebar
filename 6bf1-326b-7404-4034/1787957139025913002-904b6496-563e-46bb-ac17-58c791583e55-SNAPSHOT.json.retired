{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787957139025913002,"compiled_state":{"alias":"scathing-custommade-bobcat","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"25e2ffbb0f69266a0b5e5a54a1592bc2cb6e1fcc","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 6bf1-326b-7404-4034","material: d47dec85d4ab4004","material-part: children 647ea2107ca5072f 0","material-part: description d9606500772c63e0 7253","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact daa51267514c7010 4","material-part: ticket_id ecb465d8481d59ec 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (25e2ffbb0f69)","regver: aa61189569d34126","verified-at-sha:ae203145fa39a153c21b6cba8b25cb5679849ec9","dep 79a6b9d76284fcf2c36dc18f207a4280bdccdd9aedc33e425493883b8dce019b scripts/check_repo_root_from_tracker.py","dep 636b42d0f1632764d85e49348ae640e6a929391d808430cb51efc114835f7f85 src/rebar/_commands/compact_trigger.py","dep 213e172b3a2b1a9d9401a2a6661f9ff237ff9b0a43a155decaf78a390a556ce1 tests/unit/test_relocated_store_repo_root.py","dep 7f3aaeefaef13bb12f91cd4bff850e8c07338ea4215d36d91ac499656c9caa1b tests/unit/test_repo_root_from_tracker_guard.py","read-set: 9","read-path: infra/compose/Dockerfile.mcp","read-path: infra/scripts/mcp-entrypoint.sh","read-path: scripts/check_repo_root_from_tracker.py","read-path: src/rebar/_commands/compact.py","read-path: src/rebar/_commands/compact_plan.py","read-path: src/rebar/_commands/compact_trigger.py","read-path: src/rebar/_config_resolvers.py","read-path: src/rebar/_proc.py","read-path: src/rebar/config.py","currency-basis: file_impact"],"material_fingerprint":"d47dec85d4ab4004","merged_log_commit":"ae203145fa39a153c21b6cba8b25cb5679849ec9","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787956027421663000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":19,"unsigned":0},"authorship_ledger":[{"content_hash":"91e067e69ed9567e4286a8bbbc15cfc3a395db1943b987da2514ccd6bc54ded4","event_uuid":"2f4dabbb-ce2d-4fa8-9c5c-8045eb5a6c03","position":{"commit_sha":"e7fdcd9a2892660f8b92a700e7619eb34377a3c9","position":"1787948058889198001-2f4dabbb-ce2d-4fa8-9c5c-8045eb5a6c03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"25490fa951f43c8725c1102f94ad8771e43e362b706c5a22360cbc7e7b1334bc","event_uuid":"095ee8c5-bb25-4fca-99d6-fbef024a9d8c","position":{"commit_sha":"e7fdcd9a2892660f8b92a700e7619eb34377a3c9","position":"1787948073198300001-095ee8c5-bb25-4fca-99d6-fbef024a9d8c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"140175903a18d45f665a2d068932e05afa3f4c5c46fe352ef518ca4ada398b96","event_uuid":"d9d74ddd-2728-4cd1-83d1-0c4eaff353a0","position":{"commit_sha":"1ad3154c06c7ed7d96f495f9858c2bf97e307740","position":"1787948235032564001-d9d74ddd-2728-4cd1-83d1-0c4eaff353a0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"63d7177e47454a035ab07608dd1bfdc9b98baf88458c95338b1ab80eb1