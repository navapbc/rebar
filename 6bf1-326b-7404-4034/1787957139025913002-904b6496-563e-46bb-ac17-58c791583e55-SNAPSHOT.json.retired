954013100413950-0ffdf8d6-fe4b-42c4-aeee-8ee296e6d8fd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"52df034bd4bcbcd00e62b5a839a3753d6750a1b15ea69c8a742289df846009b6","event_uuid":"d0c0ed26-92da-4b31-b184-f661e5384983","position":{"commit_sha":"ccd776f9d8310e4288f2273999c3b126ec1d82dd","position":"1787954079652821001-d0c0ed26-92da-4b31-b184-f661e5384983"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"46348ea13c73082bf57b5c980b77984a85713fae32cf707dc7a583a6cc7959c2","event_uuid":"bbcdb51c-2a37-44f9-9cb3-d2d922e83983","position":{"commit_sha":"530fd5b52ad5537bf216a28c78bff67f6ec7e030","position":"1787954240690501001-bbcdb51c-2a37-44f9-9cb3-d2d922e83983"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"8ac933d84f993d8a33687459b2f04383b3cab95cbc7ae3dfa43392c9a35fa5ee","event_uuid":"86949ee4-3f5f-45b0-86c4-faff6c5322e1","position":{"commit_sha":"677cdad4174fb754536c61d1af53484c39502850","position":"1787954923747379177-86949ee4-3f5f-45b0-86c4-faff6c5322e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e8beb5a6e6b501cb8bcb321f2a2521e3cc3d39897cba1c6617c53619eaaaec3c","event_uuid":"a0171184-04be-4995-9888-def243a58788","position":{"commit_sha":"d59ea28cd530b6e0db7a6c14fbd21493550d8861","position":"1787955099515683001-a0171184-04be-4995-9888-def243a58788"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5c3e50e8aaefc426fea28a8ec927f5b4254ea67ce8d8ffbb06ca098ad2529002","event_uuid":"e5f94069-f2b1-493c-8387-66b1d9a14b1c","position":{"commit_sha":"24b6551de5f9fafb63e61c87c50c389d6ff8de9a","position":"1787955529148591001-e5f94069-f2b1-493c-8387-66b1d9a14b1c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d483aa40e3c1444b0ac25b0f26bce68fa5244aad29a61970541e633c39c98a42","event_uuid":"0a6ff9c0-cc0f-483f-bbbb-2dbf97f8e4e6","position":{"commit_sha":"4298e48bda30d5498d35f3d1021751924025404f","position":"1787956027491502001-0a6ff9c0-cc0f-483f-bbbb-2dbf97f8e4e6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3206b94c47decb17763c7e9fc3c1d4001ae63a49a2646b80298dcd03d21cc39b","event_uuid":"8a92259a-7ad7-4bf1-bb22-1e98fd65640d","position":{"commit_sha":"917bc3cf0c505fe9269ba8e2b91dbe1c2fd9c2aa","position":"1787956846918132464-8a92259a-7ad7-4bf1-bb22-1e98fd65640d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d845245486f5432b7a97daf9dad6e0222c92b50d0a5dacf1a7af6b0ec7a78706","event_uuid":"7dec05aa-5c7d-412e-819b-f504fdb8d5ef","position":{"commit_sha":"30870897a46ca33b9e36128b906952d58d7cf5a9","position":"1787957115798396001-7dec05aa-5c7d-412e-819b-f504fdb8d5ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4ced92eecebe9fffd1d800c7b191b1be1aa97897530f7f8f7283857b4a48ff74","event_uuid":"d2fc7d46-d6fe-4010-8318-838305994cac","position":{"commit_sha":"f964048d6388918ea6046f6c9817a7d6b69edd4c","position":"1787957139025913001-d2fc7d46-d6fe-4010-8318-838305994cac"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"RCA (rebar-debug, Phase 1 complete) — DISPOSITION: ESCALATE (design decision required; not auto-landed)\n\nSTEP 0 / ORIENT\n- 0(a) tracker sweep: no duplicate. This ticket is the single tracker for the deferred run_sweep site. Sibling injurious-pugnacious-azurevase (c0f6, in_progress) covers a DIFFERENT set (str()/realpath()/abspath() variants), not this site.\n- 0(b) reported-against floor: filed as a split-off from auspicial-friended-merganser (2ec7, Gerrit 2326, 98f21fbc). Suspect path src/rebar/_commands/compact_trigger.py unchanged on origin/main since (verified).\n- 0(c) worktree at origin/main 82a0d5cd328f (= origin/main).\n\nPROVEN ROOT CAUSE (dynamic, runtime-confirmed)\nrun_sweep(tracker) at src/rebar/_commands/compact_trigger.py:222 hardcodes repo_root = os.path.dirname(tracker) and passes it EXPLICITLY to compact.compact_all_cli([], repo_root=repo_root). compact_all_cli reads the [compact] config via config.compose_config(repo_root).compact (threshold, COMPACTION_HORIZON_NS). On a RELOCATED store (REBAR_TRACKER_DIR outside the checkout — the deployed MCP topology: store at /var/gerrit/site/mcp-tickets, code at /app) the store's parent has no rebar.toml, so the sweep reads DEFAULT compaction config (threshold=10, horizon=1800s) instead of the code-root config. tracker_dir stays correct (REBAR_TRACKER_DIR wins verbatim), so the sweep folds the RIGHT tickets by the WRONG rule. Impact is milder than the parent's gate-disable: no gate is silently turned off; a non-default [compact] config is ignored.\n\nPROOF (discriminating experiment, runtime)\nRelocated store (REBAR_TRACKER_DIR outside checkout), code-root rebar.toml sets [compact] threshold=1, COMPACTION_HORIZON_NS=0. Seeded a fresh 4-comment task.\n- run_sweep(tracker): SNAPSHOT NOT written — read default threshold/horizon from dirname(tracker), folded nothing (RED).\n- On the SAME store, compact_all_cli([], repo_root=<code root>) DID fold (SNAPSHOT written).\nOnly variable = repo_root (dirname(tracker) vs code root). Confirms repo_root resolution is the sole cause; rules out \"events not foldable\" / \"store misresolved\".\n\nDEFECT LEGITIMACY: defect. The relocatable store is a SUPPORTED feature (EV-3b; tracker_dir_override; scripts/check_repo_root_from_tracker.py). Same construct class as auspicial-friended-merganser (closed Fixed) and chuffy-arbored-goldfish (closed Fixed). This site is the ONE the AC#4 guard explicitly sanctions/defers.\n\nDEFECT ORIGIN (caused_by): the run_sweep dirname(tracker) line was introduced by commit d2dea317ec94 (\"Trigger compaction from the close, out of band\"), rebar-ticket 1fde-becd-942a-4351 (gaudy-gangrenous-basilisk). git blame -L222,222 is unambiguous and non-carrier (that commit WROTE the line); the site was born wrong (never handled a relocated store), so class = plan_defect. NOTE / divergence from the whole-class default: the parent auspicial attributed to 65e3-1fc6-5f3b-4c67 (stab-bunch-foyer), which introduced the transition.py gate site — a DIFFERENT commit. Each site of the shared construct class was shipped by its own commit; this site's is 1fde. caused_by link recorded (6bf1 -> 1fde).\n\nWHY ESCALATE (the deferred design decision is real, not stale)\nAC#1 requires the detached-child path to receive a correct code root, and AC#3 requires ZERO sanctioned sites — so the sync path alone cannot close this. The blocker is genuine and specific: WHAT durable code root should the detached child receive?\n- maybe_compact already HAS a resolved repo_root (transition_close: str(config.repo_root(repo_root))), and spawn_detached already supports threading extra argv strings (its docstring documents the optional-sentinel pattern) — so the mechanical plumbing exists.\n- BUT the two supported topologies want DIFFERENT sources:\n  * Deployment (truly relocated store, STABLE /app via REBAR_ROOT): the child should get maybe_compact's repo_root (=/app). Correct and durable.\n  * Local `make worktree` (store co-located via a .tickets-tracker SYMLINK; EPHEMERAL worktree code root): transition_close's repo_root = git-toplevel-of-cwd = the ephemeral worktree, which dies with the worktree. Today _spawn_detached_sweep deliberately hands the child StorePaths(tracker).canonical, and dirname(canonical) = the DURABLE main checkout — which is CORRECT locally. Naively threading maybe_compact's repo_root would point the outliving child at a dying worktree (a re-run of the durability class of bugs 3198/93a9), degrading to default config after teardown.\nThere is no existing helper returning the right durable code root for BOTH topologies; reconciling them (argv vs env; spawning-repo-root vs canonical-store-parent; how to stay durable across worktree teardown) is a config-root-discovery / process-detachment SEMANTICS decision. That exceeds the behavior-preserving/localized bar auspicial's other 8 sites met, exactly as this ticket's description anticipated.\n\nRECOMMENDED DISPOSITION\nTreat as a small design ticket, not a mechanical mirror. Recommended design: give run_sweep an optional second argv param (spawn_detached sentinel \"\"), and have maybe_compact pass a DURABILITY-RESOLVED code root — REBAR_ROOT/explicit when set (covers the deployment), else fall back to dirname(StorePaths(tracker).canonical) (covers the local co-located-symlink worktree, preserving today's correct behavior). run_sweep threads it into compact_all_cli; then remove the # repo-root-ok: sanction (AC#3 -> zero allowlisted sites) and add the guard-clean assertion. RED->GREEN oracle: (1) the relocated-store fold proven RED above (sync path), (2) a _spawn_detached_sweep argv-threading unit assertion (mirrors test_a_detached_sweep_child_is_handed_the_canonical_store_tracker) for the detached path. This needs a human design sign-off on the durable-root resolution rule before implementation; per agent policy I am not landing it unilaterally.\n\nSCOPE/CALLERS: run_sweep has exactly two callers — maybe_compact (sync trigger=always) and the detached child entry via spawn_detached (string ref). Blast radius is contained to compact_trigger.py + the spawn argv contract. No new dependency, no new capability.","timestamp":1787948361662822001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"IMPLEMENTED — Gerrit change 2344 (45dba2bb841b), pushed for review, NOT submitted.\n\nSEQUENCING CHECK (mandatory precondition). injurious-pugnacious-azurevase (c0f6-0fc9-fe48-41bc) — the sibling that also declares scripts/check_repo_root_from_tracker.py in its file impact — has LANDED on origin/main as 1049da8f61b8 (\"Fix config root in composer save-time advisories\"). Its guard extension (the str()-wrapped store argument) and its _store/sync.py sanctions are already merged; the ticket is merely not yet closed. So there was no concurrent editor of the guard and no sequencing conflict. This change edits only the guard's DOCSTRING (draining the run_sweep sanction from the \"sanctioned sites today\" list), which does not touch the detection logic c0f6 added. Note c0f6 also split the realpath()/abspath() family out to flowered-basaltic-beagle (088b-e4c1-050c-4516) — disjoint from this site, which is the bare dirname(tracker) form.\n\nTHE STALE BLOCKER, CORRECTED. This ticket's description and its RCA both concluded that a correct code root needed a spawn-contract change, on the premise that \"there is no existing helper returning the right durable code root for BOTH topologies\". That premise is false, and the description has been corrected so the next reader is not misled:\n  * Deployment: REBAR_ROOT is exported UNCONDITIONALLY (infra/compose/Dockerfile.mcp:102 ENV; infra/scripts/mcp-entrypoint.sh:294 documents that it is deliberately outside the PAT guard), so repo_root_or_none()'s second precedence arm resolves the code root directly.\n  * Local worktree: _proc.detached_child_cwd (src/rebar/_proc.py:127-150) ALREADY anchors the detached child's cwd at dirname(realpath(tracker)) — the durable main checkout, with realpath load-bearing precisely to escape the ephemeral worktree's .tickets-tracker symlink (bugs 3198/93a9). So the git-toplevel arm lands on the durable code root, preserving today's correct local behaviour.\nThe RCA's own worry — \"naively threading maybe_compact's repo_root would point the outliving child at a dying worktree\" — is an argument AGAINST the spawn-contract design, not against resolution. The rejected alternative is recorded in the commit message: threading the root reimplements repo_root_or_none() at the spawn site, where the parent's root is the dying worktree.\n\nTHE FIX. One line in the child: `repo_root = config.repo_root_or_none()` at compact_trigger.py run_sweep, replacing `os.path.dirname(tracker)`; the `# repo-root-ok:` sanction is removed. snapshot_repo_root() was NOT used — its snapshot-specific \".\" fallback (_config_resolvers.py:444-462) is the fatherly-incoherent-mare outage shape and run_sweep does not want it. A stale comment at the _spawn_detached_sweep call site, which justified handing over the canonical tracker partly because \"inside run_sweep this argument also becomes repo_root = dirname(tracker)\", was corrected too — the canonical-tracker rationale stands on the cwd-durability ground alone.\n\nTESTS (RED-first, mutation-checked). tests/unit/test_relocated_store_repo_root.py gains three: the sweep folds per the repo's non-default [compact] block on a relocated store; the root handed to compact_all_cli IS the resolved code root (pinned at the seam); and a repo config that folds nothing still folds nothing. Config comes from a rebar.toml FILE, never REBAR_COMPACT_THRESHOLD / REBAR_COMPACTION_HORIZON_NS, because an env read is root-independent and would hide the bug. tests/unit/test_repo_root_from_tracker_guard.py gains the AC#3 assertion that no config-root site is deferred behind a sanction.\n\nNote on the contrast control: the first draft pivoted it on the threshold and was WRONG — select_tickets' BACKFILL arm selects any snapshot-less ticket with at least one foldable event whatever the threshold, so it folded anyway. The real discriminator is the HORIZON (the default 1800 s puts just-written events out of reach, which is exactly why the buggy root folded nothing). Rewritten to pivot on the horizon and documented in the test.\n\nMUTATION RESULTS — 3 mutants, 3 killed.\n  M1 re-seed the exact defect, dirname(tracker): BOTH behaviour tests fail. Killed.\n  M2 drop the resolver and hand repo_root=None (let compose_config discover downstream): the FOLD test still PASSES — the outcome is accidentally right in-test — and only the seam assertion catches it. Killed by the seam test alone. This is the \"a different guard rescues it\" trap; without the seam test the mutant survives.\n  M3 dirname(realpath(tracker)), the plausible near-miss: both fail. Killed.\nRestored: green.\n\nGATES (all local, worktree venv; no MCP agentic op): make lint PASS; make typecheck PASS (683 files); pytest tests/unit/test_module_size_contract.py 4 passed; scripts/check_complexity_baseline.py --check new=0 increased=0; scripts/check_repo_root_from_tracker.py rc=0 with zero deferred config-root sites; the three touched unit modules 50 passed.\n\nNOT CLOSED: change 2344 awaits LLM-Review +1 and Verified +1.","timestamp":1787953578696269001}],"created_at":1787939368830168001,"creation_channel":"cli","deps":[{"link_uuid":"68b72607-20e1-49d7-b365-004004eb59a0","relation":"discovered_from","target_id":"2ec7-be89-9b01-496a"},{"link_uuid":"d9d74ddd-2728-4cd1-83d1-0c4eaff353a0","provenance":"explicit","relation":"caused_by","target_id":"1fde-becd-942a-4351"},{"link_uuid":"0ffdf8d6-fe4b-42c4-aeee-8ee296e6d8fd","relation":"relates_to","target_id":"2e25-ab1b-aa25-4733"},{"link_uuid":"86949ee4-3f5f-45b0-86c4-faff6c5322e1","relation":"relates_to","target_id":"9d96-2677-aae6-4a18"},{"link_uuid":"8a92259a-7ad7-4bf1-bb22-1e98fd65640d","relation":"relates_to","target_id":"2a84-1c44-0a44-4d2e"}],"description":"## Summary\n\nSITE: `src/rebar/_commands/compact_trigger.py` `run_sweep(tracker)` — `repo_root = os.path.dirname(tracker)`, sanctioned `# repo-root-ok:` in the AC#3 guard (`scripts/check_repo_root_from_tracker.py`) as the ONE deferred CONFIG-ROOT site.\n\nCONTEXT: split off from auspicial-friended-merganser (2ec7-be89-9b01-496a), which fixed the 8 clean `os.path.dirname(tracker)`-as-config-root sites. `run_sweep` is the DETACHED-CHILD compaction entry point: it is spawned with cwd == the canonical STORE and inherits only `tracker` as its handle. This site was deliberately DEFERRED by auspicial because the detached child needs a DURABLE code-root and the two supported topologies (relocated store vs. co-located worktree symlink) disagree on how to derive it.\n\nIMPACT (milder than the parent's AC#1): on a relocated store (`REBAR_TRACKER_DIR` — the deployed MCP topology, store `/var/gerrit/site/mcp-tickets`, code checkout `/var/gerrit/site/mcp-code`) `run_sweep` reads DEFAULT compaction config (threshold 10, 1800 s horizon) instead of the project's `[compact]` block. Compaction still runs; it folds the right tickets by the WRONG rule. No gate is disabled.\n\n## The answer — RESOLVE a DURABLE root (operator-approved; supersedes the deferral)\n\nGive the detached compaction child a DURABILITY-RESOLVED code root via a dedicated leaf resolver, `compaction_child_repo_root(canonical_tracker)` in `_config_resolvers.py`, with precedence:\n\n  explicit `REBAR_ROOT` (realpath) if set  →  else `dirname(canonical tracker)`.\n\n`run_sweep` calls it as `compaction_child_repo_root(StorePaths(tracker).canonical)`. This is correct for BOTH supported topologies WITHOUT depending on the child's cwd:\n\n- **Deployment** (relocated store): `REBAR_ROOT` is exported UNCONDITIONALLY (`infra/compose/Dockerfile.mcp:102` ENV; `infra/scripts/mcp-entrypoint.sh:294` documents that it sits deliberately outside the PAT guard) and names the PROVISIONED CHECKOUT at `/var/gerrit/site/mcp-code`. The first precedence arm resolves a real code root, so the sweep composes from that root's `rebar.toml` instead of the store parent's default rule.\n- **Local `make worktree`** (store co-located via a `.tickets-tracker` SYMLINK, ephemeral worktree): with `REBAR_ROOT` unset the fallback arm returns `dirname(canonical tracker)`, and `StorePaths(tracker).canonical` realpath-resolves the worktree's `.tickets-tracker` symlink back to the DURABLE main checkout's store (`realpath` load-bearing precisely to escape the worktree symlink, bugs 3198/93a9). So the fallback lands on the durable code root without reading the child's cwd at all.\n\nThis is the site auspicial-friended-merganser (Gerrit 2326) deferred; same defect class as injurious-pugnacious-azurevase (Gerrit 2339). The fix removes the `# repo-root-ok:` sanction at the site (relates to ADR 0051 — foreground git maintenance is never detached; this detached child does config resolution only, no git maintenance). It does NOT overlap the realpath/abspath config-root family in flowered-basaltic-beagle (088b-e4c1-050c-4516): this fix routes through `StorePaths.canonical`, not a raw `realpath`/`abspath` wrapper, so it introduces no new per-site realpath decision of that family's kind.\n\n### Rejected alternatives\n\n- **Threading the caller's resolved `repo_root` from `maybe_compact` through the spawn contract**: the parent's root is the DYING worktree — a `make worktree` git-toplevel can be deleted out from under the running detached child, re-running the durability class of 3198/93a9.\n- **`config.repo_root_or_none()`** (explicit > `REBAR_ROOT` > git-toplevel-of-**cwd**): its non-`REBAR_ROOT` fallback reads the child's CWD. That only lands on the durable checkout if the child's cwd happens to be anchored there, so it leans on `detached_child_cwd` behaviour and re-runs the same worktree-durability class if the cwd is a dying worktree toplevel. `dirname(canonical tracker)` is durable independent of cwd.\n- **`snapshot_repo_root()`**: adds a snapshot-specific `\".\"` fallback `run_sweep` does not want (`_config_resolvers.py`); a code root that silently becomes the cwd is the fatherly-incoherent-mare outage shape.\n\n## Acceptance Criteria\n\n- [ ] AC#1 — `run_sweep` resolves the code/config root independent of where the store lives, by calling the dedicated resolver `compaction_child_repo_root(StorePaths(tracker).canonical)` (precedence `REBAR_ROOT` realpath > `dirname(canonical tracker)`): no spawn-contract change, no caller-threaded root, no `repo_root_or_none()` git-toplevel-of-cwd arm, no `snapshot_repo_root()`. Proven by AC#2's seam assertion.\n- [ ] AC#2 — On a relocated store (external `REBAR_TRACKER_DIR`, `REBAR_ROOT` set to the checkout) with a non-default `[compact]` block, `run_sweep` honours it (RED->GREEN), AND the root it hands `compact_all_cli` IS the resolved code root — pinned at the seam, so a fix that merely lands on a root reading the same config by accident is still caught. Config must come from a `rebar.toml` FILE, never `REBAR_COMPACT_THRESHOLD` / `REBAR_COMPACTION_HORIZON_NS`, because an env read is root-independent and would hide the bug. Proved by `tests/unit/test_relocated_store_repo_root.py::test_run_sweep_folds_by_the_repo_compact_config_on_relocated_store` and `::test_run_sweep_hands_the_resolved_code_root_to_the_sweep`.\n- [ ] AC#3 — The `# repo-root-ok:` sanction is removed from `compact_trigger.py`, leaving the guard's allowlist with ZERO deferred config-root sites. The only sanctions remaining are `_store/sync.py`'s `tickets_branch`/`tickets_remote` reads (landed under injurious-pugnacious-azurevase), which name refs in the STORE's own git repo and are legitimately rooted there. Proved by `tests/unit/test_repo_root_from_tracker_guard.py::test_no_config_root_site_is_deferred_behind_a_sanction` and by `python scripts/check_repo_root_from_tracker.py` exiting 0.\n- [ ] AC#4 — The FALLBACK arm is exercised, not just the deployed one: a test with `REBAR_ROOT` UNSET and a real `.tickets-tracker` SYMLINK store proves `dirname(canonical tracker)` resolves the symlink back to the durable checkout and reaches the code root (`::test_run_sweep_resolves_the_code_root_without_rebar_root`), so the local half of the argument above is not merely asserted. The seam is pinned to `dirname(canonical)`, NOT the ephemeral worktree dir.\n- [ ] AC#5 — A config-effect contrast shows the fold is the repo config being read, not an unconditional sweep: the same store and ticket fold NOTHING under a `[compact]` block whose horizon puts the events out of reach. The HORIZON is the discriminator, not the threshold — `_scan_snapshot_state` (`src/rebar/_commands/compact.py`) asks `compact_plan.needs_folding`, whose BACKFILL arm selects any snapshot-less ticket with at least one foldable event whatever the threshold. Proved by `::test_run_sweep_respects_a_repo_config_that_folds_nothing`, which asserts LIVENESS (the sweep actually REACHED `compact_all_cli`) separately from the seam and the no-snapshot outcome — `run_sweep` swallows every exception, so an absent SNAPSHOT would otherwise be satisfied by a crash.\n- [ ] AC#6 — Caused-by attribution: same origin class as the parent (`dirname(tracker)`-as-config-root construct); this site was written by `d2dea317ec94` (rebar-ticket `1fde-becd-942a-4351`), recorded as a `caused_by` link.\n\n## Testing\n\nRun every command from the change's worktree with its venv first on `PATH`.\n\n- `env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest tests/unit/test_relocated_store_repo_root.py tests/unit/test_repo_root_from_tracker_guard.py tests/unit/test_compact_trigger.py -q --color=no` — the relocated-store fold and the seam assertion are RED before the fix and GREEN after; the guard self-test reports no deferred config-root site; the existing trigger suite does not regress.\n- `env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_repo_root_from_tracker.py` — exits 0 on the drained tree (AC#3).\n- Sandboxed mutation check (macOS `sandbox-exec`), each mutant applied then reverted to the fix: (1) re-seeding `repo_root = os.path.dirname(tracker)` returns ALL four run_sweep tests to RED (the bug itself); (2) replacing the resolver with a bare `repo_root = None` leaves the pure-fold test GREEN (`compose_config(None)` rediscovers `REBAR_ROOT`) and is caught ONLY by the three seam-bearing tests — the \"a different path rescues the fold\" case the seam assertion exists for; (3) `os.path.dirname(os.path.realpath(tracker))` (dropping the `REBAR_ROOT` precedence) is killed by the relocated-store tests and survives ONLY the symlink test, demonstrating why both precedence arms are needed.\n- `env PATH=\"$PWD/.venv/bin:$PATH\" make lint && make typecheck` — no regressions.\n- `env PATH=\"$PWD/.venv/bin:$PATH\" python -m pytest tests/unit/test_module_size_contract.py -q --color=no` and `env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_complexity_baseline.py --check` — the CI-only module-size gate and the complexity ratchet stay clean (`new=0 increased=0`).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_commands/compact_trigger.py","reason":"Defect site: run_sweep now resolves a durable code root via compaction_child_repo_root(StorePaths(tracker).canonical) instead of dirname(tracker); the # repo-root-ok: sanction is removed."},{"path":"src/rebar/_config_resolvers.py","reason":"New leaf resolver compaction_child_repo_root(canonical_tracker): precedence REBAR_ROOT(realpath) > dirname(canonical tracker)."},{"path":"tests/unit/test_relocated_store_repo_root.py","reason":"AC#2/#4/#5 run_sweep tests: relocated-store fold + seam pin, REBAR_ROOT-unset symlink fallback, folds-nothing liveness."},{"path":"tests/unit/test_repo_root_from_tracker_guard.py","reason":"AC#3 guard test: no config-root site remains deferred behind a sanction."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","2a84-1c44-0a44-4d2e"],["relates_to","2e25-ab1b-aa25-4733"],["relates_to","9d96-2677-aae6-4a18"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"2f4dabbb-ce2d-4fa8-9c5c-8045eb5a6c03","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"6bf1-326b-7404-4034","ticket_type":"bug","title":"run_sweep detached child derives repo_root from os.path.dirname(tracker), ignoring relocated-store config","verify_commands":[]},"source_event_uuids":["2f4dabbb-ce2d-4fa8-9c5c-8045eb5a6c03","095ee8c5-bb25-4fca-99d6-fbef024a9d8c","d9d74ddd-2728-4cd1-83d1-0c4eaff353a0","25af228c-653a-4d47-9c02-2aecbe3ae187","8252a7f9-c5d0-4acc-a551-d6d3a9ba5d07","da579e15-a172-4873-aecc-a8cfbba36103","61c7cffd-c75d-4553-9a4d-c5b22892fc0d","0ffdf8d6-fe4b-42c4-aeee-8ee296e6d8fd","d0c0ed26-92da-4b31-b184-f661e5384983","bbcdb51c-2a37-44f9-9cb3-d2d922e83983","86949ee4-3f5f-45b0-86c4-faff6c5322e1","a0171184-04be-4995-9888-def243a58788","e5f94069-f2b1-493c-8387-66b1d9a14b1c","0a6ff9c0-cc0f-483f-bbbb-2dbf97f8e4e6","8a92259a-7ad7-4bf1-bb22-1e98fd65640d","7dec05aa-5c7d-412e-819b-f504fdb8d5ef","d2fc7d46-d6fe-4010-8318-838305994cac"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787957139025913002,"uuid":"904b6496-563e-46bb-ac17-58c791583e55"}