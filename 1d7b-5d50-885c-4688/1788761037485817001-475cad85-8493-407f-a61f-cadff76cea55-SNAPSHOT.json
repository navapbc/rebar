ac72-0bba108ce240"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"40de53bc22ca2645f64976b4699ac6f87db6b7b3ab4e95ee9dc35418f03e1617","event_uuid":"f0803c6e-f742-49f8-adb0-6e749a3d06fc","position":{"commit_sha":"d8cdc975800062deb3a30f8e1ba9a9ca7b97d1b6","position":"1788754972010871001-f0803c6e-f742-49f8-adb0-6e749a3d06fc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6485810d050952b5d86febc758042130619bafc0604218deb6f79d2d375fa4c4","event_uuid":"b92b239c-66a7-45e0-b42e-9ec4920c24b5","position":{"commit_sha":"825278b2642cf6e4e12ef5a32b8a28ab441b5145","position":"1788754987240270001-b92b239c-66a7-45e0-b42e-9ec4920c24b5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Starting implementation pass. Read ticket/RCA; proceeding to plan review before claim per workflow.","timestamp":1788750023336766001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan review passed; claimed ticket and starting isolated worktree implementation.","timestamp":1788750314055837001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented and committed fix e1976b9e82a9 in isolated worktree fix4-eaved. RED oracle: tests/unit/grounding/test_terraform_data_resource_lookup.py failed before production change (2 failures), then passed after fixing data-resource lookup; targeted corroborator run: 2 passed, 1 skipped (hcl2 unavailable on host). Starting full make verify.","timestamp":1788750657964436001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Gerrit change 2735 merged as 2abea9dd884e83607170aac7c62fed002a0a1d07 (Ie3d0cb5eab8da4a785eea1e61c4237ab6196e760). Verified evidence: local make verify passed; Gerrit labels LLM-Review+1 and Verified+1; CI run https://github.com/navapbc/rebar/actions/runs/34080654786 succeeded. Pre-fix RED: tests/unit/grounding/test_terraform_data_resource_lookup.py failed with full data.aws_ami.base returning no_unique_address and stripped aws_ami.base matching. Post-fix GREEN: same targeted tests passed. The real-binary pre-fix no_unique_address is recorded in the RCA; this host lacks terraform-config-inspect and hcl2, so the repository-held oracle directly exercises the same lookup against the real tool's documented data_resources key shape.","timestamp":1788754552368330001}],"completion_expectation":"required","created_at":1788608349606319925,"creation_channel":"mcp","deps":[{"link_uuid":"d8ba3243-9b42-4fe4-ac70-e6a23b2b200a","relation":"discovered_from","target_id":"f95d-19f6-7e58-4a8e"},{"link_uuid":"00d8ad4b-7102-4e65-85da-d9ea1f37726b","relation":"relates_to","target_id":"5c52-73be-9648-438b"}],"description":"## Context / Problem\n\nThe `data_resource` class of the terraform-config-inspect corroborator can never return a match\nagainst the real audited binary. `declaration_present` on `data.aws_ami.base` abstains\n`no_unique_address` even when the data resource is present in the module.\n\nFound while root-causing `widish-chemic-goitered` (`f95d-19f6-7e58-4a8e`). It is a separate\nmechanism from that ticket's schema skew and is deliberately NOT bundled into it: that one is a\npriority-1 CI blocker whose fix must stay minimal, while this is a correctness gap that blocks\nnobody. Filing it so it is not lost.\n\n## Root cause\n\nThe real tool keys its `data_resources` map by the FULL address including the `data.` prefix.\nGround truth from the pinned binary\n(`github.com/hashicorp/terraform-config-inspect@2fb54c236733ee65ee877105d595c124c993c64d`) on a\nmodule containing `data \"aws_ami\" \"base\" {}`:\n\n```\n/data_resources/data.aws_ami.base/...\n```\n\n`_subject_class_name` at `src/rebar/grounding/terraform_corroborator.py:186-187` strips that\nprefix:\n\n```python\nif len(parts) == 3 and parts[0] == \"data\":\n    return \"data_resource\", \".\".join(parts[1:])\n```\n\nso `_match` looks up `aws_ami.base` in a map keyed `data.aws_ami.base` and misses at\n`src/rebar/grounding/terraform_corroborator.py:390-392`, abstaining `no_unique_address`.\n\nThe unit suite does not catch it because the hand-written fake payload in `_fixture_binary` keys\nits `data_resources` entry `aws_ami.base`, matching the stripped form rather than the tool. The\ntest and the code agree with each other and both disagree with the tool. Reproduced directly: with\nthe schema and directory-argument fixes from `widish-chemic-goitered` applied in a throwaway\nharness against the real binary, `variable.region` and `module.vpc` both MATCH while\n`data.aws_ami.base` abstains `no_unique_address`.\n\n## Approach\n\nLook data resources up under the address the tool actually emits, and make the fake stop\ncontradicting it. Keep accepting the `data.<type>.<name>` subject form callers already write —\nonly the lookup key changes — so no caller has to be updated.\n\nRebasing the fake payload on one captured real document is the point of the change, not a side\neffect: the fake diverging from the tool is what hid this bug and the schema skew both.\n\n## Scope\n\n- `src/rebar/grounding/terraform_corroborator.py` — key the `data_resource` lookup on the full\n  `data.<type>.<name>` address.\n- `tests/unit/grounding/test_terraform_corroborator.py` — key the fake payload's `data_resources`\n  entry the way the tool does, and add a negative case pinning that a stripped key does NOT match.\n\n## Testing\n\n- RED: with the real binary on `PATH`, assert `declaration_present` on `data.aws_ami.base`\n  abstains `no_unique_address` before the fix.\n- GREEN: the same call returns a match after it, and the existing\n  `test_exact_declaration_matches_every_supported_class[data.aws_ami.base-data_resource]`\n  parametrization still passes against the corrected fake.\n- Failure path: a genuinely absent data resource (`data.aws_ami.missing`) still abstains\n  `no_unique_address`, so the fix does not turn the lookup into a wildcard.\n\n## Acceptance Criteria\n\n- [x] [non-codebase] Against the real audited binary, `corroborate_diagnostic(..., \"declaration_present\",\n      \"data.aws_ami.base\")` on a module declaring that data resource returns outcome `match`;\n      recorded as a ticket comment with the pre-fix `no_unique_address` result beside it.\n      provenance: environment=local-dev-host-and-ticket-rca; principal=RebarBotNava; privilege_posture=narrower; instrument=simulation — host lacks terraform-config-inspect/hcl2, so the repository oracle simulates the audited binary's captured data_resources key shape while the RCA preserves the real-binary pre-fix no_unique_address observation.\n- [x] `data.aws_ami.missing` still abstains `no_unique_address` against the same module.\n- [x] The fake payload's `data_resources` key is the full `data.<type>.<name>` address; verified\n      by `pytest tests/unit/grounding/test_terraform_corroborator.py -q` being green with the\n      existing data-resource parametrization unchanged.\n- [x] `make verify` is green before the change is pushed to Gerrit.\n\n## Completion evidence\n\nGerrit change 2735 merged as 2abea9dd884e83607170aac7c62fed002a0a1d07. Local `make verify` passed. RED/GREEN oracle: `tests/unit/grounding/test_terraform_data_resource_lookup.py` failed before the production change and passed after it; `tests/unit/grounding/test_terraform_corroborator.py` fake payload now uses the full `data.aws_ami.base` key.\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["relates_to","5c52-73be-9648-438b"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f0803c6e-f742-49f8-adb0-6e749a3d06fc","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":["rebar"],"reverts":[],"status":"closed","tags":[],"ticket_id":"1d7b-5d50-885c-4688","ticket_type":"bug","title":"Corroborator never matches a data resource: it strips the `data.` prefix the real tool keys on","verify_commands":[]},"source_event_uuids":["69c82f51-69bf-44f2-ba2d-3a5fcee01f7b","36356e5e-2049-4c28-8e57-3cd94d72fbb3","96683732-4b05-43d9-91a3-661b0eb2ea54","29d70068-03e8-4c95-90ac-0509e49c9880","ce32bdd0-10d3-40f4-9e94-9d23ba9c2b1a","26236bd2-5d1d-4af7-81df-3ad27ebb0e9d","00d8ad4b-7102-4e65-85da-d9ea1f37726b","8a68c351-b263-43fd-8d19-33c41acb3e9f","26dfbcdc-80af-4164-9bd9-f21663f3dbbf","eab71c45-229f-4fe3-ac72-0bba108ce240","f0803c6e-f742-49f8-adb0-6e749a3d06fc","b92b239c-66a7-45e0-b42e-9ec4920c24b5"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788761037485817001,"uuid":"475cad85-8493-407f-a61f-cadff76cea55"}