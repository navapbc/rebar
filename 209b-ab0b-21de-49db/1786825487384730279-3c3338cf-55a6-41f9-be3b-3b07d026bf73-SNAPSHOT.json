"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e43c437aef7e1f3d50535f65e73167e7f80d5f7b393a93354bf9e8d086004c5e","event_uuid":"ca1fb193-5808-4ec9-99d2-7ff50b4530e7","position":{"commit_sha":"b245b84caa1a1a930980a6bcd4166599c26ebd8d","position":"1786824112782675001-ca1fb193-5808-4ec9-99d2-7ff50b4530e7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e10fce5b8b590eb7f9b9ea07340250d45b0ce2e6470ee4c897dd6e12e4b34466","event_uuid":"5c41dd25-05d0-4f98-8854-74cf1229a5e7","position":{"commit_sha":"8773c6c94c04afc206fa9064af8e5d7491528b1d","position":"1786824694153634001-5c41dd25-05d0-4f98-8854-74cf1229a5e7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b939ff767d5a9046a65fa7d899e4d75fd48f684ae6980f922a05a27f60b282ab","event_uuid":"3b296d58-38ec-48de-b454-65ad0aa72979","position":{"commit_sha":"0ba0f8fe9eca6ce5530c7b045aa99b944f9b6729","position":"1786824734138895001-3b296d58-38ec-48de-b454-65ad0aa72979"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4914d5b9f97b6f7499b2920c2ba92fe436cd27172431d0ad308abadbeb145992","event_uuid":"ee72c0b5-6265-4e33-ab2d-086effd4ff47","position":{"commit_sha":"19c0685b7c6a84f18a1fab68fa1199602723daf9","position":"1786825487384730278-ee72c0b5-6265-4e33-ab2d-086effd4ff47"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786807963179337001,"creation_channel":"cli","deps":[{"link_uuid":"ad136018-ae08-467d-9ae9-fd4f92619afa","relation":"discovered_from","target_id":"05b8-4efe-8d58-4c27"},{"link_uuid":"b9f8c2ae-b2ac-4ccb-8f82-a7c3d06ccf59","relation":"depends_on","target_id":"fea4-f98c-f1a2-4168"},{"link_uuid":"2fcd25d9-09d7-405c-b6b3-74ec3d0bc987","relation":"relates_to","target_id":"ef5b-7349-90c0-4fc2"},{"link_uuid":"ee72c0b5-6265-4e33-ab2d-086effd4ff47","relation":"relates_to","target_id":"9af1-a08d-9ea6-48ec"}],"description":"## Problem (finding P0-2a — separate from the seam-conversion work)\nprojects_store.set_project (projects_store.py) accepts ANY string key with no validation:\nit does not call fetcher._validate_project_key, so a syntactically-invalid or malformed\nkey (e.g. \"le-g\", \"\", \"1x\", a key with trailing whitespace) is written to projects.json\nand only fails much later, deep in the reconciler fan-out. A validation guard at write\ntime would have rejected the malformed input that contributed to the incident class\n(05b8-4efe-8d58-4c27).\n\n## Scope note\nThis is a NEW behavior (input validation), NOT a hand-rolled->seam conversion. Filed\nseparately from ticket fea4 (pure seam conversion, now merged) so it can be approved on\nits own. It does NOT modify any shared seam and adds no facade. SYNTACTIC validation ONLY —\nNO live Jira/network call (existence validation is owned by the reconcile preflight, not\nhere).\n\n## Approach\nset_project validates the key with the EXISTING fetcher._validate_project_key (import and\nreuse it — do NOT duplicate the _PROJECT_KEY_RE regex `^[A-Za-z][A-Za-z0-9_]*$`) and\nrejects an invalid key with a clear error and NO file write, BEFORE the record is\npersisted/published. remove_project gets the same guard for symmetry (it can receive an\nunvalidated key). The validation slots in BEFORE B's fsutil.atomic_write + write_lock +\ncommit_and_push_tickets_branch RMW, so a rejected key never persists or publishes. The\nnew ValueError is mapped to a clean RebarError(returncode=2) at the _lib_ops seam\n(bridge_projects_set/remove) — the SAME error contract those consumers already handle for\nremove's absent-key KeyError — so both production consumers surface it cleanly: the CLI\n(_cli/_bridge_commands.py projects set/remove) catches RebarError and prints a non-zero\nerror with no traceback, and the MCP write tools (_mcp_writes.py) raise that same\nRebarError (identical to remove's absent-key path, no MCP code change needed). No\nJira-existence checking here.\n\n## Acceptance Criteria\n- [x] set_project with an invalid key (\"le-g\", \"\", \"1x\", \"LEG \" trailing space) raises a\n      clear error and writes NOTHING (projects.json unchanged / uncreated), verified by\n      `python -m pytest tests/unit/rebar_reconciler/test_projects_store_heldout.py -q`.\n- [x] A valid key (\"REB\", \"PROJ_2\") is still accepted and written unchanged (B's\n      atomic_write/lock/publish path preserved), verified by the same test module.\n- [x] remove_project rejects an invalid key with the same guard, before any mutation.\n- [x] Reuses fetcher._validate_project_key; no duplicated regex, no seam change, no\n      network/Jira call added.\n- [x] The invalid-key rejection surfaces as ONE clean RebarError(returncode=2) / non-zero\n      error (no traceback) through the library, the CLI, and the MCP write tools, verified\n      by `python -m pytest tests/unit/test_bridge_projects_surfaces_heldout.py\n      tests/scripts/bridge/test_bridge_projects_heldout.py -q`.\n\n## Testing\n- RED-first unit tests in tests/unit/rebar_reconciler/test_projects_store_heldout.py: each\n  invalid key raises and leaves projects.json unwritten; a valid key still writes. Run\n  `python -m pytest tests/unit/rebar_reconciler/ tests/scripts/bridge/ -q`.\n- `make lint` and `make typecheck` clean.\n\n## Sequencing\nEdits projects_store.py (+ _lib_ops.py if needed) + tests — same file as ticket fea4, now\nMERGED into origin/main, so this builds on B's seams. This change stacks on B.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/projects_store.py","reason":"set_project/remove_project validate the key via fetcher._validate_project_key before any write/publish"},{"path":"src/rebar/_lib_ops.py","reason":"bridge_projects_set/remove map the ValueError to a clean RebarError(returncode=2) for consumers"},{"path":"src/rebar/_cli/_bridge_commands.py","reason":"CLI projects set/remove catch RebarError and emit a clean non-zero error"},{"path":"tests/unit/rebar_reconciler/test_projects_store_heldout.py","reason":"invalid keys rejected non-zero with no write; valid keys still set/remove"},{"path":"tests/unit/test_bridge_projects_surfaces_heldout.py","reason":"invalid key surfaces as one clean RebarError through library and MCP write tools, writing nothing"},{"path":"tests/scripts/bridge/test_bridge_projects_heldout.py","reason":"CLI set/remove of an invalid key is a clean non-zero error, no traceback, no write"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["depends_on","fea4-f98c-f1a2-4168"],["relates_to","9af1-a08d-9ea6-48ec"],["relates_to","ef5b-7349-90c0-4fc2"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"a3ed50ab-ebcf-4a2b-a74a-4b2dcefb2417","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":[],"ticket_id":"209b-ab0b-21de-49db","ticket_type":"task","title":"Validate project key at write time in projects_store.set_project (reuse _validate_project_key)","verify_commands":[]},"source_event_uuids":["0952b6c7-e8ae-4e23-b1c8-eb1f4efbabfc","4f26f7ab-a8ef-4cc0-a251-059f0bb54a90","a3ed50ab-ebcf-4a2b-a74a-4b2dcefb2417","464cde0b-be2f-4050-ba6b-478b08ba7091","2fcd25d9-09d7-405c-b6b3-74ec3d0bc987","6af0860b-412c-418f-a82a-a005e2a288f2","d3eeb07f-7ad1-441c-8afc-a4d39bbcffef","ca1fb193-5808-4ec9-99d2-7ff50b4530e7","5c41dd25-05d0-4f98-8854-74cf1229a5e7","3b296d58-38ec-48de-b454-65ad0aa72979","ee72c0b5-6265-4e33-ab2d-086effd4ff47"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786825487384730279,"uuid":"3c3338cf-55a6-41f9-be3b-3b07d026bf73"}