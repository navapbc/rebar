19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e3b5f12f0fb902402417a363cf9638be1c9fdb06f97cb84dcb3e82844cdadc0f","event_uuid":"b9f8c2ae-b2ac-4ccb-8f82-a7c3d06ccf59","position":{"commit_sha":"26e24efc572f09b19d32a651cc2810697c1beb60","position":"1786808073013683001-b9f8c2ae-b2ac-4ccb-8f82-a7c3d06ccf59"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786807963179337001,"creation_channel":"cli","deps":[{"link_uuid":"ad136018-ae08-467d-9ae9-fd4f92619afa","relation":"discovered_from","target_id":"05b8-4efe-8d58-4c27"},{"link_uuid":"b9f8c2ae-b2ac-4ccb-8f82-a7c3d06ccf59","relation":"depends_on","target_id":"fea4-f98c-f1a2-4168"}],"description":"## Problem (finding P0-2a — separate from the seam-conversion work)\nprojects_store.set_project (projects_store.py) accepts ANY string key with no validation:\nit does not call fetcher._validate_project_key, so a syntactically-invalid or malformed\nkey (e.g. \"le-g\", \"\", \"1x\", a key with whitespace/casing quirks) is written to\nprojects.json and only fails much later, deep in the reconciler fan-out. A validation\nguard at write time would have rejected the malformed input that contributed to the\nincident class (05b8-4efe-8d58-4c27).\n\n## Scope note\nThis is a NEW behavior (input validation), NOT a hand-rolled->seam conversion. Filed\nseparately from ticket fea4 (pure seam conversion) so it can be approved/prioritized on\nits own. It does NOT modify any shared seam and adds no facade.\n\n## Approach\nset_project validates the key with the EXISTING fetcher._validate_project_key (import and\nreuse it — do NOT duplicate the _PROJECT_KEY_RE regex) and rejects an invalid key with a\nclear non-zero error (and no file write). Consider remove_project symmetry only if it can\nreceive an unvalidated key. Do not add Jira-existence checking here (that is the reconciler\npreflight, ticket a011) — this is syntactic validation only.\n\n## Acceptance criteria\n1. set_project(\"le-g\"/\"\"/\"1x\", ...) exits/raises non-zero with a clear message and writes\n   nothing.\n2. A valid key (\"REB\", \"PROJ_2\") is accepted unchanged.\n3. Reuses fetcher._validate_project_key; no duplicated regex, no seam change.\n\n## Test plan\n- RED unit: set_project with each invalid key raises/exits non-zero and leaves\n  projects.json unwritten; a valid key still writes.\n\n## Sequencing\nEdits projects_store.py (+ tests) — same file as ticket fea4. Sequence AFTER fea4 to avoid\na file conflict (rebase onto it). Approval-gated: this is additional scope beyond the seam\nconversion.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/projects_store.py","reason":"set_project validates key via fetcher._validate_project_key"},{"path":"tests/unit/rebar_reconciler/test_projects_store_heldout.py","reason":"Invalid keys rejected non-zero, no write; valid key writes"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","fea4-f98c-f1a2-4168"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":[],"ticket_id":"209b-ab0b-21de-49db","ticket_type":"task","title":"Validate project key at write time in projects_store.set_project (reuse _validate_project_key)","verify_commands":[]},"source_event_uuids":["3b7511fb-54bd-418c-8770-0f28a3d02b00","83fa6d42-b4d6-484d-bb4d-0b27e564e919","ad136018-ae08-467d-9ae9-fd4f92619afa","b9f8c2ae-b2ac-4ccb-8f82-a7c3d06ccf59"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786816269857709001,"uuid":"c3d4bc37-b6c4-40d5-829f-5b9df75de5ed"}