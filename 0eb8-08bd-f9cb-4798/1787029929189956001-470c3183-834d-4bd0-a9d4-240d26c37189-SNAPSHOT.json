sh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"63dcc19b2f81cc8dd551f0cb4db7fe6a51f9e88fb5ea18937a5c2a996db44d29","event_uuid":"b0a28179-3fd6-4fe7-a1f4-e8135902d100","position":{"commit_sha":"396045e85cd861ba4051bb50c4b9d9a32b32f729","position":"1787027508126068001-b0a28179-3fd6-4fe7-a1f4-e8135902d100"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787027481280829001,"creation_channel":"cli","deps":[{"link_uuid":"b0a28179-3fd6-4fe7-a1f4-e8135902d100","relation":"depends_on","target_id":"34f2-8d32-029c-400b"}],"description":"## Context\nRepository delegation must not blur the boundary between local multi-file persistence and the existing selective tickets-branch publication seam. The ownership and partial-state rules need durable documentation and regression guards.\n\n## Outcome\nFinalize the S1 cutover with ADR 0099 and cross-seam tests proving the existing five-file allowlist, unchanged-pass behavior, rotation floor, and retired-first publication semantics remain intact.\n\n## Plan\n1. Add failing regressions around selective commit staging, unchanged passes, GET rotation, and retired-state publication.\n2. Keep publication in `reconcile_helpers.py`; do not publish each repository checkpoint or broaden staging.\n3. Record repository versus publication ownership, ordered partial-state behavior, rollback, and no-journal/no-format-migration decisions in ADR 0099 and its index.\n4. Run the full binding-state regression set after removing superseded facade persistence branches.\n\n## Testing\nUse existing held-out selective-publication suites plus ADR index checks. Assert repository failures do not cause unrelated tracker staging.\n\n## Acceptance Criteria\n- [ ] Tickets publication stages only the existing five bridge-state files.\n- [ ] An unchanged pass creates no commit.\n- [ ] GET rotation and retired-first failure cases preserve the pre-extraction publication and recovery floors.\n- [ ] Repository checkpoints never publish independently.\n- [ ] ADR 0099 records ownership, ordered partial states, selective publication, rollback, and explicit no-journal/no-format-migration decisions.\n\n## Out of scope\nLifecycle extraction and new interrupted-retirement recovery remain S2/S3.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"docs/adr/0099-binding-store-internal-ownership.md","reason":"Record repository ownership, partial-state durability, publication, and rollback."},{"path":"docs/adr/README.md","reason":"Index ADR 0099."},{"path":"tests/unit/rebar_reconciler/state/test_get_rotation_heldout.py","reason":"Lock rotation publication and failure-floor behavior."},{"path":"tests/unit/rebar_reconciler/state/test_binding_retired_commit.py","reason":"Lock selective retirement publication behavior."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","34f2-8d32-029c-400b"],["parent","5142-4dbf-9469-4672"]],"no_file_impact_reason":"","parent_id":"5142-4dbf-9469-4672","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["rp02","binding-store","adr","tdd"],"ticket_id":"0eb8-08bd-f9cb-4798","ticket_type":"task","title":"RP-02 S1 T3 — Lock persistence ownership and selective publication","verify_commands":[{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/rebar_reconciler/state/test_get_rotation_heldout.py tests/unit/rebar_reconciler/state/test_binding_retired_commit.py","dd_id":"AC1-AC4","dd_text":"Selective publication, unchanged passes, rotation/retirement floors, and checkpoint isolation"},{"command":"env PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/pytest -q tests/unit/test_check_docs_index.py tests/scripts/test_check_adr_numbers.py","dd_id":"AC5","dd_text":"ADR numbering and documentation index"}]},"source_event_uuids":["9cb1a85c-392c-4891-a06f-eb25e589fe5a","ae322769-25fa-44d1-88f5-8be6b32b386d","3d39e3eb-8c45-4511-be22-f230f5c48dae","b0a28179-3fd6-4fe7-a1f4-e8135902d100"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787029929189956001,"uuid":"470c3183-834d-4bd0-a9d4-240d26c37189"}