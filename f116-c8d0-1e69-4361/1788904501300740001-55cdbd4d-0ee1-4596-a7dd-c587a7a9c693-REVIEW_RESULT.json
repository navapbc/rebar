hort":["E3","E5","F4","G5","T6","T9","necessity","project.failure-disposition-contract","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["Context: 'Any secret that lives in BOTH SSM and GitHub Actions must be rotated in both, or CI fails with stale credentials after the old value is revoked.'","AC: 'includes an explicit GitHub Actions sync step (gh secret set from SSM) ... per mapped secret' — states the sync but not its position relative to old-value revocation.","T9 concurrency: there is a window between SSM rotation and GH sync where the mirror is stale; the runbook should sequence the sync before revocation to keep the update safe under the two-system rotation."],"finding":"The plan addresses the mirror-staleness (CONSUME) leg via sync and drift-check but does not make the rotation ORDERING explicit as an acceptance criterion: to avoid the exact incident (CI failing after the old SSM value is revoked), the GitHub Actions mirror must be synced BEFORE the old credential is revoked. The Context notes this hazard ('or CI fails with stale credentials after the old value is revoked') but no AC pins the ordering into the runbook step.","group_criteria":null,"group_id":null,"id":"f580eb80d750bfae0","impact":1.0,"is_primary":null,"location":"Acceptance Criteria, sync-step bullet","norm_id":"n17b3e7ecdf5f9182","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":[],"severity":null,"suggested_fix":"Add an AC: 'The runbook orders steps so that every mapped GitHub Actions secret is synced from its new SSM value before the prior credential is revoked/deactivated.'","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"uncertifiable_outcome","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a concrete completeness check: grep workflows for `secrets.<NAME>` references and assert each appears in the runbook inventory/sync section.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E6"],"decision":"advisory","decision_margin":-0.5375,"drop_reason":null,"evidence":["\"Runbook review: rotating any mapped secret following the runbook leaves no stale mirror.\"","Context enumerates 5 workflow secrets: ANTHROPIC_API_KEY, GERRIT_SSH_PRIVKEY, JIRA_API_TOKEN, OPENAI_API_KEY, REBAR_BOT_SIGNING_KEY"],"finding":"The Verification section relies on a subjective manual review ('rotating any mapped secret following the runbook leaves no stale mirror') with no concrete, deterministic check that the inventory is COMPLETE — i.e. that every secret referenced in workflows appears in the inventory/sync step.","group_criteria":null,"group_id":null,"id":"ff542a9a865b5e186","impact":0.55,"is_primary":null,"location":"Verification section","norm_id":"nf34d3fe20f56bb18","priority":0.4125,"reason":"default-advisory","recalled":false,"scenarios":["A new workflow secret is added later but omitted from the inventory; manual review passes anyway"],"severity":null,"suggested_fix":"Add a verification step: `grep -rhoE 'secrets\\.[A-Z0-9_]+' .github/workflows/ | sort -u` and confirm every result (excluding the named non-secrets JIRA_URL/JIRA_USER) is present in the inventory table.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"underspecified_oracle","blast_radius":"module","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Have the runbook include a per-secret post-sync confirmation (e.g. verify each mirror's updated_at is newer than the rotation timestamp) so a failed/skipped sync is caught before old SSM values are revoked.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5b","T5e"],"criteria":["E6","T5b"],"decision":"advisory","decision_margin":-0.752,"drop_reason":null,"evidence":["\"an explicit GitHub Actions sync step (gh secret set from SSM) with a copy-paste command per mapped secret\"","No post-set verification / confirmation step is required","Context: stale mirrors 'kept their 2026-08-12 values until manually synced'"],"finding":"AC2 requires 'gh secret set from SSM' commands per secret but specifies no per-secret confirmation that the sync succeeded, so a failed or skipped `gh secret set` during rotation silently leaves a stale mirror — the exact failure mode the plan exists to prevent.","group_criteria":null,"group_id":null,"id":"f2337b56f7d395138","impact":0.264,"is_primary":null,"location":"Acceptance Criteria, AC2","norm_id":"n9ea2531794ef8327","priority":0.198,"reason":"default-advisory","recalled":false,"scenarios":["Operator runs gh secret set for 4 of 5 secrets, skips or errors on one, then revokes old SSM values; CI fails with a stale credential"],"severity":null,"suggested_fix":"After the `gh secret set` block, add a confirmation step listing `gh secret list` updated_at per mapped secret and asserting it post-dates the rotation, before revoking old SSM values.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"