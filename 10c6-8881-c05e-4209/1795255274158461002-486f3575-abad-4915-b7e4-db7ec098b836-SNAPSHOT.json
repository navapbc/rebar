c3afa0fd","position":"1795254692934589001-ecf5e6d0-45cc-4e31-b92a-5278c22812b3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"53b5d0184e4fcefd83692233239e357c6410a6e12e8d10810b13c5ac2b100051","event_uuid":"1693021d-917e-439f-b45e-a7c7d23d659c","position":{"commit_sha":"e731b2de6825a575efcbec6c5e3c66df11346dca","position":"1795255272032541001-1693021d-917e-439f-b45e-a7c7d23d659c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"a3f174d615a8bfff7bc470ae785e7c2fdf9e60e9296d0ad45c891a004f0e1d4b","event_uuid":"023d14f5-12d9-4469-ba83-b9109798ba42","position":{"commit_sha":"1fe20d0ead7076bc1a0276464671559042703ff4","position":"1795255274158461001-023d14f5-12d9-4469-ba83-b9109798ba42"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"flaky","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Verify-parity sweep evidence, Nov 20 2026. The 300 s pytest-timeout expiries occurred only in runs that overlapped about 8 or more concurrent -n 4 make verify suites (Nov 19 21:09 to Nov 20 ~06:30, before the 3-run verify-slot cap): 14 to 20 expiries per run across 8 logs, 137 of them blocked in a git subprocess. The 5 complete slot-capped unsandboxed runs (Nov 20, load ~30) had 0 expiries at 300 s. A same-host A/B at load 17-21 of the git-heaviest modules from those logs (test_import_batching, test_engine_comparison, test_audit_retention_cap, test_fetch_common_dir_coordination, test_repo_snapshot, test_epic_bug_screen_4b54) passed both inside and outside the agent sandbox, slowest call 23.86 s, so the sandbox itself does not slow git (git start ~15 ms both ways). Conclusion for this ticket: the trigger observed in these logs is host oversubscription beyond the slot cap; the 0.5 s-per-start shim reduction in this ticket's AC remains a valid cost reduction but was not worked by the sweep.","timestamp":1795207254837014001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation after plan review. Addressed: batch-check now also asks for each revision's root tree, so a 'missing' cap only counts as absent when the revision is readable; an unreadable revision raises and becomes Unavailable (new test test_unreadable_revision_is_a_git_failure_not_a_missing_cap). Not covered, and recorded as a known residual: a readable root tree with an unreadable .github subtree, or a gitlink at the cap path, now reads as a missing cap where per-revision ls-tree/cat-file raised; neither occurs in a healthy repository. Regression guard: test_history_walk_cat_file_starts_do_not_grow_with_revisions asserts the cat-file process count is 5 for both 3 and 12 revisions. Evidence: oracle test 606 -> 140 git starts; under the 0.5 s-per-start shim 1 passed in 78.83 s (call 75.01 s); dogfood module under the same shim on origin/main passes, slowest call 122.10 s, so no marker. tests/unit/metrics: 180 passed, 2 skipped.","timestamp":1795246141750574001}],"completion_expectation":"required","created_at":1795180663983115001,"creation_channel":"cli","deps":[{"link_uuid":"8fae461a-1d4d-4740-8beb-7bc47ac7d885","relation":"relates_to","target_id":"adde-a8b6-befa-4a49"}],"description":"## Observation\nIn a sandboxed local `make verify` (worktree almondy-drop-acl-step, Nov 19 18:23 to Nov 20 01:14 PST, load average around 40), pytest-timeout (300 s, thread method) killed workers in `tests/unit/metrics/test_git_metrics.py::test_oracle_cap_change_events_compares_unsampled_adjacent_revisions` (inside `git_metrics._git` from `_py_blobs_at` / `module_size_trend`) and in 3 tests of `tests/interfaces/lifecycle/test_plan_policy_dogfood.py` (inside the `_cli` subprocess helper). The same change passed CI Verified (Gerrit 3475).\n\n## Root cause (verified)\nWall time is git starts times per-start latency, and these tests and the code under test start git once per revision and request. A counting git shim records 606 git starts for the oracle test: 182 from its own setup (60 x `add`, `commit`, `rev-parse`) and about 410 from `git_metrics` (per revision: `ls-tree` and `cat-file -p` for the cap file, `ls-tree -r` for modules; per sample: one `cat-file --batch`; all of it twice, once for `cap_change_events` and once for `module_size_trend`). A PATH git shim that sleeps 0.5 s before every start (606 x 0.5 s = 303 s) makes the test hit `+++ Timeout +++` every run. The same per-revision cost applies to `rebar metrics` on a long real history.\n\nThe dogfood tests do not share the defect: under the same 0.5 s shim (Nov 20 2026, origin/main) the whole module passes, slowest test 122.10 s call (`test_in_progress_to_open_resets_phase_and_requires_a_planning_review`), all others below that, so they fit the 300 s budget with no marker.\n\n## Approach\n- `src/rebar/metrics/git_metrics.py`: read every revision's cap in 2 processes instead of 2 per revision: one `git cat-file --batch-check=%(objectname) %(objecttype)` over `<sha>:.github/module-size-limit.txt` for all in-range commits (`missing` stays the ordinary not-qualified case, a non-blob stays `invalid`, a real git failure still raises and becomes `Unavailable`), then one `git cat-file --batch` for the distinct cap blobs. `module_size_trend` reads every sampled revision's blobs in one `--batch` instead of one per sample. A shared `_cat_file` helper and `_parse_batch_objects` parser serve both (`_parse_batch_output` keeps its counts contract on top of it). `_read_cap_at` is removed. Results are unchanged; `ls-tree -r` per qualified revision stays.\n- `tests/unit/metrics/test_git_metrics.py`: the oracle test builds its 60-commit history with one `git fast-import` (helper `_fast_import_history`, shas from `--export-marks`) instead of 3 git starts per commit. Its assertions are unchanged.\n- No config key, environment variable, flag or marker is added.\n\n## Scope\n- `src/rebar/metrics/git_metrics.py`\n- `tests/unit/metrics/test_git_metrics.py`\n\n## Testing\n- Counting shim: the oracle test drops from 606 to 140 git starts (measured with the change).\n- Under the 0.5 s-per-start shim the oracle test passes: 1 passed in 77.26 s (call 73.90 s), recorded here.\n- All of `tests/unit/metrics` passes (178 passed, 2 skipped), including the existing missing-cap, invalid-cap and git-failure cases of `_qualified_history`.\n- `make verify` through the verify slot.\n\n## Acceptance Criteria\n- [x] Under the 0.5 s-per-start shim, test_oracle_cap_change_events completes inside the 300 s budget, with the shim run recorded here.\n- [x] The plan-policy dogfood tests are measured under the same shim and either fit the budget or carry a justified `@pytest.mark.timeout(N)` per the pyproject policy.\n- [x] `git_metrics` reads caps and sampled blobs in batches, with unchanged results on the existing metrics tests.\n- [x] `make verify` passes and Gerrit gives Verified +1. (slot run 21626 + 226 passed; Gerrit 3499 LLM-Review +1, Verified +1; merged 863abe7cd19)","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/metrics/git_metrics.py","reason":"batch cap and sampled-blob reads"},{"path":"tests/unit/metrics/test_git_metrics.py","reason":"build the oracle history with one git fast-import"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","adde-a8b6-befa-4a49"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"1693021d-917e-439f-b45e-a7c7d23d659c","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"10c6-8881-c05e-4209","ticket_type":"bug","title":"Metrics history walk and its oracle test start git per revision, so a slow git start pushes the test past the 300 s budget","verify_commands":[]},"source_event_uuids":["c9227a4a-c677-4b52-8896-fac530d9b3d3","0a7b0bac-22ee-44fb-97aa-1fc82320a98c","1af10575-f664-419e-a706-12dd8476b58d","b4f7ad60-0dc3-41a5-b69c-d19b4f68389f","c1852d9e-9027-404f-b85e-321665737302","787b2838-6258-48ec-9524-e868a5ee6408","c7be095b-8bd8-46b7-a453-e8a663a667e4","8fae461a-1d4d-4740-8beb-7bc47ac7d885","ecf5e6d0-45cc-4e31-b92a-5278c22812b3","1693021d-917e-439f-b45e-a7c7d23d659c","023d14f5-12d9-4469-ba83-b9109798ba42"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795255274158461002,"uuid":"486f3575-abad-4915-b7e4-db7ec098b836"}