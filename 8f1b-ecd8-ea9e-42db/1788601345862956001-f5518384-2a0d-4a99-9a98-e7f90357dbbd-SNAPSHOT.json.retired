519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1788596859880177001,"creation_channel":"cli","deps":[{"link_uuid":"fa41133f-5e52-4f79-ad94-1a3b242fb2ee","relation":"discovered_from","target_id":"8b6d-caf0-83ee-4d89"}],"description":"## Context / Problem\nOn `origin/main` at `c019920390926d543a0813d4c0c8721543d98776`, `infra/gerrit/reviewbot-e2e.sh` claims to prove the current review pipeline but checks only `LLM-Review` before submit. `infra/gerrit/project.config` also requires `Verified`. The script's test commit lacks the required `rebar-ticket:` trailer, so it no longer models an admissible production change.\n\n## Approach\nUpdate the live/manual E2E flow to create a valid ticket-linked commit and wait for both active gate votes before testing submit and replication. Keep credentials secret and cleanup bounded.\n\n## Acceptance Criteria\n- [ ] The test commit carries a resolvable full-canonical `rebar-ticket:` trailer and DCO sign-off.\n- [ ] The E2E fails unless both `LLM-Review +1` and `Verified +1` are present on the tested patchset.\n- [ ] Submit and GitHub-replication assertions run only after both votes pass.\n- [ ] Existing credential-redaction, exit-code, and cleanup contracts remain intact.\n- [ ] Focused tests, shell checks, lint, and typecheck pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"infra/gerrit/reviewbot-e2e.sh","reason":"Exercise both active Gerrit gate votes and create an admissible ticket-linked E2E commit."},{"path":"tests/scripts/test_reviewbot_e2e.py","reason":"Add deterministic coverage for ticket trailer and two-vote gating behavior."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"open","tags":["gerrit","e2e","verification","ci"],"ticket_id":"8f1b-ecd8-ea9e-42db","ticket_type":"bug","title":"Make reviewbot E2E exercise the active Verified gate and a valid ticket trailer","verify_commands":[]},"source_event_uuids":["8ef17307-d548-4792-b2e4-85f94c4f8c49","87c86f07-0a16-4959-89f1-4aa6e6424db6","fa41133f-5e52-4f79-ad94-1a3b242fb2ee"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1788601345862956001,"uuid":"f5518384-2a0d-4a99-9a98-e7f90357dbbd"}