{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787863495612720002,"compiled_state":{"alias":"fatherly-incoherent-mare","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"43f783de2a2dd9877c14d5e7adddd9fa74747a18","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 1eb6-65f2-5a4e-4c7b","material: 41722e308b2ebd30","material-part: children 647ea2107ca5072f 0","material-part: description 905cdae429b95b43 5852","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact ea64c5727c1317f9 4","material-part: ticket_id 02fa35ca8cafd60c 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 6","review-phase: execution","priority-floor: 0.80","rebar-version: 0.12.0 (43f783de2a2d-dirty)","regver: aa61189569d34126","verified-at-sha:9966198879a2c542f10108b44b8c90e6e5c58021","dep 22fbe413902766544741e92c4a45632c3ed2e88220f3e5b5b2f58b0967cc5461 infra/compose/docker-compose.yml","dep a80bdd5332e78b3d4da2ef42f3ada9f0d2def374850ebe9d520d262e107e94ca infra/scripts/autodeploy.sh","dep 8676d1098d932fc0ff13184e6fa62d98b454d7cbe0242d86ccb7bd4df42ba9ce infra/scripts/mcp-entrypoint.sh","dep 55fd8a48f41ecc3e088155a0d456d02b8b284df16f93ba09075c11fb0f056d2c tests/unit/test_mcp_entrypoint_provisioning.py","read-set: 23","read-path: .dockerignore","read-path: .rebar/trusted_environments.yaml","read-path: README.md","read-path: infra/compose/Dockerfile.mcp","read-path: infra/compose/docker-compose.yml","read-path: infra/scripts/autodeploy.sh","read-path: infra/scripts/compose-up.sh","read-path: infra/