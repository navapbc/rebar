tools are blocked by the same missing object database in /app, widening the blast radius beyond plan-review gates alone."]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787871806970187001,"uuid":"f21dc104-2cc7-4d87-be44-57c319fa9bd4"}