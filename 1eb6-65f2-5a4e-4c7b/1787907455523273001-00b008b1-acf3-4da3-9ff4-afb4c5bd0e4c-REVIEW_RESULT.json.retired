age":{"dependencies":[],"digest":"80c0dabf9acdcb6d306947b36ea6f76371af77aafa21ba6bcc778bba030439b1"},"namespace_version":1,"reason":null,"unit_id":"agent:T10","usage":{"input_tokens":52876,"output_tokens":2517,"requests":3}},{"kind":"success","lineage":{"dependencies":[],"digest":"fbc341b8bc3f12b881b2b82ae611adce9dad84816d0ea0a1c5e20edd95c4751e"},"namespace_version":1,"reason":null,"unit_id":"agent:T3","usage":{"input_tokens":98964,"output_tokens":3164,"requests":5}}],"version":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Specify the UPDATE step for the /var/gerrit/site/mcp-code clone: when/how origin/main is re-fetched (per gate op, on a schedule, or on redeploy) so it actually tracks main rather than freezing at deploy time.","cohort":["E3","E5","F4","G5","T12","T6","T9","necessity","project.portability"],"criteria":["T9"],"decision":"advisory","decision_margin":-0.4475,"drop_reason":null,"evidence":["Plan rejects shipping .git because it 'pins a main that goes stale the moment the image is built — the gates need a ref that tracks main, not a frozen one.'","Proposed clone: '--filter=blob:none --single-branch --branch main, so it is a blobless clone that fetches objects on demand' — this describes on-demand OBJECT fetch, not ref advancement; a --single-branch clone does not auto-advance origin/main without an explicit fetch.","No step in 'Shape.' or 'Ordering.' describes when or how origin/main is re-fetched after the initial clone (e.g. on each gate op, on a timer, on redeploy only)."],"finding":"The provisioned code clone at /var/gerrit/site/mcp-code has a CREATE step (provision_store sibling, cloned once at deploy) but no defined UPDATE/refresh step, so origin/main will go stale exactly like the frozen-main failure mode the plan itself rejects for shipping .git in the image.","group_criteria":null,"group_id":null,"id":"f0683f7e91f2594cc","impact":0.67,"is_primary":null,"location":"Fix section — 'Shape.' and 'Why not the obvious alternatives.'","norm_id":"n4a1bf8625d5b84da","priority":0.5025,"reason":"default-advisory","recalled":false,"scenarios":["A long-lived container: main advances upstream but the container's origin/main stays at the deploy-time commit, so attested reviews silently pin a stale snapshot — the same staleness defect the plan cites against the .git-in-image alternative.","If the clone is only refreshed on redeploy, the gate resolves against a ref that lags main between deploys, contradicting 'the gates need a ref that tracks main, not a frozen one.'"],"severity":"major","suggested_fix":"State the refresh trigger — e.g. a `git -C /var/gerrit/site/mcp-code fetch --filter=blob:none origin main` on each gate op or a backgrounded periodic fetch — and confirm origin/main advances, since a plain --single-branch clone does not auto-advance.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] Specify how origin/main in the /var/gerrit/site/mcp-code checkout is refreshed after the initial clone (per gate op, on a schedule, or on redeploy) so the gate ref tracks main rather than freezing at first-boot time.","cohort":["T10"],"criteria":["T10"],"decision":"advisory","decision_margin":-0.3975,"drop_reason":null,"evidence":["Plan rejects shipping .git because it 'pins a main that goes stale the moment the image is built — the gates need a ref that tracks main, not a frozen one.'","'Shape.' provisions a one-time clone into /var/gerrit/site/mcp-code on a persistent volume: 'clones the CODE side ... --single-branch --branch main ... a blobless clone that fetches objects on demand.'","ABSENCE: no fetch/pull/update step is described (per gate op, on a schedule, or on redeploy); once the persistent volume holds a clone, `code_repo_present` short-circuits re-cloning, so origin/main is frozen at first-boot time.","The persistent named volume is external and survives `docker compose down -v`, so a redeployed container inherits the same stale checkout rather than re-cloning."],"finding":"The plan provisions a persistent blobless clone of main on a named volume but never specifies how origin/main is kept fresh after the initial clone, contradicting its own stated requirement that the gates resolve against 'a ref that tracks main, not a frozen one.'","group_criteria":null,"group_id":null,"id":"f9c134f3001ede755","impact":0.67,"is_primary":null,"location":"Fix section — 'Shape.' / 'Ordering.' paragraphs","norm_id":"na15e4c9f58942dc6","priority":0.5025,"reason":"default-advisory","recalled":false,"scenarios":["A container redeploys weeks later against the same gerrit_mcp_code volume; origin/main still points at the commit resolved at the original clone, so attested gates review against a stale snapshot of main.","main advances but the on-box checkout is never re-fetched, so `git -C <root> rev-parse origin/main` succeeds (AC4) yet resolves a frozen commit."],"severity":"major","suggested_fix":"State the refresh mechanism: e.g. run `git -C $MCP_CODE_DIR fetch --filter=blob:none origin main` on each gate op (or on container start/redeploy) so origin/main advances, and reconcile that with the double-checked `code_repo_present` short-circuit that otherwise prevents any post-clone update.","tier":"LLM","validity":0.75,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"module","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"medium","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"medium","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["vague/subjective terms present: better, sufficient"],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.9,"blocking_enabled":true,"checklist_item":"- [ ] State the auth/HTTPS precondition for the code clone in the Fix section: the code-side URL (navapbc/rebar) answers ANONYMOUS git-upload-pack requests, so the clone needs NO credential and REBAR_ROOT can be pointed at it even when MCP_TICKETS_PAT is blank.","cohort":["T3"],"criteria":["T3"],"decision":"advisory","decision_margin":-0.6855,"drop_reason":null,"evidence":["Plan quote: 'Re-using the tickets clone at REBAR_TRACKER_DIR is tempting since MCP_TICKETS_URL is the SAME repository' — the tickets clone is credentialed via MCP_TICKETS_PAT, but the code clone's auth posture is never stated.","ABSENCE: the T3 rubric requires auth/HTTPS preconditions to be stated; the plan gives none for the code clone.","Implementation confirms the precondition is real and load-bearing: mcp-entrypoint.sh:291-297 places provision_code DELIBERATELY OUTSIDE the PAT guard because 'navapbc/rebar answers anonymous git requests (GET .../info/refs?service=git-upload-pack returns 200), so this clone needs NO credential.'"],"finding":"The Fix section describes cloning the code side from the same URL as the tickets store (MCP_TICKETS_URL / navapbc/rebar) but never states the auth/HTTPS precondition that makes an UNCREDENTIALED code clone viable — namely that the upstream answers ANONYMOUS git-upload-pack requests. This is load-bearing: the tickets clone runs behind a PAT credential guard, while the code clone (per the accepted shape) must succeed even when MCP_TICKETS_PAT is blank, since REBAR_ROOT is exported unconditionally. If the repo did not serve anonymous fetches, the code clone would fail on every deploy and every attested gate would break exactly as today.","group_criteria":null,"group_id":null,"id":"fa41be2cc388fb419","impact":0.33,"is_primary":null,"location":"Fix section, 'Shape' paragraph ('Re-using the tickets clone ... MCP_TICKETS_URL is the SAME repository')","norm_id":"n09d5963d310b38bf","priority":0.2145,"reason":"default-advisory","recalled":false,"scenarios":["An operator changes the upstream repo to require auth, or the code URL diverges from the anonymous-capable tickets URL; the unauthenticated code clone silently fails and the gates stay broken.","A reviewer trying to confirm feasibility cannot tell from the plan whether the code clone will succeed without a PAT."],"severity":"minor","suggested_fix":"Add a sentence to the Fix 'Shape' paragraph, e.g.: 'The code clone needs no credential: navapbc/rebar answers anonymous git-upload-pack requests (info/refs returns 200 unauthenticated), so it runs outside the tickets PAT guard and REBAR_ROOT resolves even when MCP_TICKETS_PAT is blank.'","tier":"LLM","validity":0.65,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"insufficient","cited_reference_accurate":"insufficient","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"yes","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"low"}}}],"impact_model_version":"plan-v5","material_fingerprint":"02ce4351e36b594d","material_parts":{"children":["647ea2107ca5072f",0],"description":["c8530a656c20943e",7567],"description_boxes":["b7fb217694ae2d30",6],"file_impact":["52871c413b74c689",2],"ticket_id":["02fa35ca8cafd60c",19]},"metrics":{"cache_read_tokens":0,"cache_write_tokens":0,"claim_path":"no-llm/no-network (structural; the fast claim check is a local HMAC verify)","det_ms":2022.4,"input_tokens":837748,"llm_calls":31,"llm_ms":183443.4,"output_tokens":23108,"prech