nd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"c6497256a5312616da248f9500b826bcb7e3d471831af11139bae9d1e0d83321","event_uuid":"ae911b3b-0eb0-4729-a884-ac6ac57dad57","position":{"commit_sha":"0e67bbf692738b93dceec3ceaa11d175f9a622b1","position":"1794427001619566612-ae911b3b-0eb0-4729-a884-ac6ac57dad57"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"4add3b40a4beceb9023ac4ad261741646e3103e3e1b0b595f9a03ec97ef881ae","event_uuid":"395e5537-e624-4c12-b9bf-57517bc87c04","position":{"commit_sha":"0e67bbf692738b93dceec3ceaa11d175f9a622b1","position":"1794427001637755909-395e5537-e624-4c12-b9bf-57517bc87c04"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1794426021674440363,"creation_channel":"mcp","deps":[{"link_uuid":"d0e14749-7ad7-482f-b936-a880db0e5e27","relation":"relates_to","target_id":"8501-0e78-cbac-4b03"}],"description":"## Context / Problem\n\nBug tapestried-oversize-blackfly (rebar sends `temperature` to Bedrock models that reject it, so plan review and the completion verifier 400 on Claude Opus/Sonnet 5, non-`us.` 5.5 profiles, OpenAI GPT-5.5/6.1 and Kimi K3.1) needs to reach users. PyPI currently serves 0.15.0. The operator asked for a fix release containing that fix, cut per `docs/releasing.md`.\n\nVersion: **0.15.1**. `docs/api-stability.md` states SemVer on 0.x and that any minor \"may\" carry breaking changes; it does not require a minor bump for additive changes. Main since v0.15.0 (12 commits) also carries the Jira-fixVersions \"releases\" feature (ADR 0124): `SCHEMA_VERSION` 5→6 for the additive `RELEASE_DELTA` event (`src/rebar/reducer/_version.py`), optional `releases` / `fixVersions` keys in `ticket_state` / `jira_snapshot_entry` schemas, and new release CLI commands. The event schema row says new event types are additive and preserved-and-ignored by older clients, and output schemas only gain optional keys, so nothing on that page forces 0.16.0. The CHANGELOG entry lists those additions so the patch number does not hide them.\n\n## Approach\n\nFollow `docs/releasing.md` §\"Release procedure\" exactly, after the bug's fix has merged on main and the bug is closed:\n1. In a fresh worktree at origin/main: bump `pyproject.toml` `version`, `server.json` `version` and every `packages[].version` to 0.15.1; `uv lock`; promote `## [Unreleased]` in `CHANGELOG.md` to `## [0.15.1] - <date>` with hand-curated entries (the sampling fix under Fixed; releases/fixVersions under Added) and the compare footer link; `make install` then `python scripts/gen_api_surface.py --update` (only `__version__` changes in `tests/unit/api_surface_baseline.json`).\n2. `make verify`; commit with `rebar-ticket:` trailer + `-s`; push to Gerrit with the session hashtag; Submit with `scripts/gerrit_safe_submit.py` at LLM-Review +1, Verified +1, 0 unresolved.\n3. `gh workflow run release.yml --ref main -f version=0.15.1`.\n4. Approve the pending `pypi` deployment via `POST repos/navapbc/rebar/actions/runs/$RUN/pending_deployments` with a JSON `--input` body (`environment_ids` integer array).\n5. Confirm every channel; trigger `gh workflow run autobump.yml --repo navapbc/homebrew-rebar` if the tap has not bumped.\n\n## Scope\n\n`pyproject.toml`, `server.json`, `uv.lock`, `CHANGELOG.md`, `tests/unit/api_surface_baseline.json`.\n\n## Acceptance Criteria\n\n- [ ] Version bump commit landed on main through Gerrit (change number and merge SHA recorded in a comment); `release_guards.py version-lockstep` passes in the run's `authorize` job.\n- [ ] `release.yml` run for 0.15.1 completes successfully (run id recorded).\n- [ ] PyPI: `curl -s https://pypi.org/pypi/nava-rebar/json` reports `info.version` 0.15.1.\n- [ ] GitHub Release: `gh release view v0.15.1 --repo navapbc/rebar` exists, marked Latest, with wheel and sdist attached.\n- [ ] MCP Registry: `curl -s \"https://registry.modelcontextprotocol.io/v0/servers?search=io.github.navapbc/rebar\"` lists version 0.15.1.\n- [ ] Homebrew: `Formula/rebar.rb` in `navapbc/homebrew-rebar` points at the 0.15.1 sdist (`gh api repos/navapbc/homebrew-rebar/contents/Formula/rebar.rb`).\n","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"pyproject.toml","reason":"version bump to 0.15.1"},{"path":"server.json","reason":"version bump (top-level + packages[])"},{"path":"uv.lock","reason":"root package version"},{"path":"tests/unit/api_surface_baseline.json","reason":"__version__ in API surface baseline"},{"path":"CHANGELOG.md","reason":"promote Unreleased to 0.15.1"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","8501-0e78-cbac-4b03"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"ae911b3b-0eb0-4729-a884-ac6ac57dad57","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":["release"],"ticket_id":"7350-7ab5-de03-408b","ticket_type":"task","title":"Release 0.15.1","verify_commands":[]},"source_event_uuids":["5aaef069-38b7-49fb-8074-a3958ee38a38","e0be8e8c-396c-425e-99e3-eb77458294e5","d0e14749-7ad7-482f-b936-a880db0e5e27","b526bdfd-c819-4dc6-817c-9900abd1f0a5","ae911b3b-0eb0-4729-a884-ac6ac57dad57","395e5537-e624-4c12-b9bf-57517bc87c04"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1794427001637755910,"uuid":"78e482d5-e7be-4de8-ad71-dd1137c76493"}