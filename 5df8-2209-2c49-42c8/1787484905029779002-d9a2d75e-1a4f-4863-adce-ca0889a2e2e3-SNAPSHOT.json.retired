{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787484905029779002,"compiled_state":{"alias":"chanceful-insectile-morpho","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"dbf351c3fea200c665e777bc3ba081ed3ebbc2b0","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 5df8-2209-2c49-42c8","material: 9a3e33a7932e0d64","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (dbf351c3fe)","regver: aa61189569d34126","refreshed-from: b8a354e0-12c3-4cf2-bbf1-fcc9685d5126 probe=PASS","verified-at-sha:dbf351c3fea200c665e777bc3ba081ed3ebbc2b0","dep 1d4746332b8924750602773ebe8ea55cecc9be0d26b45adfbd7a1241fc359b92 docs/config-reference.md","dep 893c117128e6a6dd1d310c5c8ca2845851a6131aec9209cd893ca3048e4a8320 scripts/gen_config_reference.py","dep 7a781c809eff79744fed1685c7bb3fb8989b0e2a16443582bbcdc695505cd2df src/rebar/_config_schema.py","dep absent src/rebar/_config_schema_verify.py","dep b27cee63b3d410860b9e3f45d6932ba40cc489beff9cc8342eeca4757524d9f6 tests/unit/test_gen_config_reference.py","read-set: 4","read-path: .github/module-size-limit.txt","read-path: scripts/gen_config_reference.py","read-path: src/rebar/_config_schema.py","read-path: src/rebar/_config_sections.py","currency-basis: file_impact"],"material_fingerprint":"9a3e33a7932e0d64","merged_log_commit":"dbf351c3fea200c665e777bc3ba081ed3ebbc2b0","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787479945297560000}},"author":"RebarBotNava","author_email":"joeoakhart+