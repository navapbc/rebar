"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787417361912923001,"creation_channel":"cli","deps":[],"description":"## Context\nThe generated configuration reference enumerates key, type, default, and lifecycle data from typed dataclass fields but provides no public setting descriptions. It cannot serve as the external settings contract until each emitted key explains its user-visible effect.\n\n## Plan\n- Add concise `public_description` metadata to every dataclass field emitted through `_SECTION_CLASSES`.\n- Preserve field types, defaults, factories, coercion, and runtime behavior.\n- Extend `scripts/gen_config_reference.py` to require nonempty description metadata and render a Description column.\n- Fail generation when an emitted field lacks a description.\n- Regenerate `docs/config-reference.md`.\n- Add focused completeness, escaping, and drift tests.\n- Keep `src/rebar` modules below the absolute 800-line limit. Use an existing configuration-section seam if an extraction is required.\n\n## Acceptance Criteria\n- [ ] Every generated typed key has one nonempty public description.\n- [ ] The generator fails with the missing key named when metadata is absent.\n- [ ] Descriptions state user-visible behavior without duplicating type, default, or lifecycle columns.\n- [ ] Generated Markdown escapes table-sensitive content correctly.\n- [ ] Typed defaults, coercion, and configuration behavior remain unchanged.\n- [ ] Module-size, focused configuration, generator, lint, and type checks pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_config_schema.py","reason":"Attach public descriptions to typed configuration fields."},{"path":"scripts/gen_config_reference.py","reason":"Require and render public descriptions."},{"path":"docs/config-reference.md","reason":"Regenerate configuration rows with descriptions."},{"path":"tests/unit/test_gen_config_reference.py","reason":"Pin description completeness, escaping, and drift behavior."}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["parent","66c6-2fe5-4850-4297"]],"no_file_impact_reason":"","parent_id":"66c6-2fe5-4850-4297","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"open","tags":["documentation","f19b","configuration"],"ticket_id":"5df8-2209-2c49-42c8","ticket_type":"task","title":"F19B generate descriptions for every typed configuration key","verify_commands":[{"command":"python scripts/gen_config_reference.py --check","dd_id":"D1","dd_text":"Generated configuration reference is current"},{"command":"python -m pytest tests/unit/test_gen_config_reference.py tests/unit/test_config_typed.py tests/unit/test_config_surface_golden.py -q","dd_id":"D2","dd_text":"Description and typed configuration contracts pass"},{"command":"python scripts/check_complexity_baseline.py --check && test $(wc -l < src/rebar/_config_schema.py) -le $(cat .github/module-size-limit.txt)","dd_id":"D3","dd_text":"Module-size contract passes"},{"command":"make lint && make typecheck","dd_id":"D4","dd_text":"Source checks pass"}]},"source_event_uuids":["a454cba5-7170-48d1-b535-611f810bcb27","59d97a0f-d04f-4e7f-b253-d40d0240053c","d32a9f43-0af6-44ec-805f-d18a12c2020c"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787417801245408002,"uuid":"395c7062-383f-4f53-a7d7-fe8fe12859b9"}