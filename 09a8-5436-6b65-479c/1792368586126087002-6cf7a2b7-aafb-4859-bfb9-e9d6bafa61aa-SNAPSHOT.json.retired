c4752ea2b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"73ba8464d464e87dc39c79bd752ce6590725801a45500961e5948737a7ce06ca","event_uuid":"07a719f0-4d30-4d4d-ae31-d602b0a1c766","position":{"commit_sha":"1970db3dc4fbb844338423084041831ed63cc65b","position":"1792365890063618990-07a719f0-4d30-4d4d-ae31-d602b0a1c766"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"26fa5eee3e5397426ffde20c7351f60837b5b40ee8f77f754a2241a028f34e5c","event_uuid":"25c7d3ee-159c-4906-b48d-9be8a000b97c","position":{"commit_sha":"9e2a0474b00f5388a12bfe674c4b4960eaa287d9","position":"1792365923940116176-25c7d3ee-159c-4906-b48d-9be8a000b97c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"81ce162149159811dbd91cf8913148661d7ff94ca8b79590772205a6674afc48","event_uuid":"c33827dd-75d3-4251-86c3-01553e090aa2","position":{"commit_sha":"d77c8ff63ec112b4c9735bd9b2256a8d61400106","position":"1792368570692542604-c33827dd-75d3-4251-86c3-01553e090aa2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implementation detail for this story (exact line-level edit list for kept files and tests; the description carries the decisions). Line numbers are on origin/main 2e81cb9767c1.\n\nEdit (kept src): `src/rebar/_store/event_append.py:385-387` (comment + call) and `:423-430` (`_maybe_enrich_drain`); `src/rebar/_store/push.py:590-596` (drain block at the tail of `push_after_commit`); `src/rebar/llm/plan_review/attest.py:216-233` (whole try/except; `return sig` at `:234` stays; the `logging` import stays, `:46` uses it); `src/rebar/llm/plan_review/__init__.py:600-612`; `src/rebar/_engine_support/reads_cli.py:186-188` (comment), `:190-201` (keep `out = dict(state)` at `:194`); `src/rebar/_cli/_llm_commands.py:548-561`; `src/rebar/_cli/_registry.py:427,453` (reword `:444`); `src/rebar/_cli/__init__.py:65-70`; `src/rebar/llm/__init__.py:44,113`; `src/rebar/llm/config.py:47,55` (re-exports), `:114-143` (13 `DEFAULT_OVERLAP_*` + comments), `:408-426` (13 fields), `:505,521` (this story owns only these lines; the config epic owns every other line in this file); `src/rebar/llm/config_readers.py:133-138` (`_llm_drain_mode`), `:211-317` (`_read_llm_overlap_settings`); `src/rebar/llm/config_binding.py:55-67` (13 allowlist names); `src/rebar/llm/contracts.py:150-249` (`ticket_digest_response_model`, `overlap_verdict_response_model`, `overlap_verdict_batch_response_model`), `:290-297` (three `register_contract`s; keep `:298-299`), reword `:261`; `src/rebar/schemas/__init__.py:68,80` (`__all__`), `:147-155` (`TICKET_DIGEST`, `OVERLAP_VERDICT`), `:385-391` (`\"enrich\"`, `\"overlap_judge\"` entries); `src/rebar/_commands/doctor_locks.py:104,109,380-386` (drop the `enrich-drain` leg, otherwise a leftover `.rebar/enrich-drain.lock` with no producer is a permanent `stale` finding that doctor never clears, `_existence_report` `:271-281`), reword `:43-52` to five legs; `src/rebar/schemas/doctor.schema.json:47` enum entry and the two \"enrichment drain lock\" mentions in `:5`; `src/rebar/_config_schema.py:81-84` docstring becomes \"Warns at create time when another ticket with the same normalized title was created inside the recency window (rebar create duplicate_warning).\" (this story owns only these lines); `src/rebar/reducer/_version.py:43-57` and `src/rebar/_store/event_prepare.py:69-80` comments become \"Retired producer (ADR 0086, removed in granitic-realisable-dolphin); the name is kept so historical events still parse and compaction preserves them.\" with names and the `:133-134` error string unchanged; `rebar.toml:32-42` becomes a comment \"Create-time same-title duplicate journal (`rebar create` stderr / `duplicate_warning`); advisory only, never blocks a create. The store-wide overlap detector this key used to gate was removed (ADR 0086 retired).\" plus `suggest_duplicate_tickets = true`; delete `rebar.toml:205-216` (the `[llm]` header at `:204` stays); `scripts/probe_rebar.py:557` (drop the `digest_freshness` bullet), `:571` becomes `{\"inbound_deps\", \"plan_review_health\"}`.\n\nEdit (tests): `tests/unit/test_config_llm.py:126-142,146,153,168-180`; `tests/unit/test_env_registry_helper_coverage.py:34-36`; `tests/unit/test_push_callers_best_effort.py:23`; `tests/unit/test_plan_review_resign.py:64`; `tests/unit/test_llm_commands_render.py:67`; `tests/unit/test_detached_child_cwd.py:3-4,33,115,126,142,154` (drop the drain arm); `tests/unit/test_spawn_detached.py:107,119`; `tests/unit/store/test_stamped_lock.py:411,417-421,457,460`; `tests/unit/store/test_store_paths.py:59,106-107,232-249`; `tests/scripts/graph/test_doctor_locks.py:83,284,557` (five legs; retarget the two lock paths to `compact-worker.lock`); `tests/integration/test_concurrency_regression.py:2056-2131` (delete that test); `tests/scripts/test_llm_seam_clean_heldout.py:36,41`; `tests/interfaces/contracts/test_cli_help_writing_guidelines_jerboa.py:33,75,99`; `tests/interfaces/facades/test_intercept_registry_cutover_s6_heldout.py:77-79`; `tests/unit/test_cli_registry_cutover_s6.py:5`; `tests/unit/test_run_request_builder.py:132,139,152,173,191` (`output_schema=\"epic_bug_screen_verdict\"`); `tests/unit/test_subcall_class_selection.py:21-22,91,126-127`; `tests/unit/test_step_failures.py` (rename the `\"overlap-judge\"` literal to `\"epic-bug-screen\"` at `:33-35,52,61,74-75,124-129,290-296,319-325`); `tests/unit/test_schema_complexity_gate.py:215`; `tests/unit/test_store.py:185-186`.\n\nAdd test: in `tests/interfaces/contracts/test_event_schema_forward_compat.py`, `test_retired_overlap_event_types_still_parse`: seed a ticket, write one raw event file per name (mirror `_write_future_event` at `:66-78`; `data` from the shapes the deleted `test_ticket_digest_store.py` and queue tests used), assert each name is in `_NON_REPLAY_KNOWN_TYPES`, `is_unknown_newer_type(n) is False`, `n in event_append.EVENT_TYPES`, `rebar.show_ticket(tid)[\"status\"] == \"open\"` with `\"digest_freshness\" not in state`, `rebar compact` leaves the four files on disk, and `rebar.fsck(repo_root=...)` contains neither `\"newer than this rebar understands\"` nor `\"CORRUPT\"`.\n\nRegenerate: `python scripts/gen_cli_help.py && python scripts/gen_cli_reference.py && python scripts/gen_env_registry.py && python scripts/gen_config_reference.py && python -m rebar.llm.prompting.prompts regenerate-index && python scripts/gen_api_surface.py --update && python scripts/gen_mcp_reference.py` (touches `docs/cli-reference.md:838,1004-1018`, `docs/env-vars.md:69-81`, `docs/config-reference.md:69`, `src/rebar/_cli/help/overview.txt:53`, `tests/unit/api_surface_baseline.json`). Do not hand-edit `.github/complexity-baseline.json` (`:39` becomes `stale`, passes per `scripts/check_complexity_baseline.py:68-71`) or `.github/mechanism-baseline.json` (`:519-531,655` become `stale`, passes per `scripts/check_mechanism_delta.py:14,54`; `:86` and `:637` stay live). `tests/golden/config_surface.json` inventories `_config_schema._SECTIONS` only, so no regen.\n\nCross-epic ownership: the CLI-consolidation epic owns `_help_route._REMOVED_SPELLINGS`; this story appends one `\"enrich\"` entry to it (if this story lands first, the entry goes into the existing frozenset and the CLI epic migrates it). Whichever of the two lands second regenerates `help/overview.txt` and `docs/cli-reference.md` after rebase; never hand-merge them.","timestamp":1788805019370728307},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Baseline maintenance step required in this change (verified on origin/main): `tests/unit/test_mechanism_delta.py::test_the_committed_baseline_matches_the_live_tree` asserts `set(baseline) | admitted == live`, so removing the 13 `REBAR_LLM_OVERLAP_*` env vars and the `[llm] overlap_*` keys leaves stale rows that `scripts/check_mechanism_delta.py --check` tolerates but the pytest does not. Run `python scripts/check_mechanism_delta.py --update-stale` after the removal and commit the resulting `.github/mechanism-baseline.json` (it refuses while `new>0`, so it cannot bless a regression). Precedent: commit 81da792 dropped `env_var::REBAR_HLC` the same way. This is the operator-sanctioned path for this epic, superseding the \"do not hand-edit\" instruction in the description for this file only; `.github/complexity-baseline.json` is still not hand-edited (its stale entry passes both the script and its test).","timestamp":1788805893200412456},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Coordination note (2026-09-07): open bug prenatal-maudlin-seahorse (dbe7-d957-e5da-49dd, priority 1, \"duplicate ticket creation is detectable but nothing aggregates or alarms on it\") works the same area this story re-enables: the create-time duplicate journal (`recent-creates.json`, the `duplicate_warning` path in `src/rebar/_lib_writes.py`). If that bug lands first, this story keeps its aggregation and builds the journal beside it; if this story lands first, that bug builds on the re-enabled journal. Neither may build on the enrichment queue this story deletes (`rebar.llm.enrich_drain`, `maybe_drain` at `event_append.py:385-387` and `push.py:590-596`). Whoever lands second rebases and re-runs `make verify`.","timestamp":1788813861029911858},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Cross-epic ownership corrections from the 2026-09-07 file-impact overlap analysis:\n1. `src/rebar/_engine_support/reads_cli.py:186-207`: the CLI epic's story trivial-americium-motmot extracts that render block into `_render_show_state()` while this story edits the comment at `:186-188` and the lines `:190-201`. Rule: the extraction is behaviour-preserving, so whichever lands second re-applies its edit inside the current shape (this story's edits go inside `_render_show_state()` if the CLI story landed first).\n2. `src/rebar/llm/config.py`: this story's sentence \"the config epic owns every other line in this file\" is wrong; the config epic never touches the file. The real co-editor is the eval-harness epic's story disgusted-fretful-hare, which edits the same re-export block. Rule: this story deletes the overlap lines (`:47,55,114-143,408-426,505,521`); that story adds its `evals` re-exports beside them; whichever lands second rebases.\n3. `rebar.toml`: this story deletes `[llm]` overlap keys at `:205-216` keeping `[llm]` at `:204`; disgusted-fretful-hare adds `[llm.evals]` in the same region. Rule: whichever lands second places its edit relative to the surviving `[llm]` header.\n4. `src/rebar/schemas/__init__.py`: this story deletes the `enrich` and `overlap_judge` entries; the MCP schema story quilted-nepotic-kitty adds four keys to the same dict. Adjacent entries only; rebase-trivial.\n5. `tests/scripts/test_llm_seam_clean_heldout.py:36`: edited by this story, by the editor story anguished-grown-junebug (`:36,53`) and by reviewable-infatuated-arcticduck (`:64,67`), and deleted whole by the test-suite story skaldic-paradoxal-huemul. Rule: if the deletion has landed, drop the edit; otherwise apply it and let the deletion land after.","timestamp":1788814880475489906},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Coordination update: colliding fix prenatal-maudlin-seahorse (dbe7-d957-e5da-49dd) has landed and closed. Gerrit change 2824 merged as 84e94070c819934e053f8883b4719cd215b14d7d; the duplicate/volume metrics live in src/rebar/metrics/event_metrics.py and remain independent of the overlap journal work.","timestamp":1788869137165742001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## AC2 pre-edit grep discovery (origin/main b97d414b8e2, 2026-10-18)\n\nPlan review (BLOCK, 2026-10-18) found reference sites outside the enumerated kept-src edit list that the AC2 grep would hit. Confirmed by running the AC2 pattern against the files it named:\n\n```\n.rebar/criteria_routing.json:125:        \"**/enrich_drain*\",\nsrc/rebar/_commands/compact_trigger.py:25::mod:`rebar.llm.enrich_drain`, which already solved this exact shape for enrichment. Reusing it\nsrc/rebar/_proc.py:17:  (``_store.push``), the enrichment drain (``llm.enrich_drain``), the compaction\ntests/_engine_path.py:102:    exercise a Windows branch — ``tests/unit/test_enrich_drain.py`` does it twice) turns\ntests/unit/test_change_input_not_an_outage_43d4.py:98:    \"\"\"25+ sites (enrich_drain's tombstone, both CLIs' exit codes, the MCP failure envelope,\ntests/unit/test_engine_root_convention.py:172:    and ``tests/unit/test_enrich_drain.py`` does exactly that. Because ``os`` is one shared\ntests/unit/test_env_registry_helper_coverage.py:15,23-25,45,96,102,104,106  (_llm_drain_mode negative control + 3 REBAR_LLM_OVERLAP_* rows)\n```\n\nRequired edits, added to the plan's edit list:\n\n- `src/rebar/_proc.py`: reword the module docstring's consumer list to the surviving consumers (drop `llm.enrich_drain`).\n- `src/rebar/_commands/compact_trigger.py`: reword the docstring to describe the helper on its own terms (drop the \"REUSED from enrich_drain\" sentence).\n- `.rebar/criteria_routing.json`: delete the `\"**/enrich_drain*\"` glob row.\n- `tests/unit/test_env_registry_helper_coverage.py`: drop the 3 `REBAR_LLM_OVERLAP_*` rows AND the `_llm_drain_mode` negative-control assertions (lines 15, 45, 96, 102-106); pick another non-env `_llm_*` helper as the negative control or drop the control with a comment.\n- `tests/_engine_path.py:102`, `tests/unit/test_engine_root_convention.py:172`, `tests/unit/test_change_input_not_an_outage_43d4.py:98`: retarget the prose example path to another existing test module.\n\nIn-session verification of AC2: run the AC2 grep before any edit (must list exactly the deleted files plus the sites above; any extra hit is added here before coding) and again after the edits (must print nothing). Paste both outputs into a comment on this ticket.","timestamp":1792363214178943552},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Second plan review 2026-10-18 (BLOCK, 2 moves), both confirmed against origin/main b97d414b8e2 and fixed in the description:\n\n1. Wrong cite: the plan said `_NON_REPLAY_KNOWN_TYPES` is consumed by `fsck_scan.py:248`. It is not; `fsck_scan.py:244-250` builds the `ensures:`/`authorship:` summary lines and the file never names the set. The only external reader is `_engine_support/bridge_fsck.py:113,115` (the other hits are docstrings in `llm/completion_sidecar.py`, `llm/plan_review/sidecar.py`, `_store/event_prepare.py`, and the to-be-deleted `llm/overlap/digest_sidecar.py`). Approach now cites `bridge_fsck.py:115` alone.\n2. Dangling index link: `docs/README.md:142` links `calibration/overlap_batch_confidence.md`, which the plan deletes, and `scripts/check_docs_index.py --check` (gated by `tests/unit/test_check_docs_index.py`) fails on a missing target. Scope now deletes that README link alongside the two calibration files, and a new AC requires `git grep -n overlap_batch_confidence -- docs` to be empty and the docs-index check to exit 0.\n\nAlso added `docs/README.md` to file impact.","timestamp":1792365890063618990},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Third plan review 2026-10-18 (BLOCK, 1 move), confirmed against origin/main b97d414b8e2 and fixed:\n\n`docs/exit-codes.md:178` carries the per-command row for `enrich` (`| `enrich` | 0 | — | — | no ticket id; cross-ticket overlap drain; always 0 on a clean run |`). Removing the route without that row makes `tests/interfaces/lifecycle/test_exit_codes.py:304` report it as `orphaned` and fail `make verify`. The AC2 grep is scoped to `src scripts tests rebar.toml .rebar`, so it would not have caught a docs row. Scope now adds `docs/exit-codes.md` (drop `:178`), and the docs AC now also greps for a leading `enrich` table row and runs `test_exit_codes.py`.\n\nRunning tally for this story's reviews: 1st found 7 prose reference sites outside the edit list; 2nd found a wrong `fsck_scan.py` cite and a dangling `docs/README.md` link; 3rd found this orphaned exit-codes row. All were real; none changed the design.","timestamp":1792368570692542604}],"created_at":1788804986117222355,"creation_channel":"mcp","deps":[],"description":"## Context / Problem\nADR 0086's cross-ticket overlap detector ships as a write-path enrichment queue: `src/rebar/_store/event_append.py:385-387` and `src/rebar/_store/push.py:590-596` call `rebar.llm.enrich_drain.maybe_drain` after every write, `src/rebar/llm/plan_review/attest.py:216-233` enqueues `ENQUEUE_ENRICH` at certification, and `src/rebar/llm/plan_review/__init__.py:600-612` runs BM25F retrieval plus an LLM judge inside `review-plan`. Each drained ticket pushed about 4 commits on the shared `tickets` branch (`rebar.toml:205-211`), starving other writers; the feature is off here (`rebar.toml:42,216`) and upstream, so 2,280 LOC plus 13 config keys, 13 env vars, a CLI verb, two prompts, two schemas and a doctor lock leg are dead surface. `verify.suggest_duplicate_tickets` also gates the cheap create-time journal (`_commands/recent_creates.py:148`), so disabling the detector disabled the journal. Operator decisions (2026-09-06): remove the implementation; keep the four event-type names so ~105k historical events parse; re-enable the journal; no tombstones (ADR 0116 `:65-68`). Cites: origin/main 2e81cb9767c1.\n\n## Approach\nDelete the modules and their CLI, prompt, schema, and contract registrations; cut each hook from the kept files; keep `TICKET_DIGEST`, `ENQUEUE_ENRICH`, `CLAIM_ENRICH`, `DONE_ENRICH` in `src/rebar/reducer/_version.py:53-56` (`_NON_REPLAY_KNOWN_TYPES`, sole external reader `_engine_support/bridge_fsck.py:115`) and `src/rebar/_store/event_prepare.py:73-80` (`EVENT_TYPES` write allowlist: `tests/unit/test_store.py:80-86`'s drift guard holds and the regression test appends the four types normally) with a \"retired producer\" comment; narrow `verify.suggest_duplicate_tickets` to the journal and flip it to `true` in `rebar.toml` in the SAME commit as the code removal (else `true` re-arms the billable overlap step at `plan_review/__init__.py:607-612`); regenerate every CI-gated artifact; add one regression test proving the four retired types still reduce, survive compaction, and fsck clean. `[llm]` is reserved (`_config_sections.py:187,201`), so a leftover `[llm] overlap_*` key is silently ignored even under `REBAR_CONFIG_UNKNOWN_KEYS=error`; the release note says so; warning on `[llm]` keys belongs to the config epic (`_config_sections.py:180-183` must not import `rebar.llm`). `reviewers/index.json` has no digest/judge entry today. `gen_cli_help.py` `_write()` unlinks strays (`:195,229`): regen removes `help/enrich.txt`, re-renders `overview.txt:53`. `plan_review_verdict.schema.json` never declares `overlap` (`:7`, `additionalProperties: true`): no schema or `types.py` edit.\n\n## Scope\nDelete: `src/rebar/llm/overlap/` (7 modules, 1,439 LOC), `src/rebar/llm/enrich.py` (206), `src/rebar/llm/enrich_drain.py` (635), `src/rebar/_cli/_parsers/advanced/enrich.py`, `src/rebar/_cli/help/enrich.txt` (via regen), `src/rebar/llm/reviewers/ticket_digest.md`, `src/rebar/llm/reviewers/overlap_judge.md`, `src/rebar/schemas/ticket_digest.schema.json`, `src/rebar/schemas/overlap_verdict.schema.json`, `scripts/overlap_judge_calibrate.py`, `docs/calibration/overlap_batch_confidence.md` and `.output.txt` plus the `docs/README.md:142` link to the former (keeps `check_docs_index.py --check` at 0); tests `tests/unit/test_{enrich,enrich_drain,enrich_queue,overlap_judge,overlap_retrieve,plan_review_overlap,ticket_digest_store}.py`, `tests/fixtures/enrich_quality/*.json` (6), `tests/fixtures/overlap_pairs/*.json` (13).\n\nEdit (kept src and tests): the exact line-level list is in this ticket's first comment; the kept files are `_store/event_append.py`, `_store/push.py`, `llm/plan_review/attest.py`, `llm/plan_review/__init__.py`, `_engine_support/reads_cli.py`, `_cli/_llm_commands.py`, `_cli/_registry.py`, `_cli/__init__.py`, `llm/__init__.py`, `llm/config.py`, `llm/config_readers.py`, `llm/config_binding.py`, `llm/contracts.py`, `schemas/__init__.py`, `schemas/doctor.schema.json`, `_commands/doctor_locks.py`, `_config_schema.py`, `reducer/_version.py`, `_store/event_prepare.py`, `rebar.toml`, `scripts/probe_rebar.py`, `docs/exit-codes.md` (drop the `enrich` row `:178`, else `test_exit_codes.py:304` fails on an orphan), plus 26 test files; also the prose-only sites AC2 would hit: `_proc.py:17` and `_commands/compact_trigger.py:25` docstrings, the `.rebar/criteria_routing.json` `enrich_drain*` glob row, the `_llm_drain_mode` control in `tests/unit/test_env_registry_helper_coverage.py`, and three test docstrings naming `test_enrich_drain.py` (exact lines in the 2026-10-18 comment).\n\nAdd `test_retired_overlap_event_types_still_parse` to `tests/interfaces/contracts/test_event_schema_forward_compat.py` (assertions in the first comment); regenerate the seven CI-gated artifacts per that comment; never hand-edit `.github/*-baseline.json`.\n\n## Testing\nHappy: `make verify` green; `review-plan --output json` has no `overlap` key; `show` has no `digest_freshness`; `doctor --output json` reports five lock legs; `create` twice with one title prints `duplicate_warning` (journal re-enabled). Edge: the retired-types test (four types on one ticket, compaction, fsck); `REBAR_CONFIG_UNKNOWN_KEYS=error rebar list` with `[llm] overlap_k = 20` in a temp `rebar.toml` exits 0 (silent-ignore, `_config_sections.py:201`); `rebar enrich` exits 2 as an unknown subcommand; `python -c \"import rebar.llm; rebar.llm.enrich\"` raises `AttributeError`; a box with a leftover `.rebar/enrich-drain.lock` gets no doctor finding.\n\n## Acceptance Criteria\n- [ ] `git ls-files src/rebar/llm/overlap src/rebar/llm/enrich.py src/rebar/llm/enrich_drain.py src/rebar/_cli/help/enrich.txt src/rebar/schemas/ticket_digest.schema.json src/rebar/schemas/overlap_verdict.schema.json scripts/overlap_judge_calibrate.py` prints nothing.\n- [ ] `git grep -nE 'llm\\.overlap|enrich_drain|_read_llm_overlap_settings|_llm_drain_mode|DEFAULT_OVERLAP_|overlap_drain|digest_freshness|REBAR_LLM_OVERLAP' -- src scripts tests rebar.toml .rebar` prints nothing; its pre-edit run (must list only deleted files plus the sites above) and post-edit run are pasted into a comment.\n- [ ] `python -c \"from rebar.reducer._version import _NON_REPLAY_KNOWN_TYPES as N; from rebar._store.event_prepare import EVENT_TYPES as E; assert {'TICKET_DIGEST','ENQUEUE_ENRICH','CLAIM_ENRICH','DONE_ENRICH'} <= N & E\"` exits 0.\n- [ ] `pytest tests/interfaces/contracts/test_event_schema_forward_compat.py -k retired_overlap -q` prints `1 passed`.\n- [ ] `rebar review-plan <ticket> --output json | python -c \"import json,sys; assert 'overlap' not in json.load(sys.stdin)\"` exits 0 on one real ticket.\n- [ ] `rebar doctor --output json | python -c \"import json,sys; d=json.load(sys.stdin); assert [l['name'] for l in d['locks']]==['tickets-write-fcntl','tickets-write-mkdir','hlc','compact-worker','snapshot-gc-worker']\"` exits 0.\n- [ ] `rebar enrich status` exits 2 with an unknown-subcommand usage error on stderr; `rebar help` output has no `enrich` line.\n- [ ] `python -c \"import tomllib;c=tomllib.load(open('rebar.toml','rb'));assert c['verify']['suggest_duplicate_tickets'] is True and 'overlap_drain' not in c['llm']\"` exits 0, and two `rebar create task \"same title\"` within 600 s print `duplicate_warning` on stderr for the second (exit 0).\n- [ ] Each of `scripts/gen_{cli_help,cli_reference,env_registry,config_reference,api_surface}.py --check`, `python -m rebar.llm.prompting.prompts regenerate-index --check`, `python scripts/check_complexity_baseline.py --check` (reports `stale=1 new=0 increased=0`), `python scripts/check_mechanism_delta.py --check` (`stale>=14 new=0`) exits 0 with no hand edit to either `.github/*-baseline.json`.\n- [ ] `git grep -nE 'overlap_batch_confidence|^\\| `enrich`' -- docs` prints nothing, `python scripts/check_docs_index.py --check` exits 0, and `pytest tests/interfaces/lifecycle/test_exit_codes.py -q` passes.\n- [ ] `make verify` exits 0.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/overlap/","reason":"delete package"},{"path":"src/rebar/llm/enrich.py","reason":"delete"},{"path":"src/rebar/llm/enrich_drain.py","reason":"delete"},{"path":"src/rebar/_cli/_parsers/advanced/enrich.py","reason":"delete"},{"path":"src/rebar/_cli/help/enrich.txt","reason":"delete via gen_cli_help"},{"path":"src/rebar/_cli/help/overview.txt","reason":"regen"},{"path":"src/rebar/llm/reviewers/ticket_digest.md","reason":"delete"},{"path":"src/rebar/llm/reviewers/overlap_judge.md","reason":"delete"},{"path":"src/rebar/schemas/ticket_digest.schema.json","reason":"delete"},{"path":"src/rebar/schemas/overlap_verdict.schema.json","reason":"delete"},{"path":"src/rebar/schemas/__init__.py","reason":"drop registry entries"},{"path":"src/rebar/schemas/doctor.schema.json","reason":"drop enrich-drain leg"},{"path":"scripts/overlap_judge_calibrate.py","reason":"delete"},{"path":"scripts/probe_rebar.py","reason":"drop digest_freshness"},{"path":"docs/calibration/overlap_batch_confidence.md","reason":"delete"},{"path":"docs/calibration/overlap_batch_confidence.output.txt","reason":"delete"},{"path":"docs/README.md","reason":"drop the :142 link to the deleted calibration doc (docs-index gate)"},{"path":"src/rebar/_store/event_append.py","reason":"remove maybe_drain hook"},{"path":"src/rebar/_store/push.py","reason":"remove maybe_drain hook"},{"path":"src/rebar/_store/event_prepare.py","reason":"comment: retired producer"},{"path":"src/rebar/reducer/_version.py","reason":"comment: retired producer"},{"path":"src/rebar/llm/plan_review/attest.py","reason":"remove ENQUEUE_ENRICH producer"},{"path":"src/rebar/llm/plan_review/__init__.py","reason":"remove overlap_findings"},{"path":"src/rebar/_engine_support/reads_cli.py","reason":"remove digest_freshness"},{"path":"src/rebar/_cli/_llm_commands.py","reason":"remove overlap render"},{"path":"src/rebar/_cli/_registry.py","reason":"drop enrich routes"},{"path":"src/rebar/_cli/__init__.py","reason":"drop _enrich"},{"path":"src/rebar/_cli/_help_route.py","reason":"add enrich removed-name entry"},{"path":"src/rebar/llm/__init__.py","reason":"drop enrich export"},{"path":"src/rebar/llm/config.py","reason":"drop 13 overlap fields/defaults (owned lines only)"},{"path":"src/rebar/llm/config_readers.py","reason":"drop overlap readers"},{"path":"src/rebar/llm/config_binding.py","reason":"drop overlap allowlist names"},{"path":"src/rebar/llm/contracts.py","reason":"drop digest/verdict models"},{"path":"src/rebar/_commands/doctor_locks.py","reason":"drop enrich-drain leg"},{"path":"src/rebar/_config_schema.py","reason":"suggest_duplicate_tickets docstring (lines 81-84 only)"},{"path":"rebar.toml","reason":"flip suggest_duplicate_tickets; drop overlap_drain"},{"path":"src/rebar/_proc.py","reason":"docstring: drop llm.enrich_drain from consumer list (AC2 grep site)"},{"path":"src/rebar/_commands/compact_trigger.py","reason":"docstring: drop 'REUSED from enrich_drain' sentence (AC2 grep site)"},{"path":".rebar/criteria_routing.json","reason":"drop the **/enrich_drain* glob row (AC2 grep site)"},{"path":"docs/cli-reference.md","reason":"regen"},{"path":"docs/env-vars.md","reason":"regen"},{"path":"docs/config-reference.md","reason":"regen"},{"path":"tests/unit/api_surface_baseline.json","reason":"regen"},{"path":"tests/interfaces/contracts/test_event_schema_forward_compat.py","reason":"add retired-types test"},{"path":"tests/unit/test_enrich.py","reason":"delete"},{"path":"tests/unit/test_enrich_drain.py","reason":"delete"},{"path":"tests/unit/test_enrich_queue.py","reason":"delete"},{"path":"tests/unit/test_overlap_judge.py","reason":"delete"},{"path":"tests/unit/test_overlap_retrieve.py","reason":"delete"},{"path":"tests/unit/test_plan_review_overlap.py","reason":"delete"},{"path":"tests/unit/test_ticket_digest_store.py","reason":"delete"},{"path":"tests/fixtures/enrich_quality/","reason":"delete"},{"path":"tests/fixtures/overlap_pairs/","reason":"delete"},{"path":"tests/unit/test_config_llm.py","reason":"drop overlap assertions"},{"path":"tests/unit/test_env_registry_helper_coverage.py","reason":"drop overlap rows and the _llm_drain_mode negative control (AC2 grep site)"},{"path":"tests/_engine_path.py","reason":"docstring: retarget test_enrich_drain.py example path (AC2 grep site)"},{"path":"tests/unit/test_engine_root_convention.py","reason":"docstring: retarget test_enrich_drain.py example path (AC2 grep site)"},{"path":"tests/unit/test_change_input_not_an_outage_43d4.py","reason":"docstring: drop enrich_drain mention (AC2 grep site)"},{"path":"tests/unit/test_push_callers_best_effort.py","reason":"drop drain ref"},{"path":"tests/unit/test_plan_review_resign.py","reason":"drop ref"},{"path":"tests/unit/test_llm_comman