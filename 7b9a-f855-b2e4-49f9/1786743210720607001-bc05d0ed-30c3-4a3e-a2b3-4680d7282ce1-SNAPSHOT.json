45e255b9bb15b13f679b1f2c1ec360b00e5615b","position":"1786737929973734001-abebbba4-02d5-4a46-8e88-c8301ce98fc9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"391509a86297af163b123172f91cf89fa580921649db70d2c4871e7a31f2e95a","event_uuid":"74dc646a-f468-4a01-a8c0-8505957dfad2","position":{"commit_sha":"c00950159e8f4fa9e717638782aa7d1bb83c8fb8","position":"1786738268175991001-74dc646a-f468-4a01-a8c0-8505957dfad2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6cb6b67c85f346aec75b19abefb07e3846f9387a37de09a9b230e66a7235e7b8","event_uuid":"d325c9fb-eb2c-436f-9264-c7612d09120a","position":{"commit_sha":"bddd560c19f97468d6258c1d8724f7e62f4046b6","position":"1786738270784914001-d325c9fb-eb2c-436f-9264-c7612d09120a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Implemented via TDD in worktree reb-2658-7032-docs; pushed as Gerrit change 1787.\n\nFinding 1 (correctness): outbound_differ create-path membership check made case-insensitive and now stamps the canonical mapping key (matches applier guard's uppercase normalization). Held-out RED test (lowercase 'b' vs key 'B' now creates + stamps 'B') verified RED before the fix, GREEN after, and returns to RED under the case-sensitive mutation.\n\nFinding 2 (tests): added end-to-end apply() test seeding projects.json — proves read_projects(repo_root) widens the guard scope (DIG allowed when seeded {REB,DIG}; ACME still refused). Characterizes already-correct wiring.\n\nFinding 3 (tests): added run_differs._run_differs_outbound seam test — malformed projects.json fails closed with ValueError. Characterizes already-correct fail-closed threading.\n\nFinding 4 (accepted): documented the two-read single-pass-window assumption in a code comment; no behaviour change.\n\nFull reconciler unit suite (2734) green; lint + typecheck clean.","timestamp":1786735301398648001}],"created_at":1786720928170448001,"creation_channel":"cli","deps":[{"link_uuid":"3363dc7b-14a6-4fa3-bea5-807e04697f20","relation":"discovered_from","target_id":"d19d-7f60-0137-475a"},{"link_uuid":"9dfd47f2-d5a5-47e3-b5b1-2fe570bc30e1","relation":"relates_to","target_id":"51f0-cd68-1eae-4718"}],"description":"Follow-up from d19d LLM-Review (Gerrit change 1776, advisory comments — d19d landed with LLM-Review +1). Hardens the many-to-many outbound path for the four advisory findings below. None are live-behaviour regressions (the create-path resolution is gated on a seeded mapping), so this is defensive alignment + test depth.\n\n## Problem\n\n1. **(correctness) Case-sensitivity mismatch on the create path.** `outbound_differ._compute_outbound_create_mutation` suppresses a create with `target not in mapping.projects` — a **case-SENSITIVE** membership test (`src/rebar/_engine/rebar_reconciler/outbound_differ.py:585`). The applier's cross-project guard normalizes both sides to uppercase (`apply_inbound_records`/`applier._cross_project_targets`, `applier.py:247-262` `.upper()`). A `bridge_project` differing only in case from the mapping key (`\"b\"` vs `\"B\"`) is suppressed on the create path yet passes the applier guard — the two paths disagree. Jira keys are canonically uppercase so it does not fire in practice, but the paths must agree.\n2. **(tests) Applier guard store-loading wiring is not exercised end-to-end.** The many-to-many guard branch `list(read_projects(repo_root).keys()) or _project` (`applier.py:618`) is only unit-tested at the pure-helper level (`_cross_project_targets` with a literal set). The store-loading path through the caller (`apply()` reading a seeded `projects.json`) has no test.\n3. **(tests) The `run_differs` load_mapping seam has no fail-closed test.** `_run_differs_outbound` threads `projects_store.load_mapping(repo_root)` into the outbound diff (`run_differs.py:471`); the contract is that a MALFORMED `projects.json` fails closed (ValueError aborts the pass). `load_mapping`'s ValueError is unit-tested in isolation, but nothing proves `run_differs` lets it propagate through the seam.\n4. **(low priority, accept + document) The mapping is read twice per pass** — `load_mapping` in the outbound seam (create resolution) and `read_projects` in the applier guard. A mid-pass `projects.json` change could make them disagree. Accepted: `projects.json` writes are rare operator CLI actions and a pass is a short single window; document the assumption rather than thread one read through.\n\n## Approach\n\n**Finding 1 (fix, `outbound_differ.py`).** Make the create-path membership test case-insensitive and align it with the applier's normalization. Resolve the ticket's target, then match it against the mapping keys case-insensitively; when it matches, stamp the **canonical mapping key** (not the raw `bridge_project` case) so the transport routes to the real project key. When it does not match (stale/typo binding) or the ticket is not synced, emit no create — the existing suppression contract. Replace:\n\n```python\ntarget = projects_store.resolve_project(ticket, mapping)\nif not target or target not in mapping.projects:\n    return\ncreate_fields[_BRIDGE_TARGET_PROJECT_KEY] = target\n```\n\nwith a case-insensitive canonical-key lookup (`next((k for k in mapping.projects if k.upper() == target.upper()), None)`), stamping the canonical key.\n\n**Finding 2 (test, `test_applier_cross_project_guard.py`).** Add an integration test that writes a seeded `projects.json` (two projects) under `tmp_path`'s `.tickets-tracker/.bridge_state/` and drives `applier.apply()` (repo_root=tmp_path) with an update whose key is foreign to the seeded set — asserting the guard refuses before any write — and a companion asserting a key IN the seeded set is allowed. This exercises the real `read_projects(repo_root)` store-loading wiring through the caller, not the pure helper.\n\n**Finding 3 (test, `test_outbound_multi_project.py`).** Add a `run_differs`-seam test: write a MALFORMED `projects.json` under `tmp_path`, build a minimal ctx (scoped pass so binding recovery is skipped, empty `local_tickets`), call `run_differs._run_differs_outbound(ctx, [], backend)`, and assert it raises `ValueError` — proving the seam threads `load_mapping(repo_root)` and fails closed rather than degrading silently.\n\n**Finding 4 (document).** Add a short code comment at the outbound seam noting the two-read single-pass-window assumption is accepted (rare CLI writes); no behaviour change.\n\n## Acceptance criteria\n\n- [x] The create-path membership check in `outbound_differ.py` is case-insensitive; a ticket whose `bridge_project` matches a mapping key case-insensitively (e.g. `\"b\"` vs key `\"B\"`) emits a create stamped with the canonical mapping key, and a genuinely-absent project still suppresses the create. Proven by a held-out RED test in `test_outbound_multi_project.py`.\n- [x] An integration test in `test_applier_cross_project_guard.py` seeds `projects.json` and drives `apply()` through the store-loading guard wiring (foreign key refused, member key allowed).\n- [x] A `run_differs`-seam test proves a malformed `projects.json` aborts the outbound phase with `ValueError` (fail-closed).\n- [x] Finding 4 is documented as accepted at the outbound seam (comment); no behaviour change.\n- [x] [operator-attested] `make lint`, `make typecheck`, and the touched reconciler test modules pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/outbound_differ.py","reason":"finding 1: make create-path project-membership check case-insensitive; stamp canonical mapping key; finding 4 accepted-assumption comment"},{"path":"tests/unit/rebar_reconciler/test_outbound_multi_project.py","reason":"finding 1 held-out RED test (lowercase bridge_project -> canonical create) + finding 3 run_differs-seam malformed-json ValueError test"},{"path":"tests/unit/rebar_reconciler/apply/test_applier_cross_project_guard.py","reason":"finding 2 integration test seeding projects.json and driving apply() through the store-loading guard"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","0e68-41eb-5782-4336"],["relates_to","51f0-cd68-1eae-4718"]],"no_file_impact_reason":"","parent_id":"0e68-41eb-5782-4336","parent_status_uuid":"74dc646a-f468-4a01-a8c0-8505957dfad2","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"7b9a-f855-b2e4-49f9","ticket_type":"bug","title":"M2M outbound: case-insensitive project membership + guard-wiring test depth","verify_commands":[]},"source_event_uuids":["f60d830c-e477-4a9c-86ef-7b186ecdd2ec","3d6ae39a-8227-42c7-859c-21cd56e7d0d8","83e028e6-cb6a-4070-b5e3-e400cb357a86","9fa04a5b-4352-42a8-b33e-420b38e58b29","f705e114-084a-45a1-abe8-5e48fd7a3955","162b31c1-ecf5-4a8a-8a8e-6c301b32b567","2e333a65-244e-4915-981e-e38f45d51e55","9dfd47f2-d5a5-47e3-b5b1-2fe570bc30e1","abebbba4-02d5-4a46-8e88-c8301ce98fc9","74dc646a-f468-4a01-a8c0-8505957dfad2","d325c9fb-eb2c-436f-9264-c7612d09120a"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786743210720607001,"uuid":"bc05d0ed-30c3-4a3e-a2b3-4680d7282ce1"}