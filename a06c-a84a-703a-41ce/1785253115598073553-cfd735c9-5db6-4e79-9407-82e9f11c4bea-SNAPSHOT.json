XaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785252362210186001,"creation_channel":"cli","deps":[{"link_uuid":"91b94b16-b5ff-4f7e-971b-ef9fb503865b","relation":"discovered_from","target_id":"0b14-5c30-fe45-4fdf"},{"link_uuid":"6e420f86-9dc5-4e2d-bdae-bf5b83abd96a","relation":"relates_to","target_id":"e464-371d-cf28-43a5"},{"link_uuid":"71c8f779-d776-43c8-be06-654b0f317b69","relation":"relates_to","target_id":"882e-53e0-5c62-4c23"},{"link_uuid":"e711a661-4514-4212-87cc-94d078e86c2c","relation":"relates_to","target_id":"0637-6c0c-942c-453e"}],"description":"## Context\nThe Gerrit Verified run for story 0b14 failed in the clean core-wheel optionality lane after PyPI resolved bare `mcp` to newly released 2.0.0. The project MCP extra explicitly supports `mcp>=1.28.1,<2`, and rebar imports `mcp.server.fastmcp`, which MCP 2.0 no longer provides. The workflow currently installs unbounded `pytest jsonschema mcp`, so CI is testing an unsupported dependency major and now fails independently of the patchset.\n\n## Plan\n- Change `.github/workflows/_optionality.yml` so the lean degradation lane installs MCP using the same supported version interval as `pyproject.toml`.\n- Preserve the lane contract: install the core wheel without extras, then add only light test dependencies and supported FastMCP transport; do not install the agents extra.\n- Validate workflow YAML/lint and reproduce the lane imports/tests in a clean temporary environment if practical.\n\n## Acceptance Criteria\n- [ ] The clean core-wheel lane cannot resolve MCP 2.x.\n- [ ] The lane still verifies the agents extra is absent.\n- [ ] The two MCP optionality contracts execute with supported FastMCP available.\n- [ ] Workflow lint passes.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":".github/workflows/_optionality.yml","reason":"constrain clean-wheel transport dependency to supported MCP major"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","0637-6c0c-942c-453e"],["relates_to","882e-53e0-5c62-4c23"],["relates_to","e464-371d-cf28-43a5"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"dd017501-ffce-4035-9fcf-2381dce7b213","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["ci","dependencies","regression"],"ticket_id":"a06c-a84a-703a-41ce","ticket_type":"bug","title":"Pin clean-wheel optionality lane to supported MCP major","verify_commands":[]},"source_event_uuids":["b5137199-3c9c-4d09-aa16-40d4851f1777","91b94b16-b5ff-4f7e-971b-ef9fb503865b","2f1c7b5b-7639-4c50-b942-6e33c05d6ffe","9a80b0bf-df1a-485e-a08d-2f3fc2b60670","dd017501-ffce-4035-9fcf-2381dce7b213","2025af35-9b53-44ef-ac2a-26ef4db66551","6e420f86-9dc5-4e2d-bdae-bf5b83abd96a","71c8f779-d776-43c8-be06-654b0f317b69","e711a661-4514-4212-87cc-94d078e86c2c"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785253115598073553,"uuid":"cfd735c9-5db6-4e79-9407-82e9f11c4bea"}