,"reason":"low-validity","recalled":false,"scenarios":["An MCP tool call against an A-held ticket could double the advisory (response field + library warning) if the filterwarnings install is dropped or mis-scoped, and no criterion would catch it."],"severity":"major","suggested_fix":"Add an AC: 'Under build_server(), an MCP tool call as B vs A-held records zero CrossSessionWarning (catch_warnings) while the response cross_session_warning field is populated once.'","tier":"LLM","validity":0.4286,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"na","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"underspecified_certification","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"low","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a test (or acceptance criterion) asserting the MCP surface emits its cross_session_warning field exactly once and no CrossSessionWarning leaks after build_server() installs the filter.","cohort":["E3","E5","F4","G5","T5b","T6","T9","necessity","project.engine-layer-enforcement","project.portability"],"criteria":["E5"],"decision":"dropped","decision_margin":-0.7929,"drop_reason":null,"evidence":["Plan: 'build_server() installs a process-wide filterwarnings(\"ignore\", CrossSessionWarning