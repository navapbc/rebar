{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788131013815982796,"compiled_state":{"alias":"vapourific-voracious-nerka","assignee":null,"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":41,"unsigned":0},"authorship_ledger":[{"content_hash":"7a3720de2b33ad296716ce3f6cf8218b1a0fed6973050b30155ef40d2627332d","event_uuid":"85869ece-03ad-4b42-b0f0-50ed18c80125","position":{"commit_sha":"a6c45334b70042f6898a2e9c09ac006621152692","position":"1788117546406421229-85869ece-03ad-4b42-b0f0-50ed18c80125"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"22583a4044cd3012b601d1d9bae6a04c5ce6cba339b3a251180b10ae8f49b17d","event_uuid":"5742dced-dec8-42e8-9b67-42f2af4a38e1","position":{"commit_sha":"7d939873e95e9e06c9659762228046ea078276af","position":"1788117936081919914-5742dced-dec8-42e8-9b67-42f2af4a38e1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"52ed6626fb19c64ea04f7f7bb7cf1b3a486cb135d281c82e056fd88413fdc550","event_uuid":"9db45250-ab85-4c3b-9744-d8873f64c06b","position":{"commit_sha":"e538c42f1df3436952fef20f154a52cb62531be5","position":"1788124564793137126-9db45250-ab85-4c3b-9744-d8873f64c06b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"96a2b55f76c5cab205014372785d9e91366fbfc706d4919109ae1f82445c68bc","event_uuid":"23f98f92-fa9f-4313-ae8d-91d23433dde0","position":{"commit_sha":"d4950ea0a4e19d22c313364b3fe7ceebf412eb22","position":"1788125436520091