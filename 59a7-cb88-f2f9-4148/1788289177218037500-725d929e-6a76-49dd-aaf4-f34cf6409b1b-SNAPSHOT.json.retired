{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1788289177218037500,"compiled_state":{"alias":"vapourific-voracious-nerka","assignee":null,"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":104,"unsigned":0},"authorship_ledger":[{"content_hash":"0a7b15c985292364afca4c57a8b610e09d039ee740275b2fb8c0095d2f7d685e","event_uuid":"2578d98b-d30b-4371-bc41-79884ed1f41d","position":{"commit_sha":"6ad84c089c1cb8a6866a88e0564e685db2817333","position":"1788285183825379418-2578d98b-d30b-4371-bc41-79884ed1f41d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"67d49d3b8070dea9901c44a3456ff04222109b87e8a53ef71b34597b8310ffe3","event_uuid":"6ffdc535-2d84-49c7-baa0-fdce463a99f6","position":{"commit_sha":"4f03e751eea0418650eb09a335c392f44abd6fb3","position":"1788285337761201126-6ffdc535-2d84-49c7-baa0-fdce463a99f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"eb76e983d82ed63eefb9e6c2a6a9a5a8b53245f9737b1e765f3838fa8a509bdb","event_uuid":"9ce900b0-dbfc-4bb9-9d9f-df3c422ae8dc","position":{"commit_sha":"276a05be56c683588905460f84e211d2e4555a47","position":"1788285436227508824-9ce900b0-dbfc-4bb9-9d9f-df3c422ae8dc"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"1449e59ac933a53a4fa87634f4ac5a4d60114188619839a0c4deaf47bc84e3c8","event_uuid":"e69bb5c5-8a5e-48d9-8c8d-fdefca411751","position":{"commit_sha":"6aaf21ac101127e2a590f819a77c3686b9e576f3","position":"178828557597985800