tures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"29642706901debaaffc157f7b18fe46b09a4b244a4b4250852009d92f6c9a81c","event_uuid":"4794abf6-b5a0-4fe5-9cb3-03fd713bbc1c","position":{"commit_sha":"9deae071e1f26e2aecca8064e342ad149e84a819","position":"1788286793227670974-4794abf6-b5a0-4fe5-9cb3-03fd713bbc1c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"6d08787b050fe1c0c38c1aaf6a8d0c70337e641d55848c52875afc1a3119bef1","event_uuid":"56ef0361-8b9f-46fb-9b5f-8862febe9ca7","position":{"commit_sha":"9d40f5d78f7d8d6c9379bce6a7dc1eeab08dc4fe","position":"1788287261993031897-56ef0361-8b9f-46fb-9b5f-8862febe9ca7"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"77be90618c55b73b8fc0523ccd00301f88c07acbe3c77ca53d621d92eff89320","event_uuid":"3eb04622-40a5-46ed-a7bf-e8ebb5a027d8","position":{"commit_sha":"9a11c0180027239d31eff01c81e4a24f1735c09d","position":"1788287273501025959-3eb04622-40a5-46ed-a7bf-e8ebb5a027d8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"717faf6ceb6af053f724c1c268f169ed971d0cb42387642dec7e3fdb6e471785","event_uuid":"21d48773-0515-4777-b1d5-1286a6fb5dc5","position":{"commit_sha":"773b545252839b6c2dde4a2ff569cf150db9f6ee","position":"1788287280968518515-21d48773-0515-4777-b1d5-1286a6fb5dc5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b318c84e5be65461b77dac3a1264c216f470c18d