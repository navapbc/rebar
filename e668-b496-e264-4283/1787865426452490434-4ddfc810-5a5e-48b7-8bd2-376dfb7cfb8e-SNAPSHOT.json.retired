{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787865426452490434,"compiled_state":{"alias":"chiffon-venomous-annelida","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"9c0776d610ef5afa9f4529ec9064868b62c020f5","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: e668-b496-e264-4283","material: 8a3902907a602641","material-part: children 647ea2107ca5072f 0","material-part: description 378dfb86284fdede 7758","material-part: description_boxes 83b7db61ca197115 0","material-part: file_impact 6c4dc047f9129475 4","material-part: ticket_id 33d50d54b4fe84b5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.12.0 (ef1a7e66a6-dirty)","regver: aa61189569d34126","verified-at-sha:9c0776d610ef5afa9f4529ec9064868b62c020f5","dep 20015833040d867c50bfadad2349afd17918697e0600b77b79a0632ed5bf763e docs/local-dev-env.md","dep 8dd2ffc81004c4c6ba69ad520206c79af00fd2957ee346a12fbf678241ca9d11 scripts/mutation_gate.py","dep absent scripts/mutation_sandbox.py","dep absent tests/scripts/test_mutation_sandbox.py","read-set: 4","read-path: .github/workflows/_build-and-test.yml","read-path: pyproject.toml","read-path: scripts/mutation_gate.py","read-path: tests/scripts/test_mutation_gate.py","currency-basis: file_impact"],"material_fingerprint":"8a3902907a602641","merged_log_commit":"9c0776d610ef5afa9f4529ec9064868b62c020f5","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787800992124866000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":36,"unsigned":0},"authorship_ledger":[{"content_hash":"8ec5d137aac28c7b9cb84f3fb16bad3abf24565c5eba95dd86f90fd1b5ca743c","event_uuid":"7d6deaf5-426d-4725-9e61-04ec6bc57b52","position":{"commit_sha":"ff0f17d8eb9efe24b2e4d1e3e8df195f9b205d12","position":"1787811935501263606-7d6deaf5-426d-4725-9e61-04ec6bc57b52"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f19b3785f6898e9fd4209941b562daa165e86703d10da917512a241e7569dd26","event_uuid":"1f6bea9f-8133-4b86-bea9-3f4ab8a51ee4","position":{"commit_sha":"c21dd1f40ac66a6972430c222bd6d0a7c7f07734","position":"1787850055716067544-1f6bea9f-8133-4b86-bea9-3f4ab8a51ee4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"f0ca47ba36e41c7a8c534857cc31121aaeb24671647ba46ab9fe534c0383f5a9","event_uuid":"657ddb58-0da1-4ba8-a67d-4a1ef913af38","position":{"commit_sha":"08a652e2520bae4e187979d75743eaf039447fdd","position":"1787854270178401001-657ddb58-0da1-4ba8-a67d-4a1ef913af38"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"de692d4fa71efb61bd1c9b73944eace964d6eb9b6282086c590ce5503f7db8ac","event_uuid":"1bbee4bd-05ee-4b2d-9093-87b6550a59b3","position":{"commit_sha":"a9f0a988cf2df8bcad4bcf1d9e7db7bfb49bd449","position":"1787854741018475738-1bbee4bd-05ee-4b2d-9093-87b6550a59b3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"7b4454f79aea8926e8939d1fab40098fd1c7361d4bc5f303a4d52f3e09b3f805","event_uuid":"3bbce1ed-1fb7-480e-a7cc-c9faff6361e5","position":{"commit_sha":"0a538436d10aef7e15e093a3e4c54235052172e5","position":"1787855014850787001-3bbce1ed-1fb7-480e-a7cc-c9faff6361e5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e73443bf2a700d8c4fec98519f184c40d6abc7d79bfd5cae1fba91de340361a3","event_uuid":"a2dadef7-d60e-4d0c-b9a5-a4bc9c28ac67","position":{"commit_sha":"9759baff4ef1aeab6365d8b2e40ed16f733017f9","position":"1787855050873992001-a2dadef7-d60e-4d0c-b9a5-a4bc9c28ac67"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"6041b05921e396a0133197ac106419b2c08923176b8eddd06b2b0ea26529e3b8","event_uuid":"bae45bff-39ad-4134-9685-c8b05dfeb511","position":{"commit_sha":"847b338ddb0a6cc0c9692ae2c343aac6a68ab1e4","position":"1787855074935207001-bae45bff-39ad-4134-9685-c8b05dfeb511"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-