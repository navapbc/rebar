{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787808714652584001,"compiled_state":{"alias":"chiffon-venomous-annelida","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"9c0776d610ef5afa9f4529ec9064868b62c020f5","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: e668-b496-e264-4283","material: 8a3902907a602641","material-part: children 647ea2107ca5072f 0","material-part: description 378dfb86284fdede 7758","material-part: description_boxes 83b7db61ca197115 0","material-part: file_impact 6c4dc047f9129475 4","material-part: ticket_id 33d50d54b4fe84b5 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 2","review-phase: planning","rebar-version: 0.12.0 (ef1a7e66a6-dirty)","regver: aa61189569d34126","verified-at-sha:9c0776d610ef5afa9f4529ec9064868b62c020f5","dep 20015833040d867c50bfadad2349afd17918697e0600b77b79a0632ed5bf763e docs/local-dev-env.md","dep 8dd2ffc81004c4c6ba69ad520206c79af00fd2957ee346a12fbf678241ca9d11 scripts/mutation_gate.py","dep absent scripts/mutation_sandbox.py","dep absent tests/scripts/test_mutation_sandbox.py","read-set: 4","read-path: .github/workflows/_build-and-test.yml","read-path: pyproject.toml","read-path: scripts/mutation_gate.py","read-path: tests/scripts/test_mutation_gate.py","currency-basis: file_impact"],"material_fingerprint":"8a3902907a602641","merged_log_commit":"9c0776d610ef5afa9f4529ec9064868b62c020f5","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787800992124866000}},"author":"RebarBotNava","author_email":"joeoakhart+bo