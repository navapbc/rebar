t_sha":"457a4c03230b4abbada7131d505f03b9809ccadc","position":"1787799969454261001-c37c172a-8180-4857-9b92-ee34c63bc0aa"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"52026a6c651cb4ebdbeac20cebc5bade5bb1c051f5614fb91c8f935478566e7a","event_uuid":"feb764c0-ef58-4201-b84b-d151e24426d8","position":{"commit_sha":"db9129df937def61f545d9be3b982525ccd19c2f","position":"1787799975679319001-feb764c0-ef58-4201-b84b-d151e24426d8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"557996ea600fe32722b4cb2b08a16e9f7fdef6e7419c675025133a38fae8551f","event_uuid":"c2494849-ee36-4d25-990d-2176fd703e51","position":{"commit_sha":"fef422d327fcc2b755cbb6be84c4b0638362c11a","position":"1787800556881505001-c2494849-ee36-4d25-990d-2176fd703e51"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"aae6bb2122e22e04d1d06f70466fc11e52e23bf09e77b478f666fff609074fd9","event_uuid":"01cbfc78-cf08-4daa-b3ad-6d5e26e0c696","position":{"commit_sha":"844cc0f78826adc0c39cffa778ee507750e16164","position":"1787800992180990001-01cbfc78-cf08-4daa-b3ad-6d5e26e0c696"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-