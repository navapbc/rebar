d2d5c5c230a842f6d4e221bcdd9a08470","position":"1786119439006425001-6c19d0ee-9b33-44ae-92fd-53aa17ef2b50"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2a5baf95447f0ee7dd1343e4e245ebb6479fece1f09e367480416aeaa6c28490","event_uuid":"3fe89075-b0c0-4513-9ddb-b7d46653983f","position":{"commit_sha":"6d78655d2d5c5c230a842f6d4e221bcdd9a08470","position":"1786119439799557001-3fe89075-b0c0-4513-9ddb-b7d46653983f"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c69a8dbe803f69d996f8d6d42d82808a480c63eb61ef3e807ca6782e42689d2a","event_uuid":"f7033ecc-5161-4d2f-b19a-5d64e87ddc1e","position":{"commit_sha":"58d6ed6e763bf74634980b1539b53373d492a05d","position":"1786119692990682001-f7033ecc-5161-4d2f-b19a-5d64e87ddc1e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pushed to Gerrit: https://rebar.solutions.navateam.com/c/rebar/+/1506 (Change-Id I9f5abf3). Fixes the three over-cap/unparseable SKILL.md descriptions as folded block scalars and adds scripts/check_skill_frontmatter.py wired into make lint (+ unit test). Local make lint, typecheck, and the unit test are green. Awaiting LLM-Review +1 and Verified +1 before Submit.","timestamp":1786119692990682001}],"created_at":1786119073452944001,"creation_channel":"cli","deps":[{"link_uuid":"1ea2efd1-06af-4a9a-83e7-b89fcd7e830e","relation":"relates_to","target_id":"895a-c209-b7c4-4dde"}],"description":"## Context / Problem\n\nThe user-level Copilot skills `rebar-implement`, `rebar-janitor`, and `rebar-debug`\n(symlinked into `~/.copilot/skills/` from `examples/agent-skills/`) silently fail to\nregister in GitHub Copilot CLI, while `rebar-brainstorm` registers fine. Copilot CLI\nenforces the Agent Skills spec's 1024-character `description` cap and a strict YAML\nfrontmatter parse, but drops non-conforming skills silently — no error, no warning\n(github/copilot-cli#3494; YAML strictness in #1024). The three failing skills each hit a\ntrigger: `rebar-implement` (1327-char description) and `rebar-janitor` (1068-char) exceed\n1024; `rebar-debug` (868-char) contains an unquoted `: ` (`discipline: write`) that breaks\nthe YAML plain scalar. Nothing in the repo guards against this regressing.\n\n## Approach\n\nTwo parts. (1) Fix the three `SKILL.md` frontmatters: rewrite each `description` as a YAML\nfolded block scalar (`description: >-`), matching the packaged builtin skills' style, which\nneutralizes colon/quote parse breaks, and trim the two over-cap descriptions to <= 1024\ncharacters while preserving each skill's \"Use when … or invokes /rebar-<name>\" trigger.\n(2) Add a deterministic CI lint that fails when any tracked `SKILL.md` has invalid\nfrontmatter — following the established `scripts/check_*.py` + `make lint` convention\n(e.g. `scripts/check_docs_index.py` wired at `Makefile:185`, mirrored by\n`tests/unit/test_check_docs_index.py`). This fits because it single-sources the rule the\nsame way existing structural gates do, and catches the failure class at commit/CI time\ninstead of silently at skill-load time.\n\n## Scope\n\n- `examples/agent-skills/rebar-implement/SKILL.md` — block-scalar + trim description to <=1024.\n- `examples/agent-skills/rebar-janitor/SKILL.md` — block-scalar + trim description to <=1024.\n- `examples/agent-skills/rebar-debug/SKILL.md` — block-scalar to fix the unquoted `: `.\n- `scripts/check_skill_frontmatter.py` — new lint: for every `examples/agent-skills/*/SKILL.md`,\n  assert the frontmatter parses as YAML, `description` is present, non-empty, and <= 1024\n  characters, and `name` (when present) is <= 64 chars and matches `^[a-z0-9]+(-[a-z0-9]+)*$`.\n  Expose importable `check_file`/`main(argv)->int` returning exit code, printing findings.\n- `tests/unit/test_check_skill_frontmatter.py` — new test mirroring the check-script pattern\n  (importlib-loaded, `pytest.mark.unit`): the real tree passes; synthetic over-cap,\n  empty-description, unparseable-YAML, and bad-name fixtures each fail.\n- `Makefile` — invoke `python scripts/check_skill_frontmatter.py` from the `lint` target.\n\n## Testing\n\n- Happy path: `python scripts/check_skill_frontmatter.py` exits 0 on the committed tree\n  (all four skills valid after the fix); the unit test asserts this via `chk.main([]) == 0`.\n- Failure/edge paths (unit test, synthetic fixtures): a 1200-char description fails; an\n  empty description fails; frontmatter with an unquoted `: ` that yields non-string/parse\n  error fails; a `name` over 64 chars or violating the regex fails.\n- Regression check: assert each real skill's parsed description length is <= 1024 and each\n  file's frontmatter YAML-parses to a mapping with a string `description`.\n\n## Acceptance Criteria\n\n- [ ] All four `examples/agent-skills/*/SKILL.md` frontmatters parse as YAML to a mapping\n      whose `description` is a non-empty string <= 1024 chars — verified by\n      `python scripts/check_skill_frontmatter.py` exiting 0.\n- [ ] `rebar-implement`, `rebar-janitor`, and `rebar-debug` descriptions each still contain\n      their `/rebar-<name>` invocation trigger — verified by grep in the unit test.\n- [ ] `scripts/check_skill_frontmatter.py` exists and, run standalone, exits non-zero with a\n      clear message when given a fixture SKILL.md whose description exceeds 1024 chars —\n      verified by the unit test's failure cases.\n- [ ] `make lint` invokes the new check — verified by grepping the `lint` target for\n      `check_skill_frontmatter` and by `make lint` passing on the fixed tree.\n- [ ] The unit test `tests/unit/test_check_skill_frontmatter.py` passes under\n      `pytest -m unit` (happy path + over-cap + empty + unparseable + bad-name cases).","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"examples/agent-skills/rebar-implement/SKILL.md","reason":"rewrite description as block scalar, trim to <=1024 chars so it registers"},{"path":"examples/agent-skills/rebar-janitor/SKILL.md","reason":"rewrite description as block scalar, trim to <=1024 chars so it registers"},{"path":"examples/agent-skills/rebar-debug/SKILL.md","reason":"block scalar to fix unquoted colon-space that breaks YAML parse"},{"path":"scripts/check_skill_frontmatter.py","reason":"new deterministic lint validating SKILL.md frontmatter (YAML, name, description<=1024)"},{"path":"tests/unit/test_check_skill_frontmatter.py","reason":"unit test mirroring the check script (happy path + failure fixtures)"},{"path":"Makefile","reason":"wire the new frontmatter check into the lint target"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["relates_to","895a-c209-b7c4-4dde"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"6c19d0ee-9b33-44ae-92fd-53aa17ef2b50","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"db04-4d8b-cb4b-4114","ticket_type":"task","title":"Fix silently-dropped Copilot rebar skills and add a SKILL.md frontmatter lint","verify_commands":[]},"source_event_uuids":["29793c3c-d60c-4a15-bf62-bd935c9f3b59","ed60bc43-853d-4b46-a17a-9b2a21dbc983","0036c0bb-09a0-4086-b54c-6a4d1ea7ab36","6c19d0ee-9b33-44ae-92fd-53aa17ef2b50","3fe89075-b0c0-4513-9ddb-b7d46653983f","f7033ecc-5161-4d2f-b19a-5d64e87ddc1e","1ea2efd1-06af-4a9a-83e7-b89fcd7e830e"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786119923416928090,"uuid":"a6eb734e-3598-49dd-b68d-8913a1a2c0de"}