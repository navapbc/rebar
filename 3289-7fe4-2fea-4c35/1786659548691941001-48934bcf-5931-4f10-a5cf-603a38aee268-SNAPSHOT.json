b7b0a-2980-4e72-b0d6-5543489f4bbd","position":{"commit_sha":"e161bca2a759e8cf42c7dca6c6eec02aedebcf3d","position":"1785821562158394001-0c4b7b0a-2980-4e72-b0d6-5543489f4bbd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"17f88d3fcdbd589dcf594d51865275bb421f54e6e7c4f1c982644ead831ed7da","event_uuid":"9d3be847-dbd7-4f5d-a0cf-b0c603d3ee02","position":{"commit_sha":"65f71f792ad5874a02b397470de7237d38674b0d","position":"1785822481990724001-9d3be847-dbd7-4f5d-a0cf-b0c603d3ee02"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3d46bd35f19a3678e988a382f2a72e016d275eca1f619a0d7dc68920ec4d4e20","event_uuid":"6791a5a0-22cf-4f56-b08c-31a8af2c15f5","position":{"commit_sha":"8281268c09e711b1ff24df476024faf435ddfdff","position":"1785823063624469001-6791a5a0-22cf-4f56-b08c-31a8af2c15f5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1785800307371974001,"creation_channel":"cli","deps":[{"link_uuid":"839efb0d-b95c-4664-8817-2c476dc2672c","relation":"depends_on","target_id":"5c0e-e25f-b14e-4aba"},{"link_uuid":"56964b29-f432-4a52-b324-d0549eb8b8dd","relation":"depends_on","target_id":"3388-96e8-e14e-4221"}],"description":"# Live DC harness (rendered HTML) + cross-repo contract test\n\n## Context / Problem\nThe DC codec is validated offline against pandoc's jira reader as a proxy, but the\nreal Jira DC wiki renderer and Jira's own storage canonicalization differ from pandoc\nand cannot be modeled offline — that gap is the residual risk this story closes. The\nrepo already runs live DC testing with a Dockerized Jira 8.17.1 instance in GitHub\nActions (`tests/external/live_jira_dc/`), so this extends that harness rather than\nbuilding a new one. Separately, the sibling repo `agentic-dev-platform` imports the\n`InboundMapper.normalize_rich_text` seam from this package, so changing its behavior\nmust be guarded by a contract test.\n\nThis story is the LIVE proof of the state-based echo-safety and settled-conflict\nbehavior that `5c0e` (DC render robustness) and `3388` (cutover + echo suppression +\nlocal-wins conflict) deliver; it depends on both.\n\n## Approach\nExtend the existing Docker DC harness with a rich-text test that:\n- renders a representative body and pushes it via the real API\n  (`rebar.edit_ticket(local_id, repo_root=repo, description=value)`, the pattern\n  already used by `_out_description` in\n  `tests/external/live_jira_dc/test_dc_mutations.py`), and asserts **rendered HTML**\n  through `?expand=renderedFields` — not just the wiki source via `?fields=description`\n  — so we verify what Jira actually interprets (`*foo*`→bold, `h1.`→heading,\n  `{code}`→macro). No `renderedFields`/`expand=` assertion exists in the harness\n  today, so this is a genuinely new fidelity check.\n- runs a second reconcile pass to assert **state-based echo-safety end-to-end** (the\n  landed rich body decodes to a value the differ recognizes as unchanged → no\n  re-push), exercising `3388`'s once-only-upgrade-then-converge path against the real\n  renderer.\n- performs a **both-sides concurrent edit** to assert `3388`'s settled conflict\n  behavior with the precondition that policy actually requires. The\n  `outbound-field-conflict` alert fires ONLY on a both-sides divergence\n  (`local != baseline` AND `remote != baseline`, `outbound_field_diff.py:354-362`); a\n  bare Jira-side edit with local unchanged is instead suppressed by the\n  directionality guard (`_suppressed_by_inbound`) and mirrored inbound (Jira-wins)\n  with NO conflict alert. So the live scenario is: (1) push a body and let a pass\n  converge so a baseline is recorded; (2) make a **rebar-side** edit to the\n  description AND a **Jira-side** edit to the same field before the next pass;\n  (3) assert the next pass emits rebar's body (**local-wins**) and records the\n  deduped `outbound-field-conflict:<key>:description` bridge alert — the remote value\n  is recorded, never silently destroyed (NOT a novel LWW clock; this is the a713 +\n  `3388` policy proven live, mirroring `3388`'s `test_concurrent_conflict_alerts`\n  precondition).\n\nGate it with the harness's existing skip markers (absent-harness / absent-extra) and\nthe session-scoped PAT the harness already provisions. Add a contract test that pins\nthe public shape/behavior of `normalize_rich_text`\n(`src/rebar/_engine/rebar_reconciler/inbound_fields.py:134`, exposed as\n`InboundMapper.normalize_rich_text`) so a change that would break the\n`agentic-dev-platform` import fails here first.\n\n## Scope\n- `tests/external/live_jira_dc/` — new rich-text live test module (render+push,\n  `?expand=renderedFields` HTML assertions, 2nd-pass echo, both-sides-concurrent-edit\n  local-wins + conflict-alert assertion), reusing the existing conftest\n  fixtures/skip markers.\n- CI workflow for the DC harness job — ensure the new test runs in the existing\n  amd64 Docker job (no new job).\n- `tests/` — cross-repo `normalize_rich_text` contract test.\n\n## Testing\n- Live render fidelity: a pushed rich body's `renderedFields` HTML contains the\n  expected bold/heading/code-macro markup (skipped when the harness/extra is absent).\n- Live echo-safety: a second reconcile pass against the live instance pushes no\n  description change (upgrade-then-converge holds against the real renderer).\n- Live conflict: with a converged baseline, a **both-sides** edit (rebar-side AND\n  Jira-side to the description) before the next pass keeps rebar's body and raises the\n  deduped `outbound-field-conflict:<key>:description` alert (remote value recorded,\n  not clobbered); a bare Jira-only edit is NOT asserted as a conflict (it is\n  Jira-wins inbound).\n- Contract: `normalize_rich_text` accepts the documented inputs and returns the\n  documented type/shape; a signature/behavior change fails\n  `test_normalize_rich_text_contract`.\n\n## Acceptance Criteria\n- [ ] The Docker DC harness has a rich-text test asserting rendered HTML via\n  `?expand=renderedFields` (not just wiki source), covering bold/heading/code-macro;\n  verified by the test running in the existing DC-harness CI job.\n- [ ] The live test asserts state-based echo-safety across a second pass (no re-push)\n  AND `3388`'s settled local-wins + `outbound-field-conflict` bridge alert under the\n  required **both-sides** precondition (converged baseline, then a rebar-side AND a\n  Jira-side edit to the description → local-wins emit + deduped\n  `outbound-field-conflict:<key>:description`, remote value recorded, not silently\n  destroyed); verified by the same live test.\n- [ ] A cross-repo contract test pins `normalize_rich_text`\n  (`InboundMapper.normalize_rich_text`) back-compat so a breaking change fails here\n  first; verified by `test_normalize_rich_text_contract`.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"tests/external/live_jira_dc/","reason":"rich-text live test: render+push, renderedFields HTML, 2nd-pass echo, LWW"},{"path":".github/workflows/","reason":"run new test in existing DC harness job"},{"path":"tests/","reason":"cross-repo normalize_rich_text contract test"}],"file_impact_scope":"paths","keyring":[],"managed_refs":[["depends_on","3388-96e8-e14e-4221"],["depends_on","5c0e-e25f-b14e-4aba"],["parent","708d-0767-1a51-4928"]],"no_file_impact_reason":"","parent_id":"708d-0767-1a51-4928","parent_status_uuid":"","plan_review_phase":"planning","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"open","tags":["rich-text"],"ticket_id":"3289-7fe4-2fea-4c35","ticket_type":"story","title":"Live DC harness (rendered HTML) + cross-repo contract test","verify_commands":[]},"source_event_uuids":["9acd862d-4290-4e88-9712-a93e30b31492","f964b9f6-4566-4e9a-9d8a-a4611d5d2292","839efb0d-b95c-4664-8817-2c476dc2672c","56964b29-f432-4a52-b324-d0549eb8b8dd","0c4b7b0a-2980-4e72-b0d6-5543489f4bbd","9d3be847-dbd7-4f5d-a0cf-b0c603d3ee02","6791a5a0-22cf-4f56-b08c-31a8af2c15f5"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1786659548691941001,"uuid":"48934bcf-5931-4f10-a5cf-603a38aee268"}