bf7-42c3-aa55-3d0944f9a833","position":{"commit_sha":"a08f8e97e2897c12689b601551b8efe4d36886f3","position":"1795095180692982283-9aaae6ba-1bf7-42c3-aa55-3d0944f9a833"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"e07f9f2465f4a9821c20dc0a6d0dc473db80ad27c749bc47b5e00e13c9ebe938","event_uuid":"3b5ca807-13ae-48d0-8dca-d6c0482af526","position":{"commit_sha":"df599f397215731ac87456edc1601f518bde55dc","position":"1795095462772431224-3b5ca807-13ae-48d0-8dca-d6c0482af526"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"5c48097c0a78d1d2baab0d82413135227120f52b7381e4f15b6ac190a3c7abb6","event_uuid":"b832faf7-260e-4350-b109-47c819660fa1","position":{"commit_sha":"58d2846c2b2d9317dcc45fb6b1f7e3fbc7e9d16d","position":"1795095470927923056-b832faf7-260e-4350-b109-47c819660fa1"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed: Gerrit 3456 merged as 5cde271a8ee0befc319499bcc47699b4c8012bf0 (LLM-Review +1; Verified +1 on run 44528682304 after a recheck: the first run's only failure was `apt-get install bubblewrap` failing with \"Unable to locate package\" before any repository code ran). Local make verify passed on bd4b45f5330: 21,453 passed plus 226 integration. The first verify caught `tests/unit/test_completion_sidecar_material_balding.py::test_completion_gate_error_emit_enriches_only_completion_records`, which emitted for a made-up id against a stubbed tracker; it now stubs the resolver, because refusing unknown ids is the intended behaviour. Root cause: `emit_gate_error` passed the caller's raw id to `append_event`, which writes to whatever directory it is named. Portability: no subprocess, fd, path, encoding or permission change, so no Windows sweep was dispatched.","timestamp":1795095066869845912}],"completion_expectation":"required","created_at":1795026815013180036,"creation_channel":"mcp","deps":[{"link_uuid":"3745ae90-9d90-4812-a354-d2772f36ce50","relation":"discovered_from","target_id":"e266-c398-f5cd-4a3c"},{"link_uuid":"970c9afa-ec9d-471f-ae11-52b5eb59992b","relation":"relates_to","target_id":"de35-96b0-3b4c-400b"}],"description":"## Context / Problem\nA gate run called with a ticket alias that hits a provider failure writes its `gate_error_v1` sidecar into a new alias-named directory instead of the ticket's directory. After that, the alias resolves to the stray directory and every later call by alias fails with `ticket \"<alias>\" has no CREATE or SNAPSHOT event`, so the ticket can no longer be verified by alias until someone cleans the store.\n\n### Observation\nIn an isolated scratch store (2026-11-18 PST), `rebar.llm.verify_completion(\"cushiony-feathered-anura\", source=\"local\")` failed at the provider (403, dummy AWS credentials). The failure path wrote a `COMPLETION_VERDICT` event with `schema: gate_error_v1` into a NEW directory `.tickets-tracker/cushiony-feathered-anura/` instead of the ticket's canonical directory `7689-bdbe-e709-49ef/`, and committed it.\n\n`emit_gate_error` (`src/rebar/llm/gate_error_sidecar.py:69`) passes the caller's `ticket_id` straight to `append_event` (`gate_error_sidecar.py:107`) without resolving it. `append_event` (`src/rebar/_commands/_seam.py:457`) is the low-level writer and expects a canonical id; the CLI write paths resolve first with `require_id` (`_seam.py:124`). Callers of `emit_gate_error`: `src/rebar/llm/workflow/gate_dispatch.py` (5 sites, e.g. `produce_completion_verdict` at :711 passes its raw `ticket_id`) and `src/rebar/llm/workflow/completion_failures.py:227`.\n\n`origin/tickets` has no alias-named directories (checked 2026-11-18), so the production MCP path has not hit this; the library call with an alias has.\n\n## Approach\nResolve once, inside `emit_gate_error`, before the write: `rid = resolve_ticket_dir_name(ticket_id, str(tracker))` (`src/rebar/_ids.py:605`, which raises `FileNotFoundError` for an id that does not resolve), then `append_event(rid, …)`. An unresolvable id is caught by the function's existing `except Exception` and returns `False` with no write, which keeps the emitter's best-effort contract (a failed emit never changes the gate outcome). Fixing the emitter rather than the 6 call sites covers every current and future caller; `append_event` itself stays unchanged because CREATE legitimately writes to a directory that does not exist yet.\nPortability: no filesystem, process or path-separator change; `resolve_ticket_dir_name` already returns a single separator-free segment.\n\n## Scope\n- `src/rebar/llm/gate_error_sidecar.py`: resolve the id in `emit_gate_error`.\n- `tests/unit/workflow/test_gate_error_sidecar.py`: regression tests.\n\n## Testing\n- Failing gate by alias: `gate_dispatch.produce_completion_verdict(<alias>, …, runner=<outage runner>)` raises `LLMUnavailableError`; the `gate_error_v1` record is in the canonical directory and no directory named after the alias exists.\n- Direct emit with an unknown id: `emit_gate_error(\"no-such-ticket\", \"completion\", cause=\"x\")` returns `False` and creates no directory.\n- Existing canonical-id tests in the same file stay green.\n\n## Acceptance Criteria\n- [x] A regression test calls a failing gate run with an alias and asserts the gate_error sidecar lands in the canonical ticket directory and no alias-named directory is created; `pytest tests/unit/workflow/test_gate_error_sidecar.py` passes.\n- [x] The gate_error sidecar emitter resolves the ticket id to its canonical directory before appending, and an unresolvable id writes nothing (verified by a test).\n- [x] `make verify` passes.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"src/rebar/llm/gate_error_sidecar.py","reason":"resolve the ticket id before append_event"},{"path":"tests/unit/workflow/test_gate_error_sidecar.py","reason":"alias regression tests"},{"path":"tests/unit/test_completion_sidecar_material_balding.py","reason":"stub the resolver in a storeless unit test"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["relates_to","de35-96b0-3b4c-400b"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"3b5ca807-13ae-48d0-8dca-d6c0482af526","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":["llm"],"ticket_id":"9325-1186-f822-4594","ticket_type":"bug","title":"A failed gate run called with an alias writes its gate_error sidecar into a new alias-named ticket directory","verify_commands":[]},"source_event_uuids":["bb739d42-7a0f-4358-9152-17f722cd7ae8","c1cc7158-1b40-4fde-a665-d0358cf83090","5e216bdf-31b6-4ef2-8c81-db892f8ccefc","58dcd8da-6e07-44b2-a85f-336bfc904259","44b347d8-2677-485e-8895-c5457c0c11fa","5f08e8cf-aa42-49ef-b343-48c970b77f35","970c9afa-ec9d-471f-ae11-52b5eb59992b","5abe874d-9220-4d3b-9ea1-bf6b46ba6376","0bbbb900-05bf-4ef4-932a-d93d93a5d78e","9aaae6ba-1bf7-42c3-aa55-3d0944f9a833","3b5ca807-13ae-48d0-8dca-d6c0482af526","b832faf7-260e-4350-b109-47c819660fa1"]},"env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","event_type":"SNAPSHOT","timestamp":1795095470927923057,"uuid":"eb25eadf-7ec7-4d35-b89b-f0064b59c267"}