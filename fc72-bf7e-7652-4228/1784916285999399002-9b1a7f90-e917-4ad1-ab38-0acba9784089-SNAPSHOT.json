71","position":"1784911892639138001-92fc9d06-9cfe-485e-9e23-ff7fb4a1f08e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"4b017a2e8c546d609479dcb6761b321f958a74cc3400440509aecd66b3b1641f","event_uuid":"cc07bfdc-4976-41a3-8ed8-3d30f499855a","position":{"commit_sha":"31bd84c14566b0655f32229f5eed1c8aef151fc6","position":"1784912015036093001-cc07bfdc-4976-41a3-8ed8-3d30f499855a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"0f1b7f3436eff8dea030d3a2f00bf1a70a468dff24cbb0440e6cb3fe50c70aa7","event_uuid":"444d0d7c-f483-46f4-868b-56e5fce4fcd3","position":{"commit_sha":"31bd84c14566b0655f32229f5eed1c8aef151fc6","position":"1784912015395897001-444d0d7c-f483-46f4-868b-56e5fce4fcd3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8c1d4f2f85d3a6aebc6747b1beb9905231748a5ea98fb0c4721f68990814a786","event_uuid":"4e10ec7a-a876-46f8-9d7f-e2578f603ed2","position":{"commit_sha":"b8aacef345d61d802cbdcc20f676ce499f1f2fb3","position":"1784912431923995077-4e10ec7a-a876-46f8-9d7f-e2578f603ed2"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2776de529f3e2e986dd7b20d69df01a138a37c5024c26a3e626af4b4bd108ea8","event_uuid":"8c353067-c0da-454f-9ddd-3e41d863a217","position":{"commit_sha":"764b9e65f53d10fa590fcb934a535bfae3250088","position":"1784916285999399001-8c353067-c0da-454f-9ddd-3e41d863a217"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1784669695352915001,"creation_channel":"cli","deps":[{"link_uuid":"8c353067-c0da-454f-9ddd-3e41d863a217","relation":"relates_to","target_id":"5a1b-3f23-66dc-4879"}],"description":"## Context / Problem\n\n`criterion_prompt_id` — the single logical→physical criterion-id map both review gates\ndelegate to — hardcodes the plan-review prompt prefix (`PLAN_REVIEW_PROMPT_PREFIX = \"plan-review-\"`\nat `src/rebar/llm/criteria/ids.py:31`, applied unconditionally at `ids.py:42`). So a project\n**code-review** criterion resolves into the plan-review prompt namespace, the first of five seams\nthat drop project code-review criteria (root cause on superseded bug 8a4b). This is the shared\nabstraction the other four seams consume, so it lands first.\n\n## Approach\n\nMake the resolver gate-aware, additively:\n\n- Add a keyword-only `gate_key: str = \"plan_review\"` parameter to\n  `criterion_prompt_id(criterion_id, *, gate_key=\"plan_review\")`.\n- Introduce a `_PROMPT_PREFIX = {\"plan_review\": \"plan-review-\", \"code_review\": \"code-review-\"}`\n  map in `ids.py`; select the prefix by `gate_key`; an unknown `gate_key` raises `CriteriaError`\n  (imported from `rebar.llm.criteria.model`, confirmed present at\n  `src/rebar/llm/criteria/model.py`).\n- The `.`→`-` namespace rewrite is unchanged, so `project.foo` + `code_review` →\n  `code-review-project-foo` and stays filesystem-safe and injective per the existing charset\n  invariant documented in the module docstring.\n\nThe default `\"plan_review\"` preserves today's behavior byte-for-byte, so the two existing callers\n(`src/rebar/llm/plan_review/registry.py:302`, `src/rebar/llm/workflow/criterion_preview.py:487`)\nneed **no** change and plan-review parity is guaranteed by construction. Code-review call sites\n(introduced by the fan-in and eval children) pass `gate_key=\"code_review\"` explicitly.\n\n**Rejected alternatives.** (a) Making `gate_key` *required* — it would force editing\n`eval.py:419`'s existing call, colliding with the eval-admission child's file set and breaking the\ndisjoint-file decomposition; the default is the historically-correct value, not a silent bug. (b)\nRegistering the prefix on the gate via `criteria.overlay.register_gate` — adds import-order\ncoupling to gate registration for no caller benefit; the forward-only map is the pattern the\nmodule docstring already commits to.\n\n## Scope\n\n- `src/rebar/llm/criteria/ids.py` — add `gate_key` param + `_PROMPT_PREFIX` map.\n- `tests/unit/test_code_review_project_criteria.py` — NEW file; the shared test file later\n  children extend. This child adds the resolver unit tests only.\n\n## Testing\n\n- Happy path: `criterion_prompt_id(\"project.foo\", gate_key=\"code_review\") == \"code-review-project-foo\"`;\n  `criterion_prompt_id(\"F1\", gate_key=\"plan_review\") == \"plan-review-F1\"`.\n- Parity/default: `criterion_prompt_id(\"F1\") == \"plan-review-F1\"` (no `gate_key` given) — existing\n  plan-review behavior unchanged.\n- Edge: an unknown `gate_key` raises `CriteriaError`; cross-gate injectivity — no code-review\n  project id collides with any plan-review physical id.\n\nTier: unit (pure function, no I/O).\n\n## Acceptance Criteria\n\n- [ ] `criterion_prompt_id(\"project.foo\", gate_key=\"code_review\")` returns\n      `\"code-review-project-foo\"`; verified by\n      `rtk .venv/bin/pytest -q tests/unit/test_code_review_project_criteria.py -k resolver`.\n- [ ] `criterion_prompt_id(\"F1\")` (no gate_key) still returns `\"plan-review-F1\"`, proving\n      plan-review parity; verified by the same `-k resolver` selector.\n- [ ] An unknown `gate_key` raises `CriteriaError`; verified by the same `-k resolver` selector.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/criteria/ids.py","reason":"Add keyword-only gate_key param + per-gate prompt-prefix map"},{"path":"tests/unit/test_code_review_project_criteria.py","reason":"New shared test file; resolver unit tests"}],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","119f-63e3-34b7-4f96"],["relates_to","5a1b-3f23-66dc-4879"]],"parent_id":"119f-63e3-34b7-4f96","parent_status_uuid":"cc07bfdc-4976-41a3-8ed8-3d30f499855a","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["review-architecture","project-criteria","integration"],"ticket_id":"fc72-bf7e-7652-4228","ticket_type":"story","title":"Gate-key the criterion-id resolver (criterion_prompt_id)","verify_commands":[]},"source_event_uuids":["06faf549-c2d2-4848-a1b1-a584b2714d07","eed4f97b-9c5d-4b2f-b480-311d5f29589e","9c6dc122-ba01-465a-a222-719c38eb0bb0","c81a2e06-d5c7-4b7e-a802-8c459a85b6da","92fc9d06-9cfe-485e-9e23-ff7fb4a1f08e","cc07bfdc-4976-41a3-8ed8-3d30f499855a","444d0d7c-f483-46f4-868b-56e5fce4fcd3","4e10ec7a-a876-46f8-9d7f-e2578f603ed2","8c353067-c0da-454f-9ddd-3e41d863a217"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1784916285999399002,"uuid":"9b1a7f90-e917-4ad1-ab38-0acba9784089"}