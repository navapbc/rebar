{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast,io,re,subprocess,sys,tokenize\nBASE=\"0033662b5534531d84e39d4a14bf75c8e768e85e\"\nOWNERS=(ast.Module,ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nclass Strip(ast.NodeTransformer):\n def generic_visit(self,node):\n  node=super().generic_visit(node)\n  if isinstance(node,OWNERS) and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str): node.body.pop(0)\n  return node\ndef src(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(text,path):\n tree=Strip().visit(ast.parse(text,filename=path,type_comments=True))\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(text):\n lines=text.splitlines()\n chosen=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),chosen\nbad_ast=[];bad_protected=[]\nfor path in sys.argv[1:]:\n before=src(BASE,path);after=src(\"HEAD\",path)\n if norm(before,path)!=norm(after,path): bad_ast.append(path)\n if protected(before)!=protected(after): bad_protected.append(path)\nassert not bad_ast,f\"non-docstring AST/runtime changes: {bad_ast}\"\nassert not bad_protected,f\"directive/shebang changes: {bad_protected}\"' tests/scripts/test_observability_memory_9ea3.py tests/scripts/test_observability_mirror_sync_bff5.py tests/scripts/test_observability_rotation_2dc7.py tests/scripts/test_reconciler_core_seam_clean_heldout.py tests/scripts/test_reconciler_jira_seam_clean_heldout.py tests/scripts/test_residual_drain_seam_clean_heldout.py tests/scripts/test_reviewbot_entrypoint.py tests/scripts/test_skill_mutation_sandbox_rule.py tests/scripts/test_store_snapshot_io_seam_clean_heldout.py tests/scripts/test_summarize_ci_failures.py tests/scripts/test_ticket_unblock.py","dd_id":"immutable-prose-only","dd_text":"Compare 0033662b5534531d84e39d4a14bf75c8e768e85e target blobs with the final commit; preserve executable AST/runtime strings and exact directive/shebang lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nexpected=sorted(sys.argv[1:])\nassert actual==expected,f\"changed paths differ: actual={actual}, expected={expected}\"' tests/scripts/test_observability_memory_9ea3.py tests/scripts/test_observability_mirror_sync_bff5.py tests/scripts/test_observability_rotation_2dc7.py tests/scripts/test_reconciler_core_seam_clean_heldout.py tests/scripts/test_reconciler_jira_seam_clean_heldout.py tests/scripts/test_residual_drain_seam_clean_heldout.py tests/scripts/test_reviewbot_entrypoint.py tests/scripts/test_skill_mutation_sandbox_rule.py tests/scripts/test_store_snapshot_io_seam_clean_heldout.py tests/scripts/test_summarize_ci_failures.py tests/scripts/test_ticket_unblock.py","dd_id":"exact-leaf-paths","dd_text":"Require the leaf commit changed-path set to equal the declared file-impact set exactly."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python scripts/check_comment_hygiene.py","dd_id":"comment-hygiene","dd_text":"Run the repository-supported narrow comment-hygiene signal."},{"command":"rtk