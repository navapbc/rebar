{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"verify_commands":[{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import ast,io,re,subprocess,sys,tokenize\nBASE=\"10a91af197f9b1016382f08d4f77b4e477c386be\"\nALLOWED={\"tests/scripts/test_observability_memory_9ea3.py\":[\"<module>\",\"_docker\",\"test_a_failed_memory_read_publishes_pessimistically_not_nothing\",\"test_two_deploys_of_the_same_service_collapse_to_one_dimension_value\",\"test_an_unparseable_row_is_counted_not_silently_dropped\",\"test_docker_stats_is_bounded_by_no_stream_and_timeout\",\"test_a_failed_container_census_publishes_its_heartbeat\"],\"tests/scripts/test_observability_mirror_sync_bff5.py\":[\"<module>\",\"test_a_failed_fetch_publishes_one_rather_than_nothing\",\"test_replication_errors_publishes_a_zero_heartbeat_without_a_log\"],\"tests/scripts/test_observability_rotation_2dc7.py\":[\"<module>\",\"test_shrinking_journal_publishes_zero_not_the_remaining_total\",\"test_markers_after_a_rotation_still_publish\"],\"tests/scripts/test_reviewbot_entrypoint.py\":[\"test_reviewbot_image_installs_openssh_for_sshsig\"],\"tests/scripts/test_skill_mutation_sandbox_rule.py\":[\"<module>\",\"test_rule_removal_is_detected\"],\"tests/scripts/test_summarize_ci_failures.py\":[\"<module>\"],\"tests/scripts/test_ticket_unblock.py\":[\"<module>\",\"_write_ticket\",\"test_no_newly_unblocked_when_blocked_by_other_ticket\",\"test_single_newly_unblocked_on_close\",\"test_multiple_newly_unblocked_on_close\",\"test_batch_graph_query_for_burst\",\"test_depends_on_direction_unblocks_dependent\",\"test_depends_on_does_not_unblock_the_blocker\",\"test_batch_close_finds_open_children\",\"test_batch_close_detects_unblocked\",\"test_batch_close_no_false_unblocks\",\"test_batch_close_excludes_archived\",\"test_detect_newly_unblocked_ignores_suggestions_dir\",\"test_unreducible_dir_with_a_tombstone_yields_a_status_only_stub\"]}\nPAT=re.compile(r\"#\\s*(?:noqa\\b|type:\\s*ignore\\b|pragma:\\s*no cover\\b|pyright:|mypy:|ruff:|pylint:|(?:fmt|isort):\\s*(?:on|off|skip)\\b|nosec\\b|coding[:=]|[A-Za-z][\\w-]*(?:-ok|-via):)\",re.I)\nclass Strip(ast.NodeTransformer):\n def __init__(self,allowed): self.allowed=allowed;self.stack=[]\n def enter(self,node,q):\n  self.stack.append(q)\n  if q in self.allowed and node.body and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Constant) and isinstance(node.body[0].value.value,str): node.body.pop(0)\n  node=self.generic_visit(node);self.stack.pop();return node\n def visit_Module(self,node): return self.enter(node,\"<module>\")\n def named(self,node):\n  parent=self.stack[-1] if self.stack else \"<module>\";q=node.name if parent==\"<module>\" else parent+\".\"+node.name;return self.enter(node,q)\n def visit_ClassDef(self,node): return self.named(node)\n def visit_FunctionDef(self,node): return self.named(node)\n def visit_AsyncFunctionDef(self,node): return self.named(node)\ndef src(ref,path): return subprocess.check_output([\"git\",\"show\",f\"{ref}:{path}\"],text=True)\ndef norm(text,path):\n tree=Strip(set(ALLOWED.get(path,[]))).visit(ast.parse(text,filename=path,type_comments=True))\n for node in ast.walk(tree):\n  if isinstance(node,ast.TypeIgnore): node.lineno=0\n return ast.dump(tree,annotate_fields=True,include_attributes=False)\ndef protected(text):\n lines=text.splitlines()\n chosen=[lines[t.start[0]-1] for t in tokenize.generate_tokens(io.StringIO(text).readline) if t.type==tokenize.COMMENT and PAT.search(t.string)]\n return (lines[0] if lines and lines[0].startswith(\"#!\") else \"\"),chosen\nbad_ast=[];bad_protected=[]\nfor path in sys.argv[1:]:\n before=src(BASE,path);after=src(\"HEAD\",path)\n if norm(before,path)!=norm(after,path): bad_ast.append(path)\n if protected(before)!=protected(after): bad_protected.append(path)\nassert not bad_ast,f\"non-allowlisted-docstring or executable AST/runtime changes: {bad_ast}\"\nassert not bad_protected,f\"directive/shebang changes: {bad_protected}\"' tests/scripts/test_observability_memory_9ea3.py tests/scripts/test_observability_mirror_sync_bff5.py tests/scripts/test_observability_rotation_2dc7.py tests/scripts/test_reviewbot_entrypoint.py tests/scripts/test_skill_mutation_sandbox_rule.py tests/scripts/test_summarize_ci_failures.py tests/scripts/test_ticket_unblock.py","dd_id":"immutable-prose-only","dd_text":"Compare 10a91af197f9b1016382f08d4f77b4e477c386be target blobs with the final commit; strip only allowlisted qualified-owner docstrings and preserve all other docstrings, executable AST/runtime strings, and exact directive/shebang lines."},{"command":"rtk env PATH=\"$PWD/.venv/bin:$PATH\" python -c 'import subprocess,sys\nactual=sorted(subprocess.check_output([\"git\",\"diff\",\"--name-only\",\"HEAD^\",\"HEAD\"],text=True).splitlines())\nexpected=sorted(sys.argv[1:])\nassert actual==expected,f\"changed paths differ: actual={actual}, expected={expected}\"' tests/scripts/test_observability_memory_9ea3.py tests/scripts/test_observability_mirror_sync_bff5.py tests/scripts/test_observability_rotation_2dc7.py tests/scripts/test_reviewbot_entrypoint.py tests/scripts/test_skill_mutation_sandbox_rule.py tests/scripts/test_summarize_ci_failures.py tests/scripts/test_ticket_unblock.py tests/scripts/test_check_config_reads_red_proof.py tests/scripts/test_check_config_reads.py tests/scripts/test_check_import_walk.py tests/scripts/test_check_orphaned_load.py tests/scripts/test_dependency_audit.py tests/scripts/test_mcp_client_pats.py tests/scripts/test_mutation_sandbox.py tests/scripts/test_normalize_ci_conclusion.py tests/scripts/test_observability_coldstart_e2a6.py tests/scripts/test_observability_data_disk_debris.py tests/scripts/test_observability_disk_pressure.py tests/scripts/test_observability_exit.py tests