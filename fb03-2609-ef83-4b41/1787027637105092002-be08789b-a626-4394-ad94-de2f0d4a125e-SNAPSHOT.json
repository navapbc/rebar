3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"b0a7f81d139cb35d20a4049fd5fafe320ed827ca036fa36db0921326bb08a31b","event_uuid":"f156cc20-7ff0-4ee2-96a1-d4816cc01985","position":{"commit_sha":"6703bf3bab74c45d664fdf8a26f6b9e15f98a4e1","position":"1787027456441852001-f156cc20-7ff0-4ee2-96a1-d4816cc01985"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8acf3df4cccf0d0046835f7864e2c40007e86692924ddeb91bcee885f7be414a","event_uuid":"48d27381-aac2-4f6a-91f5-cfb76f07c4ba","position":{"commit_sha":"e169b4914d75b1b170e1dc2ab5f7d973d9c19faf","position":"1787027637105092001-48d27381-aac2-4f6a-91f5-cfb76f07c4ba"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 1 RCA confirmed. Dynamic experiment: for each executing nested launcher, the parent process was given its own --basetemp while PYTEST_DEBUG_TEMPROOT pointed at an isolated shared root containing pytest-0..pytest-3 and a byte sentinel in pytest-0. Both outer tests returned rc=0, yet the sentinel was deleted: tests/unit/test_engine_dir.py::test_engine_submodules_resolve_when_the_tests_unit_shadow_is_active and tests/unit/test_scripts_import_convention.py::test_repro_module_passes_standalone. This observes the exact mechanism: each outer test launches a second pytest without --basetemp; repository autouse tmp_path fixtures force that child to allocate a user-numbered root, register cleanup_numbered_dir, and delete the unrelated cleanup-eligible pytest-0 at session finish. The pinned implementation basis is uv.lock:2403-2404 (pytest 9.1.1) and upstream _pytest/tmpdir.py getbasetemp / pytest_sessionfinish. Rival explanations were rejected because the outer session had an explicit basetemp, both target tests themselves stayed green, and only the unowned inner child could reach PYTEST_DEBUG_TEMPROOT. Defect legitimacy: defect; the existing isolation invariant is encoded by tests/unit/test_test_suite_store_isolation.py::test_nested_pytest_does_not_clean_shared_numbered_temp_root and the parent-owned precedents at tests/_store_isolation.py:32-48 and tests/unit/test_external_isolation.py:62-78. Caller-dependency sweep: these are leaf pytest tests; no caller relies on deleting unrelated temp trees. The three collect-only launchers are not siblings at runtime because TempPathFactory._basetemp remains None, and pytester-managed launches already inject basetemp. Phase 2 is unlocked.","timestamp":1787027456441852001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 2 mechanism implementation complete; held-out oracle remains absent and was neither inspected nor recreated. Updated tests/unit/test_engine_dir.py::test_engine_submodules_resolve_when_the_tests_unit_shadow_is_active to accept the parent tmp_path, assign its executing mixed-module child a unique tmp_path/mixed-module-pytest --basetemp, and visibly assert that the child materialized that assigned directory. Updated tests/unit/test_scripts_import_convention.py::test_repro_module_passes_standalone equivalently with tmp_path/standalone-pytest. Existing interpreter vs console-script entrypoints, cwd values, node selection, plugins, environment filtering, return-code assertions, and symptom assertions are unchanged. No collect-only or pytester-managed site changed. Verification: exact two affected nodes 2 passed; focused tests/unit/test_test_suite_store_isolation.py + test_engine_dir.py + test_scripts_import_convention.py 10 passed in 6.25s (raw pytest exit 0); make lint exit 0; make typecheck exit 0; git diff --check exit 0. The rtk-filtered focused run printed 10 passed but surfaced exit 1, so the identical raw pytest command was used to disambiguate and exited 0. Scope/safety: two test files only, no new dependency, no existing assertion weakened. Orchestrator still owns held-out GREEN, exact-defect mutation, broad unit gate, commit, push, and final report.","timestamp":1787027637105092001}],"created_at":1786891938793583001,"creation_channel":"cli","deps":[{"link_uuid":"51023544-c6ad-4038-a0ba-49eb47ba792e","relation":"discovered_from","target_id":"bf7c-333e-29b0-4ee4"}],"description":"## Context / Problem\nNested pytest sessions that execute tests requiring temporary fixtures without a private --basetemp join pytest's user-global numbered root and may delete unrelated cleanup-eligible trees at session finish. The parent pytest process owns the temporary lifetime, so each affected nested child must use a unique basetemp under its parent's tmp_path. This bug was discovered from grindable-deviant-angwantibo after its runtime RCA confirmed that cleanup mechanism.\n\n## Complete nested-pytest inventory\nDirect subprocess launch constructs:\n- tests/_store_isolation.py:32-48 is safe: it passes tmp_path / nested-pytest as --basetemp.\n- tests/unit/test_external_isolation.py:62-78 is safe: it passes tmp_path / bt as --basetemp.\n- tests/unit/test_ci_snapshot_fixture_cleanup.py:13-31 is safe: it passes tmp_path / nested-basetemp as --basetemp.\n- tests/unit/test_git_version_floor.py:143-178 is non-applicable: --collect-only exits during configuration under the fake under-floor Git and never allocates TempPathFactory._basetemp.\n- tests/unit/test_ci_workflow_parity.py:826-848 is non-applicable: its --collect-only children instantiate no fixtures and never allocate TempPathFactory._basetemp.\n- tests/unit/test_tests_import_convention.py:82-116 is non-applicable: its --collect-only children instantiate no fixtures and never allocate TempPathFactory._basetemp.\n- tests/unit/test_engine_dir.py:148-204 is confirmed unsafe: it executes the selected reducer test under repository conftest autouse fixtures, allocating the shared numbered root without --basetemp.\n- tests/unit/test_scripts_import_convention.py:142-178 is confirmed unsafe: it executes the standalone reproduction module under repository conftest autouse fixtures, allocating the shared numbered root without --basetemp.\n\nPytester's managed launches are already safe: six pytester.runpytest_subprocess calls in tests/unit/test_caplog_coverage_integrity.py:180-264 receive the helper's native numbered --basetemp, and four pytester.runpytest calls in tests/unit/test_repo_isolation_guard.py:158-215 pass through Pytester._ensure_basetemp. The literal pytest occurrences in tests/scripts/test_summarize_ci_failures.py:134 and tests/unit/grounding/test_deps.py:286-298 are test data, not launch sites.\n\nThe non-applicable classification follows pytest 9.1's _pytest.tmpdir.TempPathFactory contract inspected in the installed locked dependency: pytest_configure constructs the factory without allocating a root; pytest_sessionfinish returns immediately while _basetemp is None; getbasetemp is what creates and registers cleanup for the numbered root. Therefore a collect-only child that resolves no temporary fixture cannot execute this defect. A repository-wide AST/literal search plus a pytester.runpytest search found no other nested pytest launch sites. Pinned evidence: uv.lock:2403-2404 locks pytest 9.1.1; pytest 9.1.1 upstream src/_pytest/tmpdir.py lines 145-229 show getbasetemp creates the numbered root and registers cleanup, lines 244-254 show pytest_configure only constructs the factory, and lines 315-340 show pytest_sessionfinish returns while _basetemp is None (https://github.com/pytest-dev/pytest/blob/9.1.1/src/_pytest/tmpdir.py).\n\n## Approach\nAdd tmp_path to each of the two confirmed unsafe outer tests and pass a distinct child path through --basetemp. This follows the already-green ownership pattern in tests/_store_isolation.py:32-48 and tests/unit/test_external_isolation.py:62-78, keeps cleanup local to the parent fixture, and preserves each child's interpreter or console-script entrypoint, cwd, selectors, plugins, and assertions. The three collect-only launchers remain unchanged because runtime control flow cannot reach the cleanup mechanism; changing them would not repair a demonstrated defect.\n\nExtend the existing behavior-level real-subprocess regression in tests/unit/test_test_suite_store_isolation.py for the two executing sites, reusing assert_nodes_do_not_mutate_external_store from tests/_store_isolation.py. A seed child allocates an isolated PYTEST_DEBUG_TEMPROOT; the test then creates enough unlocked numbered directories to make the seed sentinel cleanup-eligible. The outer subprocess receives its own --basetemp so it cannot touch the shared root. It drives one affected outer test, whose nested child crosses the real numbered-root cleanup seam. The sentinel's exact bytes distinguish the broken and repaired behavior without timing sleeps or source-text assertions.\n\n## Scope\n- tests/unit/test_engine_dir.py: parent-owned basetemp for the mixed-module child.\n- tests/unit/test_scripts_import_convention.py: parent-owned basetemp for the standalone bare-pytest child.\n- tests/unit/test_test_suite_store_isolation.py: held-out real-subprocess regression for both confirmed cleanup sites.\n\nNo production module, dependency, configuration key, or public API changes.\n\n## Testing\n- RED oracle: seed an isolated shared numbered root, prove the sentinel is cleanup-eligible, run each affected outer test with an outer --basetemp, and assert its nested child deletes the sentinel before repair.\n- GREEN oracle: apply the repair and assert each exact sentinel byte payload remains unchanged.\n- Contrast/control: require each driven outer test to return success, preserving its existing entrypoint, cwd, selection, plugin, and assertion contract.\n- Mutation: remove one repaired --basetemp pair to restore the exact defect and confirm that site's held-out case returns RED, then restore it.\n- Focused: run the new regression plus tests/unit/test_engine_dir.py and tests/unit/test_scripts_import_convention.py.\n- Broad: run the CI default unit selection, make lint, and make typecheck.\n\n## Acceptance Criteria\n- [ ] The inventory classifies every direct and pytester-managed nested pytest launch; verified by repository AST, literal, and pytester.runpytest searches.\n- [ ] The engine-directory nested child leaves its cleanup-eligible sentinel byte-for-byte unchanged; verified by its parametrized case in tests/unit/test_test_suite_store_isolation.py.\n- [ ] The standalone import-convention nested child leaves its cleanup-eligible sentinel byte-for-byte unchanged; verified by its parametrized case in tests/unit/test_test_suite_store_isolation.py.\n- [ ] Existing nested entrypoint, cwd, selector, plugin, and child assertions remain green; verified by focused execution of both affected modules.\n- [ ] Removing a repaired --basetemp makes the corresponding held-out behavior case fail; verified by the exact-defect mutation run.\n- [ ] The CI default unit selection exits zero.\n- [ ] make lint exits zero.\n- [ ] make typecheck exits zero.\n","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"tests/unit/test_engine_dir.py","reason":"give the mixed-module nested run a parent-owned basetemp"},{"path":"tests/unit/test_scripts_import_convention.py","reason":"give the standalone bare-pytest child a parent-owned basetemp"},{"path":"tests/unit/test_test_suite_store_isolation.py","reason":"extend the existing held-out shared numbered-root cleanup regression"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"5cf9aea2-12fa-4e84-a374-558e91c10855","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["test-isolation","flaky"],"ticket_id":"fb03-2609-ef83-4b41","ticket_type":"bug","title":"Nested pytest meta-tests still clean the user-global numbered temp root","verify_commands":[{"command":"pytest -q tests/unit/test_test_suite_store_isolation.py tests/unit/test_engine_dir.py tests/unit/test_scripts_import_convention.py","dd_id":"DD1","dd_text":"behavior regression and affected nested launch modules pass"},{"command":"pytest -q tests/unit -m not\\ integration\\ and\\ not\\ external","dd_id":"DD2","dd_text":"default unit suite passes"},{"command":"make lint","dd_id":"DD3","dd_text":"repository lint gate passes"},{"command":"make typecheck","dd_id":"DD4","dd_text":"repository typecheck gate passes"}]},"source_event_uuids":["d6e57940-3198-48f2-b892-b1b5739459a3","74de0fcc-f510-4a0a-983d-947e66c908dd","58a9faf5-ae7d-4094-8ae5-124dd0c4ca4f","ca368cfc-11f2-4e1e-8611-28616dee5042","f43574f3-66fc-4cd0-aba8-337b89e98590","2a259496-7f5d-4916-bbb2-a5cf465dc410","17b0356a-712b-4a78-926f-eb3e23577ddf","0fa644eb-c2c8-4308-96e9-7eb2c86bc0d2","9ebc188a-126a-4a88-bd09-aafecf207e7a","63a9c92d-e2ab-47ea-95a9-3d8f76f09ba5","9fabdc58-b445-4ba5-a1eb-1456c8d8c165","5cf9aea2-12fa-4e84-a374-558e91c10855","8503321d-387a-4bf3-a9f2-63ef343a324c","f156cc20-7ff0-4ee2-96a1-d4816cc01985","48d27381-aac2-4f6a-91f5-cfb76f07c4ba"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787027637105092002,"uuid":"be08789b-a626-4394-ad94-de2f0d4a125e"}