uests":6}}],"version":1},"findings":[{"block_threshold":0.95,"blocking_enabled":false,"checklist_item":"- [ ] Add a seeded-defect (RED) assertion for at least one construct beyond `set -o pipefail` (e.g. `[[ ... ]]` or `${var^}`) so every forbidden-construct pattern is proven to fire.","cohort":["COH","E1","E2","E6","F1","T2","T4","T5e","T7"],"criteria":["E6"],"decision":"advisory","decision_margin":0.05,"drop_reason":null,"evidence":["AC5: 'Seeding `set -o pipefail` into a reachable recipe fails the static scan'","Mutation teeth: 'add `set -o pipefail` to a CI-reachable recipe'","AC4 lists five construct classes but only one is exercised by a seeded-defect test"],"finding":"The static scan enumerates several forbidden constructs (`[[ ... ]]`, indexed/associative arrays, `<<<`, `${var^}`, `${var,}`) but the mutation-teeth/RED oracle only seeds `set -o pipefail`. The pattern-detection logic for the other constructs is therefore never independently proven to fire, leaving false-negative regex risk (e.g. an array or `${var^}` pattern that silently never matches).","group_criteria":null,"group_id":null,"id":"fbf7193845d75625f","impact":1.0,"is_primary":null,"location":"Acceptance Criteria (AC4/AC5) and Testing (Mutation teeth)","norm_id":"n153589110267e50c","priority":1.0,"reason":"default-advisory","recalled":false,"scenarios":["A regex for `${var^}` case-modification is mis-anchored and never matches, so a bash-only construct votes green undetected."],"severity":null,"suggested_fix":"Extend the mutation-teeth step and add a parametrized RED case covering each of the five construct classes, asserting the scan names the offending construct and recipe.","tier":"LLM","validity":1.0,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"yes","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"yes","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"yes"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"certification_cannot_prove","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}},{"block_threshold":null,"blocking_enabled":null,"checklist_item":"","cohort":null,"criteria":["P6"],"decision":"advisory","decision_margin":null,"drop_reason":null,"evidence":["1 criterion line(s) bundle multiple deliverables with 'and' (split so each is independently verifiable)."],"finding":"Acceptance-criteria / definition-of-done quality issues.","group_criteria":null,"group_id":null,"id":"f607dd457c67f9209","impact":0.4,"is_primary":null,"location":"","norm_id":"ned06ebc801a522e3","priority":0.4,"reason":null,"recalled":false,"scenarios":[],"severity":"minor","suggested_fix":"Split compound criteria, replace subjective terms with observable outcomes, and state how each is verified.","tier":"DET","validity":1.0,"verification":null},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Specify that the derived closure traverses BOTH job-level reusable-workflow `uses:` and step-level composite-action `uses:`, and resolves a composite-action directory `uses:` to its `action.yml`, so the floor entry `.github/actions/docs-gates/action.yml` is provably inside the closure (note it is materialized at runtime from a remote ref).","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.265,"drop_reason":"novelty","evidence":["Floor tuple GUARDED_WORKFLOWS includes '.github/actions/docs-gates/action.yml' (test_predates_gate_guard_parity.py:49)","docs-gates is referenced via a step-level composite `uses: ./.github/actions/docs-gates` at gerrit-verify.yaml:206 and _build-and-test.yml:676 — never as a job-level reusable `uses:`","gerrit-verify.yaml:202-204 materializes the action.yml at runtime from refs/remotes/gh-main-docs-action, so the file is not necessarily present in a plain checkout","Plan says 'local `uses:` transitive closure' without specifying step-level vs job-level, nor how a composite-action directory `uses:` resolves to action.yml"],"finding":"The derived guarded-workflow closure must traverse STEP-LEVEL composite-action `uses:`, not only job-level reusable-workflow `uses:`; the existing floor includes `.github/actions/docs-gates/action.yml`, which is reachable ONLY via a step-level `uses: ./.github/actions/docs-gates` (gerrit-verify.yaml:206, _build-and-test.yml:676) — and is even materialized at runtime from a remote ref, so it is not a job `uses:`. If the closure reads only job-level reusable `uses:`, docs-gates is absent from the closure and the 'floor is a subset of closure' assertion fails immediately (a false RED), not on a seeded omission.","group_criteria":null,"group_id":null,"id":"f62829bd9b99c5ca7","impact":0.536,"is_primary":null,"location":"Approach step 1 / AC lines 1-2 (derived guarded-workflow coverage set)","norm_id":"n2d9952c39f6980b9","priority":0.335,"reason":"default-advisory","recalled":false,"scenarios":["Implementer parses only jobs.*.uses reusable-workflow edges and the floor-subset assertion fails on docs-gates before any seeded-omission mutation is even applied","A composite-action `uses:` naming a directory is not resolved to action.yml, so it never matches the floor's action.yml path"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.625,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"self_revealing","undecomposed":"none","vague_directive":"medium"}}},{"block_threshold":0.6,"blocking_enabled":true,"checklist_item":"- [ ] Either widen the forbidden-construct list to the fuller dash-hostile set (process substitution, `function` keyword, `&>`/`|&`, C-style `for ((;;))`, brace expansion) OR record why these are accepted residual risk (e.g. a complementary dash-exec check on the recipe's leading `set` line), so the scan covers the construct CLASS rather than five instances.","cohort":["G6"],"criteria":["G6"],"decision":"advisory","decision_margin":-0.435,"drop_reason":"novelty","evidence":["Plan enumerates exactly: 'set -o pipefail, [[ ... ]], indexed or associative arrays, here-strings <<<, and ${var^} / ${var,}'","The motivating incident (ticket 90c7) was `set -o pipefail` under dash — one member of a broader class of dash-hostile constructs","The plan's own rationale frames this as 'deterministic repository-text coverage of specific forbidden constructs' — i.e. explicitly a fixed list"],"finding":"The bash-only-construct scan is an enumerated denylist (`set -o pipefail`, `[[ ]]`, arrays, `<<<`, `${var^}`/`${var,}`) but the invariant it serves is the CLASS 'a bash-only construct that silently no-ops or errors under /bin/sh=dash'. Common bash-only shapes outside the list — process substitution `<(...)`/`>(...)`, `function name {}`, `&>`/`|&` redirection, C-style `for ((;;))`, `[[ ... =~ ... ]]` regex (a superset case), and brace expansion `{a,b}` — pass the scan and could let a future re-landed lane's recipe vote green without executing the intended commands, the exact incident shape.","group_criteria":null,"group_id":null,"id":"fe86da301ed5a8144","impact":0.33,"is_primary":null,"location":"Approach step 2 / AC line 4 (static scan construct list)","norm_id":"n5016cb9e32e98815","priority":0.165,"reason":"default-advisory","recalled":false,"scenarios":["A future CI-reachable recipe uses process substitution or `&>` redirection; the scan stays green while the recipe misbehaves under dash"],"severity":null,"suggested_fix":"","tier":"LLM","validity":0.5,"verification":{"binary":{"absence_confirmed_in_context":"na","asserted_capability_confirmed":"na","cited_reference_accurate":"yes","claims_absence":"no","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"no","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"yes","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"yes","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"medium","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"low","irreversible_without_rationale":"none","likelihood":"low","prod_impact":"none","reversibility":"easy","silent_vs_self_revealing":"silent","undecomposed":"none","vague_directive":"none"}}}],"impact_model_version":"plan-v5","material_fingerprint":"c02a62447958034c","material_parts":{"children":["647ea2107ca5072f",0],"description":["bfcb9bfdddfee3f9",5262],"description_boxes":["399141be1d30ac26",0],"file_impact":["d7ef333a44211e65",2],"ticket_id":["992696f3394518a3",19]},"metrics":{"cache_read_tokens":1585628,"cache_writ