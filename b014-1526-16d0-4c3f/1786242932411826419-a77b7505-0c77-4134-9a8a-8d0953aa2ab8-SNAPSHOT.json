32e6c-6592-40fb-8bed-6ddde9168023"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"99c5a3fcb995844e9bcb8b34a635965dc63ae08619e47c5852717c4b1a10180a","event_uuid":"fa7f7e72-73f0-4ea1-92dd-1575a61eab53","position":{"commit_sha":"1427b9e2932e50b2226e79d74dfc7a3a3eba2594","position":"1786241312503170001-fa7f7e72-73f0-4ea1-92dd-1575a61eab53"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"148d97170e4e9995caac8617f8985f61f7b5ddf047c11ad526291d4183955cbe","event_uuid":"16e438bf-1c68-4382-bf8b-031aef289c44","position":{"commit_sha":"5b6718be711129139eb3cead3796c99d10c3058c","position":"1786241889228206001-16e438bf-1c68-4382-bf8b-031aef289c44"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"fff907b26998d6f7ca08e34077950a20baf1d6ac3e9e74e7defddfc2b6b23b71","event_uuid":"ef10364a-a3cf-4a95-90a3-208e2d8fd41a","position":{"commit_sha":"1a153f6090dcd09c8c8c45f37a08b7ddb04e85c7","position":"1786242098047419001-ef10364a-a3cf-4a95-90a3-208e2d8fd41a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1786149396818320001,"creation_channel":"cli","deps":[{"link_uuid":"d7889489-96ce-459d-854d-cb35031f8e5a","relation":"depends_on","target_id":"0289-12a7-9890-4a17"},{"link_uuid":"e6d3afc3-918a-48d6-a62e-9f233bce84ed","relation":"relates_to","target_id":"645d-8e20-4ecf-4ee6"},{"link_uuid":"d6e0f5fa-6d9f-4f95-97ff-ed7257f25adb","relation":"relates_to","target_id":"c517-3f6d-83b9-4044"},{"link_uuid":"84acf043-076f-436f-bbe5-caecfcc4ea95","relation":"relates_to","target_id":"a079-a6dc-280e-4fd8"},{"link_uuid":"3dccf26a-3e9b-4890-abd7-8c9c6b8bc3c3","relation":"relates_to","target_id":"949c-4164-2c40-4881"}],"description":"## Context / Problem\n\nThe S3 ticket-store backend (parent epic) is only usable if operators can discover the\noptional dependency and configure S3 from the docs alone — today `docs/config.md` documents\n`sync.remote` (line ~128) and `tracker.branch` (line ~154) only for the GitHub/git case, and\nnothing names the `git-remote-s3` dependency, the SSE-KMS bucket setup, or the auto-doctor\nbehavior. This story documents the feature and records the architecture decision. It is\ndocumentation-only; the code lands in the sibling stories.\n\n## Approach\n\n1. **`docs/config.md`** — under the `sync` section, document that `sync.remote` may point at a\n   git remote whose URL is `s3://bucket/prefix` (or `s3+zip://`), served by the optional\n   `git-remote-s3` helper, and that this keeps ticket history entirely out of GitHub. Cross-\n   link the new backend page.\n2. **New `docs/s3-backend.md`** — the operator guide: (a) install the optional dependency\n   (`pip install 'nava-rebar[s3]'`, minimum `git-remote-s3>=0.3.2`); (b) create the SSE-KMS bucket\n   (default encryption with a customer CMK, versioning on, public-access-block on) and the\n   IAM policy scoped to the bucket + CMK; (c) add the git remote (`git remote add <name>\n   s3://bucket/prefix`) and set `sync.remote` to it; (d) the **trust boundary**: AWS\n   credentials come from the standard boto3 chain (never stored in rebar config or events),\n   data at rest is SSE-KMS in the customer bucket, S3 access is IAM/SigV4 (no anonymous\n   access); (e) operational behavior: the non-interactive auto-doctor self-heals a\n   multiple-bundles state by merge (no data loss), and a stale lock self-heals during the next\n   push's lock acquisition (git-remote-s3 v0.3.2 `remote.py` `acquire_lock` deletes a lock older\n   than the TTL and re-acquires in the same call; a manual `git-remote-s3 doctor --lock-ttl`\n   path also exists per `remote.py:236-237`). The TTL is `DEFAULT_LOCK_TTL_SECONDS`\n   = 60s (`remote.py:45`), overridable via the `GIT_REMOTE_S3_LOCK_TTL_SECONDS` env var — a\n   rare, bounded delay we intentionally do not lower. Primary-source verified against the v0.3.2\n   release tarball (tag `v0.3.2` = commit `9f3290e1f19090a9c11ae5b8c01ec8abe6184ab9`):\n   `git_remote_s3/remote.py:95` reads `os.environ.get(\"GIT_REMOTE_S3_LOCK_TTL_SECONDS\",\n   DEFAULT_LOCK_TTL_SECONDS)`, and the string `GIT_REMOTE_S3_LOCK_TTL` (no `_SECONDS`) appears\n   ONLY in upstream's README, in NO `.py` file of the release — so the code does not honor it.\n   The docs use — and flag — the `_SECONDS` form the code actually reads, with a \"verify against\n   your installed version\" note to remove any mislead hazard.\n3. **New `docs/adr/0093-s3-ticket-store-backend.md`** — record the decision: use\n   `awslabs/git-remote-s3` (Apache-2.0, maintained) below rebar's shell-out git layer so the\n   event/data format is unchanged; SSE-KMS (not client-side) is acceptable per requirements;\n   the multi-bundle risk is handled by a rebar merge-based auto-doctor because upstream's\n   `git-s3 doctor` is interactive and discards a head; lowering the lock TTL was rejected.\n   Follow the format of an existing ADR (e.g. `docs/adr/0091-*`); 0093 is the next free number\n   (highest existing is 0091). **An ADR is not a standalone file:** after writing the prose file\n   run `python scripts/gen_adr_index.py`, which (a) creates the per-number marker\n   `docs/adr/.numbers/0093` (content = the ADR filename — the add/add-conflict uniqueness\n   mechanism) and (b) regenerates the GENERATED, do-not-hand-edit index `docs/adr/README.md`\n   (the new ADR sorts into the \"Other decisions\" fallback group, since its slug matches no\n   workstream keyword). CI enforces both: `scripts/check_adr_numbers.py` asserts the\n   number↔file bijection and that no ADR cross-reference dangles, and `gen_adr_index.py --check`\n   fails if the committed marker/index drift from a regeneration. Commit the ADR file, its\n   `.numbers/0093` marker, and the regenerated `README.md` together, and ensure every link in\n   the ADR resolves (no dangling target).\n4. **`docs/README.md`** (docs index) and, if it lists extras, a one-line pointer — link the\n   new backend page and ADR so they are discoverable.\n\nRationale: a dedicated backend page plus an ADR matches how rebar already documents optional\ncapabilities and architecture decisions (the `docs/adr/` series), giving operators a single\nconfiguration entry point and preserving the decision record the maintainability criterion\nexpects; keeping it docs-only avoids coupling the write-up to any one code story's landing.\n\n## Scope\n\n- `docs/config.md` — extend the `sync.remote` documentation for the `s3://` case.\n- `docs/s3-backend.md` — new operator guide (install, bucket/KMS/IAM, config, trust\n  boundary, self-heal behavior).\n- `docs/adr/0093-s3-ticket-store-backend.md` — new ADR (prose file).\n- `docs/adr/.numbers/0093` — new per-number marker (generated by `scripts/gen_adr_index.py`).\n- `docs/adr/README.md` — regenerated ADR index (generated; not hand-edited).\n- `docs/README.md` — add index links to the two new pages.\n\nNo source, schema, or test changes. Running `scripts/gen_adr_index.py` (a repo-provided\ngenerator) to produce the two derived ADR artifacts above is part of the mechanical ADR-add\nprocedure, not a code change to the generator itself.\n\n## Testing\n\nDocumentation-only; no automated test tier applies (mechanical prose changes, consistent\nwith how other `docs/` and ADR changes land). Validation is by review against the acceptance\nchecks below.\n\n## Acceptance Criteria\n\n- [x] `docs/config.md` documents that `sync.remote` accepts an `s3://bucket/prefix` remote\n      served by the optional `git-remote-s3` helper and links `docs/s3-backend.md`. Verified\n      by the section being present and cross-linked.\n- [x] `docs/s3-backend.md` exists and contains all five subsections: install (naming\n      `pip install 'nava-rebar[s3]'` and the `git-remote-s3>=0.3.2` minimum), SSE-KMS bucket + IAM/CMK\n      setup, remote + `sync.remote` configuration, the credentials/encryption trust boundary,\n      and the auto-doctor + 60s stale-lock self-heal behavior. Verified by the named\n      subsections being present.\n- [x] `docs/adr/0093-s3-ticket-store-backend.md` exists, follows the existing ADR format, and\n      records the git-remote-s3 choice, SSE-KMS decision, the merge-based auto-doctor\n      rationale (vs upstream's interactive/discarding doctor), and the rejected TTL-lowering.\n      Its per-number marker `docs/adr/.numbers/0093` and the regenerated `docs/adr/README.md`\n      are committed, and `python scripts/gen_adr_index.py --check` + `scripts/check_adr_numbers.py`\n      both pass (bijection holds, no dangling ADR cross-reference). Verified by the ADR sections\n      being present and both ADR gates green in CI.\n- [x] `docs/README.md` links both new pages so they are discoverable from the docs index.\n      Verified by the links being present.\n\n---\n**Delivery note (landing-time deviation):** ADR number bumped from the planned 0092 to **0093**\nbecause ADR 0092 was claimed on `main` at landing time by\n`0092-bridge-primary-vocabulary-compatibility-adapters.md`. The plan's intent (\"next free ADR\nnumber\") is preserved; only the concrete number changed. Delivered as\n`docs/adr/0093-s3-ticket-store-backend.md` + `.numbers/0093`, regenerated `docs/adr/README.md`.\nMerged as Gerrit change 1552 (LLM-Review+1, Verified+1), commit b7d29e58c7.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"docs/config.md","reason":"Extend the sync.remote documentation (~line 128) to cover the s3://bucket/prefix case and cross-link the new backend page."},{"path":"docs/s3-backend.md","reason":"New operator guide: install the optional dependency, SSE-KMS bucket + IAM/CMK setup, remote + sync.remote config, trust boundary, and self-heal behavior."},{"path":"docs/adr/0062-s3-ticket-store-backend.md","reason":"New ADR recording the git-remote-s3 choice, SSE-KMS decision, merge-based auto-doctor rationale, and rejected TTL-lowering."},{"path":"docs/README.md","reason":"Add docs-index links to the new backend page and ADR for discoverability."}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["depends_on","0289-12a7-9890-4a17"],["parent","cf3c-1444-863e-49d7"],["relates_to","645d-8e20-4ecf-4ee6"],["relates_to","949c-4164-2c40-4881"],["relates_to","a079-a6dc-280e-4fd8"],["relates_to","c517-3f6d-83b9-4044"]],"no_file_impact_reason":"","parent_id":"cf3c-1444-863e-49d7","parent_status_uuid":"8c3be089-fae4-48a3-9ade-5e822e717ec1","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"b014-1526-16d0-4c3f","ticket_type":"story","title":"Document the optional S3 dependency, S3/SSE-KMS configuration, and the backend ADR","verify_commands":[]},"source_event_uuids":["912a8eea-92e2-4e0c-9796-f55f90d47537","ea52f715-5322-4f21-b360-127ec09737c3","d7889489-96ce-459d-854d-cb35031f8e5a","cf66530