{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1786242932411826419,"compiled_state":{"alias":"scattered-unshakable-waxwing","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"ade0f2ef-51cc-45a2-bb97-c09846cd3df5\", \"sig\": \"\"}]}","head_sha":"66cabeb4d5f5100feebbde143b059b991d890c33","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: b014-1526-16d0-4c3f","material: 489fc16f60dd10e5","material-part: children 647ea2107ca5072f 0","material-part: description 6223385bdc5d8937 7431","material-part: file_impact 79e0f1c296982276 4","material-part: ticket_id 079c443cf09705fa 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 4","review-phase: execution","priority-floor: 0.80","rebar-version: 0.11.0 (66cabeb4d5)","regver: 4f90349cd81c4911","verified-at-sha:b7d29e58c733d0d6d4ea48dc553bcca5350cd737","plan-material-pin: prerequisite 0289-12a7-9890-4a17 7aee1b865c1e7ef0","dep e9ec20cfab21f80ed83cf87ac292b8cd61cd2ec610675a34d757c599560db478 docs/README.md","dep absent docs/adr/0062-s3-ticket-store-backend.md","dep 8869f052d36eb8199a82df8e241b5d07d63532f6f17c3ab515206c41d5123391 docs/config.md","dep 07a014e3c42bfccd52742a6af7ec15d7c9ab209d816593ae29a1f68a2f1b53de docs/s3-backend.md"],"material_fingerprint":"489fc16f60dd10e5","merged_log_commit":"b7d29e58c733d0d6d4ea48dc553bcca5350cd737","principal":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","signature":null,"signed_at":1786242098046446000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":14,"unsigned":4},"authorship_ledger":[{"content_hash":"ce7fe90cb6c