19 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5f71109c735fa1c90ba1e7e305c5c566fdfba8f8c64942e90e4051a533481ec8","event_uuid":"350d155e-f4a7-463f-b0ff-26ebe33fdbd9","position":{"commit_sha":"ce609117dc6a1925e895297add41d55a4a366534","position":"1785195146657077001-350d155e-f4a7-463f-b0ff-26ebe33fdbd9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"591b8f0deea23e52244a86ff8533d004d4bd395c62647f9d54b61f43eaecca71","event_uuid":"1e15063e-207f-464a-bb3e-876826176731","position":{"commit_sha":"56608f9596c5c9570e44d7d915e64bd386456303","position":"1785196128595069552-1e15063e-207f-464a-bb3e-876826176731"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"924d7bddb156a522e8cd56a9cb14233f55ba162a53751d403dff4e4c676b9b2e","event_uuid":"11b7a38f-4569-49b4-ba1b-d81322d623a8","position":{"commit_sha":"66a79ccffdf77e913fb3bc0ac5bf368e41da7aac","position":"1785198304069894001-11b7a38f-4569-49b4-ba1b-d81322d623a8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ed71b9801f15469364db72564a1e9dfa0588ef225988de3b2e48ea09b695ddd4","event_uuid":"8f7a9755-017c-4acc-bfac-ca657510ac39","position":{"commit_sha":"b343d9799a9cc7ba31ef3731e1179b9dc97970fb","position":"1785200444454204001-8f7a9755-017c-4acc-bfac-ca657510ac39"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Phase 1 confirmed with real temporary Git clones and the production drain path. A shared completed enrichment cycle was followed by independent stale-clone cycles. Before maintenance the branches merged cleanly. With both current retention paths active, merge-tree reproduced rename/rename on TICKET_DIGEST plus rename/delete and modify/delete on DONE_ENRICH. Discriminating matrix: queue deletion disabled but digest keep=1 active remained RED solely on TICKET_DIGEST; digest deletion disabled but queue prune active remained RED solely on DONE_ENRICH; both physical-deletion paths disabled became GREEN with all preexisting queue/digest paths retained and clean tracker worktrees. Later writes on the conflicted clone still returned success after three failed merge retries and grew local-ahead, matching production 867 ahead / 20063 behind. This rules out credentials, mounts, connectivity, and ordinary UUID appends. Root cause set for the observed enrichment wedge is two automatic delete_events retention paths: enrich_drain queue pruning and digest_sidecar keep=1 pruning. Clone-local claim arbitration amplifies duplicate cycles but is not sufficient to wedge an append-only store. The best-effort push policy is an intended amplifier and will not be changed. A separate discovered bug, 55bc-b6bf-7adc-4108, tracks the same destructive-retention pattern in plan-review, code-review, and completion sidecars; those siblings require their own real two-clone RED proof before repair.","timestamp":1785198304069894001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Repair landed through Gerrit change 989 at be8a0c059571b340cd7705191769a4a64998643d. Gates: LLM-Review +1, Verified +1 (21 CI jobs, run 30318034093), zero unresolved comments. The real two-clone regression now asserts the generated merge tree contains the union of both independently written queue/digest histories. Review advisories were non-blocking and recorded as discovered work: 475e-9b99-9085-4b2d covers a future merge-safe bounded retention design; 980d-83ac-a6bb-4edb covers the Git 2.38 merge-tree test floor. The local tracker gate measured about 140 ms against its 20 ms budget during ticket writes, supporting the performance follow-up. Production recovery remains pending; no live tracker history has been reset, discarded, or rewritten.","timestamp":1785200444454204001}],"created_at":1785195138819062001,"creation_channel":"cli","deps":[{"link_uuid":"ef167505-2700-4ef2-b928-ea2c118fb7e7","relation":"discovered_from","target_id":"5b09-4f3d-58cc-41e4"}],"description":"## Context\n\nThe live review-bot tracker at `/var/gerrit/site/reviewbot-tickets` is healthy enough to accept local event commits but is currently 867 commits ahead and 20,063 behind `origin/tickets`. Each artifact write fetches and then fails three merge attempts, so all bot artifacts remain local. This divergence is independently defective even apart from missing artifact bug 5b09-4f3d-58cc-41e4.\n\n## Plan\n\n- Establish the exact merge base, divergence onset, conflicting paths, and first local/remote commits after the fork.\n- Trace the startup, write, fetch, merge-driver, and push-retry paths that allowed an append-only tracker to accumulate unreconcilable history.\n- Reproduce the confirmed mechanism against real temporary Git repositories under the rebar-debug RED→GREEN protocol.\n- Repair the lifecycle/reconvergence defect without losing locally committed artifact events, then recover the live tracker and verify it remains synchronized across a fresh artifact write.\n\n## Acceptance Criteria\n\n- [ ] The precise changeable cause of the live 867-ahead/20,063-behind divergence is proven with commit/path/runtime evidence.\n- [ ] Automated coverage reproduces the divergence mechanism before the fix and passes after it.\n- [ ] All locally committed review-bot events are preserved while the live tracker reconverges with `origin/tickets`.\n- [ ] A fresh live review artifact publishes to the shared branch and the tracker finishes at zero ahead/zero behind with a clean index and no recovery state.\n- [ ] The repair lands through Gerrit with LLM-Review +1, Verified +1, and zero unresolved comments.","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[],"parent_id":null,"parent_status_uuid":"4212885a-f147-4a73-9330-03d92c04c789","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"reverts":[],"status":"in_progress","tags":["review-bot","ticket-store","git","operability"],"ticket_id":"8185-2d4b-d2bf-4282","ticket_type":"bug","title":"Review-bot tracker accumulates unreconcilable tickets-branch divergence","verify_commands":[]},"source_event_uuids":["809bfe3b-cee7-429c-ac52-42a1ff13ec3c","ef167505-2700-4ef2-b928-ea2c118fb7e7","4212885a-f147-4a73-9330-03d92c04c789","350d155e-f4a7-463f-b0ff-26ebe33fdbd9","1e15063e-207f-464a-bb3e-876826176731","11b7a38f-4569-49b4-ba1b-d81322d623a8","8f7a9755-017c-4acc-bfac-ca657510ac39"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785200444454204002,"uuid":"6644963f-2a78-46cf-b8c7-f66fea461e18"}