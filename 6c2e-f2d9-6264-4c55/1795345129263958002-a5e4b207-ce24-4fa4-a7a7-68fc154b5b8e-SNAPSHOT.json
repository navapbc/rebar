9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Landed as Gerrit 3522 at c57ce8fbe17 (LLM-Review +1, Verified +1, 0 unresolved), merged ac5f513e27c. Checked on merged main: test_opcert_gate_config.py + test_verify_opcert*.py + verify_authorship/identity tests 65 passed; the 6 crash-shape cases failed on 8469f0a5ede; complexity ratchet new=0 increased=0; mechanism ratchet exits 0. make verify green locally (21727 + 231 passed); an earlier run caught the non-string event_type case not being judged, fixed before push. A local fuzz (every event kind x 11 malformed data shapes plus odd files, 168 cases) exits 1/2 with no traceback. Out of scope and NOT a crash: a stricter fuzz showed STATUS/CREATE/EDIT events with odd but object-shaped data (e.g. data null, status as a list) are treated as never-closing, so such a ticket stays out of scope when it cannot be reduced; filing as a follow-up.","timestamp":1795344649340667001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Correction to the previous comment: no follow-up is needed. The stricter fuzz's failing cases (STATUS/CREATE/EDIT with data absent or null, or status as a list) are events that cannot make the reducer's status the string 'closed' (process_create sets state['status'] = data.get('status', ...), and a list or missing value is not 'closed'), so treating such a ticket as never closed is correct. The fuzz's expectation was over-strict, not the gate.","timestamp":1795344688944085001}],"completion_expectation":"required","created_at":1795276774990935001,"creation_channel":"cli","deps":[{"link_uuid":"009fa3ee-c3d6-44cf-901e-ce52cd045383","relation":"discovered_from","target_id":"995a-152d-fbbd-4624"},{"link_uuid":"00e5aeaf-0a30-4575-9da7-33d6d95520b3","relation":"relates_to","target_id":"709a-2292-9987-4865"}],"description":"## Context / Problem\n\nscarlet-unsocial-limpkin (Gerrit 3500, `8469f0a5ede`) added `_may_be_closed` and `_sets_closed` to `src/rebar/_commands/verify_opcert.py`. Its LLM review left 2 advisory findings:\n- `_sets_closed` calls `.get` on `event[\"data\"]` and `data[\"fields\"]` without checking they are dicts. A raw event whose `data` or `fields` is a non-empty string or list raises `AttributeError`. That happens inside `_scoped_state`'s `except` handler, so `rebar verify-opcert` crashes with a traceback instead of judging the ticket. A crash exits non-zero (so the gate does not pass), but the operator gets a traceback, not a named ticket.\n- No test drives 3 of `_may_be_closed`'s \"may be closed\" branches: an event file that does not parse, JSON that is not an object, and a ticket directory with no active event files.\n\nReproducing it showed 2 more crash sites on the same malformed input, both before `_sets_closed` is reached: `_close_anchor_event` (`src/rebar/_commands/verify_opcert.py`) calls `(ev.event.get(\"data\") or {}).get(\"status\")`, so a STATUS whose `data` is a string raises; and `_event_from_file` (`src/rebar/_commands/verify_authorship.py`, used by the merged-log walk `_collect_all` for both `verify-opcert` and `verify-identity`) calls `event.get(...)` on parsed JSON, so a file holding a JSON list raises. Review and a local fuzz (every event kind times 11 malformed `data` shapes, plus non-object and odd `event_type` files, with and without a failing reduce: 168 cases) found 2 more in `verify_authorship.py`: `_ledger_events` chains `.get` through a SNAPSHOT's `data` and `compiled_state`, and `_event_from_file` tests `event.get(\"event_type\") not in KNOWN_EVENT_TYPES`, which raises `TypeError` when `event_type` is a list.\n\n## Approach\n\n- `_sets_closed`: a non-dict `data` or `fields` returns True (\"may be closed\"), so the ticket is judged.\n- `_close_anchor_event`: skip an event whose `data` is not a dict (it cannot be a close anchor; a missing anchor is already enforced).\n- `_event_from_file`: return `[]` for parsed JSON that is not an object, exactly as it already does for unparseable JSON, and for an `event_type` that is not a string (it cannot be a known type). That keeps `verify-identity`'s handling of such a file identical to an unparseable one, which it already tolerates.\n- `_ledger_events`: read `data` and `compiled_state` with type checks, returning no ledger entries when either is not an object. Add tests for the 4 cases in `tests/unit/test_opcert_gate_config.py`, reusing `_write_event` (extended to write raw text) and `_break_show_ticket`.\n\nNo config key, env var or flag is added.\n\n## Scope\n\n- `src/rebar/_commands/verify_opcert.py`\n- `src/rebar/_commands/verify_authorship.py`\n- `tests/unit/test_opcert_gate_config.py`\n\n## Testing\n\nWith `show_ticket` raising for an in-progress ticket and `--require-environment` set, each of these makes the gate exit 1 and report `unreadable ticket state` for it: an event file holding invalid JSON; a file holding a JSON list; a ticket directory whose only files are retired (`.json.retired`); a STATUS event whose `data` is a string. The STATUS-data-string, EDIT-fields-list, JSON-list, SNAPSHOT-data-string, SNAPSHOT-compiled-state-list and event-type-list cases raise against `8469f0a5ede`; each is a parametrized case of `test_malformed_raw_event_is_judged_not_a_crash`. Existing `verify-identity`/`verify-authorship` tests must still pass. Then `make verify`.\n\n## Acceptance Criteria\n\n- [x] A raw event whose `data` or `fields` is not an object no longer crashes `rebar verify-opcert`; the ticket is judged and reported `unreadable ticket state`: shown by a test that fails on `8469f0a5ede`.\n- [x] Tests cover an unparseable event file, a non-object JSON file and a directory with no active event files, each judged (exit 1 with a required environment).\n- [x] The existing `verify-opcert` and `verify-authorship`/`verify-identity` unit tests pass unchanged.\n- [x] `python scripts/check_complexity_baseline.py --check` reports `new=0 increased=0`, and `python scripts/check_mechanism_delta.py --check` exits 0.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_commands/verify_opcert.py","reason":"judge malformed events instead of crashing"},{"path":"src/rebar/_commands/verify_authorship.py","reason":"treat non-object JSON event files like unparseable ones"},{"path":"tests/unit/test_opcert_gate_config.py","reason":"cover malformed and may-be-closed branches"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[["relates_to","709a-2292-9987-4865"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"4e32d9e3-41f3-4d42-8c2f-2a8f63c41600","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"releases":[],"repos":[],"reverts":[],"status":"closed","tags":[],"ticket_id":"6c2e-f2d9-6264-4c55","ticket_type":"bug","title":"verify-opcert crashes on a malformed raw event in an unreadable ticket","verify_commands":[]},"source_event_uuids":["73198ca3-7920-4de2-bf63-8e6c210ba593","bc187640-53fc-4825-8399-16990d16350a","c89b56d9-c266-48d6-aad2-cba9bd386c1f","43946b0e-2986-4e0d-8d91-43e9c980795c","7c5999b9-dc98-4d34-ac2d-1533c322c733","11465aaa-f78f-4a0d-8b6d-a3312ee926a5","00e5aeaf-0a30-4575-9da7-33d6d95520b3","dadfaaa2-7584-45fe-9fb0-729f8609fce2","7c56c3fb-f679-480b-b543-896c73a856b2","1910ea4d-c211-448e-a87f-7d2c9b595299","4e32d9e3-41f3-4d42-8c2f-2a8f63c41600","7010f408-3ea3-4618-ba7d-5c20f5855284"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795345129263958002,"uuid":"a5e4b207-ce24-4fa4-a7a7-68fc154b5b8e"}