{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","author_sig":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","data":{"content_hash":"999b304904e526e723b56433b74f2ace1871bc45e755ef740a0c8f5a961b648c","digest":{"component_or_area":"Gerrit review bot voter","key_entities":["voter.py:366,374","gerrit_client.py:368","voter.py:657","patchSet.ref","patchSet.revision","app.py:280","review_bot/adapter.py:184","review_bot/adapter.py:6","FETCH_HEAD","WEBHOOK_TOKEN","clone_change_ref"],"problem_keywords":["gerrit","review bot","tree","revision","mismatch","assertion","fetch","checkout"],"propositions":["The review bot fetches a tree using patchSet.ref but votes against patchSet.revision, which are independently supplied fields that may not refer to the same commit","The reviewed tree and the voted revision can become decoupled due to stale clone directories, partial fetches, or refactored checkout logic, producing no error signal","The resolved FETCH_HEAD must be asserted equal to patchSet.revision after fetch and checkout to bind the reviewed tree to the voted revision","A mismatch between FETCH_HEAD and patchSet.revision must refuse to vote with a fail-closed behavior and actionable error message"]},"digest_hash_version":1,"model":"bedrock:us.anthropic.claude-opus-4-8","schema":"ticket_digest_v1"},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"TICKET_DIGEST","timestamp":1787381552760367001,"uuid":"a85756bc-3506-48b5-ad0a-6b27fe450926"}