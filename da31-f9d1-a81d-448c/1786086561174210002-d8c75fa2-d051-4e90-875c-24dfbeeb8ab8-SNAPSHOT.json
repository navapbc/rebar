37a-d30e-4624-a8cb-a846ef24e2b0","position":{"commit_sha":"b2931df8737df87e572c3c3c31c29dd76ea598a7","position":"1786081184703912001-e66d437a-d30e-4624-a8cb-a846ef24e2b0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"488413ba30304e130847ab751e5c0c2b05ca421acc479697ff50c02b7301dfe5","event_uuid":"ef945557-8ea4-4a7d-acfd-6dfe2c2506ff","position":{"commit_sha":"09bfeeb2252cc77ae04ecabd17ea99e132a59296","position":"1786086561174210001-ef945557-8ea4-4a7d-acfd-6dfe2c2506ff"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":"claude-code_2-1-223_agent","claim_remote_session":null,"claimed_session":"6ff494b3-b67f-4284-9d1e-818a0b7eecfd","comments":[],"created_at":1786046886458291001,"creation_channel":"cli","deps":[{"link_uuid":"91895298-1e46-440a-98a3-8ffa2baac372","relation":"relates_to","target_id":"a96e-698b-1fbb-4ed1"},{"link_uuid":"e292c975-9676-4921-a207-eb1ba57768cf","relation":"relates_to","target_id":"1eac-dea7-c34f-42de"},{"link_uuid":"e9766ec5-aba2-4e9f-a421-41a247f3ba58","relation":"relates_to","target_id":"c7e4-ca22-a303-4b73"}],"description":"The Gerrit review bot fetches the tree from webhook-supplied `patchSet.ref` (`voter.py:366,374` →\n`gerrit_client.py:368`) but casts its vote against `patchSet.revision` (`voter.py:657`). Those are\ntwo independently-supplied fields, so the tree that was reviewed and the revision the vote attaches\nto need not be the same commit — on one of the two mandatory merge gates.\n\nVerified during approval and deliberately reframed: this is NOT a live vulnerability. Gerrit always\nemits the pair consistently (each patchset has its own immutable `refs/changes/NN/CCCC/P`), so a\ncontributor cannot decouple them. Decoupling requires forging a webhook, which requires\n`WEBHOOK_TOKEN` (`app.py:280`, correctly compared with `hmac.compare_digest`).\n\nThe durable justification is non-adversarial: `clone_change_ref` fetches into `repo_root`, and the\nreviewed tree is whatever ends up there. A stale or reused clone dir, a partial fetch, or a future\nrefactor of the checkout logic all produce a tree that is not the voted revision, with no signal.\n\nScope refined by the maintainer to the assertion only. The `--end-of-options` hardening was dropped:\nHTTPS transport already blocks the exploit path, and both proposers had independently scoped the\nother ~89 git call sites out as a separate sweep.\n\n`review_bot/adapter.py:184` takes `ref` as a required positional and never reads it. Both proposers\nindependently chose to give it this job rather than delete it, preserving the seam contract that\n`adapter.py:6`, ADR 0009, ADR 0015, and `docs/gerrit-aws-setup.md:411-413` all describe.\n\n## Acceptance Criteria\n\n- [x] After fetch and checkout, the resolved `FETCH_HEAD` is asserted equal to `patchSet.revision`\n- [x] A mismatch refuses to vote, fail-closed, with an actionable message\n- [x] `adapter.py`'s `ref` parameter performs that assertion instead of being unread\n- [x] A test covers the mismatch path (a false mismatch would block all reviews)","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[],"file_impact_scope":"undeclared","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","b5bc-f4f7-3433-4181"],["relates_to","1eac-dea7-c34f-42de"],["relates_to","a96e-698b-1fbb-4ed1"],["relates_to","c7e4-ca22-a303-4b73"]],"no_file_impact_reason":"","parent_id":"b5bc-f4f7-3433-4181","parent_status_uuid":"0cbbe654-f8b8-479f-b2b4-912563f73d70","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":["janitor"],"ticket_id":"da31-f9d1-a81d-448c","ticket_type":"bug","title":"Bind the reviewed tree to the voted revision in the review bot","verify_commands":[]},"source_event_uuids":["4ae208ce-f785-4dfb-8a98-175a796d0ad1","0cbbe654-f8b8-479f-b2b4-912563f73d70","5176b24d-ea6c-44d9-a05b-e103add65924","91895298-1e46-440a-98a3-8ffa2baac372","e292c975-9676-4921-a207-eb1ba57768cf","66936079-deed-4563-a815-e216b9cc3f36","e66d437a-d30e-4624-a8cb-a846ef24e2b0","e9766ec5-aba2-4e9f-a421-41a247f3ba58","ef945557-8ea4-4a7d-acfd-6dfe2c2506ff"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1786086561174210002,"uuid":"d8c75fa2-d051-4e90-875c-24dfbeeb8ab8"}