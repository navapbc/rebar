{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793509683174319001,"compiled_state":{"alias":"roundbuilt-manlike-tapaculo","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"ce5795c6a5c8f232b906c43a788f4dc51d5abc2e","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: c670-c285-a0f9-4b40","material: aa86fd964b3ff6cc","material-part: children 647ea2107ca5072f 0","material-part: description 28c35d710c059099 7950","material-part: description_boxes 1a0f564ddc603945 0","material-part: file_impact 5895ab57b0fe86ae 5","material-part: ticket_id b36aa2a944adce71 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 8","review-phase: planning","rebar-version: 0.14.0 (ce5795c6a5c)","regver: aa61189569d34126","verified-at-sha:ce5795c6a5c8f232b906c43a788f4dc51d5abc2e","dep absent docs/adr/","dep e445c543952324566fd8bdd4fb37e83b9afe8a2a362d7d8a735492b0ed27abd3 docs/adr/README.md","dep absent evals/similar-tickets/README.md","dep absent evals/similar-tickets/benchmark.json","dep absent evals/similar-tickets/measure.py","read-set: 15","read-path: docs/adr/0059-llm-provider-seam-and-support-tiers.md","read-path: docs/adr/0086-cross-ticket-overlap.md","read-path: docs/cli-reference.md","read-path: docs/release-notes.md","read-path: infra/runbooks/bedrock-access.md","read-path: infra/terraform/iam_s7.tf","read-path: rebar.toml","read-path: scripts/check_adr_numbers.py","read-path: scripts/gen_adr_index.py","read-path: src/rebar/llm/bedrock_model.py","read-path: src/rebar/llm/contracts.py","read-path: src/rebar/llm/evals/provider_parity.py","read-path: src/rebar/llm/model_classes.py","read-path: src/rebar/llm/runner.py","read-path: src/rebar/llm/structured_run.py","currency-basis: file_impact"],"material_fingerprint":"aa86fd964b3ff6cc","merged_log_commit":"ce5795c6a5c8f232b906c43a788f4dc51d5abc2e","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1793483867513620000}},"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":10,"unsigned":9},"authorship_ledger":[{"content_hash":"8d5850cee243979f38fc0ffb9c913771dd4c3a5e5803f3a2d49cbdbb2dfc7abd","event_uuid":"b837ca06-a79b-4ef6-a1c9-8449c6b942ee","position":{"commit_sha":"ca49b9c5cc92b8e124a19872849de00f198c90c3","position":"1793494833881259653-b837ca06-a79b-4ef6-a1c9-8449c6b942ee"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"d15e3accd99beb3f8ec9a8f017a08e33f4bd08c69348153dd1a682686fb21beb","event_uuid":"c3c68aef-9342-4ba3-866a-25036f84de62","position":{"commit_sha":"16c5519f01c21fc74ce85da2c93c175b29537e46","position":"1793498479789406984-c3c68aef-9342-4ba3-866a-25036f84de62"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"b491c36794a88be286a4b9de2531fae20d16bb6e3f5d445515410bc321ac58cc","event_uuid":"1726bb32-a1c6-4f8e-a03b-c41b57560c1b","position":{"commit_sha":"16c5519f01c21fc74ce85da2c93c175b29537e46","position":"1793498479823752927-1726bb32-a1c6-4f8e-a03b-c41b57560c1b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"af58b3aba6c9f5defd68ecac42515de02eeb96e7d2d3fcd5aa98e00f53a38913","event_uuid":"5c5ee102-4a0e-49fe-bb29-942ddc0bbdca","position":{"commit_sha":"b72360c3303393d3f266d8aed6fff7d9b9859822","position":"1793501291335574036-5c5ee102-4a0e-49fe-bb29-942ddc0bbdca"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"2db45c5e7625ab7c4bc7cb2c00ce095f5cc130956714713df798fbed904006eb","event_uuid":"96d88d9f-e077-4880-998d-a83e87b27d0d","position":{"commit_sha":"32ec7fb7c832e50aa24082e5dfe3623b87c3bc33","position":"1793502642749471116-96d88d9f-e077-4880-998d-a83e87b27d0d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"06a1cd9a9fa852f42bd9be51ee35dd5f7ea504c34a12dbf31eb1339f1bf993ef","event_uuid":"a1659c48-7ce1-49e2-851c-983859072c03","position":{"commit_sha":"66f1daaf0677ed5095f0e46a55cbdc7d92afef26","position":"1793503472065380682-a1659c48-7ce1-49e2-851c-983859072c03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"a97fe931911738927dd81275055ee50c5ce207a184f2d7d4cbb7c1b0a303fcd4","event_uuid":"82e376af-928e-4720-b4c9-31c95ec33fc8","position":{"commit_sha":"34ec529a243e3a1a97c500e1fe1799c246803c61","position":"1793504627100724255-82e376af-928e-4720-b4c9-31c95ec33fc8"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"723cb487697518bc2a1b46ca862af1ae7f2b0df5f08e9332899f7b6cee7e3ebf","event_uuid":"b8642ca6-8d38-417c-8551-c677788b88ad","position":{"commit_sha":"f243c81e339dac8d15f1db3f559b695ab0014bee","position":"1793504749560937195-b8642ca6-8d38-417c-8551-c677788b88ad"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pre-sweep against origin/main 7927904a0 and tickets-branch 0b9294311b5. This plan's central number was stale in a way that would have inverted the epic's conclusion, so the Context, Approach, Scope, Testing and all acceptance criteria were rewritten. The title no longer pins a pair count, so it cannot go stale the same way again.\n\nWhat was wrong. The plan said '51 known duplicate pairs identified in ticket eac3, of which 44 are semantic', and AC1 required benchmark.json to hold 51 pairs. eac3 did measure 51, honestly and by this exact method, but it measured 2,679 tickets and 43 recorded duplicates links. Running the plan's own stated procedure today over 5,663 live tickets finds 482 links closing into 148 clusters over 630 tickets, enumerating to 1,524 pairs. AC1 was therefore unsatisfiable by its own Approach: no implementation could follow 'exactly as eac3 did' and arrive at 51. Counting both archived and live tickets gives the same 1,524, so archiving does not explain the gap.\n\nWhat the re-measurement found that matters more than the count. 1,431 of the 1,524 pairs -- 94 percent -- have byte-identical normalized titles. They sit in 84 clusters that are each a single repeated title; the largest is 12 copies of one bridge-state rotation ticket and the next is 9 copies of one comment-triage ticket. Those are bulk-creation artifacts, almost certainly a retry loop, not independently authored duplicates. Normalized-title matching scores about 100 percent recall on them. A benchmark that pooled all 1,524 pairs would therefore have reported near-perfect recall for the cheapest lexical candidate and rejected vector search -- on an artifact. That is the precise opposite of eac3's finding, which was that the duplicates worth catching are semantic: it measured 14 percent lexical recall because 44 of its 51 were semantic.\n\n93 pairs have differing titles. That is the real benchmark, it is double eac3's 44, and it is the same kind of set. Spot-checked samples confirm the character: 'Attested snapshot fetch pulls unrelated oversized tickets branch' against 'Attested ref materialization broad-fetches all origin heads'; 'rebar doctor command' against 'rebar doctor: diagnose-and-heal health command'.\n\nThe rewrite keeps the story's intent -- choose a retrieval architecture on measurement -- and makes it measurable: the fixture stratifies every pair as lexical or semantic, recall is reported per stratum and never pooled, the semantic stratum is the decision criterion, and the lexical stratum is a control every candidate should near-saturate. The fixture records the tickets-branch SHA it was derived at, and --check re-derives the set at that SHA and refuses a fixture whose SHA is not an ancestor of current HEAD, so this specific staleness is now caught by the runner instead of by a reviewer.\n\nThree further corrections, each measured rather than assumed:\n- Scope said the top-level evals/ tree is created by the eval-harness epic's corpus-move story and that this story depends on it. That dependency has landed: evals/ was created by commit 91d39fd6061, 'Move research corpus out of docs to evals/'. Restated as completed work.\n- Candidate 2 pointed at the retired ticket_digest prompt via 'the commit before its removal, recorded on the closing comment of the removal story under epic bossy-skittish-foal' -- an indirection through a comment that may or may not carry the SHA. Measured directly: the prompt was deleted by 2de5f341ec4, so it is readable at parent f147e08242f, where it lives in src/rebar/llm/contracts.py and src/rebar/llm/overlap/. The SHA is now named in the plan.\n- Candidate 3 said boto3 is provided by the bedrock extra. The extra is pydantic-ai-slim[bedrock], which pulls boto3 transitively; boto3 1.43.68 imports in the worktree venv. Reworded to state the actual path rather than imply a direct dependency.\n\nVerified correct and left alone: rebar list --full exists and is accepted; rebar.toml carries [llm] bedrock_region_name = us-east-1 at :213; scripts/check_adr_numbers.py and scripts/gen_adr_index.py both exist; docs/ticket-model.md documents the duplicates relation at :136 and :143. This ticket has no blockers, so it is reviewable now.","timestamp":1793478649488647001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Detail moved out of the description to fit the 8,000-char plan-review admission cap. No figure or decision changed; the description keeps every acceptance-bearing statement.\n\nIllustrative detail moved out of the description to stay under the 8,000-character plan-review admission cap while the three blocking findings were addressed. No figure changed.\n\nRe-measured on tickets-branch 0b9294311b5 (5,663 live tickets): 482 recorded `duplicates` links close into 148 clusters over 630 tickets, enumerating to 1,524 within-cluster pairs. eac3 measured 2,679 tickets, 43 links and 51 pairs. The growth is not uniform, and the difference matters more than the count: **1,431 of the 1,524 pairs (94%) have byte-identical normalized titles**, concentrated in 84 clusters that are entirely one repeated title — the largest is 12 copies of \"A2-1: move last_get_pass rotation bookkeeping into .bridge_state/get_rotation.json\", next is 9 copies of \"Comment triage: relocate history, rationale and contracts out of src\". Those are bulk-creation artifacts, almost certainly a retry loop, not independently authored duplicates.\n\nThis is why the benchmark cannot simply be \"all recorded pairs\". Normalized-title matching scores ~100% recall on those 1,431, so a benchmark that includes them unstratified would report near-perfect recall for the cheapest lexical candidate and reject vector search on an artifact of bulk creation — inverting the epic's decision. eac3's central finding was the opposite: the duplicates worth catching are semantic, not lexical (it measured 14% lexical recall, 44 of 51 semantic).\n\n**93 pairs have differing titles.** Those are the semantic set, and they are the benchmark: double eac3's 44, same kind, drawn from 64 mixed clusters (56 of size 2). Samples confirm the character — \"Attested snapshot fetch pulls unrelated oversized tickets branch\" vs \"Attested ref materialization broad-fetches all origin heads\"; \"rebar doctor command\" vs \"rebar doctor: diagnose-and-heal health command\".\n\n---\n\n\nFurther Context detail condensed (no figure changed):\n\nRe-measured on tickets-branch 0b9294311b5 (5,663 live tickets): 482 recorded `duplicates` links close into 148 clusters over 630 tickets, enumerating to 1,524 within-cluster pairs (eac3 measured 2,679 tickets, 43 links, 51 pairs). The difference matters more than the count: **1,431 of the 1,524 (94%) have byte-identical normalized titles**, concentrated in 84 single-title clusters — bulk-creation artifacts, almost certainly a retry loop, not independently authored duplicates. Examples are on a comment.\n\nThe benchmark therefore cannot be \"all recorded pairs\": normalized-title matching scores ~100% recall on those 1,431, so an unstratified benchmark would report near-perfect recall for the cheapest lexical candidate and reject vector search on a bulk-creation artifact — inverting the epic's decision. eac3 found the opposite (14% lexical recall, 44 of 51 semantic).\n\n**93 pairs have differing titles.** Those are the semantic set and they are the benchmark: double eac3's 44, same kind, drawn from 64 mixed clusters (56 of size 2). Sample pairs are on a comment.","timestamp":1793482125108504001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Detail moved out of the description to fit the 8,000-char admission cap (no figure or decision changed):\n\ncalled with the boto3 `bedrock-runtime` client's `invoke_model` and a JSON body of `{\"inputText\": ..., \"dimensions\": 1024, \"normalize\": true}` (input limit 8,192 tokens / 50,000 characters, so the summary is truncated to 40,000 characters before the call), region from `rebar.toml` `[llm] bedrock_region_name` (currently `us-east-1`, rebar.toml:213), boto3 reaching the venv through the `bedrock` extra's `pydantic-ai-slim[bedrock]`. Cosine similarity by brute force; 630 normalized vectors need no ANN library.\n\nread from commit **f147e08242f** (parent of 2de5f341ec4, which deleted them). The prompt TEXT is `src/rebar/llm/reviewers/ticket_digest.md` at that SHA; the contract is in `src/rebar/llm/contracts.py`. Both are absent from current main, hence the pinned commit.\n\nModel: the **`trivial`** class (`src/rebar/llm/model_classes.py`, default `claude-haiku-4-5`, overridable by `REBAR_LLM_TRIVIAL_MODEL`), resolved id recorded in the fixture header.\n\n`infra/terraform/iam_s7.tf` (sid `ConverseAnthropicClaudeOnly`) scopes `bedrock:InvokeModel` to `anthropic.claude-*` foundation-model and inference-profile ARNs only; no Titan or embedding ARN is granted anywhere in `infra/`. So `amazon.titan-embed-text-v2:0` returns `AccessDeniedException` there — the shape ADR 0059:307 records for an unentitled id. Candidate 2's `claude-haiku-4-5` is entitled; candidate 3 is not.\n\nBuild the fixture at a pinned tickets-branch SHA so the set is reproducible: collect every recorded `duplicates` link (`rebar list --full --exclude-deleted -o json`, reading each ticket's `deps`; relation vocabulary in `docs/ticket-model.md`), close transitively into clusters, enumerate within-cluster pairs, and \n\n **Only the prompt text and the output shape are reused — the deleted `overlap/` orchestration is NOT restored**; the eval calls the model directly through the existing `rebar.llm` runner, and no file under `src/rebar/llm/overlap/` is reinstated.\n\nOne call per ticket, **fed exactly the fixture's `digest_input` field** (the full title + description + every comment the original prompt consumed, per epic 62dc's architecture comment — NOT a truncated description), and the returned `TicketDigest` JSON is **committed to `evals/similar-tickets/digests.json`**, keyed by ticket id plus a SHA-256 of `digest_input` and the prompt text. The runner reuses a cached digest whenever that key matches and only calls the model on a miss, so the recorded recall tables are recomputable from the committed fixture with no model access.","timestamp":1793483188207256001},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"## Auth precondition resolved — Titan embeddings ARE callable from the developer identity\n\nThe plan records candidate 3 as blocked: `infra/terraform/iam_s7.tf` sid `ConverseAnthropicClaudeOnly` scopes `bedrock:InvokeModel` to `anthropic.claude-*` foundation-model and inference-profile ARNs, with no Titan or embedding ARN anywhere in `infra/`. That is accurate, and re-confirmed on `757ca4852d7` — but it describes the **Gerrit instance role**, which is not the identity an offline eval runs under.\n\nTested the actual call rather than inferring from the policy:\n\n| Check | Result |\n|---|---|\n| `sts.get_caller_identity()` | `arn:aws:iam::896586841071:user/joe_frontier` |\n| `bedrock-runtime.invoke_model` on `amazon.titan-embed-text-v2:0`, `us-east-1`, body `{\"inputText\":\"hello\",\"dimensions\":1024,\"normalize\":true}` | **succeeded — 1024-dimension vector returned** |\n\nSo candidate 3 needs no `iam_s7.tf` change and no new entitlement. This is exactly the plan's first resolution path — \"run candidate 3 under a developer AWS identity holding Titan entitlement (a one-off offline eval, not a production path) and record that identity and its entitlement check in the fixture header.\" The identity is `joe_frontier` in account `896586841071`, and the check above is the entitlement evidence to record in the benchmark fixture header.\n\nThe `AccessDeniedException` the plan anticipated is a real risk for anything running **on the Gerrit instance**, so the runner's credentials-absent skip path still earns its place. It just does not block this story.\n\nNothing in `infra/` is edited by this story as a result.\n","timestamp":1793494833881259653},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Bedrock embedding entitlement — measured, and it splits in two.\n\nThe epic's certified round-4 finding recorded that `infra/terraform/iam_s7.tf` scopes `bedrock:InvokeModel` to `anthropic.claude-*` only, with no embedding ARN, and concluded candidate 3 may have to be recorded `unavailable`. Measuring it shows the constraint is real but narrower than that, and candidate 3 IS measurable.\n\nMeasured from the operator identity that runs the eval harness\n(`arn:aws:iam::896586841071:user/joe_frontier`), region `us-west-2`:\n\n- `amazon.titan-embed-text-v2:0` — OK, dim 1024\n- `amazon.titan-embed-text-v1` — OK, dim 1536\n- `cohere.embed-english-v3` — OK, dim 1024\n\nConfirmed the policy text at `infra/terraform/iam_s7.tf:64-66`; its resource list is exactly:\n\n    arn:aws:bedrock:*::foundation-model/anthropic.claude-*\n    arn:aws:bedrock:*:<acct>:inference-profile/*.anthropic.claude-*\n\nSo both statements hold, about different principals:\n\n1. The **eval harness** runs under an operator identity and CAN call Titan. Candidate 3 is measurable, so AC2's \"all three candidates\" is satisfiable without an `unavailable` row.\n2. The **review-bot instance role** (`rebar-gerrit-instance-role`) is scoped to Anthropic Claude and CANNOT call an embedding model. Adopting a vector architecture requires adding an embedding ARN to `iam_s7.tf`.\n\nThat second point is a deployment precondition, and the ADR will record it as one rather than as a measurement gap.\n\nScope note on the evidence: `iam_s7.tf:30-38` explicitly warns that entitlement must be re-verified from the instance and \"never from an operator identity holding bedrock:*\" — which is exactly what the test above used. It is therefore evidence about the eval path only. It does not show the instance role can call Titan, and I am not claiming it does; the instance-role scoping above comes from reading the policy, not from simulation.\n","timestamp":1793501291335574036},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Empty digests driven to **0 of 630**. The rate went 27 → 4 → 0 across two remediation rounds, each one measured rather than assumed.\n\nI had treated ~4% empty as a limitation to report. It was 2 parser bugs and 1 genuine model misfire, and only the last is a real limit.\n\n**Round 1 — YAML replies (23 recovered).** Already fixed earlier: the model answers in YAML for a minority of tickets, and the parser tried only `json.loads`. Re-fetching the 27 with the fallback in place recovered 23, leaving 4.\n\n**Round 2 — I printed the raw replies for the remaining 4 instead of reasoning about them**, which is what exposed 2 unrelated causes:\n\n`4af3-793e-6b34-4290` returned **perfectly valid JSON that the parser could not see**:\n\n    # Ticket Digest\n\n    ```json\n    { \"problem_keywords\": [...], \"component_or_area\": \"rebar reconciler inbound differ\", ... }\n    ```\n\nThe fence strip was `re.sub(r\"^```[a-zA-Z]*\\n|\\n```$\", ...)` — anchored at string start. A `# Ticket Digest` preamble ahead of the fence defeats the anchor, so the whole reply went to `json.loads` as prose and scored as 4 empty fields. The digest was fully present and complete.\n\n`16d4-115f-399e-4fda` is a different animal: the model **ignored the digest task and began doing the ticket's work**, opening with \"I'll analyze the `inbound_differ.py` file to identify a logical concern boundary suitable for splitting, then execute the refactor\" and continuing for 5,036 characters of refactoring plan. There is no digest in that reply to recover. That is a real non-answer.\n\n**Fix.** Replaced the single cleaned-string parse with 2 small helpers: `_digest_reply_candidates` yields every substring that might be the object — the whole reply, each fenced block found **anywhere** via `finditer`, and the first `{`…last `}` span — and `_first_mapping` tries JSON then YAML on each, returning the first that yields a mapping. Both recovery rules now live in one place instead of accreting as branches.\n\nVerified against all 7 shapes, the 2 interesting ones being the real captured replies:\n\n| Reply shape | Fields parsed |\n|---|---|\n| bare JSON | 4/4 |\n| fenced JSON | 4/4 |\n| **preamble + fenced JSON (`4af3` shape)** | **4/4** |\n| fenced YAML under `ticket_digest` wrapper | 4/4 |\n| JSON wrapper key | 4/4 |\n| **prose-only refusal (`16d4` shape)** | **0/4** |\n| junk | 0/4 |\n\nThe last 2 staying empty is the correct result — there is nothing in them to parse, and a parser that produced fields from that text would be inventing them.\n\nDeleting the 4 and re-fetching gave `630 cached, 4 model calls, **0 empty**`. The 2 genuine misfires succeeded on retry, which confirms they were nondeterministic rather than a property of those tickets.\n\n**This is the third silent-parse failure in `_parse_digest_reply`** — first the `ticket_digest` wrapper key, then YAML, now the preamble-before-fence. Every one of them returned 4 empty strings and no error, and every one was invisible except through the `empties` counter. The general lesson is now worth stating plainly: a deliberately lenient parser needs a failure counter, because without one, mass failure is indistinguishable from success. The counter is what made all 3 findable; the corpus would otherwise have been scored with 27 silently blank documents.\n","timestamp":1793502642749471116},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Fourth candidate measured: `vector-raw` — a DIAGNOSTIC, not one of the three the plan requires. It embeds the same raw title+description text that fts5 indexes, with the same Titan model, so the only difference from `vector` is the LLM digest step. That isolates what the per-ticket Haiku call actually buys.\n\nFull results, all four candidates, 630 tickets at tickets SHA cad39ed1289:\n\n| candidate | lexical r@5 | lexical r@10 | semantic r@5 | semantic r@10 |\n|---|---|---|---|---|\n| fts5 (bm25 title 5.0 / desc 1.0) | 0.771 | **0.993** | 0.823 | 0.952 |\n| digest BM25F | 0.703 | 0.918 | 0.796 | 0.925 |\n| vector (embeds digest paragraph) | 0.763 | 0.972 | **0.876** | **0.973** |\n| vector-raw (embeds raw title+desc) | 0.765 | 0.977 | 0.839 | 0.946 |\n\nStrata reported separately throughout; 1,431 lexical vs 93 semantic pairs makes a pooled figure meaningless.\n\nWhat the digest step is worth: +0.037 semantic r@5 (0.876 vs 0.839) and +0.027 semantic r@10. On the lexical stratum it is a slight NET LOSS (0.763 vs 0.765 at r@5; 0.972 vs 0.977 at r@10). So the LLM call buys semantic recall and costs a little lexical recall, at 1 Haiku call (~301 tokens of digest output) plus 1 Titan call per ticket, against vector-raw's 1 Titan call.\n\nThis is decision-relevant for AC3, which requires the ADR to record per-ticket cost and justify ONE architecture: the LLM step is real but small, and it is not free to operate — it carries the three silent parse-failure modes already recorded on this ticket, and two tickets in 630 refused the digest task outright and only succeeded on retry.\n\nIt also sharpens the honest reporting the ADR owes. The plan premised that lexical retrieval fails the semantic stratum. It does not: fts5 reaches 0.823 semantic r@5 and wins lexical r@10 outright at 0.993. The digest BM25F candidate the plan centred on is the WORST of the four on both strata.\n\nCode: `measure.py --candidate vector-raw`, `embed_corpus_raw` + shared `embed_texts`, cache `vectors-raw.json`.\n\nAlso fixed while wiring it: `embed_corpus` lost its `region` parameter in the refactor while its body still referenced `region` — a latent NameError on every vector run. `--candidate --check` never touches that path, so it stayed green; ruff F821 caught it.","timestamp":1793503472065380682},{"author":"Rebar Bot","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Committed `9906f0ec7b3`. All four acceptance criteria verified against the commit, not against notes.\n\n**AC1 — fixture re-derives.** `measure.py --check` → `OK: 1524 pairs ({'lexical': 1431, 'semantic': 93}) over 630 tickets re-derive exactly at cad39ed1289`.\n\n**AC2 — per-stratum recall, no pooled figure.** All four candidates re-run from the committed tree after the fixture refactor below; every number matches the ADR tables exactly:\n\n| candidate | lex@5 | lex@10 | sem@5 | sem@10 |\n|---|---|---|---|---|\n| fts5 | 0.771 | 0.993 | 0.823 | 0.952 |\n| digest | 0.703 | 0.918 | 0.796 | 0.925 |\n| vector | 0.763 | 0.972 | 0.876 | 0.973 |\n| vector-raw | 0.765 | 0.977 | 0.839 | 0.946 |\n\n**AC3 — one architecture, justified from the semantic stratum.** ADR 0122 adopts the digest embedding at k=5. The recall table alone cannot carry that: a `--paired` exact-McNemar mode was added, and at k=5 semantic `vector` beats `fts5` distinguishably (p=0.0213) while `vector` vs `vector-raw` does not (p=0.0654). Both paired tables re-ran post-refactor and reproduce. Index path, freshness key, catch-up rule, embedding model, per-ticket cost and the bulk-duplicate artifact are all recorded.\n\n**AC4 — `gen_adr_index.py --check` rc=0, `check_adr_numbers.py` rc=0.**\n\n**Two defects caught before the commit.**\n\n1. The ADR cited `infra/terraform/iam_s7.tf:64-66` for the Bedrock allowlist and an \"operator-identity warning at :30-38\". The file is 26 lines. The allowlist is `:15-18` (statement `ConverseAnthropicClaudeOnly`, `:10`) and there is no operator-identity warning anywhere in it. Citation corrected, fabricated sentence deleted. The underlying constraint is real and load-bearing for the chosen architecture: both ARNs are `anthropic.claude-*`, so `amazon.titan-embed-text-v2:0` would be denied, and adopting this ADR requires widening that list first.\n2. The draft commit message said the ADR \"selects fts5 at k=10\". It selects `vector` at k=5. Caught by reading the Decision section instead of trusting the draft.\n\n**The pre-commit large-file gate rejected the first commit attempt** — `benchmark.json` 8.0 MB and `digests.json` 884 KB against a 500 KB cap. Resolved without weakening the cap:\n\n- The fixture now carries only what AC1 enumerates (ids, aliases, titles, description heads, stratum). Full descriptions and digest inputs were never fixture data — `--build` rebuilds them from the store in the same pass, and `--check` re-derives from the store rather than trusting any stored copy. They moved to an uncommitted `corpus-text.json`, joining the Titan vector caches. `benchmark.json` is now 396 KB, under the cap with no exclusion.\n- `digests.json` (884 KB) is named in the existing `check-added-large-files` exclusion. That follows the documented precedent exactly — `uv.lock` and `.test_durations` are excluded there as \"committed, machine-generated files (~875 KB) … rather than raise the global cap for human-authored files\", and 884 KB is the same magnitude and the same rationale. It stays committed so the candidates reproduce without paying for 630 Bedrock calls. CI runs this hook with `--all-files`, so the exclusion is load-bearing there, not just locally; verified `pre-commit run check-added-large-files --all-files` rc=0.\n\n`file_impact` updated to the 8 paths actually committed.","timestamp":1793504749560937195}],"created_at":1788804925413523246,"creation_channel":"mcp","deps":[],"description":"## Context / Problem\n\nEpic fattish-plucky-bufflehead (62dc-535b-5d05-421d) needs a retrieval architecture chosen on measurement, not the July N = 8 experiment. The store holds a labeled set — every recorded `duplicates` link, closed transitively into clusters — but it must be re-derived, since eac3's numbers are a July snapshot.\n\nRe-measured on tickets-branch 0b9294311b5 (5,663 live tickets): 482 `duplicates` links close into 148 clusters over 630 tickets, giving **1,524 within-cluster pairs** (eac3: 51). But **1,431 of them (94%) have byte-identical normalized titles** — 84 single-title clusters that are bulk-creation artifacts, not authored duplicates. Pooling them would score ~100% recall for the cheapest lexical candidate and reject vector search on an artifact, inverting the epic's decision.\n\n**The 93 differing-title pairs are the semantic set and the benchmark** — double eac3's 44, same kind, from 64 mixed clusters. The parent epic carries the full rationale.\n\n## Approach\n\nBuild the fixture at a pinned tickets-branch SHA: collect every recorded `duplicates` link (`rebar list --full --exclude-deleted -o json`, reading each ticket's `deps`), close transitively into clusters, enumerate within-cluster pairs, and **stratify each pair `lexical` (normalized titles equal, case/punctuation/whitespace folded) or `semantic` (titles differ)**. Store per ticket, in `evals/similar-tickets/benchmark.json`: pair ids, aliases, stratum, title, and the **`digest_input`** — title, full description, then every comment oldest-first, each separated by a blank line, truncated to 40,000 characters — with the SHA and per-stratum counts in a header object.\n\nReport recall@5 and recall@10 **per stratum, never pooled** — the semantic stratum is the decision criterion, the lexical stratum a control every candidate should near-saturate. Query text is title plus the first 200 characters of description (the compose-time shape). Candidates:\n\n1. Lexical baseline: SQLite FTS5 with `bm25()` over title (weight 5.0) and description (weight 1.0) in a temporary index built from the fixture.\n2. Digest lexical: BM25F over LLM digests produced with the retired `ticket_digest` prompt and its `TicketDigest` contract, read from commit **f147e08242f**, the parent of 2de5f341ec4 (\"Remove the overlap/enrichment implementation\"): prompt text `src/rebar/llm/reviewers/ticket_digest.md`, contract `src/rebar/llm/contracts.py`. **Only the prompt text and output shape are reused — the deleted `overlap/` orchestration is NOT restored**; the eval calls the model directly through the `rebar.llm` runner. Model: the **`trivial`** class (`src/rebar/llm/model_classes.py`, default `claude-haiku-4-5`, override `REBAR_LLM_TRIVIAL_MODEL`), resolved id in the fixture header. One call per ticket, **fed exactly the fixture's `digest_input`** — the title + description + every comment the original prompt consumed (epic 62dc's architecture comment), NOT a truncated description. The returned `TicketDigest` JSON is **committed to `evals/similar-tickets/digests.json`**, keyed by ticket id plus a SHA-256 of `digest_input` and the prompt text; the runner reuses a cached digest on a key match and calls the model only on a miss, so the recall tables are recomputable from the committed fixture with no model access.\n3. Vector: embeddings of an LLM summary (the same digest text joined as one paragraph) from Amazon Titan Text Embeddings V2, model id `amazon.titan-embed-text-v2:0`, via boto3 `bedrock-runtime` `invoke_model` with body `{\"inputText\": ..., \"dimensions\": 1024, \"normalize\": true}`, region from `rebar.toml` `[llm] bedrock_region_name` (`us-east-1`, rebar.toml:213). Cosine similarity by brute force; 630 normalized vectors need no ANN library. Call mechanics and limits: see comment.\n\n**Auth precondition — the Titan call is NOT entitled today.** `infra/terraform/iam_s7.tf` (sid `ConverseAnthropicClaudeOnly`) scopes `bedrock:InvokeModel` to `anthropic.claude-*` ARNs only; no Titan or embedding ARN exists in `infra/`, so `amazon.titan-embed-text-v2:0` returns `AccessDeniedException` there (the shape ADR 0059:307 records). Candidate 2's `claude-haiku-4-5` is entitled; candidate 3 is not. Resolution: run candidate 3 under a developer AWS identity holding Titan entitlement (a one-off offline eval, not a production path) and record that identity and its entitlement check in the fixture header; failing that, add the Titan ARN to `iam_s7.tf` first. The credentials-absent skip is **widened to catch `AccessDeniedException`**, recording candidate 3 `unavailable` with the error instead of aborting — and an `unavailable` candidate may not be selected by the ADR.\n\n**Digest serialization (candidates 2 and 3).** `TicketDigest` is a 4-field structured contract — `problem_keywords`, `component_or_area`, `key_entities`, `propositions` (all `list[str]` but `component_or_area: str`) — not free text, so its mapping to a retrievable document is fixed here rather than left to the executor. Candidate 2 indexes the **four as BM25F fields**, weights `propositions 3.0`, `problem_keywords 2.0`, `key_entities 2.0`, `component_or_area 1.0`; lists joined with `\" \"`. Candidate 3 embeds the **same four in the same order** as one paragraph, each on one line prefixed by its field name, truncated to 40,000 characters. The weights are the one free parameter, recorded in the ADR and not tuned per candidate.\n\nWrite the ADR (number = one above the highest `docs/adr/.numbers/` marker, written by `gen_adr_index.py`; no script computes a next free number) recording the per-stratum recall tables, the chosen architecture, the bulk-duplicate artifact and why the strata are reported separately, the index location (`<repo>/.git/rebar/similar.sqlite`, keyed by tickets-branch HEAD SHA plus a format version, rebuilt on mismatch), the catch-up rule (reader-process incremental update from `git diff --name-only <indexed_sha> <head>`), and the cost model (summarization and embedding calls per changed ticket).\n\n## Scope\n\n- `evals/similar-tickets/{benchmark.json,digests.json,measure.py,README.md}` — all new; `measure.py` runs the three candidates. The top-level `evals/` tree already exists (commit 91d39fd6061), so the eval-harness dependency this story once waited on has landed.\n- `docs/adr/0NNN-similar-ticket-retrieval.md` (new).\n- `docs/adr/README.md` (regenerated by `scripts/gen_adr_index.py`).\n\n## Testing\n\n- Happy path: `python evals/similar-tickets/measure.py --candidate fts5` prints a per-stratum recall table; the fixture loads and every pair resolves to two existing ticket ids.\n- Edge: a pair whose ticket has an empty description still yields a query from the title alone; the runner skips a candidate cleanly when Bedrock credentials are absent and says so.\n- Edge: `--check` fails loudly if the fixture's recorded tickets-branch SHA is not an ancestor of the current tickets HEAD, so a stale fixture cannot be silently measured.\n\n## Acceptance Criteria\n\n- [ ] `evals/similar-tickets/benchmark.json` records the tickets-branch SHA it was derived at, and every pair carries ids, aliases, titles, description heads and a `lexical`/`semantic` stratum. `measure.py --check` resolves every id in the store and re-derives the pair set at that SHA, matching the fixture exactly. Checked by running the command.\n- [ ] Recall@5 and recall@10 are recorded **per stratum** for all three candidates in the ADR, produced by `measure.py` with the exact command lines quoted. No pooled figure is reported. Checked by re-running each command and matching the ADR tables.\n- [ ] The ADR names one architecture and justifies it from the **semantic** stratum, and records the index path, freshness key, catch-up rule, embedding model, per-ticket cost, and the bulk-duplicate artifact that makes stratification necessary. Checked by reading the ADR against `measure.py` output.\n- [ ] `scripts/gen_adr_index.py --check` and `scripts/check_adr_numbers.py` both exit 0.","env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","file_impact":[{"path":"evals/similar-tickets/benchmark.json","reason":"new: the duplicate-pair benchmark fixture, pinned to a tickets SHA"},{"path":"evals/similar-tickets/measure.py","reason":"new: runner for the four retrieval candidates plus paired significance tests"},{"path":"evals/similar-tickets/README.md","reason":"new: how to rebuild and run the benchmark"},{"path":"evals/similar-tickets/digests.json","reason":"new: cached LLM digests so candidates 2-4 reproduce without model access"},{"path":"evals/similar-tickets/.gitignore","reason":"new: holds the regenerable corpus-text and Titan vector caches out of git"},{"path":"docs/adr/","reason":"new ADR 0122 recording the chosen retrieval architecture with measured recall"},{"path":"docs/adr/README.md","reason":"regenerated index"},{"path":".pre-commit-config.yaml","reason":"name digests.json in the existing check-added-large-files exclusion, matching the uv.lock/.test_durations precedent"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"eea68b7f-6697-488b-ac52-744e2ed8e96f","managed_refs":[["parent","62dc-535b-5d05-421d"]],"no_file_impact_reason":"","parent_id":"62dc-535b-5d05-421d","parent_status_uuid":"c3c68aef-9342-4ba3-866a-25036f84de62","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["complexity-reduction","design-record"],"ticket_id":"c670-c285-a0f9-4b40","ticket_type":"story","title":"Build the duplicate-retrieval benchmark from recorded duplicate links, measure lexical, digest, and vector retrieval, and record the architecture in an ADR","verify_commands":[]},"source_event_uuids":["d31f99c9-4e8d-4061-aa48-57fbbdc80855","f16f273e-8165-4ffa-a6a0-395c844922b4","122664e4-90ef-411f-9911-f4c9f52e2b5d","ef70e928-5f8b-4d74-a0a7-a3f5338d8d02","b33f3a3f-d7b5-4627-b662-95c07302394f","b330ed7e-9d18-4740-bb57-0ae3deb9028b","df9aafa6-4c2f-438e-b52f-07c8e6508fab","e4abc86d-0d2e-498f-98da-a9899db5d603","2a9f7cb5-284b-4a23-95d4-9c40c177dedd","b837ca06-a79b-4ef6-a1c9-8449c6b942ee","c3c68aef-9342-4ba3-866a-25036f84de62","1726bb32-a1c6-4f8e-a03b-c41b57560c1b","5c5ee102-4a0e-49fe-bb29-942ddc0bbdca","96d88d9f-e077-4880-998d-a83e87b27d0d","a1659c48-7ce1-49e2-851c-983859072c03","82e376af-928e-4720-b4c9-31c95ec33fc8","b8642ca6-8d38-417c-8551-c677788b88ad"]},"env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","event_type":"SNAPSHOT","timestamp":1793509683174319001,"uuid":"1245f2ff-eb2f-4a07-ae49-775b39d07bc3"}