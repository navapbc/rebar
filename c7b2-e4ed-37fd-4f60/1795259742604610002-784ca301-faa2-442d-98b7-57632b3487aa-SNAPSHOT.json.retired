{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1795259742604610002,"compiled_state":{"alias":"smoking-bereft-boar","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"492a5c71-6cda-48a6-8134-02ff6a672739\", \"sig\": \"\"}]}","head_sha":"863abe7cd19a4a386a01fb3a9c484358ebdc7596","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: c7b2-e4ed-37fd-4f60","material: 8b2a2970f1886aec","material-part: children 647ea2107ca5072f 0","material-part: description 80a5138f9e71cf96 7732","material-part: description_boxes 6c179f21e6f62b62 0","material-part: file_impact 3c2095e3d84a85d6 14","material-part: ticket_id 24533c09f238a6bf 19","model: anthropic:claude-sonnet-5-5","runner: pydantic_ai","blocking: 0","advisory: 10","review-phase: planning","rebar-version: 0.16.0 (863abe7cd19)","regver: aa61189569d34126","verified-at-sha:863abe7cd19a4a386a01fb3a9c484358ebdc7596","dep 315e98c78dc81b20fb039a8242c82a64367483bcbe4ac2b05051d49d8988327b .github/windows-sweep-deselect/pid-liveness.args","dep c4cf898642b6a22c93c433711e2b87b426ace4a81233472b7a7b8e300aef5df9 .github/workflows/test.yml","dep 53f8df2d1146bd408e4b44a92eeac1ba5a6b84efde78f7e6ddfc756706a9064b src/rebar/_commands/compact_trigger.py","dep 7b5f19de92589046853e1e94ab092b6edb863ef2a96334c86bd9b7b6e42bbafd src/rebar/_store/lock_owner.py","dep absent tests/_python_child.py","dep e940f166ab96f1570f18c51fb3e382ecdbf6bc77b10176f8477c278e92dc2697 tests/interfaces/store/test_stale_lock_reclaim_write.py","dep c3c2dda4d03b1d22753ed69afcd2078d5125049bca55ff82fa1396a1e0f2550b tests/unit/store/test_windows_exclusive_leg.py","dep absent tests/unit/store/test_windows_pid_probe.py","dep 07ed6113ebf43aabd8a92362411e4fdcabcdcea4e3b2eb111ff41e3631227f69 tests/unit/test_lock_age_ceiling.py","dep 108982fdceea3cb91afe6f4eea666087c07ffea0aab3da25d7f1419799901457 tests/unit/test_lock_container_recreate.py","dep 317a8d626e7333d951187902c25031aa881f4de6b4bd9f9cb00059cb1fd2a58e tests/unit/test_lock_stale_reclaim.py","dep 1538547ab643c4e4d0eb43fa79fdd9c83f5f7e47ffd06c4f5fb0e5ef23c7cfec tests/unit/test_lock_timeout_names_holder_7084.py","dep f894d81f436585c40deb5220380b4078ab6057ebd9450f74d242525a7152c21a tests/unit/test_mcp_idle_sync.py","dep e6d414733375b8456a4ca5078a77494cc711ba4e641210feb5e1da1908786967 tests/unit/test_write_lock_busy_probe_7084.py","read-set: 19","read-path: .github/windows-sweep-deselect/pid-liveness.args","read-path: .github/workflows/test.yml","read-path: src/rebar/_commands/compact_trigger.py","read-path: src/rebar/_commands/doctor_locks.py","read-path: src/rebar/_store/lock.py","read-path: src/rebar/_store/lock_owner.py","read-path: src/rebar/_store/staging.py","read-path: tests/interfaces/store/test_atomic_ticket_dir_create_021d.py","read-path: tests/interfaces/store/test_stale_lock_reclaim_write.py","read-path: tests/scripts/graph/test_doctor_locks.py","read-path: tests/unit/store/test_stamped_lock.py","read-path: tests/unit/store/test_windows_exclusive_leg.py","read-path: tests/unit/test_lock_age_ceiling.py","read-path: tests/unit/test_lock_container_recreate.py","read-path: tests/unit/test_lock_stale_reclaim.py","read-path: tests/unit/test_lock_timeout_names_holder_7084.py","read-path: tests/unit/test_mcp_idle_sync.py","read-path: tests/unit/test_windows_sweep_deselect.py","read-path: tests/unit/test_write_lock_busy_probe_7084.py","currency-basis: file_impact"],"material_fingerprint":"8b2a2970f1886aec","merged_log_commit":"863abe7cd19a4a386a01fb3a9c484358ebdc7596","principal":"492a5c71-6cda-48a6-8134-02ff6a672739","signature":null,"signed_at":1795259636792609000}},"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":15,"unsigned":0},"authorship_ledger":[{"content_hash":"ac624010f0e557293595c4a48b4a693409a95a1cdc2cc4693255ed5f1a9d0a01","event_uuid":"9ce629b5-1598-4599-a542-8c5dc4348f24","position":{"commit_sha":"bba93b18d18bde9225678a2d1c057340726371fe","position":"1795256364826774001-9ce629b5-1598-4599-a542-8c5dc4348f24"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"3c6efdcdf4663bd0ef2d9255a9b301899d7d78e779d220639c6b5cc84fc4f5c2","event_uuid":"2bf20853-f891-4c6b-b4d3-66f0440100d5","position":{"commit_sha":"d49e960529e4571aaed48858d3495d366b2430ff","position":"1795256392060176001-2bf20853-f891-4c6b-b4d3-66f0440100d5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"3cc18d1198d3260f70d01ca01d8f46140a3fa5c13a4efc20c591964eae2773c3","event_uuid":"8e6d8e01-074f-49d5-9274-8ee540191625","position":{"commit_sha":"503b00bce1a6b8b1d8370b59273f97251f0178c2","position":"1795257195519166001-8e6d8e01-074f-49d5-9274-8ee540191625"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"6bbfc104702be9840d8b7709c74d653eb1dd52eccb1fe6abb86251492d6f51c0","event_uuid":"cb5935bd