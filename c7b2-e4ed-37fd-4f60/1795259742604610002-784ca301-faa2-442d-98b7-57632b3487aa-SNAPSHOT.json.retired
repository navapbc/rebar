adType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"57abe4a841ed32dfd52bef8579c13803377bb4c5c9e36a64f4e8cf15bd6214dc","event_uuid":"432da89d-d02b-4e5e-b691-f11f90ca0257","position":{"commit_sha":"87e7b8d8043f876f574c2329a49931012b5a895c","position":"1795258579238781001-432da89d-d02b-4e5e-b691-f11f90ca0257"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"ee60a445637d4ca32b616a022b1b24e9355502469a1d553aa914dfc20ad18f96","event_uuid":"b9797a87-123e-4e91-9449-4f1e947e0cce","position":{"commit_sha":"ba0ba555464b3fcf424b7a4c5439d15ecf1680da","position":"1795258599405593001-b9797a87-123e-4e91-9449-4f1e947e0cce"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"574c161e9b03c6f04d4be2800fd6ee9569f79eb90308ba9eb7d298185b77fb7d","event_uuid":"8cc1eae3-8194-4481-aeb2-393a3bc9e824","position":{"commit_sha":"dd0f7de0eaccba55c72e5c97979a79c35dbb5ef4","position":"1795259636796036001-8cc1eae3-8194-4481-aeb2-393a3bc9e824"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"e6d4a4081fd55b0ba912adc20fb83529f03568e7a2600284123d98baf7f3107e","event_uuid":"6502c3ae-7402-4dda-ba87-ca3137645754","position":{"commit_sha":"ce74c1ae623fc854f4ec75d55635b42ea9f9f513","position":"1795259732098718001-6502c3ae-7402-4dda-ba87-ca3137645754"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"},{"content_hash":"dc7215d92c9340fd074b15e8c5ed13c723785a1cc36982040b1f9ae20fed2d6f","event_uuid":"066289d9-a0bb-42c7-a09e-ad34626a23ce","position":{"commit_sha":"ce74c1ae623fc854f4ec75d55635b42ea9f9f513","position":"1795259742604610001-066289d9-a0bb-42c7-a09e-ad34626a23ce"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMQNvvCya66a6YyDlxwkxjjJPN3uaFI+QD3OjyC8e1UF rebar-mac-492a5c71 joeoakhart+bot@navapbc.com 20261119"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":"claude-code_2-1-311_agent","claim_remote_session":null,"claimed_session":"05f74084-8156-4489-b43f-fbb9222cdc20","comments":[{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan revised after review run 1 (PASS with advisories). Folded in: (1) the pid <= 0 guard, since OpenProcess returns 87 for pid 0; (2) explicit ctypes argtypes/restype, with the last error read through use_last_error plus get_last_error, both injectable; (3) a stop() helper that waits for the real interpreter pid to read dead before any not-running assertion; (4) all 4 Popen(['true']) dead-pid copies, including test_lock_age_ceiling and test_lock_container_recreate, routed through a shared dead_pid(); (5) the product consumers in compact_trigger named; (6) AC1 evidence taken from the first scheduled main run after merge, with the tmp-branch dispatch kept as pre-merge validation. AC block unchanged.","timestamp":1795257360050282001},{"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Verbatim Windows failures (run 44681457334, JUnit; moved out of the plan to keep it under the review size limit):\n- test_write_lock_busy_probe_7084::test_probe_answers_a_lock_held_by_another_process: `assert 'pid_state=not-running' in 'host=name-runnervmm7ud1 pid=7812 held=0s pid_state=unverified-live (start unknown)'`\n- test_lock_timeout_names_holder_7084::test_contended_timeout_names_the_holder: `assert 'pid=7556' in 'flock: could not acquire lock after 1s (holder: host=name-runnervmm7ud1 pid=7536 held=1s pid_state=unverified-live (start unknown))'`\n- test_mcp_idle_sync::test_a_busy_write_lock_is_logged_with_its_holder: `assert 'pid=9012' in '... (holder: host=name-runnervmm7ud1 pid=8428 held=1s pid_state=unverified-live (start unknown)) ...'`\n- test_lock_stale_reclaim::test_acquire_reclaims_dead_owner_mkdir_lock: `LockTimeout: flock: could not acquire lock after 2s (holder: unknown (unrecognised ownership stamp))` (the `[\"true\"]` dead-pid helper)\n- test_stamped_lock (2): `a provably-orphaned lock must be reclaimed, not respected / assert None is not None` and `assert False` on the reclaim warning\n- test_doctor_locks (6), test_atomic_ticket_dir_create_021d (1), test_stale_lock_reclaim_write (1): `worker 'gwN' crashed while running ...` (the `while _pid_alive(pid)` dead-pid search never ends)\nReview run 2 (BLOCK): `_sweep_exited` raises AttributeError on Windows (os.WNOHANG is Unix-only), so the plan now adds the reap guard in compact_trigger.py plus tests; staging._is_abandoned is named as a consumer.","timestamp":1795258556804082001}],"created_at":1795153682479061001,"creation_channel":"cli","deps":[{"link_uuid":"5a81b11f-702e-42be-9f4c-3083fb896cf7","relation":"discovered_from","target_id":"8aa0-2120-5ef3-4750"}],"description":"## Context / Problem\nDiscovered while triaging breezy-hogged-mastiff. The 14 entries of `.github/windows-sweep-deselect/pid-liveness.args` belong to this bug. The evidence is the Windows JUnit of run 44681457334 (2026-11-19). The verbatim failures are in this ticket's comments.\n\n## Root cause (verified at origin/main 863abe7cd19)\n\n1. **Product: Windows has no pid liveness probe.** On Windows, `lock_owner._pid_alive` returns True for every pid, because `os.kill(pid, 0)` there is TerminateProcess. So a dead holder is never proven dead:\n   - `_describe_stamped_pid` reports `unverified-live` instead of `not-running` (`test_write_lock_busy_probe_7084`).\n   - Stamped and mkdir locks of dead owners are never reclaimed on that proof (`test_stamped_lock` x2, `test_lock_stale_reclaim`, `test_stale_lock_reclaim_write`).\n   - The test helpers that search downward for a non-running pid with `while _pid_alive(pid)` never terminate, so the xdist worker dies (`test_doctor_locks` x6, `test_atomic_ticket_dir_create_021d`: \"worker crashed\").\n   Windows can probe without signalling: `OpenProcess` fails with 87 for an unknown pid, and `WaitForSingleObject(h, 0)` returns WAIT_OBJECT_0 once the process has exited.\n2. **Tests: `Popen([sys.executable, ...]).pid` is not the interpreter's pid on the sweep.** The `uv venv` `python.exe` is a launcher with the interpreter as its child, so the stamp's `os.getpid()` differs from `proc.pid`:\n   - `test_lock_timeout_names_holder_7084`: expected `pid=7556`, stamp `pid=7536`.\n   - `test_mcp_idle_sync`: expected 9012, stamp 8428.\n   - `proc.kill()` kills only the launcher, so the lock-holding interpreter keeps running (`test_write_lock_busy_probe_7084`).\n   - Separately, 2 dead-pid helpers spawn `[\"true\"]`, which does not exist on Windows (`test_lock_stale_reclaim`, `test_stale_lock_reclaim_write`).\n\n## Approach\n- `src/rebar/_store/lock_owner.py`:\n  - Add `_windows_pid_alive(pid, kernel32=None, get_last_error=None)`. It never signals.\n    - The real path uses `ctypes.WinDLL(\"kernel32\", use_last_error=True)` with explicit argtypes/restype, and reads the error with `ctypes.get_last_error()`. Tests inject both seams.\n  - The decision table:\n    - pid <= 0: alive (True), without a call. OpenProcess returns 87 for pid 0 too, which would misread a corrupt `pid=0` stamp as dead. A corrupt stamp is reclaimed only by the age ceiling. (POSIX may read a negative pid dead; that difference is accepted.)\n    - OpenProcess fails with 87: no such process (False).\n    - OpenProcess fails with any other error: alive (True).\n    - `WaitForSingleObject(h, 0) == WAIT_OBJECT_0`: exited (False).\n    - Any other wait result: alive (True).\n    - The handle is always closed with CloseHandle.\n    - Any exception (no ctypes, missing symbol): alive (True).\n  - `_pid_alive` keeps the POSIX signal-0 path. Where signal 0 is not a probe it calls `_windows_pid_alive` when `os.name == \"nt\"`, and otherwise returns True as today. Docstrings updated. No config key, env var or flag.\n- **Product consumers whose Windows behaviour changes:**\n  - `_describe_stamped_pid`: a dead same-host holder now reads `not-running`.\n  - `_stamp_is_stale` / `_legacy_stamp_is_stale` / `_mkdir_lock_is_stale` / `stamped_file_is_stale`: a dead same-host owner is now provably stale and is reclaimed, as on POSIX.\n  - `staging._is_abandoned` / `sweep_stale_staging`: hidden staging of a dead same-host owner is now removed at once instead of after the age ceiling, as on POSIX. Tested by `test_atomic_ticket_dir_create_021d::test_sweep_removes_dead_owner_staging_but_spares_a_live_one`, one of this class's lines.\n  - `compact_trigger.stop_local_sweep`: a dead holder reads `not-running` and is left alone instead of being sent `os.kill(SIGTERM)`, which is TerminateProcess on Windows.\n  - `compact_trigger._sweep_exited`: today it raises AttributeError on Windows, because `os.WNOHANG` is Unix-only. The change skips the reap when `getattr(os, \"WNOHANG\", None)` is None and falls through to `_pid_alive`. POSIX is unchanged.\n- **Tests:**\n  - A shared helper, `tests/_python_child.py`:\n    - `dead_pid()` replaces the 4 `Popen([\"true\"])` copies in `test_lock_stale_reclaim`, `test_stale_lock_reclaim_write`, `test_lock_age_ceiling` and `test_lock_container_recreate`. It is the same form `test_stamped_lock` already uses: spawn `[sys.executable, \"-c\", \"\"]` and reap it.\n    - `spawn_python(code, *args) -> (proc, pid)` starts a child whose first stdout line is `os.getpid()`, so callers get the real interpreter pid even behind a venv launcher.\n    - `stop(proc, pid)` sends SIGTERM to the real pid, kills and waits the launcher, then polls `lock_owner._pid_alive(pid)` until False, bounded at 30 s with a failure if it is still alive.\n  - `test_lock_timeout_names_holder_7084`, `test_mcp_idle_sync` and `test_write_lock_busy_probe_7084` use `spawn_python` / `stop` and assert the real pid.\n  - `tests/unit/store/test_windows_exclusive_leg.py`: the seam test keeps asserting that no `os.kill` is sent. On a non-nt host the answer stays True.\n  - New `tests/unit/store/test_windows_pid_probe.py`:\n    - The fake-kernel32 decision table covers pid <= 0, 87, 5, WAIT_OBJECT_0, WAIT_TIMEOUT and WAIT_FAILED, plus CloseHandle and exception paths.\n    - On Windows only, a real spawned-and-reaped child reads dead, and our own pid reads alive.\n    - On every host, `_sweep_exited` with `os.WNOHANG` removed (monkeypatch `delattr`) and `_pid_alive` returning False returns True without raising.\n    - On every host, `stop_local_sweep` with a stamp whose verdict is `not-running` returns None and calls no `os.kill`.\n- `.github/windows-sweep-deselect/pid-liveness.args`: remove each line whose test passes in the Windows validation run. If the file ends up empty, delete it and its `@` line in `.github/workflows/test.yml`; `tests/unit/test_windows_sweep_deselect.py` keeps the 2 in step.\n\n## Scope\n- src/rebar/_store/lock_owner.py\n- src/rebar/_commands/compact_trigger.py (`_sweep_exited` reap guard only)\n- tests/_python_child.py\n- tests/unit/test_lock_timeout_names_holder_7084.py\n- tests/unit/test_mcp_idle_sync.py\n- tests/unit/test_write_lock_busy_probe_7084.py\n- tests/unit/test_lock_stale_reclaim.py\n- tests/interfaces/store/test_stale_lock_reclaim_write.py\n- tests/unit/test_lock_age_ceiling.py\n- tests/unit/test_lock_container_recreate.py\n- tests/unit/store/test_windows_exclusive_leg.py\n- tests/unit/store/test_windows_pid_probe.py\n- .github/windows-sweep-deselect/pid-liveness.args\n- .github/workflows/test.yml (only if the args file is deleted)\n\n## Testing\n- The fake-kernel32 decision table runs on every host.\n- Pre-merge Windows validation: push the exact tree to `tmp/b4-smoking-bereft-boar`, dispatch `gh workflow run 294845723 --ref tmp/b4-smoking-bereft-boar`, record the run id and per-test outcomes in a comment on this ticket, then delete the tmp branch. A line leaves the args file only if its test passed there.\n- AC1 evidence (\"a `sweep (windows)` run on main after the fix\"): after the change merges, the first scheduled `test.yml` run on main (event `schedule`; main is never dispatched by hand) whose head contains the merge commit. Its `sweep (windows)` job must pass with the lines removed. Its run id and head SHA go in a comment on this ticket before the close.\n- `make verify` through verify-slot.sh.\n\n## Acceptance Criteria\n- [ ] Every line removed from `pid-liveness.args` names a test that passed in a `sweep (windows)` run on main after the fix (run id recorded in a comment).\n- [ ] `pid-liveness.args` is empty and deleted with its reference in `.github/workflows/test.yml`, or each remaining line names a test recorded on this ticket as intentionally unsupported on Windows with the reason.","env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","file_impact":[{"path":"src/rebar/_store/lock_owner.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"src/rebar/_commands/compact_trigger.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/_python_child.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_lock_timeout_names_holder_7084.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_mcp_idle_sync.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_write_lock_busy_probe_7084.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_lock_stale_reclaim.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/interfaces/store/test_stale_lock_reclaim_write.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_lock_age_ceiling.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/test_lock_container_recreate.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/store/test_windows_exclusive_leg.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":"tests/unit/store/test_windows_pid_probe.py","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":".github/windows-sweep-deselect/pid-liveness.args","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"},{"path":".github/workflows/test.yml","reason":"smoking-bereft-boar: Windows pid liveness probe and launcher-safe test pids"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"492a5c71-6cda-48a6-8134-02ff6a672739","managed_refs":[],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"6502c3ae-7402-4dda-ba87-ca3137645754","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":3,"releases":[],"repos":[],"reverts":[],"status":"in_progress","tags":["windows","portability"],"ticket_id":"c7b2-e4ed-37fd-4f60","ticket_type":"bug","title":"Windows sweep: tests that need a provably dead pid cannot pass, because _pid_alive answers alive on Windows","verify_commands":[]},"source_event_uuids":["9ce629b5-1598-4599-a542-8c5dc4348f24","2bf20853-f891-4c6b-b4d3-66f0440100d5","8e6d8e01-074f-49d5-9274-8ee540191625","cb5935bd-9427-499d-89b2-af8795d05b00","4563c2f5-0127-4fde-9473-dd938da931ef","31a5a463-4b7a-4f45-b5e0-6cd77d6b88a8","8208775a-cc5e-4c75-a92f-1c5491791aad","432da89d-d02b-4e5e-b691-f11f90ca0257","b9797a87-123e-4e91-9449-4f1e947e0cce","8cc1eae3-8194-4481-aeb2-393a3bc9e824","6502c3ae-7402-4dda-ba87-ca3137645754","066289d9-a0bb-42c7-a09e-ad34626a23ce"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1795259742604610002,"uuid":"784ca301-faa2-442d-98b7-57632b3487aa"}