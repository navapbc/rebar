4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"777efaacbbdb46aa86ed959dd9bbdbc31b334db63d0308ff37deee59eef78064","event_uuid":"5705552c-2788-41ab-af3d-e4819eed09f0","position":{"commit_sha":"b211686704d890d5af6aea19dc87f2682d996511","position":"1785956726562337001-5705552c-2788-41ab-af3d-e4819eed09f0"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ca45f97aa3e52f20c3fb72fb3a515ec4a889d8c340ef108b95592d06ee01b5a5","event_uuid":"ca0a17cc-546a-4e49-ada3-69165c8a1105","position":{"commit_sha":"544ad1874117e91bc708b9321499441d7c77ee1c","position":"1785957889332038001-ca0a17cc-546a-4e49-ada3-69165c8a1105"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"a5badc79b959b9b7f19fe238d8b86627c710ce0adf590f45df3236e033586fed","event_uuid":"52e6d9b4-4059-45a7-8eae-4b41aae789a5","position":{"commit_sha":"c3d104e6605adb183e0fe6b88c22af66f7845c58","position":"1785962314273329001-52e6d9b4-4059-45a7-8eae-4b41aae789a5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"d4bd3e160b9b2da7f7b1dcf76e8dd1d5649cdbe6682535030790173337add4b2","event_uuid":"02aabdad-e6cd-4386-9e07-c78f40cd6ae5","position":{"commit_sha":"c3d104e6605adb183e0fe6b88c22af66f7845c58","position":"1785962314841733001-02aabdad-e6cd-4386-9e07-c78f40cd6ae5"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Confirmed by direct experiment against real rebar code (exp_c): UsageLimitExceeded -> LLMRunnerError, and CompletionAgentStep.run catches only UnretryableOutputError (+ a textual token-exhaustion check), so bounded recovery is unreachable on budget exhaustion — the run dies at raise_completion_workflow_failure with no verdict. Additionally: even when recovery IS reached, its evidence runs pass tool_step_limit=16 (completion_recovery.py:471), and that cutoff is 400-broken on Bedrock/Anthropic (see c827 comments) — recovery must both become reachable AND lose the empty-filter cutoff. Fix folded into c827's proposal change 4.","timestamp":1785953380204045001}],"created_at":1785932595294557001,"creation_channel":"cli","deps":[{"link_uuid":"4a7f8ade-3264-49c7-9a91-281c8b97ecb5","relation":"discovered_from","target_id":"bf31-fd55-d28d-4b7a"},{"link_uuid":"80d97bb0-4ac6-4ecb-9339-b78c0ec7bf1f","relation":"relates_to","target_id":"4426-330b-9c17-4ad6"}],"description":"# Bounded completion recovery is unreachable for a step-budget exhaustion\n\n## Context / Problem\n\nDiscovered while root-causing [rebar:bf31-fd55-d28d-4b7a].\n\n`CompletionAgentStep.run` (`src/rebar/llm/workflow/completion_recovery.py:426`) catches ONLY\n`UnretryableOutputError`, and only when `_is_token_exhaustion(exc)` holds. A step-budget exhaustion\nraises `LLMRunnerError` (`src/rebar/llm/structured_run.py:95` builds it as `budget_err` with a\n`.diagnostic` attached), and per `src/rebar/llm/errors.py` `LLMRunnerError` is a strict ANCESTOR of\n`UnretryableOutputError` — so it never matches and the recovery never engages.\n\nConfirmed by experiment, with a control: a synthetic budget `LLMRunnerError` fed to\n`CompletionAgentStep.run` PROPAGATED and left `failure_diagnostic is None`; the control, an\n`UnretryableOutputError` truncation, ENTERED recovery.\n\nThis matters because bounded recovery is exactly the mechanism the failure needs. It isolates each\nexplicit criterion in a FRESH agentic history (so a loop cannot persist across criteria), converges\nthe evidence run at 16 run steps, and finishes with a tool-free structured finalizer — see\n`docs/llm-framework.md`. The error message printed to the operator says \"narrow the task\", and\nthis is the machinery that does exactly that, sitting unreachable one `except` clause away.\n\n## Approach\n\nTwo small pieces, per the design review on this ticket's plan:\n\n1. **A dedicated typed exception.** `interpret_failure`'s budget branch (`structured_run.py:95`)\n   currently raises a bare `LLMRunnerError`. Diagnostic-shape sniffing CANNOT identify that branch:\n   `interpret_failure` attaches the SAME `usage_log.failure_usage(...)` dict (same key set) to\n   EVERY exception it raises — typed `LLMError`s, sampling rejections, and `LLMUnavailableError`\n   alike — so \"carries requests/tool_calls/request_limit keys\" is true of all of them. Add\n   `LLMBudgetExhaustedError(LLMRunnerError)` to `src/rebar/llm/errors.py` and raise it from the\n   budget branch. Every existing `except LLMRunnerError` / `except LLMError` site keeps catching\n   (strict subclass = backward compatible), and the budget stop becomes identifiable **purely by\n   type** — no message sniffing, no shape sniffing.\n2. **The missing entry edge.** Extend the `except` clause in `CompletionAgentStep.run` to catch\n   `LLMBudgetExhaustedError` and route it to the existing `_recover(...)`. The truncation path\n   keeps its exact current behaviour: `UnretryableOutputError` + `_is_token_exhaustion` still\n   routes to the same `_recover`. `_recover`'s own fail-closed guarantees are untouched — this\n   ticket only adds the missing entry edge. The budget diagnostic is preserved onto\n   `self.failure_diagnostic` before recovery so that if recovery ALSO fails,\n   `raise_completion_workflow_failure` has the loop-vs-breadth counters (the surfacing of those\n   counters is [rebar:8b97-a0ca-82a4-4d4e]'s subject).\n\n## Scope\n\n- `src/rebar/llm/errors.py` — new `LLMBudgetExhaustedError(LLMRunnerError)`.\n- `src/rebar/llm/structured_run.py` — the budget branch of `interpret_failure` raises the subclass\n  (message and `.diagnostic` unchanged).\n- `src/rebar/llm/workflow/completion_recovery.py` — the `except` spine of\n  `CompletionAgentStep.run` catches the subclass and routes to `_recover`.\n- `tests/unit/workflow/test_completion_token_recovery.py` — the tests below (extends the existing\n  suite for this class).\n\nOut of scope: what `tool_step_limit` does inside the evidence runs ([rebar:e1b1-859e-a7b4-48f2]);\nthe runaway detector/actuator ([rebar:c827-2a23-cd00-473e]); sidecar emission\n([rebar:8b97-a0ca-82a4-4d4e]).\n\n## Testing\n\n    pytest tests/unit/workflow/test_completion_token_recovery.py -q\n\nHappy path: an `LLMBudgetExhaustedError` from the primary step enters recovery and produces a\nverdict. Edge: a plain `LLMRunnerError` (not the subclass) still propagates (negative control); the\ntruncation path is regression-pinned. Failure path: recovery that cannot produce full criterion\ncoverage still fails closed.\n\n## Acceptance Criteria\n\n- [ ] `LLMBudgetExhaustedError(LLMRunnerError)` exists in `src/rebar/llm/errors.py` and\n      `interpret_failure`'s budget branch raises it with the same message and `.diagnostic` as\n      today; verified by a unit test on `interpret_failure` asserting the raised type, message, and\n      diagnostic keys, and by every existing `except LLMRunnerError`-based test passing unmodified\n- [ ] a step-budget exhaustion (`LLMBudgetExhaustedError`) routes into the\n      bounded per-criterion recovery instead of propagating; verified by a test driving it end to end\n      through `CompletionAgentStep.run` with a fake runner and asserting recovery ran and produced a\n      verdict\n- [ ] a plain `LLMRunnerError` that is NOT the budget subclass still propagates unchanged (the catch\n      is purely typed — no message or diagnostic-shape sniffing); verified by a negative-control test\n- [ ] the truncation path keeps its current behaviour exactly (`UnretryableOutputError` +\n      `_is_token_exhaustion` -> recovery; non-exhaustion `UnretryableOutputError` propagates);\n      regression-pinned by the existing tests passing unmodified\n- [ ] recovery still fails CLOSED when it cannot produce full criterion coverage — this must never\n      become a route to an unearned PASS; verified by a test where recovery's preconditions fail and\n      the step still raises\n- [ ] when recovery also fails, the original budget diagnostic is preserved on\n      `self.failure_diagnostic` (not lost); verified by a test asserting the diagnostic's\n      `requests`/`tool_calls` counters survive","env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","file_impact":[{"path":"src/rebar/llm/errors.py","reason":"new LLMBudgetExhaustedError(LLMRunnerError) so the budget stop is identifiable purely by type"},{"path":"src/rebar/llm/structured_run.py","reason":"budget branch of interpret_failure raises the subclass (message/diagnostic unchanged)"},{"path":"src/rebar/llm/workflow/completion_recovery.py","reason":"CompletionAgentStep.run catches LLMBudgetExhaustedError so bounded recovery is reachable"},{"path":"tests/unit/workflow/test_completion_token_recovery.py","reason":"tests: budget exhaustion routes to _recover; plain LLMRunnerError negative control"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","managed_refs":[["parent","9b71-55b3-1bd1-4a97"],["relates_to","4426-330b-9c17-4ad6"]],"no_file_impact_reason":"","parent_id":"9b71-55b3-1bd1-4a97","parent_status_uuid":"52e6d9b4-4059-45a7-8eae-4b41aae789a5","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"reverts":[],"status":"in_progress","tags":[],"ticket_id":"fd84-92b4-01ba-4911","ticket_type":"bug","title":"Bounded completion recovery is unreachable for a step-budget exhaustion (LLMRunnerError is not UnretryableOutputError)","verify_commands":[]},"source_event_uuids":["3942e3e9-1f16-4e21-bd91-942bf5e816d3","4a7f8ade-3264-49c7-9a91-281c8b97ecb5","386f4ad2-695f-4aaa-b81c-99f5ac271ff3","5083c85b-4b8c-4c60-a8d8-6c53d2901a56","61298d86-22f3-4ae9-a57d-c65522a65a89","0d90befa-9ecc-4281-a678-497b5460c546","72bd899b-be94-43a2-9db1-8850411468c2","5705552c-2788-41ab-af3d-e4819eed09f0","ca0a17cc-546a-4e49-ada3-69165c8a1105","52e6d9b4-4059-45a7-8eae-4b41aae789a5","02aabdad-e6cd-4386-9e07-c78f40cd6ae5","80d97bb0-4ac6-4ecb-9339-b78c0ec7bf1f"]},"env_id":"ade0f2ef-51cc-45a2-bb97-c09846cd3df5","event_type":"SNAPSHOT","timestamp":1785963871528023740,"uuid":"7f0e7eac-a714-4b0d-b2a1-1e0d87e0ea78"}