{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787330063469291530,"compiled_state":{"alias":"pinkish-tabarded-cornsnake","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"21a178e27602c24ca78ccc2911608e9816f9780c","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: db7f-6e32-9df9-40e5","material: c4099e83983ac1bb","material-part: children 647ea2107ca5072f 0","material-part: description 68689b961f70b7cf 5919","material-part: description_boxes 7879981d4f226a8f 0","material-part: file_impact c2c0c55be5b1125a 6","material-part: ticket_id b127d461aca44338 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (21a178e276)","regver: 362a5dd2d2052826","verified-at-sha:6fb4d801c908a04aaddc48accdce2e1777b1d26e","dep 3cc45d48de48a52bbbf0af55995cfef98387e84f5bd66a97bd9d4154f7df3ed8 docs/cli-reference.md","dep 258f03579dc7002abc7c35cf332691c76a953c520aec4076ecde828297679a3d src/rebar/_cli/_parsers/advanced/audit.py","dep 6ff46fd56ac0ae6d94e4cf5ab63bf6837b430402570e29502d7cdcead82ac0e5 src/rebar/_cli/_parsers/advanced/bridge_arms.py","dep 273f7079c4b70773a056f7e4944992308d699b4214078c5669c6a8ea28eb7d7d src/rebar/_cli/_parsers/advanced/metrics.py","dep 1deef5b4f571adb21d8e5cd4ee456404c51c39b06819b40180b3cfb20769071f src/rebar/_cli/help/bridge-fsck.txt","dep absent tests/interfaces/contracts/test_parser_formatter_pinned.py","read-set: 9","read-path: scripts/gen_cli_help.py","read-path: scripts/gen_cli_reference.py","read-path: src/rebar/_cli/_parser.py","read-p