keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"18c1c89e9145c9093b846c8ec8f533abbcdcb8d307280ea8230d27fd67c64e05","event_uuid":"d79a61cf-f277-4759-879c-01155238469a","position":{"commit_sha":"632a69d030bf0716cba76e3de0987b322796b37d","position":"1787142577061712001-d79a61cf-f277-4759-879c-01155238469a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"ce5353ac49e7c3125f243522959c21d130ec37e79087c91e1c73dead916f4b82","event_uuid":"c28141a1-ac6e-4388-86ec-d6c0af2fa2f6","position":{"commit_sha":"aab59cf6165477284392a5cdb6a7b8283d605d9e","position":"1787142772227913001-c28141a1-ac6e-4388-86ec-d6c0af2fa2f6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"8b27cdb65eb2b1fd1cc002934a6d45cc76bad7e60cfb3a9af241420a34c333e1","event_uuid":"a3f01101-44b1-4e22-8858-c9003e2734dd","position":{"commit_sha":"d8bc5e5e8528dfefb2ecda3d15b238b04c4499de","position":"1787142876156389001-a3f01101-44b1-4e22-8858-c9003e2734dd"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c8671e09174dcc3d6812b0865d167b9c2d89c70ece456ac508d22ce02a853bc4","event_uuid":"b3cc384f-60b0-4f07-bbee-eb7647cd724e","position":{"commit_sha":"d8bc5e5e8528dfefb2ecda3d15b238b04c4499de","position":"1787142877017954001-b3cc384f-60b0-4f07-bbee-eb7647cd724e"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[],"created_at":1787142001026014001,"creation_channel":"cli","deps":[],"description":"## Context / Problem\n\nRP-04's config-ownership drain reaches its final two rows. After C3f\n(`ed65`) drains the nine residual files, `scripts/config_ownership_exceptions.py`\n`LEGACY_EXCEPTIONS` holds exactly TWO rows, both on\n`_engine/rebar_reconciler/binding_lifecycle.py`:\n\n- `RECONCILER_ABSENT_RETIRE_GRACE` — the consecutive-404 absence-retire grace,\n  read in `note_absent` via the local `_env_int` shim.\n- `os.environ.get` — the raw ambient lookup inside that same `_env_int` parser.\n\nBoth were MOVED into `binding_lifecycle.py` from `binding_store.py` by RP-02 S2\n(the absence policy travelled with them). RP-04 S7.3.a (ticket `6633`) closed\nhaving cut the reconciler CORE/JIRA reads but NOT these — its recorded file\nimpact named the pre-move `binding_store.py`, so the moved reads fell through.\nTracker `01d8` records the coupling but is bookkeeping-only (no file impact,\nout of the epic tree). This story is the executable drain that RP-02 S2's move\nleft owing, and it is the LAST one before the whitelist is EMPTY.\n\n## Key finding — the owned accessor already exists, exposed via the public facade\n\nThe cut is NOT a constructor-threading refactor. `src/rebar/_config_sources.py`\n(a composition root that owns env reads) ALREADY exposes\n`resolve_absent_retire_grace()` — \"Owns the read for binding_store/binding_walk\"\n— with byte-identical semantics to the local shim: raw `RECONCILER_ABSENT_RETIRE_GRACE`\nover the default `3`, clamped `>= 1`, malformed/absent → default. It is\nre-exported through the PUBLIC facade `rebar.config`\n(`config.py`: `from rebar._config_sources import resolve_absent_retire_grace as\nresolve_absent_retire_grace`), which is exactly how the sibling reconciler modules\nconsume owned config (`fetcher.py`/`applier.py` use `from rebar.config import\ncompose_config`/`repo_root_env`/`reconciler_repo_root`). So this is the\nestablished, in-process pattern — import the accessor from `rebar.config`, never\nfrom the private `_config_sources` module.\n\n## Approach\n\n1. In `binding_lifecycle.py::note_absent`, replace the\n   `_env_int(\"RECONCILER_ABSENT_RETIRE_GRACE\", _DEFAULT_ABSENT_RETIRE_GRACE, minimum=1)`\n   call with `resolve_absent_retire_grace()` imported from the PUBLIC facade\n   `from rebar.config import resolve_absent_retire_grace` (the same import\n   direction `fetcher.py`/`applier.py` already use — no cycle).\n2. Remove ONLY the now-dead `_env_int` helper (its single caller was that\n   `note_absent` read), which eliminates the ambient `os.environ.get` read\n   entirely. KEEP the `_DEFAULT_ABSENT_RETIRE_GRACE` constant: it is a plain\n   module constant (NOT an ambient read, so the gate never flagged it) and it\n   has a live cross-module consumer — `binding_store.py` aliases it at import\n   time (`_DEFAULT_ABSENT_RETIRE_GRACE = binding_lifecycle._DEFAULT_ABSENT_RETIRE_GRACE`)\n   and `tests/unit/rebar_reconciler/test_no_resurrection_after_confirmed_delete_3b5f.py`\n   reads that alias. It stays at `3`, agreeing with the accessor's default.\n3. Remove BOTH `binding_lifecycle.py` rows from\n   `scripts/config_ownership_exceptions.py`. `LEGACY_EXCEPTIONS` is now EMPTY.\n\n## Portability\n\nThe cut composes through an in-process owned accessor exposed on the public\n`rebar.config` facade; it has no CI-provider or external-service trigger. The\nconfig-ownership gate is a deterministic offline AST check. Works with any or no\nCI provider.\n\n## Acceptance Criteria\n\n- [ ] `note_absent`'s absence-retire grace is sourced from\n  `resolve_absent_retire_grace()` imported from the public `rebar.config`\n  facade; no ambient `os.environ` read or `_env_int`-style shim for it remains\n  below the seam in `binding_lifecycle.py`.\n- [ ] The dead `_env_int` helper is removed (its only caller was rewired), so\n  `binding_lifecycle.py` carries zero below-seam config/credential reads. The\n  `_DEFAULT_ABSENT_RETIRE_GRACE` constant is RETAINED (still aliased by\n  `binding_store.py` and asserted by the resurrection test).\n- [ ] Both `binding_lifecycle.py` rows are removed from\n  `scripts/config_ownership_exceptions.py`, and `LEGACY_EXCEPTIONS` is now\n  EMPTY (`[]`) — the whole-tree config-ownership drain is complete.\n- [ ] `python scripts/check_config_ownership.py` reports zero findings with the\n  whitelist empty.\n- [ ] Absence-retire behavior is byte-preserved: default 3, clamp `>= 1`,\n  malformed/absent env → default; a set valid value is honored; a binding\n  retires at exactly `grace` consecutive 404s.\n\n## Testing / Verification\n\n- Held-out oracle (RED-first before the cut): `python -m pytest\n  tests/scripts/test_binding_lifecycle_grace_seam_clean_heldout.py -q` — asserts\n  `LEGACY_EXCEPTIONS == []`, the gate is clean for `binding_lifecycle.py`, no\n  `_env_int` shim remains, and the grace behavior is byte-preserved.\n- Config-ownership gate: `python scripts/check_config_ownership.py` (exit 0).\n- Module-size gate: `find src/rebar -name '*.py' | grep -v __pycache__ |\n  xargs wc -l | awk '$2!=\"total\" && $1>800'` (empty).\n- Env-registry drift: `python scripts/gen_env_registry.py --check` (clean).\n- Full pre-flight: `make lint && make typecheck`, plus the reconciler\n  binding-lifecycle unit tests (`pytest -k \"binding or resurrection\"`).","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/binding_lifecycle.py","reason":"rewire note_absent to the owned resolve_absent_retire_grace() accessor; remove dead _env_int helper + its ambient os.environ.get read"},{"path":"scripts/config_ownership_exceptions.py","reason":"remove the final two binding_lifecycle.py LEGACY_EXCEPTIONS rows; whitelist becomes EMPTY"},{"path":"tests/scripts/test_binding_lifecycle_grace_seam_clean_heldout.py","reason":"held-out oracle: whitelist EMPTY, gate clean for binding_lifecycle.py, _env_int removed, grace behavior byte-preserved"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[["parent","075b-1479-dcb7-40ab"]],"no_file_impact_reason":"","parent_id":"075b-1479-dcb7-40ab","parent_status_uuid":"a3f01101-44b1-4e22-8858-c9003e2734dd","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"in_progress","tags":["reconciler","config","rp04"],"ticket_id":"2a95-236b-535f-460e","ticket_type":"story","title":"RP-04 C3g: cut binding_lifecycle absence-grace read (reach EMPTY)","verify_commands":[]},"source_event_uuids":["f045644c-017d-427f-8479-1145621e6675","84bba174-3ec3-4ade-8ed7-445e9ff0b4f1","4b6a6b2e-112b-4b31-bbb8-71ffe19f6f62","d79a61cf-f277-4759-879c-01155238469a","c28141a1-ac6e-4388-86ec-d6c0af2fa2f6","a3f01101-44b1-4e22-8858-c9003e2734dd","b3cc384f-60b0-4f07-bbee-eb7647cd724e"]},"env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","event_type":"SNAPSHOT","timestamp":1787142877017954002,"uuid":"d1f3a53f-4f96-4b68-a25d-cb87af155cf3"}