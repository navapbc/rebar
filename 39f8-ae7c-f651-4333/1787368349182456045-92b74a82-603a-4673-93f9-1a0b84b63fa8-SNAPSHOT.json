{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787368349182456045,"compiled_state":{"alias":"loveydovey-preoceanic-geese","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"ce331172813a59559f0c13332b67a5c23dbfdb3b","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 39f8-ae7c-f651-4333","material: cb9f229c539a79f8","material-part: children 647ea2107ca5072f 0","material-part: description 0b272431c5823670 7535","material-part: description_boxes 399141be1d30ac26 0","material-part: file_impact dabfc49483dffd61 11","material-part: ticket_id ae071144ce5b1c81 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 1","review-phase: planning","rebar-version: 0.12.0 (ce33117281-dirty)","regver: aa61189569d34126","verified-at-sha:ce331172813a59559f0c13332b67a5c23dbfdb3b","dep bec5f0ffbc5b88dae33abd2db067fcfc1002687a2c0dfad4d8906e7da72b287f docs/config.md","dep 68a3bb207d15ce60c29fd0cbda23ecb433ff7dc568c7f3e2a3963b1aaaab2e70 docs/llm-framework.md","dep 1d8546a5ca2deee6b771c576f9005acec5e46d49278381fcd1374901c6d151dc docs/plan-review-gate.md","dep cb269c210d0b792dd8939ddb032ce1ac8bd376d489f594f9daf0dcccde81a9a1 src/rebar/_cli/__init__.py","dep f325f1af420e8d2337f7191ad93dd38f393d8c0d9839331f1d30c58f1ac22b49 src/rebar/_commands/close_precheck.py","dep ce00ef78c8991e0b42aa056124ae9064b3398f0289727b5462686cd8877f36ac src/rebar/_commands/gates.py","dep f50a00ec668e715ebf16aadf8c4291558fe2eec846a849ee06fbdc0e9b765660 src/rebar/_commands/transition_close.py","dep 4f2e108b58b40a24e117d31f28ce8f1e6225e5ac272a9424cae6