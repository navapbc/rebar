{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1793915632687414002,"compiled_state":{"alias":"inferior-seaborgium-aruanas","assignee":null,"author":"Rebar Bot Nava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":18,"unsigned":0},"authorship_ledger":[{"content_hash":"f485d3de9b8ceecc6d0e1b8acb52be95c61c8f392accc637a3204056fcdb587a","event_uuid":"6dc719bf-d232-44e9-bcb3-dcd5630b2a5d","position":{"commit_sha":"4844d784a5c971f2a07bd54672e760e76f3cd84b","position":"1793912050029097001-6dc719bf-d232-44e9-bcb3-dcd5630b2a5d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"795b18ced33f82373efe5d9df3f6cf234a6e67eb53c579d957f09d404dc63a99","event_uuid":"7849ca9f-583d-48c8-bd15-e3c07c0d869d","position":{"commit_sha":"5a5183891b9fc764adea46e837a82fd84046b917","position":"1793914368908353001-7849ca9f-583d-48c8-bd15-e3c07c0d869d"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"6a2a8aead3e00147c1fc552277c06349765891bd2e69d07b207138a4eb68e271","event_uuid":"558d7d7c-72df-44d4-b920-9d8c0dba69ef","position":{"commit_sha":"11db674eac1ca98649e193a2552361a6a1591b36","position":"1793914378376475001-558d7d7c-72df-44d4-b920-9d8c0dba69ef"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"5f18a65541e4822fe6541e5ca34aca0776b378bb0b46d2fb07f8cd81a023686d","event_uuid":"f7598fc2-af63-4a11-bf9b-5bd06c8cff03","position":{"commit_sha":"1b558a1940c5f348e30f573027f05f46920e753a","position":"1793914618526861001-f7598fc2-af63-4a11-bf9b-5bd06c8cff03"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"c46577fe05e7cd9d5acb06b393e47f7eb222349519b02539f7ec5b82fd26b41a","event_uuid":"124d9df5-986e-44ee-ac35-4ec4e32eaed4","position":{"commit_sha":"a732937a6361435f9f9b0ddb33b7262ac1af8e89","position":"1793914627147356001-124d9df5-986e-44ee-ac35-4ec4e32eaed4"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"6360d78d3b375497037393bada6e256f7e7401aecb3a608a07e4b9a7acb29914","event_uuid":"f10bf9ba-095a-4960-98b6-9f9799bc2d00","position":{"commit_sha":"0c458cce2d9cc7ab712f6b4ce2beba5f64db55a3","position":"1793914664060331001-f10bf9ba-095a-4960-98b6-9f9799bc2d00"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"40f73d565b2bf2557eb603d04110115297b8df8cbae24f566f5015c0a5c3410d","event_uuid":"6024e7c3-c9ab-4dd3-883e-bfe3fbd1cea3","position":{"commit_sha":"d834d1f50bb651e91a12f09673b48f5a655716e7","position":"1793914697522589001-6024e7c3-c9ab-4dd3-883e-bfe3fbd1cea3"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"d48d8bd265ca812a38caa81a6654d3a0d348ae086274fa3bb0b128fac36ea908","event_uuid":"5cb68f1c-83d3-4fa7-9153-3ae6e3337e62","position":{"commit_sha":"5cc25592d9f597240bab177f620e3920bc5e2f4f","position":"1793914709737369001-5cb68f1c-83d3-4fa7-9153-3ae6e3337e62"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"18f4f36be48abfb9dcd88a57779af0a0e8eff947e426c3b52a357abffec6dd04","event_uuid":"dd3fb164-cb4d-458a-9644-0623eaab17c6","position":{"commit_sha":"83dc5c30f99bb02069469e2a883ad24bfb601f1a","position":"1793914842135855001-dd3fb164-cb4d-458a-9644-0623eaab17c6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGNNmnI/WYNJAOKH9yvo0l+tMYJR2tK2UV4H8ReXBQU5 rebar-bot joeoakhart+bot@navapbc.com rotated-20260907"},{"content_hash":"464bb4764062ad1cc8e07db959acca1d2b91067b4fe5399198149853408fd89e","event_uuid":"48565745-61ea-40f1-90de-3a3ac5bda2fb","position":{"commit_sha":"1c2bc2fe89d82c9826b17574f83e655904018c93","position":"1793914850858496001-48565745-61ea