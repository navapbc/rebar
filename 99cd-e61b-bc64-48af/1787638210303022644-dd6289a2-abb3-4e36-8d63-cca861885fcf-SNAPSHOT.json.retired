{"author":"rebar-bridge[bot]","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","data":{"compacted_at":1787638210303022644,"compiled_state":{"alias":"shaven-censorable-sifaka","assignee":"joeoakhart@navapbc.com","attestations":{"plan-review":{"algorithm":"sshsig","author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","envelope":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.opcert.v1+json\", \"signatures\": [{\"keyid\": \"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126\", \"sig\": \"\"}]}","head_sha":"49c2067d7ddeeb24068bd2cc62441c307eebb5b3","key_id":null,"kind":"plan-review","manifest":["plan-review: PASS","ticket: 99cd-e61b-bc64-48af","material: 0f839eb3975088cd","material-part: children 647ea2107ca5072f 0","material-part: description 78f15a3273dd7f31 3668","material-part: description_boxes 05a8475feebbfea6 0","material-part: file_impact 003ffa614d5e4a28 0","material-part: file_impact_scope ea2e39ad1c26bf1a 2","material-part: ticket_id 6415d0675daf75af 19","model: bedrock:us.anthropic.claude-sonnet-4-6","runner: pydantic_ai","blocking: 0","advisory: 3","review-phase: planning","rebar-version: 0.12.0 (49c2067d7dde)","regver: aa61189569d34126","verified-at-sha:49c2067d7ddeeb24068bd2cc62441c307eebb5b3","file-scope: none","read-set: 6","read-path: docs/adr/0005-snapshot-cache-architecture.md","read-path: src/rebar/_snapshot/repo_snapshot.py","read-path: src/rebar/reducer/__init__.py","read-path: src/rebar/reducer/_api.py","read-path: src/rebar/reducer/_cache.py","read-path: src/rebar/reducer/_processors.py","currency-basis: fail-safe"],"material_fingerprint":"0f839eb3975088cd","merged_log_commit":"49c2067d7ddeeb24068bd2cc62441c307eebb5b3","principal":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","signature":null,"signed_at":1787630586803559000}},"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","authorship":{"signed":9,"unsigned":0},"authorship_ledger":[{"content_hash":"8a29999c3234da4d5b25665b9dbccc4aff93786ca6475a10cd7113d42ad09b13","event_uuid":"7a430715-b9e8-456c-b31e-eb31b47db16c","position":{"commit_sha":"cf4ffde3df65b0c307f7674f4fff3ca3643f7c89","position":"1787629286785052001-7a430715-b9e8-456c-b31e-eb31b47db16c"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"e837a7dabe3bb087fdedc570bf648eab02d8bd2b29677e095dc314dda9d3cb26","event_uuid":"7a58dcd3-e92b-4009-98af-4ed969b103c9","position":{"commit_sha":"c63c2f7036cbd0d79840d0c06ae0f1118b7683bd","position":"1787629309249182001-7a58dcd3-e92b-4009-98af-4ed969b103c9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"5fac07f3016773923c0f967ce39404259fb47eef803593553a5ef76507736d03","event_uuid":"74502c09-4433-47b5-a1a2-7a6816a7153b","position":{"commit_sha":"3ef726426a5f4e79f2e181b760265077667cc9cd","position":"1787629326740170001-74502c09-4433-47b5-a1a2-7a6816a7153b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"03d327aa5152a4b312e62ac827f446a0d8af977458c79ad25493c95199042cbb","event_uuid":"dc2bd576-bbf5-46b9-bc56-2446d2a81f14","position":{"commit_sha":"6e8db120e92a0c7b6348f9efbd60a2db4e42afb1","position":"1787630059282884001-dc2bd576-bbf5-46b9-bc56-2446d2a81f14"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"1290d84bf44c9f8d6143c16f08341d356d13738c1c92ed7f7932372c6ad5a63e","event_uuid":"5b211733-cbfb-4717-a5d4-f4af3a0d476a","position":{"commit_sha":"29d581426576bc321822089e50e05b6bef244adf","position":"1787630586837074001-5b211733-cbfb-4717-a5d4-f4af3a0d476a"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"3b61ed1adbfeafe4810d174e859ddfa7171f058c38512dd119eefe0802e8cedf","event_uuid":"dcacad2f-48ce-4212-b6f7-d3feb73ade25","position":{"commit_sha":"282782b67063efb563d03af0a0c62235979d41a1","position":"1787630842315736001-dcacad2f-48ce-4212-b6f7-d3feb73ade25"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"10e7543f3f6097d560b4c1276adb7c5f6e6ee1ce5f20286dd6deeae62705c3b3","event_uuid":"e9e6a75f-079c-47c2-a936-2181734cd895","position":{"commit_sha":"282782b67063efb563d03af0a0c62235979d41a1","position":"1787630849869116001-e9e6a75f-079c-47c2-a936-2181734cd895"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"c061d28caabb7a19f789f772a0148c48222a892be4b7bcc481b1c3a629aaa05a","event_uuid":"2db4aed8-cf35-42ea-bb62-215359cb87c6","position":{"commit_sha":"6e7f6b5619da0a5ee19e35e8d4e3ee06ecd746fc","position":"1787631452019841001-2db4aed8-cf35-42ea-bb62-215359cb87c6"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"},{"content_hash":"2acca33f45917e02b89430cd12862c008194c1dd75ea8f8f34b9a10d5e4f950a","event_uuid":"d8e4dc05-6d89-42e3-8bc6-491a9e6ed8e9","position":{"commit_sha":"71fe4b908509df5a712cdf5f186510612654b3e8","position":"1787631570528501001-d8e4dc05-6d89-42e3-8bc6-491a9e6ed8e9"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHe3p+OG3L79IIh99qRBEkAEXaU+VbeQcSfhIu4M2F8b rebar-bot joeoakhart+bot@navapbc.com"}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Pinned read-view stability mutation marker: pinned-read-view-stability-99cd-e61b-9f7c2d61. Preliminary real-store probe at revision 86b18cb9defc0a12074bf4a68efb22b5efed2dff: 40 trials; rev-parse p50/p90/max 9.496/12.404/62.312 ms, ticket ls-tree 11.562/16.346/295.227 ms, batched cat-file 10.961/14.518/49.416 ms. Scoped extraction plus uncached reduction: 29.156 ms total, 10 files, 62,426 bytes, pinned/live canonical state hashes equal, no cache file written.","timestamp":1787631452019841001},{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Final experiment and OSS research evidence, 2026-08-24\n\nREAL PINNED READ / CONCURRENT WRITE\n- Captured A=86b18cb9defc0a12074bf4a68efb22b5efed2dff. A one-ticket view listed and fetched 10 blobs / 62,426 bytes, materialized to a temporary directory, and reduced uncached in 29.156 ms total. Its canonical reduced-state hash b9a5e0dcbf3956e757aedbac5689357a6d5efb6e74fb48d48f8b0c52b1ecfb22 exactly matched the live target state. event_files_override created no .cache.json.\n- A normal rebar comment advanced the live tracker to B=6e7f6b5619da0a5ee19e35e8d4e3ee06ecd746fc. Git proved A is an ancestor of B. Re-reading the A manifest was byte-identical; the unique mutation marker was absent at A and present only in the new COMMENT blob at B. This proves stable pinned reads while the normal store continues mutating.\n- Compared with the observed 135,334-234,615 ms full-store materialization phases, the 29.156 ms scoped path was about 4,642-8,047 times shorter in these samples. This comparison isolates mechanics, not an end-to-end completion forecast.\n\nDISPOSABLE VALIDATION FIXTURE\n- Exact read plus children-of-target predicate manifest: an unrelated ticket COMMENT stayed valid; a target COMMENT invalidated the exact read; a newly created child invalidated the predicate even though the child did not exist at A; an incomparable revision failed closed before diffing.\n- A .bridge_state/bindings.json change invalidated the global-context dependency and changed REB-1 resolution from bbbb-bbbb-bbbb-4bbb to aaaa-aaaa-aaaa-4aaa. Query/global reads must therefore be explicit dependencies, not inferred only from ticket directories already visited.\n- Alias LINK gotcha: full-store reduction resolved sibling-alias to bbbb-bbbb-bbbb-4bbb; isolated target-only reduction retained sibling-alias. A scoped view needs canonical references or equivalent resolver context.\n- Self-write gotcha: adding reducer-ignored COMPLETION_VERDICT changed the target tree OID from 2721aeb373f1965f5a899794f45d614f383c45b3 to 86e8e61b1d6971be788eaee918a36fe7649fcec8. Raw reduced hashes also differed, but only because the derived updated_at field advances; hashes with that presentation field removed were identical at d80deffc55665c2bfd07af61bc5aed952077727364a415bf5eaf00f1a1473ce6. A raw target-tree dependency would make completion conflict with its own sidecar write. Validation must distinguish state-bearing inputs from operation-owned observability events, or validate before any sidecar write and carry the result atomically into mutation.\n\nACTIVE OSS PRIOR ART\n- Git, about 62.8k stars and v2.55.0 in 2026: immutable commit/tree OID plus lazy batched object reads and atomic ref advance. https://git-scm.com/docs/git-cat-file#Documentation/git-cat-file.txt---batch-command and https://git-scm.com/docs/git-update-ref\n- libgit2, about 10.6k stars and v1.9.7 in 2026: in-process path lookup in an immutable commit tree without checkout. https://libgit2.org/docs/reference/v1.9.7/tree/git_tree_entry_bypath.html\n- SQLite, about 10.3k stars on the official mirror and 3.53.4 in 2026: a WAL reader pins an end mark while writers append; stale promotion fails. https://www.sqlite.org/wal.html#concurrency\n- RocksDB, about 32.0k stars and v11.8.1 in 2026: sequence-number snapshots plus transaction conflict checks. https://github.com/facebook/rocksdb/wiki/Snapshot and https://github.com/facebook/rocksdb/wiki/Transactions\n- PostgreSQL, about 21.9k stars on the official mirror and supported releases in 2026: MVCC snapshots plus serializable predicate dependency tracking for phantoms. https://www.postgresql.org/docs/current/mvcc-intro.html and https://www.postgresql.org/docs/current/transaction-iso.html\n- etcd, about 52.2k stars and v3.7.1 in 2026: pin a cluster revision and make historical range reads while newer revisions proceed. https://etcd.io/docs/v3.6/learning/api/#revisions\n- FoundationDB, about 16.6k stars and 7.3.77 in 2026: one read version plus exact-key and range conflict sets validated at optimistic commit. https://apple.github.io/foundationdb/developer-guide.html#conflict-ranges\n- Apache Iceberg, about 9.2k stars and 1.11.0 in 2026: immutable shared metadata, atomic current-pointer swap, and explicit assumption revalidation before retry. https://iceberg.apache.org/docs/latest/reliability/\n- LMDB provides the same copy-on-write read-transaction pattern without a data copy. Btrfs snapshots are a filesystem-specific counterexample and do not meet rebar portability needs.\n\nRESEARCH CONCLUSION\nThe recurring design is: capture one immutable version ID, read objects lazily, record exact reads plus predicate/global reads, then validate against the live descendant under the mutation lock and abort or retry on conflict. For rebar this maps directly to tracker commit OID plus Git object reads plus a typed dependency manifest. Whole-store hardlink copies, whole-HEAD equality, target-tree-only equality, and filesystem snapshots are not supported by the evidence. Removing checkout cost also does not remove broad list_states/reduction cost; that must remain separately instrumented and optimized.","timestamp":1787631570528501001}],"created_at":1787629286785052001,"creation_channel":"cli","deps":[{"link_uuid":"74502c09-4433-47b5-a1a2-7a6816a7153b","relation":"discovered_from","target_id":"0538-9893-97b2-4c2d"}],"description":"## Context / Problem\nLive completion runs directly attribute 135-235 seconds to full ticket-store materialization. The store has about 5,500 ticket directories and 132,000 tracked files, so donor hardlinks avoid blob duplication but still perform work proportional to the inode tree. We need evidence for a stable read-only completion environment that pins tracker state cheaply while close, sidecar, and signature mutations continue against the normal live store.\n\n## Approach\nUse the tracker commit OID as the immutable read identity, because Git already preserves an immutable tree and the current implementation already resolves that OID before creating a checkout. Prove the boundary with Git plumbing against the real tracker plus a standard-library disposable Git fixture. The experiments will read objects lazily or extract only named ticket directories; no full-store copy or production implementation is needed.\n\n## Scope\n- Read-only Git plumbing against the configured `.tickets-tracker` repository.\n- A temporary standard-library experiment harness under `tempfile.TemporaryDirectory`.\n- Ticket comments containing timestamped measurements and conclusions.\n- No repository source, test, guidance, or architecture-document edits.\n\n## Testing / Verification\n- Benchmark at least 30 invocations of `git rev-parse HEAD`, pinned `git ls-tree`, and batched `git cat-file` reads against the real tracker; record median, p90, and maximum wall time.\n- Extract one real ticket directory from a captured commit and compare canonical reduced-state hashes using `rebar.reducer.reduce_ticket`.\n- In a disposable Git fixture, capture revision A, commit a live mutation producing revision B, and assert reads through A remain byte-identical while B exposes the mutation.\n- In the fixture, run `git diff --name-only A..B` and semantic predicates for exact-ticket changes, new-child membership, unrelated changes, and non-ancestor history.\n- Record command output, timestamps, environment facts, and cleanup outcome as ticket comments.\n\n## Acceptance Criteria\n- [ ] [non-codebase] Revision-capture timing for at least 30 trials is recorded on this ticket; checked from the harness summary for `git rev-parse HEAD`.\n- [ ] [non-codebase] Pinned Git-tree lookup timing is recorded on this ticket; checked from the harness summaries for `git ls-tree` and `git cat-file`.\n- [ ] [non-codebase] A scoped pinned directory reduces to the same canonical target-state hash as the captured live directory; checked by the harness equality assertion.\n- [ ] [non-codebase] Pinned reads stay byte-identical after a later live commit; checked by the disposable revision-A/revision-B assertion.\n- [ ] [non-codebase] The live view exposes the later mutation; checked by the disposable revision-B assertion.\n- [ ] [non-codebase] Scoped extraction time, file count, and bytes are recorded on this ticket; checked by the harness summary.\n- [ ] [non-codebase] An exact ticket edit invalidates its recorded read dependency; checked by the validation harness exit status.\n- [ ] [non-codebase] A newly matching child invalidates the recorded child-query dependency; checked by the validation harness exit status.\n- [ ] [non-codebase] An unrelated ticket mutation leaves the relevant dependency set valid; checked by the validation harness exit status.\n- [ ] [non-codebase] A non-ancestor live revision fails closed; checked by the validation harness exit status.\n- [ ] [non-codebase] Primary-source OSS prior art and design gotchas are recorded on this ticket; checked by cited URLs in the research comment.\n- [ ] No repository files change; checked by `git status --short` in the dedicated worktree.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[],"file_impact_scope":"none","keyring":[],"last_status_env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","managed_refs":[],"no_file_impact_reason":"Read-only disposable experiments and ticket-recorded research; no repository files will be changed.","parent_id":null,"parent_status_uuid":"dcacad2f-48ce-4212-b6f7-d3feb73ade25","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":1,"repos":[],"reverts":[],"status":"in_progress","tags":["architecture","performance","completion-verifier","research"],"ticket_id":"99cd-e61b-bc64-48af","ticket_type":"task","title":"Experiment with a pinned read-only ticket view for completion verification","verify_commands":[]},"source_event_uuids":["7a430715-b9e8-456c-b31e-eb31b47db16c","7a58dcd3-e92b-4009-98af-4ed969b103c9","74502c09-4433-47b5-a1a2-7a6816a7153b","dc2bd576-bbf5-46b9-bc56-2446d2a81f14","5b211733-cbfb-4717-a5d4-f4af3a0d476a","dcacad2f-48ce-4212-b6f7-d3feb73ade25","e9e6a75f-079c-47c2-a936-2181734cd895","2db4aed8-cf35-42ea-bb62-215359cb87c6","d8e4dc05-6d89-42e3-8bc6-491a9e6ed8e9"]},"env_id":"","event_type":"SNAPSHOT","timestamp":1787638210303022644,"uuid":"dd6289a2-abb3-4e36-8d63-cca861885fcf"}