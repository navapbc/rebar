5d","T5e"],"criteria":["T5e"],"decision":"dropped","decision_margin":-0.95,"drop_reason":null,"evidence":["Approach: 'Only that ordering buys the implication, so the probe is no background task or lazy /health field.' — a load-bearing design invariant","No stated ADR / module-docstring update capturing why the drive must run inside the lifespan"],"finding":"The plan introduces a novel architectural decision — driving a real initialize handshake inside the ASGI lifespan before lifespan.startup.complete — but does not state where this rationale is durably captured. It cites the existing module docstring for DEFAULT_SHUTDOWN_GRACE_SECONDS as precedent for the budget-constant choice, yet does not commit to recording the handshake-ordering rationale similarly.","group_criteria":null,"group_id":null,"id":"f4b10f5b3fef7e8b3","impact":0.0,"is_primary":null,"location":"Approach / Scope (_mcp_health.py)","norm_id":"n80836fb07ac6d303","priority":0.0,"reason":"low-validity","recalled":false,"scenarios":["A future maintainer moves the probe to a background task or lazy /health field, silently breaking the by-construction guarantee"],"severity":"none","suggested_fix":"","tier":"LLM","validity":0.375,"verification":{"binary":{"absence_confirmed_in_context":"yes","asserted_capability_confirmed":"na","cited_reference_accurate":"na","claims_absence":"yes","committed_work_relies_on_unbacked_claim":"na","current_state_satisfies_plan_goal":"na","evidence_entails_finding":"yes","impact_follows_necessarily":"no","is_verifiable":"yes","no_existing_mitigation":"no","no_viable_alternative_explanation":"no","path_reachable":"yes","prerequisite_attribution_valid":"na","respects_artifact_altitude":"no","severity_claim_justified":"no"},"severity_attributes":{"ac_unverifiable":"none","blast_radius":"local","debt_impact":"low","divergent_implementation":"none","dod_uncertifiable":"none","internal_conflict":"none","irreversible_without_rationale":"none","likelihood":"medium","prod_impact":"none","r