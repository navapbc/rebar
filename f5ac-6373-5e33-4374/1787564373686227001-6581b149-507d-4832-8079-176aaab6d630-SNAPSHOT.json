94c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3918d703a9d9493bc6e83548370aa39c661e5be3441f1ff938df1972123be13a","event_uuid":"ae0da8f4-7b8e-41a0-a7f9-e116ada84521","position":{"commit_sha":"a1a40f868935bba8707423a1ce4df81f03cdf778","position":"1787560280570508001-ae0da8f4-7b8e-41a0-a7f9-e116ada84521"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"0bcc323f610cf40b7420ad2daf0c185733a5f90d9995fc7ea942c76d60ff18f5","event_uuid":"76c9b5cd-f287-4751-af07-18c5af477144","position":{"commit_sha":"e3ee529ab5cbf82090a6b466206d86600b4ada7a","position":"1787561057434102001-76c9b5cd-f287-4751-af07-18c5af477144"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"3abf919c1a900956d7eede5febfe9f95620fe459d6c95f4630461cf0f6f56506","event_uuid":"9669808f-d2fb-4ad0-bafa-97a99831395b","position":{"commit_sha":"690493e6849b68b55ff6bad103f9ae6823eb49dd","position":"1787561417604811001-9669808f-d2fb-4ad0-bafa-97a99831395b"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null},{"content_hash":"9e0f98b4ce8369cc227897f4469574611501c6763cf28f715cca7b7193920476","event_uuid":"5c74d563-2b8f-402b-ab07-537e36bd5268","position":{"commit_sha":"690493e6849b68b55ff6bad103f9ae6823eb49dd","position":"1787561427341679001-5c74d563-2b8f-402b-ab07-537e36bd5268"},"signature":"{\"payload\": \"\", \"payloadType\": \"application/vnd.rebar.authorship.v1+json\", \"signatures\": [{\"keyid\": \"594c-9dcf-5ad6-4e6d\", \"sig\": \"\"}]}","signer_pubkey":null}],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"comments":[{"author":"RebarBotNava","author_email":"joeoakhart+bot@navapbc.com","author_id":"594c-9dcf-5ad6-4e6d","body":"Plan-review remediation evidence (2026-08-17): installed the lock-compatible optional dependency `jira==3.10.5` into this dedicated worktree venv and inspected the runtime API without reading credentials or contacting Jira. `inspect.signature(jira.JIRA.__init__)` exposes top-level `max_retries: int = 3`. Source assigns `self._session.max_retries = max_retries`. A no-network construction probe using `JIRA(server=\"https://jira.invalid\", token_auth=\"probe\", get_server_info=False, max_retries=0)` produced `_session.max_retries == 0`. This confirms the dedicated executor-client mechanism and shows that the existing transport comment about `verify` belonging in the options dict does not apply to `max_retries`. The remediated plan review then certified PASS at origin/main SHA 5b5008bbfbec04cd8c0c9ad2d4b2860ed7d8f652.","timestamp":1787027230899582001}],"created_at":1787022532234587001,"creation_channel":"cli","deps":[{"link_uuid":"456581fc-1006-4f33-9e62-abec02381228","relation":"relates_to","target_id":"e042-4780-6c63-4b09"},{"link_uuid":"30f1e3b2-d609-446f-ab33-7beb0aa15733","relation":"relates_to","target_id":"6e3b-3d1a-0ff7-44b6"}],"description":"## Context / Outcome\nNested subprocess/SDK/wrapper/reconciler retries mean a timeout can multiply Jira writes or leave acceptance ambiguous. Prove one provider-neutral budget by setting an exact summary through Cloud and DC. Jira has no idempotency key, so recovery observes desired state before replay. S1 establishes ADR 0103; S3 owns cutover/consumption; S5 finalizes it.\n\n## Approach\n1. Define an operation/outcome contract: stable logical id, desired postcondition, invocation/request counts, disposition, failure scope, replay safety, provider delay, `retry_not_before`, and bounded redacted diagnostics (at most eight chronological entries; each message redacted then capped at 512 Unicode code points).\n2. One physical invocation is one executor call to a write or observation; raw requests counted separately. At most three invocations and 15s cumulative sleep. Fallback delay `2**(attempt+1)+U[0,1)`: [2s,3s), then [4s,5s). Provider `Retry-After`, parsed by `_errors.parse_retry_after`, is a lower bound.\n3. Add a constructor-injected internal route selector at dispatch, defaulting to legacy in S1 (not config/env); tests explicitly select the executor. Only exact `{\"summary\"}` is eligible; mixed fields remain one legacy call. No dual-send. S3 owns venue-gated validation and default-on cutover.\n4. Cloud makes one ACLI process per write, preserving POSIX/non-POSIX cleanup; decode sanitized exit/stdout/stderr, unknown shapes fail loud. Recovery uses primary-store `get_issue_by_rest`, never ACLI JQL. A per-call policy on `acli_rest._rest_urlopen_with_retry` gives summary recovery one attempt/no sleep; other callers keep three attempts (2s/5s).\n5. Build the dedicated DC executor via the public `jira.JIRA(..., max_retries=0)` seam, then fail fast unless the constructed client's `_session.max_retries == 0`. Validate this riskiest capability FIRST, in-session, against the REAL `jira` 3.10.5 library (see the AC): an offline construction test proves the knob before executor logic layers on it, mirroring the accepted construction-time guard at `llm/anthropic_model.py`. The legacy client keeps current SDK retry. Selected pre-read/write/read-back calls use `_with_connection_retry` under a per-call one-attempt/no-sleep policy; legacy callers unchanged.\n6. A DC summary-write invocation is GET -> PUT -> GET with no hidden repeats; failure ends that invocation. Successful read-back is authoritative. After an ambiguous PUT, a separate GET observation consumes the next invocation.\n7. Desired summary observed after timeout is recovered success; conclusive old state may replay within remaining budget; failed/rate-limited/inconclusive returns non-replaying `commit_unknown`. A delay that cannot fit returns `retry_not_before` without sleeping. Auth/TLS/permission/invalid-request/permanent failures do not retry; eligible network/429/retryable-5xx use the shared schedule.\n8. Keep the `update_one`/`apply_handlers.handle_update` boundary while S1 is test-only. `dispatch_one` maps success/recovered success to the legacy result, filling `_fields_synced` only after conclusive success; `_comment_errors`/`_subop` keep shapes; `commit_unknown`/`retry_not_before` map to a tagged internal result. `handle_update` records one redacted per-mutation message (<=512 code points), leaves `_fields_synced` empty, advances no baseline/provenance, persists no S1 deferral, and lets the batch continue. S3 later maps terminal dispositions to pass/fuse control and durable deferral, then retires the bridge.\n9. Emit exactly one redacted completion log per terminal/exhausted outcome or cleanup failure: only logical id, disposition, invocation count, request count, cleanup status, `retry_not_before`, and one redacted message (<=512 code points); the whole log <=1,024 code points.\n10. ADR 0103 records the retry owner, Jira idempotency limit, observe-before-replay, budget, lifecycle owners, rollback, and deltas from ADR 0084/0087 and desired-state ADRs 0004/0026/0029. The 15s cumulative limit supersedes ADR 0084 only on selected routes.\n\n## Scope\n- Core: `operation_outcome.py`, `retry_budget.py`, `dispatch_one.py`, `dispatch_apply_phases.py`, `apply_handlers.py`.\n- Cloud: `acli.py`, `acli_subprocess.py`, `acli_rest.py`, backend; preserve unrelated REST retry defaults.\n- DC: `transport.py`, `retry.py`, `_issues.py`, backend; dedicated executor client and per-call policy preserve legacy defaults.\n- ADR 0103; budget/outcome, handler, historical ACLI, cleanup, and DC request tests.\n\n## Testing\nFake-clock/stateful tests cover schedules, deadlines, request order, ambiguity, recovery, failure classes, and no real sleep. Poison tests reject hidden retry or extra ACLI processes; neighbor tests preserve unselected behavior. Handler tests prevent false state advance. Historical triples pin decoding, real processes pin cleanup, output tests pin bounds/redaction. A real-`jira`-library construction test (offline) pins the retry-disable seam against the actual SDK. S3 owns venue-gated evidence; S5 owns final live confirmation.\n\n## Compatibility / Rollback\nProduction stays on legacy through the internal selector. Rollback selects legacy before a call; no config/env surface or dual-send. S3 changes the default after validation. Selected routes use the new budget, long-delay deferral, fail-loud unknown ACLI shapes, and non-replaying inconclusive recovery; other callers retain current behavior.\n\n## Acceptance Criteria\n- [ ] Cloud and DC summary routes produce one provider-neutral outcome schema; tests assert every field.\n- [ ] Repeated invocations preserve one logical id.\n- [ ] No selected operation exceeds three invocations or 15 seconds cumulative sleep.\n- [ ] Each selected DC write invocation is exactly GET/PUT/GET with no hidden repeats.\n- [ ] Cloud recovery performs one primary-store REST request with no sleep; neighbor tests preserve existing REST retry.\n- [ ] Executor-selected exact `{\"summary\"}` bypasses generic `_call_with_retry`.\n- [ ] The constructor selector defaults to legacy, adds no config/env key, and tests explicitly enable it.\n- [ ] Mixed fields stay one unsplit legacy call.\n- [ ] Confirmed outcomes preserve legacy result, `_fields_synced`, `_comment_errors`, and `_subop` shapes.\n- [ ] Every terminal outcome records exactly one redacted per-mutation message capped at 512 Unicode code points, with no baseline/provenance advance or S1 deferral.\n- [ ] ADR and contract name S3 as sole cutover, fuse/deferral consumer, and bridge-retirement owner.\n- [ ] The Jira 3.10.5 executor passes `max_retries=0` and fails fast unless `_session.max_retries == 0`; legacy SDK retry is unchanged.\n- [ ] A test against the REAL `jira` 3.10.5 library builds `jira.JIRA(..., max_retries=0, get_server_info=False, validate=False)` offline and asserts `_session.max_retries == 0` (not via fake transports); skipped when the `jira-datacenter` extra is absent.\n- [ ] Selected DC wrapper calls are one-attempt/no-sleep; legacy wrapper behavior is unchanged.\n- [ ] Fallback sleeps remain [2s,3s), then [4s,5s).\n- [ ] Over-budget provider delay returns `retry_not_before` without sleep.\n- [ ] Permanent failures use one invocation; eligible transient failures use the schedule.\n- [ ] Satisfied observation returns recovered success without another write.\n- [ ] Conclusive old state permits only remaining-budget replay.\n- [ ] Failed/inconclusive observation returns non-replaying `commit_unknown`.\n- [ ] ACLI cleanup passes for POSIX groups and non-POSIX children.\n- [ ] Historical ACLI triples decode deterministically; unknown triples do not retry.\n- [ ] Operation outcomes hold at most eight diagnostics, each redacted message <=512 code points.\n- [ ] Every terminal/exhausted outcome or cleanup failure emits exactly one completion log with only the step-9 fields; each message <=512 and the whole log <=1,024 code points.\n- [ ] ADR 0103 records contract, ownership, compatibility deltas, rollback, and prior art; index checks pass.","env_id":"b8a354e0-12c3-4cf2-bbf1-fcc9685d5126","file_impact":[{"path":"src/rebar/_engine/rebar_reconciler/operation_outcome.py","reason":"Provider-neutral logical-operation outcomes and terminal dispositions."},{"path":"src/rebar/_engine/rebar_reconciler/retry_budget.py","reason":"Single three-invocation and fifteen-second sleep budget."},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_one.py","reason":"Legacy-default selector, selected summary route, and compatibility result mapping."},{"path":"src/rebar/_engine/rebar_reconciler/dispatch_apply_phases.py","reason":"Bypass and poison-test the legacy generic retry wrapper."},{"path":"src/rebar/_engine/rebar_reconciler/apply_handlers.py","reason":"Consume terminal result tags without false baseline or provenance advance."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli.py","reason":"Expose the selected Cloud summary operation."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_subprocess.py","reason":"One-process invocation, decoding, timeout, and cleanup."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/acli_rest.py","reason":"Per-call single-attempt recovery observation while preserving other retry defaults."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira/backend.py","reason":"Expose the typed Cloud operation to core coordination."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/transport.py","reason":"Build a dedicated no-SDK-retry executor client without changing legacy construction."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/retry.py","reason":"Per-call one-attempt executor policy while preserving legacy wrapper defaults."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/_issues.py","reason":"Execute the selected DC summary postcondition once per invocation."},{"path":"src/rebar/_engine/rebar_reconciler/adapters/jira_datacenter/backend.py","reason":"Expose the typed DC operation to core coordination."},{"path":"docs/adr/0100-reconciler-operation-coordination.md","reason":"Establish coordination, retry, ambiguity, lifecycle ownership, and rollback."},{"path":"tests/unit/rebar_reconciler/mutate/test_operation_retry_budget.py","reason":"Fake-clock budget, route, classification, ambiguity, and wire-count tests."},{"path":"tests/unit/rebar_reconciler/apply/test_apply_handlers_operation_outcome.py","reason":"Regression tests for result compatibility and no false baseline or provenance advance."},{"path":"tests/fixtures/reconciler/rp03_acli_outcomes.json","reason":"Sanitized historical ACLI exit/stdout/stderr evidence."},{"path":"tests